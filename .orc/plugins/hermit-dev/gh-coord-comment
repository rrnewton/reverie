#!/usr/bin/env bash
#
# Post a GitHub issue/PR comment as the orc-coord-014 coordinator team.
#
# WHY THIS EXISTS. Several agent teams comment on the same rrnewton repositories,
# and the owner needs to tell this team's output apart at a glance. A rule that
# lives only in AGENTS.md is remembered; a wrapper is enforced. So this normalises
# the team prefix instead of trusting every caller to type it.
#
# THE RULE (canonical text: AGENTS.md, "Team identity — orc-coord-014"):
#   the FIRST LINE of every comment must carry the literal tag [orc-coord-014].
#   A role tag may precede it on the same line -- "[coordinator, opus-5]
#   [orc-coord-014] ..." is correct and common. The role tag says WHAT KIND of
#   agent wrote it; the team tag says WHICH TEAM. Neither substitutes for the
#   other, which is why this checks only for the team tag and leaves role tags
#   alone.
#
# THREE OUTCOMES, deliberately distinct:
#   present   -> pass through byte-for-byte. Never rewrite a correct comment.
#   absent    -> prepend "[orc-coord-014] " and post. Normalising beats refusing
#                here: the comment is wanted, only the attribution is missing.
#   CONFLICT  -> refuse, exit 2. A first line carrying a DIFFERENT [orc-coord-NNN]
#                is another team's identity; silently retagging it would forge
#                attribution, which is the exact thing this wrapper exists to make
#                reliable.
#
# Destination is restricted to rrnewton/*. facebookexperimental/* is REFUSED, not
# redirected: comment targets are per-repo issue numbers, so "the same comment on
# the fork" is a different thread, and upstream syncs into Meta's internal task
# tracker (see AGENTS.md, Bot-Created GitHub Issue Policy).
#
#   gh-coord-comment --repo rrnewton/hermit 1844 --body "text"
#   gh-coord-comment --repo rrnewton/hermit --pr 1719 --body-file note.md
#   gh-coord-comment --repo rrnewton/hermit 1844 --body "x" --check-only  # no network

set -euo pipefail

readonly TEAM_TAG="[orc-coord-014]"
readonly DEFAULT_HTTPS_PROXY="http://fwdproxy:8080"
readonly PLUGIN_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
# GH_BIN remains an offline-test seam. Production always crosses the fleet-aware
# comment boundary, which adds exact agent+session identity before this team's
# existing role tag. A shared owner credential must never be the speaker ID.
readonly GH_COMMAND="${GH_BIN:-$PLUGIN_ROOT/ci-hub/bin/gh}"

repo="${GH_REPO:-}"
target=""
kind="issue"
body=""
body_source="none"
check_only=0

die() { echo "error: $*" >&2; exit 2; }

while (($# > 0)); do
  case "$1" in
    -R|--repo)   (($# >= 2)) || die "$1 requires a repository"; repo="$2"; shift 2 ;;
    --repo=*)    repo="${1#*=}"; shift ;;
    --pr)        (($# >= 2)) || die "--pr requires a number"; kind="pr"; target="$2"; shift 2 ;;
    --issue)     (($# >= 2)) || die "--issue requires a number"; kind="issue"; target="$2"; shift 2 ;;
    -b|--body)   (($# >= 2)) || die "$1 requires a value"; body="$2"; body_source="arg"; shift 2 ;;
    -F|--body-file)
      (($# >= 2)) || die "$1 requires a path"
      [[ -r "$2" ]] || die "cannot read body file: $2"
      body="$(cat -- "$2")"; body_source="file"; shift 2 ;;
    --check-only) check_only=1; shift ;;
    -h|--help)   sed -n '2,40p' "$0"; exit 0 ;;
    -*)          die "unsupported flag for a coordination comment: $1" ;;
    *)           [[ -z "$target" ]] || die "unexpected extra argument: $1"; target="$1"; shift ;;
  esac
done

[[ -n "$target" ]] || die "pass the issue/PR number (or --pr N / --issue N)"
[[ "$body_source" != "none" ]] || die "pass --body or --body-file"
[[ -n "${body//[[:space:]]/}" ]] || die "refusing to post an empty comment"

# Normalise the destination the same way gh-issue-create does.
if [[ -z "$repo" ]]; then
  remote="$(git config --get remote.origin.url 2>/dev/null || true)"
  if [[ "$remote" =~ github\.com[:/]([^/]+)/([^/]+)$ ]]; then
    repo="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
  else
    die "pass --repo rrnewton/<repo>"
  fi
fi
repo="${repo#https://github.com/}"; repo="${repo#http://github.com/}"
repo="${repo#git@github.com:}";     repo="${repo#github.com/}"; repo="${repo%.git}"

case "$repo" in
  rrnewton/*) ;;
  facebookexperimental/*)
    die "refusing to comment on $repo: upstream syncs into Meta's internal task tracker. Comment on the rrnewton fork instead (the issue numbers differ, so this is NOT a redirect)." ;;
  *) die "coordination comments are restricted to rrnewton/* (got: $repo)" ;;
esac

# --- the attribution rule -----------------------------------------------------
first_line="${body%%$'\n'*}"
if [[ "$first_line" == *"$TEAM_TAG"* ]]; then
  : # already attributed; pass through unchanged
elif [[ "$first_line" =~ \[orc-coord-[0-9]+\] ]]; then
  die "first line carries a different team tag (${BASH_REMATCH[0]}), not $TEAM_TAG. Refusing to retag another team's comment."
else
  body="$TEAM_TAG $body"
fi

if ((check_only)); then
  printf 'repo=%s kind=%s target=%s\n' "$repo" "$kind" "$target"
  printf '%s\n' "$body"
  exit 0
fi

export HTTPS_PROXY="${HTTPS_PROXY:-$DEFAULT_HTTPS_PROXY}"
unset GH_REPO
exec "$GH_COMMAND" "$kind" comment "$target" --repo "$repo" --body "$body"
