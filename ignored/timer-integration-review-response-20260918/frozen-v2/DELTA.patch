+fn parked_signal_two_thread_failed_predecessor_retains_both_owners() {
+    if !leader_self_exec_bounded(
+        "parked_signals::parked_signal_two_thread_failed_predecessor_retains_both_owners",
+    ) {
+        return;
+    }
+    run_sibling_dequeues(true);
+}
