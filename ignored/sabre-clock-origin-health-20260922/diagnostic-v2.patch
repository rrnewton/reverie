 typedef int clock_gettime_fn(clockid_t, struct timespec *);
+
+/* LOCAL DIAGNOSTIC ONLY: excluded unless the bounded diagnostic build names
+ * its own output file. No routing decision or guest-visible result changes. */
+#ifdef SBR_ORIGIN_DIAGNOSTIC_PATH
+static char *origin_text(char *out, const char *text) {
+  while (*text) *out++ = *text++;
+  return out;
+}
+
+static char *origin_hex(char *out, uintptr_t value) {
+  static const char digits[] = "0123456789abcdef";
+  *out++ = '0'; *out++ = 'x';
+  for (int shift = 60; shift >= 0; shift -= 4)
+    *out++ = digits[(value >> shift) & 15];
+  return out;
+}
+
+static void origin_write(int fd, const char *data, size_t bytes) {
+  while (bytes) {
+    long n = real_syscall(SYS_write, fd, (long)data, bytes, 0, 0, 0);
+    if (n == -EINTR) continue;
+    if (n <= 0) return;
+    data += n; bytes -= n;
+  }
+}
+
+static void origin_diagnostic(const char *route, long sc_no, uintptr_t site,
+                              const uintptr_t *caller_sp, int plugin) {
+  static unsigned records;
+  static int maps_written;
+  static int entered;
+  if (entered || records >= 128) return;
+  entered = 1;
+  int saved_errno = errno;
+  long fd = real_syscall(SYS_openat, AT_FDCWD, (long)SBR_ORIGIN_DIAGNOSTIC_PATH,
+                        O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600, 0, 0);
+  if (fd >= 0) {
+    if (!maps_written && plugin == 0) {
+      maps_written = 1;
+      origin_write(fd, "MAPS_BEGIN\n", 11);
+      long maps = real_syscall(SYS_openat, AT_FDCWD, (long)"/proc/self/maps",
+                              O_RDONLY | O_CLOEXEC, 0, 0, 0);
+      if (maps >= 0) {
+        char block[4096];
+        for (unsigned i = 0; i < 16; ++i) {
+          long n = real_syscall(SYS_read, maps, (long)block, sizeof(block), 0, 0, 0);
+          if (n <= 0) break;
+          origin_write(fd, block, n);
+        }
+        real_syscall(SYS_close, maps, 0, 0, 0, 0, 0);
+      }
+      origin_write(fd, "MAPS_END\n", 9);
+    }
+    uintptr_t words[16] = {0};
+    struct iovec local = {words, sizeof(words)};
+    struct iovec remote = {(void *)caller_sp, sizeof(words)};
+    long pid = real_syscall(SYS_getpid, 0, 0, 0, 0, 0, 0);
+    long copied = caller_sp ? real_syscall(SYS_process_vm_readv, pid, (long)&local, 1,
+                                           (long)&remote, 1, 0) : 0;
+    char line[1024]; char *out = line;
+    out = origin_text(out, "ORIGIN route="); out = origin_text(out, route);
+    out = origin_text(out, " sc="); out = origin_hex(out, sc_no);
+    out = origin_text(out, " plugin="); out = origin_hex(out, plugin);
+    out = origin_text(out, " site="); out = origin_hex(out, site);
+    out = origin_text(out, " caller_sp="); out = origin_hex(out, (uintptr_t)caller_sp);
+    out = origin_text(out, " copied="); out = origin_hex(out, copied);
+    for (unsigned i = 0; i < 16; ++i) {
+      out = origin_text(out, " "); out = origin_hex(out, words[i]);
+    }
+    *out++ = '\n'; origin_write(fd, line, out - line);
+    real_syscall(SYS_close, fd, 0, 0, 0, 0, 0);
+  }
+  ++records;
+  errno = saved_errno;
+  entered = 0;
+}
+#endif
