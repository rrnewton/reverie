+    }
+
+    let mut plain = ElfExecutor::new(plain_state, false);
+    assert_eq!(
+        plain.execute(
+            &SyscallRequest::new(libc::SYS_dup as u64, [1, 0, 0, 0, 0, 0]),
+            &memory,
+        ),
+        negative_errno(libc::EBADF)
