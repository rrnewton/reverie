+    memory.write(0x3000, b"xy").unwrap();
+    let one_byte = libc::iovec {
+        iov_base: 0x3000_usize as *mut libc::c_void,
+        iov_len: 1,
+    };
+    assert_eq!(write_struct(&mut memory, 0x3100, &one_byte), 0);
