+        error: libc::c_int,
+        length: libc::socklen_t,
+        bytes: Vec<u8>,
+    }
+
+    #[derive(Debug, Eq, PartialEq)]
+    struct SocketSnapshot {
+        device: libc::dev_t,
+        inode: libc::ino_t,
+        mode: libc::mode_t,
+        socket_type: libc::c_int,
+        domain: libc::c_int,
+        accepting: libc::c_int,
+        reuse_address: libc::c_int,
+        receive_buffer: libc::c_int,
+        send_buffer: libc::c_int,
