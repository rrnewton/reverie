+            return Err(negative_errno(libc::EIO));
+        }
+        // SAFETY: successful fstat initialized the complete structure.
+        let backing = unsafe { backing.assume_init() };
+        if (candidate.st_dev, candidate.st_ino) == (backing.st_dev, backing.st_ino) {
+            return Ok(true);
+        }
+    }
+    Ok(false)
