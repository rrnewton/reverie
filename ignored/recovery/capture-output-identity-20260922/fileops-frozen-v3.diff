+fn matches_capture_carrier(candidate: &libc::stat, capture: CaptureMetadata) -> Result<bool, i64> {
+    for alias in [OutputAlias::Stdout, OutputAlias::Stderr] {
+        let mut backing = std::mem::MaybeUninit::<libc::stat>::zeroed();
