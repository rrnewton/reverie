+                expected_flags[index]
+            );
+            assert_eq!(std::fs::read(path).unwrap(), expected);
+            assert_eq!(
+                unsafe { libc::lseek(file.as_raw_fd(), 0, libc::SEEK_CUR) },
+                1
+            );
+        }
+        drop(restore);
+        (direct, direct_repeat, tool, tool_repeat)
