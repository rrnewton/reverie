+// Linux permits fchdir through an O_PATH directory. Exercise direct, duplicate,
+// proc-fd-reopened, and raw high-word spellings, plus rejecting controls. Each
+// source changes to a distinct directory and is then closed; a relative read
+// proves the cwd retained an independent usable reference. This is
+// output/exit/status repeat parity only, not L2-log or record/replay parity.
+#[test]
+fn fchdir_opath_matches_native_and_is_repeatable_on_kvm() {
+    const TEST: &str = "fchdir_opath_matches_native_and_is_repeatable_on_kvm";
+    if !leader_self_exec_bounded(TEST) {
+        return;
+    }
+
+    let directory = TestDirectory::new();
+    let executable = compile_c_program(
+        &directory.0,
+        "fchdir-opath-parity",
+        r#"
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define HIGH_WORD UINT64_C(0x5a5a5a5a00000000)
+
+static int cwd_is(const char *expected) {
+  char observed[4096];
+  return getcwd(observed, sizeof(observed)) != NULL &&
+         strcmp(observed, expected) == 0;
+}
+
+static int failed_with(long result, int error) {
+  return result == -1 && errno == error;
+}
+
+int main(int argc, char **argv) {
+  if (argc != 1) return 1;
+  char original[4096], target[4096], path[64];
+  if (getcwd(original, sizeof(original)) == NULL) return 2;
+  if (snprintf(target, sizeof(target), "%s/target", original) >=
+      (int)sizeof(target)) return 3;
+
+  int restore = open(".", O_PATH | O_DIRECTORY | O_CLOEXEC);
+  if (restore < 0) return 4;
+  int direct = open("target", O_PATH | O_DIRECTORY | O_CLOEXEC);
+  if (direct < 0) return 5;
+  int duplicate = dup(direct);
+  if (duplicate < 0) return 6;
+  if (snprintf(path, sizeof(path), "/proc/self/fd/%d", direct) >=
+      (int)sizeof(path)) return 7;
+  int reopened = open(path, O_PATH | O_DIRECTORY | O_CLOEXEC);
+  if (reopened < 0) return 8;
+
+  int sources[] = {direct, duplicate, reopened};
+  for (unsigned index = 0; index < sizeof(sources) / sizeof(sources[0]); ++index) {
+    int fd = sources[index];
+    if (fchdir(fd) != 0 || !cwd_is(target)) return 10 + (int)index;
+    if (syscall(SYS_fchdir, HIGH_WORD | (uint32_t)fd) != 0 ||
+        !cwd_is(target)) return 20 + (int)index;
+    if (close(fd) != 0 || !cwd_is(target)) return 30 + (int)index;
+    int inside = open("inside", O_RDONLY | O_CLOEXEC);
+    char byte = 0;
+    if (inside < 0 || read(inside, &byte, 1) != 1 || byte != 'x' ||
+        close(inside) != 0) return 33 + (int)index;
+    if (fchdir(restore) != 0 || !cwd_is(original)) return 36 + (int)index;
+  }
+
+  int regular = open(argv[0], O_PATH | O_CLOEXEC);
+  if (regular < 0) return 40;
+  errno = 0;
+  if (!failed_with(fchdir(regular), ENOTDIR)) return 41;
+  int closed = dup(regular);
+  if (closed < 0 || close(closed) != 0) return 42;
+  errno = 0;
+  if (!failed_with(syscall(SYS_fchdir,
+                           HIGH_WORD | (uint32_t)closed), EBADF)) return 43;
+  if (close(regular) != 0) return 44;
+
+  int pipes[2];
+  if (pipe2(pipes, O_CLOEXEC) != 0) return 45;
+  for (unsigned index = 0; index < 2; ++index) {
+    errno = 0;
+    if (!failed_with(syscall(SYS_fchdir,
+                             HIGH_WORD | (uint32_t)pipes[index]), ENOTDIR))
+      return 46 + (int)index;
+    if (close(pipes[index]) != 0) return 48 + (int)index;
+  }
+  if (!cwd_is(original) || close(restore) != 0) return 50;
+
+  static const char out[] = "fchdir-opath-ok\n";
+  static const char err[] = "fchdir-opath-err\n";
+  if (write(STDOUT_FILENO, out, sizeof(out) - 1) != sizeof(out) - 1) return 51;
+  if (write(STDERR_FILENO, err, sizeof(err) - 1) != sizeof(err) - 1) return 52;
+  return 0;
+}
+"#,
+    );
+    std::fs::create_dir(directory.0.join("target")).unwrap();
