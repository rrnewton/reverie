+        executor
+            .state
+            .thread_signals
+            .lock()
+            .blocked
+            .remove(libc::SIGALRM);
+        assert_eq!(
+            executor.take_pending_signal_for_delivery().unwrap(),
+            Some(PendingSignal {
+                event: replacement,
+                domain
