+fn process_alarm_set_action(executor: &mut ElfExecutor, memory: &mut GuestMemory, handler: u64) {
+    memory
+        .write(
+            0x100,
+            &KernelSigaction {
+                handler,
+                ..Default::default()
+            }
+            .encode(),
+        )
+        .unwrap();
+    assert_eq!(
+        rt_sigaction(
+            memory,
+            &mut executor.state,
+            &[
+                libc::SIGALRM as u64,
+                0x100,
+                0,
+                KERNEL_SIGSET_SIZE as u64,
+                0,
+                0
+            ]
+        ),
+        0
+    );
+}
