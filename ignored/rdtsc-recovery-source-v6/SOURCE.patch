+        0x31, 0xff, // xor edi, edi
+        0x0f, 0x05, // syscall
+    ]);
+    let failure = code.len();
+    code.extend_from_slice(&[
+        0xb8, 0x3c, 0x00, 0x00, 0x00, // mov eax, SYS_exit
+        0xbf, 0x01, 0x00, 0x00, 0x00, // mov edi, 1
+        0x0f, 0x05, // syscall
+    ]);
