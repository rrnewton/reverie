+    #[test]
+    fn synthetic_proc_dup_and_reopen_preserve_description_semantics_and_seals() {
+        const PATH: u64 = 0x100;
+        const BUFFER: u64 = 0x200;
+
+        let root = TestDir::new();
+        let mut state = test_state(&root.0);
+        let mut memory = GuestMemory::new(0, state.mmap_limit as usize).unwrap();
+        write_c_string(&mut memory, PATH, "/proc/uptime");
+        let fd = syscall_result(
+            &mut memory,
+            &mut state,
+            libc::SYS_openat,
+            [
+                libc::AT_FDCWD as u64,
+                PATH,
+                (libc::O_RDONLY | libc::O_CLOEXEC) as u64,
+                0,
+                0,
+                0,
+            ],
+        );
+        assert_eq!(fd, 3);
+        assert_eq!(
+            syscall_result(
+                &mut memory,
+                &mut state,
+                libc::SYS_read,
+                [fd as u64, BUFFER, 2, 0, 0, 0],
+            ),
+            2
+        );
+        let duplicate = syscall_result(
+            &mut memory,
+            &mut state,
+            libc::SYS_dup,
+            [fd as u64, 0, 0, 0, 0, 0],
+        );
+        assert_eq!(duplicate, 4);
+        assert_eq!(
+            syscall_result(
+                &mut memory,
+                &mut state,
+                libc::SYS_fcntl,
+                [duplicate as u64, libc::F_GETFD as u64, 0, 0, 0, 0],
+            ),
+            0,
+            "dup must clear the descriptor-local close-on-exec bit"
+        );
+        assert_eq!(
+            syscall_result(
+                &mut memory,
+                &mut state,
+                libc::SYS_read,
+                [duplicate as u64, BUFFER, 3, 0, 0, 0],
+            ),
+            3
+        );
+        let mut shared_offset = [0; 3];
+        memory.read(BUFFER, &mut shared_offset).unwrap();
+        assert_eq!(&shared_offset, b"00 ");
+
+        write_c_string(&mut memory, PATH, &format!("/proc/self/fd/{fd}"));
+        let reopened = syscall_result(
+            &mut memory,
+            &mut state,
+            libc::SYS_openat,
+            [
+                libc::AT_FDCWD as u64,
+                PATH,
+                (libc::O_RDONLY | libc::O_CLOEXEC) as u64,
+                0,
+                0,
+                0,
+            ],
+        );
+        assert_eq!(reopened, 5);
+        assert_eq!(
+            syscall_result(
+                &mut memory,
+                &mut state,
+                libc::SYS_read,
+                [reopened as u64, BUFFER, 2, 0, 0, 0],
+            ),
+            2
+        );
+        let mut fresh_offset = [0; 2];
+        memory.read(BUFFER, &mut fresh_offset).unwrap();
+        assert_eq!(&fresh_offset, b"0.");
+        assert_eq!(
+            syscall_result(
+                &mut memory,
+                &mut state,
+                libc::SYS_fcntl,
+                [reopened as u64, libc::F_GETFD as u64, 0, 0, 0, 0],
+            ),
+            i64::from(libc::FD_CLOEXEC)
+        );
+
+        let inode = state.proc_files[&(fd as libc::c_int)];
+        for alias in [duplicate, reopened] {
+            assert_eq!(state.proc_files.get(&(alias as libc::c_int)), Some(&inode));
+            let host_fd = state.files[&(alias as libc::c_int)].as_raw_fd();
+            assert_eq!(
+                unsafe { libc::fcntl(host_fd, libc::F_GET_SEALS) },
+                libc::F_SEAL_WRITE | libc::F_SEAL_GROW | libc::F_SEAL_SHRINK | libc::F_SEAL_SEAL
+            );
+            assert_eq!(
+                unsafe { libc::fcntl(host_fd, libc::F_GETFL) } & libc::O_ACCMODE,
+                libc::O_RDONLY
+            );
+        }
+
+        // A writable proc-fd reopen is possible for the private memfd carrier,
+        // but every operation that could mutate its immutable snapshot remains
+        // blocked by the inode seals. This makes the checks sensitive to the
+        // seals independently of the initially exposed O_RDONLY description.
+        let writable = syscall_result(
+            &mut memory,
+            &mut state,
+            libc::SYS_openat,
+            [
+                libc::AT_FDCWD as u64,
+                PATH,
+                (libc::O_RDWR | libc::O_CLOEXEC) as u64,
+                0,
+                0,
+                0,
+            ],
+        );
+        assert_eq!(writable, 6);
+        assert_eq!(
+            unsafe {
+                libc::fcntl(
+                    state.files[&(writable as libc::c_int)].as_raw_fd(),
+                    libc::F_GET_SEALS,
+                )
+            },
+            libc::F_SEAL_WRITE | libc::F_SEAL_GROW | libc::F_SEAL_SHRINK | libc::F_SEAL_SEAL
+        );
+        memory.write(BUFFER, b"x").unwrap();
+        for (number, args) in [
+            (libc::SYS_write, [writable as u64, BUFFER, 1, 0, 0, 0]),
+            (libc::SYS_pwrite64, [writable as u64, BUFFER, 1, 0, 0, 0]),
+            (libc::SYS_ftruncate, [writable as u64, 0, 0, 0, 0, 0]),
+            (libc::SYS_fallocate, [writable as u64, 0, 10, 1, 0, 0]),
+        ] {
+            assert_eq!(
+                syscall_result(&mut memory, &mut state, number, args),
+                negative_errno(libc::EPERM),
+                "syscall {number} bypassed the immutable snapshot seals"
+            );
+        }
+        assert_eq!(
+            syscall_result(
+                &mut memory,
+                &mut state,
+                libc::SYS_mmap,
+                [
+                    0,
+                    PAGE_SIZE,
+                    (libc::PROT_READ | libc::PROT_WRITE) as u64,
+                    libc::MAP_SHARED as u64,
+                    writable as u64,
+                    0,
+                ],
+            ),
+            negative_errno(libc::EPERM)
+        );
+    }
