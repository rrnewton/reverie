+fn append_jne_failure(code: &mut Vec<u8>, patches: &mut Vec<usize>) {
+    code.extend_from_slice(&[0x0f, 0x85]);
+    patches.push(code.len());
+    code.extend_from_slice(&0_i32.to_le_bytes());
