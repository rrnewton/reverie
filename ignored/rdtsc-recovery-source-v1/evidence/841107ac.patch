+"#
+    );
+    let executable = compile_c_program(&directory.0, "timestamp-lifecycle", &source);
+    let image = std::fs::read(&executable).unwrap();
+    let mut backend = KvmBackend::new(256 * 1024 * 1024).unwrap();
+    backend
+        .install_static_elf_with_context(
