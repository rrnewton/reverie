+    let image = static_elf(&[
+        0x0f, 0x31, // rdtsc
+        0xb8, 0x3c, 0x00, 0x00, 0x00, // mov eax, SYS_exit
+        0x31, 0xff, // xor edi, edi
+        0x0f, 0x05, // syscall
+    ]);
+    let (log, code) = run_timestamp_probe(&image, false);
+    assert_eq!(code, 0);
