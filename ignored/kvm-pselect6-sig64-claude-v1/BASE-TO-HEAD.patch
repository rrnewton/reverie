+            );
+        }
+
+        let root = TestDir::new();
+        let mut state = test_state(&root.0);
+        let mut memory = GuestMemory::new(0, PAGE_SIZE as usize).unwrap();
+        let valid_timeout = libc::timespec {
+            tv_sec: 0,
+            tv_nsec: 0,
