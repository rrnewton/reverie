+        const TIMEOUT: u64 = 0x180;
+        const SIGNAL_MASK: u64 = 0x200;
+        const READ_SET: u64 = 0x280;
+        const WRITE_SET: u64 = 0x300;
+        const EXCEPT_SET: u64 = 0x380;
+        const BAD_ADDRESS: u64 = 0x00f0_0000;
+
