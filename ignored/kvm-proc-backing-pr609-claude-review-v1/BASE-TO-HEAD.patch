+        Err(error) => Err(Error::HostIo(std::io::Error::new(
+            std::io::ErrorKind::Unsupported,
+            format!("cannot establish O_CREAT|O_DIRECTORY host policy: {error}"),
+        ))),
+    }
+}
 
