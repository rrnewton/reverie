+                [duplicate as u64, libc::F_GETFL as u64, 0, 0, 0, 0],
+            ) & i64::from(libc::O_NOFOLLOW),
+            0
+        );
+        let fcntl_copy = syscall_result(
+            &mut memory,
+            &mut state,
