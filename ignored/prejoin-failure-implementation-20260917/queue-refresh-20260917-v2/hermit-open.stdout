orks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":562,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":562,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/3069"},"html":{"href":"https://github.com/rrnewton/hermit/pull/3069"},"issue":{"href":"https://api.github.com/repos/rrnewton/hermit/issues/3069"},"comments":{"href":"https://api.github.com/repos/rrnewton/hermit/issues/3069/comments"},"review_comments":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/3069/comments"},"review_comment":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/3069/commits"},"statuses":{"href":"https://api.github.com/repos/rrnewton/hermit/statuses/9cec06dcc9d8acf4828b72f73d9bb1abd1f01ddc"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/rrnewton/hermit/pulls/3066","id":4557942302,"node_id":"PR_kwDOIZiOrM8AAAABD6yuHg","html_url":"https://github.com/rrnewton/hermit/pull/3066","diff_url":"https://github.com/rrnewton/hermit/pull/3066.diff","patch_url":"https://github.com/rrnewton/hermit/pull/3066.patch","issue_url":"https://api.github.com/repos/rrnewton/hermit/issues/3066","number":3066,"state":"open","locked":false,"title":"Report a node whose required results were never written as undetermined","user":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Report a node whose required results were never written as undetermined\n\n[hermit2, assertions-3, claude-opus-5, devbig014, role=impl]\n\nPlain Language Summary and Project Impact\n\nWhen a validate node's required structured test results are never written, the\nrun today records that node as a product failure. It is not one: nothing failed\nthat anybody measured, and the whole content of the condition is that no\nevidence exists in either direction. Run 1819 recorded 26 failed nodes of which\n17 were exactly this, so a reader saw a badly broken product where two thirds of\nthe evidence was the harness failing to record. That conflation is the reason a\nvalidate run that mostly did not record reads as main being red, and those are\ndifferent claims.\n\nThis routes that one condition to no_result. The node stops counting as a\nfailure and equally cannot count as green evidence for landing, which is both\nhalves of the owner's ruling, using the taxonomy that already exists.\n\nTask: structured-test-results-refused-dominates-validate-failures-and-hides-what-failed\n\nThe scope is one cause of three. dagrun funnels three conditions into the same\nrefusal: `cannot read structured test results {path}: {error}`, `malformed\nstructured test results {path}: {error}`, and `required structured test results\nwere not written to {location}`. The first two describe a report the run\nactually produced, so the suite is a fair suspect -- a duplicate test identity\nis a malformed suite, and that is exactly what product_evidence_bracket already\npins as a product failure. Only the third says the report does not exist. Only\nthe third is reclassified, and the existing bracket passes untouched.\n\nThe match is a PREFIX, not a substring, because the other two interpolate a\npath. A malformed report whose path happens to contain the phrase must stay a\nproduct failure, and there is a control for precisely that.\n\nDeterminism\n\nNo random, scheduling, timing or comparison behavior changes. This is a pure\nfunction of already-recorded attempt fields, so the same evidence yields the\nsame classification on every read. No assertion, tolerance, comparator or\nbudget constant was weakened, and no existing expectation was edited to\naccommodate the change.\n\nLinux Semantics\n\nNo guest syscall, process, signal or exit-status behavior is affected. Reading\na nonzero exit status as a real failed condition is preserved exactly, which is\nthe Linux-facing property this touches.\n\nValidation\n\n`./scripts/validate.rs --self-test` -> FINAL_VALIDATE_STATUS PASSED, rc 0, with\nthe new bracket in the classification line.\n\nMeasured in both directions rather than asserted. With the reclassification\ndisabled and everything else identical, the same self-test fails with\n`classification: a report that was never written was reported as a product\nfailure`, rc 1. The control is what proves the new expectations can fail; the\nprevious attempt at this change had a fixture that could not fail, because it\nwas cloned from one already carrying understood_infrastructure_class and so\nreached no_result by a different arm. This fixture starts from a plain outcome\nwith no infrastructure diagnosis, so the reclassification is the only thing that\ncan satisfy it.\n\nrustfmt --edition 2024 --check clean. hermit-cli is edition 2024; checking with\n2021 reports unrelated pre-existing let-chain errors.\n\nThe controls cover every counterexample raised against the earlier attempt:\n\n- never written, command exited 0        -> no_result   (the repair)\n- malformed, and unreadable              -> product failure, unchanged\n- malformed whose PATH contains the\n  absence phrase                         -> product failure, not excused\n- legacy `STRUCTURED TEST RESULTS\n  REFUSED: ` reason form, both causes    -> same verdicts as the typed field\n- never written + a measured failing test-> product failure\n- never written + exit 1, 2, 101, -15    -> product failure, all four\n- never written + each of the 7 wall /\n  CPU / OOM / oom_kills combinations     -> product failure\n- never written + each of the 15\n  incomplete / aborted / unreported\n  masks                                  -> no_result, never upgraded\n- never written + a real infrastructure\n  diagnosis                              -> understood_infrastructure_failure\n- the ledger projection a consumer reads -> result and failure_class no_result\n\nTwo ordering properties are enforced by the code rather than by placement. The\nabsence test requires the command's own exit status to be zero and no collected\nwall/CPU/OOM breach, so a node that genuinely failed is never excused by its\nreport going missing -- the missing report means the failure cannot be NAMED,\nand naming is not the same as existing. And the new branch sits last, after the\nunderstood-infrastructure check, so it can only intercept what would otherwise\nfall through to the default product failure.\n\nIt is no_result rather than understood_infrastructure_failure on purpose.\nNothing here diagnosed a cause, and that bucket is projected with a named cause\nthis branch would have to leave empty.\n\nNot claimed: this does not stop the refusals happening -- that was the stray\nsummary file, repaired separately -- and it does not touch the post-run\nscorecard write-back. Neither subsumes the other.\n\n","created_at":"2026-09-17T11:35:19Z","updated_at":"2026-09-17T15:33:06Z","closed_at":null,"merged_at":null,"merge_commit_sha":"455ad2d5ef8e7c79c20f391ffc78acbaa8197ea2","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/rrnewton/hermit/pulls/3066/commits","review_comments_url":"https://api.github.com/repos/rrnewton/hermit/pulls/3066/comments","review_comment_url":"https://api.github.com/repos/rrnewton/hermit/pulls/comments{/number}","comments_url":"https://api.github.com/repos/rrnewton/hermit/issues/3066/comments","statuses_url":"https://api.github.com/repos/rrnewton/hermit/statuses/b27530786ae57fb9cc43d9d49563ce8f02e64013","head":{"label":"rrnewton:assertions-3/unwritten-report-is-undetermined","ref":"assertions-3/unwritten-report-is-undetermined","sha":"b27530786ae57fb9cc43d9d49563ce8f02e64013","user":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":563646124,"node_id":"R_kgDOIZiOrA","name":"hermit","full_name":"rrnewton/hermit","private":false,"own