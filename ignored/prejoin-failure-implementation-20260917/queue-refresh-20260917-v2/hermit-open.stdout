es linux x86_64 programs in a special, hermetically isolated sandbox to control their execution. Hermit translates normal, nondeterministic behavior, into deterministic, repeatable behavior. This can be used for various applications, including replay-debugging, reproducible artifacts, chaos mode concurrency testing and bug analysis.","fork":true,"url":"https://api.github.com/repos/rrnewton/hermit","forks_url":"https://api.github.com/repos/rrnewton/hermit/forks","keys_url":"https://api.github.com/repos/rrnewton/hermit/keys{/key_id}","collaborators_url":"https://api.github.com/repos/rrnewton/hermit/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/rrnewton/hermit/teams","hooks_url":"https://api.github.com/repos/rrnewton/hermit/hooks","issue_events_url":"https://api.github.com/repos/rrnewton/hermit/issues/events{/number}","events_url":"https://api.github.com/repos/rrnewton/hermit/events","assignees_url":"https://api.github.com/repos/rrnewton/hermit/assignees{/user}","branches_url":"https://api.github.com/repos/rrnewton/hermit/branches{/branch}","tags_url":"https://api.github.com/repos/rrnewton/hermit/tags","blobs_url":"https://api.github.com/repos/rrnewton/hermit/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/rrnewton/hermit/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/rrnewton/hermit/git/refs{/sha}","trees_url":"https://api.github.com/repos/rrnewton/hermit/git/trees{/sha}","statuses_url":"https://api.github.com/repos/rrnewton/hermit/statuses/{sha}","languages_url":"https://api.github.com/repos/rrnewton/hermit/languages","stargazers_url":"https://api.github.com/repos/rrnewton/hermit/stargazers","contributors_url":"https://api.github.com/repos/rrnewton/hermit/contributors","subscribers_url":"https://api.github.com/repos/rrnewton/hermit/subscribers","subscription_url":"https://api.github.com/repos/rrnewton/hermit/subscription","commits_url":"https://api.github.com/repos/rrnewton/hermit/commits{/sha}","git_commits_url":"https://api.github.com/repos/rrnewton/hermit/git/commits{/sha}","comments_url":"https://api.github.com/repos/rrnewton/hermit/comments{/number}","issue_comment_url":"https://api.github.com/repos/rrnewton/hermit/issues/comments{/number}","contents_url":"https://api.github.com/repos/rrnewton/hermit/contents/{+path}","compare_url":"https://api.github.com/repos/rrnewton/hermit/compare/{base}...{head}","merges_url":"https://api.github.com/repos/rrnewton/hermit/merges","archive_url":"https://api.github.com/repos/rrnewton/hermit/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/rrnewton/hermit/downloads","issues_url":"https://api.github.com/repos/rrnewton/hermit/issues{/number}","pulls_url":"https://api.github.com/repos/rrnewton/hermit/pulls{/number}","milestones_url":"https://api.github.com/repos/rrnewton/hermit/milestones{/number}","notifications_url":"https://api.github.com/repos/rrnewton/hermit/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/rrnewton/hermit/labels{/name}","releases_url":"https://api.github.com/repos/rrnewton/hermit/releases{/id}","deployments_url":"https://api.github.com/repos/rrnewton/hermit/deployments","created_at":"2022-11-09T03:00:19Z","updated_at":"2026-09-17T19:31:24Z","pushed_at":"2026-09-17T19:31:22Z","git_url":"git://github.com/rrnewton/hermit.git","ssh_url":"git@github.com:rrnewton/hermit.git","clone_url":"https://github.com/rrnewton/hermit.git","svn_url":"https://github.com/rrnewton/hermit","homepage":null,"size":247745,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":562,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":562,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/2836"},"html":{"href":"https://github.com/rrnewton/hermit/pull/2836"},"issue":{"href":"https://api.github.com/repos/rrnewton/hermit/issues/2836"},"comments":{"href":"https://api.github.com/repos/rrnewton/hermit/issues/2836/comments"},"review_comments":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/2836/comments"},"review_comment":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/2836/commits"},"statuses":{"href":"https://api.github.com/repos/rrnewton/hermit/statuses/1948e95fe14cc95687e886704420a9922a1fe1cb"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/rrnewton/hermit/pulls/2747","id":4375614608,"node_id":"PR_kwDOIZiOrM8AAAABBM6UkA","html_url":"https://github.com/rrnewton/hermit/pull/2747","diff_url":"https://github.com/rrnewton/hermit/pull/2747.diff","patch_url":"https://github.com/rrnewton/hermit/pull/2747.patch","issue_url":"https://api.github.com/repos/rrnewton/hermit/issues/2747","number":2747,"state":"open","locked":false,"title":"Wait for physical thread exit before waking pthread joiners","user":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"[hermit2, hermit-125, unresolved, devbig014, role=impl]\n\n## Plain Language Summary and Project Impact\n\nSaBRe could let a sibling enter `pthread_join` after Detcore's logical thread exit but before Linux completed the physical thread exit and cleared `CLONE_CHILD_CLEARTID`. Identical executions then observed different futex outcomes. This change keeps siblings parked until the SaBRe ptrace supervisor reports the final kernel exit status, then performs the existing logical child-TID wake.\n\nThe measured mechanism covers `backend-parity-c/pthread-lifecycle`, `chaos-c/lock-granularity`, and `c-programs/ppoll-simulation`. It is separate from the DBT `wait4` work in https://github.com/rrnewton/reverie/pull/506 and https://github.com/rrnewton/hermit/pull/2737.\n\nTask: `pthread-exit-join-timing-accounts-for-two-of-the-eight-divergences`\n\n## Summary\n\n- Record an ordinary SaBRe thread exit before returning control to that thread.\n- Keep sibling threads parked until the SaBRe supervisor observes the final kernel exit status.\n- Perform the existing child-TID futex wake at that point; retain the immediate wake on backends without physical-exit reporting.\n- Cover the ordering and the unchanged backend behavior with scheduler unit tests.\n\n## Determinism\n\nThe ordinary `Exit { group: false }` turn installs the wait before the exiting thread resumes. While that wait exists, no sibling receives a scheduler turn. The existing child-TID futex wake is delayed until the backend reports the exact thread's final kernel exit status. Completion removes the wait and wakes the joiner. The ordering is therefore fixed by the deterministic exit turn and the kernel's actual completion of that exit, rather than by host timing between those events.\n\nThe canonical comparator, its assertions, tolerances, labels, and gates are unchanged.\n\n## Linux Semantics\n\nLinux clears `CLONE_CHILD_CLEARTID` and wakes its futex during final thread exit. The change waits for that physical boundary before allowing a modeled `pthread_join` wake, so a resumed joiner cannot race Linux's write. Backends without physical-exit reporting retain the existing immediate logical wake behavior.\n\n## Validation\n\nExact-head evidence used Hermit `76b078dd5e64e5a3bdfec8d6d187db0f1094dca5`, based on `d4d9fe5effe31a90c5a64238ce99fc5ddeea4710`, with pinned Reverie `ab07a89239150df3726a036bee9f5e897893dfc1`, kernel `6.13.2-0_fbk17_hardened_0_g2ae417e0caa0`, and capability masks `Inh=0`, `Prm=0`, `Eff=0`, `Bnd=000001ffffffffff`, `Amb=0`. All 65 typed rows report the exact Hermit source SHA, a clean source tree, binary build SHA `76b078dd5e64`, the SaBRe backend, INFO logs, no relaxations, and the canonical `BitwiseInfoV1` comparison.\n\n- `cargo fmt --all -- --check`: passed.\n- `cargo test -p hermit-detcore --lib`: 566 passed, 0 failed.\n- `cargo clippy -p hermit-detcore --lib -- -D warnings`: passed.\n- SaBRe-only release build: passed; `hermit --version` reports `g76b078dd5e64`.\n- `backend-parity-c/pthread-lifecycle/verify@sabre`: 20 matched of 20. Both retained logs have the final ordinary child exit on scheduler turn 13, main-thread `FutexWait` on turn 14, and futex syscall 26 returning `Ok(0)`.\n- `chaos-c/lock-granularity/verify@sabre`: the former exit/join difference occurred in 0 of 20 comparisons. Nineteen comparisons matched completely. One diverged earlier, at the first child's start on scheduler turn 2, before any child exit; both retained logs later have the ordinary child exit on turn 7, main-thread `FutexWait` on turn 8, and futex syscall 16 returning `Ok(0)`. This change is not credited with that separate earlier timing difference.\n- `c-programs/ppoll-simulation/verify@sabre`: 20 matched of 20. After ppoll syscall 22, both retained logs have main-thread syscall 23 as stdout `fstat`; neither execution enters the formerly differing join futex at that point.\n- Control `system-utils/startup-tls-guards/verify@sabre`: 5 diverged of 5 at scheduler turn 3 and main-thread write syscall 49, with the stack canary and pointer guard differing. This shows the unchanged canonical comparison still reports a real divergence and that this change does not claim the separate startup TLS cause.\n\nThe harness classified each SaBRe row as failed because its separate execution-path qualification does not accept trusted libc sites. The retained path evidence nevertheless reports a complete path, guest RPC observed, and zero ptrace fallback sites. The counts above are the typed strict-comparison verdicts, not the harness process exit status.\n\nThe pre-fix evidence is identified by event content, not record position: pthread-lifecycle and lock-granularity differ across an ordinary child `Exit`, the following main-thread `FutexWait`, and the join futex result. The independently reproduced ppoll case in https://github.com/rrnewton/hermit/pull/2745 differs after ppoll syscall 22 when main-thread syscall 23 is the pthread-join futex in one execution and stdout `fstat` in the other.\n\nReverie main moved again after the pinned-tree measurement. A separate compatibility population used the same Hermit source commit `76b078dd5e64e5a3bdfec8d6d187db0f1094dca5` with exact Reverie main `d3cd29e2fef334108a4e99739a6a38a744628702`, the same kernel and capabilities, and a temporary checkout whose only tracked changes were the ten Reverie pin/lock files. These results are not mixed with the clean pinned-tree population:\n\n- SaBRe-only Hermit build passed.\n- pthread-lifecycle: 20 matched of 20.\n- lock-granularity: 20 matched terminal comparisons; 1 additional requested run timed out before any comparison and returned `no_result`.\n- ppoll-simulation: 20 matched of 20.\n- startup-TLS control: 5 divergences in 5 terminal comparisons; 1 additional requested run timed out before any comparison and returned `no_result`.\n- Event content remained stable in the sampled logs: pthread-lifecycle has the final ordinary child exit, then the main-thread `FutexWait`, then futex syscall 26 returning `Ok(0)` in both executions; ppoll-simulation has ppoll syscall 22 followed by stdout `fstat` as syscall 23 in both executions.\n\nNo full validate was run.\n\n## Human Review Required\n\nTrigger 4: this is a core DetCore scheduling change affecting when sibling threads may run across a thread-exit boundary.\n","created_at":"2026-08-27T12:09:19Z","updated_at":"2026-09-16T01:08:58Z","closed_at":null,"merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[{"id":11603596200,"node_id":"LA_kwDOIZiOrM8AAAACs6DTqA","url":"https://api.github.com/repos/rrnewton/hermit/labels/post-facto-human-review","name":"post-facto-human-review","color":"FFA500","default":false,"description":"Landed under post-facto protocol; needs human review","archived_at":null,"archived_by":null}],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/rrnewton/hermit/pulls/2747/commits","review_comments_url":"https://api.github.com/repos/rrnewton/hermit/pulls/2747/comments","review_comment_url":"https://api.github.com/repos/rrnewton/hermit/pulls/comments{/number}","comments_url":"https://api.github.com/repos/rrnewton/hermit/issues/2747/comments","statuses_url":"https://api.github.com/repos/rrnewton/hermit/statuses/b3901a992c99b99a79e53adc877c8d4324b1e92e","head":{"label":"rrnewton:hermit-125/pthread-exit-join","ref":"hermit-125/pthread-exit-join","sha":"b3901a992c99b99a79e53adc877c8d4324b1e92e","user":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","grav