rrnewton/hermit/downloads","issues_url":"https://api.github.com/repos/rrnewton/hermit/issues{/number}","pulls_url":"https://api.github.com/repos/rrnewton/hermit/pulls{/number}","milestones_url":"https://api.github.com/repos/rrnewton/hermit/milestones{/number}","notifications_url":"https://api.github.com/repos/rrnewton/hermit/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/rrnewton/hermit/labels{/name}","releases_url":"https://api.github.com/repos/rrnewton/hermit/releases{/id}","deployments_url":"https://api.github.com/repos/rrnewton/hermit/deployments","created_at":"2022-11-09T03:00:19Z","updated_at":"2026-09-17T19:31:24Z","pushed_at":"2026-09-17T19:31:22Z","git_url":"git://github.com/rrnewton/hermit.git","ssh_url":"git@github.com:rrnewton/hermit.git","clone_url":"https://github.com/rrnewton/hermit.git","svn_url":"https://github.com/rrnewton/hermit","homepage":null,"size":247745,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":562,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":562,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/3077"},"html":{"href":"https://github.com/rrnewton/hermit/pull/3077"},"issue":{"href":"https://api.github.com/repos/rrnewton/hermit/issues/3077"},"comments":{"href":"https://api.github.com/repos/rrnewton/hermit/issues/3077/comments"},"review_comments":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/3077/comments"},"review_comment":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/3077/commits"},"statuses":{"href":"https://api.github.com/repos/rrnewton/hermit/statuses/552c68b8f763e4fc431928b44e637b61d5d5d83a"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/rrnewton/hermit/pulls/3073","id":4560549215,"node_id":"PR_kwDOIZiOrM8AAAABD9R1Xw","html_url":"https://github.com/rrnewton/hermit/pull/3073","diff_url":"https://github.com/rrnewton/hermit/pull/3073.diff","patch_url":"https://github.com/rrnewton/hermit/pull/3073.patch","issue_url":"https://api.github.com/repos/rrnewton/hermit/issues/3073","number":3073,"state":"open","locked":false,"title":"Make a refused count say whether the tests it ran actually passed","user":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Make a refused count say whether the tests it ran actually passed\n\n[hermit2, assertions-3, claude-opus-5, devbig014, role=impl]\n\nPlain Language Summary and Project Impact\n\nWhen a node's test population drifts, the count ratchet refuses and the run\nrecords a product failure with no test ids. Measured on 2026-09-17 in the newest\nretained validate run: test.regular_crates reported \"507 tests run: 507 passed,\n0 skipped\" and was recorded as a product failure, because two tests had been\nadded and NEXTEST_EXPECTED_EXECUTED still said 505. A node where every single\ntest passed reads in the ledger as a broken product.\n\nThe refusal already knows the answer and does not say it. This change makes it\nsay it. A reader now sees whether a population drift was all-green or was hiding\nfailures, which is the difference between a bookkeeping update and a real\nregression.\n\nTask: structured-test-results-refused-dominates-validate-failures-and-hides-what-failed\n\nThe refusal message becomes \"expected 505 tests to execute, saw 507, of which\n507 passed and 0 failed; refusing because the selected set changed\". `passed`\nand `failed` are already computed twenty lines above for the\nstatus-disagreement check, so nothing new is derived.\n\nWHAT THIS DELIBERATELY DOES NOT DO, because it is the obvious change and it is\nwrong. The complete typed report is constructed four lines above the refusal and\ndiscarded by the early return. Moving the write above the check would publish a\ntest population nobody sanctioned, which is exactly what the ratchet exists to\nprevent, and run-nextest-counted.sh already asserts the file is absent:\n\n    [[ ! -e $scratch/launch-wrong-count.json && ! -e $scratch/launch-wrong-cpu.json ]]\n\nThat assertion is untouched and still passes. The typed report stays withheld;\nonly the diagnostic gains the outcome. So the message is the only place the run\ncan say what happened, which is why it is worth saying there.\n\nDeterminism\n\nNo random, scheduling, timing or comparison behaviour changes. This alters one\nerror string's content. The refusal fires on exactly the same condition, returns\nthe same Err, writes the same absence of files, and yields the same non-zero\nstatus. No assertion, tolerance, comparator or gate was weakened.\n\nLinux Semantics\n\nNo guest syscall, process or exit-status behaviour is affected.\n\nValidation\n\n./ci/run-nextest-counted.sh --self-test in the pinned image:\n  with the change     \"run-nextest-counted: self-test PASS\", rc 0\n  change reverted     rc 1, and that PASS line absent\n\nSo the new assertion genuinely binds. The pre-existing assertion\n'expected 1 tests to execute, saw 0' still matches as a substring of the longer\nmessage and was not edited, so it is not being made to pass by this change.\n\nNot claimed: this is the script's own self-test in the pinned image, not a\nvalidation run. It does not change any node's verdict -- a drifted population\nstill fails -- it changes only what the failure is able to say.\n\nNote for a later reader: ci/nextest-test-results.rs is not rustfmt-clean under\n--edition 2024 at its own import block, identically before and after this\nchange. I left that alone; it is unrelated and the lint node does not format\nrust-scripts.\n\n","created_at":"2026-09-17T16:07:09Z","updated_at":"2026-09-17T16:21:01Z","closed_at":null,"merged_at":null,"merge_commit_sha":"f805b2b7465f908a3835d3b37b538c06c62482e4","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/rrnewton/hermit/pulls/3073/commits","review_comments_url":"https://api.github.com/repos/rrnewton/hermit/pulls/3073/comments","review_comment_url":"https://api.github.com/repos/rrnewton/hermit/pulls/comments{/number}","comments_url":"https://api.github.com/repos/rrnewton/hermit/issues/3073/comments","statuses_url":"https://api.github.com/repos/rrnewton/hermit/statuses/62cb9321b8c95cf184904d98cf03677fcbe8f2fb","head":{"label":"rrnewton:assertions-3/count-refusal-says-what-ran","ref":"assertions-3/count-refusal-says-what-ran","sha":"62cb9321b8c95cf184904d98cf03677fcbe8f2fb","user":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":563646124,"node_id":"R_kgDOIZiOrA","name":"hermit","full_name":"rrnewton/hermit","private":false,"owner":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/rrnewton/hermit","description":"Hermit launches linux x86_64 programs in a special, hermetically isolated sandbox to control their execution. Hermit translates normal, nondeterministic behavior, into deterministic, repeatable behavior. This can be used for various applications, including replay-debugging, reproducible artifacts, chaos mode concurrency testing and bug analysis.","fork":true,"url":"https://api.github.com/repos/rrnewton/hermit","forks_url":"https://api.github.com/repos/rrnewton/hermit/forks","keys_url":"https://api.github.com/repos/rrnewton/hermit/keys{/key_id}","collaborators_url":"https://api.github.com/repos/rrnewton/hermit/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/rrnewton/hermit/teams","hooks_url":"https://api.github.com/repos/rrnewton/hermit/hooks","issue_events_url":"https://api.github.com/repos/rrnewton/hermit/issues/events{/number}","events_url":"https://api.github.com/repos/rrnewton/hermit/events","assignees_url":"https://api.github.com/repos/rrnewton/hermit/assignees{/user}","branches_url":"https://api.github.com/repos/rrnewton/hermit/branches{/branch}","tags_url":"https://api.github.com/repos/rrnewton/hermit/tags","blobs_url":"https://api.github.com/repos/rrnewton/hermit/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/rrnewton/hermit/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/rrnewton/hermit/git/refs{/sha}","trees_url":"https://api.github.com/repos/rrnewton/hermit/git/trees{/sha}","statuses_url":"https://api.github.com/repos/rrnewton/hermit/statuses/{sha}","languages_url":"https://api.github.com/repos/rrnewton/hermit/languages","stargazers_url":"https://api.github.com/repos/rrnewton/hermit/stargazers","contributors_url":"https://api.github.com/repos/rrnewton/hermit/contributors","subscribers_url":"https://api.github.com/repos/rrnewton/hermit/subscribers","subscription_url":"https://api.github.com/repos/rrnewton/hermit/subscription","commits_url":"https://api.github.com/repos/rrnewton/hermit/commits{/sha}","git_