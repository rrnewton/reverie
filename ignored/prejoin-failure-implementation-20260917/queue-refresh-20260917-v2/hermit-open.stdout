uages_url":"https://api.github.com/repos/rrnewton/hermit/languages","stargazers_url":"https://api.github.com/repos/rrnewton/hermit/stargazers","contributors_url":"https://api.github.com/repos/rrnewton/hermit/contributors","subscribers_url":"https://api.github.com/repos/rrnewton/hermit/subscribers","subscription_url":"https://api.github.com/repos/rrnewton/hermit/subscription","commits_url":"https://api.github.com/repos/rrnewton/hermit/commits{/sha}","git_commits_url":"https://api.github.com/repos/rrnewton/hermit/git/commits{/sha}","comments_url":"https://api.github.com/repos/rrnewton/hermit/comments{/number}","issue_comment_url":"https://api.github.com/repos/rrnewton/hermit/issues/comments{/number}","contents_url":"https://api.github.com/repos/rrnewton/hermit/contents/{+path}","compare_url":"https://api.github.com/repos/rrnewton/hermit/compare/{base}...{head}","merges_url":"https://api.github.com/repos/rrnewton/hermit/merges","archive_url":"https://api.github.com/repos/rrnewton/hermit/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/rrnewton/hermit/downloads","issues_url":"https://api.github.com/repos/rrnewton/hermit/issues{/number}","pulls_url":"https://api.github.com/repos/rrnewton/hermit/pulls{/number}","milestones_url":"https://api.github.com/repos/rrnewton/hermit/milestones{/number}","notifications_url":"https://api.github.com/repos/rrnewton/hermit/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/rrnewton/hermit/labels{/name}","releases_url":"https://api.github.com/repos/rrnewton/hermit/releases{/id}","deployments_url":"https://api.github.com/repos/rrnewton/hermit/deployments","created_at":"2022-11-09T03:00:19Z","updated_at":"2026-09-17T19:31:24Z","pushed_at":"2026-09-17T19:31:22Z","git_url":"git://github.com/rrnewton/hermit.git","ssh_url":"git@github.com:rrnewton/hermit.git","clone_url":"https://github.com/rrnewton/hermit.git","svn_url":"https://github.com/rrnewton/hermit","homepage":null,"size":247745,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":562,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":562,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/2368"},"html":{"href":"https://github.com/rrnewton/hermit/pull/2368"},"issue":{"href":"https://api.github.com/repos/rrnewton/hermit/issues/2368"},"comments":{"href":"https://api.github.com/repos/rrnewton/hermit/issues/2368/comments"},"review_comments":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/2368/comments"},"review_comment":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/2368/commits"},"statuses":{"href":"https://api.github.com/repos/rrnewton/hermit/statuses/26276e2b266e944bc02ff775b4ceb5cb0956019e"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/rrnewton/hermit/pulls/2302","id":4291117605,"node_id":"PR_kwDOIZiOrM7_xUIl","html_url":"https://github.com/rrnewton/hermit/pull/2302","diff_url":"https://github.com/rrnewton/hermit/pull/2302.diff","patch_url":"https://github.com/rrnewton/hermit/pull/2302.patch","issue_url":"https://api.github.com/repos/rrnewton/hermit/issues/2302","number":2302,"state":"open","locked":false,"title":"Land M2 canonical verification and fix remaining measured reds","user":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"[hermit2, sanity-driver, unresolved, devbig014, role=impl]\n\n## Plain Language Summary and Project Impact\n\nLand the existing M2 implementation range that makes canonical verification the only verification policy, adds the record/replay path and DBT evidence handling, updates the compatibility and scorecard consumers, and carries the corresponding tests and documentation. The scheduler and signal commits resolve the measured shutdown and fork/SIGKILL/waitpid INFO-order failures that remained after re-running the three bounded reproductions on the rescued branch. The final gate commits assign the three rescued record/replay C fixtures to their actual Cargo integration-test owner and keep every pressure self-test plan inside one checked-scorecard boundary.\n\nBefore this range, M2 work existed in local commits and an uncommitted checkout and could not be reviewed or landed as one durable artifact. After it, the complete nine-commit range is published, the inherited dirty state is preserved in `79cc84087904bf7069cef9c585a2eac041341d40`, and the two reproduced failures have focused fixes and durable regression coverage. The Node wait4 red did not reproduce on the rescued branch or the final implementation, so this PR makes no Node-specific change.\n\nTask: sanity-driver-commit-hermit-then-drive-m2\n\n## Determinism\n\nCanonical verification compares exit status, stdout, stderr, and nonempty INFO observations under the repository's `BitwiseInfoV1` policy. The scheduler shutdown fix emits the existing terminal diagnostic exactly once at the terminal observation rather than once per host-loop pass. For process-directed `SIGKILL`, Hermit forwards the real signal, keeps the killing thread inside Hermit until the scheduler no longer reports the target as live, and publishes lifecycle diagnostics through scheduler-controlled RPC before the guest can proceed to `waitpid`. Inbound-signal INFO is published only after the scheduler grants delivery. Therefore host callback timing cannot choose the compared INFO order or whether the parent reaches `waitpid` before target removal.\n\nThe fork/SIGKILL/waitpid regression runs five canonical ptrace strict verifications and requires `verdict: matched`, `bitwise_parity: true`, and nonzero compared INFO counts on both sides.\n\n## Linux Semantics\n\nThe kernel still receives the real `SIGKILL`, and unsuccessful `kill` results return without entering the completion barrier. The parent reaps the kernel-produced child status and the regression requires `WIFSIGNALED` with `WTERMSIG == SIGKILL`; no synthetic child status is substituted. The M2 verification changes compare and report execution rather than altering guest-visible syscall results.\n\n## Validation\n\nExact head: `39829148def0dd3278e607e33c9885e248a605a6`\n\nBase: `rrnewton/hermit:main` at `302a1a9c0fde564db0292d1ea5cabc91343e79bc`\n\n- `cargo fmt --all -- --check` — passed\n- `git diff --check` — passed\n- `env CARGO_BUILD_JOBS=1 cargo test -p hermit-detcore --lib` — 420 passed, 0 failed\n- `timeout --kill-after=10s 120s env CARGO_BUILD_JOBS=1 cargo test -p hermit --test signal_determinism -- --nocapture --test-threads=1` — 13 passed, 0 failed\n- `timeout --kill-after=10s 90s env CARGO_BUILD_JOBS=1 cargo test -p hermit --test record_replay record_rs_sched_yield -- --nocapture --test-threads=1` — 1 passed, 0 failed\n- `env CARGO_BUILD_JOBS=1 cargo clippy -p hermit-detcore -p hermit --all-targets -- -D warnings` — passed\n- `./ci/test_harness.sh audit-inventory` — passed with all 552 tracked test files classified\n- `./ci/compat-envelope/pressure-test.rs self-test` — passed, including exact/batch wording, scorecard and manifest refusal, generated-DAG, and result-identity brackets\n- fork/SIGKILL/waitpid: L2, ptrace backend, INFO log level, no relaxations — five exact-head strict verification iterations passed with matched JSON, bitwise parity, and nonzero INFO counts\n- Node wait4: L2, ptrace backend, INFO log level, no relaxations — direct bounded reproductions passed; the harness attempts that returned `no_result` were rejected before guest execution by host ptrace policy and are not counted as cell failures\n\nThe first full-profile validation at `3f71ddc2924888e4a97aa6be97e584f4d3c52efa` stopped at `gate.manifest` because the three rescued C fixtures had no inventory disposition. Commit `a9056179d042811df01e642ffe73a499aded1e54` records them as guest fixtures owned and exercised by `hermit-cli/tests/record_replay.rs`. The next run reached the same gate and exposed one new pressure self-test plan rechecking the scorecard plus a stale one-cell replay premise; `39829148def0dd3278e607e33c9885e248a605a6` fixes both without changing the four-compilation ceiling.\n\nThe full-profile run at exact head `39829148def0dd3278e607e33c9885e248a605a6` passed `gate.manifest`, including the inventory, pressure self-test, four-compilation bracket, and committed-DAG correspondence. It then stopped in `build.workspace`: Hermit reads `DbtRuntimeCallbacks.emit_evidence` and `.evidence_log_level`, but the pinned Reverie `c261050cfd41bec67e31bfd0cf6f56be008d0ebb` does not define those fields. The canonical receipt is `NEEDS-RERUN`; this is not a qualifying green receipt.\n\nThis is not a whole-workspace or all-backend completion claim. The rescued inherited range is large (118 changed paths against the listed base) and requires exact-head CI plus adversarial review before landing.\n\n## Cross-repository dependency\n\nThe required protected DBT evidence API is now durable in Reverie PR https://github.com/rrnewton/reverie/pull/459 at exact head `eae94035ea7313d0b0d1b129a9fbb9c2c30fa3d8`. That PR contains the six-path owner-authorized rescue that defines `emit_evidence`, `evidence_log_level`, the protected transport and collector, and its adversarial/live tests.\n\nThis Hermit PR cannot build or land until Reverie #459 is reviewed and landed on `rrnewton/reverie:main`, after which the Hermit pin must be deliberately advanced to its landed SHA. Reusing the ordinary diagnostic emitter would remove the protected evidence boundary and is not an acceptable workaround.\n\n## Human Review Required\n\n- Trigger 3: the range establishes canonical verification and protected DBT evidence behavior as a determinization strategy.\n- Trigger 4: the final fixes change core DetCore scheduler-controlled event ordering for terminal shutdown and process-directed `SIGKILL`.\n\nReview the full nine-commit range, with particular attention to the rescued implementation commit `79cc84087904bf7069cef9c585a2eac041341d40`, the scheduler INFO change in `60fbfd612b57b615f152f071a6bbcac09064185e`, and the SIGKILL completion barrier in `3f71ddc2924888e4a97aa6be97e584f4d3c52efa`.\n","created_at":"2026-08-16T18:02:00Z","updated_at":"2026-09-13T11:20:36Z","closed_at":null,"merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[{"id":11603596200,"node_id":"LA_kwDOIZiOrM8AAAACs6DTqA","url":"https://api.github.com/repos/rrnewton/hermit/labels/post-facto-human-review","name":"post-facto-human-review","color":"FFA500","default":false,"description":"Landed under post-facto protocol; needs human review","archived_at":null,"archived_by":null},{"id":11918294697,"node_id":"LA_kwDOIZiOrM8AAAACxmK-qQ","url":"https://api.github.com/repos/rrnewton/hermit/labels/category:other","name":"category:other","color":"CCCCCC","default":false,"description":"Unclassified; the owner will triage these","archived_at":null,"archived_by":null}],"milestone":null,"draft":true,"commits_url":"https://api.github.com/repos/rrnewton/hermit/pulls/2302/commits","review_comments_url":"https://api.github.com/repos/rrnewton/hermit/pulls/2302/comments","review_comment_url":"https://api.github.com/repos/rrnewton/hermit/pulls/comments{/number}","comments_url":"https://api.github.com/repos/rrnewton/hermit/issues/2302/comments","statuses_url":"https://api.github.com/repos/rrnewton/hermit/statuses/d16a0f1c12626ac7991a354b9597b135633ea25c","head":{"label":"rrnewton:codex/m2-sanity-driver","ref":"codex/m2-sanity-driver","sha":"d16a0f1c12626ac7991a354b9597b135633ea25c","user":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":563646124,"node_id":"R_kgDOIZiOrA","name":"hermit","full_