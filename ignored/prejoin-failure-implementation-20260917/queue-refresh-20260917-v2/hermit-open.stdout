"open_issues":562,"watchers":1,"default_branch":"main"}},"base":{"label":"rrnewton:main","ref":"main","sha":"bae4a34fec5bfe45dd8cad00adcd5b6ddb04abcc","user":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":563646124,"node_id":"R_kgDOIZiOrA","name":"hermit","full_name":"rrnewton/hermit","private":false,"owner":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/rrnewton/hermit","description":"Hermit launches linux x86_64 programs in a special, hermetically isolated sandbox to control their execution. Hermit translates normal, nondeterministic behavior, into deterministic, repeatable behavior. This can be used for various applications, including replay-debugging, reproducible artifacts, chaos mode concurrency testing and bug analysis.","fork":true,"url":"https://api.github.com/repos/rrnewton/hermit","forks_url":"https://api.github.com/repos/rrnewton/hermit/forks","keys_url":"https://api.github.com/repos/rrnewton/hermit/keys{/key_id}","collaborators_url":"https://api.github.com/repos/rrnewton/hermit/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/rrnewton/hermit/teams","hooks_url":"https://api.github.com/repos/rrnewton/hermit/hooks","issue_events_url":"https://api.github.com/repos/rrnewton/hermit/issues/events{/number}","events_url":"https://api.github.com/repos/rrnewton/hermit/events","assignees_url":"https://api.github.com/repos/rrnewton/hermit/assignees{/user}","branches_url":"https://api.github.com/repos/rrnewton/hermit/branches{/branch}","tags_url":"https://api.github.com/repos/rrnewton/hermit/tags","blobs_url":"https://api.github.com/repos/rrnewton/hermit/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/rrnewton/hermit/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/rrnewton/hermit/git/refs{/sha}","trees_url":"https://api.github.com/repos/rrnewton/hermit/git/trees{/sha}","statuses_url":"https://api.github.com/repos/rrnewton/hermit/statuses/{sha}","languages_url":"https://api.github.com/repos/rrnewton/hermit/languages","stargazers_url":"https://api.github.com/repos/rrnewton/hermit/stargazers","contributors_url":"https://api.github.com/repos/rrnewton/hermit/contributors","subscribers_url":"https://api.github.com/repos/rrnewton/hermit/subscribers","subscription_url":"https://api.github.com/repos/rrnewton/hermit/subscription","commits_url":"https://api.github.com/repos/rrnewton/hermit/commits{/sha}","git_commits_url":"https://api.github.com/repos/rrnewton/hermit/git/commits{/sha}","comments_url":"https://api.github.com/repos/rrnewton/hermit/comments{/number}","issue_comment_url":"https://api.github.com/repos/rrnewton/hermit/issues/comments{/number}","contents_url":"https://api.github.com/repos/rrnewton/hermit/contents/{+path}","compare_url":"https://api.github.com/repos/rrnewton/hermit/compare/{base}...{head}","merges_url":"https://api.github.com/repos/rrnewton/hermit/merges","archive_url":"https://api.github.com/repos/rrnewton/hermit/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/rrnewton/hermit/downloads","issues_url":"https://api.github.com/repos/rrnewton/hermit/issues{/number}","pulls_url":"https://api.github.com/repos/rrnewton/hermit/pulls{/number}","milestones_url":"https://api.github.com/repos/rrnewton/hermit/milestones{/number}","notifications_url":"https://api.github.com/repos/rrnewton/hermit/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/rrnewton/hermit/labels{/name}","releases_url":"https://api.github.com/repos/rrnewton/hermit/releases{/id}","deployments_url":"https://api.github.com/repos/rrnewton/hermit/deployments","created_at":"2022-11-09T03:00:19Z","updated_at":"2026-09-17T19:31:24Z","pushed_at":"2026-09-17T19:31:22Z","git_url":"git://github.com/rrnewton/hermit.git","ssh_url":"git@github.com:rrnewton/hermit.git","clone_url":"https://github.com/rrnewton/hermit.git","svn_url":"https://github.com/rrnewton/hermit","homepage":null,"size":247745,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":562,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":562,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/2747"},"html":{"href":"https://github.com/rrnewton/hermit/pull/2747"},"issue":{"href":"https://api.github.com/repos/rrnewton/hermit/issues/2747"},"comments":{"href":"https://api.github.com/repos/rrnewton/hermit/issues/2747/comments"},"review_comments":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/2747/comments"},"review_comment":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/2747/commits"},"statuses":{"href":"https://api.github.com/repos/rrnewton/hermit/statuses/b3901a992c99b99a79e53adc877c8d4324b1e92e"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/rrnewton/hermit/pulls/2694","id":4368658783,"node_id":"PR_kwDOIZiOrM8AAAABBGRxXw","html_url":"https://github.com/rrnewton/hermit/pull/2694","diff_url":"https://github.com/rrnewton/hermit/pull/2694.diff","patch_url":"https://github.com/rrnewton/hermit/pull/2694.patch","issue_url":"https://api.github.com/repos/rrnewton/hermit/issues/2694","number":2694,"state":"open","locked":false,"title":"Preserve inherited stdio flags and append writes across run and replay","user":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"[hermit2, dev-hermit, gpt-6-astra, devbig014, role=impl]\n\n## Plain Language Summary and Project Impact\n\nA guest can inherit the same Linux open file descriptions as Hermit and its caller. Forwarding `fcntl(F_SETFL)` could leave `O_APPEND` set on the caller's output after the guest exits; a later verification run then observes different state. This change keeps supported inherited status flags in Detcore's shared description model, preserves the caller's physical flags, and performs logical append writes after scheduler admission through a kernel append operation. It supports faithful repeated execution and record/replay of programs using redirected output.\n\nRecovered head: `46670790208e71be0b1aa0e249297c0f4b38663a`, tree `2c5ffe82932954367046ae55a43c0a94e1afa6a1`, based on main `dade02611a0988aaa2f234411c16462fdbfb5519`. The final diff has 22 paths. Original commit authors/messages and intentional empty history entries remain; earlier main prerequisite repairs have been incorporated rather than duplicated in the final product diff. This description replaces the historical seek-before-write implementation and stale source/count claims.\n\nTask: `astra-lane-drains-hermit-reverie-pr-queues-to-zero`\n\n## Summary\n\n- Inherited stdin/stdout/stderr start with their real status flags. `kcmp(KCMP_FILE)` detects descriptions already shared by those descriptors; aliases keep one logical flag word. A comparison error retains exact descriptors/errno, rejects partial initialization and is refused before scheduler startup, including both eager and lazy DBT exports. It is not silently treated as proof of different descriptions.\n- `F_SETFL` models `O_APPEND`. Only `O_NONBLOCK` is forwarded, with the logical and physical state updated together. The caller's other physical bits remain intact. Unsupported changes to `O_ASYNC`, `O_DIRECT` and `O_NOATIME`, and clearing caller-supplied physical append, retain the existing explicit `EOPNOTSUPP` refusal.\n- Nonstdio `F_GETFL` again hides scheduler-forced physical `O_NONBLOCK` while exposing the guest's logical state. The recovery preserves negative-offset rejection for `pwrite64` and `pwritev`.\n- For inherited regular-file append, all admitted write paths read the shared logical flags after resource admission. Scalar writes use a two-entry scratch iovec and the required oversized-range guard; vectors retain their original vector shape. Converted `pwritev2(RWF_APPEND)` uses offset -1 for ordinary write/writev and preserves explicit positional-write offsets. `RWF_NOAPPEND`, zero writes, partial completion and fatal Tool errors retain their distinct rules. Scratch/preparation failure still releases resources. Pipes, sockets and existing captured-output behavior keep their original paths.\n- Each recovered C fixture has a caller-owned temporary directory, lasting across all of that test's invocations. Fixture executables use Cargo's visible temporary root, preserving the original Command/Stdio aliases and assertions. Current manifest declarations and prepared selectors match measured test identities; deleted legacy graphs are not restored.\n\n## Determinism\n\nThe shared description model prevents one inherited alias or verification run from leaving an unmodeled append bit on the caller. Append positioning is performed by the injected kernel write after admission; there is no pre-admission lseek or sampled EOF to become stale while waiting. Native ordered controls prove the requested admission/flag-read/release boundaries and meaningful restored defects fail those controls. The actual ptrace recording control checks the real `WriteV2` and debug syscall records and replay effects.\n\nThis changes the inherited-descriptor determinization strategy, not the verifier comparator. Existing syscall-output comparisons, test identities, deadlines and failure oracles remain. Hermit does not make arbitrary external file writers deterministic. A kernel append operation is not a claim that a multi-iteration short-write loop is atomic against every external writer.\n\n## Linux Semantics\n\nAccess/creation bits retain Linux's `F_SETFL` treatment. The guest model and supervisor's physical status word are deliberately distinct. `O_NONBLOCK` is the explicit physical exception needed by the current scheduler. Unsupported inherited flag transitions remain intentional, visible refusals rather than successful operations with fictitious behavior.\n\nThe scalar/vector translation preserves the measured Linux errno, content, file size, physical flags and OFD position, including invalid/negative offsets, huge buffers, zero writes and partial results. The second zero-length scalar iovec avoids Linux's one-iovec optimization changing scalar access-range precedence. The native reference campaign qualifies the measured x86-64 regular-file ABI; it does not establish every filesystem, architecture or backend.\n\nBroader operations that can modify the inherited backing object (`ftruncate`, `fchmod`, record locks) remain outside this focused flag repair. No universal stdio isolation claim is made. `kcmp` denial is now an explicit startup failure; host support is not assumed and no unchecked alternative comparison is used.\n\n## Relationship to gVisor and backend limits\n\ngVisor separates sandbox application file descriptions from the runtime's descriptions. This change uses Detcore's existing shared open-file-description model and syscall mediation; it introduces no second determinism engine.\n\nThe current Reverie pin is `8c8c0a57649c9ffbf8a7a14291a64320f64b935f`. The new actual guest qualification is ptrace. KVM remains dependent on the positioned-vector and decoder work in https://github.com/rrnewton/reverie/pull/538; its review findings and unexecuted mixed iovec-import-order case remain explicit. Existing KVM test identities/admitted operation scopes are retained, but no new KVM pass is claimed here. Native DBT export/startup controls are evidence of those paths, not DBT append guest qualification. No DBT, SaBRe or KVM append equivalence is inferred from ptrace or native success.\n\n## Validation\n\nAll numbers below retain their actual source and executable attribution. Historical native qualification is tied to its recorded source snapshots and preserved commit/blob mappings; it is not relabeled as a fresh run at this head.\n\n| Population | Actual result | Time |\n| --- | --- | ---: |\n| Alias/startup native qualification | Ten unique Rust tests, including eight new actual-path controls; all nine build/list/lint stages passed | 55.732 s total |\n| Append native handler qualification | Five new parent controls plus one nested child with 84 Linux-reference/actual-handler pairs; three existing error controls preserved | 52.899 s stages |\n| Five restored append defects | Every mutant failed the exact substantive assertion with Cargo 101; no setup/timeout/cap failure credited | 36.076 s native stages |\n| Restored positive controls | Five append parents, one child with all 84 pairs, and three original error controls passed | 7.548 s stages |\n| Original CLI at recovered head | **FAILED: 87 executed, 85 passed, one assertion failure and one timeout, 44 filtered**, all attempt 1 | 150.669 s Nextest; 276.346 s dispatch |\n| Independent full unit selection at recovered head | **FAILED: 533 executed, 529 passed, two assertion failures and two timeouts, zero filtered**, all attempt 1 | 138.436 s Nextest; 201.832 s dispatch |\n\nAll nine new stdio CLI cases passed through the original descriptor objects and assertions. The actual `inherited_append_record_replay_preserves_recorded_offsets_and_ofd` unit test passed in 2.409 seconds: native reference, nonverify ptrace record and autopilot replay returned guest exit 37; the real event reader required six `WriteV2` events and exact converted syscall arguments, recorded offsets, file bytes, physical flags and shared OFD position. It ran with info logs and strict recording. Its temporary event/log directory was removed by subsequent official run-state cleanup; the raw PASS/count entry, exact executed source/binary and runtime binding are retained, but no surviving external copy of that event archive is claimed.\n\nThe six failed test bodies are unchanged from main. This is a source comparison, **not a claim that baseline main was run and reproduced them**. Current diagnostics are:\n\n- CLI `record_classifies_a_gdbserver_replay_stage_container_child_failure`: the original 57.003-second Nextest timeout; cause remains under investigation.\n- CLI `sigint_instakill_reports_a_signal_death_not_a_policy_refusal`: unchanged guest-discovery assertion after 30.042 seconds. The independently landed main fixture incorrectly supplied unsupported `--argv0=cat`; the supported bare-`cat` repair passed the original targeted SIGINT test separately in 0.607 seconds and landed on main as `0838ee98a712b2c31ebead7594f9e0cec15c38d7`. This feature head retains the original failed fixture and result. The buffered parser diagnostic was not captured by this failed campaign.\n- Unit `dbt_public_dispatch_runs_echo_through_detcore` and `dbt_public_status_dispatch_runs_true_through_detcore`: original 57.003-second timeouts; the latter retains the actual `Unable to load client library: libc.so.6` diagnostic.\n- Unit `non_e9patch_validation_preserves_parent_component_paths`: `/usr/bin/../bin/echo` is absent in the current image.\n- Unit `requested_logs_survive_log_comparison_io_error`: its explicit mode-000 unreadability precondition failed in the current container.\n\nNo case was skipped, quarantined, retried or weakened to turn those populations green. The earlier CLI result (72 passed / 15 failed), compiler/observer failures and main manifest-gate failures remain separate. The last manifest gate remains **UNQUALIFIED**, with null node/driver statuses and post-rescue -9. The independently authorized compiler and product-only campaigns did not manufacture a gate pass or universal validation receipt.\n\nCurrent image: `localhost/hermit-hermetic-validate@sha256:882414fd2b1eb9c1bdc6924ab1cc8b508151e678ea5e07129bd891bb33bb2b52`. Normal source-bound compiler/bundle and host-script producers were used, with genuine prepared-reader checks. All 1,156 bound runtime inputs (4,588,959,581 bytes), source/index and historical inputs were retained before mutation. CLI/unit payload and conmon PIDs were checked in the exact node cgroup before release, with unchanged CPU/memory/swap/file/stream limits; both campaigns closed captures below cap and removed their exact processes/cgroups before rescue. Full cleanup and source/artifact readbacks passed. These are bounded local qualification results, not official receipt or whole-project success.\n\nRetained evidence is indexed in `/tmp/astra-reverie-2694-recovery/stdio-publication-plan/evidence-map.json`, with full source/history proof in `source-proof.json`. Current CLI report: `corrected-product-runtime-result/report.md`; independent unit report: `independent-unit-runtime-result-v2/report.md`; exact original-source/binary maps and immutable raw manifests are adjacent.\n\n## Human Review Required\n\nTrigger 3 applies: inherited status flags and append behavior use a changed determinization strategy. Review the alias-error startup boundary, logical/physical nonblocking distinction, post-admission flag read, Linux scalar/vector error ordering, scratch lifetime/resource release, and actual recorder/replayer integration. The code uses already admitted write-family syscalls; this Hermit patch does not change the Reverie Tool/Guest/Backend API. The pending Reverie dependency has its own required review.\n\nThe recovery author does not supply independent approval. Historical labels and approvals refer to earlier heads. Fresh non-author Codex-family and Claude-family exact-head review is still required, and the existing review-history ambiguity must be explicitly resolved by the responsible coordinator/reviewer before landing. Speculative qualification does not waive those source-review obligations.\n","created_at":"2026-08-26T15:50:09Z","updated_at":"2026-09-16T01:47:32Z","closed_at":null,"merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[{"id":11603596200,"node_id":"LA_kwDOIZiOrM8AAAACs6DTqA","url":"https://api.github.com/repos/rrnewton/hermit/labels/post-facto-human-review","name":"post-facto-human-review","color":"FFA500","default":false,"description":"Landed under post-facto protocol; needs human review","archived_at":null,"archived_by":null},{"id":11681812195,"node_id":"LA_kwDOIZiOrM8AAAACuEpO4w","url":"https://api.github.com/repos/rrnewton/hermit/labels/adversarial-review-codex1","name":"adversarial-review-codex1","color":"5319e7","default":false,"description":"Codex adversarial review round 1 completed","archived_at":null,"archived_by":null},{"id":11681812218,"node_id":"LA_kwDOIZiOrM8AAAACuEpO-g","url":"https://api.github.com/repos/rrnewton/hermit/labels/adversarial-review-claude1","name":"adversarial-review-claude1","color":"1D76DB","default":false,"description":"Adversarial review pass, claude lane (round 1)","archived_at":null,"archived_by":null},{"id":11721084220,"node_id":"LA_kwDOIZiOrM8AAAACuqGNPA","url":"https://api.github.com/repos/rrnewton/hermit/labels/adversarial-review-codex2","name":"adversarial-review-codex2","color":"BFD4F2","default":false,"description":"Codex adversarial review round 2 conducted","archived_at":null,"archived_by":null}],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/rrnewton/hermit/pulls/2694/commits","review_comments_url":"https://api.github.com/repos/rrnewton/hermit/pulls/2694/comments","review_comment_url":"https://api.github.com/repos/rrnewton/hermit/pulls/comments{/number}","comments_url":"https://api.github.com/repos/rrnewton/hermit/issues/2694/comments","statuses_url":"https://api.github.com/repos/rrnewton/hermit/statuses/46670790208e71be0b1aa0e249297c0f4b38663a","head":{"label":"rrnewton:fix/kvm-verify-stderr-oappend-leak","ref":"fix/kvm-verify-stderr-oappend-leak","sha":"46670790208e71be0b1aa0e249297c0f4b38663a","user":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":563646124,"node_id":"R_kgDOIZiOrA","name":"hermit","full_name":"rrnewton/hermit","private":false,"owner":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/rrnewton/hermit","description":"Hermit launches linux x86_64 programs in a special, hermetically isolated sandbox to control their execution. Hermit translates normal, nondeterministic behavior, into deterministic, repeatable behavior. This can be used for various applications, including replay-debugging, reproducible artifacts, chaos mode concurrency testing and bug analysis.","fork":true,"url":"https://api.github.com/repos/rrnewton/hermit","forks_url":"https://api.github.com/repos/rrnewton/hermit/forks","keys_url":"https://api.github.com/repos/rrnewton/hermit/keys{/key_id}","collaborators_url":"https://api.github.com/repos/rrnewton/hermit/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/rrnewton/hermit/teams","hooks_url":"https://api.github.com/repos/rrnewton/hermit/hooks","issue_events_url":"https://api.github.com/repos/rrnewton/hermit/issues/events{/number}","events_url":"https://api.github.com/repos/rrnewton/hermit/events","assignees_url":"https://api.github.com/repos/rrnewton/hermit/assignees{/user}","branches_url":"https://api.github.com/repos/rrnewton/hermit/branches{/branch}","tags_url":"https://api.github.com/repos/rrnewton/hermit/tags","blobs_url":"https://api.github.com/repos/rrnewton/herm