ithub.com/repos/rrnewton/hermit/issues{/number}","pulls_url":"https://api.github.com/repos/rrnewton/hermit/pulls{/number}","milestones_url":"https://api.github.com/repos/rrnewton/hermit/milestones{/number}","notifications_url":"https://api.github.com/repos/rrnewton/hermit/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/rrnewton/hermit/labels{/name}","releases_url":"https://api.github.com/repos/rrnewton/hermit/releases{/id}","deployments_url":"https://api.github.com/repos/rrnewton/hermit/deployments","created_at":"2022-11-09T03:00:19Z","updated_at":"2026-09-17T19:31:24Z","pushed_at":"2026-09-17T19:31:22Z","git_url":"git://github.com/rrnewton/hermit.git","ssh_url":"git@github.com:rrnewton/hermit.git","clone_url":"https://github.com/rrnewton/hermit.git","svn_url":"https://github.com/rrnewton/hermit","homepage":null,"size":247745,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":562,"license":{"key":"other","name":"Other","spdx_id":"NOASSERTION","url":null,"node_id":"MDc6TGljZW5zZTA="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":562,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/2302"},"html":{"href":"https://github.com/rrnewton/hermit/pull/2302"},"issue":{"href":"https://api.github.com/repos/rrnewton/hermit/issues/2302"},"comments":{"href":"https://api.github.com/repos/rrnewton/hermit/issues/2302/comments"},"review_comments":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/2302/comments"},"review_comment":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/rrnewton/hermit/pulls/2302/commits"},"statuses":{"href":"https://api.github.com/repos/rrnewton/hermit/statuses/d16a0f1c12626ac7991a354b9597b135633ea25c"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/rrnewton/hermit/pulls/1689","id":4221494945,"node_id":"PR_kwDOIZiOrM77nuah","html_url":"https://github.com/rrnewton/hermit/pull/1689","diff_url":"https://github.com/rrnewton/hermit/pull/1689.diff","patch_url":"https://github.com/rrnewton/hermit/pull/1689.patch","issue_url":"https://api.github.com/repos/rrnewton/hermit/issues/1689","number":1689,"state":"open","locked":false,"title":"Honor DBT host log files across fork and exec","user":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","followers_url":"https://api.github.com/users/rrnewton/followers","following_url":"https://api.github.com/users/rrnewton/following{/other_user}","gists_url":"https://api.github.com/users/rrnewton/gists{/gist_id}","starred_url":"https://api.github.com/users/rrnewton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rrnewton/subscriptions","organizations_url":"https://api.github.com/users/rrnewton/orgs","repos_url":"https://api.github.com/users/rrnewton/repos","events_url":"https://api.github.com/users/rrnewton/events{/privacy}","received_events_url":"https://api.github.com/users/rrnewton/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"[hermit2, degraded-unresolved, gpt-6-astra, devbig014, role=impl]\n\n## Plain Language Summary and Project Impact\n\nRestore ordinary DBT `--log-file` support using the file opened in the host namespace. The remaining work is to port this draft's logging intent onto current main, preserve the existing log-size policy, and carry the selected log level across fork and followed exec, including an empty environment.\n\nThe public draft is still the older implementation at `96eeb0d603875e595f36d6ce97fc77a998ea53a2`. Its historical guest-path approach and old validation claims are not current-main qualification. The current recovery uses the existing `DbtRunner::diagnostic_file` descriptor route as its starting point. It still needs an implementation that preserves the public logger's configured bound and explicit truncation marker, plus persistent ordinary log-level configuration.\n\nTask: `astra-hermit-drafts`, within `astra-lane-drains-hermit-reverie-pr-queues-to-zero`.\n\n## Determinism\n\nPreserve the complete selected INFO stream and existing strict comparison policy. The original guest-only INFO filtering must not be carried into the recovery. The intended change routes diagnostics without changing scheduler decisions, guest syscall results, wait ownership or the existing process-lifetime policy.\n\nOrdinary public logging has the existing diagnostic write-error and truncation behavior. It does not promise a completed evidence artifact after every descendant exits. S7's stronger evidence settlement requirements remain separate, and its ordinary DBT evidence refusal remains in force.\n\n## Linux Semantics\n\nPass the host-opened file descriptor through the existing diagnostic route rather than reopening a pathname in the guest. Preserve stdout/stderr, root wait status, terminal handling, PGID/SID, ordinary setsid/setpgid behavior and current workdir staging. Ordinary log routing must not create an evidence session, force a new process group, kill late children or wait for every writer solely to finalize the log.\n\n## Validation\n\nCurrent recovery analysis is read-only. It is bound to Hermit main `21ea8e42ad1ed478cffe9d36338e484939ee9cef` and its Reverie pin `8c8c0a57649c9ffbf8a7a14291a64320f64b935f`; no new runtime qualification is claimed for this draft.\n\nThe eventual focused checks must cover host-path replacement after open; fork and empty-environment exec at the selected log levels; default, unlimited, malformed and small log-size settings; explicit truncation; original root status and stream separation; and ordinary process/session/TTY behavior. A late-child control must preserve ordinary lifetime and routing without pretending that root completion settles the whole log.\n\nThe source findings and correction of an earlier overbroad S7 prerequisite are recorded in the TaskGraph notes. The report is `/tmp/astra-reverie-1689-log-route-20260914/scope-clarification/report.md`, SHA256 `ca8787160942ae6c7fe11c7be182723d30ee4287013a3f2585bfb7b3f4cf7d63`. The draft remains open for the implementation and its meaningful validation.\n","created_at":"2026-08-06T13:55:40Z","updated_at":"2026-09-16T02:00:09Z","closed_at":null,"merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[{"id":11734119731,"node_id":"LA_kwDOIZiOrM8AAAACu2h1Mw","url":"https://api.github.com/repos/rrnewton/hermit/labels/codex-coord","name":"codex-coord","color":"1D76DB","default":false,"description":"Owned or shepherded by codex-coord/hermit-coord","archived_at":null,"archived_by":null},{"id":11750372094,"node_id":"LA_kwDOIZiOrM8AAAACvGBy_g","url":"https://api.github.com/repos/rrnewton/hermit/labels/mechanism:dbi-log-file-routing","name":"mechanism:dbi-log-file-routing","color":"5319e7","default":false,"description":"DBI log-file CLI routing into backend configuration","archived_at":null,"archived_by":null},{"id":11756618087,"node_id":"LA_kwDOIZiOrM8AAAACvL_BZw","url":"https://api.github.com/repos/rrnewton/hermit/labels/codex-coord-030","name":"codex-coord-030","color":"1D76DB","default":false,"description":"Claimed or shepherded by codex-coord-030 on devbig030","archived_at":null,"archived_by":null},{"id":11756625801,"node_id":"LA_kwDOIZiOrM8AAAACvL_fiQ","url":"https://api.github.com/repos/rrnewton/hermit/labels/claude-coord","name":"claude-coord","color":"0E8A16","default":false,"description":"Owned or shepherded by the claude-coord autonomous team","archived_at":null,"archived_by":null},{"id":11756625821,"node_id":"LA_kwDOIZiOrM8AAAACvL_fnQ","url":"https://api.github.com/repos/rrnewton/hermit/labels/claude-coord-176","name":"claude-coord-176","color":"0E8A16","default":false,"description":"Owned by claude-coord-176 (this coordinator instance)","archived_at":null,"archived_by":null},{"id":11918294630,"node_id":"LA_kwDOIZiOrM8AAAACxmK-Zg","url":"https://api.github.com/repos/rrnewton/hermit/labels/category:backends","name":"category:backends","color":"1D76DB","default":false,"description":"Changes for one of the non-ptrace Reverie backends; must also carry a backend: label","archived_at":null,"archived_by":null},{"id":11918294735,"node_id":"LA_kwDOIZiOrM8AAAACxmK-zw","url":"https://api.github.com/repos/rrnewton/hermit/labels/backend:dbt","name":"backend:dbt","color":"5319E7","default":false,"description":"DBT backend (CLI --backend dbt; crates reverie-dbt, detcore-dbt; DynamoRIO)","archived_at":null,"archived_by":null}],"milestone":null,"draft":true,"commits_url":"https://api.github.com/repos/rrnewton/hermit/pulls/1689/commits","review_comments_url":"https://api.github.com/repos/rrnewton/hermit/pulls/1689/comments","review_comment_url":"https://api.github.com/repos/rrnewton/hermit/pulls/comments{/number}","comments_url":"https://api.github.com/repos/rrnewton/hermit/issues/1689/comments","statuses_url":"https://api.github.com/repos/rrnewton/hermit/statuses/96eeb0d603875e595f36d6ce97fc77a998ea53a2","head":{"label":"rrnewton:dbi-honour-log-file","ref":"dbi-honour-log-file","sha":"96eeb0d603875e595f36d6ce97fc77a998ea53a2","user":{"login":"rrnewton","id":274582,"node_id":"MDQ6VXNlcjI3NDU4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/274582?v=4","gravatar_id":"","url":"https://api.github.com/users/rrnewton","html_url":"https://github.com/rrnewton","follo