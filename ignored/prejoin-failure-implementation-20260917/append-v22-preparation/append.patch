+    impl Drop for GateFailureCleanup {
+        fn drop(&mut self) {
+            if let Some(release) = self.release.take() {
+                let _ = release.send(());
+            }
+            if let Some(publisher) = self.publisher.take() {
+                let _ = publisher.join();
