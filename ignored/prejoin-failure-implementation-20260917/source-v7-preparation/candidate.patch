+fn wait_until(condition: impl Fn() -> bool) {
+    let deadline = Instant::now() + Duration::from_secs(2);
+    while !condition() {
+        assert!(
+            Instant::now() < deadline,
+            "native control did not reach its ordering boundary"
+        );
+        std::thread::yield_now();
+    }
+}
