+                .args(["--kill-after=2s", "10s"])
+                .arg(std::env::current_exe().unwrap())
+                .args(["--exact", TEST, "--test-threads=1", "--nocapture"])
+                .env(CHILD_ENV, TEST)
+                .output()
+                .expect("failed to exec isolated file-table EMFILE control");
