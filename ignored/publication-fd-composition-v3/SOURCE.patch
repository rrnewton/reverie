+        let mut sibling = f.executor.thread_child(2).unwrap();
+        f.memory.write(0x100, b"c\0").unwrap();
+        for (target, position) in [(first, 5), (second, 6)] {
+            let mut call = |number: libc::c_long, args: [u64; 6]| {
