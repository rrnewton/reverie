+        assert_eq!(
+            unsafe {
+                libc::epoll_ctl(
+                    epoll_host,
+                    libc::EPOLL_CTL_DEL,
+                    event_host,
+                    std::ptr::null_mut(),
+                )
+            },
+            0
+        );
+        eprintln!("{COMPLETE}");
+    }
