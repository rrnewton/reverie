+struct TerminalTool {
+    mode: u8,
+}
+
+#[reverie::tool]
+impl Tool for TerminalTool {
+    type GlobalState = TerminalLog;
+    type ThreadState = bool;
+
+    fn new(_: Pid, mode: &u8) -> Self {
+        Self { mode: *mode }
+    }
+
+    fn subscriptions(mode: &u8) -> Subscription {
