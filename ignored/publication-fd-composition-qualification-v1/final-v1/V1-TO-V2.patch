+                .pending_mask(&process.pending_generations)
+                .to_bytes(),
+            KernelSigset::default().to_bytes()
+        );
+        assert!(executor.signal_registry.failure.lock().unwrap().is_none());
+        assert!(executor.file_table.is_poisoned());
     }
 
