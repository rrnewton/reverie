+                .join()
+                .expect("retirement lock checker panicked");
+                assert_eq!(
+                    checked,
+                    (true, true),
+                    "both guards must be released before close"
+                );
+                observed.lock().unwrap().push(batch);
+            })));
+        observations
+    }
