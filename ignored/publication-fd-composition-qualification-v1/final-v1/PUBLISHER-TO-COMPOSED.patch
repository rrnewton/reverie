+        assert_eq!(f.seek(first, 1, libc::SEEK_SET), 1);
+        assert_eq!(f.seek(second, 2, libc::SEEK_SET), 2);
+        let event = f.call(
+            libc::SYS_eventfd2,
+            [0, libc::EFD_NONBLOCK as u64, 0, 0, 0, 0],
+        );
+        let epoll = f.call(libc::SYS_epoll_create1, [0; 6]);
+        assert!(event > second && epoll > event);
