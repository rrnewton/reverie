+                libc::SYS_close => [target as u64, 0, 0, 0, 0, 0],
+                libc::SYS_close_range => [target as u64, target as u64, 0, 0, 0, 0],
+                libc::SYS_dup2 => [source as u64, target as u64, 0, 0, 0, 0],
+                libc::SYS_dup3 => [
+                    source as u64,
