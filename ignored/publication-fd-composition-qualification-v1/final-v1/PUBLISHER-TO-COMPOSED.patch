+        // Do not execute another parent syscall: it would first install the
+        // sibling's table and erase the original local snapshot under test.
+        let file_handles = |state: &LoadedStaticElf| {
+            state
+                .files
+                .iter()
+                .map(|(&fd, file)| (fd, file.as_raw_fd()))
