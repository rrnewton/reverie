+                    let mut stat = std::mem::MaybeUninit::<libc::stat>::uninit();
+                    // SAFETY: each descriptor is still owned by the paused batch.
+                    assert_eq!(unsafe { libc::fstat(fd, stat.as_mut_ptr()) }, 0);
