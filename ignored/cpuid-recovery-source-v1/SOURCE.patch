+    assert_eq!(
+        calls
+            .iter()
+            .map(|call| (call.0.as_raw(), call.1, call.2))
+            .collect::<Vec<_>>(),
+        vec![(1, 7, 2), (1, u32::MAX, 0), (1, u32::MAX, 1)]
+    );
+    assert!(calls.windows(2).all(|pair| pair[1].3 > pair[0].3));
+}
