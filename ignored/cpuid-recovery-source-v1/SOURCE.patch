+#[test]
+fn unsubscribed_cpuid_keeps_the_installed_table_and_indexed_xstate_policy() {
+    for (leaf, subleaf, expected) in [
+        (0x80000001, 0, [0x663, 0, 1, 0x20100800]),
+        (0xd, 1, [0; 4]),
+        (0xd, 17, [0; 4]),
+        (0xd, 19, [0; 4]),
+    ] {
+        let (log, status) = run_cpuid(
+            &table_program(leaf, subleaf, expected),
