+    append_cpuid(&mut code, &[], 0, &mut failures);
+    code.extend_from_slice(&[0x48, 0xbf]);
+    let path_operand = code.len();
+    code.extend_from_slice(&0_u64.to_le_bytes());
+    code.extend_from_slice(&[0x48, 0xbe]);
+    let argv_operand = code.len();
