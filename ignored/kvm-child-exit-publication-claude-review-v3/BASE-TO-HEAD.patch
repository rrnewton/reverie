+            if grandchild_first {
+                grandchild.retire_current_thread(reverie::ExitStatus::Exited(3), false);
+                assert_eq!(
+                    grandchild
+                        .signal_registry
+                        .process_family_exit(grandchild_id),
+                    Some(ProcessFamilyExit::RunTeardownChild {
+                        status: reverie::ExitStatus::Exited(3),
+                    }),
