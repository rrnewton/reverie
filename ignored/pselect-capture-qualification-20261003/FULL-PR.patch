+                BAD,
+                0,
+                0,
+                1_000_000_000,
+                libc::EFAULT,
+            ),
+            (
+                "timeout first",
+                u64::MAX,
+                BAD,
+                BAD,
+                OUTER,
+                BAD,
+                0,
+                0,
+                libc::EFAULT,
+            ),
+            (
+                "timeout value",
+                u64::MAX,
+                BAD,
+                TIMEOUT,
+                OUTER,
+                BAD,
+                8,
+                1_000_000_000,
+                libc::EINVAL,
+            ),
+            (
+                "inner size",
+                u64::MAX,
+                BAD,
+                TIMEOUT,
+                OUTER,
+                BAD,
+                7,
+                0,
+                libc::EINVAL,
+            ),
+            (
+                "inner access",
+                u64::MAX,
+                BAD,
+                TIMEOUT,
+                OUTER,
+                BAD,
+                8,
+                0,
+                libc::EFAULT,
+            ),
+            (
+                "signed low word",
+                0x1234_5678_ffff_ffff,
+                BAD,
+                TIMEOUT,
+                OUTER,
+                0,
+                u64::MAX,
+                0,
+                libc::EINVAL,
+            ),
+            (
+                "input after low word",
+                0x1234_5678_0000_0001,
+                BAD,
+                TIMEOUT,
+                OUTER,
+                0,
