+    #[test]
+    fn pselect6_zero_captured_alias_preserves_validation_precedence() {
+        const BAD: u64 = 0x00f0_0000;
+        let root = TestDir::new();
+        let mut state = test_state(&root.0);
+        assert_eq!(
+            insert_file_with_flags(
