+    const EPOLL_LIFECYCLE_DATA: u64 = 0x0123_4567_89ab_cdef;
+    const EPOLL_LIFECYCLE_EVENT: u64 = 0x200;
+    const EPOLL_LIFECYCLE_ZERO: u64 = 0x240;
