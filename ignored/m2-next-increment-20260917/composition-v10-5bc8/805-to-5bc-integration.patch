+            .env("PATH", path)
+            .env("HOME", "/root")
+            .env("TMPDIR", fixture.path())
+            .current_dir("/");
+        // Root can read mode-000 files. A privileged self-test must exercise
+        // genuine denied access too, rather than skip or falsely pass this case.
+        if unreadable && unsafe { libc::geteuid() } == 0 {
