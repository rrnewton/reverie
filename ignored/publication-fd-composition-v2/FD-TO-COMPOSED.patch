+        for handler in [libc::SIG_DFL as u64, libc::SIG_IGN as u64, 0x1234] {
+            for blocked in [false, true] {
+                let executor = executor();
+                let id = identity(&executor);
+                let control = executor.signal_registry.control();
+                executor
