+    fn alarm(target: SignalProcessId) -> SignalEvent {
+        let mut info = [0; reverie::SIGNAL_INFO_SIZE];
+        info[..4].copy_from_slice(&libc::SIGALRM.to_ne_bytes());
+        info[8..12].copy_from_slice(&libc::SI_KERNEL.to_ne_bytes());
