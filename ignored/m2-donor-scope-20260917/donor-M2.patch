+        } else if let Some(message) = &mut current {
+            message.push('\n');
+            message.push_str(line);
+        } else if !line.is_empty() {
+            return Err(LogParseError::MissingTimestampPrefix {
+                line: line_index + 1,
+            });
+        }
+    }
+    if let Some(message) = current {
+        messages.push((messages.len() + 1, message));
+    }
