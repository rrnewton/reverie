+    fn metadata_call(
+        memory: &mut GuestMemory,
+        state: &mut LoadedStaticElf,
+        capture: bool,
+        number: libc::c_long,
+        args: [u64; 6],
+    ) -> i64 {
+        if capture {
+            syscall_result_with_output(memory, state, &mut CapturedOutput::default(), number, args)
