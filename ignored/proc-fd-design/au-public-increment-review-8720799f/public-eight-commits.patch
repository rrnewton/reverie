+
+    def no_tmux(*_args: object, **_kwargs: object) -> object:
+        raise FileNotFoundError(2, "No such file or directory", "tmux")
+
+    monkeypatch.setattr("herdr_run.foreign.lib.subprocess.run", no_tmux)
