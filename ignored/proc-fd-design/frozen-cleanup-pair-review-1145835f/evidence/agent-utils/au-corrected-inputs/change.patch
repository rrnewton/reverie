+@dataclasses.dataclass(frozen=True)
+class _RetainedValidationGitState:
+    head: str
+    common: Path
+    git_directory: Path
+    index: Path
+    index_identity: _RegularFileIdentity
+    status: str
+    directories: tuple[tuple[int, int, int], ...]
