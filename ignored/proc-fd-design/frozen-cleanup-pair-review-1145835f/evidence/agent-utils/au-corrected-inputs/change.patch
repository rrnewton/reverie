+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+    capsys: pytest.CaptureFixture[str], action: str, mutation: str,
+) -> None:
+    project, source, checkout, record, sidecar = prepare_current_incomplete_frozen_checkout(
