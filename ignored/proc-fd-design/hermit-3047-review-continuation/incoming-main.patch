+    validate_evidence::SelectedEvidence::capture(root, &plan)?.publish(
+        evidence_root.path(),
+        &plan,
+        "requalification-plan-bracket",
+        &"a".repeat(40),
+    )?;
+
     let selected_owner = plan
         .cfg
         .steps
