+    pub fn planned_shutdown(&self) {
+        self.planned.store(true, Ordering::Release);
+    }
+    pub async fn failed(&self) {
+        loop {
+            let notified = self.changed.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            if !self.issues.lock().unwrap().is_empty() {
