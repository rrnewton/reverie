+/// Actual connection failures, retained independently of the serving task.
+#[derive(Clone, Debug)]
+pub enum ConnectionFailure {
+    Transport(Arc<RpcError>),
+    Panicked(Arc<PanicPayload>),
+    UnresolvedPanic,
+    Interrupted,
