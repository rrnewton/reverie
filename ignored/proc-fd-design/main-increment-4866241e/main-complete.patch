+  # an explicit failed observation, rather than hiding it in a secondary RET.
+  mov SLOT(ORIGINAL_RSP)(%r15),%rsp
+  pop %r15
+  pop %r14
+  pop %r13
+  pop %r12
+  pop %rbx
+  pop %rbp
+  ret
+  .size frame_probe,.-frame_probe
+  .section .note.GNU-stack,"",@progbits
diff --git a/experimental/reverie-sabre/tests/fixtures/syscall_frame/frame_probe.c b/experimental/reverie-sabre/tests/fixtures/syscall_frame/frame_probe.c
