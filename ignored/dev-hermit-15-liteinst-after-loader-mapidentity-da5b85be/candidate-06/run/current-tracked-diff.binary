+            match publication.superseded_status {
+                None => {
+                    event.observer().ok_or(Errno::EPROTO)?.finish_status(
+                        retained_status,
+                        PhysicalStatusDisposition::KernelSupersededByExitStop,
+                    );
+                    publication.superseded_status = Some(retained_status);
+                }
