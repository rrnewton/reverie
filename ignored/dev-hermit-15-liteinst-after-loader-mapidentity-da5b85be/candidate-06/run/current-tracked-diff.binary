+    ) -> PrivateExecutionTimerError {
+        self.private_execution = Some(PrivateExecutionState::Failed(snapshot));
+        PrivateExecutionTimerError::CounterOperation { operation, source }
+    }
+
+    fn latch_private_execution_inconsistency(
