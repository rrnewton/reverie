+fn scalar_read_full_width_descriptor_transport() {
+    scalar_fd_width_transport(
+        "scalar_read_full_width_descriptor_transport",
+        "read",
+        libc::SYS_read,
+    );
+}
+
+#[test]
+fn scalar_pread_full_width_descriptor_transport() {
+    scalar_fd_width_transport(
+        "scalar_pread_full_width_descriptor_transport",
+        "pread",
+        libc::SYS_pread64,
+    );
+}
+
+#[test]
+fn scalar_pwrite_full_width_descriptor_transport() {
+    scalar_fd_width_transport(
+        "scalar_pwrite_full_width_descriptor_transport",
+        "pwrite",
+        libc::SYS_pwrite64,
+    );
+}
+
+fn scalar_fd_width_transport(test: &str, operation: &str, number: libc::c_long) {
+    if !leader_self_exec_bounded(test) {
+        return;
+    }
+    let directory = TestDirectory::new();
+    let program = compile_c_program(
+        &directory.0,
+        "scalar-fd-width",
+        include_str!("fixtures/scalar_fd_width.c"),
+    );
+    // Qualification supplies a fresh owned directory per phase, preserving the
+    // actual native/KVM fixture before TestDirectory removes its working copy.
+    if let Some(root) = std::env::var_os("REVERIE_SCALAR_FD_ARTIFACT_DIR") {
+        use std::io::Write;
+        let path = PathBuf::from(root).join(format!("{test}.elf"));
+        let mut retained = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(path)
+            .unwrap();
+        retained
+            .write_all(&std::fs::read(&program).unwrap())
+            .unwrap();
+    }
+    for native in [true, false] {
+        let cwd = directory.0.join(if native { "native" } else { "kvm" });
+        std::fs::create_dir(&cwd).unwrap();
+        let (code, stdout, stderr) = if native {
+            let output = std::process::Command::new(&program)
+                .arg(operation)
+                .current_dir(&cwd)
+                .output()
+                .unwrap();
+            (output.status.code(), output.stdout, output.stderr)
+        } else {
+            let mut backend = KvmBackend::new(256 * 1024 * 1024).unwrap();
+            backend
+                .install_static_elf_file_with_context(
+                    std::fs::File::open(&program).unwrap(),
+                    &[program.to_str().unwrap(), operation],
+                    &[],
+                    &cwd,
+                )
+                .unwrap();
+            let (code, stdout, stderr) = backend.run_static_elf_captured().unwrap();
+            (Some(code), stdout, stderr)
+        };
+        // These raw records include actual addresses. Retain them unchanged;
+        // native and guest addresses need not equal each other. Each execution
+        // independently meets the same exact result/byte/position oracle.
+        eprintln!(
+            "operation={operation} native={native} code={code:?} stdout={stdout:02x?} stderr={stderr:02x?}"
+        );
+        assert_eq!(code, Some(0));
+        assert!(stderr.is_empty());
+        assert_eq!(stdout.len(), 5 * 112);
+        for (index, record) in stdout.chunks_exact(112).enumerate() {
+            let word = |field: usize| {
+                u64::from_ne_bytes(record[field * 8..field * 8 + 8].try_into().unwrap())
+            };
+            assert_eq!(word(0), index as u64);
+            assert_eq!(word(1), number as u64);
+            assert!(word(2) <= i32::MAX as u64);
+            let prefix = match index {
+                0 => 0,
+                2 => 0xffff_ffff_0000_0000,
+                _ => 1_u64 << 32,
+            };
+            let low = if index == 3 { u32::MAX as u64 } else { word(2) };
+            assert_eq!(word(3), prefix | low);
+            assert_ne!(word(4), 0);
+            assert_eq!(word(5), 3);
+            assert_eq!(word(6), 4);
+            assert_eq!(word(7), 0x7654_3210_fedc_ba98);
+            assert_eq!(word(8), 0x89ab_cdef_0123_4567);
+            let valid = index < 3;
+            assert_eq!(
+                word(9) as i64,
+                if valid { 3 } else { -i64::from(libc::EBADF) }
+            );
+            assert_eq!(word(10), 1);
+            assert_eq!(word(11), if valid && operation == "read" { 4 } else { 1 });
+            let buffer = if operation == "pwrite" {
+                b"xyzUUUUU"
+            } else if valid {
+                if operation == "read" {
+                    b"BCDUUUUU"
+                } else {
+                    b"EFGUUUUU"
+                }
+            } else {
+                b"UUUUUUUU"
+            };
+            let contents = if valid && operation == "pwrite" {
+                b"ABCDxyzH"
+            } else {
+                b"ABCDEFGH"
+            };
+            assert_eq!(&record[96..104], buffer);
+            assert_eq!(&record[104..112], contents);
+        }
+    }
+}
