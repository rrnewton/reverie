+        Some(cleanup) => (
+            cleanup.scheduler.err(),
+            cleanup.preemption_recording.err(),
+            cleanup.signal_refusal,
+        ),
+        None => (None, None, None),
+    };
+    let independent_failure = refusal.is_some()
+        && (scheduler.is_some()
+            || recording.is_some()
+            || backend
+                .as_ref()
+                .is_some_and(|error| !matches!(error, reverie_kvm::Error::RunAborted)));
