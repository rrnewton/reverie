+#[test]
+fn captured_write_signal_capability_routes_and_refusals() {
+    if leader_self_exec_bounded(
+        "captured_write_signals::captured_write_signal_capability_routes_and_refusals",
+    ) {
+        run_modes(0..=12);
+    }
+}
