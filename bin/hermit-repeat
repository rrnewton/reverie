#!/usr/bin/env python3
"""hermit-repeat -- run one guest N times and report the DISTRIBUTION of first
divergence points.

WHY THIS EXISTS
===============
Getting a red or yellow cell to green means running it many times and looking at
WHERE it parts company with itself. Before this, that meant hand-writing a loop,
a log-capture scheme and a parser per investigation, and the parsers disagreed.
This is the one command:

    bin/hermit-repeat -n 20 -- /bin/echo hello
    bin/hermit-repeat -n 20 --mode concurrent --backend liteinst -- ./myguest

WHAT ONE "RUN" IS, AND WHY IT IS A VERIFY PAIR
==============================================
Each of the N runs is ONE `hermit run --verify --verify-strict` invocation, which
executes the guest TWICE from a single command line and compares the two under
the canonical BitwiseInfoV1 envelope. So N runs give N INDEPENDENT divergence
observations, each self-contained.

This deliberately does NOT compare run 3 against run 7. `hermit log-diff --help`
documents, with measurements, that two separately-produced runs only compare
meaningfully when their argv AND environment are byte-identical -- one byte of
argv moved stack addresses by 32 bytes and diverged two otherwise identical runs
20 records in. N nodes cannot have byte-identical environments (each needs its
own output path), so a cross-node comparison would measure this harness. A
verify pair has identical argv by construction, so it measures the guest.

HOW IT RUNS THEM
================
N DISCONNECTED nodes in a dagrun (formerly safe-ci-dag-runner) DAG -- not a
runner. That reuses the existing scheduler, its two-level cgroup boxing and its
resource accounting instead of inventing a second mechanism that would drift
from it. Each node's command is `bin/safehermit`, so the easy path is the boxed
path: there is now a one-line way to run an ad-hoc hermit command N times that
cannot bypass the wrapper the way `/tmp/hermit-ers-patched run ...` did on
2026-08-17.

CONCURRENT AND SEQUENTIAL ARE DIFFERENT MEASUREMENTS
====================================================
`--mode concurrent` runs the N nodes at once and therefore measures the cell
PLUS host contention; contention is itself a flake source and is often the point.
`--mode sequential` runs them one at a time and measures the cell with the box as
quiet as it gets. A distribution that mixes the two is two populations wearing
one histogram, so the mode is a flag, it is printed on the report, and it is
recorded in the JSON. The DEFAULT IS SEQUENTIAL -- not because it is faster (it
is slower) but because a reader who did not think about the mode should get the
number that is least likely to be attributed to the wrong cause.

EXIT CODES
  0  every run was clean (verified deterministic)
  1  at least one run diverged
  2  usage error, or the tool could not run the DAG at all
  3  no run produced a verdict (all failed / no-result) -- a NON-ANSWER, which is
     deliberately not 0 and not 1
"""

from __future__ import annotations

import argparse
import csv
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import threading
import time
from dataclasses import dataclass, field, asdict
from pathlib import Path

PROG = "hermit-repeat"
ROOT = Path(__file__).resolve().parent.parent

# The record separator detcore's log comparator uses (detcore/src/logdiff.rs
# RECORD_START). Our derived coordinates are only trustworthy while this matches,
# which is why every derived value is cross-checked against hermit's own JSON
# before it is printed -- see cross_check() below.
RECORD_START = re.compile(
    r"((Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) \d\d \d\d:\d\d:\d\d\.\d+"
    r"|\d+-\d\d-\d\dT\d\d:\d\d:\d\d.\d+Z) +"
)
COMMIT_TURN = re.compile(r"\bCOMMIT turn ([0-9][0-9_]*)\b")
COMMIT_TIME = re.compile(
    r"\b(?:at time|on previously committed) ([0-9][0-9_]*(?:\.[0-9_]+)?)(ns|s)?\b"
)
FINISH_SYSCALL = re.compile(r"\[syscall\]\[detcore, dtid (\d+)\]\s+finish syscall #(\d+):")
BUILD_REVISION = re.compile(r"\bg([0-9a-f]{12})(-dirty)?(?:\)|\s|$)")


def die(msg: str, code: int = 2):
    print(f"{PROG}: {msg}", file=sys.stderr)
    sys.exit(code)


def say(msg: str = ""):
    print(msg, file=sys.stderr)


def git_value(checkout: Path, *args: str) -> str:
    """Read one exact Git value or refuse instead of inventing provenance."""
    completed = subprocess.run(
        ["git", "-C", str(checkout), *args],
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    value = completed.stdout.strip()
    if completed.returncode != 0 or not value:
        detail = completed.stderr.strip() or f"exit {completed.returncode}"
        raise RuntimeError(
            f"cannot read git {' '.join(args)} from {checkout}: {detail}"
        )
    return value


def git_tracked_dirty(checkout: Path) -> bool:
    """Whether tracked checkout content differs from HEAD."""
    completed = subprocess.run(
        ["git", "-C", str(checkout), "status", "--porcelain", "--untracked-files=no"],
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    if completed.returncode != 0:
        detail = completed.stderr.strip() or f"exit {completed.returncode}"
        raise RuntimeError(f"cannot inspect tracked state in {checkout}: {detail}")
    return bool(completed.stdout.strip())


def hermit_binary_revision(hermit_bin: str) -> tuple[str, bool]:
    """Read the source revision embedded by Hermit's build script."""
    completed = subprocess.run(
        [hermit_bin, "--version"],
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    text = "\n".join((completed.stdout, completed.stderr))
    match = BUILD_REVISION.search(text)
    if completed.returncode != 0 or match is None:
        detail = text.strip() or f"exit {completed.returncode}"
        raise RuntimeError(
            f"cannot read a 12-hex build revision from {hermit_bin} --version: {detail}"
        )
    return match.group(1), match.group(2) is not None


def require_matching_binary(checkout_sha: str, binary_revision: str, hermit_bin: str):
    """Refuse to label results with a checkout the selected binary did not use."""
    if not checkout_sha.startswith(binary_revision):
        raise RuntimeError(
            f"Hermit checkout is {checkout_sha}, but {hermit_bin} was built from "
            f"{binary_revision}"
        )


def series_outcome(category: str) -> str:
    """Map one retained run without turning a non-verdict into a divergence."""
    try:
        return {
            "clean": "PASS",
            "diverged": "FAIL",
            "failed": "ERROR",
            "no_result": "NO_RESULT",
            "not_run": "NO_RESULT",
        }[category]
    except KeyError as exc:
        raise RuntimeError(f"cannot write unknown run category {category!r}") from exc


def series_cell_rows(
    *,
    cell: str,
    backend: str,
    run_id: str,
    hermit_sha: str,
    detcore_tree: str,
    source_tree_dirty: bool,
    deadline: int,
    results: list[RunResult],
) -> list[dict]:
    """Translate a manifest-cell sweep to the parent writer's typed input."""
    rows = []
    for result in results:
        row = {
            "schema": 4,
            "run_id": run_id,
            "hermit_sha": hermit_sha,
            "detcore_tree": detcore_tree,
            "source_tree_dirty": source_tree_dirty,
            "test": cell,
            "mode": "verify",
            "backend": backend,
            "outcome": series_outcome(result.category),
            "run_index": result.index - 1,
            "attempt": 1,
            "timeout_seconds": deadline,
            "attempts": [],
        }
        if result.elapsed_s is not None:
            row["duration_ms"] = round(result.elapsed_s * 1000)
        if result.info_record is not None:
            row["first_divergent_record"] = result.info_record
        if result.sched_turn is not None:
            row["first_divergent_scheduler_turn"] = result.sched_turn
        if result.virtual_ns is not None:
            row["first_divergent_virtual_nanoseconds"] = result.virtual_ns
        if result.syscall_ordinal is not None:
            row["first_divergent_syscall"] = result.syscall_ordinal
        rows.append(row)
    return rows


def append_cell_series(args, run_id: str, results: list[RunResult]) -> str | None:
    """Append every `--cell` run through the parent series write boundary."""
    if not args.cell:
        return None
    hermit_checkout = ROOT / "hermit"
    hermit_sha = git_value(hermit_checkout, "rev-parse", "HEAD")
    detcore_tree = git_value(hermit_checkout, "rev-parse", "HEAD:detcore")
    binary_revision, binary_dirty = hermit_binary_revision(args.sh_bin_resolved)
    require_matching_binary(hermit_sha, binary_revision, args.sh_bin_resolved)
    dirty = git_tracked_dirty(hermit_checkout) or binary_dirty
    rows = series_cell_rows(
        cell=args.cell,
        backend=args.backend or "ptrace",
        run_id=run_id,
        hermit_sha=hermit_sha,
        detcore_tree=detcore_tree,
        source_tree_dirty=dirty,
        deadline=args.deadline,
        results=results,
    )
    writer = ROOT / "ci-hub/series/series.py"
    if not writer.is_file():
        raise RuntimeError(f"series writer does not exist at {writer}")
    payload = "".join(json.dumps(row, sort_keys=True) + "\n" for row in rows)
    completed = subprocess.run(
        [
            sys.executable,
            str(writer),
            "append-cells",
            "--parent",
            str(ROOT),
            "--producer",
            "hermit-repeat",
            "--run-id",
            run_id,
            "--tree",
            hermit_sha,
        ],
        input=payload,
        capture_output=True,
        text=True,
        timeout=60,
        check=False,
    )
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip()
        # append-cells quarantines each refused run and still appends the
        # valid ones, so a nonzero status does not mean nothing was written.
        raise RuntimeError(
            f"series writer refused one or more of the {len(rows)} run(s); valid "
            f"runs, if any, were retained: {detail or 'no detail'}"
        )
    return completed.stdout.strip()


# --------------------------------------------------------------------------- units
UNIT_KEYSPACES = [
    (
        "info_record",
        "ordinal of the record inside ONE log file, 1-based, counting every "
        "timestamped record. NOT a text line number: a record can span several "
        "lines, so this number is smaller than the line number and the two must "
        "not be compared.",
    ),
    (
        "sched_turn",
        "detcore scheduler turn (`COMMIT turn N`) at or before the divergent "
        "record. Global across threads within one run.",
    ),
    (
        "virtual_ns",
        "absolute virtual nanoseconds since hermit's fixed epoch (default "
        "1_640_995_199_000_000_000), read off that same COMMIT. Not wall clock.",
    ),
    (
        "syscall",
        "hermit's own `finish syscall #N` counter, which is PER-THREAD (per "
        "dtid) and not global -- the dtid is printed with it. A syscall ordinal "
        "is NOT comparable across backends (the same getpgrp sat at DETLOG event "
        "40 under ptrace and 39 under DBT) nor across guests. Compare only "
        "within one backend and one guest.",
    ),
]


# --------------------------------------------------------------------------- model
@dataclass
class RunResult:
    index: int
    name: str
    dir: str
    # set only for a nextest node; None for a hermit verify-pair node
    test_id: str | None = None
    # exactly one of: diverged | clean | failed | no_result
    category: str = "failed"
    why: str = "the node produced no verdict file"
    exit_code: int | None = None
    guest_exit_code: int | None = None
    started_at: float | None = None
    ended_at: float | None = None
    # divergence coordinates (only for category == diverged)
    info_record: int | None = None
    sched_turn: int | None = None
    virtual_ns: int | None = None
    syscall_ordinal: int | None = None
    syscall_dtid: int | None = None
    # Why syscall_ordinal is absent when it is. "no syscall had completed yet"
    # and "we could not tell" are different answers and must not share a blank.
    syscall_note: str | None = None
    # provenance of the coordinates
    coord_source: str | None = None
    coord_cross_check: str | None = None
    coord_verified: bool = False
    turn_note: str | None = None
    # per-node resource facts, joined from the dag runner's own step CSV
    inner_jobs: int | None = None
    effective_cores: float | None = None
    peak_bytes: int | None = None
    elapsed_s: float | None = None
    oom_kills: int | None = None
    timed_out: bool | None = None
    co_tenants_start: int | None = None
    load1_start: float | None = None
    safehermit_bounds: dict = field(default_factory=dict)
    # Last few lines of the node's own stderr, so a failure explains itself in
    # the report instead of sending the reader to a log file.
    error_tail: list = field(default_factory=list)


# --------------------------------------------------------------------------- binary
def resolve_hermit(explicit: str | None) -> tuple[str, str]:
    """Resolve the hermit binary with the SAME precedence bin/safehermit uses, and
    NAME which layer won. 'which build produced this artifact' was unanswerable
    for most of 2026-08-19 and cost a day of rework."""
    if explicit:
        return os.path.abspath(explicit), "flag:--sh-bin"
    if os.environ.get("HERMIT_BIN"):
        return os.path.abspath(os.environ["HERMIT_BIN"]), "env:HERMIT_BIN"
    for cand, src in (
        (ROOT / "target/release/hermit", "default:target/release/hermit"),
        (ROOT / "hermit/target/release/hermit", "default:hermit/target/release/hermit"),
        (ROOT / "bin/hermit", "default:bin/hermit"),
    ):
        if cand.is_file() and os.access(cand, os.X_OK):
            return str(cand.resolve()), src
    found = shutil.which("hermit")
    if found:
        return found, f"path:{found}"
    die(
        "no hermit binary found. Pass --sh-bin PATH, set HERMIT_BIN, or build "
        "target/release/hermit."
    )


def sha256_of(path: str) -> str:
    h = hashlib.sha256()
    try:
        with open(path, "rb") as fh:
            for chunk in iter(lambda: fh.read(1 << 20), b""):
                h.update(chunk)
    except OSError:
        return "unavailable"
    return h.hexdigest()


# --------------------------------------------------------------------------- parsing
def split_records(text: str) -> list[str]:
    """Split a hermit log into records the way detcore's comparator does. Index 0
    is whatever preceded the first timestamp; the comparator enumerates the split
    the same way, so our indices line up with its `first_divergent_record`."""
    return RECORD_START.split(text)


def _record_at(records: list[str], index: int) -> str | None:
    # RECORD_START has capture groups, so re.split interleaves them into the
    # result. Rebuild the plain record list by stride.
    return records[index] if 0 <= index < len(records) else None


def records_by_comparator_index(text: str) -> dict[int, str]:
    """Map comparator record index -> record text.

    `re.split` with capturing groups interleaves the captures, so we cannot use
    the raw list. Rust's `Regex::split` yields ONLY the pieces between matches,
    which is what `extract_log_messages` enumerates. Reproduce that."""
    pieces: list[str] = []
    last = 0
    for m in RECORD_START.finditer(text):
        pieces.append(text[last : m.start()])
        last = m.end()
    pieces.append(text[last:])
    return {i: p for i, p in enumerate(pieces)}


def commit_at_or_before(pieces: dict[int, str], index: int) -> tuple[int | None, int | None]:
    for i in range(index, -1, -1):
        rec = pieces.get(i)
        if not rec or " COMMIT " not in rec:
            continue
        m = COMMIT_TURN.search(rec)
        if not m:
            continue
        turn = int(m.group(1).replace("_", ""))
        ns = None
        t = COMMIT_TIME.search(rec)
        if t:
            ns = parse_virtual_ns(t.group(1), t.group(2))
        return turn, ns
    return None, None


def parse_virtual_ns(value: str, unit: str | None) -> int | None:
    v = value.replace("_", "")
    if unit == "s":
        secs, _, frac = v.partition(".")
        if len(frac) > 9 or (frac and not frac.isdigit()):
            return None
        try:
            return int(secs) * 1_000_000_000 + (int(frac) * 10 ** (9 - len(frac)) if frac else 0)
        except ValueError:
            return None
    if "." in v:
        return None
    try:
        return int(v)
    except ValueError:
        return None


def syscall_at_or_before(pieces: dict[int, str], index: int) -> tuple[int | None, int | None]:
    """The last `finish syscall #N` at or before `index`, with its dtid.

    This is hermit's OWN counter read straight out of the log, not a count we
    recompute, so it cannot drift from what detcore believes. It is per-thread."""
    for i in range(index, -1, -1):
        rec = pieces.get(i)
        if not rec or " DETLOG " not in rec:
            continue
        m = FINISH_SYSCALL.search(rec)
        if m:
            return int(m.group(2)), int(m.group(1))
    return None, None


# --------------------------------------------------------------------------- dag
def build_dag(args, hermit_bin: str, out: Path, guest: list[str]) -> dict:
    steps = []
    per_step_timeout = args.deadline + 60
    for i in range(1, args.runs + 1):
        name = f"run{i:0{len(str(args.runs))}d}"
        d = out / "runs" / name
        (d / "logs").mkdir(parents=True, exist_ok=True)
        # A PRIVATE, EMPTY, QUIESCENT CWD PER NODE -- and this is a correctness
        # measure, not tidiness. Verified cells run with the launcher's cwd, and
        # hermit makes host files outside its private /tmp visible to the guest,
        # so a directory entry appearing or vanishing between the two verify
        # executions changes that directory's st_size and shows up as a canonical
        # -log divergence with both guest executions exiting zero. Measured
        # independently on this box: a SERIAL exact-main validate diverged because
        # newfstatat("/home/newton") returned 5788 then 5810
        # (ai_docs/validate-concurrency-characterization-20260824.md, F-3/F-15).
        # N concurrent nodes all writing under one directory would manufacture
        # exactly that, and the divergence rate would then be a property of this
        # harness. Each node gets its own empty directory, created now and never
        # written to again.
        if args.cwd:
            node_cwd = os.path.abspath(args.cwd)
        else:
            node_cwd = str(d / "cwd")
            (d / "cwd").mkdir(parents=True, exist_ok=True)
        # safehermit's own report goes to a FILE, never to the shared stderr:
        # six of its lines embed a per-run id, and demo comparators that line-diff
        # hermit's stderr fail on that difference for a reason unrelated to hermit.
        inner = [
            str(ROOT / "bin/safehermit"),
            "--sh-bin", hermit_bin,
            "--sh-report", str(d / "safehermit.txt"),
            "--sh-deadline", str(args.deadline),
        ]
        inner += args.global_arg
        if args.backend:
            inner += ["--backend", args.backend]
        inner += [
            "run",
            "--verify",
            "--verify-strict",
            "--keep-logs",
            "--verify-log-dir", str(d / "logs"),
            "--verify-json", str(d / "verify.json"),
        ]
        inner += args.hermit_arg
        inner += ["--"] + guest
        # A SCRIPT FILE, NOT AN INLINE ONE-LINER. The first version inlined the
        # whole thing as one `;`-separated string; the runner presents a step's
        # cmd to the shell such that `exit $rc` came apart ("exit: too many
        # arguments"), which made every node exit nonzero and the runner report
        # 3 failed for three runs that had all verified clean. The report was
        # right and the runner's verdict was wrong, which is the worse half of
        # that failure. A file has none of that coupling.
        #
        # It records start/end stamps so peak overlap is MEASURED rather than
        # assumed from -j, and re-raises the child's real exit code so the
        # runner's verdict stays honest.
        runner_script = d / "node.sh"
        runner_script.write_text(
            "#!/usr/bin/env bash\n"
            # Keep safehermit's own captured stderr INSIDE this run's artefact
            # tree. By default it lands in ignored/safehermit/<its run id>/,
            # outside anything this tool bounds or reads, so the artefact cap
            # would not see it and a failure's stderr would not reach the report.
            f"export SAFEHERMIT_LOG_ROOT={shlex.quote(str(d / 'safehermit-logs'))}\n"
            f"cd {shlex.quote(node_cwd)} || exit 70\n"
            f"date +%s.%N > {shlex.quote(str(d / 'started'))}\n"
            f"{' '.join(shlex.quote(a) for a in inner)}\n"
            "rc=$?\n"
            f"date +%s.%N > {shlex.quote(str(d / 'ended'))}\n"
            f"printf '%s' \"$rc\" > {shlex.quote(str(d / 'rc'))}\n"
            # WHAT THIS NODE'S EXIT CODE MEANS: "did this node produce a
            # MEASUREMENT", not "did the cell pass". A diverging cell is the
            # finding, so exiting nonzero on divergence would be wrong twice
            # over -- and it was, measurably. `--keep-going` lets in-flight
            # steps finish but STILL STOPS LAUNCHING NEW ONES, so in sequential
            # mode (-j 1) the first diverging node ended the sweep: 4 of 20
            # nodes ran and the other 16 never started. The real exit code is
            # preserved in `rc` and is reported.
            f"if [ -s {shlex.quote(str(d / 'verify.json'))} ]; then exit 0; fi\n"
            "exit \"$rc\"\n"
        )
        runner_script.chmod(0o755)
        script = f"bash {shlex.quote(str(runner_script))}"
        steps.append(
            {
                "group": "repeat",
                "job": name,
                "desc": f"hermit --verify repeat {i}/{args.runs}",
                "cmd": script,
                "timeout": per_step_timeout,
                "hint": {
                    # AN HONEST PER-NODE BUDGET. hermit sequentializes guest
                    # threads onto one logical CPU, so one node's honest width is
                    # 1 core. Claiming more would let N nodes oversubscribe the
                    # box and turn the contention into an artefact of this
                    # harness rather than a property of the cell. What each node
                    # ACTUALLY got is read back from the runner's step CSV and
                    # printed, so the claim is checkable.
                    "preferred_inner_jobs": 1,
                    "classification": "cpu-bound",
                    "rss_baseline_bytes": args.node_rss_bytes,
                    "hard_mem_max_bytes": args.node_mem_max_bytes,
                },
            }
        )
    return {
        "description": (
            f"hermit-repeat: {args.runs} disconnected verify nodes for "
            f"{' '.join(guest)}"
        ),
        "steps": steps,
    }



def build_nextest_dag(args, out: Path, test_ids: list[str]) -> dict:
    """N boxed nodes per test id, one per repetition.

    Deliberately NOT folded into build_dag(). That function builds a hermit
    verify PAIR -- safehermit, --verify-strict, --keep-logs, a verify.json to
    read coordinates out of -- and none of it applies here. Sharing the
    function would mean a flag on every line of it; sharing the DAG shape,
    the boxing, the per-node budget and the statistics is what actually
    matters and that is what these two have in common.
    """
    steps = []
    per_step_timeout = args.deadline + 60
    width = len(str(args.runs))
    workspace = os.path.abspath(args.test_workspace) if args.test_workspace else str(ROOT / "hermit")
    for test_id in test_ids:
        slug = re.sub(r"[^A-Za-z0-9]+", "-", test_id).strip("-")[:60]
        for i in range(1, args.runs + 1):
            name = f"{slug}-run{i:0{width}d}"
            d = out / "runs" / name
            d.mkdir(parents=True, exist_ok=True)
            (d / "test-id").write_text(test_id + "\n")
            # Run in the hermit checkout: that is where the workspace and the
            # test live. Unlike a hermit guest, a nextest node has no private
            # cwd to give it -- cargo needs the workspace -- so nodes of the
            # same id DO share a directory. Recorded rather than hidden,
            # because the private-cwd reasoning that applies to guests does
            # not apply here and a reader should not assume it does.
            inner = [
                "cargo", "nextest", "run",
                "--no-fail-fast",
                "-E", nextest_filter_for(test_id),
            ]
            runner_script = d / "node.sh"
            runner_script.write_text(
                "#!/usr/bin/env bash\n"
                f"cd {shlex.quote(workspace)} || exit 70\n"
                f"date +%s.%N > {shlex.quote(str(d / 'started'))}\n"
                f"{' '.join(shlex.quote(a) for a in inner)} "
                f"> {shlex.quote(str(d / 'nextest.out'))} 2>&1\n"
                "rc=$?\n"
                f"date +%s.%N > {shlex.quote(str(d / 'ended'))}\n"
                f"printf '%s' \"$rc\" > {shlex.quote(str(d / 'rc'))}\n"
                # Same rule as the hermit nodes: this exit code answers "did
                # this node produce a MEASUREMENT", not "did the test pass".
                # A failing test is the finding. Exiting nonzero on it would
                # make --keep-going stop launching the remaining repetitions
                # and the sweep would silently become a 4-of-20.
                f"if [ -s {shlex.quote(str(d / 'nextest.out'))} ]; then exit 0; fi\n"
                "exit \"$rc\"\n"
            )
            runner_script.chmod(0o755)
            steps.append({
                "group": "repeat",
                "job": name,
                "desc": f"nextest {test_id} repeat {i}/{args.runs}",
                "cmd": f"bash {shlex.quote(str(runner_script))}",
                "timeout": per_step_timeout,
                "hint": {
                    "preferred_inner_jobs": 1,
                    "classification": "cpu-bound",
                    "rss_baseline_bytes": args.node_rss_bytes,
                    "hard_mem_max_bytes": args.node_mem_max_bytes,
                },
            })
    return {
        "description": (
            f"hermit-repeat: {args.runs} nodes x {len(test_ids)} nextest id(s)"
        ),
        "steps": steps,
    }


# --------------------------------------------------------------------------- disk guard
class DiskGuard(threading.Thread):
    """Bound total artefact bytes and KILL the run at the cap.

    THIS CLOSES A REAL HOLE, not a tidy-up. bin/safehermit caps the child's
    STDERR at 64 MiB and kills at the cap -- but under `--verify` hermit diverts
    its log to files under --verify-log-dir, which that cap never sees. So the
    thing that actually grows here is exactly the thing safehermit does not
    bound. N nodes multiply it."""

    def __init__(self, root: Path, cap_bytes: int, on_breach):
        super().__init__(daemon=True)
        self.root, self.cap, self.on_breach = root, cap_bytes, on_breach
        self.stop_evt = threading.Event()
        self.peak = 0
        self.breached = False

    def _size(self) -> int:
        total = 0
        for dirpath, _dirs, files in os.walk(self.root):
            for f in files:
                try:
                    total += os.lstat(os.path.join(dirpath, f)).st_size
                except OSError:
                    pass
        return total

    def run(self):
        while not self.stop_evt.wait(2.0):
            n = self._size()
            self.peak = max(self.peak, n)
            if n > self.cap:
                self.breached = True
                say(
                    f"{PROG}: DISK CAP: artefacts reached {n/1e9:.2f} GB (cap "
                    f"{self.cap/1e9:.2f} GB). Killing the run; the results "
                    f"collected so far are still reported."
                )
                self.on_breach()
                return
        self.peak = max(self.peak, self._size())


# --------------------------------------------------------------------------- collect
def read_json(p: Path):
    try:
        return json.loads(p.read_text())
    except Exception:
        return None


def read_safehermit_bounds(p: Path) -> dict:
    out = {}
    try:
        for line in p.read_text().splitlines():
            if line.startswith("safehermit: ") and "=" in line:
                k, _, v = line[len("safehermit: "):].partition("=")
                out[k.strip()] = v.strip()
    except OSError:
        pass
    return out


def tail_of_stderr(node_dir: Path, lines: int = 6) -> list[str]:
    """The tail of what the node actually printed. safehermit captures the child's
    stderr into its own log dir, which we point INSIDE the node dir so it is both
    covered by the artefact cap and readable here."""
    for log in sorted(node_dir.glob("safehermit-logs/*/hermit.log")):
        try:
            text = log.read_text(errors="replace").rstrip().splitlines()
        except OSError:
            continue
        if text:
            return text[-lines:]
    return []



def collect_one_nextest(r: RunResult) -> RunResult:
    """Fill a nextest node's verdict from its own captured output."""
    d = Path(r.dir)
    try:
        r.test_id = (d / "test-id").read_text().strip()
    except OSError:
        r.test_id = None
    for stamp, attr in (("started", "started_at"), ("ended", "ended_at")):
        try:
            setattr(r, attr, float((d / stamp).read_text().strip()))
        except Exception:
            pass
    try:
        r.exit_code = int((d / "rc").read_text().strip())
    except Exception:
        r.exit_code = None
    try:
        text = (d / "nextest.out").read_text(errors="replace")
    except OSError:
        text = ""
    if not text and r.started_at is None and r.exit_code is None:
        # Same distinction the hermit path makes: --keep-going stops LAUNCHING
        # after a node fails, so a node with no trace at all never ran and
        # calling it a failure would invent one.
        r.category = "not_run"
        r.why = ("the node never started -- the scheduler stopped launching new "
                 "steps. The sweep is TRUNCATED, not complete.")
        return r
    r.category, r.why = classify_nextest_output(text, r.test_id or "?")
    tail = [ln for ln in text.splitlines() if ln.strip()][-6:]
    if r.category in ("failed", "no_result"):
        r.error_tail = tail
    return r

def collect_one(r: RunResult, hermit_bin: str, keep: bool) -> RunResult:
    d = Path(r.dir)
    r.safehermit_bounds = read_safehermit_bounds(d / "safehermit.txt")
    for stamp, attr in (("started", "started_at"), ("ended", "ended_at")):
        try:
            setattr(r, attr, float((d / stamp).read_text().strip()))
        except Exception:
            pass
    try:
        r.exit_code = int((d / "rc").read_text().strip())
    except Exception:
        r.exit_code = None

    verdict = read_json(d / "verify.json")
    if verdict is None and r.started_at is None and r.exit_code is None:
        # NEVER LAUNCHED. Distinct from "failed": the scheduler stopped starting
        # new steps (that is what --keep-going does after any node fails), so
        # this node has no result at all. Calling it failed would report 16
        # nonexistent failures, which is what an earlier version of this did.
        r.category = "not_run"
        r.why = (
            "the node never started -- the scheduler stopped launching new steps "
            "after an earlier node failed. The sweep is TRUNCATED, not complete."
        )
        return r
    if verdict is None:
        r.category = "failed"
        bounds = r.safehermit_bounds
        detail = []
        if r.exit_code is not None:
            detail.append(f"exit {r.exit_code}")
        if r.exit_code == 124:
            detail.append("safehermit DEADLINE fired (cgroup kill)")
        elif r.exit_code == 125:
            detail.append("safehermit STDERR BYTE CAP fired (cgroup kill)")
        if bounds.get("truncated") == "true":
            detail.append("hermit stderr was truncated at the cap")
        if not detail:
            detail.append("no verdict file and no exit code was recorded")
        r.why = "; ".join(detail)
        r.error_tail = tail_of_stderr(d)
        return r

    r.guest_exit_code = verdict.get("guest_exit_code")
    v = verdict.get("verdict")
    if v == "matched" and verdict.get("verified"):
        r.category = "clean"
        r.why = (
            "verified deterministic"
            + (", bitwise_parity=true" if verdict.get("bitwise_parity") else
               ", bitwise_parity=FALSE (not L2 -- KVM's output-only fallback)")
        )
        return r
    if v != "diverged":
        # HERMIT'S `no_result` COVERS TWO DIFFERENT THINGS and they must not share
        # a bucket. "the comparison ran and selected nothing" is a no-result;
        # "run 1 died so there was never a second run to compare" is a FAILURE.
        # Measured: LiteInst on `sh -c 'seq | wc -l'` writes verdict=no_result
        # with comparison=null after erroring out of run 1 -- filing that as
        # no-result would report a hard backend failure as a measurement gap.
        if verdict.get("comparison") is None:
            r.category = "failed"
            r.why = (
                f"hermit wrote verdict={v!r} with no comparison at all"
                + (f" (node exit {r.exit_code})" if r.exit_code is not None else "")
                + " -- the run did not reach a second execution"
            )
            r.error_tail = tail_of_stderr(d)
        else:
            r.category = "no_result"
            r.why = (
                f"hermit reported verdict={v!r} -- the comparison ran but selected "
                "nothing comparable"
            )
        return r

    r.category = "diverged"
    r.why = "hermit --verify reported the two executions diverged"
    r.sched_turn = verdict.get("first_divergent_scheduler_turn")
    r.virtual_ns = verdict.get("first_divergent_virtual_nanoseconds")
    r.coord_source = "hermit run --verify-json"

    # --verify-json does not carry first_divergent_record today (hermit#2386,
    # which publishes it to the verify report, is NOT landed), so get it from
    # log-diff on the two retained logs -- the same comparator, run again.
    logs = sorted((d / "logs").glob("run1_log_*")), sorted((d / "logs").glob("run2_log_*"))
    if not (logs[0] and logs[1]):
        r.coord_cross_check = (
            "UNAVAILABLE: --keep-logs did not leave a run1/run2 log pair, so "
            "info_record and syscall could not be located"
        )
        r.syscall_note = "UNAVAILABLE: no retained log pair to read it from"
        return r
    left, right = logs[0][0], logs[1][0]
    ldj = d / "logdiff.json"
    try:
        subprocess.run(
            [hermit_bin, "log-diff", "--json", str(ldj), str(left), str(right)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=600,
            check=False,
        )
    except Exception as exc:
        r.coord_cross_check = f"UNAVAILABLE: log-diff failed to run ({exc})"
        r.syscall_note = "UNAVAILABLE: log-diff did not run"
        return r
    ld = read_json(ldj)
    if not ld or ld.get("first_divergent_record") is None:
        r.coord_cross_check = (
            "UNAVAILABLE: log-diff produced no first_divergent_record for this pair"
        )
        r.syscall_note = "UNAVAILABLE: no record index to anchor the lookup"
        return r
    r.info_record = ld["first_divergent_record"]
    r.coord_source = "hermit run --verify-json + hermit log-diff --json"

    # CROSS-CHECK before trusting the derived syscall ordinal. We locate the
    # record ourselves to read the syscall counter, so we first prove our record
    # indexing agrees with hermit's by re-deriving the turn and virtual time it
    # already reported. If those disagree, our index is wrong and the syscall
    # number would be confidently wrong too -- so it is withheld, not printed.
    try:
        pieces = records_by_comparator_index(left.read_text(errors="replace"))
    except OSError as exc:
        r.coord_cross_check = f"UNAVAILABLE: could not read {left} ({exc})"
        r.syscall_note = "UNAVAILABLE: run 1's log could not be read"
        return r
    turn, ns = commit_at_or_before(pieces, r.info_record)
    ld_turn = ld.get("first_divergent_scheduler_turn")
    ld_ns = ld.get("first_divergent_virtual_nanoseconds")
    if r.sched_turn is None:
        r.sched_turn = ld_turn
    if r.virtual_ns is None:
        r.virtual_ns = ld_ns
    if r.sched_turn is None:
        r.turn_note = (
            "hermit reported no scheduler turn for this divergence: no COMMIT record "
            "precedes it in either log. `--no-sequentialize-threads` produces this, "
            "since it removes the serialized-schedule COMMITs the coordinate is read "
            "from. Absent, not zero."
        )

    if ld_turn is not None:
        # A REAL CHECK: hermit already located this divergence by turn, so if our
        # record indexing is right we must land on the same turn from the same
        # index.
        if turn == ld_turn and (ns == ld_ns or ld_ns is None):
            r.coord_cross_check = (
                "VERIFIED: reading run 1's log at record "
                f"{r.info_record} independently reproduces hermit's turn "
                f"({ld_turn}) and virtual time, so the record index is right"
            )
            r.coord_verified = True
        else:
            r.coord_cross_check = (
                f"FAILED: at record {r.info_record} we read turn={turn} ns={ns} but "
                f"hermit reported turn={ld_turn} ns={ld_ns}; the syscall ordinal is "
                f"WITHHELD rather than reported wrong"
            )
            r.syscall_note = (
                "WITHHELD: the record-index cross-check failed, so any syscall "
                "number read at that index would be confidently wrong"
            )
            return r
    else:
        # NOT A PASS. hermit reported no turn, so comparing our None to its None
        # would agree on nothing -- an earlier version of this code did exactly
        # that and printed "OK". The weaker check that IS available is applied,
        # and the result is labelled UNVERIFIED so the syscall number is read as
        # what it is.
        rec = pieces.get(r.info_record, "")
        if rec.startswith("INFO "):
            r.coord_cross_check = (
                "UNVERIFIED: hermit published no turn for this divergence, so there "
                "is nothing to check the record index against. The record at that "
                "index IS an INFO record, which is necessary but not sufficient. "
                "Treat the syscall coordinate below as indicative, not established."
            )
        else:
            r.coord_cross_check = (
                f"FAILED: record {r.info_record} of run 1's log is not an INFO record "
                f"({rec[:40]!r}), so the index does not mean what we assumed"
            )
            r.syscall_note = "WITHHELD: the record index does not resolve to an INFO record"
            return r

    r.syscall_ordinal, r.syscall_dtid = syscall_at_or_before(pieces, r.info_record)
    if r.syscall_ordinal is None:
        r.syscall_note = (
            "NONE_YET: no `finish syscall #N` record precedes the divergence in "
            "run 1's log -- the two executions parted before any intercepted "
            "syscall completed. This is a measured zero, not a gap."
        )
    if not keep:
        for f in (left, right):
            try:
                f.unlink()
            except OSError:
                pass
    return r


def join_step_csv(results: list[RunResult], perf_dir: Path):
    rows = {}
    for csv_path in perf_dir.glob("step_profiles_*.csv"):
        try:
            with open(csv_path, newline="") as fh:
                for row in csv.DictReader(fh):
                    rows[row.get("step", "")] = row
        except OSError:
            continue
    for r in results:
        row = rows.get(f"repeat.{r.name}")
        if not row:
            continue

        def num(key, cast):
            v = row.get(key)
            if v in (None, ""):
                return None
            try:
                return cast(v)
            except ValueError:
                return None

        r.inner_jobs = num("inner_jobs", int)
        r.effective_cores = num("effective_cores", float)
        r.peak_bytes = num("peak_bytes", int)
        r.elapsed_s = num("elapsed_s", float)
        r.oom_kills = num("oom_kills", int)
        r.timed_out = row.get("timed_out") == "true"
        r.co_tenants_start = num("co_tenants_start", int)
        r.load1_start = num("load1_start", float)


def measured_peak_overlap(results: list[RunResult]) -> int | None:
    events = []
    for r in results:
        if r.started_at is None or r.ended_at is None:
            continue
        events.append((r.started_at, 1))
        events.append((r.ended_at, -1))
    if not events:
        return None
    events.sort()
    cur = peak = 0
    for _t, delta in events:
        cur += delta
        peak = max(peak, cur)
    return peak



# --------------------------------------------------------------------------- nextest ids
NEXTEST_RESULT = re.compile(
    r"^\s+(PASS|FAIL|LEAK|LEAK-FAIL|TIMEOUT|SLOW|TRY \d+ FAIL|TRY \d+ ERROR"
    r"|SIGSEGV|SIGABRT|ABORT|ERROR)\s+\[\s*[0-9.]+s\]\s+(\S+)\s+(\S+)\s*$",
    re.M,
)
NEXTEST_SUMMARY = re.compile(r"^\s*Summary\s+\[[^\]]*\]\s+(\d+)\s+tests?\s+run", re.M)
NEXTEST_STARTING = re.compile(r"^\s*Starting\s+(\d+)\s+tests?\s+across", re.M)


def nextest_filter_for(test_id: str) -> str:
    """A nextest filterset selecting EXACTLY one test.

    ⚠️ WHICH NAMESPACE THIS ACCEPTS, because getting it wrong selects NOTHING and
    nextest calls that success. nextest's own test id is `BINARY$TEST`, e.g.
    `hermit::cli$run_dbt_verifies_self_prlimit`. Its result lines print the two
    space-separated, `hermit::cli run_dbt_verifies_self_prlimit`, and a reader
    who rejoins them with `::` produces a string that matches no test at all:
    `test()` matches the TEST name only, never the binary.
    That rejoined form is also AMBIGUOUS and cannot be split back, which is why
    this takes `$` rather than being clever. Both of these are real ids and both
    are `A::B`, with the boundary in different places:
        binary hermit::cli    test run_dbt_verifies_self_prlimit
        binary hermit-detcore test detlog::tests::detlog_observed_is_true...
    So: `BINARY$TEST` pins both. A bare TEST with no `$` is accepted and pins
    only the test name, which may legitimately exist in several binaries -- the
    multi-test guard in classify_nextest_output catches that rather than
    scoring one arbitrarily.

    The EXACT-match forms `=` are deliberate throughout: `test(NAME)` is a
    SUBSTRING match and would pull in every id having this one as a prefix,
    which for several ids of interest is the whole
    liteinst_strict_verify_round2_* family. Invisible until it runs the wrong set.
    """
    if "$" in test_id:
        binary, _, test = test_id.partition("$")
        return f"binary(={binary}) and test(={test})"
    return f"test(={test_id})"


def classify_nextest_output(text: str, test_id: str) -> tuple[str, str]:
    """(category, why) for one nextest node, from its own output.

    ⚠️ AN ID THAT SELECTS NOTHING MUST NOT READ AS A PASS. nextest exits 0 when a
    filterset matches no test, so a typo, a renamed test, or a test behind a
    cfg that is off all produce a silent green. That is the single worst input
    here: the whole point is to decide whether a named id fails, and "no such
    id" answered as "did not fail" is how a set gets marked as known-failing
    while one of its members has quietly ceased to exist. Reported as its own
    category, never as clean.
    """
    ran = NEXTEST_SUMMARY.search(text) or NEXTEST_STARTING.search(text)
    verdicts = {}
    for m in NEXTEST_RESULT.finditer(text):
        v = m.group(1)
        if v == "SLOW":
            continue
        verdicts[f"{m.group(2)}::{m.group(3)}"] = v

    if ran and int(ran.group(1)) == 0:
        return "no_result", (
            f"the filterset {nextest_filter_for(test_id)!r} selected NO test. "
            f"nextest exits 0 for this, so it would otherwise read as a pass. "
            f"The id may be misspelled, renamed, or compiled out."
        )
    if not verdicts:
        return "failed", (
            "nextest produced no per-test verdict line at all -- the node did not "
            "get as far as running a test (build failure, or killed)."
        )
    if len(verdicts) > 1:
        return "no_result", (
            f"the filterset selected {len(verdicts)} tests, not one: "
            f"{', '.join(sorted(verdicts)[:4])}. A per-id verdict cannot be read "
            f"from a multi-test run."
        )
    only = next(iter(verdicts.values()))
    if only == "PASS":
        return "clean", f"nextest reported PASS for {test_id}"
    return "failed", f"nextest reported {only} for {test_id}"



# --------------------------------------------------------------------------- bound proximity
# ⚠️ A FAILURE THAT RAN CLOSE TO ITS BOUND MAY NOT BE A FAILURE OF THE CELL.
# agent(hermit-122) measured, under two concurrent validates, deadline-sensitive
# failures including a KVM failure it classified as a bound-kill under
# contention. A pressure test is DELIBERATELY load, so it is the tool most
# likely to produce exactly that and the least able to notice: the verdict says
# "failed" either way.
# The pieces to tell them apart were already recorded -- elapsed_s, timed_out,
# exit 124, safehermit's bound.wall -- but they sat in three different tables, so
# separating a bound-kill from a real failure meant cross-referencing by hand and
# nobody would.
BOUND_PROXIMITY = 0.80


def bound_note(r, deadline: float | None) -> str | None:
    """One phrase saying whether this run's failure could be the bound firing.

    Returns None when the question does not arise -- the run did not fail, or
    there is no elapsed time to compare. Deliberately NOT a verdict: a run at 95%
    of its bound MIGHT still have failed on its merits, and saying otherwise
    would trade one unjustified claim for another."""
    if r.category not in ("failed", "no_result"):
        return None
    if r.exit_code == 124 or r.timed_out:
        return "BOUND FIRED: killed at the deadline, so this is not a cell verdict"
    if r.exit_code == 125:
        return "BOUND FIRED: stderr byte cap, so this is not a cell verdict"
    if not deadline or not r.elapsed_s:
        return None
    frac = r.elapsed_s / deadline
    if frac >= BOUND_PROXIMITY:
        return (f"NEAR THE BOUND: ran {r.elapsed_s:.1f}s of a {deadline:.0f}s deadline "
                f"({100*frac:.0f}%) -- contention could have made this a bound-kill")
    return f"ran {r.elapsed_s:.1f}s of a {deadline:.0f}s deadline ({100*frac:.0f}%)"


def bound_summary_lines(results: list, deadline: float | None) -> list[str]:
    """How many failures could be the bound rather than the cell."""
    failed = [r for r in results if r.category in ("failed", "no_result")]
    if not failed:
        return []
    fired = [r for r in failed if r.exit_code in (124, 125) or r.timed_out]
    near = [r for r in failed
            if r not in fired and deadline and r.elapsed_s
            and r.elapsed_s / deadline >= BOUND_PROXIMITY]
    unknown = [r for r in failed if r not in fired and r not in near
               and not (deadline and r.elapsed_s)]
    out = [f"  BOUND CHECK on {len(failed)} non-passing run(s), deadline "
           f"{deadline:.0f}s:" if deadline else
           f"  BOUND CHECK on {len(failed)} non-passing run(s): NO DEADLINE RECORDED"]
    out.append(f"    {len(fired)} killed BY the bound -- not cell verdicts")
    out.append(f"    {len(near)} ran to >= {100*BOUND_PROXIMITY:.0f}% of it -- could be "
               f"bound-kills under contention")
    out.append(f"    {len(failed) - len(fired) - len(near) - len(unknown)} finished well "
               f"inside it -- these are the cell's own failures")
    if unknown:
        out.append(f"    {len(unknown)} have NO elapsed time recorded, so the question "
                   f"cannot be answered for them")
    if fired or near:
        out.append("    ⚠️ A pressure test is deliberately load. Do not report the rows "
                   "above")
        out.append("       as cell flakiness without saying the bound may have produced "
                   "them.")
    return out


# --------------------------------------------------------------------------- report
def fmt(v, width, none="-"):
    return (none if v is None else str(v)).rjust(width)


def stats(values: list[int]) -> str:
    if not values:
        return "-"
    s = sorted(values)
    uniq = len(set(s))
    return f"min {s[0]}  max {s[-1]}  distinct {uniq}"


def syscall_range_lines(diverged: list) -> list[str]:
    """The syscall row of the range table, which CANNOT use plain stats().

    Two properties make this coordinate different from the other three, and
    pooling it like them produced two measured falsehoods:

    1. IT IS PER-THREAD. `finish syscall #N` counts within one dtid, as the
       UNIT KEYSPACES block printed a few lines below says in as many words.
       Pooling it across threads reports two DIFFERENT positions as one:
       run1 at dtid 3 #12 and run2 at dtid 7 #12 rendered as
       `min 12  max 12  distinct 1`, which is the report's own wording for
       "the divergence point never moved". So the range is broken out per
       dtid, and a single pooled line is emitted only when every run
       diverged in the same thread.
    2. IT IS THE ONLY COORDINATE GATED ON A CROSS-CHECK. `coord_verified` is
       false when hermit published no turn to check our record index
       against, and CHECK_KIND_MEANING calls such a value "indicative, not
       established". Those were silently setting the published min and max:
       a fixture with one verified 12 and one unverified 999 printed
       `min 12  max 999  distinct 2` with nothing on the line to say the max
       was never established. Unverified ordinals are excluded from the
       range and DISCLOSED, in the same `[n of m]` shape the other rows use
       for absent values -- the tool already withholds this number when the
       cross-check FAILS, and this applies the same discipline one step
       further out, to the aggregate a reader actually quotes.
    """
    label = "syscall(#)"
    n = len(diverged)
    usable = [r for r in diverged if r.syscall_ordinal is not None and r.coord_verified]
    indicative = [r for r in diverged if r.syscall_ordinal is not None and not r.coord_verified]
    absent = n - len(usable) - len(indicative)

    notes = []
    if absent:
        notes.append(f"{absent} of {n} not reported")
    if indicative:
        notes.append(
            f"{len(indicative)} of {n} EXCLUDED as unverified "
            f"({', '.join(r.name for r in indicative[:4])}"
            f"{'...' if len(indicative) > 4 else ''})"
        )
    tail = f"   [{'; '.join(notes)}]" if notes else ""

    if not usable:
        return [f"  {label:<12} -{tail}"]

    dtids = sorted({r.syscall_dtid for r in usable})
    if len(dtids) == 1:
        vals = [r.syscall_ordinal for r in usable]
        return [f"  {label:<12} {stats(vals)}  (all in dtid {dtids[0]}){tail}"]

    out = [
        f"  {label:<12} NOT POOLED -- these runs diverged in {len(dtids)} DIFFERENT "
        f"threads{tail}",
        "               and `finish syscall #N` counts per thread, so one range "
        "across them",
        "               would compare positions on different axes. Per dtid:",
    ]
    for dtid in dtids:
        vals = [r.syscall_ordinal for r in usable if r.syscall_dtid == dtid]
        out.append(f"                 dtid {dtid}: {stats(vals)}   [{len(vals)} of {n} runs]")
    return out


# The runs inside one CONCURRENT sweep are not independent, and the binomial
# interval assumes they are.
#
# MEASURED, not assumed (experiments/race-oracle-repeat-variance_20260824, 800
# runs, 40 sweeps, one arm held fixed, modes interleaved):
#
#   sequential  75/400 = 18.8%   dispersion 0.96   chi-square 18.3 / 19 df
#   concurrent 144/400 = 36.0%   dispersion 2.64   chi-square 50.2 / 19 df
#
# Sequential is binomial to three digits. Concurrent is not: its sweep-to-sweep
# variance is 2.64x what independence predicts, it tracks host load (r = +0.549
# against +0.155 for sequential), and dropping the three highest-load sweeps
# collapses it to 1.38. The extra variance enters through CONTENTION -- every
# run in a concurrent sweep shares one contention episode -- not through the
# oracle, which is why the correction belongs to the mode and not to the tool.
#
# WHY THIS IS NOT COSMETIC. On that data the naive interval declares two sweeps
# of the IDENTICAL arm to be different in 15 of 190 pairs, 7.9%. Every one of
# those is a false positive, against a nominal rate under 1% for non-overlapping
# 95% intervals. Applying the correction takes it to 0 of 190. Sequential was
# already 0 of 190 and is deliberately left uncorrected: widening an interval
# that is already right would only hide real differences.
#
# A SINGLE SWEEP CANNOT ESTIMATE ITS OWN DESIGN EFFECT. The overdispersion is
# BETWEEN sweeps, and one sweep has one contention episode, so there is nothing
# to compare within it -- no N, however large, fixes that, because growing N
# grows the episode rather than replicating it. Estimating it needs replicate
# sweeps: R>=10 of them, roughly R x the wall cost of one sweep. Until a caller
# does that, this measured constant is the honest default, and --design-effect
# overrides it for anyone who has measured their own.
CONCURRENT_DESIGN_EFFECT = 2.64
SEQUENTIAL_DESIGN_EFFECT = 1.0


def wilson95(k: int, n: int, deff: float = 1.0) -> tuple[float, float]:
    """Wilson score interval for a proportion. Used instead of the normal
    approximation because it stays inside [0,1] and behaves at k=0 and k=n,
    which is exactly where a 20-run sweep lands.

    `deff` is the design effect: the factor by which the true variance exceeds
    the binomial variance. deff=1 is the ordinary Wilson interval. Larger values
    widen it by sqrt(deff), which is the standard survey-sampling correction for
    observations that are not independent."""
    if n == 0:
        return (0.0, 1.0)
    z = 1.959963984540054 * (deff ** 0.5)
    p = k / n
    denom = 1 + z * z / n
    centre = (p + z * z / (2 * n)) / denom
    half = z * ((p * (1 - p) / n + z * z / (4 * n * n)) ** 0.5) / denom
    return (max(0.0, centre - half), min(1.0, centre + half))


def design_effect_for(mode: str, override: float | None) -> float:
    """The design effect this mode's interval must carry. An explicit override
    always wins, including an override of 1.0, which is how a caller who has
    measured a quiet box asks for the uncorrected interval."""
    if override is not None:
        return override
    return CONCURRENT_DESIGN_EFFECT if mode == "concurrent" else SEQUENTIAL_DESIGN_EFFECT


COMMANDS_DIR = "ignored/e2e-commands"


def absolutise_repo_paths(guest: list[str], hermit_root) -> tuple[list[str], list[str]]:
    """Rewrite repo-relative guest tokens to absolute paths under `hermit_root`.

    Returns (rewritten tokens, the originals that were rewritten).

    EXISTENCE IS THE DISCRIMINATOR, and it has to be. Many cells pass bare
    selector WORDS as guest arguments -- `chaos`, `condvar`, `epoll`,
    `pipe-order` -- and a rule that absolutised every token without a leading
    slash would turn each of those into a path that does not exist and has
    never been asked for. Measured over the generated commands: 27 argument
    tokens look relative, exactly 1 is a real file.
    """
    out, rewritten = list(guest), []
    for i, g in enumerate(out):
        if g.startswith("-") or os.path.isabs(g):
            continue
        cand = hermit_root / g
        if cand.exists():
            out[i] = str(cand)
            rewritten.append(g)
    return out, rewritten



def unwrap_bucket_command(body: str) -> tuple[str, str | None]:
    """Recover the cell's real program from the bucket's wrapper.

    ⚠️ THE GENERATED SHAPE CHANGED AND THE OLD PARSE FAILED CONFUSINGLY. The
    bucket now emits

        timeout --kill-after=10s 15s bash -c '<the whole cell>'   # <id> mode= backend=

    where the program is single-quoted with '\''-escaping. Splitting that at the
    hermit invocation lands INSIDE the quotes, so `bash -c` got an unterminated
    string and reported "unexpected EOF while looking for matching quote" -- a
    shell syntax error that says nothing about the real cause. The existing guard
    only caught the marker being ABSENT; here it is present, just quoted.

    Returns (program, per-cell cap). The cap is the bucket's own per-cell
    timeout, which this sweep does NOT apply -- it runs each node under its own
    deadline -- so it is returned to be REPORTED rather than silently dropped:
    a cell the bucket caps at 15s and this tool does not is being run under
    different conditions, and that difference belongs in the report.
    """
    try:
        toks = shlex.split(body)
    except ValueError:
        return body, None
    cap = None
    if toks and toks[0] == "timeout":
        for t in toks[1:4]:
            if re.fullmatch(r"[0-9]+(\.[0-9]+)?s?", t):
                cap = t
                break
    for i, t in enumerate(toks):
        if t == "-c" and i and toks[i - 1].rsplit("/", 1)[-1] in ("bash", "sh") and i + 1 < len(toks):
            return toks[i + 1], cap
    return body, cap


def resolve_cell(cell_id: str, want_backend: str | None):
    """A manifest cell id -> (guest argv, backend, hermit flags).

    ⚠️ THE MANIFEST IS NOT RE-IMPLEMENTED HERE, DELIBERATELY. The cell's real
    definition -- which program, which backends, which hermit flags, which
    fixture and HOME and XDG directories -- lives in tests/e2e/manifests/*.yaml
    and is expanded by scripts/manifest-to-commands.rs into exactly the command
    the e2e bucket runs. A second expansion in this file would be a second
    definition of what a cell IS, and the two would drift the first time either
    changed. So this SHELLS OUT to that expander and reads its output.

    What this means for the measurement: the sweep stresses the cell as the
    bucket runs it, not an approximation of it. If the flags differ, the answer
    is about a configuration nobody schedules.
    """
    root = ROOT
    commands = root / COMMANDS_DIR
    if not commands.is_dir() or not any(commands.glob("*.txt")):
        say(f"{PROG}: " + f"expanding manifests into {COMMANDS_DIR} (scripts/manifest-to-commands.rs)")
        r = subprocess.run(
            [str(root / "hermit/scripts/manifest-to-commands.rs")],
            cwd=root / "hermit", capture_output=True, text=True,
        )
        if r.returncode != 0:
            die(f"manifest expansion failed ({r.returncode}): {r.stderr.strip()[:400]}")
        commands = root / "hermit" / COMMANDS_DIR
    if not commands.is_dir():
        commands = root / "hermit" / COMMANDS_DIR

    # Every generated line ends with `# <id> mode=<m> backend=<b>`, which is the
    # only stable key in it; the body is one long shell pipeline.
    hits = []
    for f in sorted(commands.glob("*.txt")):
        for line in f.read_text().splitlines():
            marker = f"# {cell_id} mode="
            if marker in line:
                tail = line[line.index(marker) + 2:]
                fields = dict(
                    kv.split("=", 1) for kv in tail.split() if "=" in kv
                )
                hits.append((fields.get("backend", "?"), fields.get("mode", "?"), line, f.name))
    if not hits:
        die(f"cell {cell_id!r} is in no expanded bucket under {commands}. "
            f"Check the id against tests/e2e/manifests/*.yaml.")
    verify = [h for h in hits if h[1] == "verify"]
    if not verify:
        die(f"cell {cell_id!r} declares no `verify` mode ({', '.join(sorted({h[1] for h in hits}))} "
            f"only). This tool measures verify pairs; there is nothing to compare otherwise.")
    if want_backend:
        chosen = [h for h in verify if h[0] == want_backend]
        if not chosen:
            die(f"cell {cell_id!r} has no verify/{want_backend}; enabled: "
                f"{', '.join(sorted({h[0] for h in verify}))}")
    else:
        chosen = [verify[0]]
        others = sorted({h[0] for h in verify}) 
        if len(others) > 1:
            say(f"{PROG}: cell {cell_id} has verify backends {', '.join(others)}; "
                 f"stressing {chosen[0][0]} (pick with --cell-backend)")
    backend, _mode, line, bucket = chosen[0]

    # Run everything the cell does BEFORE hermit -- mkdir, xdg-config copy, and the
    # ${CC} compile -- once, so the sweep's N nodes all execute the same prebuilt
    # guest. Re-compiling per node would put the compiler in the measurement.
    body = line.split(" # ")[0]
    body, bucket_cap = unwrap_bucket_command(body)
    if bucket_cap:
        say(f"{PROG}: " + f"NOTE: the bucket caps this cell at {bucket_cap}; this sweep does "
            f"NOT apply that cap and runs each node under its own --deadline instead.")
    marker = ' "$hermit_bin" '
    if marker not in body:
        # some cells invoke hermit without the env prefix
        marker = '"$hermit_bin" '
        if marker not in body:
            die(f"cannot find the hermit invocation in the expansion of {cell_id!r}; "
                f"the generated shape changed and this resolver must be updated "
                f"rather than guessed at.")
    prep = body[: body.index(marker)].rstrip().rstrip("&").rstrip()
    hermit_part = body[body.index(marker):]
    r = subprocess.run(["bash", "-c", prep], cwd=root / "hermit",
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"cell {cell_id!r} setup/compile failed ({r.returncode}): "
            f"{(r.stderr or r.stdout).strip()[-500:]}")

    # The guest is the argument after the bare `--`, and the hermit flags are what
    # sits between `run` and it. --verify/--verify-json/--strict are supplied by the
    # sweep itself, so they are dropped here to avoid passing them twice.
    toks = hermit_part.split()
    if "--" not in toks:
        die(f"no guest separator in the expansion of {cell_id!r}")
    cut = toks.index("--")
    flags, guest_toks = toks[:cut], toks[cut + 1:]
    # --backend takes its value as a SEPARATE token. Dropping the flag alone left
    # the bare value ("ptrace") in the carried-through flags, where hermit would
    # have read it as a positional. Caught by the dry-run printing
    # `flags carried through: --base-env=minimal ptrace`.
    drop_with_value = {"--verify-json", "--log", "--backend"}
    drop = {"--verify", "--verify-strict", "--strict", "run", '"$hermit_bin"', "$hermit_bin"}
    keep, skip_next = [], False
    for t in flags:
        if skip_next:
            skip_next = False
            continue
        if t in drop_with_value:
            skip_next = True
            continue
        if t.split("=")[0] in drop_with_value or t in drop:
            continue
        if t.startswith("$run_verify_strict") or t.startswith("$record_verify_strict"):
            continue
        keep.append(t)
    guest = [t.strip('"') for t in guest_toks]
    guest = [g.replace("$cell", str((root / "hermit" / COMMANDS_DIR / "work" /
                                     cell_id.replace("/", "-")))) for g in guest]

    # ⚠️ ABSOLUTISE REPO-RELATIVE PATHS, OR 61 OF 366 CELLS CANNOT RUN AT ALL.
    #
    # The bucket runs the guest with the HERMIT REPO ROOT as its cwd, so a cell
    # may name its program or its inputs relative to that root. This sweep
    # deliberately gives every node its OWN EMPTY, QUIESCENT cwd -- without that,
    # a directory entry appearing between a node's two executions changes
    # st_size and reads as a divergence (measured serially: newfstatat on a
    # shared directory returned 5788 then 5810). Both designs are right; together
    # they broke every cell whose paths are repo-relative, in two ways:
    #
    #   language-runtimes/python-dict-hash-iteration -> guest PROGRAM is
    #       `tests/e2e/language-runtimes/python-dict-hash-iteration.sh`
    #       -> exit 127, "Could not resolve program ... in the guest PATH"
    #   c-programs/record-replay-lseek-seek-cur      -> guest ARGV is `README.md`
    #       -> exit 125, "open(fixture) failed: No such file or directory"
    #
    # Measured over the generated commands: 60 cells name a relative PROGRAM and
    # 6 name a relative FILE ARGUMENT, 61 distinct cells in all. It is not a
    # uniform 17% either -- every one of them is a non-C cell (system-utils 26,
    # language-runtimes 18, data-handling 6, applications 6, determinism-stress
    # 4), because the compiled-C shape is the one that already gets an absolute
    # path from the $cell substitution above. So --cell worked on exactly the
    # shape it was demonstrated on and on no other.
    #
    # ONLY tokens that ACTUALLY EXIST at the repo root are rewritten. Many cells
    # pass bare selector words as arguments -- `chaos`, `condvar`, `epoll`,
    # `pipe-order` -- and a rule that absolutised anything without a leading `/`
    # would corrupt those into paths. Existence is the discriminator: of 27
    # candidate relative argument tokens, exactly 1 is a real file.
    hermit_root = (root / "hermit").resolve()
    guest, absolutised = absolutise_repo_paths(guest, hermit_root)
    if absolutised:
        say(f"{PROG}: " + f"cell repo-relative path(s) resolved against {hermit_root}: "
            f"{', '.join(absolutised)}")

    say(f"{PROG}: " + f"cell {cell_id} -> backend={backend} bucket={bucket} guest={' '.join(guest)}")
    if keep:
        say(f"{PROG}: " + f"cell hermit flags carried through: {' '.join(keep)}")
    return guest, backend, keep


def histogram(values: list[int]) -> list[tuple[int, int]]:
    out = {}
    for v in values:
        out[v] = out.get(v, 0) + 1
    return sorted(out.items())



def per_id_lines(results: list) -> list[str]:
    """One pass/fail count per test id, which is the whole point of a multi-id
    sweep: a SET that fails every time is a different thing from a set whose
    membership moves, and only per-id counts can tell them apart."""
    out = []
    ids = []
    for r in results:
        if r.test_id and r.test_id not in ids:
            ids.append(r.test_id)
    if not ids:
        return out
    out.append("-" * 78)
    out.append(f"PER TEST ID ({len(ids)} ids)")
    out.append("-" * 78)
    out.append(f"  {'failed':>6} {'clean':>6} {'other':>6} {'runs':>5}   test id")
    for tid in ids:
        rs = [r for r in results if r.test_id == tid]
        nf = sum(r.category == "failed" for r in rs)
        nc = sum(r.category == "clean" for r in rs)
        no = len(rs) - nf - nc
        out.append(f"  {nf:>6} {nc:>6} {no:>6} {len(rs):>5}   {tid}")
    out.append("")
    out.append("  'other' is a node that produced NO verdict for the id -- an id that")
    out.append("  selected no test, a filterset that selected several, a build failure,")
    out.append("  or a node the scheduler never launched. It is counted separately and")
    out.append("  NEVER folded into clean: an id that has ceased to exist must not read")
    out.append("  as an id that did not fail.")
    unresolved = sorted({r.test_id for r in results
                         if r.test_id and r.category == "no_result"})
    if unresolved:
        out.append("")
        out.append(f"  ⚠️ {len(unresolved)} id(s) produced NO USABLE VERDICT IN AT LEAST ONE RUN:")
        for tid in unresolved:
            why = next((r.why for r in results if r.test_id == tid and r.category == "no_result"), "")
            out.append(f"     {tid}")
            for line in _wrap(why, 64):
                out.append(f"       {line}")
    out.append("")
    return out

def write_report(args, meta: dict, results: list[RunResult], fh):
    w = lambda s="": print(s, file=fh)
    by = lambda c: [r for r in results if r.category == c]
    diverged, clean, failed, noresult = (by("diverged"), by("clean"), by("failed"), by("no_result"))
    notrun = by("not_run")
    n = len(results)

    w("=" * 78)
    w(f"{PROG}: " + ("PASS/FAIL PER TEST ID, ACROSS REPEATED RUNS"
                     if any(r.test_id for r in results)
                     else "DISTRIBUTION OF FIRST DIVERGENCE POINTS"))
    w("=" * 78)
    nx_ids = [t for t in dict.fromkeys(r.test_id for r in results if r.test_id)]
    if nx_ids:
        # ⚠️ NO HERMIT BINARY, NO BACKEND, NO GUEST COMMAND. These tests do NOT
        # run under hermit, and the header used to print `backend: ptrace
        # (hermit default; not passed explicitly)` beside them -- a reader would
        # reasonably conclude the suite had been run under ptrace. It had not.
        # An inherited default printed in the wrong context is an assertion.
        w(f"test ids         : {len(nx_ids)}")
        for t in nx_ids:
            w(f"                   {t}")
        w(f"workspace        : {meta.get('test_workspace', '(hermit checkout)')}")
        w(f"runner           : cargo nextest run --no-fail-fast -E 'binary(=..) and test(=..)'")
        w(f"run id           : {meta['run_id']}")
        w(f"artefacts        : {meta['out_dir']}")
        w()
        w("ONE RUN = one `cargo nextest run` invocation selecting EXACTLY ONE test.")
        w("N runs of each id give N independent pass/fail observations of that id.")
        w("This is NOT a hermit verify pair: nothing is compared against anything,")
        w("so there is no determinism claim here and no divergence coordinate.")
    else:
        w(f"guest command    : {meta['guest_cmdline']}")
        w(f"hermit binary    : {meta['hermit_bin']}")
        w(f"                   sha256 {meta['hermit_sha256']}  ({meta['hermit_source']})")
        w(f"backend          : {meta['backend']}")
        w(f"hermit run flags : {meta['hermit_flags']}")
        w(f"run id           : {meta['run_id']}")
        w(f"artefacts        : {meta['out_dir']}")
        w()
        w("ONE RUN = one `hermit run --verify --verify-strict` invocation, i.e. TWO")
        w("back-to-back guest executions compared against each other under the")
    if not nx_ids:
        w(f"canonical BitwiseInfoV1 envelope. {n} such invocations give {n} independent")
        w("observations. Runs are NOT compared against each other: two separately-")
        w("produced runs need byte-identical argv and environment to be comparable")
        w("(see `hermit log-diff --help`), and N nodes cannot have that.")
    w()
    w(f"MODE             : {meta['mode'].upper()} -- {meta['mode_meaning']}")
    w(f"scheduling       : {meta['runner']}, -j {meta['jobs']}")
    w(f"runner verdict   : {meta['runner_exit_label']}")
    for line in _wrap(meta["runner_verdict_meaning"], 60):
        w(f"                   {line}")
    w(f"peak overlap     : {meta['peak_overlap']} (MEASURED from per-node start/end stamps,")
    w("                   not inferred from -j)")
    w(f"boxing           : {meta['boxing']}")
    w(f"per-node budget  : declared preferred_inner_jobs=1 (hermit sequentializes")
    w("                   guest threads onto one logical CPU). What each node")
    w("                   actually got is in the PER-NODE column below.")
    w(f"disk bound       : {meta['disk_bound']}")
    w(f"wall clock       : {meta['wall_s']:.1f}s")
    w()
    pre = meta.get("preflight")
    if pre:
        w("-" * 78)
        w("PREFLIGHT (1 real run of the real guest, before the sweep)")
        w("-" * 78)
        coords = (
            f"info_record {pre['info_record']}  sched_turn {pre['sched_turn']}  "
            f"virtual_ns {pre['virtual_ns']}"
            if pre["category"] == "diverged"
            else pre["why"]
        )
        w(f"  {pre['category'].upper()}: {coords}")
        for line in _wrap(
            "It ran SOLO before the sweep, so under --mode concurrent it belongs to a "
            "different population than the N nodes below and is NOT counted in any "
            "ratio there. It is reported because it is a real verdict, not because it "
            "is part of the distribution.",
            74,
        ):
            w(f"  {line}")
        w()
    w("-" * 78)
    w("OUTCOME CATEGORIES (every run is in exactly one; they sum to N)")
    w("-" * 78)
    if any(r.test_id for r in results):
        w(f"  diverged   {len(diverged):4d} / {n}   not applicable to a nextest sweep (no verify pair)")
        w(f"  clean      {len(clean):4d} / {n}   the named test PASSED")
        w(f"  failed     {len(failed):4d} / {n}   the named test FAILED -- the finding, not an error")
    else:
        w(f"  diverged   {len(diverged):4d} / {n}   the two executions parted; a point is reported below")
        w(f"  clean      {len(clean):4d} / {n}   verified deterministic -- a data point, not an absence")
        w(f"  failed     {len(failed):4d} / {n}   NO verdict (crash / deadline / cap kill); NOT counted as either")
    w(f"  no-result  {len(noresult):4d} / {n}   ran, but nothing comparable was selected")
    w(f"  not-run    {len(notrun):4d} / {n}   never launched -- the sweep was cut short")
    if notrun:
        w()
        w(f"  *** THE SWEEP IS TRUNCATED: {len(notrun)} of {n} nodes never started, so every")
        w(f"  ratio above is out of {n - len(notrun)} actual runs, NOT {n}. The scheduler")
        w("  stops launching new steps once a node fails. Read the failed nodes")
        w("  below, then re-run; --mode concurrent starts every node at once and")
        w("  so is not exposed to this.")
    # ⚠️ A NEXTEST SWEEP GETS A FAILURE RATE, NOT A DIVERGENCE RATE, AND NO
    # L-LEVEL AT ALL. The L2/L4 ladder is about a verify pair repeated with no
    # divergence; applied to a nextest sweep it is a claim about a property that
    # was never measured. Worse, the old line reported this run's two FAILED
    # nodes as "2 more produced no verdict" -- reasserting, three lines below the
    # per-id table, the exact confusion the table exists to prevent.
    if any(r.test_id for r in results):
        nx_failed = [r for r in results if r.category == "failed"]
        nx_measured = len(nx_failed) + len(clean)
        if nx_measured:
            w()
            deff = design_effect_for(meta["mode"], getattr(args, "design_effect", None))
            lo, hi = wilson95(len(nx_failed), nx_measured, deff)
            w(f"  failure rate     : {len(nx_failed)}/{nx_measured} = "
              f"{100*len(nx_failed)/nx_measured:.0f}% of the runs that produced a verdict")
            w(f"                     95% interval {100*lo:.0f}%-{100*hi:.0f}% (Wilson, "
              f"n={nx_measured}"
              f"{'' if deff == 1.0 else f', design effect {deff:g}'}).")
            w(f"                     POOLED ACROSS {len({r.test_id for r in results if r.test_id})} "
              f"ID(S) -- a pooled rate over several ids is not any one id's rate.")
            w(f"                     The per-id table above is the number to read.")
            unmeasured = [r for r in results if r.category in ("no_result", "not_run")]
            if unmeasured:
                w(f"                     {len(unmeasured)} node(s) produced no verdict and are "
                  f"EXCLUDED from this denominator.")
        w()
    measured = 0 if any(r.test_id for r in results) else len(diverged) + len(clean)
    if measured:
        w()
        deff = design_effect_for(meta["mode"], getattr(args, "design_effect", None))
        lo, hi = wilson95(len(diverged), measured, deff)
        w(f"  divergence rate: {len(diverged)}/{measured} = {100*len(diverged)/measured:.0f}% of the runs that "
          f"produced a verdict")
        # A BARE RATIO AT N=20 INVITES OVER-READING. Measured on sabre +
        # `sh -c 'seq 1 2000 | wc -l'` on 2026-08-24: 11/20 concurrent against
        # 7/20 sequential -- a 20-point gap whose intervals overlap heavily. Two
        # single sweeps cannot establish that difference, and the interval is
        # printed so nobody reports one from them.
        w(f"                   95% interval {100*lo:.0f}%-{100*hi:.0f}% (Wilson, n={measured}"
          f"{'' if deff == 1.0 else f', design effect {deff:g}'}). Two sweeps whose")
        w(f"                   intervals overlap have not shown a difference.")
        if deff != 1.0:
            # The uncorrected number is shown so the correction is auditable
            # rather than a figure the reader has to take on trust -- and so the
            # size of it is visible, which is the part that argues for itself.
            nlo, nhi = wilson95(len(diverged), measured, 1.0)
            w(f"                   BINOMIAL-ONLY interval would be "
              f"{100*nlo:.0f}%-{100*nhi:.0f}%, and is TOO NARROW here: runs in one")
            w(f"                   {meta['mode']} sweep share a contention episode, so they are not")
            w(f"                   independent. Measured dispersion {deff:g}x binomial over 20 replicate")
            w(f"                   sweeps; on that data the uncorrected interval called two sweeps of")
            w(f"                   the SAME arm different in 15 of 190 pairs (7.9%), the corrected one")
            w(f"                   in 0 of 190. See experiments/race-oracle-repeat-variance_20260824.")
            w(f"                   Override with --design-effect if you have measured your own.")
        # Say what this means in the project's own vocabulary rather than
        # leaving the reader to translate a ratio into an assurance claim.
        bitwise = all(
            "bitwise_parity=true" in (r.why or "") for r in clean
        ) if clean else False
        if diverged or failed or noresult or notrun:
            w(f"  assurance        : NOT L4. L4 is L2 repeated ~20x with NO divergence, and "
              f"{len(diverged)} of {measured} diverged"
              + (f" ({len(failed) + len(noresult) + len(notrun)} more produced no verdict)"
                 if (failed or noresult or notrun) else "")
              + ".")
        elif measured >= 20 and bitwise:
            w(f"  assurance        : L4 evidence -- {measured} L2 verify pairs, all "
              f"bitwise_parity=true, none diverged, mode={meta['mode']}.")
        else:
            w(f"  assurance        : L2 x{measured}, none diverged. L4 wants ~20; "
              f"this run has {measured}.")
    w()

    for line in per_id_lines(results):
        w(line)

    if any(r.test_id for r in results) and not diverged:
        w("  NO DIVERGENCE SECTION: these are nextest nodes, not hermit verify pairs,")
        w("  so there is no log pair to compare and no divergence coordinate exists.")
        w("  Omitted rather than printed empty -- an absent section and a section of")
        w("  dashes read very differently.")
        w()

    if diverged:
        w("-" * 78)
        w(f"FIRST DIVERGENCE POINTS ({len(diverged)} observations)")
        w("-" * 78)
        w(f"{'run':<8}{'info_record':>12}{'sched_turn':>12}{'virtual_ns':>22}  syscall")
        for r in diverged:
            sc = (
                f"dtid {r.syscall_dtid} #{r.syscall_ordinal}"
                + ("" if r.coord_verified else "  (?)")
                if r.syscall_ordinal is not None
                else (r.syscall_note or "-").split(":")[0]
            )
            w(
                f"{r.name:<8}{fmt(r.info_record,12)}{fmt(r.sched_turn,12)}"
                f"{fmt(r.virtual_ns,22)}  {sc}"
            )
        w()
        for label, vals in (
            ("info_record", [r.info_record for r in diverged if r.info_record is not None]),
            ("sched_turn", [r.sched_turn for r in diverged if r.sched_turn is not None]),
            ("virtual_ns", [r.virtual_ns for r in diverged if r.virtual_ns is not None]),
        ):
            missing = len(diverged) - len(vals)
            tail = f"   [{missing} of {len(diverged)} not reported]" if missing else ""
            w(f"  {label:<12} {stats(vals)}{tail}")
        for line in syscall_range_lines(diverged):
            w(line)
        unverified = [r.name for r in diverged if r.syscall_ordinal is not None and not r.coord_verified]
        if unverified:
            w(f"  (?) marks an UNVERIFIED coordinate ({len(unverified)} of {len(diverged)}): hermit")
            w("      published no scheduler turn for that divergence, so the record index")
            w("      this tool used to read the syscall number could not be cross-checked.")
        notes = {}
        for r in diverged:
            if r.syscall_ordinal is None and r.syscall_note:
                notes.setdefault(r.syscall_note, []).append(r.name)
        for r in diverged:
            if r.sched_turn is None and r.turn_note:
                notes.setdefault(r.turn_note, []).append(r.name)
        for note, names in notes.items():
            w(f"    for {len(names)} run(s) ({', '.join(names[:6])}{'...' if len(names) > 6 else ''}):")
            for line in _wrap(note, 66):
                w(f"      {line}")
        w()
        for label, vals in (
            ("info_record", [r.info_record for r in diverged if r.info_record is not None]),
            ("sched_turn", [r.sched_turn for r in diverged if r.sched_turn is not None]),
        ):
            h = histogram(vals)
            if h:
                w(f"  {label} histogram: " + "  ".join(f"{v}x{c}" for v, c in h))
        w()
        w("  UNIT KEYSPACES -- these integers are NOT on the same axis. Reading one")
        w("  against another is the misread this section exists to prevent.")
        for name, desc in UNIT_KEYSPACES:
            w(f"    {name}:")
            for line in _wrap(desc, 68):
                w(f"      {line}")
        w()
        w("  COORDINATE PROVENANCE -- grouped by cross-check outcome; each run's own")
        w("  wording is in result.json")
        prov: dict[tuple, list[str]] = {}
        for r in diverged:
            prov.setdefault((r.coord_source, _check_kind(r.coord_cross_check)), []).append(r.name)
        for (source, kind), names in prov.items():
            w(f"    {len(names)} run(s) [{kind}]: {source}")
            for line in _wrap(CHECK_KIND_MEANING.get(kind, "(no cross-check recorded)"), 66):
                w(f"      {line}")
        w()

    missing_units = []
    if any(r.info_record is None for r in diverged):
        missing_units.append(
            "info_record is missing on some runs: `hermit run --verify-json` does not "
            "carry first_divergent_record today (hermit#2386, which publishes it to "
            "the verify report, is NOT landed), so it is recovered by re-running "
            "`hermit log-diff --json` on the retained log pair -- which needs both "
            "logs to have been kept."
        )
    if any(
        r.syscall_ordinal is None and not (r.syscall_note or "").startswith("NONE_YET")
        for r in diverged
    ):
        missing_units.append(
            "syscall is missing on some runs for a reason other than 'none had "
            "completed yet': nothing in hermit publishes a syscall coordinate for a "
            "divergence, so this tool reads it out of the retained log at the located "
            "record, and WITHHOLDS it whenever the record-index cross-check fails. "
            "A NONE_YET row is a measured zero and is not in this category."
        )
    if missing_units:
        w("-" * 78)
        w("UNITS THAT ARE MISSING, AND WHY (unimplemented upstream, not absent from the data)")
        w("-" * 78)
        for m in missing_units:
            for line in _wrap(m, 76):
                w(f"  {line}")
            w()

    if failed or noresult or notrun:
        w("-" * 78)
        if any(r.test_id for r in results):
            w(nextest_outcome_heading(results))
            w("-" * 78)
            w("  A FAILED run here IS a measurement: the named test ran and failed, which")
            w("  is the finding this sweep exists to produce. It is counted in the per-id")
            w("  table above and it is NOT an error in the tool.")
            w("  A run that was NOT MEASURED is the opposite -- the id selected no test, or")
            w("  several -- and nothing here speaks to that id. The two are listed together")
            w("  only because both need their output read; they are counted separately")
            w("  everywhere else and must not be added together.")
        else:
            w(non_measurement_heading(results))
            w("-" * 78)
            w("  These are NOT clean and NOT diverged. Counting them either way would be")
            w("  a value that reads as information and carries none.")
        if notrun:
            w(f"  {len(notrun)} of them NEVER RAN: " + ", ".join(r.name for r in notrun))
        shown = failed + noresult
        for _l in bound_summary_lines(results, getattr(args, "deadline", None)):
            w(_l)
        _summarize_failures(shown, w)
        w("  FULL DETAIL for the first 3 (the rest are in result.json):")
        for r in shown[:3]:
            w(f"    {r.name}  [{r.category}]  {r.why}")
            _bn = bound_note(r, getattr(args, "deadline", None))
            if _bn:
                w(f"        {_bn}")
            for k in ("bound.wall", "bound.bytes", "truncated"):
                if k in r.safehermit_bounds:
                    w(f"        safehermit {k} = {r.safehermit_bounds[k]}")
            for line in r.error_tail:
                w(f"        | {line}")
        if len(shown) > 3:
            w(f"    ... and {len(shown) - 3} more: " + ", ".join(r.name for r in shown[3:]))
        w()

    w("-" * 78)
    w("PER-NODE RESOURCE FACTS (from the DAG runner's own step CSV)")
    w("-" * 78)
    if any(r.test_id for r in results):
        w("  A pass/fail rate collected under accidental oversubscription measures the")
        w("  harness. These are what each node ACTUALLY got.")
    else:
        w("  A divergence distribution collected under accidental oversubscription")
        w("  measures the harness. These are what each node ACTUALLY got.")
    w(f"  {'run':<8}{'inner_jobs':>11}{'eff_cores':>11}{'peak_MB':>10}{'elapsed_s':>11}{'oom':>5}{'co_tenants':>12}{'load1':>9}")
    for r in results:
        w(
            f"  {r.name:<8}{fmt(r.inner_jobs,11)}{fmt(r.effective_cores,11)}"
            f"{fmt(round(r.peak_bytes/1e6,1) if r.peak_bytes else None,10)}"
            f"{fmt(r.elapsed_s,11)}{fmt(r.oom_kills,5)}{fmt(r.co_tenants_start,12)}"
            f"{fmt(r.load1_start,9)}"
        )
    if all(r.inner_jobs is None for r in results):
        w("  (all NOT_MEASURED: the runner wrote no step CSV -- was --no-profile set?)")
    w()
    # GUEST-ONLY FROM HERE. Both the cwd confound and the concurrent/sequential
    # advice are about a hermit verify PAIR: the confound is a directory changing
    # between a pair's two executions, and the mode advice is about a divergence
    # distribution. A nextest sweep has neither. Printing them anyway told the
    # reader to re-run in the other mode "to get the contention-exposed
    # population" of a measurement that does not exist.
    if any(r.test_id for r in results):
        w("=" * 78)
        for line in verdict_lines(meta, results):
            w(line)
        w("=" * 78)
        return

    w("-" * 78)
    w("KNOWN CONFOUND, AND WHAT IS DONE ABOUT IT")
    w("-" * 78)
    for line in _wrap(
        "Hermit makes host files outside its private /tmp visible to the guest, and a "
        "verified cell runs with the launcher's cwd. So a directory entry appearing or "
        "vanishing between a node's two executions changes that directory's st_size and "
        "reads as a canonical-log divergence with both guest executions exiting zero. "
        "Measured independently on this box, SERIALLY: a validate diverged because "
        'newfstatat("/home/newton") returned 5788 then 5810 '
        "(ai_docs/validate-concurrency-characterization-20260824.md, findings F-3 and F-15).",
        76,
    ):
        w(f"  {line}")
    w()
    if meta["shared_cwd"]:
        w(f"  *** NOT APPLIED, BY REQUEST: --cwd {meta['shared_cwd']}")
        w("  Every node shares that directory. If anything writes there during the")
        w("  sweep -- including another node -- the divergence rate below is partly")
        w("  a property of this harness and the box, not of the cell.")
    else:
        w("  APPLIED: each node runs with cwd set to its own empty, quiescent")
        w("  <node>/cwd/ directory, created before the sweep and never written again.")
    w("  NOT APPLIED: the shared ancestors ($HOME, the checkout root, ignored/)")
    w("  are still visible to the guest and are still written by other agents on")
    w("  this box. A divergence whose first record is a newfstatat on one of")
    w("  those is this mechanism, not the cell. Check the retained logs with")
    w("  --keep-artifacts before believing a low-rate divergence.")
    w()
    other = "concurrent" if meta["mode"] == "sequential" else "sequential"
    w(f"THE OTHER MODE MEASURES SOMETHING ELSE. Re-run with --mode {other} to get")
    w(f"the {'contention-exposed' if other == 'concurrent' else 'quiet-box baseline'} population; do not merge the two histograms.")
    w()
    # THE LAST LINE IS A VERDICT, ALWAYS, AND IT MUST AGREE WITH THE BODY.
    # An owner ran -n 200 where all 200 failed on a missing backend. The
    # no-divergence-point section said so correctly, but the report ended on a
    # tip about run modes, so 200 runs were spent learning that a build lacked
    # SaBRe. A reader who reads only the last line must not be misled by it.
    w("=" * 78)
    for line in verdict_lines(meta, results):
        w(line)
    w("=" * 78)


def verdict_lines(meta: dict, results: list[RunResult]) -> list[str]:
    """The terminal verdict. Returned as lines so the report and the process's
    own final stderr line are generated from ONE place and cannot drift."""
    by = lambda c: [r for r in results if r.category == c]
    diverged, clean = by("diverged"), by("clean")
    n = len(results)

    # ⚠️ A NEXTEST SWEEP HAS DIFFERENT VOCABULARY AND THE GUEST WORDING IS WRONG
    # FOR IT. Here `failed` means THE NAMED TEST FAILED -- which is the finding
    # the sweep exists to produce -- not "no verdict". Measured on the first real
    # end-to-end run: two nodes of a deliberately-failing test were reported as
    # "2 of 4 produced NO verdict" and the process exited 0. Both statements were
    # false; the tests failed, and they failed on purpose.
    if any(r.test_id for r in results):
        ids = {r.test_id for r in results if r.test_id}
        failed_n = len(by("failed"))
        unresolved = sorted({r.test_id for r in results if r.test_id and r.category == "no_result"})
        notrun_n = len(by("not_run"))
        out = []
        if unresolved:
            out.append(f"VERDICT: {len(unresolved)} of {len(ids)} REQUESTED IDS WERE NEVER MEASURED "
                       f"(selected no test, or several).")
            out.append("This run does NOT speak to them. See the per-id table.")
            return out
        if notrun_n:
            out.append(f"VERDICT: TRUNCATED -- {notrun_n} of {n} nodes never launched.")
            out.append(f"Counts below are out of {n - notrun_n}, not {n}.")
            return out
        if failed_n:
            out.append(f"VERDICT: {failed_n} of {n} runs FAILED across {len(ids)} id(s); "
                       f"{len(clean)} passed. See the per-id table for which.")
        else:
            out.append(f"VERDICT: all {n} runs passed across {len(ids)} id(s), mode={meta['mode']}.")
        return out

    nores = by("failed") + by("no_result") + by("not_run")
    measured = len(diverged) + len(clean)
    if measured == 0:
        cause = homogeneous_failure_cause(nores)
        head = f"VERDICT: ALL {n} RUNS FAILED. NO DISTRIBUTION WAS MEASURED."
        if cause and looks_like_config_error(cause):
            return [
                head,
                "This is a CONFIGURATION ERROR, not data: every run failed the same",
                "way, so there is nothing here about the cell. The single cause was:",
                f"    {cause[:200]}",
                "Fix that and re-run. Nothing below or above this line is a measurement.",
            ]
        if cause:
            return [
                head,
                f"Every run failed identically, so this is ONE failure observed {n} times,",
                "not a distribution. The single cause was:",
                f"    {cause[:200]}",
            ]
        return [
            head,
            f"{len(nores)} runs produced no verdict, with more than one distinct cause;",
            "see the no-divergence-point section above. This is not a distribution.",
        ]
    lines = []
    if nores:
        lines.append(
            f"VERDICT: {len(diverged)} diverged, {len(clean)} clean, and {len(nores)} of {n} produced NO"
        )
        lines.append(
            f"verdict -- every rate above is out of {measured}, not {n}. Read the failures."
        )
    elif diverged:
        lines.append(
            f"VERDICT: {len(diverged)} of {n} runs DIVERGED ({100*len(diverged)//n}%), {len(clean)} clean. Not L4."
        )
    else:
        lines.append(f"VERDICT: all {n} runs clean, none diverged, mode={meta['mode']}.")
    return lines


def nextest_outcome_heading(results: list[RunResult]) -> str:
    """Heading for the failure-detail section of a NEXTEST sweep.

    ⚠️ THE GUEST HEADING IS NOT MERELY THE WRONG WORDS HERE, IT ASSERTS THE WRONG
    MODEL. "RUNS THAT PRODUCED NO DIVERGENCE POINT" groups a failing nextest node
    with the runs that produced nothing -- but a nextest node that FAILED
    produced a verdict, and that verdict is the entire finding the sweep exists
    for. A reader who meets guest vocabulary in a nextest report will reason
    about guests: they will look for a divergence coordinate that cannot exist,
    and conclude the tool lost it.
    This project has already paid for a change that preserved behaviour and
    dropped rationale -- a later reader filed a defect that was not one, and the
    prescribed fix would have broken verification. Wording that implies the wrong
    model is how that starts.
    """
    failed = [r for r in results if r.category == "failed"]
    unresolved = [r for r in results if r.category == "no_result"]
    notrun = [r for r in results if r.category == "not_run"]
    parts = []
    if failed:
        parts.append(f"{len(failed)} FAILED")
    if unresolved:
        parts.append(f"{len(unresolved)} NOT MEASURED")
    if notrun:
        parts.append(f"{len(notrun)} NEVER LAUNCHED")
    return "RUN DETAIL -- " + ", ".join(parts)


def non_measurement_heading(results: list[RunResult]) -> str:
    """Name failed/non-result runs without presenting total failure as clean.

    The generic "no divergence point" wording is accurate for a mixed sweep,
    but dangerously incomplete when every run failed: in that case no
    distribution was measured at all. Keep the two states visibly distinct.
    """
    failed = [r for r in results if r.category == "failed"]
    noresult = [r for r in results if r.category == "no_result"]
    notrun = [r for r in results if r.category == "not_run"]
    count = len(failed) + len(noresult) + len(notrun)
    measured = sum(r.category in ("diverged", "clean") for r in results)
    if results and measured == 0:
        if len(failed) == len(results):
            return (
                f"ALL {len(results)} RUNS FAILED; "
                "NO DIVERGENCE DISTRIBUTION WAS MEASURED"
            )
        return (
            f"NO RUN PRODUCED A VERDICT ({len(results)} RUNS); "
            "NO DIVERGENCE DISTRIBUTION WAS MEASURED"
        )
    return f"RUNS THAT PRODUCED NO DIVERGENCE POINT ({count})"


CHECK_KIND_MEANING = {
    "VERIFIED": (
        "reading run 1's log at the reported record index independently "
        "reproduces the scheduler turn and virtual time hermit itself reported, "
        "so the index -- and the syscall coordinate read from it -- is right."
    ),
    "UNVERIFIED": (
        "hermit published no scheduler turn for this divergence, so there is "
        "nothing to check the record index against. The record at that index IS "
        "an INFO record, which is necessary but not sufficient. Treat the "
        "syscall coordinate as indicative, not established."
    ),
    "FAILED": (
        "the record index does not mean what this tool assumed, so the syscall "
        "coordinate was withheld rather than reported wrong."
    ),
    "UNAVAILABLE": (
        "the record index could not be obtained at all (no retained log pair, or "
        "log-diff produced none), so only the coordinates hermit published are "
        "reported."
    ),
    "NONE": "no cross-check was recorded for these runs.",
}


def _check_kind(check: str | None) -> str:
    """Which outcome a cross-check line reports. Grouping on the leading keyword
    keeps identical outcomes as one entry without mangling the numbers inside the
    sentence, which an earlier digit-substituting version did."""
    if not check:
        return "NONE"
    head = check.split(":", 1)[0].strip()
    return head if head in CHECK_KIND_MEANING else "NONE"


def best_cause_line(r: "RunResult") -> str:
    """The most informative line of a failed run's output.

    NOT simply the last line. hermit prints its diagnosis on an `Error:` line and
    then a wrapped `     > errno` continuation, so taking the tail yields
    "> No such file or directory (os error 2)" -- true, and useless without the
    line above it that names the program."""
    for line in reversed(r.error_tail):
        stripped = line.strip()
        if stripped.startswith(("Error:", "error:", "hermit:")) and len(stripped) > 12:
            return stripped
    for line in reversed(r.error_tail):
        stripped = line.strip()
        if stripped and not stripped.startswith(">"):
            return stripped
    return r.why


def homogeneous_failure_cause(runs: list[RunResult]) -> str | None:
    """The single cause when EVERY non-measuring run failed the same way.

    N identical failures are one configuration error observed N times, not a
    distribution of anything. Reported as a cause, not as data."""
    if not runs:
        return None
    causes = {best_cause_line(r) for r in runs}
    return causes.pop() if len(causes) == 1 else None


CONFIG_ERROR_MARKERS = (
    # backend not compiled in / prerequisites unmet
    #   hermit-cli/src/lib.rs: "backend `sabre` is unavailable: SaBRe support was
    #   not included in this build"
    "is unavailable:",
    "was not included in this build",
    # guest not reachable
    "is not visible through the configured guest mounts",
    "does not exist or is not accessible",
    "is under host /tmp",
    "No such file or directory",
    "command not found",
    "Permission denied",
    # harness could not produce the guest at all
    "prebuilt fixture is missing",
    "compiled guest is missing or not executable",
)


def looks_like_config_error(cause: str | None) -> bool:
    """Whether a cause is the environment being wrong rather than the cell being
    flaky. Deliberately a small, literal list: guessing wider would relabel real
    product failures as the user's fault."""
    return bool(cause) and any(m in cause for m in CONFIG_ERROR_MARKERS)


def _summarize_failures(runs: list[RunResult], w):
    """Group identical failure tails. With 20 nodes, 20 copies of one message is
    one finding, and printing it 20 times hides that."""
    groups: dict[str, list[str]] = {}
    for r in runs:
        key = best_cause_line(r)
        groups.setdefault(key, []).append(r.name)
    w("  GROUPED BY LAST LINE:")
    for key, names in sorted(groups.items(), key=lambda kv: -len(kv[1])):
        w(f"    {len(names)}x  {key[:140]}")
        w(f"          runs: {', '.join(names)}")
    w()


def _wrap(text: str, width: int) -> list[str]:
    words, lines, cur = text.split(), [], ""
    for word in words:
        if cur and len(cur) + 1 + len(word) > width:
            lines.append(cur)
            cur = word
        else:
            cur = f"{cur} {word}".strip()
    if cur:
        lines.append(cur)
    return lines


# --------------------------------------------------------------------------- main
def main() -> int:
    p = argparse.ArgumentParser(
        prog=PROG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=__doc__,
        epilog=(
            "examples\n"
            "  bin/hermit-repeat -n 20 -- /bin/echo hello\n"
            "  bin/hermit-repeat -n 20 --mode concurrent -- ./target/debug/mythread\n"
            "  bin/hermit-repeat -n 20 --mode concurrent --backend liteinst -- /bin/echo hi\n"
            "  bin/hermit-repeat -n 8 --hermit-arg=--no-detlog-io-buffers -- ./guest\n"
            "\n"
            "NOTE: --hermit-arg and --global-arg need the =VALUE form when the value\n"
            "starts with '-', e.g. --hermit-arg=--no-detlog-io-buffers. Repeat the flag\n"
            "for each extra argument.\n"
        ),
    )
    p.add_argument("-n", "--runs", type=int, default=20, help="how many times to run the guest (default 20)")
    p.add_argument(
        "--mode",
        choices=("sequential", "concurrent"),
        default="sequential",
        help=(
            "sequential (default): one node at a time, the quiet-box baseline. "
            "concurrent: all N at once, which measures the cell PLUS contention. "
            "These are different populations and are labelled as such."
        ),
    )
    p.add_argument("--backend", help="hermit --backend (ptrace|dbt|liteinst|sabre|kvm|e9patch)")
    p.add_argument(
        "--cell",
        metavar="ID",
        help="stress a MANIFEST CELL by id (e.g. c-programs/add-key-enosys) instead of "
             "a guest command line. Resolves the id through scripts/manifest-to-commands.rs "
             "-- the same expansion the e2e buckets run -- builds the cell's guest, and "
             "feeds it to the ordinary sweep. GREEN cells are the point: a cell that "
             "passes today and is flaky underneath is invisible to a single run. Every "
             "completed run is appended to the parent per-test series.",
    )
    p.add_argument(
        "--test-id",
        metavar="ID",
        action="append",
        default=[],
        help="stress a NEXTEST test by id in nextest's own BINARY$TEST form (e.g. "
             "'hermit::cli$run_dbt_verifies_self_prlimit' -- quote it, $ is shell-special), "
             "repeatable. Each id is run N times as its own set of boxed nodes and gets its "
             "own pass/fail count. This is a DIFFERENT measurement from --cell: a nextest "
             "test is not a hermit verify pair, so it yields NO divergence coordinates and "
             "that section is omitted rather than left blank.",
    )
    p.add_argument(
        "--test-workspace",
        metavar="DIR",
        help="cargo workspace to run --test-id in (default: the hermit checkout). "
             "Exists so the nextest path can be exercised against a small throwaway "
             "crate without building the whole hermit workspace -- an untestable code "
             "path is one nobody has watched fail.",
    )
    p.add_argument(
        "--cell-backend",
        metavar="B",
        help="which enabled backend of --cell to stress; default is the cell's first",
    )
    p.add_argument("--hermit-arg", action="append", default=[], help="extra arg for `hermit run`, repeatable; use the =VALUE form when it starts with '-' (--hermit-arg=--no-detlog-io-buffers)")
    p.add_argument("--global-arg", action="append", default=[], help="extra hermit GLOBAL arg (before the subcommand), repeatable; same =VALUE rule")
    p.add_argument("-j", "--jobs", type=int, help="concurrency in concurrent mode (default: N)")
    p.add_argument("--deadline", type=int, default=900, help="per-node wall deadline in seconds, enforced by safehermit's cgroup (default 900)")
    p.add_argument("--sh-bin", help="hermit binary to run (else HERMIT_BIN, else target/release/hermit)")
    p.add_argument("--out", help="artefact directory (default ignored/hermit-repeat/<run-id>)")
    p.add_argument("--json", help="also write the whole result as JSON here")
    p.add_argument("--keep-artifacts", action="store_true", help="keep the retained verify log pairs (large); by default they are deleted once their coordinates are extracted")
    p.add_argument("--max-total-mb", type=int, default=4096, help="abort the run if artefacts exceed this many MB (default 4096)")
    p.add_argument("--node-rss-bytes", type=int, default=2 * 1024**3, help="planner hint: expected RSS per node (default 2 GiB)")
    p.add_argument("--node-mem-max-bytes", type=int, default=8 * 1024**3, help="hard cgroup memory cap per node (default 8 GiB)")
    p.add_argument(
        "--cwd",
        help=(
            "run EVERY node with this SHARED working directory instead of each node's "
            "own private empty one. This is a measurement knob for studying the cwd "
            "as a nondeterminism source, not a normal option: on btrfs a directory's "
            "st_size changes on every entry added or removed, so a shared, live "
            "directory makes the divergence rate a property of whatever else is "
            "writing there. Named in the report when set."
        ),
    )
    p.add_argument(
        "--design-effect",
        type=float,
        default=None,
        metavar="D",
        help=(
            "override the design effect used to widen the reported interval. "
            f"Default: {CONCURRENT_DESIGN_EFFECT:g} in concurrent mode and "
            f"{SEQUENTIAL_DESIGN_EFFECT:g} in sequential, both MEASURED over 20 "
            "replicate sweeps (experiments/race-oracle-repeat-variance_20260824). "
            "Runs inside one concurrent sweep share a contention episode and are "
            "not independent, so the binomial interval is too narrow there. Pass 1 "
            "for the uncorrected binomial interval, or your own measured value; a "
            "single sweep CANNOT estimate this, it needs replicate sweeps"
        ),
    )
    p.add_argument("--no-preflight", action="store_true", help="skip the single probe run that checks this configuration can produce a verdict at all; use when a genuinely flaky cell fails the probe")
    p.add_argument("--dry-run", action="store_true", help="print the generated DAG and the exact per-node command, run nothing")
    p.add_argument("-v", "--verbose", action="store_true", help="echo the runner's whole stream; it is written to <out>/runner.log either way")
    p.add_argument("--selftest", action="store_true", help="check the log-coordinate parsing against built-in fixtures and exit")
    p.add_argument("guest", nargs=argparse.REMAINDER, help="-- GUEST [ARGS...]")

    args = p.parse_args()
    if args.selftest:
        return _selftest()
    guest = args.guest
    if guest and guest[0] == "--":
        guest = guest[1:]
    if args.cell:
        if guest:
            die("--cell and an explicit guest command are mutually exclusive; the cell "
                "supplies the guest.")
        guest, cell_backend, cell_flags = resolve_cell(args.cell, args.cell_backend)
        if args.backend and args.backend != cell_backend:
            die(f"--backend {args.backend} contradicts the cell's backend {cell_backend}; "
                f"use --cell-backend to choose among the cell's enabled backends.")
        args.backend = cell_backend
        # The cell's own hermit flags (--base-env=minimal, --strict, ...) are part of
        # what the cell IS. Dropping them would stress a different configuration than
        # the one the bucket runs, and the sweep would answer about something else.
        args.hermit_arg = list(cell_flags) + list(args.hermit_arg or [])
    if args.test_id:
        # These are different measurements and combining them in one sweep would
        # put two populations under one set of headline ratios.
        if guest or args.cell:
            die("--test-id runs NEXTEST tests and cannot be combined with --cell or a "
                "guest command line; they are different measurements. Run them separately.")
        if args.backend or args.cell_backend:
            die("--backend/--cell-backend do not apply to --test-id: a nextest test is "
                "not a hermit run and chooses its own backend, if any.")
    if not guest and not args.test_id:
        die("no guest command given. Usage: hermit-repeat [options] -- GUEST [ARGS...]\n"
            "       or: hermit-repeat [options] --cell <manifest-id>\n"
            "       or: hermit-repeat [options] --test-id <nextest-id> [--test-id ...]")
    if args.runs < 1:
        die(f"--runs must be >= 1 (got {args.runs})")

    # BOTH NAMES. agent-utils renamed the DAG runner (rs/safe-ci-dag-runner ->
    # rs/dagrun, executable -> dagrun, profile store .safe-ci-dag-runner/profiles
    # -> .dagrun/profiles) and hermit main already pins the renamed agent-utils,
    # so this checkout will flip under us. Resolve whichever is present and NAME
    # the one that won, rather than hardcoding a name that is on its way out.
    candidates = [
        ROOT / "agent-utils/common/bin/dagrun",
        ROOT / "agent-utils/common/bin/safe-ci-dag-runner",
    ]
    runner = next((c for c in candidates if c.exists()), None)
    if runner is None:
        die(
            "no DAG runner found. Looked for, in order:\n  "
            + "\n  ".join(str(c) for c in candidates)
            + "\nIs the agent-utils submodule checked out?"
        )
    if not (ROOT / "bin/safehermit").exists():
        die(f"bin/safehermit not found at {ROOT / 'bin/safehermit'}")

    hermit_bin, hermit_source = resolve_hermit(args.sh_bin)
    args.sh_bin_resolved = hermit_bin
    if not os.access(hermit_bin, os.X_OK):
        die(f"not executable: {hermit_bin}")
    if args.cell:
        try:
            checkout_sha = git_value(ROOT / "hermit", "rev-parse", "HEAD")
            binary_revision, _ = hermit_binary_revision(hermit_bin)
            require_matching_binary(checkout_sha, binary_revision, hermit_bin)
        except RuntimeError as exc:
            die(f"cannot prepare the per-test series writer: {exc}")

    run_id = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + f"-{os.getpid()}"
    out = Path(args.out) if args.out else ROOT / "ignored" / "hermit-repeat" / run_id
    out.mkdir(parents=True, exist_ok=True)
    perf_dir = out / "profiles"
    perf_dir.mkdir(exist_ok=True)

    dag = (build_nextest_dag(args, out, args.test_id) if args.test_id
           else build_dag(args, hermit_bin, out, guest))
    dag_path = out / "dag.json"
    dag_path.write_text(json.dumps(dag, indent=2))

    # ⚠️ BUDGET FROM THE NODE COUNT, NOT FROM --runs. With M ids these differ by
    # a factor of M, and the earlier version of this used --runs: a 3-id sweep at
    # -j 1 got a third of the wall budget it needed, so the runner would have cut
    # it off two thirds of the way through and every unreached node would have
    # been reported `not_run`. A truncated sweep that LOOKS like a completed one
    # is the failure this whole tool exists to avoid.
    node_count = len(dag["steps"])
    jobs = 1 if args.mode == "sequential" else (args.jobs or node_count)
    waves = (node_count + jobs - 1) // jobs
    run_timeout = args.deadline * waves + 300

    if args.dry_run:
        print(f"{PROG}: DAG written to {dag_path} ({node_count} disconnected nodes"
              + (f", {len(args.test_id)} ids x {args.runs} runs" if args.test_id else "")
              + ")")
        print(f"{PROG}: mode={args.mode} -j {jobs} run-timeout {run_timeout}s")
        print(f"{PROG}: node 1 command:\n  {dag['steps'][0]['cmd']}")
        print(f"{PROG}: runner command:\n  {runner} run --dag {dag_path} -j {jobs} "
              f"--keep-going --run-timeout {run_timeout} --perf-dir {perf_dir}")
        return 0

    preflight_result: RunResult | None = None
    # ---------------------------------------------------------------- preflight
    # ONE RUN BEFORE N. An owner spent 200 runs discovering that the build had no
    # SaBRe backend. Every one of those failures was identical and none of them
    # was a measurement. A single real run of the real guest with the real flags
    # answers "can this configuration produce a verdict at all" in the time one
    # node takes, and refuses in seconds instead of after the whole sweep.
    if not args.no_preflight:
        pre_args = argparse.Namespace(**vars(args))
        pre_args.runs = 1
        pre_dir = out / "preflight"
        pre_dir.mkdir(parents=True, exist_ok=True)
        # ⚠️ PREFLIGHT EVERY ID, NOT JUST THE FIRST. One bad id anywhere in the
        # list is the failure mode this guards against, and probing only
        # args.test_id[0] would let a typo in id 9 of 12 sail through preflight
        # and surface after the full M x N sweep. M extra single-run nodes is a
        # trivial price for that: for 12 ids at n=20 it is 12 nodes against 240.
        pre_dag = (build_nextest_dag(pre_args, pre_dir, args.test_id) if args.test_id
                   else build_dag(pre_args, hermit_bin, pre_dir, guest))
        pre_dag_path = pre_dir / "dag.json"
        pre_dag_path.write_text(json.dumps(pre_dag, indent=2))
        say(f"{PROG}: preflight -- " + (
            f"one run of each of the {len(args.test_id)} id(s) before all {args.runs} each"
            if args.test_id else
            f"one run of the real guest before all {args.runs}"))
        subprocess.run(
            [str(runner), "run", "--dag", str(pre_dag_path), "-j", "1", "--keep-going",
             "--run-timeout", str(args.deadline + 120), "--no-profile"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
        )
        if args.test_id:
            probes = []
            for st in pre_dag["steps"]:
                pr = RunResult(index=1, name=st["job"], dir=str(pre_dir / "runs" / st["job"]))
                collect_one_nextest(pr)
                probes.append(pr)
            # Report the WORST outcome: an unmeasurable id must not be masked by
            # its neighbours passing.
            bad = [pr for pr in probes if pr.category == "no_result"] or \
                  [pr for pr in probes if pr.category == "not_run"]
            probe = bad[0] if bad else probes[0]
            if bad:
                say("")
                say(f"{PROG}: preflight found {len(bad)} of {len(probes)} id(s) UNMEASURABLE:")
                for pr in bad:
                    say(f"{PROG}:   {pr.test_id}")
        else:
            probe = RunResult(index=1, name="run1", dir=str(pre_dir / "runs" / "run1"))
            collect_one(probe, hermit_bin, keep=False)
        # A FAILING TEST IS A MEASUREMENT, NOT A CONFIGURATION ERROR. For a
        # nextest sweep the whole question is whether a named id fails, so
        # `failed` must pass preflight; only "no verdict at all" may refuse.
        ok = ("diverged", "clean", "failed") if args.test_id else ("diverged", "clean")
        if probe.category not in ok:
            say("")
            say(f"{PROG}: REFUSED -- the preflight run produced no verdict, so all "
                f"{args.runs} runs would fail the same way.")
            say(f"{PROG}:   category : {probe.category}")
            say(f"{PROG}:   why      : {probe.why}")
            for line in probe.error_tail:
                say(f"{PROG}:   | {line}")
            cause = best_cause_line(probe)
            if looks_like_config_error(cause):
                say(f"{PROG}: This reads as a CONFIGURATION ERROR (backend, binary or "
                    f"guest), not a flaky cell. Fix it and re-run.")
            say(f"{PROG}: If you believe this is a flake rather than a configuration "
                f"error, re-run with --no-preflight.")
            say(f"{PROG}: artefacts: {pre_dir}")
            return 2
        say(f"{PROG}: preflight OK ({probe.category}) -- running all {args.runs}")
        # KEEP IT. The probe is a real verify pair on the real guest, so its
        # verdict is a data point and throwing it away wastes evidence. It is
        # NOT merged into the distribution: it ran SOLO, before the sweep, so
        # under --mode concurrent it belongs to a different population than the
        # N nodes it precedes -- which is the exact conflation this tool refuses
        # to make elsewhere. Reported on its own line instead.
        preflight_result = probe

    cmd = [
        str(runner), "run",
        "--dag", str(dag_path),
        "-j", str(jobs),
        "--keep-going",
        "--run-timeout", str(run_timeout),
        "--perf-dir", str(perf_dir),
    ]
    say(f"{PROG}: {node_count} nodes, mode={args.mode}, -j {jobs}, artefacts in {out}")
    say(f"{PROG}: {' '.join(shlex.quote(c) for c in cmd)}")

    proc_holder = {}

    def kill_run():
        proc = proc_holder.get("p")
        if proc and proc.poll() is None:
            proc.terminate()

    guard = DiskGuard(out, args.max_total_mb * 1024 * 1024, kill_run)
    guard.start()
    started = time.time()
    runner_log = out / "runner.log"
    # EVERY line is kept; only the ECHO is filtered. 20 nodes x hermit's own
    # per-run chatter buries the report, but a wrapper that quietly discards its
    # child's output is how a failure goes unnoticed, so the full stream always
    # lands in runner.log and -v echoes all of it.
    with open(runner_log, "w") as lf:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        proc_holder["p"] = proc
        for line in proc.stdout:
            lf.write(line)
            if args.verbose or line.startswith((runner.name, "safe-ci-dag-runner", "dagrun")) or " FAIL " in line:
                sys.stderr.write(line)
        runner_rc = proc.wait()
    wall = time.time() - started
    guard.stop_evt.set()
    guard.join(timeout=10)

    width = len(str(args.runs))
    if args.test_id:
        # Names come from the DAG so the two never drift apart; deriving them a
        # second time here is how a renamed node becomes a phantom not_run.
        results = [
            RunResult(index=i, name=st["job"], dir=str(out / "runs" / st["job"]))
            for i, st in enumerate(dag["steps"], 1)
        ]
        for r in results:
            collect_one_nextest(r)
    else:
        results = [
            RunResult(index=i, name=f"run{i:0{width}d}", dir=str(out / "runs" / f"run{i:0{width}d}"))
            for i in range(1, args.runs + 1)
        ]
        for r in results:
            collect_one(r, hermit_bin, args.keep_artifacts)
    join_step_csv(results, perf_dir)

    peak = measured_peak_overlap(results)
    disk_bound = (
        f"APPLIED: {args.max_total_mb} MB total artefact cap, polled every 2s "
        f"(peak observed {guard.peak/1e6:.1f} MB)"
        + ("  *** CAP FIRED: the run was cut short ***" if guard.breached else "")
    )
    disk_bound += (
        "\n                   NOTE: safehermit's 64 MiB cap covers hermit's STDERR only; "
        "under --verify hermit's log goes to files that cap never sees, which is why "
        "this separate cap exists."
    )
    mode_meaning = (
        f"{args.runs} disconnected DAG nodes run ONE AT A TIME; measures the cell with "
        "the box as quiet as it gets"
        if args.mode == "sequential"
        else f"{args.runs} disconnected DAG nodes run AT ONCE; measures the cell PLUS "
        "host contention, which is itself a flake source"
    )

    meta = {
        "run_id": run_id,
        "guest_cmdline": " ".join(shlex.quote(g) for g in guest),
        "hermit_bin": hermit_bin,
        "hermit_sha256": sha256_of(hermit_bin),
        "hermit_source": hermit_source,
        "backend": args.backend or "ptrace (hermit default; not passed explicitly)",
        "hermit_flags": " ".join(
            ["run", "--verify", "--verify-strict", "--keep-logs"] + args.hermit_arg
        ),
        "mode": args.mode,
        "test_workspace": (os.path.abspath(args.test_workspace) if args.test_workspace else str(ROOT / "hermit")),
        "mode_meaning": mode_meaning,
        "runner": f"{runner.name} (cgroup-boxed, two-level) at {runner}",
        "jobs": jobs,
        "peak_overlap": peak if peak is not None else "NOT_MEASURED (no start/end stamps)",
        "boxing": "bin/safehermit per node; its APPLIED/NOT_APPLIED report is at "
        "<node>/safehermit.txt",
        "runner_verdict_meaning": (
            "the runner's PASS/FAIL answers 'did every node produce a MEASUREMENT', "
            "not 'did the cell pass'. A diverging node exits 0 to it on purpose."
        ),
        "disk_bound": disk_bound,
        "wall_s": wall,
        "shared_cwd": os.path.abspath(args.cwd) if args.cwd else None,
        "preflight": (
            None
            if preflight_result is None
            else {
                "category": preflight_result.category,
                "why": preflight_result.why,
                "info_record": preflight_result.info_record,
                "sched_turn": preflight_result.sched_turn,
                "virtual_ns": preflight_result.virtual_ns,
                "syscall_ordinal": preflight_result.syscall_ordinal,
                "syscall_dtid": preflight_result.syscall_dtid,
                "ran": "SOLO, before the sweep -- a different population from the "
                       "N nodes, so deliberately NOT merged into the distribution",
            }
        ),
        "out_dir": str(out),
        "runner_exit": runner_rc,
        "runner_exit_label": {0: "PASS (exit 0)", 1: "a node failed (exit 1)",
                              2: "bad usage / bad DAG (exit 2)",
                              3: "cgroup boxing unavailable (exit 3)"}.get(
            runner_rc, f"exit {runner_rc}"),
        "runner_log": str(runner_log),
    }

    report_path = out / "report.txt"
    with open(report_path, "w") as fh:
        write_report(args, meta, results, fh)
    sys.stdout.write(report_path.read_text())

    # The interval goes in the JSON too. A machine consumer that recomputed it
    # from k and n would get the binomial one and lose the correction silently,
    # which is the same defect in a different place.
    _div = sum(1 for r in results if r.category == "diverged")
    _measured = _div + sum(1 for r in results if r.category == "clean")
    _deff = design_effect_for(meta["mode"], args.design_effect)
    _lo, _hi = wilson95(_div, _measured, _deff)
    _nlo, _nhi = wilson95(_div, _measured, 1.0)
    meta["design_effect"] = _deff
    meta["design_effect_source"] = (
        "explicit --design-effect" if args.design_effect is not None
        else f"measured default for mode={meta['mode']} "
             "(experiments/race-oracle-repeat-variance_20260824)"
    )
    meta["divergence_rate"] = {
        "diverged": _div,
        "measured": _measured,
        "rate": (_div / _measured) if _measured else None,
        "wilson95": [_lo, _hi] if _measured else None,
        "wilson95_binomial_only": [_nlo, _nhi] if _measured else None,
        "note": (
            "wilson95 carries the design effect; wilson95_binomial_only assumes "
            "independence, which concurrent mode does not have"
        ),
    }
    payload = {"meta": meta, "runs": [asdict(r) for r in results],
               "verdict": verdict_lines(meta, results)}
    (out / "result.json").write_text(json.dumps(payload, indent=2))
    if args.json:
        Path(args.json).write_text(json.dumps(payload, indent=2))

    series_message = None
    series_error = None
    try:
        series_message = append_cell_series(args, run_id, results)
    except RuntimeError as exc:
        series_error = str(exc)

    diverged = [r for r in results if r.category == "diverged"]
    clean = [r for r in results if r.category == "clean"]
    # The LAST thing on stderr is the verdict, from the same generator the report
    # ends with, so the two can never disagree. The artefact path goes above it.
    say(f"{PROG}: report {report_path}")
    if series_message:
        say(f"{PROG}: {series_message}")
    if series_error:
        say(f"{PROG}: SERIES WRITE FAILED -- {series_error}")
    for line in verdict_lines(meta, results):
        say(f"{PROG}: {line}")
    if series_error:
        return 2
    # ⚠️ A SELECTION THAT MATCHED NOTHING MUST NOT EXIT 0. With --test-id the
    # categories mean something different from the guest path: `failed` is the
    # FINDING (the named test failed) and `no_result` means the id was never
    # examined -- it selected no test, or several. The old rule returned 0 as
    # soon as ANY node was clean, so a sweep where id A passed 20/20 and id B
    # selected nothing 20/20 exited 0 and read as a completed measurement of
    # both. That is a check reporting success for having examined nothing, and
    # it is the defect this project keeps finding.
    unresolved = sorted({r.test_id for r in results
                         if r.test_id and r.category == "no_result"})
    if unresolved:
        say("")
        say(f"{PROG}: FAILED -- {len(unresolved)} of "
            f"{len({r.test_id for r in results if r.test_id})} requested id(s) produced NO "
            f"USABLE VERDICT. They were NOT measured; this run does not speak to them.")
        for tid in unresolved:
            why = next((r.why for r in results
                        if r.test_id == tid and r.category == "no_result"), "")
            say(f"{PROG}:   {tid}")
            say(f"{PROG}:     {why}")
        return 3
    if not diverged and not clean and not any(r.test_id for r in results):
        return 3
    if args.test_id:
        # 0 only when every requested id passed every run. A failing named test
        # is the finding and exits 1, the same code a divergence uses on the
        # guest path: "something was observed", not "the tool broke".
        if [r for r in results if r.category == "failed"]:
            return 1
        if not clean:
            return 3
        return 0
    return 1 if diverged else 0


def _selftest() -> int:
    """Check the log-parsing coordinates against fixtures built here, so a
    regression in the record indexing is caught without needing a hermit run."""
    log = (
        "Aug 24 19:00:00.100  INFO detcore: COMMIT turn 7, dettid 3 using resources {}, "
        "on previously committed 1_640_995_199.000_500_000s\n"
        "Aug 24 19:00:00.200  INFO detcore: DETLOG [syscall][detcore, dtid 3] "
        "finish syscall #4: openat(-100, \"/x\") = Ok(3)\n"
        "Aug 24 19:00:00.300  INFO detcore: DETLOG [syscall][detcore, dtid 3] "
        "inbound syscall: read(3) = ?\n"
        "  a continuation line of the record above\n"
        "Aug 24 19:00:00.400  INFO detcore: COMMIT turn 8, dettid 5 using resources {}, "
        "on previously committed 1_640_995_199.000_900_000s\n"
        "Aug 24 19:00:00.500  INFO detcore: DETLOG [syscall][detcore, dtid 5]  "
        "finish syscall #1: write(1) = Ok(2)\n"
    )
    pieces = records_by_comparator_index(log)
    failures = []

    def check(label, got, want):
        if got != want:
            failures.append(f"{label}: got {got!r}, want {want!r}")

    check("build revision parser",
          BUILD_REVISION.search("hermit 0.2.0 (2026-08-27, gabcdef123456)").groups(),
          ("abcdef123456", None))
    check("dirty build revision parser",
          BUILD_REVISION.search("hermit 0.2.0 (2026-08-27, gabcdef123456-dirty)").groups(),
          ("abcdef123456", "-dirty"))
    try:
        require_matching_binary("abcdef123456" + "0" * 28, "abcdef123456", "/fixture/hermit")
    except RuntimeError as exc:
        failures.append(f"matching binary revision: rejected with {exc}")
    try:
        require_matching_binary("abcdef123456" + "0" * 28, "000000000000", "/fixture/hermit")
        failures.append("mismatched binary revision: accepted")
    except RuntimeError as exc:
        check("mismatched binary names both revisions",
              "abcdef123456" in str(exc) and "000000000000" in str(exc), True)

    # --- parent series rows --------------------------------------------
    # A run that never produced a comparison remains a non-verdict, and a
    # missing elapsed time remains absent rather than becoming zero.
    series_fixture = [
        RunResult(
            index=1,
            name="run01",
            dir="/fixture/run01",
            category="diverged",
            info_record=98,
            sched_turn=4,
            virtual_ns=1_640_995_199_000_000_000,
            syscall_ordinal=37,
            elapsed_s=4.016,
        ),
        RunResult(
            index=2,
            name="run02",
            dir="/fixture/run02",
            category="no_result",
        ),
    ]
    series_rows = series_cell_rows(
        cell="applications/git-repository-workflow",
        backend="ptrace",
        run_id="repeat-fixture",
        hermit_sha="a" * 40,
        detcore_tree="b" * 40,
        source_tree_dirty=False,
        deadline=10,
        results=series_fixture,
    )
    check("series keeps one row per run", len(series_rows), 2)
    check("series run indices start at zero",
          [row["run_index"] for row in series_rows], [0, 1])
    check("series divergence stays a failure outcome",
          series_rows[0]["outcome"], "FAIL")
    check("series no-result stays a non-verdict",
          series_rows[1]["outcome"], "NO_RESULT")
    check("series carries the Detcore tree",
          series_rows[0]["detcore_tree"], "b" * 40)
    check("series carries measured wall time",
          series_rows[0]["duration_ms"], 4016)
    check("series does not invent missing wall time",
          "duration_ms" in series_rows[1], False)
    check("series carries four separate coordinates",
          [series_rows[0].get(key) for key in (
              "first_divergent_record",
              "first_divergent_scheduler_turn",
              "first_divergent_virtual_nanoseconds",
              "first_divergent_syscall",
          )], [98, 4, 1_640_995_199_000_000_000, 37])

    # Record 0 is the text before the first timestamp; records are 1-based after
    # it, exactly as detcore's comparator enumerates them.
    check("record 0 empty", pieces[0], "")
    # 5 timestamped records plus the empty preamble. The continuation line does
    # NOT add a record -- that is the property this asserts.
    check("record count", len(pieces), 6)
    check("turn at record 1", commit_at_or_before(pieces, 1), (7, 1_640_995_199_000_500_000))
    check("turn at record 3", commit_at_or_before(pieces, 3), (7, 1_640_995_199_000_500_000))
    check("turn at record 4", commit_at_or_before(pieces, 4), (8, 1_640_995_199_000_900_000))
    check("no turn before record 0", commit_at_or_before(pieces, 0), (None, None))
    check("syscall before any", syscall_at_or_before(pieces, 1), (None, None))
    check("syscall at record 2", syscall_at_or_before(pieces, 2), (4, 3))
    # An `inbound syscall` record must NOT be mistaken for a completed one, and a
    # multi-line record must count as ONE record.
    check("syscall at record 3 (inbound only)", syscall_at_or_before(pieces, 3), (4, 3))
    check("multi-line record stays one", "continuation line" in pieces[3], True)
    check("syscall at record 5 (per-dtid counter resets per thread)",
          syscall_at_or_before(pieces, 5), (1, 5))
    check("ns from seconds form", parse_virtual_ns("1_640_995_199.000_500_000", "s"),
          1_640_995_199_000_500_000)
    check("ns from bare ns", parse_virtual_ns("1767225600069347500", None),
          1767225600069347500)
    check("ns rejects fractional bare", parse_virtual_ns("1.5", None), None)

    # --- interval and design effect -------------------------------------
    # The property that matters is not a magic number but the DIRECTION and the
    # SELECTION: the correction must widen, only in concurrent mode, and an
    # explicit override must beat the default in both directions.
    check("mode picks the measured default: concurrent",
          design_effect_for("concurrent", None), CONCURRENT_DESIGN_EFFECT)
    check("mode picks the measured default: sequential",
          design_effect_for("sequential", None), SEQUENTIAL_DESIGN_EFFECT)
    check("sequential is left uncorrected", design_effect_for("sequential", None), 1.0)
    check("explicit override beats the default",
          design_effect_for("concurrent", 1.0), 1.0)
    check("explicit override applies in sequential too",
          design_effect_for("sequential", 4.0), 4.0)

    naive = wilson95(7, 20, 1.0)
    corrected = wilson95(7, 20, CONCURRENT_DESIGN_EFFECT)
    check("deff=1 reproduces the plain Wilson interval", wilson95(7, 20), naive)
    check("the correction WIDENS the interval",
          (corrected[0] < naive[0], corrected[1] > naive[1]), (True, True))
    check("the interval stays inside [0,1] at k=0", wilson95(0, 20, 4.0)[0], 0.0)
    check("the interval stays inside [0,1] at k=n", wilson95(20, 20, 4.0)[1], 1.0)
    check("n=0 is unresolved, not a point estimate", wilson95(0, 0, 2.64), (0.0, 1.0))

    # THE REGRESSION THIS EXISTS TO CATCH, from the measured data: 2/20 against
    # 13/20 are disjoint under the binomial interval and overlap once the
    # measured design effect is applied. If a future edit drops the correction,
    # this pair silently starts reporting a difference between two sweeps of the
    # SAME arm again.
    a_naive, b_naive = wilson95(2, 20, 1.0), wilson95(13, 20, 1.0)
    a_corr, b_corr = wilson95(2, 20, CONCURRENT_DESIGN_EFFECT), wilson95(13, 20, CONCURRENT_DESIGN_EFFECT)
    check("2/20 vs 13/20 read as DIFFERENT under the binomial interval",
          a_naive[1] < b_naive[0], True)
    check("2/20 vs 13/20 read as INDISTINGUISHABLE once corrected",
          a_corr[1] >= b_corr[0], True)

    # --- terminal report ------------------------------------------------
    # Two-sided bracket for the owner-visible failure: a sweep where every run
    # errors must not wear the same "no divergence" wording as a sweep where
    # every verify pair completed cleanly.
    report_meta = {"mode": "sequential"}
    all_failed = [
        RunResult(
            index=i,
            name=f"run{i}",
            dir=f"/fixture/run{i}",
            category="failed",
            why="hermit exited before producing a verdict",
            error_tail=["Error: backend unavailable"],
        )
        for i in range(1, 4)
    ]
    all_clean = [
        RunResult(
            index=i,
            name=f"run{i}",
            dir=f"/fixture/run{i}",
            category="clean",
            why="verified=true bitwise_parity=true",
        )
        for i in range(1, 4)
    ]
    check(
        "all-error heading names total failure",
        non_measurement_heading(all_failed),
        "ALL 3 RUNS FAILED; NO DIVERGENCE DISTRIBUTION WAS MEASURED",
    )
    check(
        "all-error verdict names total failure",
        verdict_lines(report_meta, all_failed)[0],
        "VERDICT: ALL 3 RUNS FAILED. NO DISTRIBUTION WAS MEASURED.",
    )
    check(
        "all-clean verdict remains no-divergence",
        verdict_lines(report_meta, all_clean),
        ["VERDICT: all 3 runs clean, none diverged, mode=sequential."],
    )
    check(
        "all-clean verdict is not mislabeled as failure",
        any("FAILED" in line for line in verdict_lines(report_meta, all_clean)),
        False,
    )

    # --- the syscall range row --------------------------------------------
    # TWO MEASURED FALSEHOODS THIS ROW USED TO PRINT. Both were found by
    # rendering the report from fixtures, not by reading it: the divergence
    # range had never been observed firing at all, because the only run that
    # ever exercised the tool end to end had nothing diverge.
    def sysrun(name, ordinal, dtid, verified):
        return RunResult(
            index=int(name[-1]), name=name, dir=f"/fixture/{name}",
            category="diverged", why="diverged",
            info_record=90 + int(name[-1]), sched_turn=60 + int(name[-1]),
            virtual_ns=100 * int(name[-1]),
            syscall_ordinal=ordinal, syscall_dtid=dtid, coord_verified=verified,
        )

    # 1. PER-THREAD COUNTER POOLED ACROSS THREADS. Two runs diverging at
    #    ordinal 12 in dtid 3 and dtid 7 are two DIFFERENT positions, and the
    #    old row rendered them as `min 12  max 12  distinct 1` -- this
    #    report's own wording for a divergence point that never moved.
    two_threads = [sysrun("run1", 12, 3, True), sysrun("run2", 12, 7, True)]
    lines = syscall_range_lines(two_threads)
    check("two dtids are NOT pooled into one range",
          any("NOT POOLED" in l for l in lines), True)
    check("two dtids never render as the old distinct-1 claim",
          any("min 12  max 12  distinct 1" in l and "dtid" not in l for l in lines), False)
    check("each thread gets its own range", sum("dtid " in l and "min" in l for l in lines), 2)

    # 2. AN UNVERIFIED ORDINAL SETTING THE PUBLISHED MAX. CHECK_KIND_MEANING
    #    calls such a value "indicative, not established"; the old row folded
    #    it into min/max silently, so the max came from a number the tool
    #    refuses to vouch for and the line said nothing.
    mixed = [sysrun("run1", 12, 3, True), sysrun("run2", 999, 3, False)]
    lines = syscall_range_lines(mixed)
    check("an unverified ordinal does not set the range",
          any("max 999" in l for l in lines), False)
    check("the range is the verified value alone",
          any("min 12  max 12  distinct 1" in l for l in lines), True)
    check("excluding it is DISCLOSED, not silent",
          any("EXCLUDED as unverified" in l and "run2" in l for l in lines), True)

    # 3. THE GOOD CASE IS UNCHANGED -- a fix that suppressed the row whenever
    #    it was awkward would pass 1 and 2 and destroy the feature.
    same_thread = [sysrun("run1", 12, 3, True), sysrun("run2", 40, 3, True)]
    lines = syscall_range_lines(same_thread)
    check("one thread, all verified: a single pooled range is still reported",
          len(lines), 1)
    check("and it carries the real min, max and distinct",
          "min 12  max 40  distinct 2" in lines[0], True)
    check("and it names the thread the range belongs to",
          "dtid 3" in lines[0], True)

    # --- bound proximity on failures ---------------------------------------
    # agent(hermit-122) measured deadline-sensitive failures under two concurrent
    # validates, including a KVM failure it classified as a bound-kill under
    # contention. A pressure test is deliberately load, so it manufactures that
    # condition; if the report cannot separate it from a cell failure the sweep
    # reports contention as flakiness.
    kill124 = RunResult(index=1, name="a", dir="/f/a", category="failed", why="",
                        exit_code=124, elapsed_s=900.0)
    check("an exit-124 failure is named as the bound firing, not a verdict",
          bound_note(kill124, 900.0).startswith("BOUND FIRED"), True)
    to = RunResult(index=2, name="b", dir="/f/b", category="failed", why="",
                   exit_code=1, timed_out=True, elapsed_s=899.0)
    check("a timed_out failure is the bound firing however it exited",
          bound_note(to, 900.0).startswith("BOUND FIRED"), True)
    near = RunResult(index=3, name="c", dir="/f/c", category="failed", why="",
                     exit_code=1, elapsed_s=800.0)
    check("a failure at 89% of the bound is flagged as possibly bound-limited",
          "NEAR THE BOUND" in bound_note(near, 900.0), True)
    far = RunResult(index=4, name="d", dir="/f/d", category="failed", why="",
                    exit_code=1, elapsed_s=8.0)
    n = bound_note(far, 900.0)
    check("a failure well inside the bound is NOT flagged", "NEAR THE BOUND" in n, False)
    check("but its elapsed IS still stated against the bound", "8.0s of a 900s" in n, True)
    # ⚠️ The one that keeps this honest in the other direction.
    check("a CLEAN run gets no bound note at all -- this is about failures",
          bound_note(RunResult(index=5, name="e", dir="/f/e", category="clean", why="",
                               elapsed_s=899.0), 900.0), None)
    check("no elapsed time means the question is unanswerable, not answered no",
          bound_note(RunResult(index=6, name="f", dir="/f/f", category="failed", why="",
                               exit_code=1), 900.0), None)

    lines = "\n".join(bound_summary_lines([kill124, near, far], 900.0))
    check("the summary counts bound-kills separately", "1 killed BY the bound" in lines, True)
    check("and counts the near ones separately again", ">= 80% of it" in lines, True)
    check("and says which are the cell's own", "1 finished well inside it" in lines, True)
    check("and warns against reporting the first two as flakiness",
          "without saying the bound may have produced them." in lines, True)
    check("no failures means no bound section at all", bound_summary_lines([far._replace()] if hasattr(far,'_replace') else [RunResult(index=9,name="g",dir="/f/g",category="clean",why="")], 900.0), [])

    # --- nextest vocabulary -----------------------------------------------
    # The guest heading does not merely use the wrong words for a nextest sweep,
    # it asserts the wrong MODEL: it groups a FAILING test with the runs that
    # produced nothing, when a failing test is the finding. A reader who meets
    # guest vocabulary in a nextest report reasons about guests -- they look for
    # a divergence coordinate that cannot exist and conclude the tool lost it.
    nx = [RunResult(index=1, name="n1", dir="/f/1", category="failed", why="", test_id="A"),
          RunResult(index=2, name="n2", dir="/f/2", category="no_result", why="", test_id="B")]
    head = nextest_outcome_heading(nx)
    check("a nextest heading does not claim a missing DIVERGENCE POINT",
          "DIVERGENCE" in head, False)
    check("it separates a failure from a non-measurement",
          head, "RUN DETAIL -- 1 FAILED, 1 NOT MEASURED")
    check("a never-launched node is its own third thing",
          nextest_outcome_heading(nx + [RunResult(index=3, name="n3", dir="/f/3",
                                                  category="not_run", why="", test_id="C")]),
          "RUN DETAIL -- 1 FAILED, 1 NOT MEASURED, 1 NEVER LAUNCHED")
    check("all-failed reads as failures, not as an absence of measurement",
          nextest_outcome_heading([nx[0]]), "RUN DETAIL -- 1 FAILED")
    # The GUEST heading is untouched -- this must not have been a rename.
    guest_only = [RunResult(index=i, name=f"r{i}", dir=f"/f/{i}", category="failed", why="")
                  for i in (1, 2, 3)]
    check("the guest heading is unchanged",
          non_measurement_heading(guest_only),
          "ALL 3 RUNS FAILED; NO DIVERGENCE DISTRIBUTION WAS MEASURED")

    # --- nextest ids ------------------------------------------------------
    # ⚠️ THE ONE THAT MATTERS: nextest EXITS 0 WHEN A FILTERSET MATCHES NOTHING.
    # A typo, a renamed test, or a test compiled out all produce a silent green.
    # For a tool whose entire job is deciding whether a named id fails, "no such
    # id" answered as "did not fail" is how an id gets marked known-failing after
    # it has quietly ceased to exist.
    empty = ("    Starting 0 tests across 0 binaries (23 skipped)\n"
             "    Summary [   0.001s] 0 tests run: 0 passed, 0 failed\n")
    check("an id that selects NO test is not clean",
          classify_nextest_output(empty, "gone")[0], "no_result")
    check("and the reason names the filterset",
          "test(=gone)" in classify_nextest_output(empty, "gone")[1], True)

    passed = ("        PASS [   0.004s] hermit::cli only_test\n"
              "    Summary [   0.010s] 1 test run: 1 passed, 0 failed\n")
    check("a passing id is clean", classify_nextest_output(passed, "only_test")[0], "clean")
    failed_out = ("        FAIL [   2.304s] hermit::cli only_test\n"
                  "    Summary [   2.400s] 1 test run: 0 passed, 1 failed\n")
    check("a failing id is failed -- the finding, not an error",
          classify_nextest_output(failed_out, "only_test")[0], "failed")

    # A SLOW line is a progress notice; if it were counted the test would look
    # like it produced two verdicts and be refused as ambiguous.
    slow = ("        SLOW [  60.000s] hermit::cli only_test\n" + passed)
    check("SLOW does not make a single test look like two",
          classify_nextest_output(slow, "only_test")[0], "clean")

    # A filterset that pulls in a FAMILY cannot yield a per-id verdict.
    many = ("        PASS [   0.004s] hermit::cli a\n"
            "        FAIL [   0.004s] hermit::cli b\n"
            "    Summary [   0.010s] 2 tests run: 1 passed, 1 failed\n")
    check("a multi-test selection is refused, not scored",
          classify_nextest_output(many, "a")[0], "no_result")

    # EXACT MATCH, not substring: test(NAME) would sweep in every id having this
    # one as a prefix, which is a whole liteinst_strict_verify_round2_* family.
    check("the filterset is the EXACT-match form",
          nextest_filter_for("x"), "test(=x)")
    # ⚠️ THE ONE THAT WOULD HAVE WASTED THE FIRST SWEEP. nextest prints
    # `hermit::cli run_dbt_...`; rejoining those with `::` yields a string that
    # matches NO test, and nextest exits 0 for that. Every id would have come
    # back "selected no test".
    check("a BINARY$TEST id pins both halves",
          nextest_filter_for("hermit::cli$run_dbt_verifies_self_prlimit"),
          "binary(=hermit::cli) and test(=run_dbt_verifies_self_prlimit)")
    # The boundary is NOT the last `::`, which is why `$` is required rather
    # than inferred: both of these are real and split in different places.
    check("a test name containing :: survives intact",
          nextest_filter_for("hermit-detcore$detlog::tests::detlog_observed"),
          "binary(=hermit-detcore) and test(=detlog::tests::detlog_observed)")

    # No output at all is a node that never got to a test, not a pass.
    check("empty output is failed, not clean", classify_nextest_output("", "x")[0], "failed")

    # The per-id table must never fold a no-verdict node into clean.
    rows = [RunResult(index=1, name="n1", dir="/f/1", category="failed", why="", test_id="A"),
            RunResult(index=2, name="n2", dir="/f/2", category="clean", why="", test_id="A"),
            RunResult(index=3, name="n3", dir="/f/3", category="no_result", why="gone", test_id="B")]
    table = "\n".join(per_id_lines(rows))
    check("per-id counts are reported per id", "1      1      0     2   A" in table, True)
    check("a no-verdict node counts as other, not clean",
          "0      0      1     1   B" in table, True)
    check("and the unusable id is named", "NO USABLE VERDICT" in table and "B" in table, True)

    # --- repo-relative guest paths ----------------------------------------
    # THE DEFECT: the bucket runs a cell with the HERMIT REPO ROOT as cwd, so a
    # cell may name its program or inputs relative to it. This sweep gives each
    # node its own EMPTY cwd (so a directory entry appearing between a node's
    # two executions cannot read as a divergence), and in an empty cwd those
    # paths resolve to nothing. Measured: 61 of 366 cells, every one of them a
    # NON-C cell, died at exit 127 "could not resolve program" or exit 125
    # "open(fixture) failed".
    import tempfile as _tf
    with _tf.TemporaryDirectory() as _d:
        _root = Path(_d)
        (_root / "tests").mkdir()
        (_root / "tests" / "guest.sh").write_text("#!/bin/sh\n")
        (_root / "README.md").write_text("x\n")
        got, rewritten = absolutise_repo_paths(
            ["tests/guest.sh", "--run", "README.md", "chaos", "/bin/true"], _root)
        check("a relative PROGRAM path is absolutised",
              got[0], str(_root / "tests/guest.sh"))
        check("a relative FILE ARGUMENT is absolutised",
              got[2], str(_root / "README.md"))
        # The one that makes existence the discriminator rather than the shape.
        check("a bare selector WORD is left alone", got[3], "chaos")
        check("a flag is left alone", got[1], "--run")
        check("an already-absolute path is left alone", got[4], "/bin/true")
        check("and exactly what was rewritten is reported",
              rewritten, ["tests/guest.sh", "README.md"])

    # 4. NO USABLE ORDINAL IS AN ABSENCE, NOT A ZERO-WIDTH RANGE.
    none_usable = [sysrun("run1", 999, 3, False), sysrun("run2", None, None, False)]
    lines = syscall_range_lines(none_usable)
    check("no verified ordinal yields no range at all", lines[0].split()[1], "-")
    check("and says how many of each reason",
          "1 of 2 not reported" in lines[0] and "1 of 2 EXCLUDED" in lines[0], True)

    for f in failures:
        print(f"{PROG}: SELFTEST FAIL {f}", file=sys.stderr)
    print(f"{PROG}: selftest {'FAILED' if failures else 'PASSED'} "
          f"({len(failures)} failures)", file=sys.stderr)
    return 1 if failures else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
