+    fn resource_caps_collision_run(
+        dir: &std::path::Path,
+        coordinator: Option<ResourceCoordinator>,
+    ) -> RunResult {
+        let counter = dir.join("counter");
+        let observations = dir.join("observations");
+        let command = format!(
+            "value=$(cat {counter}); printf '%s' \"$value\" >> {observations}; sleep 0.35; printf '%s\\n' \"$((value + 1))\" > {counter}",
+            counter = counter.display(),
+            observations = observations.display(),
+        );
+        let cfg = DagConfig {
+            steps: vec![step("g", "writer", &command, &[], 0.0, &[("guest", 1)])],
+            resource_caps: BTreeMap::from([("guest".to_string(), 1)]),
+            ..Default::default()
+        };
+        let runner = Runner::new(&cfg, 1, 1, false, 0, None, None, None, coordinator);
+        let (_ok, wall) = runner.run();
+        runner.result(wall)
+    }
+
+    fn wait_for_observation(path: &std::path::Path) {
+        let deadline = Instant::now() + Duration::from_secs(3);
+        while fs::metadata(path).map(|meta| meta.len()).unwrap_or(0) == 0 {
+            assert!(
+                Instant::now() < deadline,
+                "the first writer never entered its critical section"
+            );
+            thread::sleep(Duration::from_millis(5));
+        }
+    }
+
