+    /// excludes the wait from the second step's own elapsed time.
+    #[test]
+    fn resource_caps_coordinate_independent_runners_before_step_timing() {
+        let stamp = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let dir = std::env::temp_dir().join(format!(
+            "dagrun-resource-caps-collision-{}-{stamp}",
+            std::process::id()
+        ));
+        fs::create_dir_all(&dir).unwrap();
+
+        // REMOVED FIX: two independent runners both believe they own guest=1. Force B to start
+        // after A has read 0 but before A writes, so the final 1 is a demonstrated lost update,
+        // not a concurrent run that happened not to overlap.
+        fs::write(dir.join("counter"), b"0\n").unwrap();
+        let first_dir = dir.clone();
+        let first = thread::spawn(move || resource_caps_collision_run(&first_dir, None));
+        wait_for_observation(&dir.join("observations"));
+        let second_dir = dir.clone();
+        let second = thread::spawn(move || resource_caps_collision_run(&second_dir, None));
+        let first_result = first.join().unwrap();
+        let second_result = second.join().unwrap();
+        assert!(first_result.ok && second_result.ok);
+        assert_eq!(fs::read_to_string(dir.join("observations")).unwrap(), "00");
+        assert_eq!(
+            fs::read_to_string(dir.join("counter")).unwrap(),
+            "1\n",
+            "without cross-process resource_caps both steps read 0 and one update is lost"
+        );
+
+        // FIXED: the same two independent runners share one resource_caps path. B is launched
+        // while A is inside the critical section, but its command cannot start until A releases.
+        fs::write(dir.join("counter"), b"0\n").unwrap();
+        fs::write(dir.join("observations"), b"").unwrap();
+        let ledger = dir.join("resource-caps.json");
+        let capacities = BTreeMap::from([("guest".to_string(), 1)]);
+        let first_coordinator =
