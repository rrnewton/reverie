+def _ownerless_worktree_content_sha256(
+    checkout: Path,
+    repository_paths: Sequence[str],
+    safe_roots: Sequence[str],
+) -> str:
+    """Hash non-cache checkout contents without consulting Git after a path fence."""
+
+    digest = hashlib.sha256()
+
+    def add(value: bytes) -> None:
+        digest.update(len(value).to_bytes(8, "big"))
+        digest.update(value)
+
+    def visit(directory: Path, relative: Path) -> None:
+        try:
+            entries = sorted(os.scandir(directory), key=lambda item: os.fsencode(item.name))
+        except OSError as exc:
+            raise Refusal(f"cannot inspect ownerless worktree contents at {directory}: {exc}") from exc
+        for entry in entries:
+            child_relative = relative / entry.name
+            if _ownerless_snapshot_excluded(
+                child_relative, repository_paths, safe_roots
+            ):
+                continue
+            try:
+                before = entry.stat(follow_symlinks=False)
+            except OSError as exc:
+                raise Refusal(
+                    f"cannot inspect ownerless worktree entry {directory / entry.name}: {exc}"
+                ) from exc
+            add(os.fsencode(child_relative.as_posix()))
+            add(str(stat.S_IMODE(before.st_mode)).encode("ascii"))
+            child = directory / entry.name
+            if stat.S_ISDIR(before.st_mode):
+                add(b"directory")
+                visit(child, child_relative)
+            elif stat.S_ISREG(before.st_mode):
+                add(b"file")
+                try:
+                    contents = child.read_bytes()
+                    after = child.stat(follow_symlinks=False)
+                except OSError as exc:
+                    raise Refusal(
+                        f"cannot read ownerless worktree entry {child}: {exc}"
+                    ) from exc
+                if (
+                    not stat.S_ISREG(after.st_mode)
+                    or before.st_dev != after.st_dev
+                    or before.st_ino != after.st_ino
+                    or before.st_size != after.st_size
+                    or before.st_mtime_ns != after.st_mtime_ns
+                ):
+                    raise Refusal(f"ownerless worktree changed while reading {child}")
+                add(contents)
+            elif stat.S_ISLNK(before.st_mode):
+                add(b"symlink")
+                try:
+                    add(os.fsencode(os.readlink(child)))
+                except OSError as exc:
+                    raise Refusal(
+                        f"cannot read ownerless worktree symlink {child}: {exc}"
+                    ) from exc
+            else:
+                raise Refusal(f"ownerless worktree contains a special file: {child}")
+
+    visit(checkout, Path())
+    return digest.hexdigest()
+
