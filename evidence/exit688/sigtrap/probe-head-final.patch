diff --git a/safeptrace/src/probe.rs b/safeptrace/src/probe.rs
new file mode 100644
index 000000000..ce5cbd3ba
--- /dev/null
+++ b/safeptrace/src/probe.rs
@@ -0,0 +1,97 @@
+//! INVESTIGATION PROBE (sigtrap): per-tid history of ptrace requests and decoded stops.
+#![allow(missing_docs)]
+use std::backtrace::Backtrace;
+use std::collections::HashMap;
+use std::collections::VecDeque;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+pub struct Entry {
+    pub seq: u64,
+    pub text: String,
+    pub bt: Option<Backtrace>,
+}
+
+static SEQ: AtomicU64 = AtomicU64::new(0);
+static HIST: Mutex<Option<HashMap<i32, VecDeque<Entry>>>> = Mutex::new(None);
+
+pub fn record(tid: i32, text: String, with_bt: bool) {
+    let seq = SEQ.fetch_add(1, Ordering::SeqCst);
+    let bt = with_bt.then(Backtrace::force_capture);
+    let mut guard = HIST.lock().unwrap_or_else(|p| p.into_inner());
+    let map = guard.get_or_insert_with(HashMap::new);
+    let ring = map.entry(tid).or_default();
+    if ring.len() >= 128 {
+        ring.pop_front();
+    }
+    ring.push_back(Entry { seq, text, bt });
+}
+
+fn frames(bt: &Backtrace) -> String {
+    let rendered = format!("{bt}");
+    let mut out = Vec::new();
+    let mut lines = rendered.lines().peekable();
+    while let Some(line) = lines.next() {
+        let t = line.trim();
+        if (t.contains("reverie_ptrace::") || t.contains("safeptrace::"))
+            && !t.contains("safeptrace::probe")
+        {
+            let loc = lines
+                .peek()
+                .map(|l| l.trim().to_owned())
+                .filter(|l| l.starts_with("at "))
+                .unwrap_or_default();
+            let short = loc.rsplit("/src/").next().unwrap_or("").to_owned();
+            out.push(format!("{}@{}", t.split(": ").nth(1).unwrap_or(t), short));
+            if out.len() >= 6 {
+                break;
+            }
+        }
+    }
+    out.join(" <- ")
+}
+
+pub fn dump(tid: i32) -> String {
+    let guard = HIST.lock().unwrap_or_else(|p| p.into_inner());
+    let Some(map) = guard.as_ref() else {
+        return String::new();
+    };
+    let Some(ring) = map.get(&tid) else {
+        return format!("  (no history for {tid})");
+    };
+    let mut s = String::new();
+    for e in ring {
+        s.push_str(&format!("  #{} {}", e.seq, e.text));
+        if let Some(bt) = &e.bt {
+            s.push_str(&format!("  [{}]", frames(bt)));
+        }
+        s.push('\n');
+    }
+    s
+}
+
+/// Dump `tid` plus any former tid named in its EXEC-DECODE records.
+pub fn dump_related(tid: i32) -> String {
+    let mut out = format!(" history tid={tid}:\n{}", dump(tid));
+    let formers: Vec<i32> = {
+        let guard = HIST.lock().unwrap_or_else(|p| p.into_inner());
+        guard
+            .as_ref()
+            .and_then(|m| m.get(&tid))
+            .map(|ring| {
+                ring.iter()
+                    .filter_map(|e| e.text.strip_prefix("EXEC-DECODE former=").or_else(|| e.text.strip_prefix("CLONE-DECODE former=")))
+                    .filter_map(|v| v.parse().ok())
+                    .collect()
+            })
+            .unwrap_or_default()
+    };
+    let mut formers = formers;
+    formers.sort();
+    formers.dedup();
+    for f in formers {
+        out.push_str(&format!(" history former tid={f}:\n{}", dump(f)));
+    }
+    out
+}
