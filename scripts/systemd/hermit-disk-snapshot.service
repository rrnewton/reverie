[Unit]
Description=Publish serialized bounded dev-hermit disk-health snapshots
Documentation=https://github.com/rrnewton/dev-hermit/blob/main/scripts/publish-disk-snapshots.py

[Service]
Type=oneshot
Environment=PATH=%h/.local/libexec/dev-hermit:%h/bin:%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin
# Match the independently validated bounds on the immutable-tool bootstrap.
Environment=GOMAXPROCS=4
Environment=MALLOC_CONF=background_thread:false,narenas:4
# Make the bootstrap's materialization-lock wait explicit so it is a tested
# part of this service's complete-run envelope rather than a hidden default.
Environment=HERMIT_HEALTH_TOOL_LOCK_TIMEOUT=120
WorkingDirectory=%h
Nice=19
IOSchedulingClass=idle
UMask=0077
# One immutable current-origin tool invocation runs both publishers serially;
# the wrapper's lock also refuses overlapping direct/manual invocations.
ExecStart=%h/.local/libexec/dev-hermit/operational-tool --run-current-tool --state-root %h/work/dev-hermit --tool-relative scripts/publish-disk-snapshots.py -- --state-root %h/work/dev-hermit --population-timeout 180
# This is the fail-closed wall authority for the complete path: lock wait,
# immutable-tool materialization, measurements, and atomic publication. It is
# deliberately below both the 15-minute timer period and the disk evidence's
# 45-minute freshness refusal window; no internal phase is claimed to have a
# separate code-enforced wall bound.
TimeoutStartSec=540
TimeoutStopSec=5s
KillMode=control-group
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=128M
TasksMax=512

[Install]
WantedBy=default.target
