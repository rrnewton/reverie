[Unit]
Description=Check dev-hermit health-tick liveness every 10 minutes
Documentation=https://github.com/rrnewton/dev-hermit/blob/main/scripts/hermit-health-staleness.sh
# Ordering is not a dependency: if both timers are started in one transaction,
# make the monitored timer active first so the watchdog can measure its bounded
# bootstrap grace. The watchdog still runs when health-tick is absent or dead.
After=hermit-health-tick.timer

[Timer]
# A real calendar schedule makes Persistent=true meaningful: systemd runs one
# missed check after downtime. This schedule is independent of health-tick, so
# a stopped tick cannot stop the alarm that watches it.
OnCalendar=*:0/10
Persistent=true
AccuracySec=1min
Unit=hermit-health-staleness.service

[Install]
WantedBy=timers.target
