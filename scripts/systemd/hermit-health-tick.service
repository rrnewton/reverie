[Unit]
Description=dev-hermit operational health tick (durable replacement for ORC session-bound wf.loop)
Documentation=https://github.com/rrnewton/dev-hermit/blob/main/scripts/hermit-health-tick.sh

[Service]
Type=oneshot
# %h, not a literal home and not $HOME: systemd does not expand shell variables
# in ExecStart/WorkingDirectory, and a hardcoded owner path fails the parent's
# portability gate.
Environment=PATH=%h/.cargo/bin:%h/orc-bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h
# The installed bootstrap materializes and verifies current origin/main before
# it executes the version-controlled health wrapper. The shared parent checkout
# is mutable state and can be unable to fast-forward while another agent has a
# nested checkout on a different revision; it must not select the wrapper code.
ExecStart=%h/.local/libexec/dev-hermit/operational-tool --run-current-tool --state-root %h/work/dev-hermit --tool-relative scripts/hermit-health-tick.sh
# The tick's own pin-guard exit is expected signal, not a unit failure.
SuccessExitStatus=0 1
# NOTE: a tick that exceeds this is KILLED before it can append its invocation
# line, which is why the alarm reads the timer's LastTriggerUSec rather than the
# invocation log's mtime -- see scripts/hermit-health-staleness.sh.
TimeoutStartSec=300

[Install]
WantedBy=default.target
