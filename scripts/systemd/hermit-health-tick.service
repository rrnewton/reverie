[Unit]
Description=dev-hermit operational health tick (sole durable scheduler)
Documentation=https://github.com/rrnewton/dev-hermit/blob/main/scripts/hermit-health-tick.sh

[Service]
Type=oneshot
# %h, not a literal home and not $HOME: systemd does not expand shell variables
# in ExecStart/WorkingDirectory, and a hardcoded owner path fails the parent's
# portability gate.
Environment=PATH=%h/.local/libexec/dev-hermit:%h/bin:%h/.local/bin:%h/.cargo/bin:%h/orc-bin:/usr/local/bin:/usr/bin:/bin
Environment=FLEET_REAL_GH=%h/bin/gh
# Coordinator substrate is runtime state, not portable repository policy.  The
# local file explicitly binds TG_DB_PATH (for example %h/.tg/hermit2.db); when
# it is absent, TaskGraph consumers retain their existing fail-closed result.
EnvironmentFile=-%h/.config/dev-hermit/health.env
WorkingDirectory=%h
# The installed bootstrap materializes and verifies current origin/main before
# it executes the version-controlled health wrapper. The shared parent checkout
# is mutable state and can be unable to fast-forward while another agent has a
# nested checkout on a different revision; it must not select the wrapper code.
ExecStart=%h/.local/libexec/dev-hermit/operational-tool --run-current-tool --state-root %h/work/dev-hermit --tool-relative scripts/hermit-operational-tick
# The tick's own pin-guard exit is expected signal, not a unit failure.
SuccessExitStatus=0 1
# NOTE: a tick that exceeds this is KILLED before it can append its invocation
# line, which is why the alarm reads the timer's LastTriggerUSec rather than the
# invocation log's mtime -- see scripts/hermit-health-staleness.sh.
# The version-controlled entry point owns the 1200s CPU budget and 619s blocked-
# work backstop. This outer deadline leaves its cgroup accounting and report
# persistence 31 seconds to finish before systemd applies a final service kill.
TimeoutStartSec=650

[Install]
WantedBy=default.target
