[Unit]
Description=Publish exact Herdr worker identities for dev-hermit health authority
Documentation=https://github.com/rrnewton/dev-hermit/blob/main/ci-hub/health/herdr_agent_snapshot.py

[Service]
Type=oneshot
Environment=PATH=%h/.local/libexec/dev-hermit:%h/bin:%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h
# Current origin/main supplies the producer; the mutable parent supplies only
# coordinator-owned bindings and the atomically replaced evidence artifact.
ExecStart=%h/.local/libexec/dev-hermit/operational-tool --run-current-tool --state-root %h/work/dev-hermit --tool-relative ci-hub/health/herdr_agent_snapshot.py -- --root %h/work/dev-hermit --bindings %h/work/dev-hermit/.tick-hub/herdr-agent-bindings.json --output %h/work/dev-hermit/ignored/ci-hub/agent-snapshot.json --herdr-bin %h/bin/herdr --agentctl-bin %h/.local/bin/agentctl --gate
TimeoutStartSec=90
TimeoutStopSec=2s
KillMode=control-group
MemoryMax=1G
MemorySwapMax=128M
# `operational-tool` may refresh its immutable checkout before the tiny Python
# producer starts. The GitHub credential helper is a Go binary and initializes
# more than 32 runtime threads on this host; TasksMax=32 made it abort before
# authentication with `pthread_create failed`. Keep a bound, but cover the
# cold checkout bootstrap, Git repack, helper, and producer. The exact cold
# path needed 1,012 MiB peak and 236 KiB swap; cached runs are much smaller.
# Keep finite RAM and swap bounds so neither path can consume the host without
# limit.
TasksMax=512

[Install]
WantedBy=default.target
