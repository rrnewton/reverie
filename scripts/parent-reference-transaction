#!/usr/bin/env bash
# Keep the shared parent repository's origin-tracking refs bound to the parent
# repository. The ordinary tracked reference-transaction hook still runs after
# this check and retains its shared-branch protections.
set -uo pipefail

phase="${1:-}"
updates=$(mktemp) || {
  echo "parent-origin: REFUSED: could not capture the reference transaction" >&2
  exit 1
}
trap 'rm -f -- "$updates"' EXIT
if ! cat >"$updates"; then
  echo "parent-origin: REFUSED: could not capture the reference transaction" >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
[ -n "$repo_root" ] || exit 0

if [ "$phase" = prepared ]; then
  touches_origin=0
  while read -r _old _new ref; do
    case "$ref" in
      refs/remotes/origin/*) touches_origin=1 ;;
    esac
  done <"$updates"

  if [ "$touches_origin" = 1 ]; then
    origin=$(git config --get remote.origin.url 2>/dev/null || true)
    case "$origin" in
      https://github.com/rrnewton/dev-hermit.git | \
      https://github.com/rrnewton/dev-hermit | \
      git@github.com:rrnewton/dev-hermit.git | \
      git@github.com:rrnewton/dev-hermit | \
      ssh://git@github.com/rrnewton/dev-hermit.git | \
      ssh://git@github.com/rrnewton/dev-hermit)
        ;;
      *)
        cat >&2 <<REFUSAL
parent-origin: REFUSED: origin-tracking refs belong to rrnewton/dev-hermit,
but this checkout has origin configured as:

  ${origin:-<unset>}

No origin-tracking ref was updated. Correct the remote in the checkout where
the command was intended to run; do not fetch through this mismatch.
REFUSAL
        exit 1
        ;;
    esac
  fi
fi

repo_hook="$repo_root/.githooks/reference-transaction"
if [ -x "$repo_hook" ]; then
  exec "$repo_hook" "$@" <"$updates"
fi

exit 0
