#!/usr/bin/env bash
# Serialize every parent-main publication and bind it to a freshly fetched
# origin/main value.  Hooks call the verify-* subcommands; humans and tools use
# commit, publish, or sync.  No mode force-pushes or rewrites a branch.
set -Eeuo pipefail

ZERO=0000000000000000000000000000000000000000

# NO SILENT FAILURE ON THE ONE PATH EVERY AGENT MUST USE.
#
# `set -e` aborts with no output at all when an un-`if`-guarded command fails,
# and this is the single serialized route to landing anything -- so a wordless
# abort costs every reader the same reconstruction. It happened: a SIGPIPE in the
# reversion guard killed the script mid-sentence and agents saw a publish that
# simply did not work.
#
# `die` is the EXPLAINED exit. This trap catches everything else and says WHERE,
# so an unexplained failure is at worst a located one. It only prints: it never
# changes an exit status and never turns a failure into a success. `set -E` is
# required for it to fire inside functions and subshells, which is where the
# interesting failures are.
#
# AND THE BANNER MUST NOT CONTRADICT A REASON THAT WAS PRINTED.
#
# `die` runs inside a command substitution more often than it looks --
# `checker=$(attribution_checker "$root")`, `expected=$(verify_context)`,
# `root=$(repo_root)`. A subshell cannot set a variable its parent reads, so
# `_pmw_explained` stayed 0 in the parent, the substitution's failure tripped
# this trap, and the banner printed "and no reason was printed" DIRECTLY UNDER
# the reason `die` had just printed. That is worse than silence: it tells every
# reader to disbelieve the line above it, and a caller keeping the LAST line
# (the ledger publisher did) reports the banner's tail and discards the cause.
# Measured 2026-08-09 against the real tool at line 124.
#
# A marker FILE crosses the subshell boundary. `$$` is the top-level PID in
# every subshell, so both sides name the same file; the EXIT trap removes it,
# and bash does NOT run an inherited EXIT trap in a command-substitution
# subshell (measured), so the marker survives exactly as far as it must.
_pmw_explained=0
_pmw_explained_marker="${TMPDIR:-/tmp}/.parent-main-write-explained.$$"
trap 'rm -f "$_pmw_explained_marker"' EXIT
_pmw_on_err() {
  local rc=$1 line=$2
  if [ "$_pmw_explained" = 1 ] || [ -e "$_pmw_explained_marker" ]; then return 0; fi
  echo "parent-main-write: ABORTED at line $line with status $rc, and no reason" >&2
  echo "  was printed. That is a defect in this tool, not a verdict on your" >&2
  echo "  change: nothing was published and nothing was modified." >&2
  case "$rc" in
    141) echo "  Status 141 is SIGPIPE -- a producer was still writing when a" >&2
         echo "  reader (head/grep -q) closed the pipe, and pipefail promoted it." >&2 ;;
  esac
  return 0
}
trap '_pmw_on_err "$?" "$LINENO"' ERR

die() {
  _pmw_explained=1
  # Also record it where a parent shell can see it: this may be a subshell.
  : >"$_pmw_explained_marker" 2>/dev/null || true
  echo "parent-main-write: REFUSED: $*" >&2
  exit 1
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a Git checkout"
}

lock_path() {
  if [ -n "${HERMIT_PARENT_MAIN_LOCK_PATH:-}" ]; then
    printf '%s\n' "$HERMIT_PARENT_MAIN_LOCK_PATH"
  else
    printf '/tmp/dev-hermit-parent-main-%s.lock\n' "$(id -u)"
  fi
}

acquire_lock() {
  local path timeout
  path=$(lock_path)
  # Contention is an observable defect, not hidden queueing. A second writer
  # must fail immediately so the owner sees that parent-main authority was not
  # acquired. A caller may opt into a bounded wait explicitly for maintenance.
  timeout=${HERMIT_PARENT_MAIN_LOCK_TIMEOUT:-0}
  exec 9>"$path"
  if ! flock -w "$timeout" 9; then
    local holder
    holder=$(sed -n '1,4p' "$path" 2>/dev/null | tr '\n' ' ')
    die "another parent-main writer owns $path after ${timeout}s${holder:+ ($holder)}"
  fi
  printf 'pid=%s\nmode=%s\nreason=%s\nstarted=%s\n' \
    "$$" "$HERMIT_PARENT_MAIN_MODE" "${HERMIT_PARENT_MAIN_AUDIT_REASON:-ordinary}" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$path"
  export HERMIT_PARENT_MAIN_LOCK_FD=9
  export HERMIT_PARENT_MAIN_LOCK_PATH="$path"
}

verify_lock() {
  local fd=${HERMIT_PARENT_MAIN_LOCK_FD:-} expected actual
  expected=$(lock_path)
  case "$fd" in ''|*[!0-9]*) die "missing serialized-writer lock receipt" ;; esac
  [ -e "/proc/$$/fd/$fd" ] || die "writer lock fd $fd is not inherited"
  actual=$(readlink "/proc/$$/fd/$fd" 2>/dev/null || true)
  [ "$actual" = "$expected" ] || die "writer lock fd does not name $expected"
  flock -n "$fd" || die "writer lock is not owned by this operation"
}

network_git() {
  local root=$1
  shift
  local url
  url=$(git -C "$root" remote get-url origin 2>/dev/null || true)
  if [ "${HERMIT_PARENT_MAIN_NO_PROXY:-}" = 1 ] ||
     [ -z "$url" ] || [ "${url#/}" != "$url" ] || [ "${url#file://}" != "$url" ]; then
    git -C "$root" "$@"
  elif command -v with-proxy >/dev/null 2>&1; then
    with-proxy git -C "$root" "$@"
  else
    git -C "$root" "$@"
  fi
}

fetch_expected() {
  local root=$1
  network_git "$root" fetch origin main >/dev/null ||
    die "could not fetch origin/main; nothing was modified"
  HERMIT_PARENT_MAIN_EXPECT=$(git -C "$root" rev-parse --verify 'refs/remotes/origin/main^{commit}') ||
    die "fetched origin/main but could not resolve its commit; nothing was modified"
  export HERMIT_PARENT_MAIN_EXPECT
}

# A dirty gitlink is not an overwrite when the fast-forward changes only the
# superproject's index entry. The writer stages each qualifying gitlink at its
# fetched target itself, immediately before `git merge --ff-only` (see
# sync_preserve_dirty), so the merge keeps that index entry and never checks out
# the path: it does not update, clean, or otherwise touch the nested checkout's
# HEAD, edits, or untracked files. `git merge` has no --recurse-submodules
# option; on git 2.53 it left the nested checkout alone even with
# submodule.recurse=true, for both an embedded .git directory and an absorbed
# gitfile (measured 2026-10-01).
#
# Two states qualify. The function records which one in gitlink_overlap_state,
# and records gitlink_overlap_checkout, gitlink_overlap_target,
# gitlink_overlap_before and gitlink_overlap_index, all of which the caller
# declares local:
#
#   already-at-target: the nested checkout already names the fetched target,
#     and the index equals either endpoint.
#   unstaged-checkout-preserved: the superproject's index entry still equals
#     the gitlink recorded in HEAD, so nothing about the gitlink is staged, and
#     the path is a real directory. The nested checkout may be at any commit and
#     carry any edits. The shared parent's ./hermit is a primary working
#     checkout whose HEAD rarely equals the recorded gitlink, so refusing this
#     state blocked every gitlink bump:
#     https://github.com/rrnewton/dev-hermit/issues/468
#
# Everything else remains an ordinary overlap and refuses:
#   - either endpoint or the stage-0 index entry is not a mode-160000 gitlink;
#   - the gitlink is staged (index differs from HEAD), unless the checkout and
#     the index both already name the target;
#   - a regular file, a symlink, or nothing at the gitlink path when the
#     checkout is not already at the target. A plain fast-forward replaces a
#     non-directory there with an empty directory, which deletes a regular
#     file's bytes (measured with git merge --ff-only on 2026-10-01). The
#     writer's pre-staging would leave such a path alone too, but a
#     non-directory at a gitlink path is not a nested checkout in any state;
#     it is local work of another kind, and this tool does not classify it.
#
# Every metadata query uses --literal-pathspecs. Without it, a path such as
# `:(literal)hermit` is pathspec magic and the query inspects `hermit` instead.
gitlink_overlap_preservable() {
  local root=$1 before=$2 target=$3 path=$4
  local before_mode before_oid target_mode target_oid index_mode index_oid checkout_oid
  before_mode=$(git --literal-pathspecs -C "$root" ls-tree "$before" -- "$path" | awk 'NR == 1 { print $1 }')
  before_oid=$(git --literal-pathspecs -C "$root" ls-tree "$before" -- "$path" | awk 'NR == 1 { print $3 }')
  target_mode=$(git --literal-pathspecs -C "$root" ls-tree "$target" -- "$path" | awk 'NR == 1 { print $1 }')
  target_oid=$(git --literal-pathspecs -C "$root" ls-tree "$target" -- "$path" | awk 'NR == 1 { print $3 }')
  index_mode=$(git --literal-pathspecs -C "$root" ls-files --stage -- "$path" | awk '$3 == 0 { print $1 }')
  index_oid=$(git --literal-pathspecs -C "$root" ls-files --stage -- "$path" | awk '$3 == 0 { print $2 }')
  [ "$before_mode" = 160000 ] && [ "$target_mode" = 160000 ] &&
    [ "$index_mode" = 160000 ] || return 1
  checkout_oid=$(git -C "$root/$path" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) ||
    checkout_oid=
  if [ -n "$checkout_oid" ] && [ "$checkout_oid" = "$target_oid" ] &&
     { [ "$index_oid" = "$before_oid" ] || [ "$index_oid" = "$target_oid" ]; }; then
    gitlink_overlap_state=already-at-target
    gitlink_overlap_checkout=$checkout_oid
    gitlink_overlap_target=$target_oid
    gitlink_overlap_before=$before_oid
    gitlink_overlap_index=$index_oid
    return 0
  fi
  if [ "$index_oid" = "$before_oid" ] && [ ! -L "$root/$path" ] && [ -d "$root/$path" ]; then
    gitlink_overlap_state=unstaged-checkout-preserved
    # In a directory without its own .git, rev-parse reports the superproject's
    # HEAD. Name the checkout only when it is a repository of its own.
    if [ -n "$checkout_oid" ] && [ -e "$root/$path/.git" ]; then
      gitlink_overlap_checkout=$checkout_oid
    else
      gitlink_overlap_checkout=unreadable
    fi
    gitlink_overlap_target=$target_oid
    gitlink_overlap_before=$before_oid
    gitlink_overlap_index=$index_oid
    return 0
  fi
  return 1
}

# Write to FILE a patch that changes each named gitlink from its entry in
# commit FROM to its entry in commit TO. Plumbing with every format option
# explicit, so local diff.* configuration (submodule=log, noprefix,
# mnemonicPrefix, external drivers) cannot change what `git apply` reads.
write_gitlink_patch() {
  local root=$1 from=$2 to=$3 file=$4
  shift 4
  git --literal-pathspecs -C "$root" diff-tree -r -p --full-index --no-renames \
    --no-ext-diff --no-textconv --no-color --submodule=short \
    --ignore-submodules=none --src-prefix=a/ --dst-prefix=b/ \
    "$from" "$to" -- "$@" >"$file"
}

# Undo sync_preserve_dirty's gitlink staging after a fast-forward that did not
# happen. It reads the caller's prestaged_paths and prestaged_befores arrays.
# Each entry is put back with `git apply --cached -R` of that path's
# BEFORE..TARGET patch: Git takes the index lock, then checks that the entry
# still names TARGET, then writes, so an entry that anything else changed
# meanwhile is left alone rather than overwritten. It is attempted only while
# HEAD is still BEFORE; HEAD is read once, before the first attempt, and a HEAD
# move after that read is not detected. An entry left alone is named on
# stderr. Every command is guarded so that this cleanup cannot itself abort
# before the caller's explanation.
restore_prestaged_gitlinks() {
  local root=$1 before=$2 target=$3 head entry i path patch restored
  head=$(git -C "$root" rev-parse HEAD 2>/dev/null) || head=unreadable
  patch=$(mktemp "${TMPDIR:-/tmp}/parent-main-sync-gitlink.XXXXXX" 2>/dev/null) || patch=
  for ((i = 0; i < ${#prestaged_paths[@]}; i++)); do
    path=${prestaged_paths[$i]}
    restored=0
    if [ "$head" = "$before" ] && [ -n "$patch" ] &&
       write_gitlink_patch "$root" "$before" "$target" "$patch" "$path" 2>/dev/null &&
       git -C "$root" apply --cached -R --whitespace=nowarn "$patch"; then
      restored=1
    fi
    entry=$(git --literal-pathspecs -C "$root" ls-files --stage -- "$path" 2>/dev/null |
      awk '{ print $1, $2, $3 }') || entry=unreadable
    if [ "$restored" = 1 ]; then
      printf 'PARENT_MAIN_WRITE sync gitlink-unstaged path=%q index=%s\n' \
        "$path" "${prestaged_befores[$i]}" >&2
    elif [ "$head" = "$before" ]; then
      printf 'PARENT_MAIN_WRITE sync gitlink-left-staged path=%q index=%q head=%s; the entry no longer named the target this run staged, or the index could not be locked; if this run staged it, restore with: git -C %q update-index --cacheinfo %q\n' \
        "$path" "$entry" "$head" "$root" "160000,${prestaged_befores[$i]},$path" >&2
    else
      printf 'PARENT_MAIN_WRITE sync gitlink-left-staged path=%q index=%q head=%s before=%s; HEAD moved, so the entry was not restored\n' \
        "$path" "$entry" "$head" "$before" >&2
    fi
  done
  if [ -n "$patch" ]; then rm -f "$patch" 2>/dev/null || true; fi
}

# The operational tick may advance the shared parent around dirty paths only
# when the exact fetched change is disjoint from them, or when an overlapping
# gitlink is one that the fast-forward cannot overwrite: nothing about it is
# staged and its path is a real directory, or its checkout is already at the
# fetched target (see gitlink_overlap_preservable). It has no authority to
# decide that local bytes are expendable. This is deliberately narrower than
# ordinary `sync` and `sync --automatic`: it never calls the published-residue
# classifier and therefore cannot adopt, stage, stash, discard, reset, or
# reconcile work.
sync_preserve_dirty() {
  local root=$1 before target after path_dir incoming dirty incoming_cmp dirty_cmp overlap
  local preserved_gitlinks=0 gitlink_overlap_state gitlink_overlap_checkout gitlink_overlap_target
  local gitlink_overlap_before gitlink_overlap_index prestage_patch
  local -a incoming_paths=() dirty_paths=() prestaged_paths=() prestaged_befores=()
  before=$(git -C "$root" rev-parse HEAD) ||
    die "sync --preserve-dirty could not read HEAD; nothing was modified"
  target=$HERMIT_PARENT_MAIN_EXPECT

  if [ "$before" = "$target" ]; then
    printf 'PARENT_MAIN_WRITE sync state=already-current before=%s after=%s target=%s preserve-dirty=1\n' \
      "$before" "$before" "$target"
    return 0
  fi

  if ! git -C "$root" merge-base --is-ancestor "$before" "$target"; then
    die "sync --preserve-dirty requires a fast-forward (before=$before after=$before target=$target); local main diverges from origin/main and nothing was modified"
  fi

  # Use NUL-delimited path lists throughout: a newline is legal in a Git path,
  # and a safety decision may not depend on Git's display quoting. Disable rename
  # detection so both the removed and added names participate in the overlap
  # check. Override ignoreSubmodules so a moved or dirty gitlink is never hidden
  # by local configuration.
  path_dir=$(mktemp -d "${TMPDIR:-/tmp}/parent-main-sync-paths.XXXXXX") ||
    die "sync --preserve-dirty could not allocate path-list storage; nothing was modified"
  if ! git -C "$root" diff --name-only --no-renames --ignore-submodules=none -z >"$path_dir/worktree" ||
     ! git -C "$root" diff --cached --name-only --no-renames --ignore-submodules=none -z >"$path_dir/index" ||
     ! git -C "$root" ls-files --others --exclude-standard -z >"$path_dir/untracked" ||
     ! git -C "$root" ls-files --others --ignored --exclude-standard --directory -z >"$path_dir/ignored" ||
     ! git -C "$root" diff --name-only --no-renames --ignore-submodules=none -z "$before" "$target" >"$path_dir/incoming" ||
     ! LC_ALL=C sort -zu "$path_dir/worktree" "$path_dir/index" "$path_dir/untracked" "$path_dir/ignored" >"$path_dir/dirty"; then
    rm -f "$path_dir/worktree" "$path_dir/index" "$path_dir/untracked" "$path_dir/ignored" "$path_dir/incoming" "$path_dir/dirty"
    rmdir "$path_dir" 2>/dev/null || true
    die "sync --preserve-dirty could not compare incoming and dirty paths (before=$before after=$before target=$target); nothing was modified"
  fi
  mapfile -d '' -t incoming_paths <"$path_dir/incoming"
  mapfile -d '' -t dirty_paths <"$path_dir/dirty"
  rm -f "$path_dir/worktree" "$path_dir/index" "$path_dir/untracked" "$path_dir/ignored" "$path_dir/incoming" "$path_dir/dirty"
  rmdir "$path_dir" 2>/dev/null || true

  overlap=0
  for incoming in "${incoming_paths[@]}"; do
    incoming_cmp=${incoming%/}
    for dirty in "${dirty_paths[@]}"; do
      # `git ls-files --others` reports an embedded untracked repository as a
      # directory name ending in slash. Normalize only for comparison so an
      # incoming child of that directory is still recognized as overlapping;
      # retain the exact Git-reported spelling in the refusal below.
      dirty_cmp=${dirty%/}
      if [ "$incoming_cmp" = "$dirty_cmp" ] ||
         [[ "$incoming_cmp" == "$dirty_cmp/"* ]] ||
         [[ "$dirty_cmp" == "$incoming_cmp/"* ]]; then
        if [ "$incoming_cmp" = "$dirty_cmp" ] &&
           gitlink_overlap_preservable "$root" "$before" "$target" "$incoming_cmp"; then
          printf 'PARENT_MAIN_WRITE sync gitlink-drift path=%q checkout=%s target=%s state=%s\n' \
            "$incoming" "$gitlink_overlap_checkout" "$gitlink_overlap_target" "$gitlink_overlap_state" >&2
          preserved_gitlinks=$((preserved_gitlinks + 1))
          if [ "$gitlink_overlap_index" = "$gitlink_overlap_before" ]; then
            prestaged_paths+=("$incoming_cmp")
            prestaged_befores+=("$gitlink_overlap_before")
          fi
          continue
        fi
        if [ "$overlap" = 0 ]; then
          printf 'PARENT_MAIN_WRITE sync state=skipped reason=path-overlap before=%s after=%s target=%s blocking-paths:\n' \
            "$before" "$before" "$target" >&2
        fi
        printf '  incoming=%q dirty=%q\n' "$incoming" "$dirty" >&2
        overlap=$((overlap + 1))
      fi
    done
  done
  if [ "$overlap" -ne 0 ]; then
    die "sync --preserve-dirty found $overlap incoming/dirty path overlap(s) (before=$before after=$before target=$target); nothing was modified"
  fi

  # Merge the fetched commit object, not the mutable tracking-ref name. Another
  # process may fetch after our check; that must not silently change the target
  # between the ancestry proof and the ref update. Git performs its own final
  # overwrite check, including ignored paths that become dirty after our
  # comparison (plain `git merge` overwrites ignored files by default).
  #
  # First stage every accepted gitlink whose index entry still equals HEAD at
  # its fetched target. With the index entry already equal to the new tree,
  # unpack-trees keeps the entry and never checks out the path, so whatever is
  # at the path when the merge runs is left alone, including anything that
  # replaced the nested checkout after the classification above. Without this,
  # the merge checks out such a gitlink and, for a non-directory at its path,
  # unlinks a regular file or replaces a symlink with an empty directory
  # (measured with git 2.53 on 2026-10-01). After a successful fast-forward the
  # staged entry equals the new HEAD, so nothing is left staged.
  #
  # The staging is one `git apply --cached` of the BEFORE..TARGET patch for
  # exactly those paths. Git takes the index lock before it reads the index,
  # checks every entry against the patch's preimage, and writes all of them or
  # none (measured with strace and a concurrently staged entry on git 2.53,
  # 2026-10-01). So a gitlink that anything else staged after the overlap check
  # makes the whole sync refuse with the index untouched, instead of being
  # overwritten. An unconditional `update-index --cacheinfo` here erased such
  # staging and then reported success.
  #
  # From a successful apply until the merge returns, every command is guarded:
  # the index has been changed, so the generic abort banner ("nothing was
  # modified") would be false. A failed merge restores the entries. A kill
  # inside this window leaves a gitlink staged at its target; the next run then
  # refuses it as a staged gitlink (unless its checkout is already at the
  # target), and the nested checkout is never touched.
  #
  # --no-autostash: with merge.autostash=true, Git stashes the dirty tree,
  # including the staged entry, and resets to HEAD before merging. That reset
  # checks out the gitlink path, which replaced a regular file there with an
  # empty directory and left an unmerged gitlink while the merge still exited
  # 0 (reproduced by adversarial review on 2026-10-01). This mode may not stash
  # local work in any case.
  if [ "${#prestaged_paths[@]}" -ne 0 ]; then
    prestage_patch=$(mktemp "${TMPDIR:-/tmp}/parent-main-sync-gitlinks.XXXXXX") ||
      die "sync --preserve-dirty could not allocate gitlink patch storage (before=$before after=$before target=$target); nothing was modified"
    if ! write_gitlink_patch "$root" "$before" "$target" "$prestage_patch" "${prestaged_paths[@]}"; then
      rm -f "$prestage_patch" 2>/dev/null || true
      die "sync --preserve-dirty could not write the gitlink patch to stage (before=$before after=$before target=$target); nothing was modified"
    fi
    if ! git -C "$root" apply --cached --whitespace=nowarn "$prestage_patch"; then
      rm -f "$prestage_patch" 2>/dev/null || true
      die "sync --preserve-dirty could not stage ${#prestaged_paths[@]} gitlink(s) at their fetched targets (before=$before after=$before target=$target): an index entry changed after the overlap check, or the index could not be locked; git apply --cached writes all entries or none, so HEAD was not moved and nothing was modified"
    fi
    rm -f "$prestage_patch" 2>/dev/null || true
  fi
  if ! git -C "$root" merge --ff-only --no-autostash --no-overwrite-ignore "$target"; then
    after=$(git -C "$root" rev-parse HEAD 2>/dev/null || printf unreadable)
    restore_prestaged_gitlinks "$root" "$before" "$target"
    die "sync --preserve-dirty fast-forward failed (before=$before after=$after target=$target); no adoption, reset, or reconcile was attempted"
  fi
  after=$(git -C "$root" rev-parse HEAD) ||
    die "sync --preserve-dirty advanced the checkout but could not read its new HEAD (before=$before target=$target)"
  [ "$after" = "$target" ] ||
    die "sync --preserve-dirty ended at $after instead of fetched origin/main $target (before=$before)"
  printf 'PARENT_MAIN_WRITE sync state=fast-forwarded before=%s after=%s target=%s preserve-dirty=1 incoming=%s dirty=%s overlap=0 gitlink-drift=%s\n' \
    "$before" "$after" "$target" "${#incoming_paths[@]}" "${#dirty_paths[@]}" "$preserved_gitlinks"
}

attribution_checker() {
  local root=$1 checker="$1/scripts/check_commit_attribution.py"
  [ -x "$checker" ] || die "machine-attribution checker is missing: $checker"
  printf '%s\n' "$checker"
}

verify_proposed_attribution() {
  local root=$1 message=$2 checker
  checker=$(attribution_checker "$root")
  if ! printf '%s\n' "$message" |
      "$checker" --stdin --expected-machine auto --quiet; then
    die "commit message lacks this machine's canonical final attribution line"
  fi
}

verify_published_attribution() {
  local root=$1 base=$2 source=$3 checker
  checker=$(attribution_checker "$root")
  if ! "$checker" --repo "$root" --range "$base..$source"; then
    die "publication contains a commit without canonical machine attribution"
  fi
}

is_sensitive_path() {
  # agent-utils remains sensitive because changing the parent symlink changes
  # which shared tooling path callers execute; it is not a parent gitlink.
  case "$1" in
    hermit|reverie|liteinst2|agent-utils|.githooks/*|scripts/parent-main-write|scripts/setup-hooks.sh)
      return 0 ;;
    *) return 1 ;;
  esac
}

range_has_sensitive_path() {
  local root=$1 old=$2 new=$3 path
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    is_sensitive_path "$path" && return 0
  done < <(git -C "$root" diff --name-only "$old" "$new" --)
  return 1
}

verify_audit_receipt() {
  local root=$1 base=$2 commit=$3 message reason
  [ "${HERMIT_PARENT_MAIN_MODE:-}" = audited ] ||
    die "gitlink/hook writes require --audit-reason"
  reason=${HERMIT_PARENT_MAIN_AUDIT_REASON:-}
  [ -n "$reason" ] || die "audited mode requires a non-empty reason"
  message=$(git -C "$root" log -1 --format=%B "$commit")
  grep -Fqx 'Parent-Main-Write-Mode: audited' <<<"$message" ||
    die "audited commit $commit lacks Parent-Main-Write-Mode trailer"
  grep -Fqx "Parent-Main-Write-Reason: $reason" <<<"$message" ||
    die "audited commit $commit does not retain this audit reason"
  grep -Fqx "Parent-Main-Write-Base: $base" <<<"$message" ||
    die "audited commit $commit is not bound to fetched base $base"
}

# THE RECEIPT IS A REF, NOT AN ENVIRONMENT VARIABLE.
#
# `HERMIT_PARENT_MAIN_EXPECT` is set by `fetch_expected` from the ref that the
# fetch just wrote, and every verify-* entry point trusted the variable. But
# hooks inherit the caller's environment, so what the hook read as "the freshly
# fetched origin/main" was whatever the caller said it was. Demonstrated by the
# cross-model review, 2026-08-10: holding the writer lock and exporting an
# arbitrary LOCAL commit as EXPECT, a hooked `update-ref` accepted that commit as
# the target -- `local_main=bc910c31 origin_main=7f673b18 arbitrary=bc910c31`.
# The predicate was being re-derived honestly while the TARGET it was derived
# against was caller-supplied, which is the same defect one level down.
#
# So the hook now reads `refs/remotes/origin/main` itself and requires the
# variable to AGREE with it. The variable survives only as a cross-check that the
# ref did not move under the operation; the authority is the ref that `git fetch`
# wrote. This binds every mode at once -- ordinary, audited, sync, reconcile --
# because a forged base is a forged base whichever arm consumes it.
#
# EXACTLY WHAT THIS GUARANTEES, AND EXACTLY WHAT IT DOES NOT.
#
# GUARANTEES: the target equals this checkout's `refs/remotes/origin/main` at the
# instant the ref transaction runs. That is a real binding and it is what catches
# both a forged EXPECT and a tracking ref that moves mid-operation.
#
# DOES NOT GUARANTEE FRESHNESS. A tracking ref only records what the LAST fetch
# saw. Demonstrated by the cross-model review, 2026-08-10, with no rewrite at all
# -- just a remote that moved and a checkout that did not re-fetch:
# `tracking 412cccd  actual_remote 11bcf115  stale True`, accepted by sync,
# ordinary, audited and reconcile alike. Every mode calls `fetch_expected` first,
# so the ordinary path is fresh in practice; the HOOK simply cannot prove it, and
# "in practice" is not a guarantee. Nor is it a complete answer to a local
# process, which could rewrite `refs/remotes/origin/main` directly --
# `refs/remotes/*` is outside the shared-branch guard.
#
# WHY THAT RESIDUAL IS TOLERATED HERE, mode by mode, rather than paid for with a
# network round trip on every commit:
#   * ordinary / audited -- a stale base makes the eventual PUSH fail, because
#     `verify_push` requires the REMOTE's own reported old value to equal the
#     receipt and the remote itself rejects a non-fast-forward. The remote is the
#     authority and it is consulted.
#   * sync -- the move must be a fast-forward, so a stale target only means
#     "less far forward than it could be". Harmless and self-correcting.
#   * reconcile -- moves main to a NON-DESCENDANT, so a stale target is the one
#     case that does real damage. It therefore pays for the round trip: see
#     `remote_main_now` and the reconcile arm of `verify_ref`.
verify_context() {
  local root=${1:?repo root required} expected=${HERMIT_PARENT_MAIN_EXPECT:-} fetched
  verify_lock
  [[ "$expected" =~ ^[0-9a-f]{40}$ ]] || die "missing fetched-origin CAS receipt"
  fetched=$(git -C "$root" rev-parse --verify --quiet 'refs/remotes/origin/main^{commit}' || true)
  [ -n "$fetched" ] ||
    die "no refs/remotes/origin/main to bind the CAS receipt to; fetch first"
  [ "$expected" = "$fetched" ] ||
    die "the fetched-origin receipt does not match refs/remotes/origin/main
  (receipt=$expected refs/remotes/origin/main=$fetched). The receipt is a
  cross-check on the ref, never a substitute for it: an environment variable
  the caller sets cannot establish what origin/main is."
  printf '%s\n' "$expected"
}

# Ask the REMOTE what its main is, right now, over the network.
#
# The only way to prove freshness is to consult the authority: a tracking ref
# says what the last fetch saw, which is a different claim. `ls-remote` reads and
# writes nothing, so unlike a fetch it is safe to call from inside an open ref
# transaction -- there is no nested transaction to re-enter.
#
# BOUNDED AND FAIL-CLOSED. This runs while git holds the lock on
# refs/heads/main, so an unbounded call would hold that lock for as long as the
# network hangs. On timeout, error, or an unparsable answer the caller REFUSES:
# an unproven target is not a fresh target.
REMOTE_PROBE_TIMEOUT=${HERMIT_PARENT_MAIN_REMOTE_PROBE_TIMEOUT:-60}
remote_main_now() {
  local root=$1 url out
  url=$(git -C "$root" remote get-url origin 2>/dev/null || true)
  [ -n "$url" ] || return 1
  if [ "${HERMIT_PARENT_MAIN_NO_PROXY:-}" = 1 ] ||
     [ "${url#/}" != "$url" ] || [ "${url#file://}" != "$url" ] ||
     ! command -v with-proxy >/dev/null 2>&1; then
    out=$(timeout "$REMOTE_PROBE_TIMEOUT" git -C "$root" ls-remote origin refs/heads/main 2>/dev/null) || return 1
  else
    out=$(timeout "$REMOTE_PROBE_TIMEOUT" with-proxy git -C "$root" ls-remote origin refs/heads/main 2>/dev/null) || return 1
  fi
  printf '%s\n' "$out" | awk '$2 == "refs/heads/main" { print $1; exit }'
}

verify_commit() {
  local root branch head expected path sensitive=0
  root=$(repo_root)
  branch=$(git -C "$root" branch --show-current)
  [ "$branch" = main ] || return 0
  expected=$(verify_context "$root")
  head=$(git -C "$root" rev-parse HEAD)
  [ "$head" = "$expected" ] ||
    die "ordinary main commit is stale (HEAD=$head fetched-origin=$expected)"
  while IFS= read -r path; do
    is_sensitive_path "$path" && sensitive=1
  done < <(git -C "$root" diff --cached --name-only --)
  if [ "$sensitive" -eq 1 ] && [ "${HERMIT_PARENT_MAIN_MODE:-}" != audited ]; then
    die "gitlink/hook commit requires the retained --audit-reason path"
  fi
}

# ---------------------------------------------------------------------------
# THE RECONCILE PREDICATE: may refs/heads/main leave OLD behind for NEW?
#
# THE STATE THIS EXISTS FOR (live parent, 2026-08-09). Local main held one
# commit, c7a05a1. `parent-main-write commit` had built it, then its own
# publish_sha LOST A PUSH RACE, and the content was later published under a
# REBUILT sha. So the patch was upstream while the commit object was stranded,
# and every sanctioned route was shut: `sync` requires HEAD to be an ancestor of
# origin/main; `verify_ref` in sync mode requires the same; in ordinary/audited
# mode it requires old == fetched-origin; and `git rebase origin/main` computes
# the right answer but its own final ref update is refused by this very hook,
# leaving a half-finished rebase. `documented_commands.py --closeout` then
# refused for EVERY agent in the workspace over a commit none of them made.
#
# WHAT IS ACTUALLY AT STAKE. Moving main from OLD to NEW loses exactly the
# commits in NEW..OLD. So the predicate is: every one of those commits is
# already applied upstream. Patch equivalence is git's own answer to that
# question -- it is what makes `git rebase` drop a duplicate -- so this uses it,
# but it does NOT use `git cherry`.
#
# WHY NOT `git cherry`, WHICH IS THE OBVIOUS TOOL. `git cherry` SILENTLY OMITS
# MERGE COMMITS. Measured on git 2.53: a range whose `rev-list` is
# {770f725 merge, 038cf80, 1938fc5, 9464153} printed exactly three lines and the
# merge was not among them. "No line starts with +" is therefore NOT "nothing is
# lost" -- an evil merge, whose conflict resolution exists in neither parent,
# passes that test while carrying content no upstream commit has. Empty commits
# are the same shape from the other side.
#
# So the range is enumerated with `rev-list` (which hides nothing) and each
# commit must be POSITIVELY matched to a NAMED upstream commit by patch id. A
# commit with no patch id -- a merge, or an empty diff -- is unprovable by this
# method and is therefore REFUSED, not skipped. Fail-closed is the whole point:
# absence of a patch id is absence of evidence, never evidence of absence.
#
# PATCH-ID ALONE IS NOT ENOUGH, AND IS NOT THE AUTHORITY HERE.
#
# `git patch-id` deliberately normalises away whitespace AND line positions, so
# two genuinely different changes can share one id: the same added text at a
# different call site in the same file, or the same text differing only in
# indentation. Worse, an id is not a pairing -- N local commits can all "match"
# ONE upstream commit and every one of them counts as proven.
#
# So patch-id is used only as a cheap PREFILTER, and the proof is a STRICT DIFF
# DIGEST plus an INJECTIVE pairing:
#
#   * STRICT: the digest hashes `diff-tree -p --full-index --binary` verbatim --
#     every added, removed and context line byte-for-byte, INCLUDING whitespace,
#     plus file names, modes, rename headers and binary payloads. Only two things
#     are normalised away, and only because a faithful republish must change
#     them: the `index <old>..<new>` blob line, and the NUMBERS in the `@@ -a,b
#     +c,d @@` hunk header. Line positions may therefore shift, but the context
#     lines around every hunk may not -- which is what distinguishes "the same
#     change, rebased" from "the same text somewhere else".
#   * INJECTIVE: each upstream commit is CONSUMED by at most one local commit, so
#     three local commits cannot all be discharged by one upstream commit.
#
# Verified against the real case this mode was built for: the stranded c7a05a16
# and its rebuilt twin d9f5508b, published from a different base, have identical
# strict digests (494bfe22...). The strictness costs nothing on a genuine
# republish and refuses the coincidences patch-id would have accepted.
#
# A commit with NO diff at all -- a merge, or an empty commit -- has no digest,
# is unprovable by this method, and is REFUSED rather than skipped. Fail-closed
# is the whole point: absence of a patch is absence of evidence.
#
# NOTHING IS DESTROYED EITHER WAY. The old tip stays in the reflog and in the
# object store; the printed old= sha is the recovery handle.
RECONCILE_DROPPED=0
RECONCILE_PROVEN=0
RECONCILE_EVIDENCE=''
patch_id_pairs() {
  # "<patch-id> <commit>" for every commit in RANGE THAT HAS A DIFF. Merges
  # print no diff through `diff-tree --stdin -p` and empty commits have none, so
  # both are simply ABSENT here -- which the caller treats as unproven.
  local root=$1 range=$2
  git -C "$root" rev-list "$range" |
    git -C "$root" diff-tree --stdin -p |
    git -C "$root" patch-id --stable
}

# Print the strict digest of COMMIT's diff, or return 1 if it has no diff.
#
# Written through a FILE, not a `$(...)`: command substitution strips trailing
# newlines, and a digest that cannot see trailing whitespace is not the
# whitespace-preserving digest this claims to be.
strict_diff_digest() {
  local root=$1 commit=$2 scratch=$3
  # Each stage guarded: `grep -v`/`sed` exit non-zero on empty input, and under
  # `set -e -o pipefail` that would abort the script mid-proof -- silently.
  git -C "$root" diff-tree -p --no-commit-id --full-index --binary "$commit" \
    | { grep -v '^index [0-9a-f]*\.\.[0-9a-f]*' || true; } \
    | { sed -E 's/^@@ -[0-9]+(,[0-9]+)? \+[0-9]+(,[0-9]+)? @@/@@/' || true; } \
    >"$scratch"
  [ -s "$scratch" ] || return 1
  git -C "$root" hash-object --stdin <"$scratch"
}

verify_reconcile_is_lossless() {
  local root=$1 old=$2 new=$3
  local tmp sha id match near taken reason subject digest dropped=0 proven=0 unproven='' evidence=''
  RECONCILE_DROPPED=0
  RECONCILE_PROVEN=0
  RECONCILE_EVIDENCE=''
  if [ "$old" = "$new" ]; then return 0; fi
  # An empty NEW..OLD range: nothing is left behind, so nothing can be lost.
  # This is an ordinary fast-forward and is allowed for the same reason `sync`
  # allows it -- stated explicitly rather than falling out of a vacuous loop.
  if git -C "$root" merge-base --is-ancestor "$old" "$new"; then
    RECONCILE_EVIDENCE="  fast-forward: NEW..OLD is empty, no commit is left behind"$'\n'
    return 0
  fi
  tmp=$(mktemp -d) || die "cannot create a scratch directory for the reconcile scan"
  # Oldest first, so the pairing consumes upstream commits in replay order and
  # the evidence reads in the order the work happened.
  git -C "$root" rev-list --reverse "$new..$old" >"$tmp/left-behind"
  patch_id_pairs "$root" "$new..$old" >"$tmp/local-ids"
  patch_id_pairs "$root" "$old..$new" >"$tmp/upstream-ids"
  : >"$tmp/consumed"
  while IFS= read -r sha; do
    [ -n "$sha" ] || continue
    dropped=$((dropped + 1))
    subject=$(git -C "$root" log -1 --format=%s "$sha")
    id=$(awk -v c="$sha" '$2 == c { print $1; exit }' "$tmp/local-ids")
    digest=''
    if strict_diff_digest "$root" "$sha" "$tmp/scratch" >"$tmp/digest"; then
      digest=$(cat "$tmp/digest")
    fi
    match=''
    taken=''
    near=''
    if [ -n "$digest" ]; then
      # Prefilter by patch-id, then require a BYTE-EXACT strict digest, and
      # never reuse an upstream commit another local commit already consumed.
      while IFS= read -r candidate; do
        [ -n "$candidate" ] || continue
        if grep -Fqx "$candidate" "$tmp/consumed"; then taken=$candidate; continue; fi
        if strict_diff_digest "$root" "$candidate" "$tmp/scratch" >"$tmp/cand-digest" &&
           [ "$(cat "$tmp/cand-digest")" = "$digest" ]; then
          match=$candidate
          break
        fi
        # Same patch-id, different bytes: exactly what patch-id alone would
        # have accepted. Remember it so the refusal can say so.
        near=$candidate
      done < <(awk -v p="$id" '$1 == p { print $2 }' "$tmp/upstream-ids")
    fi
    if [ -n "$match" ]; then
      proven=$((proven + 1))
      printf '%s\n' "$match" >>"$tmp/consumed"
      evidence+="  ${sha:0:12} $subject"$'\n'
      evidence+="      is already upstream as ${match:0:12} $(git -C "$root" log -1 --format=%s "$match")"$'\n'
      evidence+="      strict diff digest ${digest} (byte-exact, one-to-one)"$'\n'
    else
      if [ -z "$digest" ]; then
        reason="has NO comparable patch -- a merge commit or an empty commit. Patch
      equivalence cannot speak for it, so it is refused rather than skipped."
      elif [ -n "$taken" ]; then
        reason="matches upstream ${taken:0:12}, but an EARLIER local commit already
      claimed it. One upstream commit discharges at most ONE local commit;
      applying the same change twice locally is not the same as it being
      upstream twice."
      elif [ -n "$near" ]; then
        reason="matches upstream ${near:0:12} by patch-id but NOT byte-for-byte:
      whitespace, hunk context or file structure differs, so this is a
      DIFFERENT change that patch-id alone would have accepted."
      elif [ -n "$id" ]; then
        reason="carries a patch no upstream commit has (patch-id $id)."
      else
        reason="carries a patch no upstream commit has."
      fi
      unproven+="  ${sha:0:12} $subject"$'\n'
      unproven+="      $reason"$'\n'
    fi
  done <"$tmp/left-behind"
  rm -rf "$tmp"
  if [ -n "$unproven" ]; then
    printf '%s' "$unproven" >&2
    die "moving main from $old to $new would DROP the commit(s) above, and this
  tool cannot prove their content is already upstream. Nothing was moved.
  Publish them instead -- \`parent-main-write publish <sha>\` rebased onto
  freshly fetched origin/main -- or, if they really are obsolete, say so by
  publishing an explicit revert. reconcile only ever drops a commit whose diff
  it can match BYTE-FOR-BYTE against its own NAMED upstream commit."
  fi
  RECONCILE_DROPPED=$dropped
  RECONCILE_PROVEN=$proven
  RECONCILE_EVIDENCE=$evidence
}

verify_ref() {
  local old=${1:?old SHA required} new=${2:?new SHA required} root expected mode remote_now
  root=$(repo_root)
  expected=$(verify_context "$root")
  mode=${HERMIT_PARENT_MAIN_MODE:-}
  case "$mode" in
    sync)
      [ "$new" = "$expected" ] || die "sync target $new is not fetched origin $expected"
      git -C "$root" merge-base --is-ancestor "$old" "$new" ||
        die "sync is not a fast-forward"
      ;;
    reconcile)
      [ "$new" = "$expected" ] ||
        die "reconcile target $new is not fetched origin $expected"
      # PROVE FRESHNESS AGAINST THE REMOTE ITSELF, not against a tracking ref.
      #
      # This is the only mode that moves main to a NON-DESCENDANT, so it is the
      # only mode where a target that is merely "what the last fetch saw" does
      # real damage -- and the only one that pays a network round trip for it.
      # The other three are covered by the remote's own push CAS or by requiring
      # a fast-forward; see the boundary statement above `verify_context`.
      #
      # Refusing on an unreadable remote is deliberate: reconcile already
      # required the network to fetch its target, so an unprovable target here
      # means retry, not proceed.
      remote_now=$(remote_main_now "$root") ||
        die "cannot read origin's current main, so the target cannot be proven
  fresh. Nothing was moved. reconcile needs the network; retry when it is back."
      [[ "$remote_now" =~ ^[0-9a-f]{40}$ ]] ||
        die "origin did not report a usable refs/heads/main; nothing was moved"
      [ "$new" = "$remote_now" ] ||
        die "reconcile target $new is NOT origin's current main $remote_now.
  A tracking ref records what the last fetch saw; origin has moved since. Re-run
  reconcile so it retargets the commit origin actually has. Nothing was moved."
      # RE-DERIVED HERE, from the transaction's OWN old and new. The caller
      # already ran this check before mutating anything, and that run is not
      # evidence: an environment variable the caller sets cannot authorise a ref
      # update, and this hook is the enforcement point that a bare `git update-
      # ref`, `git reset`, or `git rebase` also has to pass.
      verify_reconcile_is_lossless "$root" "$old" "$new"
      # NO AUDIT RECEIPT IS REQUIRED, and that is not an omission. The
      # ordinary/audited arms demand one when the range touches a sensitive path
      # because that range is NEW CONTENT being published. Here the range
      # old..new is origin/main's ALREADY-PUBLISHED history, which passed that
      # gate when it landed; demanding a second receipt to adopt it locally
      # would gate reading, not writing. `sync` takes the same position.
      ;;
    ordinary|audited)
      [ "$old" = "$expected" ] ||
        die "main ref CAS failed (old=$old fetched-origin=$expected)"
      git -C "$root" merge-base --is-ancestor "$old" "$new" ||
        die "main ref update is not a forward append"
      if range_has_sensitive_path "$root" "$old" "$new"; then
        verify_audit_receipt "$root" "$expected" "$new"
      fi
      ;;
    *) die "unknown or missing writer mode '$mode'" ;;
  esac
}

verify_push() {
  local remote=${1:?remote required} remote_old=${2:?remote old required} new=${3:?new required}
  local root expected
  root=$(repo_root)
  [ "$remote" = origin ] || die "parent main may be published only to remote 'origin'"
  [ "$remote_old" != "$ZERO" ] || die "refusing to create a missing remote main"
  expected=$(verify_context "$root")
  [ "$remote_old" = "$expected" ] ||
    die "remote main moved after fetch (remote=$remote_old fetched-origin=$expected)"
  git -C "$root" merge-base --is-ancestor "$remote_old" "$new" ||
    die "remote main update is not a fast-forward"
  if range_has_sensitive_path "$root" "$remote_old" "$new"; then
    verify_audit_receipt "$root" "$expected" "$new"
  fi
}

# Refuse a publication that would drop a line main already has, from a region the
# author never touched.
#
# THE FAILURE THIS EXISTS FOR (near-miss, 2026-08-08): an agent read a shared file,
# edited one field, and its content was later committed onto a NEWER base. The
# commit then carried two hunks -- the authored one, and a silent reversion of
# everything that landed in that file meanwhile. The second hunk is invisible in a
# diff against the base the author read, which is the diff every review habit
# looks at; it only appears against origin/main. Nobody was careless.
#
# MEASURED, so the guard fires on the right thing: committing on a stale base and
# REBASING is safe -- git replays only the authored diff, and the colleague's line
# survives. The dangerous move is committing stale CONTENT onto a current BASE
# (transplanting a file between trees, or regenerating one from a stale read).
# So this must key on content lineage, not on tree staleness; keying on staleness
# would cry wolf on the safe-and-common case and be ignored within a day.
#
# THE TEST: for each changed file, replay main's own A..tip changes into the
# SUBMITTED content using an older main version A as base. A CLEAN merge that
# still changes the submission means the submission is missing work that landed
# and that the author never touched -- an unauthored reversion. A CONFLICTING
# merge means the author did edit that region, which is a real edit and is
# allowed through.
REVERT_SCAN_DEPTH=${HERMIT_PARENT_MAIN_REVERT_SCAN_DEPTH:-20}
refuse_unauthored_reverts() {
  local root=$1 expected=$2 source=$3
  # NB: written as `if`, not `[ ... ] && ...`. Under `set -e` a false `[ ]` in an
  # && list aborts the whole script, which would make this guard fail SILENTLY --
  # the exact failure mode it exists to prevent.
  if [ "${HERMIT_PARENT_MAIN_ALLOW_REVERT:-0}" = 1 ]; then
    echo "parent-main-write: reversion guard DISABLED by HERMIT_PARENT_MAIN_ALLOW_REVERT=1" >&2
    return 0
  fi
  local tmp file base scanned truncated=0 findings=0 report=""
  tmp=$(mktemp -d) || die "cannot create a scratch directory for the reversion scan"
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    git -C "$root" show "$expected:$file" >"$tmp/ours" 2>/dev/null || continue
    git -C "$root" show "$source:$file"  >"$tmp/theirs" 2>/dev/null || continue
    if cmp -s "$tmp/ours" "$tmp/theirs"; then continue; fi
    scanned=0
    while IFS= read -r base; do
      scanned=$((scanned + 1))
      git -C "$root" show "$base:$file" >"$tmp/base" 2>/dev/null || continue
      # Main did not move this file between A and tip: nothing could be dropped.
      if cmp -s "$tmp/base" "$tmp/ours"; then continue; fi
      cp "$tmp/theirs" "$tmp/probe"
      if git merge-file -q -p "$tmp/probe" "$tmp/base" "$tmp/ours" >"$tmp/merged" 2>/dev/null; then
        # merged != theirs is NOT sufficient. Two independent insertions at the
        # same place (main appended a class; the author appended another) merge
        # cleanly into a DIFFERENT file without anything being dropped -- the
        # merge merely re-inserts what the author already has. Refusing on
        # inequality alone fires on "append to a file main also appended to",
        # which is routine, and a guard that fires on routine work is switched
        # off within a day. Refuse only on content that main has and the
        # submission genuinely LACKS.
        # Every stage guarded: `grep -v` exits 1 when it filters everything out,
        # and under `set -e -o pipefail` that aborts the script mid-classification
        # -- silently, which is the failure mode this whole file exists to avoid.
        lost_lines=$( { diff "$tmp/theirs" "$tmp/merged" 2>/dev/null || true; } \
          | { sed -n 's/^> //p' || true; } \
          | { grep -v '^[[:space:]]*$' || true; } \
          | while IFS= read -r line; do
              grep -Fqx -- "$line" "$tmp/theirs" || printf '%s\n' "$line"
            done || true)
        if [ -n "$lost_lines" ]; then
          findings=$((findings + 1))
          report+="  $file: would drop content that landed on main after ${base:0:12}"$'\n'
          # TRUNCATE IN awk, NOT WITH `| head -6` (2026-08-08). `head` closes
          # the pipe after six lines; if `sed` is still writing it dies of
          # SIGPIPE, `pipefail` makes this substitution exit 141, and `set -e`
          # aborts the script -- while building the very message that explains
          # the refusal. It was SIZE-DEPENDENT, so the message went missing
          # exactly when there was most to say: measured, 55 lost lines reported
          # fine and 4995 aborted with no output at all. awk reads the whole
          # stream and caps its own output, so no reader closes the pipe early.
          report+=$(printf '%s\n' "$lost_lines" \
            | awk '{ if (++n <= 6) print "      LOST: " $0 }
                   END { if (n > 6) printf "      ... and %d more lost line(s)\n", n - 6 }' \
            )$'\n'
          break
        fi
      fi
    done < <(git -C "$root" rev-list --max-count="$REVERT_SCAN_DEPTH" "$expected" -- "$file")
    if [ "$scanned" -ge "$REVERT_SCAN_DEPTH" ]; then truncated=1; fi
  done < <(git -C "$root" diff --name-only "$expected" "$source" -- 2>/dev/null)
  rm -rf "$tmp"
  # No silent caps: say so when the scan window bounded the search.
  if [ "$truncated" = 1 ]; then
    echo "parent-main-write: note: reversion scan bounded to $REVERT_SCAN_DEPTH commits per file" >&2
  fi
  if [ "$findings" -gt 0 ]; then
    printf '%s\n' "$report" >&2
    die "publication would revert landed work in $findings file(s) that the author did not edit.
  Your own diff will look correct -- this hunk is only visible against origin/main.
  Fix by REBASING rather than transplanting content: re-read the file from
  origin/main, re-apply your change, and publish that.
  If the reversion is deliberate, re-run with HERMIT_PARENT_MAIN_ALLOW_REVERT=1."
  fi
}

# Name the newest commit reachable from TARGET whose version of PATH is
# byte-identical to the copy on disk, or print nothing.
#
# DIAGNOSTIC ONLY. IT AUTHORISES NOTHING, and an earlier version of this file
# had it authorise a refresh -- which is the defect the cross-model review found
# on 2026-08-10 and the reason for the warning in this comment.
#
# Reproduced: an agent mid-edit on a tracked file whose in-progress bytes
# happened to equal a version published earlier (V2, while the target was V3).
# `sync` refused and left the edit alone; `reconcile` overwrote it with V3 and
# reported a clean tree. Byte-coincidence with history is not consent to discard
# an edit in progress, and it cannot be: the test cannot tell "a stale leftover
# somebody checked out" from "work that happens to look like an old version".
#
# The distinction that DOES hold, and the one adoption rests on: adopting a path
# whose disk bytes equal the TARGET moves zero bytes on disk. Refreshing a path
# whose disk bytes equal an ANCESTOR overwrites the disk. Those are different
# acts and only the first is authorised by byte equality. Git's own two-way
# merge overwrites a path only when it is CLEAN against the index -- cleanliness
# is the consent, and a superseded copy is by construction not clean.
#
# So this now only makes the refusal ACTIONABLE: it names the commit that still
# holds the bytes, so the path's owner can decide. The tool never decides.
SUPERSEDED_SCAN_DEPTH=${HERMIT_PARENT_MAIN_SUPERSEDED_SCAN_DEPTH:-60}
published_at_commit() {
  local root=$1 target=$2 path=$3 disk commit blob
  disk=$(git -C "$root" hash-object -- "$root/$path" 2>/dev/null) || return 0
  [ -n "$disk" ] || return 0
  while IFS= read -r commit; do
    [ -n "$commit" ] || continue
    blob=$(git -C "$root" rev-parse "$commit:$path" 2>/dev/null) || continue
    if [ "$blob" = "$disk" ]; then printf '%s\n' "$commit"; return 0; fi
  done < <(git -C "$root" rev-list --max-count="$SUPERSEDED_SCAN_DEPTH" "$target" -- "$path")
  return 0
}

# Adopt working-tree residue that is ALREADY byte-identical to the fetched target.
#
# THE FREEZE THIS EXISTS FOR (2026-08-08): the shared parent sat pinned while
# origin/main advanced six commits, so `commit` refused for every agent -- the
# fleet's only serialized landing path was shut, and the blockage belonged to
# nobody. The cause was ~14 tracked paths and 2 untracked files left by agents
# whose tasks had already CLOSED. Their bytes already matched origin/main.
#
# Git refuses the fast-forward anyway, because it compares the working tree
# against the INDEX, not against the target: "local changes would be overwritten
# by merge" and "untracked working tree files would be overwritten". Both are
# true statements about the index and false statements about the content -- the
# merge would not have changed a single byte on disk.
#
# So the distinction this turns on, the same one the reversion guard turns on:
# a stale index entry for content that is ALREADY PUBLISHED is not somebody's
# uncommitted work. Adopting it destroys nothing, because the bytes on both
# sides are equal -- that equality is checked per path, and it is the ONLY thing
# that authorizes the adoption.
#
# FAIL-CLOSED, ABSOLUTELY: a path whose bytes differ from the target is never
# touched, never staged, and still blocks. This mirrors how `main-green` cleared
# the freeze by hand -- it stopped on a genuinely different ai_docs file and
# waited for its owner rather than reasoning past it.
#
# SUPERSEDED COPIES are REPORTED AND REFUSED, never refreshed, in every mode.
#
# A long-frozen parent grows a residue class this cannot adopt: an on-disk copy
# byte-identical to the path's content at some ANCESTOR of the target rather
# than at the target itself -- published, just not published LAST. On the live
# parent, 10 of 42 differing paths were that shape.
#
# It is tempting, and it was briefly implemented, to refresh those from the
# target on the grounds that the replaced bytes remain recoverable at a named
# commit. That is wrong, and the reproduction is in `published_at_commit` above:
# the same test matches an agent's uncommitted edit that happens to equal an
# older published version, and refreshing silently discards it. `reconcile` must
# never be harsher than `sync`, and refreshing made it exactly that.
#
# TWO PASSES, DELIBERATELY, and now split into two FUNCTIONS. A single pass that
# stages as it goes leaves the index half-adopted when it later hits a blocker --
# the very class of residue this exists to remove, created by the thing removing
# it, on the failure path where nobody is looking. It also made the refusal
# message ("Nothing was staged or modified") a lie. Classify everything first;
# mutate only once the whole set is known to be safe. `reconcile` splits the two
# further apart still, so that its own later gates also run before any mutation.
RESIDUE_PLAN=''
classify_published_residue() {
  # FROM is the tree the working copy currently corresponds to. Normally HEAD --
  # but when completing an INTERRUPTED reconcile the ref has already moved, so
  # HEAD is the target and the only tree that describes the working copy is the
  # recorded `old`. Passing it explicitly is what makes resume possible.
  local root=$1 from=$2 target=$3
  local path mode blob gitlinks=0
  local blockers="" plan="" superseded_at=""
  # Scoped deliberately: an unscoped flag would leak into a later call in the
  # same process and attach the wrong remedy to a clean classification.
  local blocker_modified="" blocker_untracked="" blocker_superseded=""
  RESIDUE_PLAN=''
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    # Not present on disk: the merge simply creates or removes it.
    if [ ! -e "$root/$path" ]; then continue; fi
    # A GITLINK IS NOT WORKING-TREE CONTENT. Decided FIRST and by MODE, because
    # every other test below gives the right answer for the wrong reason:
    #   * `git cat-file -e "$target:$path"` FAILS for a gitlink (rc 1, measured
    #     on the live parent for its product submodules) -- the
    #     submodule's commit object lives in the submodule's own store, not the
    #     superproject's -- so a gitlink used to exit through the arm labelled
    #     "absent from the target tree (a deletion)", which it is not; and
    #   * `git hash-object` CANNOT hash a directory (`fatal: Unable to hash
    #     ./sub`, rc 128, measured), so if that object ever WERE present the
    #     byte-equality test would fail and an advanced gitlink would be
    #     reported as somebody's uncommitted work.
    # Both land on "skip", one by luck and one wrongly; say it on purpose.
    #
    # Skipping is right because the superproject only ever rewrites the INDEX
    # entry: measured 2026-08-10 with HEAD pinning S1, target pinning S2 and the
    # submodule checked out at an unrelated S3, `read-tree -m -u`, `merge
    # --ff-only` and `reset --keep` all advanced the superproject, left the
    # submodule at S3, and left ` M sub` byte-identical before and after. The
    # live parent's `hermit` has exactly that shape: the primary checkout sits
    # ahead of both pins, as the Primary Checkout Invariant requires.
    if [ "$(git -C "$root" ls-tree "$target" -- "$path" | awk '{print $1}')" = 160000 ] &&
       [ "$(git -C "$root" ls-files --stage -- "$path" | awk '{print $1}')" = 160000 ]; then
      gitlinks=$((gitlinks + 1))
      echo "parent-main-write: gitlink $path: index pointer only; the submodule checkout is untouched" >&2
      continue
    fi
    # Absent from the target tree (a deletion): never adopt, let git decide.
    if ! git -C "$root" cat-file -e "$target:$path" 2>/dev/null; then continue; fi
    # Already matching the index: ordinary clean path, nothing to reconcile.
    if git -C "$root" diff --quiet "$from" -- "$path" 2>/dev/null &&
       git -C "$root" ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
      continue
    fi
    blob=$(git -C "$root" rev-parse "$target:$path" 2>/dev/null) || continue
    # THE ONLY AUTHORIZATION: the bytes on disk are the published bytes.
    if git -C "$root" hash-object -- "$root/$path" 2>/dev/null | grep -Fqx "$blob"; then
      mode=$(git -C "$root" ls-tree "$target" -- "$path" | awk '{print $1}')
      [ -n "$mode" ] || mode=100644
      plan+="$mode,$blob,$path"$'\n'
    else
      # CLASSIFY THE BLOCKER; the remedy differs and the wrong one is costly.
      # A path tracked at HEAD and differing from both ends is genuinely
      # uncommitted work: land it or park it. A path NOT tracked here but
      # present in the target is a file the target ADDED, with some other copy
      # sitting on disk -- almost always a stale leftover, whose remedy is to
      # replace it from the target, NOT to park it. Both still block; only the
      # advice differs. Saying "uncommitted work" for the second case sends the
      # next agent to park work that never needed parking.
      #
      # FIRST, though, ask whether these exact bytes are published at all. Only
      # a NAMED commit reachable from the target counts -- a claim that "it
      # looks stale" is not evidence, and a hit is reported with the SHA so the
      # reader can `git show` the replaced bytes.
      superseded_at=$(published_at_commit "$root" "$target" "$path")
      if [ -n "$superseded_at" ]; then
        blockers+="  $path  [SUPERSEDED — these exact bytes are this path at ${superseded_at:0:12}, already on origin/main]"$'\n'
        blocker_superseded=1
      elif git -C "$root" ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
        blockers+="  $path  [MODIFIED here — differs from HEAD and $target]"$'\n'
        blocker_modified=1
      else
        blockers+="  $path  [UNTRACKED here — $target adds this path; on-disk copy is probably stale]"$'\n'
        blocker_untracked=1
      fi
    fi
  done < <(git -C "$root" diff --name-only "$from" "$target" -- 2>/dev/null)

  if [ -n "$blockers" ]; then
    printf '%s' "$blockers" >&2
    local advice=""
    if [ -n "${blocker_modified:-}" ]; then
      advice+="
  MODIFIED paths are genuinely uncommitted work: LAND them, or PARK them by
  committing to a branch (never checkout/reset --hard/stash-and-drop)."
    fi
    if [ -n "${blocker_untracked:-}" ]; then
      advice+="
  UNTRACKED paths are added by $target and are usually a STALE LEFTOVER, not
  work: diff the on-disk copy against $target and, if it carries nothing new,
  the remedy is to PULL/replace it -- parking it preserves nothing."
    fi
    if [ -n "${blocker_superseded:-}" ]; then
      advice+="
  SUPERSEDED paths hold bytes that ARE published, just not last, so nothing on
  disk is unrecoverable -- but that is NOT authority to replace them, because
  the same test matches an uncommitted edit that happens to equal an older
  version. Only the path's OWNER can tell those apart. If it really is a stale
  leftover: git -C $root checkout $target -- <path>"
    fi
    # Name the mode the caller actually ran. "Then re-run sync" printed under
    # `reconcile` sends the reader to the one command that cannot help them.
    local mode=${HERMIT_PARENT_MAIN_MODE:-sync}
    die "the paths above differ from BOTH your HEAD and $target, so this $mode
  cannot classify them as published residue. Nothing was staged or modified.$advice
  Then re-run $mode."
  fi
  RESIDUE_PLAN=$plan
  printf 'PARENT_MAIN_WRITE residue planned=%s gitlinks=%s target=%s\n' \
    "$(printf '%s' "$plan" | grep -c . || true)" "$gitlinks" "$target"
}

# THE ONLY MUTATION. Every entry here was authorised by byte equality with the
# target, so each `update-index` stages content the working tree already holds:
# zero bytes move on disk, by construction.
apply_published_residue() {
  local root=$1 target=$2 entry adopted=0
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    git -C "$root" update-index --add --cacheinfo "$entry" ||
      die "cannot adopt published residue at ${entry##*,}"
    adopted=$((adopted + 1))
    echo "parent-main-write: adopted published residue (bytes identical to $target): ${entry##*,}" >&2
  done <<<"$RESIDUE_PLAN"
  # Never a silent action: say how many entries moved, including none.
  printf 'PARENT_MAIN_WRITE residue adopted=%s target=%s\n' "$adopted" "$target"
}

adopt_published_residue() {
  classify_published_residue "$1" HEAD "$2"
  apply_published_residue "$1" "$2"
}

# Automatic callers have a narrower authority than a human invoking `sync`.
# Manual sync may advance around unrelated dirty paths after a coordinator has
# inspected them. The snapshot tick has made no such judgement: it may carry
# only exact-target published residue, plus worktree-only drift of a gitlink
# whose index still equals HEAD. Every other dirty path is ambiguous and must
# refuse before the first shared-state write.
#
# This runs after classify_published_residue and under the same writer lock and
# fresh-fetch receipt. A precheck in primary_checkout.py would be a stale,
# weaker copy of the authority this function protects.
verify_automatic_sync_boundary() {
  local root=$1 from=$2 target=$3
  local path entry plan_path exact gitlink blockers='' dirty=0 accepted=0 gitlinks=0
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    dirty=$((dirty + 1))
    exact=0
    while IFS= read -r entry; do
      [ -n "$entry" ] || continue
      plan_path=${entry#*,}
      plan_path=${plan_path#*,}
      if [ "$path" = "$plan_path" ]; then
        exact=1
        break
      fi
    done <<<"$RESIDUE_PLAN"
    if [ "$exact" = 1 ]; then
      accepted=$((accepted + 1))
      continue
    fi

    # Product main advancing makes its checked-out submodule differ from the
    # recorded gitlink. That is the snapshot being due, not parent-file work.
    # It is safe only while nobody staged the gitlink: the index must still be
    # byte-identical to FROM, and both endpoints must remain gitlinks.
    gitlink=0
    if [ "$(git -C "$root" ls-tree "$from" -- "$path" | awk '{print $1}')" = 160000 ] &&
       [ "$(git -C "$root" ls-files --stage -- "$path" | awk '{print $1}')" = 160000 ] &&
       [ "$(git -C "$root" ls-tree "$target" -- "$path" | awk '{print $1}')" = 160000 ] &&
       git -C "$root" diff --cached --quiet "$from" -- "$path"; then
      gitlink=1
    fi
    if [ "$gitlink" = 1 ]; then
      gitlinks=$((gitlinks + 1))
      continue
    fi

    blockers+="  $path  [DIRTY OUTSIDE EXACT FETCHED TARGET]"$'\n'
  done < <({
    git -C "$root" diff --cached --name-only --
    git -C "$root" diff --name-only --
    git -C "$root" ls-files --others --exclude-standard
  } | sort -u)

  if [ -n "$blockers" ]; then
    printf '%s' "$blockers" >&2
    die "automatic sync refuses every dirty path that is not exact-target
  published residue. Nothing was staged, moved, or modified. A human may inspect
  the named work and invoke ordinary sync; automation must not reason past it."
  fi
  printf 'PARENT_MAIN_WRITE automatic-boundary dirty=%s exact-target=%s gitlink-drift=%s refused=0 target=%s\n' \
    "$dirty" "$accepted" "$gitlinks" "$target"
}

# ---------------------------------------------------------------------------
# THE RECONCILE JOURNAL, and why the ref moves before the tree.
#
# reconcile has two mutations that cannot be made one: the ref transaction, and
# the index/working-tree update. SOMETHING can fail between them -- an index
# lock lost to one of the fifteen agents sharing this tree is enough -- so the
# only real choice is WHICH window to have, and the choice must be defended
# rather than inherited.
#
#   index first (the original) leaves a SILENTLY MUTATED SHARED INDEX under a
#   refusal that says "Nothing was staged, moved, or modified". Undetectable
#   from the outside, indistinguishable from a bystander's staging, and the
#   message actively misleads.
#
#   ref first leaves main advanced over a tree that still holds the old
#   content. Also wrong -- and measured worse at first: `git status` showed
#   `M  notes.md  D  remote-only.txt`, and the RETRY said `already-current` and
#   exited 0, because "current" was being read off the ref alone. A tool whose
#   whole job is making "nothing was modified" trustworthy had a path that
#   reported success over a half-applied state.
#
# ref first is still the right choice, but ONLY with this journal, which is what
# makes the difference real instead of rhetorical: a moved ref plus a recorded
# intent is DETECTABLE and REPAIRABLE, while a mutated shared index is neither.
# The journal is written before the transaction and removed only after the tree
# update has been verified, so its presence means exactly "an interrupted
# reconcile happened here, and here are the two commits needed to finish it".
# This is how git itself survives an interrupted merge or rebase, for the same
# reason: state that outlives the process must live in the repository.
#
# If the journal is deleted by hand, resume is lost -- the same as deleting
# .git/MERGE_HEAD. That residual is accepted and stated rather than papered over.
reconcile_journal_path() {
  local root=$1 path
  path=$(git -C "$root" rev-parse --git-path parent-main-write-reconcile)
  case "$path" in /*) printf '%s\n' "$path" ;; *) printf '%s/%s\n' "$root" "$path" ;; esac
}

# Refuse to build on a half-applied tree.
#
# Scoped to the operations that CONSUME working-tree or index state: `commit`
# takes worktree content for its pathspec, and `sync` merges into this index.
# `publish` deliberately does NOT check, because it publishes a rev that was
# built elsewhere and never reads the working tree -- blocking it would also
# remove the plumbing escape hatch without removing any hazard.
guard_reconcile_journal() {
  local root=$1 what=$2 journal old target head
  journal=$(reconcile_journal_path "$root")
  [ -e "$journal" ] || return 0
  old=$(awk -F= '$1 == "old" { print $2 }' "$journal" 2>/dev/null || true)
  target=$(awk -F= '$1 == "target" { print $2 }' "$journal" 2>/dev/null || true)
  head=$(git -C "$root" rev-parse HEAD 2>/dev/null || true)

  # A JOURNAL IS NOT AUTOMATICALLY A HAZARD, and this used to say it was.
  #
  # The first version refused for any journal with "a reconcile was INTERRUPTED
  # here after main had already moved". After the pre-CAS crash was made
  # recoverable, that sentence became FALSE for exactly the case it was most
  # likely to meet -- a run that died before its transaction, where main never
  # moved at all -- and it blocked every agent's `commit` over a tree that was
  # provably untouched. A claim not bound to the fact it asserts, plus an
  # unjustified fleet block: the two failure shapes this file exists to refuse.
  #
  # The pre-CAS case is SAFE BY CONSTRUCTION, not by inspection: everything
  # reconcile does before `update-ref` is read-only -- classification reads,
  # the rehearsal writes only to a copy of the index, and the journal lives in
  # $GIT_DIR. The first shared-state write is the residue adoption that happens
  # AFTER the transaction. So `HEAD == recorded old` means nothing was staged
  # and nothing was written, and there is nothing to protect anyone from.
  if [ -n "$head" ] && [ "$head" = "$old" ] && [ "$old" != "$target" ]; then
    echo "parent-main-write: note: a stale reconcile journal is present at $journal" >&2
    echo "  (recorded ${old:0:12} -> ${target:0:12}; main never moved, so nothing is" >&2
    echo "  half-applied and $what is unaffected). Clear it with:" >&2
    echo "      scripts/parent-main-write reconcile" >&2
    return 0
  fi

  local state
  if [ "$head" = "$target" ]; then
    state="main HAS already moved to $target, so the index and working tree may
  still hold $old"
  else
    state="main is at ${head:-<unknown>}, which is neither recorded end"
  fi
  die "a reconcile was INTERRUPTED here: $state. $what would build on that.
    recorded old:    ${old:-<unreadable>}
    recorded target: ${target:-<unreadable>}
    journal:         $journal
  Finish it first -- \`scripts/parent-main-write reconcile\` detects the journal
  and completes the interrupted update. Nothing is lost either way."
}

# Bring the index and working tree from FROM up to TARGET, then drop the
# journal. Used identically on the first attempt and on a resume, so the resume
# path is the SAME code the original ran, not a second implementation of it.
complete_reconcile_tree() {
  local root=$1 from=$2 target=$3 journal moved behind
  journal=$(reconcile_journal_path "$root")
  classify_published_residue "$root" "$from" "$target"
  apply_published_residue "$root" "$target"
  git -C "$root" read-tree -m -u "$from" "$target" || die "main HAS ALREADY MOVED to $target; the index and working tree still hold
  $from, so this checkout is INTERRUPTED, not broken -- no content is lost and
  \`git status\` shows the difference.
  Re-run \`scripts/parent-main-write reconcile\`: it reads the journal at
  $journal and completes exactly this step. Do NOT hand-run read-tree; residue
  adoption has to happen first, which is why the bare command fails with
  'not uptodate'."
  moved=$(git -C "$root" rev-parse refs/heads/main)
  [ "$moved" = "$target" ] ||
    die "main is $moved after reconcile, not the fetched target $target"
  behind=$(git -C "$root" rev-list --count "$target..refs/heads/main")
  [ "$behind" = 0 ] ||
    die "main still holds $behind commit(s) that $target does not contain"
  # LAST, and only now: the work this journal recorded is done and verified.
  rm -f "$journal"
}

publish_sha() {
  local root=$1 source=$2 expected published
  expected=$HERMIT_PARENT_MAIN_EXPECT
  git -C "$root" merge-base --is-ancestor "$expected" "$source" ||
    die "source $source is not based on fetched origin/main $expected"
  verify_published_attribution "$root" "$expected" "$source"
  refuse_unauthored_reverts "$root" "$expected" "$source"
  if range_has_sensitive_path "$root" "$expected" "$source"; then
    verify_audit_receipt "$root" "$expected" "$source"
  fi
  network_git "$root" push origin "$source:refs/heads/main"
  network_git "$root" fetch origin main >/dev/null
  published=$(git -C "$root" rev-parse refs/remotes/origin/main)
  git -C "$root" merge-base --is-ancestor "$source" "$published" ||
    die "freshly fetched main $published does not contain published $source"
  printf 'PARENT_MAIN_WRITE published=%s fetched-main=%s ancestry=1/1 mode=%s\n' \
    "$source" "$published" "$HERMIT_PARENT_MAIN_MODE"
}

usage() {
  cat >&2 <<'EOF'
usage:
  scripts/parent-main-write commit -m MESSAGE [--audit-reason REASON] -- PATH...
  scripts/parent-main-write publish [--audit-reason REASON] [REV]
  scripts/parent-main-write sync [--automatic | --preserve-dirty] [--expect-target FULL_SHA]
  scripts/parent-main-write reconcile

Hooks use: verify-commit, verify-ref OLD NEW, verify-push REMOTE OLD NEW.
EOF
  exit 2
}

command=${1:-}
[ -n "$command" ] || usage
shift

case "$command" in
  verify-commit) verify_commit ;;
  verify-ref) verify_ref "$@" ;;
  verify-push) verify_push "$@" ;;
  sync)
    automatic=0
    preserve_dirty=0
    expected_target=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --automatic|--preserve-dirty)
          [ "$automatic" = 0 ] && [ "$preserve_dirty" = 0 ] || usage
          if [ "$1" = --automatic ]; then automatic=1; else preserve_dirty=1; fi
          shift
          ;;
        --expect-target)
          [ "$#" -ge 2 ] && [ -z "$expected_target" ] || usage
          [[ "$2" =~ ^[0-9a-f]{40}$ ]] ||
            die "--expect-target requires a full lowercase 40-character commit SHA"
          expected_target=$2
          shift 2
          ;;
        *) usage ;;
      esac
    done
    root=$(repo_root)
    HERMIT_PARENT_MAIN_MODE=sync
    export HERMIT_PARENT_MAIN_MODE
    acquire_lock
    fetch_expected "$root"
    sync_target=refs/remotes/origin/main
    if [ -n "$expected_target" ]; then
      [ "$HERMIT_PARENT_MAIN_EXPECT" = "$expected_target" ] ||
        die "sync expected target $expected_target but freshly fetched origin/main is $HERMIT_PARENT_MAIN_EXPECT; checkout and index were not modified"
      # Bind the eventual merge to the checked object, even if an unrelated
      # fetch later updates the local tracking ref while this lock is held.
      sync_target=$expected_target
    fi
    [ "$(git -C "$root" branch --show-current)" = main ] || die "sync requires local main"
    guard_reconcile_journal "$root" "sync"
    head=$(git -C "$root" rev-parse HEAD)
    if [ "$preserve_dirty" = 1 ]; then
      sync_preserve_dirty "$root"
      exit $?
    fi
    if [ "$head" = "$HERMIT_PARENT_MAIN_EXPECT" ]; then
      printf 'PARENT_MAIN_WRITE sync already-current=%s\n' "$head"
      exit 0
    fi
    if [ "$automatic" = 1 ]; then
      ahead=$(git -C "$root" rev-list --count "$HERMIT_PARENT_MAIN_EXPECT..$head")
      [ "$ahead" = 0 ] || die "automatic sync found $ahead local commit(s) not
  contained in fetched origin/main. Nothing was modified. A human must preserve
  or publish them; automatic sync never reconciles, rebases, or rewrites."
    fi
    git -C "$root" merge-base --is-ancestor "$head" "$HERMIT_PARENT_MAIN_EXPECT" ||
      die "local main diverges from fetched origin; reconcile without reset"
    classify_published_residue "$root" HEAD "$HERMIT_PARENT_MAIN_EXPECT"
    if [ "$automatic" = 1 ]; then
      verify_automatic_sync_boundary "$root" HEAD "$HERMIT_PARENT_MAIN_EXPECT"
    fi
    apply_published_residue "$root" "$HERMIT_PARENT_MAIN_EXPECT"
    git -C "$root" merge --ff-only "$sync_target"
    printf 'PARENT_MAIN_WRITE sync old=%s new=%s fast-forward=1/1\n' \
      "$head" "$HERMIT_PARENT_MAIN_EXPECT"
    ;;
  reconcile)
    # sync's narrower sibling for the one state sync cannot reach: local main
    # DIVERGED while owning no work of its own. See the predicate above.
    [ "$#" -eq 0 ] || usage
    root=$(repo_root)
    HERMIT_PARENT_MAIN_MODE=reconcile
    export HERMIT_PARENT_MAIN_MODE
    acquire_lock
    fetch_expected "$root"
    [ "$(git -C "$root" branch --show-current)" = main ] || die "reconcile requires local main"
    head=$(git -C "$root" rev-parse HEAD)
    target=$HERMIT_PARENT_MAIN_EXPECT
    journal=$(reconcile_journal_path "$root")

    # RESUME FIRST, BEFORE ANYTHING ELSE LOOKS AT THE REF.
    #
    # An interrupted reconcile has already moved main, so every ref-only test --
    # "am I current?", "am I diverged?" -- answers as though the work were done.
    # The journal is the only thing that knows better, so it is consulted first.
    #
    # THREE CASES, NOT TWO. A journal is written before the transaction, so the
    # process can die on EITHER side of it, and the two sides need opposite
    # treatment. An earlier version implemented only the after case and routed
    # the before case into "this needs a human": killing the process between the
    # journal write and the CAS left `first_rc=97 head_is_old=True journal=True`,
    # and from then on reconcile, sync AND commit all refused until somebody
    # deleted the file by hand. That is the fleet wedge the journal exists to
    # prevent, produced by the journal itself.
    if [ -e "$journal" ]; then
      journal_old=$(awk -F= '$1 == "old" { print $2 }' "$journal" 2>/dev/null || true)
      journal_target=$(awk -F= '$1 == "target" { print $2 }' "$journal" 2>/dev/null || true)
      [[ "$journal_old" =~ ^[0-9a-f]{40}$ ]] && [[ "$journal_target" =~ ^[0-9a-f]{40}$ ]] ||
        die "the reconcile journal at $journal is unreadable, so the interrupted
  update cannot be completed automatically. Nothing was modified. Show it to a
  human rather than deleting it: it is the only record of what was in flight."
      if [ "$head" = "$journal_target" ]; then
        # AFTER the CAS: the ref is already where it belongs and only the tree
        # is behind. Complete it with the same code the first attempt runs.
        printf 'PARENT_MAIN_WRITE reconcile RESUMING an interrupted update old=%s new=%s\n' \
          "$journal_old" "$journal_target"
        complete_reconcile_tree "$root" "$journal_old" "$journal_target"
        printf 'PARENT_MAIN_WRITE reconcile resumed=1 old=%s new=%s tree-completed=1 journal-cleared=1\n' \
          "$journal_old" "$journal_target"
        exit 0
      elif [ "$head" = "$journal_old" ]; then
        # BEFORE the CAS: main never moved, so nothing was staged and nothing
        # was written -- the ref transaction is all-or-nothing and it did not
        # happen. There is no work to complete, only a stale record to clear,
        # and then a fresh attempt that revalidates EVERYTHING from a new fetch
        # (the recorded target may itself be stale by now).
        #
        # Reading "the CAS never happened" off HEAD == old is sound because the
        # only way back from target to old is a rewind of a shared branch, and
        # the reference-transaction hook refuses those. If one somehow occurred,
        # falling through is still safe: re-classification finds the adopted
        # entries again by byte equality and re-adopts them idempotently.
        printf 'PARENT_MAIN_WRITE reconcile stale-journal-cleared=1 recorded-old=%s recorded-target=%s reason=ref-never-moved\n' \
          "$journal_old" "$journal_target"
        rm -f "$journal"
        # ... and fall through to a completely fresh, fully revalidated attempt.
      else
        die "the journal records an interrupted reconcile from $journal_old to
  $journal_target, but main is now $head -- neither end. Something else moved
  the branch in between. Nothing was modified. This needs a human: the journal
  is at $journal."
      fi
    fi

    if [ "$head" = "$target" ]; then
      # "already-current" is a claim about the END STATE, not about the ref. The
      # ref alone said "current" over a half-applied tree once already; the
      # journal check above is what makes this line mean what it says, and the
      # counts keep it from implying a clean tree it never inspected.
      #
      # THE COUNTS ARE NAMED FOR WHAT THEY COUNT. A single `dirty=` field fed by
      # `git diff` printed `dirty=0` with `?? untracked.txt` sitting on disk,
      # because `git diff` does not see untracked files -- a field claiming more
      # than it measured, which is the exact defect this file keeps finding
      # elsewhere. Three fields, each bound to one command.
      printf 'PARENT_MAIN_WRITE reconcile already-current=%s interrupted=0 staged=%s unstaged-tracked=%s untracked=%s\n' \
        "$head" \
        "$(git -C "$root" diff --cached --name-only | grep -c . || true)" \
        "$(git -C "$root" diff --name-only | grep -c . || true)" \
        "$(git -C "$root" ls-files --others --exclude-standard | grep -c . || true)"
      exit 0
    fi
    # ESTABLISH THE PREDICATE BEFORE TOUCHING ANYTHING. The hook re-derives it
    # independently at the ref update, but a refusal that arrives only after the
    # index and working tree have been rewritten is a worse refusal.
    verify_reconcile_is_lossless "$root" "$head" "$target"
    printf 'PARENT_MAIN_WRITE reconcile leaving behind %s commit(s), all proven upstream:\n' \
      "$RECONCILE_DROPPED"
    printf '%s' "$RECONCILE_EVIDENCE"
    # CLASSIFY, then REHEARSE, and only then mutate anything.
    #
    # The order matters and the first version got it wrong: it adopted residue
    # into the SHARED index and only afterwards ran the dry run, so a refusal
    # from the dry run left the index already rewritten while the message said
    # "Nothing was staged or modified". Classification is read-only, and the
    # rehearsal below applies the adoption plan to a COPY of the index, so every
    # gate has passed before one byte of shared state changes.
    classify_published_residue "$root" "$head" "$target"
    rehearsal=$(mktemp -u "${TMPDIR:-/tmp}/parent-main-write-rehearsal.XXXXXX")
    cp "$(git -C "$root" rev-parse --git-path index)" "$rehearsal" ||
      die "cannot copy the index for a rehearsal; nothing was modified"
    rehearse() {
      local entry
      while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        GIT_INDEX_FILE=$rehearsal git -C "$root" update-index --add --cacheinfo "$entry" ||
          return 1
      done <<<"$RESIDUE_PLAN"
      # THE SAME two-way merge the real move performs, against the index the
      # real move would see. `-n` computes it and writes nothing.
      GIT_INDEX_FILE=$rehearsal git -C "$root" read-tree -m -n "$head" "$target"
    }
    if ! rehearse; then
      rm -f "$rehearsal"
      die "the two-way merge from $head to $target would overwrite local changes;
  nothing was staged, moved, or modified. The paths are named in git's own
  error above. This was a REHEARSAL against a copy of the index."
    fi
    rm -f "$rehearsal"

    # THE MOVE ITSELF: the SAME two-way merge `sync` performs, then a
    # compare-and-swap on the ref. Neither half force-writes anything.
    #
    # NOT `git reset --keep`, which reads like the obvious tool and is the one
    # thing measured to be worse than `sync` here. In this parent ~15 agents
    # share ONE .git/index, and `reset --keep` REWRITES EVERY INDEX ENTRY:
    # measured 2026-08-10 on a bystander's staged `new.txt` plus a staged edit
    # to an untouched `keep.txt`, `merge --ff-only` and `read-tree -m -u` both
    # left `A new.txt` / `M  keep.txt` staged, and `reset --keep` left `??` and
    # ` M` -- the bytes survive, the staging does not. read-tree keeps
    # sync's exact semantics (twoway_merge cases 14/15 keep an entry that is
    # identical in both trees) so reconcile is never harsher than sync.
    #
    # THE REF TRANSACTION GOES FIRST, BEFORE ANY SHARED STATE IS TOUCHED.
    #
    # A rehearsal proves the operation COMPUTES; it cannot prove the world holds
    # still afterwards. This parent's origin/main moves every few minutes, so
    # between the rehearsal and the transaction a concurrent fetch can move
    # refs/remotes/origin/main and the hook will then -- correctly -- refuse.
    #
    # An earlier ordering adopted residue into the SHARED index first and moved
    # the ref second. Reproduced 2026-08-10 by wrapping `git` so the tracking ref
    # moved during the operation: `rc 128, index_same False, cached_paths
    # notes.md`, with the refusal printing "Nothing was staged, moved, or
    # modified" over a notes.md that was, in fact, now staged. Gate ORDERING was
    # fixed by the rehearsal; this is the time-of-check-to-time-of-use half, and
    # only the order of the two mutations closes it.
    #
    # The transaction is the one operation nothing can un-do and nothing can
    # partially do: the hook either refuses (nothing anywhere has changed) or the
    # ref moves. Only afterwards do we touch the index and the working tree, and
    # both of those are exactly what `sync` does.
    #
    # Restoring a captured index on the failure path was the alternative and was
    # rejected: fifteen agents share this index, so a snapshot taken before the
    # transaction and written back after it would silently revert any `git add`
    # a bystander made in between -- trading a stale-index bug for a lost-work
    # bug, which is the trade this whole file exists to refuse.
    #
    # The window ref-first leaves is REAL, and the journal is what pays for it:
    # written here, before the transaction, so that a failure between the two
    # mutations is recoverable rather than merely visible. See its definition.
    # ATOMIC, AND DURABLE BEFORE THE TRANSACTION IT GUARDS.
    #
    # Plain redirection can leave a half-written record, and a half-written
    # journal lands in the "unreadable, needs a human" branch -- the worst of
    # both, since it neither resumes nor clears. Write to a temporary, force it
    # out, then rename: a reader sees either no journal or a complete one, and
    # the record reaches the disk BEFORE the ref it is supposed to explain.
    journal_tmp="$journal.$$"
    printf 'old=%s\ntarget=%s\npid=%s\nstarted=%s\n' \
      "$head" "$target" "$$" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$journal_tmp" || {
      rm -f "$journal_tmp"
      die "cannot write the reconcile journal at $journal; nothing was modified"
    }
    sync -- "$journal_tmp" 2>/dev/null || sync 2>/dev/null || true
    mv -f "$journal_tmp" "$journal" || {
      rm -f "$journal_tmp"
      die "cannot install the reconcile journal at $journal; nothing was modified"
    }
    # The rename itself has to be durable, or a crash can lose the record while
    # keeping the ref move it guards. Directory fsync; best effort by design --
    # a filesystem that refuses it must not block the operation.
    sync -- "${journal%/*}" 2>/dev/null || true
    git -C "$root" update-ref refs/heads/main "$target" "$head" || {
      # The transaction refused: it changed nothing, so neither should we.
      rm -f "$journal"
      die "the ref transaction was refused; nothing was staged, moved, or
  modified, and the journal has been removed. The reason is above."
    }
    complete_reconcile_tree "$root" "$head" "$target"
    printf 'PARENT_MAIN_WRITE reconcile old=%s new=%s dropped=%s proven-upstream=%s divergence=0\n' \
      "$head" "$target" "$RECONCILE_DROPPED" "$RECONCILE_PROVEN"
    printf 'PARENT_MAIN_WRITE reconcile recovery: the previous tip %s is unreferenced but not gone (reflog + object store)\n' \
      "$head"
    ;;
  commit)
    message=''
    audit_reason=''
    paths=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -m|--message) [ "$#" -ge 2 ] || usage; message=$2; shift 2 ;;
        --audit-reason) [ "$#" -ge 2 ] || usage; audit_reason=$2; shift 2 ;;
        --) shift; paths=("$@"); break ;;
        *) usage ;;
      esac
    done
    [ -n "$message" ] && [ "${#paths[@]}" -gt 0 ] || usage
    root=$(repo_root)
    verify_proposed_attribution "$root" "$message"
    if [ -n "$audit_reason" ]; then
      [[ "$audit_reason" != *$'\n'* ]] || die "audit reason must be one line"
      HERMIT_PARENT_MAIN_MODE=audited
      HERMIT_PARENT_MAIN_AUDIT_REASON=$audit_reason
      export HERMIT_PARENT_MAIN_AUDIT_REASON
    else
      HERMIT_PARENT_MAIN_MODE=ordinary
    fi
    export HERMIT_PARENT_MAIN_MODE
    acquire_lock
    fetch_expected "$root"
    [ "$(git -C "$root" branch --show-current)" = main ] || die "commit requires local main"
    guard_reconcile_journal "$root" "a commit"
    [ "$(git -C "$root" rev-parse HEAD)" = "$HERMIT_PARENT_MAIN_EXPECT" ] ||
      die "local main is not the freshly fetched origin/main"
    commit_args=(commit --only)
    if [ "$HERMIT_PARENT_MAIN_MODE" = audited ]; then
      # Canonical five-field disclosure belongs on the FIRST body line.  Legacy
      # role/team disclosure belongs on the FINAL line.  Preserve whichever
      # already-validated form the caller supplied while inserting receipts.
      trimmed=$message
      while [[ "$trimmed" == *$'\n' ]]; do trimmed=${trimmed%$'\n'}; done
      first_body=$(printf '%s\n' "$trimmed" | awk '
        NR > 2 {
          candidate = $0
          sub(/^[[:space:]]+/, "", candidate)
          if (candidate != "" && substr(candidate, 1, 1) != "#") {
            print $0
            exit
          }
        }
      ')
      logical_last_nr=$(printf '%s\n' "$trimmed" | awk '
        {
          candidate = $0
          sub(/^[[:space:]]+/, "", candidate)
          if (candidate != "" && substr(candidate, 1, 1) != "#") {
            last = NR
          }
        }
        END { if (last) print last }
      ')
      attribution=$(printf '%s\n' "$trimmed" | awk -v target="$logical_last_nr" '
        NR == target { print; exit }
      ')
      legacy_attribution_re='^\[(impl agent|adversarial-reviewer agent|coordinator|Human), [^][]+\] \[[A-Za-z0-9][A-Za-z0-9._/@+-]*, devbig[0-9]+\]$'
      if [[ $first_body == \[* && $first_body == *'role='* && $first_body == *\] ]]; then
        if [[ $attribution =~ $legacy_attribution_re ]]; then
          body=$(printf '%s\n' "$trimmed" | awk -v target="$logical_last_nr" '
            NR != target { print }
          ')
          commit_args+=( -m "$body" \
            -m "Parent-Main-Write-Mode: audited" \
            -m "Parent-Main-Write-Reason: $audit_reason" \
            -m "Parent-Main-Write-Base: $HERMIT_PARENT_MAIN_EXPECT" \
            -m "$attribution" )
        else
          commit_args+=( -m "$trimmed" \
            -m "Parent-Main-Write-Mode: audited" \
            -m "Parent-Main-Write-Reason: $audit_reason" \
            -m "Parent-Main-Write-Base: $HERMIT_PARENT_MAIN_EXPECT" )
        fi
      else
        body=$(printf '%s\n' "$trimmed" | awk -v target="$logical_last_nr" '
          NR != target { print }
        ')
        [ -n "$body" ] || die "audited commit message needs a subject before attribution"
        commit_args+=( -m "$body" \
          -m "Parent-Main-Write-Mode: audited" \
          -m "Parent-Main-Write-Reason: $audit_reason" \
          -m "Parent-Main-Write-Base: $HERMIT_PARENT_MAIN_EXPECT" \
          -m "$attribution" )
      fi
    else
      commit_args+=( -m "$message" )
    fi
    commit_args+=( -- "${paths[@]}" )
    git -C "$root" "${commit_args[@]}"
    source=$(git -C "$root" rev-parse HEAD)
    publish_sha "$root" "$source"
    ;;
  publish)
    audit_reason=
    if [ "${1:-}" = --audit-reason ]; then
      [ "$#" -ge 2 ] || usage
      audit_reason=$2
      shift 2
    fi
    [ "$#" -le 1 ] || usage
    root=$(repo_root)
    source=$(git -C "$root" rev-parse "${1:-HEAD}^{commit}")
    if [ -n "$audit_reason" ]; then
      [[ "$audit_reason" != *$'\n'* ]] || die "audit reason must be one line"
      HERMIT_PARENT_MAIN_MODE=audited
      HERMIT_PARENT_MAIN_AUDIT_REASON=$audit_reason
      export HERMIT_PARENT_MAIN_AUDIT_REASON
    else
      HERMIT_PARENT_MAIN_MODE=ordinary
    fi
    export HERMIT_PARENT_MAIN_MODE
    acquire_lock
    fetch_expected "$root"
    publish_sha "$root" "$source"
    ;;
  *) usage ;;
esac
