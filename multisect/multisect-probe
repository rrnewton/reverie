#!/usr/bin/env bash
# multisect-probe -- the token-free automatic probe unit.
#
# This is the command the multisect ENGINE (debug/multisect) runs, once per
# repetition, wrapped inside `safe-ci-dag-runner box` (cgroup mem + wall
# timeout + core cap). It does the three things the engine deliberately does
# NOT do:
#
#     checkout(commit)  ->  targeted-minimal-build  ->  run-one-test
#
# and exits with a status the box turns into a PASS/FAIL/TIMEOUT verdict:
#
#     exit 0      test passed              -> box PASS  -> engine "green"
#     exit 124    test hung (inner kill)   -> box FAIL  -> engine "wedged"
#     exit !=0    test failed              -> box FAIL  -> engine "wedged"
#     exit 125    BUILD FAILED (infra)     -> box FAIL, but a `build-failed`
#                                            marker is written so the
#                                            orchestrator can WARN that the
#                                            blame may be a compile break,
#                                            not the target bug.
#
# Once the investigating agent has configured the probe (a probes/*.env file),
# the entire search runs through this script in pure code -- NO tokens per
# probe. That automation boundary is the whole point of the tool.
#
# BUILD-VS-HANG SEPARATION (correctness-critical):
#   The build is NOT wrapped in the hang timeout -- only the test binary is
#   (via PROBE_TEST_TIMEOUT). A cold build therefore can NEVER be misread as a
#   test hang. The box's own (outer) timeout is a generous safety net sized to
#   cover a cold build plus the inner timeout; see the orchestrator.
#
# Inputs from the engine (environment):
#   MULTISECT_COMMIT MULTISECT_SHORT_COMMIT MULTISECT_REP MULTISECT_ROUND
#   MULTISECT_OUTPUT_DIR MULTISECT_REPO
#
# Inputs from the configured probe (probes/<name>.env, exported by orchestrator):
#   PROBE_REPO           git checkout that owns the .git objects to search
#   PROBE_POOL_DIR       directory holding per-commit build caches and probe output
#   PROBE_BUILD_ARGV     build command; compiles the test WITHOUT running it
#   PROBE_TEST_BIN_GLOB  glob (under target/) matching the compiled test binary
#   PROBE_TEST_ARGV      args passed to the test binary (filter, --exact, etc.)
#   PROBE_TEST_TIMEOUT   inner hang-detector timeout, seconds (bounds the TEST only)
#   PROBE_BUILD_ENV      extra `KEY=VAL ...` build env (the C3 profile lives here)
#
set -uo pipefail

fail_infra() { echo "multisect-probe: INFRA: $*" >&2; }

# Robustness: if the boxed environment did not forward the probe config (some
# sandboxes scrub env), source it from PROBE_CONFIG. The orchestrator always
# exports both the PROBE_* vars and PROBE_CONFIG.
if [[ -z "${PROBE_REPO:-}" && -n "${PROBE_CONFIG:-}" && -f "${PROBE_CONFIG}" ]]; then
  # The path comes from the caller, so it cannot be followed statically.
  # The directive must sit on the `source` itself: previously it preceded
  # `set -a; source ...` on one line, so it bound to `set -a` and never
  # applied -- the suppression was present and inert, and SC1090 still fired.
  set -a
  # shellcheck disable=SC1090
  source "${PROBE_CONFIG}"
  set +a
fi

: "${MULTISECT_COMMIT:?engine must set MULTISECT_COMMIT}"
: "${MULTISECT_REPO:?engine must set MULTISECT_REPO}"
: "${PROBE_REPO:?configured probe must set PROBE_REPO}"
: "${PROBE_POOL_DIR:?configured probe must set PROBE_POOL_DIR}"
: "${PROBE_BUILD_ARGV:?configured probe must set PROBE_BUILD_ARGV}"
: "${PROBE_TEST_BIN_GLOB:?configured probe must set PROBE_TEST_BIN_GLOB}"
: "${PROBE_TEST_TIMEOUT:?configured probe must set PROBE_TEST_TIMEOUT}"

short="${MULTISECT_SHORT_COMMIT:-${MULTISECT_COMMIT:0:12}}"
out="${MULTISECT_OUTPUT_DIR:-$PROBE_POOL_DIR/out-$short-r${MULTISECT_REP:-0}}"
mkdir -p "$out"

project_root="${PROBE_PROJECT_ROOT:-$(dirname "$PROBE_REPO")}"
wrkslots="${PROBE_WRKSLOTS:-$project_root/ci-hub/bin/wrkslots}"
repository_name=$(basename "$PROBE_REPO")
slot="multisect-${short}-${MULTISECT_REP:-0}-$$"
slot_created=0
wt=""
target_dir="$PROBE_POOL_DIR/target-$short"
lock="$PROBE_POOL_DIR/.lock-$short"
mkdir -p "$PROBE_POOL_DIR"

cleanup() {
  local rc=$?
  trap - EXIT
  if [[ $slot_created -eq 1 ]]; then
    cleanup_output=$(
      "$wrkslots" --project-root "$project_root" \
        --allow-existing-unregistered-worktrees remove "$slot" \
        --validate-complete --coordinator-pid "$$" --expected-generation 1 2>&1
    )
    cleanup_rc=$?
    if [[ $cleanup_rc -ne 0 ]]; then
      printf '%s\n' \
        "multisect-probe: validation checkout RETAINED after wrkslots cleanup refused." \
        "state: RETAINED -- probe exit remains $rc; cleanup did not complete." \
        "remedy: $cleanup_output" >&2
    fi
  fi
  exit "$rc"
}
trap cleanup EXIT

# Serialize any same-commit concurrency (reps are serial today, but a per-commit
# flock keeps a future -j change or a retry from clobbering one worktree's build
# directory -- Hard Invariant 8, no shared writable build dirs).
exec 9>"$lock"
if ! flock 9; then
  fail_infra "cannot lock $lock"
  exit 3
fi

# --- checkout ------------------------------------------------------------------
# Every repetition gets a registered validation checkout. The per-commit target
# directory remains outside it, so warm repetitions retain build artifacts
# without retaining or sharing an unregistered Git worktree.
create_output=$(
  "$wrkslots" --project-root "$project_root" \
    --allow-existing-unregistered-worktrees create "$slot" --format json \
    --slot-type validate --coordinator-authorized --agent "multisect-$$" \
    --task "multisect-$MULTISECT_COMMIT" \
    --purpose "build and run one multisect repetition" \
    --owner-pid "$$" --coordinator-pid "$$" \
    --repo "checkout=$repository_name" --start "checkout=$MULTISECT_COMMIT" \
    2>"$out/checkout.log"
)
rc_add=$?
if [[ $rc_add -ne 0 ]]; then
  fail_infra "wrkslots could not create the validation checkout for $short (see $out/checkout.log); the probe never ran"
  exit 3
fi
slot_created=1
wt=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["checkouts"][0]["path"])' <<<"$create_output")
parse_rc=$?
if [[ $parse_rc -ne 0 || ! -d $wt ]]; then
  fail_infra "wrkslots returned no readable checkout path for $slot; inspect wrkslots status"
  exit 3
fi

# --- targeted minimal build (NOT under the hang timeout) -----------------------
# The C3 profile (CARGO_INCREMENTAL=0 + line-tables-only + split-debuginfo) is
# carried in PROBE_BUILD_ENV. It keeps file:line backtraces (this bug class
# needs them) while being strictly cheaper than the default dev profile.
build_start=$(date +%s.%N)
if ! env CARGO_TARGET_DIR="$target_dir" ${PROBE_BUILD_ENV:-} \
      bash -c "cd '$wt' && ${PROBE_BUILD_ARGV}" \
      >"$out/build.log" 2>&1; then
  # A build failure is INFRA, not a wedge: main commits normally compile, so a
  # break here almost certainly means an environmental problem or a range that
  # crosses a compile-broken commit. Leave a marker the orchestrator scans for.
  touch "$PROBE_POOL_DIR/build-failed-$short"
  echo "BUILD-FAILED commit=$short (see $out/build.log)" >&2
  exit 125
fi
build_end=$(date +%s.%N)

# Locate the compiled test binary (never rebuild inside the timed step). Pick
# the newest executable that is not a depfile/dSYM/dwo artifact.
shopt -s nullglob
testbin=""
# ls -t is deliberate: newest-first is the point, and a glob cannot order by mtime.
test_glob=${PROBE_TEST_BIN_GLOB#target/}
# shellcheck disable=SC2045
for cand in $(ls -t "$target_dir"/$test_glob 2>/dev/null); do
  case "$cand" in
    *.d | *.dwo | *.dSYM) continue ;;
  esac
  if [[ -f "$cand" && -x "$cand" ]]; then
    testbin="$cand"
    break
  fi
done
shopt -u nullglob
if [[ -z "$testbin" ]]; then
  fail_infra "no executable test binary matched $PROBE_TEST_BIN_GLOB under $target_dir"
  exit 3
fi

# --- run one test (THIS is what the inner timeout bounds) ----------------------
run_start=$(date +%s.%N)
# shellcheck disable=SC2086
timeout --signal=KILL "${PROBE_TEST_TIMEOUT}" \
  env ${PROBE_TEST_ENV:-} "$testbin" ${PROBE_TEST_ARGV:-} \
  >"$out/test.log" 2>&1
rc=$?
run_end=$(date +%s.%N)

# Record per-probe timings for the estimator's calibration ingestion.
awk -v b="$build_start" -v be="$build_end" -v r="$run_start" -v re="$run_end" \
    -v rc="$rc" -v c="$short" -v rep="${MULTISECT_REP:-0}" 'BEGIN{
  printf "commit=%s rep=%s build_s=%.3f test_s=%.3f rc=%d\n", c, rep, be-b, re-r, rc
}' >"$out/probe-timing.txt" 2>/dev/null || true

exit "$rc"
