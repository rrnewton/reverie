# multisect probe: detcore_misc reap-hang search (FIRST CUSTOMER)
#
# Bug signature (coordinate with hermit-multisect, who runs this search live):
#   Zombie::reap -> Running::next_state -> ptrace_getevent with hot ESRCH
#   re-polling. Manifests as a HANG-to-timeout, NOT a fast failure. Per-instance
#   hang rate p ~= 2.6%, so this probe needs a HIGH rep count (amplification):
#   at p=0.026, N=60 reps miss a truly-broken commit with probability
#   (1-p)^N ~= 20%; N=120 -> ~4%. Machine load raises p, so run on a busy host.
#
# The test runs IN-PROCESS (libc::fork + test_allocator + detcore/reverie
# in-process; NO hermit-CLI shell-out). The minimal build therefore compiles
# detcore + detcore-model + reverie + testutils and EXCLUDES hermit-cli, so the
# third-party backends (dbi/sabre/e9patch, which live in hermit-cli) are already
# out of the build with zero extra flags.
#
# Recommended invocation:
#   ./multisect/multisect run --probe detcore_misc \
#       --good <known-green sha> --bad <known-broken sha> -k 3 -n 120 -j 8
#   (omit --good to accept a ci-hub known-green anchor)

# --- what repo to search -------------------------------------------------------
# The primary checkout whose commits wrkslots materializes for each repetition.
# It must live directly below the configured dev-hermit project root.
PROBE_REPO=/home/newton/work/dev-hermit/hermit

# --- build-cache and output pool (orchestrator-owned; **/ignored/ is gitignored)
PROBE_POOL_DIR=/home/newton/work/dev-hermit/multisect/ignored/pool-detcore_misc

# --- targeted minimal build (compiles the test, does NOT run it) ---------------
PROBE_BUILD_ARGV='detcore_package=$(grep -m1 -E "^name = \"(hermit-)?detcore\"$" detcore/Cargo.toml | cut -d "\"" -f 2); case "$detcore_package" in detcore|hermit-detcore) cargo test -p "$detcore_package" --test tests_misc --no-run ;; *) echo "could not resolve Detcore Cargo package name" >&2; exit 2 ;; esac'

# The C3 profile: the measured cost floor that KEEPS usable file:line backtraces
# (this bug class needs them). CARGO_INCREMENTAL=0 avoids per-probe incremental
# bloat; line-tables-only + unpacked split-debuginfo shrink the binary ~3x vs
# default dev debug=2 while preserving backtraces.
PROBE_BUILD_ENV=CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=line-tables-only CARGO_PROFILE_DEV_SPLIT_DEBUGINFO=unpacked

# --- run one test (this, and only this, is bounded by the inner hang timeout) --
PROBE_TEST_BIN_GLOB=target/debug/deps/tests_misc-*
# The known reap-trigger. To probe the whole suite (more fork/reap events per
# rep, at ~0.4s), clear PROBE_TEST_ARGV to run every test in tests_misc.
PROBE_TEST_ARGV=--exact vfork::vfork_parent_resumes_after_child_exec --test-threads=1 --nocapture
# A healthy run of this test is ~0.02s; a hang spins indefinitely. 30s is far
# above healthy yet bounds a wedge tightly. CPU-vs-wall on completion tells a
# spin (pins a core) apart from a slow-but-progressing run.
PROBE_TEST_TIMEOUT=30

# --- box resources (cold build wants cores; RSS measured <1G) ------------------
PROBE_BOX_CORES=8
PROBE_BOX_MEM=6G
