# multisect probe: e2e.metadata DAG node (the owner's motivating case)
#
# DAG-NODE SHAPED, not test-binary shaped. e2e.metadata is a shell step in
# ci/dag/portable.json; there is no compiled binary for multisect-probe to glob,
# which is why this needs multisect-dag-probe instead.
#
# THE NODE IS BIMODAL AND THAT IS THE HAZARD, not the bug: measured 16.5s (warm
# cache) vs 57s (cold compile) against a 60s budget, and it drew slow 2 times in
# 9 observed CI runs. A single-shot probe bisects to whichever commit drew the
# slow mode and blames an innocent diff. So run this with reps and read the
# RATE, never one draw:
#
#   ./multisect/multisect run --probe e2e_metadata \
#       --good <sha> --bad <sha> -n 6
#
# SIZING, and the honest limit. At a ~2-in-9 slow rate, n=6 gives roughly a
# 3-in-4 chance of seeing at least one slow draw per commit -- enough to DETECT
# bimodality, nowhere near enough to separate "this commit is slower" from "this
# commit drew unlucky". The refusal path (engine `status: ambiguous`) matters
# more here than the detection path. Do not raise n to force a verdict; a
# refusal is the correct output when the rate does not separate.
#
# This node's bimodality is expected to disappear when the DAG-root fix lands
# (task e2e_metadata_is_a). The probe shape outlives it -- the next bimodal node
# will not announce itself.

PROBE_REPO=/home/newton/work/dev-hermit/hermit
PROBE_POOL_DIR=/home/newton/work/dev-hermit/multisect/ignored/pool-e2e_metadata

PROBE_DAG=ci/dag/portable.json
PROBE_NODE=e2e.metadata

# Outer bound only. The node's OWN 60s budget is what decides TIMEOUT vs pass;
# this exists so a wedged runner cannot hang the whole search. Deliberately far
# above the node budget so it can never be the thing that fires.
PROBE_NODE_TIMEOUT=900
