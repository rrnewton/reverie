# Vendored upstream checkouts do not belong in the parent history. Experiments
# must record source URLs + commit SHAs for reproducibility, not embed a full
# clone (a nested .git would otherwise be at risk of accidental staging).
/experiments/gvisor/

# Per-experiment scratch space (experiments/ignored/ is also covered by the
# global `ignored/` rule below; listed explicitly for discoverability).
/experiments/ignored/
**/ignored/

# Protective guards against accidentally committing large/binary experiment
# artifacts. Durable evidence stays as text (README/CSV/JSON/TSV); heavy
# outputs live under an ignored/ scratch dir or an external artifact store.
/experiments/**/*.img
/experiments/**/*.qcow2
/experiments/**/*.raw
/experiments/**/*.iso
/experiments/**/*.bin
/experiments/**/*.a
/experiments/**/*.o
/experiments/**/*.so
/experiments/**/*.tar
/experiments/**/*.tar.*
/experiments/**/*.tgz
/experiments/**/*.gz
/experiments/**/*.zip
/experiments/**/*.zst
/experiments/**/*.core
/experiments/**/core.[0-9]*
/experiments/**/bzImage
/experiments/**/vmlinux
/experiments/**/initramfs*.cpio*

# Compiled experiment fixtures are rebuilt from their checked-in *.c source;
# never commit the extensionless ELF binaries produced next to it.
/experiments/dbi_perf_leader_baseline_20260801/src/branch_heavy
/experiments/dbi_perf_leader_baseline_20260801/src/syscall_loop
/experiments/gvisor-blog-repro-v2_20260807/scripts/getpid-threads

# Heavy raw preempt-traces are bulk scratch evidence; keep the experiment's
# README/CSV/JSON summary in-tree and leave multi-MiB traces untracked.
/experiments/**/*.preempt-trace.txt

# Transient tooling output
**/__pycache__/
/debug/
!/debug/
/debug/*
!/debug/MULTISECT.md
!/debug/multisect
!/debug/test_multisect.py
*.perf.data
*.log

# High-volume per-run transcripts stay local.  Compact, durable tables are
# promoted to each experiment's results directory before publication.
/experiments/btrfs_userspace_fuzz_cases_20260728/runs/
/experiments/btrfs_userspace_logic_20260728/runs/

# A busybox initramfs staging tree: 413 files, almost all symlinks to one
# `bin/busybox`, rebuilt in seconds by re-running the experiment. Only `init`
# below is authored, and REPORT.md quotes it. Committing the tree would add 413
# paths of noise for 3 KiB of content.
# The trailing `/*` is load-bearing: git does not descend into an excluded
# DIRECTORY, so `rootfs/` followed by `!rootfs/init` silently drops init too.
/experiments/icount-smp_20260820/rootfs/*
!/experiments/icount-smp_20260820/rootfs/init

# Per-run QEMU outputs from the 2026-08-17/20 measurement campaigns. These
# directories contain multi-gigabyte stderr/log captures and extracted run
# trees; the durable scripts, README files, and compact result tables remain
# visible to Git alongside them.
/experiments/first-divergence_20260820/bwork/
/experiments/first-divergence_20260820/keep/
/experiments/first-divergence_20260820/runs/
/experiments/kvm-canonical-measurement-2026-08-17/original-69-run-measurement/build/
/experiments/kvm-canonical-measurement-2026-08-17/original-69-run-measurement/results/runs/

# Compiled guest fixtures for the vCPU-steering experiment. Their C sources
