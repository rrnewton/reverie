# Landing mutex runtime state (see ci-hub/landing/). Machine-local, never committed.
/.landing-lock
/.landing-lock.owner
/.landing-lock.guard
/.landing-lock.guard.*
/.landing-lock.queue
/.landing-lock.queue.*
/.landing-lock.cleanup-required
