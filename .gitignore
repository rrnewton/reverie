# PR-sweep command-output capture (stdout/stderr). Transient, never committed.
/pr_sweep.out
/pr_sweep.err

# validate-lock box-exclusive admission runtime state (see ci-hub/, validate-lock
# gate). Same shape as the landing mutex above. Machine-local, never committed.
/.validate-lock
/.validate-lock.owner
/.validate-lock.guard
/.validate-lock.guard.*
/.validate-lock.queue
/.validate-lock.queue.*
/.validate-lock.cleanup-required
/.validate-lock.cleanup-required.tmp-*
