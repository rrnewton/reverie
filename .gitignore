target/

# Local backup and Python cache files.
*.orig
**/__pycache__/
**/.mypy_cache/

# buck2 build output
buck-out/

# Reindeer-generated dependency output. These patterns live at the repository
# root rather than shim/.gitignore: Reindeer reads ignore files only through
# the shim cell root, so the root rules keep Git clean without filtering the
# source files that Reindeer materializes.
/shim/third-party/rust/.cargo/
/shim/third-party/rust/BUCK
/shim/third-party/rust/vendor/
