# safe-ci-dag-runner runtime scratch (per-node profiles). Machine-local, never committed.
/.safe-ci-dag-runner/

# Transient ops-poll output redirected into the parent root. These are stdout/stderr
# capture files from `ci-hub health` (h.*) and pr_status runs (pr_status*), NOT tracked
# artifacts — the real script lives at ci-hub/health/pr_status.py. Root-anchored so they
# never dirty `git status`; does not match ci-hub/health/pr_status.py.
/h.err
/h.json
/pr_status*.err
/pr_status*.json
/prstatus*.err
/prstatus*.json
# A zero-byte root file left by a stray shell redirect on 2026-08-08 (almost
# certainly a truncated `critical-path` word). It holds no bytes and no work, but
# deleting another agent's file is the owner's call, so it is ignored rather than
# removed. Delete `critical` and this line together once that is confirmed.
/critical

# One-off manual snapshot taken before the compat-envelope provenance migration
# (291 KiB, 2026-08-08). A backup copy of a tracked CSV is working state, not
# durable evidence, so it stays out of history; its author may still need it on
# disk. Remove the file and this rule once the migration is settled.
/compat-envelope/*.pre-provenance-migration

# herdr-run run spools + sandbox-crossing audit log (machine-local command OUTPUT, never source)
.herdr-run/

# Compiled guest executables built by experiments (sources are tracked, binaries are not)
experiments/*/sig_alarm
experiments/*/sig_chld
experiments/*/sig_usr
experiments/*/vtime_probe
experiments/*/memaddrs
experiments/*/pid_tid
experiments/*/guest_heap
experiments/*/probe
experiments/*/pn

# Runtime marker written by ci-hub validate-lock on release; never durable state.
.validate-lock.released

# ---- 2026-08-22 parent-cleanup: compiled experiment output ----
# Adding experiments/ to version control surfaced 80 extensionless ELF files
# totalling 596 MB against 13 MB of durable text across the same 2,227 files.
# The rules below exclude exactly those binaries. Everything else in each
# experiment -- README, scripts, *.c/*.rs sources, JSON/CSV/TSV results -- stays
# tracked, which is what makes the experiment repeatable.

# Eight ~59 MiB copies of the hermit executable kept as A/B comparison subjects,
# 472 MB and nothing else in that directory. The experiment records the SHAs they
# were built from, so they are reproducible without being stored.
/experiments/first-divergence_20260820/bin2/

# 38 byte-identical copies of one compiled test fixture, one per run directory in
# the KVM measurement's replay tree.
/experiments/kvm-canonical-measurement-2026-08-17/**/fixtures/program

# Extensionless ELF fixtures built beside their own checked-in sources. Almost
# every line here has a *.c or *.rs sibling that stays tracked; only the build
# output is excluded. Written as exact paths rather than a name wildcard so that
# a future *text* file called e.g. `probe` or `racer` is not silently dropped.
/experiments/cc-repro_20260818/guest/order
/experiments/cc-repro_20260818/guest/order_cpu
/experiments/cc-repro_20260818/guest/order_long
/experiments/cc-repro_20260818/guest/order_same
/experiments/cc-repro_20260818/guest/racer
/experiments/chaos-seed-repro_20260818/spin6
/experiments/chaos-seed-repro_20260818/tickwait
/experiments/chaos-wedge_20260818/busywork
/experiments/chaos-wedge_20260818/tickwait
/experiments/detcore-partial-determinism_20260819/repro/extclock
/experiments/detcore-partial-determinism_20260819/repro/extclock2
/experiments/detcore-partial-determinism_20260819/repro/pollclock
/experiments/detcore-partial-determinism_20260819/repro/threadclock
/experiments/first-divergence_20260820/price/hashcost
/experiments/first-divergence_20260820/price/hashcost2
/experiments/first-divergence_20260820/price/netlink_buf
/experiments/first-divergence_20260820/price/netlink_where
/experiments/first-divergence_20260820/price/syscost
/experiments/netlink-audit_20260820/hashorder
/experiments/netlink-audit_20260820/hermit-sorted
/experiments/netlink-audit_20260820/hermit-unsorted
/experiments/netlink-audit_20260820/nlab_generic
