# Agent and local runtime state
/.agents/*
!/.agents/skills/
/.agent-locked
/.agent-continuations/
/.orc/
/.runtime/
/CLAUDE.local.md

# Secrets and machine-specific configuration
/.api_keys.env
/.gh.env
/.oauth.env
/.ops-driver.env
/.ops-state.json
/.ops-state.yaml
/.tick-hub/
# A previously materialized live runner workspace may remain while tracked
# runner source moves under ci-hub/runners/.
/ci-runner/

# Physical worktrees and disposable work areas are machine-local.
/worktree/
/worktrees/*
!/worktrees/ARCHIVED.md
/main/
/scratch/
/targets/
/target/
/ignored/

# Retained machine-local archives from the 2026-07-23 parent cleanup.
/experiments/hermit-verify-keeplogs_20260723/
/experiments/hermit-wave7-safe_20260723/
/experiments/landing-nonreview_20260723/
/experiments/reverie-pr18-fix_20260723/
/experiments/scratch_20260723/
/experiments/target-nondet-test-framework_20260723/
/experiments/targets_20260723/
/experiments/recording-noseq_20260723/

# Vendored upstream checkouts do not belong in the parent history. Experiments
# must record source URLs + commit SHAs for reproducibility, not embed a full
# clone (a nested .git would otherwise be at risk of accidental staging).
/experiments/gvisor/

# Per-experiment scratch space (experiments/ignored/ is also covered by the
# global `ignored/` rule below; listed explicitly for discoverability).
/experiments/ignored/
**/ignored/

# Protective guards against accidentally committing large/binary experiment
# artifacts. Durable evidence stays as text (README/CSV/JSON/TSV); heavy
# outputs live under an ignored/ scratch dir or an external artifact store.
/experiments/**/*.img
/experiments/**/*.qcow2
/experiments/**/*.raw
/experiments/**/*.iso
/experiments/**/*.bin
/experiments/**/*.a
/experiments/**/*.o
/experiments/**/*.so
/experiments/**/*.tar
/experiments/**/*.tar.*
/experiments/**/*.tgz
/experiments/**/*.gz
/experiments/**/*.zip
/experiments/**/*.zst
/experiments/**/*.core
/experiments/**/core.[0-9]*
/experiments/**/bzImage
/experiments/**/vmlinux
/experiments/**/initramfs*.cpio*

# Compiled experiment fixtures are rebuilt from their checked-in *.c source;
# never commit the extensionless ELF binaries produced next to it.
/experiments/dbi_perf_leader_baseline_20260801/src/branch_heavy
/experiments/dbi_perf_leader_baseline_20260801/src/syscall_loop
/experiments/gvisor-blog-repro-v2_20260807/scripts/getpid-threads

# Heavy raw preempt-traces are bulk scratch evidence; keep the experiment's
# README/CSV/JSON summary in-tree and leave multi-MiB traces untracked.
/experiments/**/*.preempt-trace.txt

# Transient tooling output
**/__pycache__/
/debug/
!/debug/
/debug/*
!/debug/MULTISECT.md
!/debug/multisect
!/debug/test_multisect.py
*.perf.data
*.log

# High-volume per-run transcripts stay local.  Compact, durable tables are
# promoted to each experiment's results directory before publication.
/experiments/btrfs_userspace_fuzz_cases_20260728/runs/
/experiments/btrfs_userspace_logic_20260728/runs/

# ai_docs contains durable text, not binary or archive attachments.
/ai_docs/**/*.a
/ai_docs/**/*.bin
/ai_docs/**/*.bmp
/ai_docs/**/*.dll
/ai_docs/**/*.dylib
/ai_docs/**/*.exe
/ai_docs/**/*.gif
/ai_docs/**/*.gz
/ai_docs/**/*.jpeg
/ai_docs/**/*.jpg
/ai_docs/**/*.o
/ai_docs/**/*.pdf
/ai_docs/**/*.png
/ai_docs/**/*.so
/ai_docs/**/*.tar
/ai_docs/**/*.tgz
/ai_docs/**/*.webp
/ai_docs/**/*.zip
ignored/
ACTIVE.md

# Local type-checker cache files.
**/.mypy_cache/
/worktree-state.json
/worktree-state.lock

# Landing mutex runtime state (see ci-hub/landing/). Machine-local, never committed.
/.landing-lock
/.landing-lock.owner
/.landing-lock.guard
/.landing-lock.guard.*
/.landing-lock.queue
/.landing-lock.queue.*
/.landing-lock.cleanup-required
/.landing-lock.cleanup-required.tmp-*

# PR-sweep command-output capture (stdout/stderr). Transient, never committed.
/pr_sweep.out
/pr_sweep.err

# validate-lock box-exclusive admission runtime state (see ci-hub/, validate-lock
# gate). Same shape as the landing mutex above. Machine-local, never committed.
/.validate-lock
/.validate-lock.owner
/.validate-lock.guard
/.validate-lock.guard.*
/.validate-lock.queue
/.validate-lock.queue.*
/.validate-lock.cleanup-required
/.validate-lock.cleanup-required.tmp-*

# safe-ci-dag-runner runtime scratch (per-node profiles). Machine-local, never committed.
/.safe-ci-dag-runner/

# Transient ops-poll output redirected into the parent root. These are stdout/stderr
# capture files from `ci-hub health` (h.*) and pr_status runs (pr_status*), NOT tracked
# artifacts — the real script lives at ci-hub/health/pr_status.py. Root-anchored so they
# never dirty `git status`; does not match ci-hub/health/pr_status.py.
/h.err
/h.json
/pr_status*.err
/pr_status*.json
/prstatus*.err
/prstatus*.json
# A zero-byte root file left by a stray shell redirect on 2026-08-08 (almost
# certainly a truncated `critical-path` word). It holds no bytes and no work, but
# deleting another agent's file is the owner's call, so it is ignored rather than
# removed. Delete `critical` and this line together once that is confirmed.
/critical

# One-off manual snapshot taken before the compat-envelope provenance migration
# (291 KiB, 2026-08-08). A backup copy of a tracked CSV is working state, not
# durable evidence, so it stays out of history; its author may still need it on
# disk. Remove the file and this rule once the migration is settled.
/compat-envelope/*.pre-provenance-migration

# herdr-run run spools + sandbox-crossing audit log (machine-local command OUTPUT, never source)
.herdr-run/

# Compiled guest executables built by experiments (sources are tracked, binaries are not)
experiments/*/sig_alarm
experiments/*/sig_chld
experiments/*/sig_usr
experiments/*/vtime_probe
experiments/*/memaddrs
experiments/*/pid_tid
experiments/*/guest_heap
experiments/*/probe
experiments/*/pn
