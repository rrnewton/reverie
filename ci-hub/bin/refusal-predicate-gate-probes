#!/usr/bin/env python3
"""Run the measured refusal-predicate cases against any Hermit revision.

This command keeps the review evidence outside the checker: it writes each
predicate to an isolated file, checks that the predicate itself has the stated
behavior, invokes the selected checker, and reports the result separately for
every case.

Two checkers have held this line and they take different input, so the command
resolves whichever one exists at the selected revision and runs the probe set
that matches it.

``scripts/check-refusal-predicate-anchored.py`` read the SOURCE of every Python
file and refused predicates whose spelling looked unanchored.  It was deleted on
https://github.com/rrnewton/hermit/pull/2702 at
e2bcf4d1a34a142abbae5ea8cf8d162bb33a3895.  Its probes pass one file holding a
``looks_refused`` predicate, and a directory for the wrong-corpus case.

``scripts/check-validate-refusal-predicate.py`` replaced it.  It EXECUTES the
real classification in ``scripts/test_validate_stop_paths.py`` against the
checker's channel examples, so spelling no longer decides the verdict.  Its
probes pass one file defining ``ValidateChildRefused`` and ``wait_for_text``.
It takes a file rather than a directory, so the wrong-corpus case becomes a
target file that holds no classification: it must not read as a pass, which for
this checker means a ``NO-RESULT-CASE:`` line at column zero that
``ci/lint-checks-node.sh`` turns into a no_result, not exit 0 alone.
"""

from __future__ import annotations

import argparse
import contextlib
import hashlib
import subprocess
import sys
import tempfile
import textwrap
from dataclasses import dataclass
from pathlib import Path
from typing import Iterator


ROOT = Path(__file__).resolve().parents[2]
DEFAULT_HERMIT = ROOT / "hermit"
# Newest first: at a revision carrying both, the executing checker is the one
# the recipe runs.
CHECKER_GENERATIONS = (
    (Path("scripts/check-validate-refusal-predicate.py"), "executing"),
    (Path("scripts/check-refusal-predicate-anchored.py"), "source-matching"),
)
CHECKER_RELATIVE = CHECKER_GENERATIONS[1][0]


@dataclass(frozen=True)
class Probe:
    name: str
    expected_rc: int
    predicate: str
    source: str
    samples: tuple[tuple[str, bool], ...]

    @property
    def expected_word(self) -> str:
        return "REFUSED" if self.expected_rc == 1 else "OK"

    @property
    def filename(self) -> str:
        expectation = "must-refuse" if self.expected_rc == 1 else "must-pass"
        return f"{expectation}-{self.name}.py"


QUOTED_REFUSAL = "thread panicked: connection refused by: peer"
DIRECT_REFUSAL = "validate: REFUSED because a nested validate is active"
INDENTED_REFUSAL = "earlier output\n   refused by: admission\nlater output"


MUST_REFUSE = (
    Probe(
        "map-bound-contains",
        1,
        "return any(map(output.__contains__, _REFUSAL_SHAPES))",
        """
        _REFUSAL_SHAPES = ("refused by:",)
        def looks_refused(output):
            return any(map(output.__contains__, _REFUSAL_SHAPES))
        """,
        ((QUOTED_REFUSAL, True),),
    ),
    Probe(
        "operator-contains",
        1,
        "return any(operator.contains(output, shape) for shape in _REFUSAL_SHAPES)",
        """
        import operator
        _REFUSAL_SHAPES = ("refused by:",)
        def looks_refused(output):
            return any(operator.contains(output, shape) for shape in _REFUSAL_SHAPES)
        """,
        ((QUOTED_REFUSAL, True),),
    ),
    Probe(
        "imported-search",
        1,
        "return any(search(shape, output) for shape in _REFUSAL_SHAPES)",
        """
        from re import search
        _REFUSAL_SHAPES = ("refused by:",)
        def looks_refused(output):
            return any(search(shape, output) for shape in _REFUSAL_SHAPES)
        """,
        ((QUOTED_REFUSAL, True),),
    ),
    Probe(
        "unbound-find",
        1,
        "return any(str.find(output, shape) >= 0 for shape in _REFUSAL_SHAPES)",
        """
        _REFUSAL_SHAPES = ("refused by:",)
        def looks_refused(output):
            return any(str.find(output, shape) >= 0 for shape in _REFUSAL_SHAPES)
        """,
        ((QUOTED_REFUSAL, True),),
    ),
    Probe(
        "direct-bound-contains",
        1,
        "return any(output.__contains__(shape) for shape in _REFUSAL_SHAPES)",
        """
        _REFUSAL_SHAPES = ("refused by:",)
        def looks_refused(output):
            return any(output.__contains__(shape) for shape in _REFUSAL_SHAPES)
        """,
        ((QUOTED_REFUSAL, True),),
    ),
    Probe(
        "keyword-helper",
        1,
        "return any(_contains(hay=output, needle=shape) for shape in _REFUSAL_SHAPES)",
        """
        _REFUSAL_SHAPES = ("refused by:",)
        def _contains(hay, needle):
            return needle in hay
        def looks_refused(output):
            return any(
                _contains(hay=output, needle=shape)
                for shape in _REFUSAL_SHAPES
            )
        """,
        ((QUOTED_REFUSAL, True),),
    ),
    Probe(
        "constructed-marker",
        1,
        "return any(shape in output for shape in (\"refused\" + \" by:\",))",
        """
        _REFUSAL_SHAPES = ("refused" + " by:",)
        def looks_refused(output):
            return any(shape in output for shape in _REFUSAL_SHAPES)
        """,
        ((QUOTED_REFUSAL, True),),
    ),
    Probe(
        "refusal-marker-character",
        1,
        "return any(shape in output for shape in (\"🚫\",))",
        """
        _REFUSAL_SHAPES = ("🚫",)
        def looks_refused(output):
            return any(shape in output for shape in _REFUSAL_SHAPES)
        """,
        (("wrapper quoted the 🚫 marker", True),),
    ),
    Probe(
        "validate-no-result",
        1,
        "return any(shape in output for shape in _NO_RESULT_SHAPES)",
        """
        _NO_RESULT_SHAPES = ("validate NO-RESULT", "INTERRUPTED (no result)")
        def looks_refused(output):
            return any(shape in output for shape in _NO_RESULT_SHAPES)
        """,
        (("wrapper quoted validate NO-RESULT from another command", True),),
    ),
    Probe(
        "declined-by",
        1,
        "return any(shape in output for shape in (\"declined by:\", \"validate: DECLINED\"))",
        """
        _REFUSAL_SHAPES = ("declined by:", "validate: DECLINED")
        def looks_refused(output):
            return any(shape in output for shape in _REFUSAL_SHAPES)
        """,
        (("server said declined by: policy before crashing", True),),
    ),
    Probe(
        "fixed-prose-before-fullmatch",
        1,
        'return any(re.compile(r"wrapper quoted: refused by:.*").fullmatch(line) '
        "for line in output.splitlines())",
        """
        import re
        _REFUSAL_SUMMARY = re.compile(r"wrapper quoted: refused by:.*")
        def looks_refused(output):
            return any(
                _REFUSAL_SUMMARY.fullmatch(line)
                for line in output.splitlines()
            )
        """,
        (("wrapper quoted: refused by: firewall", True),),
    ),
)


MUST_PASS = (
    Probe(
        "assigned-splitlines",
        0,
        "lines = output.splitlines(); line.strip().startswith(shape)",
        """
        _REFUSAL_SHAPES = ("refused by:", "validate: REFUSED")
        def looks_refused(output):
            lines = output.splitlines()
            return any(
                line.strip().startswith(shape)
                for line in lines
                for shape in _REFUSAL_SHAPES
            )
        """,
        (
            (QUOTED_REFUSAL, False),
            (INDENTED_REFUSAL, True),
            (DIRECT_REFUSAL, True),
        ),
    ),
    Probe(
        "split-newline",
        0,
        'line.strip().startswith(shape) for line in output.split("\\n")',
        """
        _REFUSAL_SHAPES = ("refused by:", "validate: REFUSED")
        def looks_refused(output):
            return any(
                line.strip().startswith(shape)
                for line in output.split("\\n")
                for shape in _REFUSAL_SHAPES
            )
        """,
        (
            (QUOTED_REFUSAL, False),
            (INDENTED_REFUSAL, True),
            (DIRECT_REFUSAL, True),
        ),
    ),
    Probe(
        "spaces-before-marker-regex",
        0,
        're.search(r"^ *(?:refused by:|validate: REFUSED)", output, re.MULTILINE)',
        """
        import re
        def looks_refused(output):
            return bool(re.search(
                r"^ *(?:refused by:|validate: REFUSED)",
                output,
                re.MULTILINE,
            ))
        """,
        (
            (QUOTED_REFUSAL, False),
            (INDENTED_REFUSAL, True),
            (DIRECT_REFUSAL, True),
        ),
    ),
    Probe(
        "safe-exact-membership",
        0,
        "return output in _REFUSAL_SHAPES",
        """
        _REFUSAL_SHAPES = ("refused by:", "validate: REFUSED")
        def looks_refused(output):
            return output in _REFUSAL_SHAPES
        """,
        (
            (QUOTED_REFUSAL, False),
            ("refused by:", True),
        ),
    ),
)


PROBES = MUST_REFUSE + MUST_PASS


def normalized_source(source: str) -> str:
    return textwrap.dedent(source).lstrip("\n").rstrip() + "\n"


def behavior_errors(probe: Probe, path: Path) -> list[str]:
    namespace: dict[str, object] = {"__file__": str(path), "__name__": "probe"}
    try:
        exec(compile(path.read_text(encoding="utf-8"), str(path), "exec"), namespace)
        predicate = namespace["looks_refused"]
    except Exception as error:
        return [f"fixture could not load: {type(error).__name__}: {error}"]
    errors = []
    for sample, wanted in probe.samples:
        try:
            observed = bool(predicate(sample))  # type: ignore[operator]
        except Exception as error:
            errors.append(f"fixture raised {type(error).__name__}: {error}")
            continue
        if observed != wanted:
            errors.append(
                f"fixture returned {observed}, expected {wanted}, for {sample!r}"
            )
    return errors


def run_checker(checker: Path, target: Path) -> tuple[int, str]:
    completed = subprocess.run(
        [sys.executable, str(checker), str(target)],
        capture_output=True,
        text=True,
        timeout=60,
    )
    return completed.returncode, completed.stdout + completed.stderr


def first_output_line(output: str) -> str:
    return next((line.strip() for line in output.splitlines() if line.strip()), "<no output>")


def checker_word(rc: int) -> str:
    if rc == 0:
        return "OK"
    if rc == 1:
        return "REFUSED"
    return "ERROR"


def run_probes(checker: Path) -> int:
    failures = 0
    total = 0
    with tempfile.TemporaryDirectory(prefix="refusal-predicate-gate-probes-") as raw:
        root = Path(raw)
        for probe in PROBES:
            total += 1
            fixture = root / probe.filename
            fixture.write_text(normalized_source(probe.source), encoding="utf-8")
            fixture_errors = behavior_errors(probe, fixture)
            rc, output = run_checker(checker, fixture)
            ok = not fixture_errors and rc == probe.expected_rc
            print(
                f"{'PASS' if ok else 'FAIL'} {probe.name}: expected checker "
                f"{probe.expected_word} rc={probe.expected_rc}, got "
                f"{checker_word(rc)} rc={rc}"
            )
            print(f"  predicate: {probe.predicate}")
            for error in fixture_errors:
                print(f"  fixture: {error}")
            if not ok:
                print(f"  checker: {first_output_line(output)}")
                failures += 1

        total += 1
        wrong = root / "wrong-nonempty-directory"
        wrong.mkdir()
        (wrong / "harmless.py").write_text("value = 1\n", encoding="utf-8")
        rc, output = run_checker(checker, wrong)
        ok = rc == 1
        print(
            f"{'PASS' if ok else 'FAIL'} wrong-nonempty-directory: expected checker "
            f"REFUSED rc=1, got {checker_word(rc)} rc={rc}"
        )
        print("  predicate: protected refusal predicate is absent from a nonempty Python corpus")
        if not ok:
            print(f"  checker: {first_output_line(output)}")
            failures += 1

    print()
    print(f"probes: {total}  passed: {total - failures}  failed: {failures}")
    print("RESULT: PASS" if failures == 0 else "RESULT: FAIL")
    return 0 if failures == 0 else 1



# ── the executing checker's probes ────────────────────────────────────────────
#
# This checker loads the target module and drives its real consumer, so a probe
# is a whole classification, not a predicate in isolation.  Every probe below was
# measured.  The cases that must be refused include predicates that turned from
# refused to OK when marker detection moved from the collection's NAME to a list
# of five literals, and the cases that must pass are correct predicates the
# source-matching checker refused for their spelling.

EXECUTING_SHELL = """
FINAL_VALIDATE_STATUS_PREFIX = "FINAL_VALIDATE_STATUS: "
FINAL_VALIDATE_STATUSES = frozenset(("PASSED", "FAILED", "COULD_NOT_RUN"))
NO_RESULT_EXIT_CODE = 75
class ValidateChildRefused(RuntimeError):
    pass
def final_validate_status(output):
    matches = [
        line.removeprefix(FINAL_VALIDATE_STATUS_PREFIX)
        for line in output.splitlines()
        if line.startswith(FINAL_VALIDATE_STATUS_PREFIX)
    ]
    if not matches:
        return None
    status = matches[-1]
    if status not in FINAL_VALIDATE_STATUSES:
        raise AssertionError("unknown final status")
    return status
{body}
def wait_for_text(log, marker, proc):
    if child_hit_reentrancy_refusal(log.read_text(), proc.returncode):
        raise ValidateChildRefused("refused")
    raise AssertionError("ordinary failure")
"""

_SUMMARY_RE = (
    'r"\\U0001F6AB validate REFUSED \\(exit 75\\)'
    ' \\u2014 profile .+ @ (?:[0-9a-f]{40}|unknown)"'
)
_GENUINE = (
    "\U0001F6AB validate REFUSED (exit 75) \u2014 profile strict @ "
    + "0123456789abcdef0123456789abcdef01234567\n"
    + "   refused by: the re-entrancy guard\n"
    + "   nodes: none executed (stopped before the DAG ran)\n"
    + "FINAL_VALIDATE_STATUS: COULD_NOT_RUN\n"
)
_UNKNOWN_COMMIT = (
    "\U0001F6AB validate REFUSED (exit 75) \u2014 profile full @ unknown\n"
    + "   refused by: the re-entrancy guard\n"
    + "FINAL_VALIDATE_STATUS: COULD_NOT_RUN\n"
)
_WRAPPED = "wrapper: " + _GENUINE
_QUOTED_DOC = (
    "\U0001F6AB validate REFUSED is quoted documentation, not a final summary\n"
    + "   refused by: the re-entrancy guard\n"
    + "FINAL_VALIDATE_STATUS: COULD_NOT_RUN\n"
)
_BAD_ARGUMENTS = (
    "\U0001F6AB validate REFUSED (exit 75) \u2014 profile full @ "
    + "0123456789abcdef0123456789abcdef01234567\n"
    + "   refused by: argument parsing\n"
    + "FINAL_VALIDATE_STATUS: COULD_NOT_RUN\n"
)
_STATUS_ONLY = "FINAL_VALIDATE_STATUS: COULD_NOT_RUN\n"
_EARLIER_STATUS = (
    "FINAL_VALIDATE_STATUS: COULD_NOT_RUN\n"
    "quoted earlier\n"
    "FINAL_VALIDATE_STATUS: FAILED\n"
)


def _whole_channel(collection: str, values: str) -> str:
    return (
        f"{collection} = {values}\n"
        "def child_hit_reentrancy_refusal(output, returncode):\n"
        f"    return any(s in output for s in {collection})"
    )


EXECUTING_MUST_REFUSE = (
    ("marker-character-only",
     'the refusal marker character alone, matched against the whole channel',
     _whole_channel("_REFUSAL_SHAPES", '("\\U0001F6AB",)')),
    ("sibling-verdict-words",
     '("validate NO-RESULT", "INTERRUPTED (no result)"), whole channel',
     _whole_channel("_REFUSAL_SHAPES",
                    '("validate NO-RESULT", "INTERRUPTED (no result)")')),
    ("restated-marker",
     '("declined by:", "validate: DECLINED"), whole channel',
     _whole_channel("_REFUSAL_SHAPES", '("declined by:", "validate: DECLINED")')),
    ("decline-named-collection",
     '_DECLINE_MARKERS = ("would not run:",), whole channel',
     _whole_channel("_DECLINE_MARKERS", '("would not run:",)')),
    ("verdict-named-collection",
     'VERDICT_STRINGS = ("could not evaluate",), whole channel',
     _whole_channel("VERDICT_STRINGS", '("could not evaluate",)')),
    ("marker-named-regex-search",
     '_REFUSAL_PATTERNS under re.search, whole channel',
     'import re\n_REFUSAL_PATTERNS = ("gave up:",)\n'
     'def child_hit_reentrancy_refusal(output, returncode):\n'
     '    return any(re.search(p, output) for p in _REFUSAL_PATTERNS)'),
    ("marker-named-find",
     '_REFUSAL_SHAPES under output.find, whole channel',
     '_REFUSAL_SHAPES = ("skipped by policy",)\n'
     'def child_hit_reentrancy_refusal(output, returncode):\n'
     '    return any(output.find(s) >= 0 for s in _REFUSAL_SHAPES)'),
    # ⚠️ THIS PROBE USES THE REAL MARKER, AND THAT IS THE WHOLE POINT.
    # It previously keyed on "halted:", a string no sample contains, so it was
    # refused because it MISSED both genuine refusals -- not because a line-start
    # match on an incomplete summary is wrong. Substituting the real marker made
    # it PASS, which means the probe named one class and tested another. A test
    # that goes red for a reason other than the one it names is as bad as one
    # that goes green without checking; it just does not announce itself.
    ("marker-named-bare-startswith",
     'startswith the real marker: anchored to the line, but not the WHOLE line',
     '_REFUSAL_SHAPES = ("\\U0001F6AB validate REFUSED",)\n'
     'def child_hit_reentrancy_refusal(output, returncode):\n'
     '    return any(l.startswith(s) for l in output.splitlines()'
     ' for s in _REFUSAL_SHAPES)'),
    ("space-star-indent",
     'the complete summary with optional spaces, without child status or reason',
     'import re\n_S = re.compile(r"^ *\\U0001F6AB validate REFUSED'
     ' \\(exit 75\\) \\u2014 profile .+ @ (?:[0-9a-f]{40}|unknown)$",'
     ' re.MULTILINE)\n'
     'def child_hit_reentrancy_refusal(output, returncode):\n'
     '    return bool(_S.search(output))'),
    ("whole-channel-original-defect",
     'the original defect: refusal text anywhere in the channel',
     _whole_channel("_REFUSAL_SHAPES", '("refused by:", "validate: REFUSED")')),
    ("final-status-only",
     'the final could-not-run status and exit 75, without the refusal reason',
     'def child_hit_reentrancy_refusal(output, returncode):\n'
     '    return (final_validate_status(output) == "COULD_NOT_RUN" '
     'and returncode == 75)'),
)

EXECUTING_MUST_PASS = (
    ("splitlines-bound-to-a-name",
     'split lines, then match the summary, child exit, and following reason',
     'import re\n_S = re.compile(' + _SUMMARY_RE + ')\n'
     '_R = "   refused by: the re-entrancy guard"\n'
     'def child_hit_reentrancy_refusal(output, returncode):\n'
     '    if returncode != 75 or final_validate_status(output) '
     '!= "COULD_NOT_RUN":\n'
     '        return False\n'
     '    lines = output.splitlines()\n'
     '    status = max(i for i, line in enumerate(lines) '
     'if line.startswith(FINAL_VALIDATE_STATUS_PREFIX))\n'
     '    summaries = [i for i, line in enumerate(lines[:status]) '
     'if _S.fullmatch(line)]\n'
     '    return bool(summaries and lines[summaries[-1] + 1:'
     'summaries[-1] + 2] == [_R])'),
    ("split-on-newline",
     'split on newline, then match the summary, child exit, and following reason',
     'import re\n_S = re.compile(' + _SUMMARY_RE + ')\n'
     '_R = "   refused by: the re-entrancy guard"\n'
     'def child_hit_reentrancy_refusal(output, returncode):\n'
     '    if returncode != 75 or final_validate_status(output) '
     '!= "COULD_NOT_RUN":\n'
     '        return False\n'
     '    lines = output.split(chr(10))\n'
     '    status = max(i for i, line in enumerate(lines) '
     'if line.startswith(FINAL_VALIDATE_STATUS_PREFIX))\n'
     '    summaries = [i for i, line in enumerate(lines[:status]) '
     'if _S.fullmatch(line)]\n'
     '    return bool(summaries and lines[summaries[-1] + 1:'
     'summaries[-1] + 2] == [_R])'),
    ("reverse-scan",
     'scan backward from the final status to the last complete refusal summary',
     'import re\n_S = re.compile(' + _SUMMARY_RE + ')\n'
     '_R = "   refused by: the re-entrancy guard"\n'
     'def child_hit_reentrancy_refusal(output, returncode):\n'
     '    if returncode != 75 or final_validate_status(output) '
     '!= "COULD_NOT_RUN":\n'
     '        return False\n'
     '    lines = output.splitlines()\n'
     '    status = max(i for i, line in enumerate(lines) '
     'if line.startswith(FINAL_VALIDATE_STATUS_PREFIX))\n'
     '    for index in range(status - 1, -1, -1):\n'
     '        if _S.fullmatch(lines[index]):\n'
     '            return lines[index + 1:index + 2] == [_R]\n'
     '    return False'),
)

# Both directions have to be exercised by the same samples, or a predicate that
# never fires would look correct.
EXECUTING_SAMPLES = (
    ("thread 'main' panicked at src/x.rs:9: connection refused by: peer", 1, False),
    ("guest: server said 'refused by: firewall'", 1, False),
    ("error: /tmp/validate: REFUSED_cases/t.rs not found", 1, False),
    ("refused by: guest firewall policy", 1, False),
    ("   refused by: guest firewall policy", 1, False),
    ("validate: REFUSED_cases is a guest label", 1, False),
    ("another validate is already running in documentation", 1, False),
    (_WRAPPED, 75, False),
    ("thread panicked: connection refused by: peer", 1, False),
    # ⚠️ THE CASE THAT SEPARATES "starts the line" FROM "is the line". The marker
    # opens this line at column zero, so a startswith match fires, but the line is
    # documentation rather than a final summary. Without it a predicate that
    # anchors to the line start without requiring the complete summary classifies
    # every sample here correctly and reads as safe.
    (_QUOTED_DOC, 75, False),
    (_BAD_ARGUMENTS, 75, False),
    (_GENUINE, 1, False),
    (_STATUS_ONLY, 75, False),
    (_EARLIER_STATUS, 1, False),
    (_GENUINE, 75, True),
    (_UNKNOWN_COMMIT, 75, True),
    (
        "wrapper mentioned validate: REFUSED and FINAL_VALIDATE_STATUS: FAILED\n"
        + _GENUINE,
        75,
        True,
    ),
)


def executing_behavior_errors(source: str, path: Path, wanted_correct: bool) -> list[str]:
    """Check the fixture itself, so a mislabeled probe cannot create evidence."""
    namespace: dict[str, object] = {"__file__": str(path), "__name__": "probe"}
    try:
        exec(compile(source, str(path), "exec"), namespace)
        predicate = namespace["child_hit_reentrancy_refusal"]
    except Exception as error:
        return [f"fixture could not load: {type(error).__name__}: {error}"]
    observed = []
    for sample, returncode, wanted in EXECUTING_SAMPLES:
        try:
            observed.append(
                bool(predicate(sample, returncode)) == wanted  # type: ignore[operator]
            )
        except Exception as error:
            return [f"fixture raised {type(error).__name__}: {error}"]
    if wanted_correct and not all(observed):
        return ["fixture labelled correct but misclassifies its own samples"]
    if not wanted_correct and all(observed):
        return ["fixture labelled unsafe but classifies its own samples correctly"]
    return []


def run_executing_probes(checker: Path) -> int:
    failures = 0
    total = 0
    with tempfile.TemporaryDirectory(prefix="refusal-predicate-gate-probes-") as raw:
        root = Path(raw)

        def one(name: str, predicate: str, body: str, expected_rc: int) -> None:
            nonlocal failures, total
            total += 1
            wanted_correct = expected_rc == 0
            expectation = "must-pass" if wanted_correct else "must-refuse"
            case = root / f"{expectation}-{name}"
            case.mkdir()
            fixture = case / "test_validate_stop_paths.py"
            source = EXECUTING_SHELL.format(body=body)
            fixture.write_text(source, encoding="utf-8")
            fixture_errors = executing_behavior_errors(source, fixture, wanted_correct)
            rc, output = run_checker(checker, fixture)
            ok = not fixture_errors and rc == expected_rc
            print(
                f"{'PASS' if ok else 'FAIL'} {name}: expected checker "
                f"{'OK' if wanted_correct else 'REFUSED'} rc={expected_rc}, got "
                f"{checker_word(rc)} rc={rc}"
            )
            print(f"  predicate: {predicate}")
            for error in fixture_errors:
                print(f"  fixture: {error}")
            if not ok:
                print(f"  checker: {first_output_line(output)}")
                failures += 1

        for name, predicate, body in EXECUTING_MUST_REFUSE:
            one(name, predicate, body, 1)
        for name, predicate, body in EXECUTING_MUST_PASS:
            one(name, predicate, body, 0)

        # ⚠️ The wrong-corpus case for this checker. It takes a file, so the
        # equivalent of a wrong nonempty directory is a real, nonempty target that
        # holds no classification. Exit 0 ALONE is not the question: the node
        # reads a NO-RESULT-CASE: line at column zero and reports no_result. A
        # bare exit 0 with no marker is the failure this probe exists for.
        total += 1
        absent = root / "target-without-a-classification"
        absent.mkdir()
        fixture = absent / "test_validate_stop_paths.py"
        fixture.write_text("value = 1\n", encoding="utf-8")
        rc, output = run_checker(checker, fixture)
        marked = any(
            line.startswith("NO-RESULT-CASE:") for line in output.splitlines()
        )
        ok = rc != 0 or marked
        node = "fail" if rc != 0 else ("no_result" if marked else "pass")
        print(
            f"{'PASS' if ok else 'FAIL'} target-without-a-classification: expected "
            f"the node NOT to read a pass, got node {node} (rc={rc})"
        )
        print(
            "  predicate: a real, nonempty target file holding no refusal "
            "classification at all"
        )
        if not ok:
            print(f"  checker: {first_output_line(output)}")
            failures += 1

    print()
    print(f"probes: {total}  passed: {total - failures}  failed: {failures}")
    print("RESULT: PASS" if failures == 0 else "RESULT: FAIL")
    return 0 if failures == 0 else 1


def git(repo: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(repo), *args], capture_output=True, text=True, timeout=30
    )


@contextlib.contextmanager
def selected_checker(repo: Path, rev: str | None) -> Iterator[tuple[Path, str, Path, str]]:
    if rev is None:
        for relative, kind in CHECKER_GENERATIONS:
            checker = repo / relative
            if checker.is_file():
                break
        else:
            names = ", ".join(str(r) for r, _ in CHECKER_GENERATIONS)
            raise ValueError(f"no refusal checker found in {repo}; looked for {names}")
        resolved = git(repo, "rev-parse", "HEAD")
        identity = resolved.stdout.strip() if resolved.returncode == 0 else "working tree"
        dirty = git(repo, "status", "--porcelain", "--", str(relative))
        if dirty.returncode == 0 and dirty.stdout.strip():
            identity += "-dirty"
        yield checker, identity, relative, kind
        return

    resolved = git(repo, "rev-parse", "--verify", f"{rev}^{{commit}}")
    if resolved.returncode != 0 or not resolved.stdout.strip():
        raise ValueError(
            f"cannot resolve Hermit revision {rev!r}: {resolved.stderr.strip()}"
        )
    exact = resolved.stdout.strip()
    for relative, kind in CHECKER_GENERATIONS:
        shown = git(repo, "show", f"{exact}:{relative.as_posix()}")
        if shown.returncode == 0:
            break
    else:
        names = ", ".join(str(r) for r, _ in CHECKER_GENERATIONS)
        raise ValueError(f"no refusal checker at {exact}; looked for {names}")
    with tempfile.TemporaryDirectory(prefix="refusal-predicate-checker-") as raw:
        checker = Path(raw) / relative.name
        checker.write_text(shown.stdout, encoding="utf-8")
        yield checker, exact, relative, kind


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Run the measured refusal-predicate cases against a Hermit checkout "
            "or an exact revision."
        )
    )
    parser.add_argument(
        "repo",
        nargs="?",
        type=Path,
        default=DEFAULT_HERMIT,
        help=f"Hermit repository (default: {DEFAULT_HERMIT})",
    )
    parser.add_argument(
        "--rev",
        help="Hermit commit to read without changing the checkout; default uses its working tree",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    repo = args.repo.resolve()
    if not repo.is_dir():
        print(
            f"refusal-predicate-gate-probes: no such Hermit repository: {repo}. "
            "Pass the path to an existing Hermit checkout, then retry.",
            file=sys.stderr,
        )
        return 2
    try:
        with selected_checker(repo, args.rev) as (checker, identity, relative, kind):
            print(f"Hermit: {repo}")
            print(f"revision: {identity}")
            print(f"checker: {relative}  ({kind})")
            print(f"checker sha256: {hashlib.sha256(checker.read_bytes()).hexdigest()}")
            print()
            if kind == "executing":
                return run_executing_probes(checker)
            return run_probes(checker)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        print(f"refusal-predicate-gate-probes: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
