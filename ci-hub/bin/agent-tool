#!/usr/bin/env bash
# Run a tool from the agent-utils commit pinned by dev-hermit's Hermit pin.
# tick-hub may use a different clean checkout commit only when its complete
# tracked Python entrypoint and package have the exact same Git objects.
set -euo pipefail

TOOL=${1:-}

usage() {
    cat <<'EOF'
usage: ci-hub/bin/agent-tool <dagrun|pr-landing-planner|safe-ci-dag-runner|tick-hub> [args...]

Run one agent-utils tool from the commit selected by dev-hermit's Hermit pin.
Pin authority is DEV_HERMIT_TOOL_ROOT's exact HEAD when set, otherwise a fresh
parent origin/main fetch. DEV_HERMIT_PARENT may name a separate state checkout.
For that tool's options, choose its name above and append --help.
EOF
}

case "$TOOL" in
    dagrun|pr-landing-planner|safe-ci-dag-runner|tick-hub) ;;
    help|-h|--help)
        usage
        exit 0
        ;;
    "")
        echo "agent-tool: missing tool name; choose one of the four names below." >&2
        usage >&2
        exit 2
        ;;
    *)
        echo "agent-tool: unknown tool '$TOOL'; choose one of the four names below." >&2
        usage >&2
        exit 2
        ;;
esac
shift

die() {
    echo "agent-tool: $*" >&2
    exit 1
}

if ! SCRIPT_ROOT=$(git -C "$(dirname -- "${BASH_SOURCE[0]}")/../.." \
    rev-parse --show-toplevel 2>/dev/null); then
    die "cannot resolve the dev-hermit tool root containing ${BASH_SOURCE[0]}"
fi
STATE_ROOT_INPUT=${DEV_HERMIT_PARENT:-$SCRIPT_ROOT}
if ! ROOT=$(git -C "$STATE_ROOT_INPUT" rev-parse --show-toplevel 2>/dev/null); then
    die "DEV_HERMIT_PARENT '$STATE_ROOT_INPUT' is not a dev-hermit Git checkout"
fi
HERMIT="$ROOT/hermit"
AGENT_UTILS="$ROOT/agent-utils"
AGENT_UTILS_LINK_TARGET="hermit/agent-utils"

run_networked() {
    if command -v with-proxy >/dev/null 2>&1; then
        with-proxy "$@"
    else
        "$@"
    fi
}

gitlink_at() {
    local repo=$1 tree=$2 path=$3 description=$4 entry mode kind object entry_path extra
    if ! entry=$(git -C "$repo" ls-tree "$tree" -- "$path" 2>/dev/null); then
        die "cannot inspect $description for $path"
    fi
    read -r mode kind object entry_path extra <<<"$entry"
    if [[ $mode != 160000 || $kind != commit || $entry_path != "$path" || -n ${extra:-} \
          || ! $object =~ ^[0-9a-f]{40}$ ]]; then
        die "$description has no gitlink at $path (got ${entry:-no entry})"
    fi
    printf '%s\n' "$object"
}

PIN_SOURCE_TEMP_ROOT=""
PIN_SOURCE_TEMP_REF=""
PIN_SOURCE_TEMP_OID=""

cleanup_pin_source_ref() {
    local original_rc=$1 current ref_rc cleanup_rc=0
    trap - EXIT INT TERM
    if [[ -z $PIN_SOURCE_TEMP_REF ]]; then
        return "$original_rc"
    fi

    if current=$(git -C "$PIN_SOURCE_TEMP_ROOT" rev-parse --verify --quiet \
        "$PIN_SOURCE_TEMP_REF"); then
        if [[ $current != "$PIN_SOURCE_TEMP_OID" ]]; then
            echo "agent-tool: WARNING: refusing to remove private pin-source ref $PIN_SOURCE_TEMP_REF: expected $PIN_SOURCE_TEMP_OID, found $current" >&2
            cleanup_rc=1
        elif git -C "$PIN_SOURCE_TEMP_ROOT" update-ref --no-deref -d \
            "$PIN_SOURCE_TEMP_REF" "$PIN_SOURCE_TEMP_OID"; then
            PIN_SOURCE_TEMP_REF=""
            PIN_SOURCE_TEMP_OID=""
            PIN_SOURCE_TEMP_ROOT=""
        else
            echo "agent-tool: WARNING: could not remove private pin-source ref $PIN_SOURCE_TEMP_REF at expected $PIN_SOURCE_TEMP_OID" >&2
            cleanup_rc=1
        fi
    else
        ref_rc=$?
        if [[ $ref_rc -eq 1 ]]; then
            PIN_SOURCE_TEMP_REF=""
            PIN_SOURCE_TEMP_OID=""
            PIN_SOURCE_TEMP_ROOT=""
        else
            echo "agent-tool: WARNING: could not inspect private pin-source ref $PIN_SOURCE_TEMP_REF before cleanup" >&2
            cleanup_rc=1
        fi
    fi

    if [[ $original_rc -ne 0 ]]; then
        return "$original_rc"
    fi
    return "$cleanup_rc"
}

pin_source_exit() {
    local original_rc=$? final_rc
    if cleanup_pin_source_ref "$original_rc"; then
        final_rc=0
    else
        final_rc=$?
    fi
    exit "$final_rc"
}

pin_source_signal() {
    local signal_rc=$1 final_rc
    if cleanup_pin_source_ref "$signal_rc"; then
        final_rc=0
    else
        final_rc=$?
    fi
    exit "$final_rc"
}

arm_pin_source_cleanup() {
    trap pin_source_exit EXIT
    trap 'pin_source_signal 130' INT
    trap 'pin_source_signal 143' TERM
}

select_pin_source() {
    local pin_root_input fetch_ref remote_listing remote_url remote_ref extra
    local -a remote_lines
    if [[ -n ${DEV_HERMIT_TOOL_ROOT:-} ]]; then
        pin_root_input=$DEV_HERMIT_TOOL_ROOT
        if ! PIN_ROOT=$(git -C "$pin_root_input" rev-parse --show-toplevel 2>/dev/null); then
            die "DEV_HERMIT_TOOL_ROOT '$pin_root_input' is not a dev-hermit Git checkout"
        fi
        if ! PIN_SOURCE_COMMIT=$(git -C "$PIN_ROOT" rev-parse --verify 'HEAD^{commit}' 2>/dev/null); then
            die "cannot resolve immutable HEAD in DEV_HERMIT_TOOL_ROOT $PIN_ROOT"
        fi
        PIN_SOURCE_DESCRIPTION="immutable tool root $PIN_ROOT at HEAD $PIN_SOURCE_COMMIT"
        return
    fi

    # The durable health tick normally runs from the shared primary, whose HEAD
    # may stay behind indefinitely because advancing its product gitlinks would
    # overwrite another agent's work. Fetch main into a process-private ref and
    # immediately collapse that mutable ref to one exact commit. Never derive a
    # reviewed tool pin from the stale state checkout's HEAD.
    PIN_ROOT=$ROOT
    fetch_ref="refs/ci-hub/agent-tool-pin/${BASHPID}-${RANDOM}"
    if ! remote_url=$(git -C "$PIN_ROOT" remote get-url origin 2>/dev/null); then
        die "cannot resolve the agent-utils pin: $PIN_ROOT has no readable origin fetch URL; stale local HEAD was not used"
    fi
    # Fetch by URL rather than by the configured remote name. Git otherwise
    # also updates refs/remotes/origin/main opportunistically, even with an
    # explicit destination, creating a shared-ref race across linked worktrees.
    if ! remote_listing=$(run_networked git -C "$PIN_ROOT" ls-remote \
        --exit-code --refs "$remote_url" refs/heads/main); then
        die "cannot resolve the agent-utils pin: live origin/main query failed in $PIN_ROOT; stale local HEAD was not used"
    fi
    mapfile -t remote_lines <<<"$remote_listing"
    if [[ ${#remote_lines[@]} -ne 1 ]]; then
        die "cannot resolve the agent-utils pin: live origin/main query returned ${#remote_lines[@]} records; stale local HEAD was not used"
    fi
    read -r PIN_SOURCE_TEMP_OID remote_ref extra <<<"${remote_lines[0]}"
    if [[ ! $PIN_SOURCE_TEMP_OID =~ ^[0-9a-f]{40}$ \
          || $remote_ref != refs/heads/main || -n ${extra:-} ]]; then
        die "cannot resolve the agent-utils pin: malformed origin/main response '${remote_lines[0]}'; stale local HEAD was not used"
    fi

    PIN_SOURCE_TEMP_ROOT=$PIN_ROOT
    PIN_SOURCE_TEMP_REF=$fetch_ref
    arm_pin_source_cleanup
    if ! run_networked git -C "$PIN_ROOT" fetch --quiet --no-tags \
        --no-write-fetch-head "$remote_url" "$PIN_SOURCE_TEMP_OID"; then
        die "cannot resolve the agent-utils pin: fresh fetch of origin/main failed in $PIN_ROOT; stale local HEAD was not used"
    fi
    if ! git -C "$PIN_ROOT" cat-file -e "$PIN_SOURCE_TEMP_OID^{commit}" 2>/dev/null; then
        die "fresh origin/main fetch did not provide commit $PIN_SOURCE_TEMP_OID"
    fi
    if ! git -C "$PIN_ROOT" update-ref --no-deref "$PIN_SOURCE_TEMP_REF" \
        "$PIN_SOURCE_TEMP_OID" 0000000000000000000000000000000000000000; then
        die "cannot create private pin-source ref $PIN_SOURCE_TEMP_REF at $PIN_SOURCE_TEMP_OID"
    fi
    PIN_SOURCE_COMMIT=$PIN_SOURCE_TEMP_OID
    PIN_SOURCE_DESCRIPTION="freshly fetched origin/main commit $PIN_SOURCE_COMMIT in $PIN_ROOT"
}

if [[ ! -L $AGENT_UTILS ]]; then
    die "$AGENT_UTILS is not the tracked compatibility symlink; expected 'agent-utils -> $AGENT_UTILS_LINK_TARGET'"
fi
ACTUAL_LINK=$(readlink "$AGENT_UTILS")
if [[ $ACTUAL_LINK != "$AGENT_UTILS_LINK_TARGET" ]]; then
    die "$AGENT_UTILS points to '$ACTUAL_LINK'; expected exact relative target '$AGENT_UTILS_LINK_TARGET'"
fi

select_pin_source
PARENT_HERMIT=$(gitlink_at "$PIN_ROOT" "$PIN_SOURCE_COMMIT" hermit \
    "$PIN_SOURCE_DESCRIPTION")
STATE_PARENT_HEAD=$(git -C "$ROOT" rev-parse --verify 'HEAD^{commit}' 2>/dev/null || echo unknown)
if [[ $PIN_ROOT != "$ROOT" || $PIN_SOURCE_COMMIT != "$STATE_PARENT_HEAD" ]]; then
    echo "agent-tool: pin source is $PIN_SOURCE_DESCRIPTION; state root HEAD $STATE_PARENT_HEAD remains untouched." >&2
fi
if [[ ! -e $HERMIT/.git ]]; then
    if [[ $PIN_ROOT != "$ROOT" || $PIN_SOURCE_COMMIT != "$STATE_PARENT_HEAD" ]]; then
        die "cannot reconcile $PIN_SOURCE_DESCRIPTION: state checkout $HERMIT is not initialized, and initializing it from stale state-root HEAD $STATE_PARENT_HEAD would select the wrong Hermit commit $PARENT_HERMIT; no checkout was moved"
    fi
    update_hermit=(git -C "$ROOT" submodule update --init --checkout -- hermit)
    run_networked "${update_hermit[@]}" \
        || die "could not initialize Hermit checkout recorded by $PIN_SOURCE_DESCRIPTION; rerun '${update_hermit[*]}'"
fi
if [[ ! -e $HERMIT/.git ]]; then
    die "$HERMIT is not initialized; run 'git -C $ROOT submodule update --init --checkout -- hermit'"
fi
if ! git -C "$HERMIT" cat-file -e "$PARENT_HERMIT^{commit}" 2>/dev/null; then
    die "cannot reconcile $PIN_SOURCE_DESCRIPTION: it records Hermit $PARENT_HERMIT, but state checkout $HERMIT does not contain that commit; run 'with-proxy git -C $HERMIT fetch origin $PARENT_HERMIT', then rerun; no checkout was moved"
fi
EXPECTED=$(gitlink_at "$HERMIT" "$PARENT_HERMIT" agent-utils \
    "Hermit commit $PARENT_HERMIT selected by $PIN_SOURCE_DESCRIPTION")
if ! cleanup_pin_source_ref 0; then
    die "pin resolution completed, but private pin-source ref cleanup was unsafe; refusing to run $TOOL"
fi

# REPORTERS DEGRADE, ACTORS REFUSE.
#
# The pin exists so a tool runs reviewed code. A dirty agent-utils breaks that
# PROVENANCE claim -- but the cost of refusing is not the same for every tool,
# and treating them alike is what caused the outage this guard now prevents.
#
# Direct-to-main is the DOCUMENTED workflow for agent-utils, so agents are
# EXPECTED to edit that checkout. A transient dirty tree there is a normal
# operating condition, not an anomaly. Under the old rule, doing the sanctioned
# thing took down the fleet's only monitoring, with no warning anywhere: the
# tick-hub RUNNER is itself an agent-utils tool, so one dirty file stopped every
# gate -- PR health, main authority, pin state -- from being evaluated at all.
# We caught both of 2026-08-08's red waves BECAUSE the tick was reporting.
#
# So the line is drawn on CONSEQUENCE, not on tidiness:
#   REPORTERS read and print. Running them unpinned risks a wrong REPORT, which
#     is visible and correctable. Their silence is worse than their imprecision,
#     because silence is indistinguishable from health.
#   ACTORS execute work. Running them unpinned risks unreviewed code doing
#     something, which is not correctable after the fact.
# This is the same asymmetry the refire futility probe uses: it fails OPEN
# because it withholds an ACTION, while the pin gate fails CLOSED because it
# authorizes one.
case "$TOOL" in
    tick-hub|pr-landing-planner) AGENT_TOOL_ROLE=reporter ;;
    *)                           AGENT_TOOL_ROLE=actor ;;
esac


# Say WHICH checks the dirt invalidates, at the point of dirt, and either refuse
# (actor) or proceed with provenance marked UNDETERMINED (reporter). Never
# proceed silently: a report that looks complete is the worse error.
agent_utils_dirt() {
    local where=$1 paths
    paths=$(git -C "$AGENT_UTILS" status --porcelain | wc -l | tr -d ' ')
    {
        echo "agent-tool: agent-utils is dirty $where ($paths path(s) modified)."
        echo "agent-tool: INVALIDATED -- provenance of the '$TOOL' tool itself:"
        echo "agent-tool:   it will NOT be the reviewed, pinned agent-utils commit."
        echo "agent-tool: NOT invalidated -- every check whose logic lives in this"
        echo "agent-tool:   parent repo (PR health, main authority, pin state, gates)."
        git -C "$AGENT_UTILS" status --porcelain | sed 's/^/agent-tool:   dirty: /'
    } >&2
    if [[ $AGENT_TOOL_ROLE == actor ]]; then
        echo "agent-tool: '$TOOL' EXECUTES work, so it REFUSES to run unpinned. Commit or stash agent-utils." >&2
        exit 1
    fi
    echo "agent-tool: '$TOOL' only reports, so it PROCEEDS with provenance UNDETERMINED." >&2
    echo "agent-tool: its output is usable; treat the tool's own version as unverified." >&2
    export AGENT_TOOL_PROVENANCE="undetermined: agent-utils dirty $where ($paths path(s))"
}

tick_hub_matches_parent_pin() {
    # The parent records Hermit, Hermit records agent-utils, and the shared
    # checkouts can be ahead while a landing is in progress. Refusing every SHA
    # difference took down all health checks even when none of tick-hub changed.
    # Compare the whole runtime surface, not selected files and not a commit
    # distance. Any tick-hub change or local file under these paths still
    # refuses, while unrelated agent-utils commits cannot blind the reporter.
    [[ $TOOL == tick-hub ]] || return 1
    local path expected_object actual_object
    for path in py/bin/tick-hub py/tick_hub; do
        expected_object=$(git -C "$AGENT_UTILS" rev-parse "$EXPECTED:$path" 2>/dev/null) \
            || return 1
        actual_object=$(git -C "$AGENT_UTILS" rev-parse "$ACTUAL:$path" 2>/dev/null) \
            || return 1
        [[ $actual_object == "$expected_object" ]] || return 1
    done
    # Commit equality is not enough when the checkout is dirty: an untracked or
    # modified module under the package can change what Python imports.
    [[ -z $(git -C "$AGENT_UTILS" status --porcelain=v1 --untracked-files=all -- \
        py/bin/tick-hub py/tick_hub) ]]
}

ACTUAL=""
if [[ -e "$AGENT_UTILS/.git" ]]; then
    ACTUAL=$(git -C "$AGENT_UTILS" rev-parse HEAD 2>/dev/null || true)
fi
TICK_HUB_CONTENT_MATCH=0
if [[ "$ACTUAL" != "$EXPECTED" ]]; then
    CURRENT_PIN=$(gitlink_at "$HERMIT" HEAD agent-utils "checked-out Hermit commit")
    if [[ $CURRENT_PIN != "$EXPECTED" ]]; then
        if tick_hub_matches_parent_pin; then
            TICK_HUB_CONTENT_MATCH=1
            HERMIT_HEAD=$(git -C "$HERMIT" rev-parse HEAD 2>/dev/null || echo unknown)
            echo "agent-tool: selected and checked-out Hermit pins differ, but tick-hub's complete tracked executable/package is byte-identical." >&2
            echo "agent-tool:   $PIN_SOURCE_DESCRIPTION -> Hermit $PARENT_HERMIT -> agent-utils $EXPECTED" >&2
            echo "agent-tool:   checkout Hermit $HERMIT_HEAD -> agent-utils $CURRENT_PIN; materialized agent-utils $ACTUAL" >&2
            echo "agent-tool: proceeding without moving either shared checkout; the running health gates still report gitlink drift." >&2
        else
            HERMIT_HEAD=$(git -C "$HERMIT" rev-parse HEAD 2>/dev/null || echo unknown)
            die "agent-utils pin mismatch.
  EXPECTED $EXPECTED
    read from: gitlink 'agent-utils' at Hermit $PARENT_HERMIT,
               selected by $PIN_SOURCE_DESCRIPTION
  ACTUAL   $CURRENT_PIN
    read from: gitlink 'agent-utils' at the CHECKED-OUT Hermit $HERMIT_HEAD
               in $HERMIT
  STATE ROOT HEAD $STATE_PARENT_HEAD in $ROOT was not used as pin authority.
  Reconcile the checked Hermit checkout with the selected immutable pin source.
  Reverting only the agent-utils submodule does NOT hold -- any 'submodule update' in
  that checkout restores the value its own HEAD records."
        fi
    fi
    if [[ $TICK_HUB_CONTENT_MATCH == 0 ]] && [[ -n "$ACTUAL" ]] \
       && [[ -n $(git -C "$AGENT_UTILS" status --porcelain) ]]; then
        agent_utils_dirt "at $ACTUAL; expected pinned $EXPECTED"
    fi
    if [[ $TICK_HUB_CONTENT_MATCH == 0 ]]; then
        update_agent_utils=(
            git -C "$HERMIT"
            -c submodule.agent-utils.update=checkout
            submodule update --init --checkout -- agent-utils
        )
        run_networked "${update_agent_utils[@]}" \
            || die "could not initialize $AGENT_UTILS; rerun '${update_agent_utils[*]}'"
    fi
fi

if [[ ! -e $AGENT_UTILS/.git ]]; then
    die "$AGENT_UTILS is not initialized through $AGENT_UTILS_LINK_TARGET; run 'git -C $HERMIT submodule update --init --checkout -- agent-utils'"
fi
ACTUAL=$(git -C "$AGENT_UTILS" rev-parse HEAD 2>/dev/null) \
    || die "cannot read agent-utils checkout at $AGENT_UTILS"
if [[ "$ACTUAL" != "$EXPECTED" && $TICK_HUB_CONTENT_MATCH == 0 ]]; then
    echo "agent-tool: agent-utils is at $ACTUAL; expected $EXPECTED" >&2
    exit 1
fi
# This front door proves either the pin selected by an explicitly supplied
# immutable tool-root HEAD or a commit obtained by a fresh origin/main fetch.
# For tick-hub alone, exact identity of its complete tracked runtime is also
# accepted across an otherwise unrelated checked-out Hermit pin difference.
if [[ -n $(git -C "$AGENT_UTILS" status --porcelain) ]]; then
    if [[ $TICK_HUB_CONTENT_MATCH == 1 ]]; then
        agent_utils_dirt "at content-equivalent commit $ACTUAL; parent pin $EXPECTED"
    else
        agent_utils_dirt "at pinned commit $EXPECTED"
    fi
fi

PYTHON=${CI_HUB_PYTHON:-python3}
if ! "$PYTHON" -c 'import yaml' >/dev/null 2>&1; then
    VENV="$ROOT/.tick-hub/venv"
    if [[ ! -x "$VENV/bin/python" ]]; then
        "$PYTHON" -m venv "$VENV"
    fi
    PYTHON="$VENV/bin/python"
    if ! "$PYTHON" -c 'import yaml' >/dev/null 2>&1; then
        install=(
            "$PYTHON" -m pip install
            --disable-pip-version-check
            --requirement "$ROOT/ci-hub/health/requirements.txt"
        )
        if command -v with-proxy >/dev/null 2>&1; then
            with-proxy "${install[@]}"
        else
            "${install[@]}"
        fi
    fi
fi

TOOL_PATH="$AGENT_UTILS/py/bin/$TOOL"
case "$TOOL" in
    dagrun|safe-ci-dag-runner)
        # This parent validates targets on both sides of the runner rename. The
        # requested spelling identifies the tool; the pinned tree decides which
        # executable exists.
        if [[ -f $AGENT_UTILS/py/bin/dagrun ]]; then
            TOOL_PATH="$AGENT_UTILS/py/bin/dagrun"
        elif [[ -f $AGENT_UTILS/py/bin/safe-ci-dag-runner ]]; then
            TOOL_PATH="$AGENT_UTILS/py/bin/safe-ci-dag-runner"
        else
            die "pinned agent-utils contains neither py/bin/dagrun nor py/bin/safe-ci-dag-runner"
        fi
        ;;
esac
exec "$PYTHON" "$TOOL_PATH" "$@"
