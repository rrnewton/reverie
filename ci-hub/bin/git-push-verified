#!/usr/bin/env python3
"""Push, then PROVE the remote moved. Never infer a landing from a printed line.

WHY THIS EXISTS
---------------
Two agents in one hour reported a successful push for a push that was REJECTED.
Both wrote the shape

    with-proxy git push origin HEAD:main 2>&1 | tail -2
    rc=$?            # <-- this is tail's exit status, not the push's

`$?` after a pipeline is the status of the LAST command in it. `tail` almost
always succeeds, so a non-fast-forward rejection is reported as rc=0 and a
change that never landed is recorded as merged.

That failure mode outranks a destroyed branch. A destroyed branch survives on a
rescue ref; an unlanded change recorded as landed is invisible, and every
downstream decision that trusts the record inherits the error.

The trap was already documented in agent-utils AGENTS.md. Two independent
instances despite the documentation is the evidence that documentation is not
the fix -- a rule that depends on remembering is a preference. So this is a
tool, and it does the thing the pipeline cannot:

  1. It runs `git push` with NO PIPE, so the status it reads is the push's own.
  2. It then asks the REMOTE what the ref actually points at, and compares that
     to the sha it meant to push. A push that "succeeded" but left the remote
     elsewhere is reported as a failure.

Step 2 matters independently of step 1. It is the only check that survives a
future variant of the same mistake, because it verifies the outcome rather than
the report.

USAGE
-----
    ci-hub/bin/git-push-verified <remote> <src>:<dst> [extra git push args...]
    ci-hub/bin/git-push-verified origin HEAD:main
    ci-hub/bin/git-push-verified origin HEAD:refs/heads/my-branch --force-with-lease

EXIT
----
    0  pushed AND the remote ref now equals the intended sha
    1  usage / could not resolve the local sha or the remote ref
    2  the push itself failed (this is the case the pipeline hid)
    3  the push reported success but the remote ref does NOT match
"""

from __future__ import annotations

import shutil
import subprocess
import sys
from typing import NamedTuple, Optional


def run(args: list[str]) -> tuple[int, str, str]:
    """Run a command with NO shell and NO pipe, so the status is the command's."""
    p = subprocess.run(args, capture_output=True, text=True)
    return p.returncode, p.stdout, p.stderr


def local_sha(src: str) -> str | None:
    rc, out, _ = run(["git", "rev-parse", "--verify", "--quiet", f"{src}^{{commit}}"])
    return out.strip() if rc == 0 and out.strip() else None


def remote_sha(remote: str, dst: str) -> str | None:
    """Ask the REMOTE, not the local tracking ref, which can be stale or absent."""
    rc, out, _ = run(["git", "ls-remote", remote, dst])
    if rc != 0:
        return None
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2:
            return parts[0]
    return None


def warn_shared_checkout(src: str, before: str | None) -> None:
    """Say, before the push, when this checkout is carrying other people's work.

    ⚠️ THIS IS ADVISORY AND DOES NOT BLOCK. It is here because the shared parent
    checkout is the tree every agent reaches for first, it is frequently dirty
    with several agents' uncommitted work at once, and it drifts a long way
    behind the remote. Committing from it is how another agent's half-finished
    edit gets swept into an unrelated landing, and how a landing arrives on top
    of a base nobody tested. That checkout has cost this project hours.

    The remedy is one command and costs nothing:

        git worktree add --detach /tmp/<name> origin/main

    Then stage only the paths you own. A clean worktree at origin/main cannot
    pick up a neighbour's edit, because the neighbour's edit is not in it.

    Deliberately NOT a refusal. Several agents push concurrently and a hard stop
    here would strand work mid-flight for a condition that is sometimes correct.
    So it names the foreign paths rather than guessing intent.
    """
    rc, out, _ = run(["git", "status", "--porcelain"])
    if rc != 0:
        return
    dirty = [line[3:].strip() for line in out.splitlines() if line.strip()]
    if not dirty:
        return

    # Paths this push actually carries. Anything dirty and NOT in here is
    # somebody else's work sitting in the same tree.
    carried: set[str] = set()
    if before:
        rc, names, _ = run(["git", "diff", "--name-only", f"{before}..{src}"])
        if rc == 0:
            carried = {n.strip() for n in names.splitlines() if n.strip()}
    foreign = [d for d in dirty if d not in carried]

    print("")
    print("git-push-verified: ⚠️  PUSHING FROM A CHECKOUT THAT IS NOT CLEAN")
    print(f"  {len(dirty)} uncommitted path(s) present, {len(foreign)} of them NOT part of this push:")
    for path in foreign[:8]:
        print(f"      {path}")
    if len(foreign) > 8:
        print(f"      ... and {len(foreign) - 8} more")

    if before:
        # ⚠️ SAY SO WHEN THE DRIFT CANNOT BE MEASURED, rather than printing
        # nothing. The remote commit is frequently absent from a checkout that is
        # behind -- which is exactly the case this line exists to report -- so a
        # bare `rev-list` failure would drop the warning precisely when it is
        # most warranted, and silence would read as "not behind".
        have_remote = run(["git", "cat-file", "-e", f"{before}^{{commit}}"])[0] == 0
        if not have_remote:
            print("  drift NOT MEASURED: the remote commit is not in this checkout "
                  "(fetch to find out how far behind it is).")
        else:
            rc, behind, _ = run(["git", "rev-list", "--count", f"{src}..{before}"])
            if rc == 0 and behind.strip().isdigit() and int(behind.strip()) > 0:
                print(f"  and this checkout is {behind.strip()} commit(s) BEHIND the remote ref.")

    print("  If this is the shared parent checkout, land from a clean worktree instead:")
    print("      git worktree add --detach /tmp/<name> origin/main")
    print("  then stage only the paths you own. Not blocking; naming it so it is a choice.")
    print("")


class FormatVerdict(NamedTuple):
    refused: bool
    line: str


def rust_files_being_pushed(src: str, before: Optional[str]) -> list[str]:
    """The .rs files this push would publish, or [] if none."""
    span = f"{before}..{src}" if before else src
    rc, out, _ = run(["git", "diff", "--name-only", span])
    if rc != 0:                      # unrelated histories, first push of a branch, etc.
        rc, out, _ = run(["git", "show", "--name-only", "--format=", src])
        if rc != 0:
            return []
    return [f for f in out.split() if f.endswith(".rs")]


def format_gate(src: str, before: Optional[str]) -> FormatVerdict:
    """Refuse a push that would publish misformatted Rust.

    WHY THIS LIVES HERE AND NOT IN THE FULL PROFILE.

    `cargo fmt --all -- --check` sits in the FULL validate profile. The
    soft-green path exists so a landing need not wait for a full-profile
    receipt, so it NEVER REACHES the format check -- not suppressed, not
    silently passing, simply never on that path. Every soft-green landing has
    that exposure, and one of them put an import-order violation on hermit main
    on 2026-08-25 (fixed by rrnewton/hermit#2520). The agent had run cargo
    check, cargo test and cargo build, and had verified the behaviour change
    with before/after runs. It had not run cargo fmt, because nothing on the
    path did.

    A documented precondition was measured at 20 percent compliance tonight, so
    this is a gate rather than a rule to remember. It costs seconds and needs no
    receipt, lock, runner or network -- the reasons the full profile is
    expensive do not apply to it.

    ⚠️ THREE OUTCOMES, NEVER TWO. "checked and clean" and "could not check" are
    reported differently and neither is silent. Collapsing them is exactly the
    defect that made a merge verifier exit 0 when it could not verify at all,
    and it is the failure mode this project has hit repeatedly tonight: an empty
    or unrunnable check read as a pass.
    """
    rust = rust_files_being_pushed(src, before)
    if not rust:
        return FormatVerdict(False, "git-push-verified: format check SKIPPED (no .rs in this push)")
    if shutil.which("cargo") is None:
        return FormatVerdict(
            False,
            "git-push-verified: format NOT CHECKED -- cargo is absent on this box. "
            f"{len(rust)} .rs file(s) are being pushed UNVERIFIED. This is not a pass.",
        )
    rc, out, err = run(["cargo", "fmt", "--all", "--", "--check"])
    if rc == 0:
        return FormatVerdict(False, f"git-push-verified: format CHECKED and clean ({len(rust)} .rs file(s))")
    blob = f"{out}\n{err}"
    # ⚠️ NO CARGO MANIFEST IS NOT A FORMATTING FAILURE, AND THIS REPOSITORY HAS
    # NONE. dev-hermit is not a cargo workspace -- its `.rs` files are rust-scripts
    # -- so `cargo fmt --all` exits non-zero with "could not find `Cargo.toml`"
    # for reasons that say nothing about the code. That fell through to the
    # offender branch below, which named no file and REFUSED THE PUSH with
    # "Run `cargo fmt --all`" -- a remedy that cannot work here. Measured
    # 2026-08-25 on the first dev-hermit push to carry a `.rs` file; earlier
    # pushes carried none and skipped the gate, which is why it went unnoticed.
    #
    # Falling back to `rustfmt` directly on the files being pushed is the RIGHT
    # tool for a rust-script, so this converts a false refusal into a real check
    # rather than into an abstention.
    if "could not find `Cargo.toml`" in blob or "cargo metadata` exited with an error" in blob:
        if shutil.which("rustfmt") is None:
            return FormatVerdict(
                False,
                "git-push-verified: format NOT CHECKED -- no cargo manifest and rustfmt is "
                f"absent. {len(rust)} .rs file(s) are being pushed UNVERIFIED. This is not a pass.",
            )
        rc2, out2, err2 = run(["rustfmt", "--edition", "2021", "--check", *rust])
        if rc2 == 0:
            return FormatVerdict(
                False,
                "git-push-verified: format CHECKED and clean via rustfmt "
                f"({len(rust)} .rs file(s); no cargo manifest in this repository)",
            )
        blob = f"{out2}\n{err2}"
        if out2.strip():
            print(out2.rstrip())
    if "not installed" in blob or "no such subcommand" in blob:
        return FormatVerdict(
            False,
            "git-push-verified: format NOT CHECKED -- rustfmt is not installed. "
            f"{len(rust)} .rs file(s) are being pushed UNVERIFIED. This is not a pass.",
        )
    offenders = sorted({
        ln.split("Diff in ", 1)[1].rsplit(":", 2)[0]
        for ln in blob.splitlines() if ln.startswith("Diff in ")
    })
    named = ", ".join(offenders) if offenders else "(rustfmt named no file; see its output above)"
    if out.strip():
        print(out.rstrip())
    return FormatVerdict(True, f"git-push-verified: format CHECK FAILED in: {named}")


def main(argv: list[str]) -> int:
    if argv and argv[0] in {"help", "-h", "--help"}:
        print(__doc__.strip())
        return 0
    if len(argv) < 2:
        print(
            "git-push-verified: missing remote or <src>:<dst> refspec. "
            "Pass both values; run --help for examples.",
            file=sys.stderr,
        )
        return 1
    if ":" not in argv[1]:
        print(
            f"git-push-verified: refspec {argv[1]!r} has no ':'. "
            "Pass <src>:<dst>; run --help for examples.",
            file=sys.stderr,
        )
        return 1

    remote, refspec = argv[0], argv[1]
    extra = argv[2:]
    src, dst = refspec.split(":", 1)
    src = src.lstrip("+")
    if not dst.startswith("refs/"):
        dst = f"refs/heads/{dst}"

    intended = local_sha(src)
    if intended is None:
        print(
            f"git-push-verified: cannot resolve local {src!r} as a commit. "
            "Fetch or create that commit, or pass an existing local ref, then rerun.",
            file=sys.stderr,
        )
        return 1

    before = remote_sha(remote, dst)
    print(f"git-push-verified: intending {intended[:12]} -> {remote} {dst}")
    print(f"git-push-verified: remote is currently {(before or '(absent)')[:12]}")

    warn_shared_checkout(src, before)

    fmt = format_gate(src, before)
    print(fmt.line)
    if fmt.refused:
        print(
            "git-push-verified: REFUSING THE PUSH. Run `cargo fmt --all` and push again.\n"
            "  This costs seconds and needs no receipt, lock, runner or network, which is\n"
            "  why it runs here instead of only in the full validate profile.",
            file=sys.stderr,
        )
        return 4

    # NO PIPE. The status below is the push's own.
    rc, out, err = run(["git", "push", remote, f"{src}:{dst}", *extra])
    for stream in (out, err):
        if stream.strip():
            print(stream.rstrip())

    if rc != 0:
        # ⚠️ ASK THE REMOTE AGAIN RATHER THAN REPORTING THE PRE-PUSH READ.
        # `before` was taken BEFORE the push, and the commonest reason a push is
        # rejected is that the remote MOVED -- so the one line a reader uses to
        # orient themselves stated a position that was already wrong, at exactly
        # the moment they were recovering from a failed landing.
        #
        # Measured 2026-08-26: this printed "origin refs/heads/main is unchanged
        # at 53eee5b02645" while git's own rejection, three lines above it, read
        # "cannot lock ref 'refs/heads/main': is at 362fbd10305a but expected
        # 53eee5b0264". Two contradictory locations in one failure report, and
        # the wrong one was the sentence written to be read.
        #
        # The success path below has always re-read the remote before claiming
        # anything. This one now does the same: a landing tool must not state
        # where main is from memory.
        after = remote_sha(remote, dst)
        if after == before:
            where = (
                f"{remote} {dst} is unchanged at {(before or '(absent)')[:12]} "
                "(re-read after the failure, not assumed)."
            )
        else:
            where = (
                f"{remote} {dst} MOVED WHILE THIS PUSH WAS IN FLIGHT: it was "
                f"{(before or '(absent)')[:12]} when this command started and is "
                f"now {(after or '(absent)')[:12]}. That move is why the push was "
                "rejected. Rebase onto the new tip and push again."
            )
        print(
            f"git-push-verified: PUSH FAILED, git exited {rc}. {where} "
            "NOTHING LANDED -- do not record this as a landing.",
            file=sys.stderr,
        )
        return 2

    after = remote_sha(remote, dst)
    if after != intended:
        print(
            "git-push-verified: PUSH REPORTED SUCCESS BUT THE REMOTE DISAGREES.\n"
            f"  intended {intended}\n"
            f"  remote   {after or '(absent)'}\n"
            "  Treat this as NOT LANDED. The push command's own status cannot be\n"
            "  trusted here; the remote is the authority.",
            file=sys.stderr,
        )
        return 3

    print(f"git-push-verified: VERIFIED {remote} {dst} = {intended}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
