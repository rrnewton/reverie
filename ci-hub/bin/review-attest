#!/usr/bin/env python3
"""Record a coordinator's exact-head review-outcome attestation.

This command does not identify the process that performed a review.  It records
the coordinator's knowledge that a reviewer from the selected dispatch family
returned an approval or refusal for one exact PR head.  The family and outcome
are closed CLI enums; unknown values fail during argument parsing before any
GitHub command runs.

The reviewer's exact-head comment is authority.  Labels are routing/activity
caches.  The exact comment is verified first, the coordinator's attestation is
posted, the live head is checked again, and labels are applied only while that
head remains current.  No label is created by this command.
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
import subprocess
import sys
from typing import Callable, Sequence


ROOT = Path(__file__).resolve().parents[2]
GH = ROOT / "ci-hub/bin/gh"
sys.path.insert(0, str(ROOT / "ci-hub"))
sys.path.insert(0, str(ROOT / "ci-hub/health"))
import approval_binding as approval_authority  # noqa: E402
import review_contract  # noqa: E402

SHA40 = re.compile(r"^[0-9a-f]{40}$")
COMMENT_URL = re.compile(
    r"^https://github\.com/(?P<repo>rrnewton/(?:hermit|reverie))/pull/"
    r"(?P<pr>[1-9][0-9]*)#issuecomment-(?P<comment>[1-9][0-9]*)$"
)
SUPPORTED_REPOS = frozenset(review_contract.SUPPORTED_REPOS)
FAMILY_LABELS = review_contract.PASSED_REVIEW_LABELS
OUTCOMES = ("approval", "refusal")
CRITICAL_CLASSES = (
    "hermit-syscall",
    "detcore-scheduling",
    "reverie-api",
)

Runner = Callable[..., subprocess.CompletedProcess[str]]


def _positive_round(raw: str) -> int:
    try:
        value = int(raw)
    except ValueError as error:
        raise argparse.ArgumentTypeError("review round must be an integer") from error
    if value not in review_contract.REVIEW_ROUNDS:
        raise argparse.ArgumentTypeError(
            "review round must be one of "
            + ", ".join(str(round_number) for round_number in review_contract.REVIEW_ROUNDS)
        )
    return value


def _exact_sha(raw: str) -> str:
    if SHA40.fullmatch(raw) is None:
        raise argparse.ArgumentTypeError("--head must be one lowercase 40-hex SHA")
    return raw


def _repo(raw: str) -> str:
    if raw not in SUPPORTED_REPOS:
        raise argparse.ArgumentTypeError(
            "--repo must be rrnewton/hermit or rrnewton/reverie"
        )
    return raw


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description=(
            "Coordinator-only exact-head review-outcome attestation that verifies "
            "the reviewer's exact comment; does not prove the executing process family."
        )
    )
    result.add_argument("--pr", type=int, required=True)
    result.add_argument("--repo", type=_repo, default="rrnewton/hermit")
    result.add_argument("--head", type=_exact_sha, required=True)
    result.add_argument("--family", choices=review_contract.REVIEW_FAMILIES, required=True)
    result.add_argument("--outcome", choices=OUTCOMES, required=True)
    result.add_argument("--comment-url", required=True)
    result.add_argument("--reviewer", required=True)
    result.add_argument("--task", required=True)
    result.add_argument("--round", type=_positive_round, default=1)
    result.add_argument("--critical", choices=CRITICAL_CLASSES)
    result.add_argument("--who", required=True)
    result.add_argument("--team", required=True)
    return result


def _run(
    runner: Runner,
    args: Sequence[str],
    *,
    context: str,
) -> subprocess.CompletedProcess[str]:
    proc = runner(list(args), text=True, capture_output=True)
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()[:800]
        raise RuntimeError(f"{context} failed rc={proc.returncode}: {detail}")
    return proc


def _read_pr(runner: Runner, repo: str, pr: int) -> dict[str, object]:
    proc = _run(
        runner,
        [
            str(GH),
            "pr",
            "view",
            str(pr),
            "--repo",
            repo,
            "--json",
            "headRefOid,state,labels",
        ],
        context="read live PR",
    )
    try:
        value = json.loads(proc.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError("read live PR returned malformed JSON") from error
    if not isinstance(value, dict):
        raise RuntimeError("read live PR returned a non-object")
    return value


def _label_names(value: object) -> set[str]:
    if not isinstance(value, list):
        return set()
    return {
        str(item["name"])
        for item in value
        if isinstance(item, dict) and isinstance(item.get("name"), str)
    }


def _available_labels(runner: Runner, repo: str) -> set[str]:
    proc = _run(
        runner,
        [str(GH), "label", "list", "--repo", repo, "--limit", "200", "--json", "name"],
        context="read repository labels",
    )
    try:
        return _label_names(json.loads(proc.stdout))
    except json.JSONDecodeError as error:
        raise RuntimeError("repository label list returned malformed JSON") from error


def _assert_repository_contract(runner: Runner) -> None:
    missing = review_contract.repository_label_gaps(
        lambda repo: _available_labels(runner, repo)
    )
    if missing:
        raise RuntimeError(
            "review label contract is incomplete; refusing to record any outcome: "
            + ", ".join(missing)
        )


def _required_labels(
    family: str,
    round_number: int,
    outcome: str,
    critical: str | None,
) -> list[str]:
    labels = [review_contract.round_label(family, round_number)]
    if outcome == "approval":
        labels.append(FAMILY_LABELS[family])
    if critical is not None:
        labels.append(review_contract.POST_FACTO_LABEL)
    return labels


def _comment_reference(raw: str) -> tuple[str, int, str]:
    match = COMMENT_URL.fullmatch(raw)
    if match is None:
        raise RuntimeError(
            "--comment-url must be a full supported pull-request comment URL"
        )
    return match.group("repo"), int(match.group("pr")), match.group("comment")


def _read_comment(runner: Runner, repo: str, comment_id: str) -> dict[str, object]:
    proc = _run(
        runner,
        [str(GH), "api", f"repos/{repo}/issues/comments/{comment_id}"],
        context="read exact reviewer comment",
    )
    try:
        value = json.loads(proc.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError("read exact reviewer comment returned malformed JSON") from error
    if not isinstance(value, dict):
        raise RuntimeError("read exact reviewer comment returned a non-object")
    return value


def _verify_reviewer_comment(args: argparse.Namespace, runner: Runner) -> None:
    repo, pr, comment_id = _comment_reference(args.comment_url)
    if repo != args.repo or pr != args.pr:
        raise RuntimeError(
            "--comment-url must name the selected repository and pull request"
        )
    comment = _read_comment(runner, repo, comment_id)
    if comment.get("html_url") != args.comment_url:
        raise RuntimeError("GitHub returned a different reviewer comment URL")
    body = comment.get("body")
    if not isinstance(body, str):
        raise RuntimeError("reviewer comment has no readable body")
    issuer = approval_authority.comment_issuer(body)
    if issuer is None:
        raise RuntimeError(
            "reviewer comment issuer is missing, expected "
            f"{args.reviewer}; the comment cannot be attested and must remain visible. "
            "Do not wait for the original reviewer: another independent reviewer may "
            "evaluate the exact current head and publish their own verdict through "
            "ci-hub/bin/gh with a validated five-field disclosure. A different "
            "coordinator can then attest the new comment"
        )
    if issuer.casefold() != args.reviewer.casefold():
        raise RuntimeError(
            f"reviewer comment issuer is {issuer}, expected {args.reviewer}"
        )

    markers = [
        parsed
        for line in approval_authority.marker_lines(body)
        if approval_authority.marker_assertion(line)
        for parsed in [approval_authority.parse_marker(line)]
    ]
    if any(marker is None for marker in markers):
        raise RuntimeError("reviewer comment contains a non-canonical verdict assertion")
    expected_kind = (
        approval_authority.MARKER_APPROVED
        if args.outcome == "approval"
        else approval_authority.MARKER_REFUSED
    )
    expected = (expected_kind, args.family, args.head)
    if markers != [expected]:
        raise RuntimeError(
            "reviewer comment must contain exactly one canonical exact-head verdict: "
            f"{expected_kind}: {args.family} {args.head}"
        )


def _comment_body(args: argparse.Namespace) -> str:
    critical = args.critical or "none"
    return "\n".join(
        [
            "REVIEW-DISPATCH-ATTESTATION",
            f"family: {args.family}",
            f"reviewer: {args.reviewer}",
            f"task: {args.task}",
            f"review-round: {args.round}",
            f"review-outcome: {args.outcome}",
            f"review-comment: {args.comment_url}",
            f"critical-class: {critical}",
            f"head: {args.head}",
            "basis: coordinator verified the reviewer's exact comment for this exact head",
            "limitation: dispatch attestation does not prove the executing process family",
        ]
    )


def execute(args: argparse.Namespace, runner: Runner = subprocess.run) -> int:
    if args.pr <= 0:
        raise RuntimeError("--pr must be positive")
    if args.who.casefold() == args.reviewer.casefold():
        raise RuntimeError(
            "the dispatched reviewer cannot record its own family attestation"
        )

    _assert_repository_contract(runner)
    labels = _required_labels(args.family, args.round, args.outcome, args.critical)

    before = _read_pr(runner, args.repo, args.pr)
    if before.get("state") != "OPEN":
        raise RuntimeError(f"PR #{args.pr} is not OPEN")
    if before.get("headRefOid") != args.head:
        raise RuntimeError(
            f"PR head mismatch before comment: expected {args.head}, "
            f"observed {before.get('headRefOid') or 'missing'}"
        )

    _verify_reviewer_comment(args, runner)

    _run(
        runner,
        [
            str(GH),
            "--who",
            args.who,
            "--team",
            args.team,
            "--role",
            "coordinator",
            "pr",
            "comment",
            str(args.pr),
            "--repo",
            args.repo,
            "--body",
            _comment_body(args),
        ],
        context="post exact-head dispatch attestation",
    )

    after_comment = _read_pr(runner, args.repo, args.pr)
    if after_comment.get("headRefOid") != args.head:
        raise RuntimeError(
            "PR head moved after the exact-head comment; no labels were applied"
        )

    edit = [str(GH), "pr", "edit", str(args.pr), "--repo", args.repo]
    existing = _label_names(after_comment.get("labels"))
    additions = [label for label in labels if label not in existing]
    for label in additions:
        edit.extend(["--add-label", label])
    removals: list[str] = []
    approval_label = FAMILY_LABELS[args.family]
    if args.outcome == "refusal" and approval_label in existing:
        removals.append(approval_label)
        edit.extend(["--remove-label", approval_label])
    if additions or removals:
        _run(runner, edit, context="apply review cache labels")

    final = _read_pr(runner, args.repo, args.pr)
    if final.get("headRefOid") != args.head:
        raise RuntimeError(
            "PR head moved after cache-label application; exact-head consumers must treat the labels as stale"
        )
    final_labels = _label_names(final.get("labels"))
    missing_after = [label for label in labels if label not in final_labels]
    if missing_after:
        raise RuntimeError(
            "review cache label(s) absent after mutation: " + ", ".join(missing_after)
        )
    if args.outcome == "refusal" and approval_label in final_labels:
        raise RuntimeError(f"{approval_label} remains after recording a refusal")
    print(
        "REVIEW-ATTESTED "
        f"repo={args.repo} pr={args.pr} head={args.head} family={args.family} "
        f"reviewer={args.reviewer} outcome={args.outcome} "
        f"comment={args.comment_url} labels={','.join(labels)} "
        f"removed={','.join(removals) or '-'} "
        "basis=coordinator-dispatch limitation=process-family-not-proven"
    )
    return 0


def main(argv: Sequence[str] | None = None, runner: Runner = subprocess.run) -> int:
    try:
        args = parser().parse_args(argv)
        return execute(args, runner)
    except RuntimeError as error:
        print(f"review-attest: REFUSED: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
