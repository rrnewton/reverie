#!/usr/bin/env python3
"""Record a coordinator's exact-head review-dispatch attestation.

This command does not identify the process that performed a review.  It records
the coordinator's knowledge that a reviewer from the selected dispatch family
returned an approval for one exact PR head.  The family is a closed CLI enum;
unknown values fail during argument parsing before any GitHub command runs.

The exact-head comment is authority.  Labels are routing/activity caches.  The
comment is posted first, read back through the canonical approval parser, and
the live head is checked again.  Labels are applied and the named review task
is closed only while that authority remains current.  No label is created by
this command.
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import Callable, Mapping, Sequence


ROOT = Path(__file__).resolve().parents[2]
GH = ROOT / "ci-hub/bin/gh"
sys.path.insert(0, str(ROOT / "ci-hub/health"))
sys.path.insert(0, str(ROOT / "ci-hub/lib"))
import approval_binding  # noqa: E402
import taskgraph_db  # noqa: E402

SHA40 = re.compile(r"^[0-9a-f]{40}$")
SUPPORTED_REPOS = frozenset({"rrnewton/hermit", "rrnewton/reverie"})
FAMILY_LABELS = {
    "codex": "passed-review-codex",
    "claude": "passed-review-claude",
}
CRITICAL_CLASSES = (
    "hermit-syscall",
    "detcore-scheduling",
    "reverie-api",
)
HUMAN_REVIEW_LABEL = "post-facto-human-review"

Runner = Callable[..., subprocess.CompletedProcess[str]]


def _positive_round(raw: str) -> int:
    try:
        value = int(raw)
    except ValueError as error:
        raise argparse.ArgumentTypeError("review round must be an integer") from error
    if not 1 <= value <= 99:
        raise argparse.ArgumentTypeError("review round must be in 1..99")
    return value


def _exact_sha(raw: str) -> str:
    if SHA40.fullmatch(raw) is None:
        raise argparse.ArgumentTypeError("--head must be one lowercase 40-hex SHA")
    return raw


def _repo(raw: str) -> str:
    if raw not in SUPPORTED_REPOS:
        raise argparse.ArgumentTypeError(
            "--repo must be rrnewton/hermit or rrnewton/reverie"
        )
    return raw


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description=(
            "Coordinator-only exact-head review-dispatch attestation; "
            "does not prove the executing process family."
        )
    )
    result.add_argument("--pr", type=int, required=True)
    result.add_argument("--repo", type=_repo, default="rrnewton/hermit")
    result.add_argument("--head", type=_exact_sha, required=True)
    result.add_argument("--family", choices=tuple(FAMILY_LABELS), required=True)
    result.add_argument("--reviewer", required=True)
    result.add_argument("--task", required=True)
    result.add_argument("--round", type=_positive_round, default=1)
    result.add_argument("--critical", choices=CRITICAL_CLASSES)
    result.add_argument("--who", required=True)
    result.add_argument("--team", required=True)
    return result


def _run(
    runner: Runner,
    args: Sequence[str],
    *,
    context: str,
    env: Mapping[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    kwargs: dict[str, object] = {"text": True, "capture_output": True}
    if env is not None:
        kwargs["env"] = dict(env)
    proc = runner(list(args), **kwargs)
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()[:800]
        raise RuntimeError(f"{context} failed rc={proc.returncode}: {detail}")
    return proc


def _read_pr(runner: Runner, repo: str, pr: int) -> dict[str, object]:
    proc = _run(
        runner,
        [
            str(GH),
            "pr",
            "view",
            str(pr),
            "--repo",
            repo,
            "--json",
            "headRefOid,state,labels",
        ],
        context="read live PR",
    )
    try:
        value = json.loads(proc.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError("read live PR returned malformed JSON") from error
    if not isinstance(value, dict):
        raise RuntimeError("read live PR returned a non-object")
    return value


def _label_names(value: object) -> set[str]:
    if not isinstance(value, list):
        return set()
    return {
        str(item["name"])
        for item in value
        if isinstance(item, dict) and isinstance(item.get("name"), str)
    }


def _available_labels(runner: Runner, repo: str) -> set[str]:
    proc = _run(
        runner,
        [str(GH), "label", "list", "--repo", repo, "--limit", "200", "--json", "name"],
        context="read repository labels",
    )
    try:
        return _label_names(json.loads(proc.stdout))
    except json.JSONDecodeError as error:
        raise RuntimeError("repository label list returned malformed JSON") from error


def _read_comments(runner: Runner, repo: str, pr: int) -> list[dict[str, object]]:
    proc = _run(
        runner,
        [
            str(GH),
            "api",
            "--paginate",
            "--slurp",
            f"repos/{repo}/issues/{pr}/comments",
        ],
        context="read posted review authority",
    )
    try:
        pages = json.loads(proc.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError("review authority readback returned malformed JSON") from error
    if not isinstance(pages, list) or any(not isinstance(page, list) for page in pages):
        raise RuntimeError("review authority readback returned malformed pages")
    comments: list[dict[str, object]] = []
    for page in pages:
        for comment in page:
            if not isinstance(comment, dict):
                raise RuntimeError("review authority readback returned a malformed comment")
            comments.append(comment)
    return comments


def _task_environment() -> dict[str, str]:
    environment = dict(os.environ)
    try:
        resolution = taskgraph_db.resolve(env=environment)
    except taskgraph_db.TaskGraphUnavailable as error:
        raise RuntimeError(f"cannot bind review task: {error}") from error
    return taskgraph_db.child_env(resolution, env=environment)


def _close_review_task(
    runner: Runner,
    task: str,
    environment: Mapping[str, str],
) -> None:
    _run(
        runner,
        ["tg", "update", task, "--status", "closed"],
        context="close canonically bound review task",
        env=environment,
    )


def _required_labels(family: str, round_number: int, critical: str | None) -> list[str]:
    labels = [
        f"adversarial-review-{family}{round_number}",
        FAMILY_LABELS[family],
    ]
    if critical is not None:
        labels.append(HUMAN_REVIEW_LABEL)
    return labels


def _comment_body(args: argparse.Namespace) -> str:
    critical = args.critical or "none"
    return "\n".join(
        [
            "REVIEW-DISPATCH-ATTESTATION",
            f"family: {args.family}",
            f"reviewer: {args.reviewer}",
            f"task: {args.task}",
            f"review-round: {args.round}",
            f"critical-class: {critical}",
            f"head: {args.head}",
            "basis: coordinator dispatched this reviewer and received an approval for this exact head",
            "limitation: dispatch attestation does not prove the executing process family",
            f"APPROVED-AT: {args.family} {args.head}",
        ]
    )


def execute(
    args: argparse.Namespace,
    runner: Runner = subprocess.run,
    task_environment: Mapping[str, str] | None = None,
) -> int:
    if args.pr <= 0:
        raise RuntimeError("--pr must be positive")
    if args.who.casefold() == args.reviewer.casefold():
        raise RuntimeError(
            "the dispatched reviewer cannot record its own family attestation"
        )

    environment = (
        dict(task_environment)
        if task_environment is not None
        else _task_environment()
    )
    _run(
        runner,
        ["tg", "show", args.task],
        context="read review task before attestation",
        env=environment,
    )

    labels = _required_labels(args.family, args.round, args.critical)
    available = _available_labels(runner, args.repo)
    missing = [label for label in labels if label not in available]
    if missing:
        raise RuntimeError(
            "required existing label(s) absent; refusing to create or mutate: "
            + ", ".join(missing)
        )

    before = _read_pr(runner, args.repo, args.pr)
    if before.get("state") != "OPEN":
        raise RuntimeError(f"PR #{args.pr} is not OPEN")
    if before.get("headRefOid") != args.head:
        raise RuntimeError(
            f"PR head mismatch before comment: expected {args.head}, "
            f"observed {before.get('headRefOid') or 'missing'}"
        )

    _run(
        runner,
        [
            str(GH),
            "--who",
            args.who,
            "--team",
            args.team,
            "--role",
            "coordinator",
            "pr",
            "comment",
            str(args.pr),
            "--repo",
            args.repo,
            "--body",
            _comment_body(args),
        ],
        context="post exact-head dispatch attestation",
    )

    after_comment = _read_pr(runner, args.repo, args.pr)
    if after_comment.get("headRefOid") != args.head:
        raise RuntimeError(
            "PR head moved after the exact-head comment; no labels were applied"
        )

    comments = _read_comments(runner, args.repo, args.pr)
    binding = approval_binding.classify_approval(
        args.head,
        approval_binding.lane_shas(comments, args.family),
    )
    if binding != approval_binding.BOUND_CURRENT:
        raise RuntimeError(
            "posted review authority did not bind the requested family to the exact head: "
            f"expected {approval_binding.BOUND_CURRENT}, observed {binding}; "
            "no labels were applied and the review task remains open"
        )

    edit = [str(GH), "pr", "edit", str(args.pr), "--repo", args.repo]
    existing = _label_names(after_comment.get("labels"))
    additions = [label for label in labels if label not in existing]
    for label in additions:
        edit.extend(["--add-label", label])
    if additions:
        _run(runner, edit, context="apply review cache labels")

    final = _read_pr(runner, args.repo, args.pr)
    if final.get("headRefOid") != args.head:
        raise RuntimeError(
            "PR head moved after cache-label application; exact-head consumers must treat the labels as stale"
        )
    _close_review_task(runner, args.task, environment)
    print(
        "REVIEW-ATTESTED "
        f"repo={args.repo} pr={args.pr} head={args.head} family={args.family} "
        f"reviewer={args.reviewer} labels={','.join(labels)} "
        "basis=coordinator-dispatch limitation=process-family-not-proven"
    )
    return 0


def main(
    argv: Sequence[str] | None = None,
    runner: Runner = subprocess.run,
    task_environment: Mapping[str, str] | None = None,
) -> int:
    try:
        args = parser().parse_args(argv)
        return execute(args, runner, task_environment)
    except RuntimeError as error:
        print(f"review-attest: REFUSED: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
