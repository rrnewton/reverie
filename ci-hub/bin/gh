#!/usr/bin/env python3
"""Fleet-aware boundary for GitHub CLI prose writes.

Covers comment and review writes, and the writes that CREATE or REPLACE an
issue or pull-request body: ``issue create``, ``pr create``, ``issue edit`` and
``pr edit``, plus the equivalent REST endpoints.  The GitHub author is a
constant on this fork, so an unattributed issue or pull request is
indistinguishable from one the repository owner wrote himself; the disclosure
prefix in the body is the only thing that separates them.

Every supported write requires caller-supplied ``--who``,
``--team``, and ``--role`` arguments.  The boundary resolves the caller through
the shared process-context authority (inherited agent identity, ancestry, cwd
slot owner, pane, cgroup, sidecar, and TaskGraph where readable) and refuses
unless the result is AGREEMENT and ``--who`` equals the resolved agent.

The resulting disclosure prefix is mechanical, not authentication, and is
always separated from the body by a newline::

    [team-slug, agent-name, resolved-model, machine-shortname, role=enum]

The model comes only from the process resolver.  There is no ``--model`` input;
an unavailable or ambiguous model is rendered literally as ``unresolved``.
Roles are the closed owner-approved enum ``impl``, ``debugger``, ``reviewer``,
``relay``, ``coordinator``, and ``human``.

A shared GitHub credential still cannot prove who typed the arguments.  The
independent process-context comparison makes a false claim falsifiable; it does
not turn the prefix into identity or review-family authority.

Truly unresolvable ownership is deliberately fail-closed for every comment
lane.  A missing cwd, pane, or sidecar remains an explicit unavailable signal
but is not by itself UNRESOLVED when inherited process identity is proven and
all readable signals agree.  DISAGREEMENT and UNRESOLVED always REFUSE; callers
may not self-classify a write as non-critical to bypass either outcome.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from collections.abc import Mapping
from pathlib import Path
from typing import NoReturn


ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "ci-hub/lib"))

import agent_identity  # noqa: E402
import disclosure_tag  # noqa: E402


DISCLOSURE_RE = re.compile(
    r"^\[(?P<team>[A-Za-z0-9_.-]+), "
    r"(?P<agent>[A-Za-z0-9_.-]+), "
    r"(?P<model>[^,\]\r\n]+), "
    r"(?P<machine>[A-Za-z0-9_.-]+), "
    r"role=(?P<role>[A-Za-z0-9_.-]+)\](?=\n|\Z)"
)
MALFORMED_FIVE_FIELD_RE = re.compile(
    r"^\[[^,\]\n]+, [^,\]\n]+, [^,\]\n]+, [^,\]\n]+, "
    r"role=[^\]\n]+\](?=\n|\Z)"
)
LEGACY_DISCLOSURE_RE = re.compile(
    r"^(?:\[[^,\]\n]+, [^,\]\n]+, [^,\]\n]+, role=[^\]\n]+\]"
    r"|\[[^,\]\n]+, [^\]\n]+\] \[[^,\]\n]+, [^\]\n]+\])"
)


def die(message: str) -> NoReturn:
    print(f"fleet-gh: REFUSE: {message}", file=sys.stderr)
    raise SystemExit(2)


def real_gh() -> str:
    configured = os.environ.get("FLEET_REAL_GH")
    candidates = [configured] if configured else []
    candidates += ["/usr/local/bin/gh", "/usr/bin/gh"]
    here = Path(__file__).resolve()
    for candidate in candidates:
        if candidate and Path(candidate).is_file() and os.access(candidate, os.X_OK):
            if Path(candidate).resolve() != here:
                return candidate
    die("could not locate the real gh binary (set FLEET_REAL_GH)")


def _option_value(args: list[str], index: int, name: str) -> tuple[str, int] | None:
    arg = args[index]
    if arg == name:
        if index + 1 >= len(args):
            die(f"{name} requires a value")
        return args[index + 1], 2
    if arg.startswith(name + "="):
        return arg.split("=", 1)[1], 1
    return None


def disclosure_options(args: list[str]) -> tuple[list[str], dict[str, str]]:
    """Strip leading boundary options without parsing comment body text as flags."""

    values: dict[str, str] = {}
    index = 0
    while index < len(args):
        if args[index] == "--model" or args[index].startswith("--model="):
            die("--model is process-resolved and must not be supplied by the caller")
        matched = False
        for name, key in (("--who", "who"), ("--team", "team"), ("--role", "role")):
            parsed = _option_value(args, index, name)
            if parsed is None:
                continue
            if key in values:
                die(f"{name} was supplied more than once")
            value, consumed = parsed
            values[key] = value
            index += consumed
            matched = True
            break
        if not matched:
            break
    return args[index:], values


def required_disclosure(values: Mapping[str, str]) -> tuple[str, str, str]:
    if not values.get("who"):
        die("missing required --who for a GitHub comment/review write")
    if not values.get("team"):
        die("missing required --team for a GitHub comment/review write")
    if not values.get("role"):
        die("missing required --role for a GitHub comment/review write")
    return values["who"], values["team"], values["role"]


def validate_disclosure(
    claimed_agent: str, team: str, role: str
) -> disclosure_tag.Disclosure:
    resolution = agent_identity.resolve_identity(os.getpid())
    try:
        return disclosure_tag.from_resolution(
            resolution,
            team=team,
            role=role,
            claimed_agent=claimed_agent,
        )
    except disclosure_tag.DisclosureError as error:
        die(str(error))


def attributed(body: str, disclosure: disclosure_tag.Disclosure) -> str:
    existing = DISCLOSURE_RE.match(body)
    if existing:
        if existing.group("role") not in disclosure_tag.ROLES:
            die("malformed five-field who-is-talking prefix must be corrected before posting")
        observed = (
            existing.group("team"),
            existing.group("agent"),
            existing.group("model"),
            existing.group("machine"),
            existing.group("role"),
        )
        wanted = (
            disclosure.team,
            disclosure.agent,
            disclosure.model,
            disclosure.machine,
            disclosure.role,
        )
        if observed != wanted:
            die("existing who-is-talking prefix conflicts with validated disclosure")
        return body
    if LEGACY_DISCLOSURE_RE.match(body):
        die("legacy who-is-talking prefix must be removed before posting")
    if MALFORMED_FIVE_FIELD_RE.match(body):
        die("malformed five-field who-is-talking prefix must be corrected before posting")
    return f"{disclosure.tag}\n{body}"


def body_option(args: list[str]) -> tuple[int, int, str] | None:
    """Return (start, consumed arguments, body), reading body files eagerly."""
    for index, arg in enumerate(args):
        if arg in ("--body", "-b"):
            if index + 1 >= len(args):
                die(f"{arg} requires a value")
            return index, 2, args[index + 1]
        if arg.startswith("--body="):
            return index, 1, arg.split("=", 1)[1]
        if arg in ("--body-file", "-F"):
            if index + 1 >= len(args):
                die(f"{arg} requires a value")
            source = args[index + 1]
            if source == "-":
                return index, 2, sys.stdin.read()
            try:
                return index, 2, Path(source).read_text()
            except OSError as error:
                die(f"cannot read comment body file {source!r}: {error}")
    return None


def close_comment_option(args: list[str]) -> tuple[int, int, str] | None:
    """Return the sole ``pr close`` comment option, in any gh-supported form."""

    found: tuple[int, int, str] | None = None
    index = 0
    while index < len(args):
        arg = args[index]
        candidate: tuple[int, int, str] | None = None
        if arg in ("--comment", "-c"):
            if index + 1 >= len(args):
                die(f"{arg} requires a value")
            candidate = (index, 2, args[index + 1])
        elif arg.startswith("--comment="):
            candidate = (index, 1, arg.split("=", 1)[1])
        elif arg.startswith("-c") and not arg.startswith("--"):
            candidate = (index, 1, arg[2:])
        if candidate is None:
            index += 1
            continue
        if found is not None:
            die("pr close must supply --comment exactly once")
        found = candidate
        index += candidate[1]
    return found


def rewrite_body_option(
    args: list[str], disclosure: disclosure_tag.Disclosure, *, required: bool
) -> list[str]:
    found = body_option(args)
    if found is None:
        if required:
            return args + ["--body", attributed("", disclosure)]
        die("command has no supported --body/--body-file argument")
    index, consumed, body = found
    return args[:index] + ["--body", attributed(body, disclosure)] + args[index + consumed :]


def rewrite_close_comment(
    args: list[str], disclosure: disclosure_tag.Disclosure
) -> list[str]:
    found = close_comment_option(args)
    if found is None:
        die("pr close comment write has no --comment value")
    index, consumed, body = found
    return (
        args[:index]
        + ["--comment", attributed(body, disclosure)]
        + args[index + consumed :]
    )


def api_method(args: list[str]) -> str:
    for index, arg in enumerate(args):
        if arg in ("-X", "--method") and index + 1 < len(args):
            return args[index + 1].upper()
        if arg.startswith("--method="):
            return arg.split("=", 1)[1].upper()
    if any(arg in ("-f", "-F", "--field", "--raw-field") for arg in args):
        return "POST"
    return "GET"


def api_endpoint(args: list[str]) -> str:
    options_with_values = {
        "-X", "--method", "-H", "--header", "-f", "--raw-field", "-F",
        "--field", "--input", "--hostname", "--cache", "--jq", "-q",
        "--template", "-t",
    }
    skip = False
    for arg in args[1:]:
        if skip:
            skip = False
            continue
        if arg in options_with_values:
            skip = True
            continue
        if arg.startswith("-"):
            continue
        return arg
    return ""


# Subcommands whose body IS the artifact being created. The GitHub author is a
# constant on this fork, so an unattributed issue or pull request is
# indistinguishable from one the repository owner wrote himself. These fail
# closed when no body option is supplied rather than creating an unattributed
# artifact.
CREATED_BODY_COMMANDS = (["issue", "create"], ["pr", "create"])

# Subcommands that may REPLACE an existing body. Attributed only when a body
# option is actually present: `gh issue edit 1 --title x` writes no prose and
# must keep passing through untouched.
EDITED_BODY_COMMANDS = (["issue", "edit"], ["pr", "edit"])


def is_created_body_endpoint(endpoint: str) -> bool:
    """The REST endpoints that create an issue or a pull request."""
    endpoint = endpoint.split("?", 1)[0].strip("/")
    return bool(re.fullmatch(r"repos/[^/]+/[^/]+/(issues|pulls)", endpoint))


def is_comment_endpoint(endpoint: str) -> bool:
    endpoint = endpoint.split("?", 1)[0].strip("/")
    return bool(
        re.fullmatch(r"repos/[^/]+/[^/]+/(issues|pulls)/[^/]+/comments(?:/[^/]+)?", endpoint)
        or re.fullmatch(r"repos/[^/]+/[^/]+/pulls/[^/]+/reviews(?:/[^/]+)?", endpoint)
        or re.fullmatch(r"repos/[^/]+/[^/]+/commits/[^/]+/comments", endpoint)
        or re.fullmatch(r"repos/[^/]+/[^/]+/(issues|pulls)/comments/[^/]+", endpoint)
        or re.fullmatch(r"repos/[^/]+/[^/]+/comments/[^/]+", endpoint)
    )


def is_attributed_write(args: list[str]) -> bool:
    if len(args) >= 2 and args[:2] in (
        ["pr", "comment"],
        ["issue", "comment"],
        ["pr", "review"],
    ):
        return True
    if len(args) >= 2 and args[:2] in CREATED_BODY_COMMANDS:
        return True
    if len(args) >= 2 and args[:2] in EDITED_BODY_COMMANDS:
        return body_option(args) is not None
    if len(args) >= 2 and args[:2] == ["pr", "close"]:
        return close_comment_option(args) is not None
    if not args or args[0] != "api":
        return False
    if len(args) > 1 and args[1] == "graphql":
        joined = "\n".join(args[2:])
        return re.search(
            r"\b(addComment|addDiscussionComment|addPullRequestReview|"
            r"updateIssueComment|updatePullRequestReview|"
            r"updatePullRequestReviewComment)\b",
            joined,
        ) is not None
    method = api_method(args)
    endpoint = api_endpoint(args)
    if method in {"POST", "PATCH", "PUT"} and is_comment_endpoint(endpoint):
        return True
    # Creating an issue or a pull request through the raw API is the same
    # artifact as `issue create` / `pr create` and must not be a way around it.
    return method == "POST" and is_created_body_endpoint(endpoint)


def rewrite_api(args: list[str], disclosure: disclosure_tag.Disclosure) -> list[str]:
    if len(args) > 1 and args[1] == "graphql":
        die("raw GraphQL comment mutations cannot be attributed safely")
    method = api_method(args)
    endpoint = api_endpoint(args)
    attributable = is_comment_endpoint(endpoint) or (
        method == "POST" and is_created_body_endpoint(endpoint)
    )
    if method not in {"POST", "PATCH", "PUT"} or not attributable:
        return args
    if "--input" in args or any(arg.startswith("--input=") for arg in args):
        die("raw API comment mutation via --input cannot be attributed safely")
    for index, arg in enumerate(args):
        if arg in ("-f", "--raw-field", "-F", "--field") and index + 1 < len(args):
            if args[index + 1].startswith("body="):
                body = args[index + 1].split("=", 1)[1]
                rewritten = list(args)
                rewritten[index + 1] = f"body={attributed(body, disclosure)}"
                return rewritten
        for prefix in ("--raw-field=body=", "--field=body="):
            if arg.startswith(prefix):
                rewritten = list(args)
                rewritten[index] = f"{prefix}{attributed(arg[len(prefix):], disclosure)}"
                return rewritten
    die(f"raw API comment mutation {method} {endpoint} has no supported body field")


def rewrite(args: list[str], disclosure: disclosure_tag.Disclosure) -> list[str]:
    if len(args) >= 2 and args[:2] in (["pr", "comment"], ["issue", "comment"]):
        return rewrite_body_option(args, disclosure, required=False)
    if len(args) >= 2 and args[:2] in CREATED_BODY_COMMANDS + EDITED_BODY_COMMANDS:
        return rewrite_body_option(args, disclosure, required=False)
    if len(args) >= 2 and args[:2] == ["pr", "review"]:
        return rewrite_body_option(args, disclosure, required=True)
    if len(args) >= 2 and args[:2] == ["pr", "close"]:
        return rewrite_close_comment(args, disclosure)
    if args and args[0] == "api":
        return rewrite_api(args, disclosure)
    return args


def main() -> int:
    args, supplied = disclosure_options(sys.argv[1:])
    if is_attributed_write(args):
        claimed_agent, team, role = required_disclosure(supplied)
        disclosure = validate_disclosure(claimed_agent, team, role)
        args = rewrite(args, disclosure)
    return subprocess.run([real_gh(), *args]).returncode


if __name__ == "__main__":
    raise SystemExit(main())
