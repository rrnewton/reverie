#!/usr/bin/env python3
"""Fleet-aware boundary for GitHub CLI prose writes.

Covers comment and review writes, and the writes that CREATE or REPLACE an
issue or pull-request body: ``issue create``, ``pr create``, ``issue edit`` and
``pr edit``, plus the equivalent REST endpoints.  The GitHub author is a
constant on this fork, so an unattributed issue or pull request is
indistinguishable from one the repository owner wrote himself; the disclosure
prefix in the body is the only thing that separates them.

Every supported write requires caller-supplied ``--who``,
``--team``, and ``--role`` arguments.  The boundary resolves the caller through
the shared process-context authority (inherited agent identity, ancestry, cwd
slot owner, pane, cgroup, sidecar, and TaskGraph where readable) and refuses
unless the result is AGREEMENT and ``--who`` equals the resolved agent.

The resulting disclosure prefix is mechanical, not authentication, and is
always separated from the body by a newline::

    [team-slug, agent-name, resolved-model, machine-shortname, role=enum]

The model comes only from the process resolver.  There is no ``--model`` input;
an unavailable or ambiguous model is rendered literally as ``unresolved``.
Roles are the closed owner-approved enum ``impl``, ``debugger``, ``reviewer``,
``relay``, ``coordinator``, and ``human``.

A comment or review that carries a verdict may also supply ``--verdict`` with
the exact canonical marker line. The boundary adds that line to the body once,
so surrounding prose cannot make the readers mistake a verdict for a mention.

A shared GitHub credential still cannot prove who typed the arguments.  The
independent process-context comparison makes a false claim falsifiable; it does
not turn the prefix into identity or review-family authority.

Truly unresolvable ownership is deliberately fail-closed for every comment
lane.  A missing cwd, pane, or sidecar remains an explicit unavailable signal
but is not by itself UNRESOLVED when inherited process identity is proven and
all readable signals agree.  DISAGREEMENT and UNRESOLVED always REFUSE; callers
may not self-classify a write as non-critical to bypass either outcome.
"""

from __future__ import annotations

import sys as _bootstrap_sys
from pathlib import Path as _BootstrapPath

# ci-hub/closure is a sibling of ci-hub/bin; the record grammar is shared with
# the checker that reads it, so neither can drift from the other.
_bootstrap_sys.path.insert(0, str(_BootstrapPath(__file__).resolve().parent.parent))
from closure import publication_record  # noqa: E402

import os
import re
import subprocess
import sys
from collections.abc import Mapping
from pathlib import Path
from typing import NoReturn


ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "ci-hub/lib"))

import agent_identity  # noqa: E402
import disclosure_tag  # noqa: E402


DISCLOSURE_RE = re.compile(
    r"^\[(?P<team>[A-Za-z0-9_.-]+), "
    r"(?P<agent>[A-Za-z0-9_.-]+), "
    r"(?P<model>[^,\]\r\n]+), "
    r"(?P<machine>[A-Za-z0-9_.-]+), "
    r"role=(?P<role>[A-Za-z0-9_.-]+)\](?=\n|\Z)"
)
MALFORMED_FIVE_FIELD_RE = re.compile(
    r"^\[[^,\]\n]+, [^,\]\n]+, [^,\]\n]+, [^,\]\n]+, "
    r"role=[^\]\n]+\](?=\n|\Z)"
)
LEGACY_DISCLOSURE_RE = re.compile(
    r"^(?:\[[^,\]\n]+, [^,\]\n]+, [^,\]\n]+, role=[^\]\n]+\]"
    r"|\[[^,\]\n]+, [^\]\n]+\] \[[^,\]\n]+, [^\]\n]+\])"
)


def die(message: str) -> NoReturn:
    print(f"fleet-gh: REFUSE: {message}", file=sys.stderr)
    raise SystemExit(2)


def real_gh() -> str:
    configured = os.environ.get("FLEET_REAL_GH")
    candidates = [configured] if configured else []
    candidates += ["/usr/local/bin/gh", "/usr/bin/gh"]
    here = Path(__file__).resolve()
    for candidate in candidates:
        if candidate and Path(candidate).is_file() and os.access(candidate, os.X_OK):
            if Path(candidate).resolve() != here:
                return candidate
    die("could not locate the real gh binary (set FLEET_REAL_GH)")


def _option_value(args: list[str], index: int, name: str) -> tuple[str, int] | None:
    arg = args[index]
    if arg == name:
        if index + 1 >= len(args):
            die(f"{name} requires a value")
        return args[index + 1], 2
    if arg.startswith(name + "="):
        return arg.split("=", 1)[1], 1
    return None


def disclosure_options(args: list[str]) -> tuple[list[str], dict[str, str]]:
    """Strip leading boundary options without parsing comment body text as flags."""

    values: dict[str, str] = {}
    index = 0
    while index < len(args):
        if args[index] == "--model" or args[index].startswith("--model="):
            die("--model is process-resolved and must not be supplied by the caller")
        matched = False
        for name, key in (
            ("--who", "who"),
            ("--team", "team"),
            ("--role", "role"),
            ("--task", "task"),
            ("--verdict", "verdict"),
        ):
            parsed = _option_value(args, index, name)
            if parsed is None:
                continue
            if key in values:
                die(f"{name} was supplied more than once")
            value, consumed = parsed
            values[key] = value
            index += consumed
            matched = True
            break
        if not matched:
            break
    return args[index:], values


def required_disclosure(values: Mapping[str, str]) -> tuple[str, str, str]:
    if not values.get("who"):
        die("missing required --who for a GitHub comment/review write")
    if not values.get("team"):
        die("missing required --team for a GitHub comment/review write")
    if not values.get("role"):
        die("missing required --role for a GitHub comment/review write")
    return values["who"], values["team"], values["role"]


def validate_disclosure(
    claimed_agent: str, team: str, role: str
) -> disclosure_tag.Disclosure:
    resolution = agent_identity.resolve_identity(os.getpid())
    try:
        return disclosure_tag.from_resolution(
            resolution,
            team=team,
            role=role,
            claimed_agent=claimed_agent,
        )
    except disclosure_tag.DisclosureError as error:
        die(str(error))


#: A VERDICT THAT CANNOT BIND MUST NOT BE POSTED SILENTLY.
#:
#: The first version of this guard refused any COMMENT carrying a verdict
#: marker, exempting only `review-attest`. That was wrong, and using it proved
#: it within a minute: `review-attest` is a COORDINATOR ATTESTATION of a
#: DISPATCHED review -- its own help says it "does not prove the executing
#: process family" -- so it is NOT how a reviewer publishes a verdict they
#: reached themselves. A reviewer posts a COMMENT. Refusing that refuses the
#: PRIMARY USE, which is the mirror failure of warning and letting everything
#: through: both end with the check ignored.
#:
#: So the refusal is narrowed to the case that is SILENTLY HARMFUL. A comment
#: carrying a marker that BINDS is a verdict and is allowed. A comment quoting
#: a marker in prose is a citation and is allowed. What is refused is a
#: marker-SHAPED line that will NOT bind: the reviewer believes they voted and
#: nothing recorded it.
#:
#: ⚠️ THAT IS NOT HYPOTHETICAL AND IT IS THE MOST EXPENSIVE FAILURE IN THIS
#: SYSTEM. `APPROVED-AT: claude 6457ba0acfb4` -- canonical form, own line,
#: correct lane, merely ABBREVIATED -- bound nothing and reported nothing.
#: hermit#1689 carried TWO blocking reviews written without the -AT suffix,
#: neither bound, and the head sat NINETEEN DAYS while both reviewers believed
#: they had blocked it.
#:
#: Refusing here costs a re-post. Not refusing costs a review.
#:
#: ⚠️ LIMIT, STATED SO NOBODY READS THIS AS FULL COVERAGE. It asks
#: `approval_binding`, so it can only refuse what THAT parser cannot bind. A
#: refusal written `CHANGES-REQUESTED: <lane> <sha>` -- no `-AT` -- IS honoured
#: there on purpose (`reject_current` accepts the missing suffix, because a
#: malformed refusal must still refuse), so this guard allows it. THE LANDERS
#: USE A DIFFERENT PARSER AND DO NOT HONOUR IT, which is a separate live P0 and
#: a fail-open on the refusal path. This guard does not and cannot close that:
#: two parsers for one grammar is the underlying defect, and a third checker
#: agreeing with one of them would not fix the disagreement.
def _approval_binding_module():
    """Load the one marker parser used by the readers."""
    try:
        sys.path.insert(0, str(ROOT / "ci-hub/health"))
        import approval_binding as _ab  # noqa: PLC0415
    except Exception:
        return None
    return _ab


def _marker_binding(body: str) -> tuple[int, int, bool]:
    """``(bound, unbindable, parser_can_discriminate_quotations)`` for ``body``."""
    _ab = _approval_binding_module()
    if _ab is None:
        return (0, 0, False)
    capable = hasattr(_ab, "_is_quoted_mention")
    bound = 0
    unbindable: list[tuple[str, str]] = []
    for lane in ("claude", "codex"):
        bound += len(_ab.lane_shas([{"body": body, "html_url": "?"}], lane, unbindable))
    return (bound, len(unbindable), capable)


def refuse_unbindable_verdict(body: str) -> None:
    """Refuse a body whose verdict-shaped line would NOT bind."""
    bound, unbindable, capable = _marker_binding(body)
    if not unbindable:
        return
    detail = (
        f"body carries {unbindable} verdict-shaped line(s) that will NOT bind"
        + (f" (and {bound} that will)" if bound else "")
    )
    if not capable:
        print(
            "fleet-gh: WARNING: " + detail + " -- NOT refusing, because this "
            "checkout's approval_binding cannot yet tell a QUOTED marker from an "
            "unbindable one (dev-hermit#188), so refusing would block comments "
            "that merely discuss the grammar.",
            file=sys.stderr,
        )
        return
    die(
        detail + ". A verdict that cannot bind is silently lost: the reviewer "
        "believes they voted and nothing records it. Use the full 40-hex head "
        "sha and the exact grammar, or quote the marker inside inline code with "
        "prose around it if you are discussing rather than issuing it."
    )


def with_verdict(body: str, verdict: str | None) -> str:
    """Append the exact canonical marker supplied by ``--verdict`` once."""
    if verdict is None:
        return body
    grammar = _approval_binding_module()
    if grammar is None:
        die("cannot load approval_binding to verify --verdict")
    if "\n" in verdict or "\r" in verdict or verdict.strip() != verdict \
            or grammar.parse_marker(verdict) is None:
        die(
            "--verdict must be one canonical marker line with a full 40-hex SHA: "
            "APPROVED-AT, CHANGES-REQUESTED-AT, or "
            "CHANGES-REQUESTED-WITHDRAWN-AT"
        )
    if any(
        line == verdict and grammar.marker_assertion(line)
        for line in grammar.marker_lines(body)
    ):
        return body
    separator = "" if not body or body.endswith("\n") else "\n"
    return body + separator + verdict


def attributed(
    body: str,
    disclosure: disclosure_tag.Disclosure,
    verdict: str | None = None,
) -> str:
    # Inside `attributed` on purpose: there are five call sites and a gate that
    # misses one is not a gate. Every comment body passes through here.
    body = with_verdict(body, verdict)
    refuse_unbindable_verdict(body)
    existing = DISCLOSURE_RE.match(body)
    if existing:
        if existing.group("role") not in disclosure_tag.ROLES:
            die("malformed five-field who-is-talking prefix must be corrected before posting")
        observed = (
            existing.group("team"),
            existing.group("agent"),
            existing.group("model"),
            existing.group("machine"),
            existing.group("role"),
        )
        wanted = (
            disclosure.team,
            disclosure.agent,
            disclosure.model,
            disclosure.machine,
            disclosure.role,
        )
        if observed != wanted:
            die("existing who-is-talking prefix conflicts with validated disclosure")
        return body
    if LEGACY_DISCLOSURE_RE.match(body):
        die("legacy who-is-talking prefix must be removed before posting")
    if MALFORMED_FIVE_FIELD_RE.match(body):
        die("malformed five-field who-is-talking prefix must be corrected before posting")
    return f"{disclosure.tag}\n{body}"


def body_option(args: list[str]) -> tuple[int, int, str] | None:
    """Return (start, consumed arguments, body), reading body files eagerly."""
    for index, arg in enumerate(args):
        if arg in ("--body", "-b"):
            if index + 1 >= len(args):
                die(f"{arg} requires a value")
            return index, 2, args[index + 1]
        if arg.startswith("--body="):
            return index, 1, arg.split("=", 1)[1]
        if arg in ("--body-file", "-F"):
            if index + 1 >= len(args):
                die(f"{arg} requires a value")
            source = args[index + 1]
            if source == "-":
                return index, 2, sys.stdin.read()
            try:
                return index, 2, Path(source).read_text()
            except OSError as error:
                die(f"cannot read comment body file {source!r}: {error}")
    return None


def close_comment_option(args: list[str]) -> tuple[int, int, str] | None:
    """Return the sole ``pr close`` comment option, in any gh-supported form."""

    found: tuple[int, int, str] | None = None
    index = 0
    while index < len(args):
        arg = args[index]
        candidate: tuple[int, int, str] | None = None
        if arg in ("--comment", "-c"):
            if index + 1 >= len(args):
                die(f"{arg} requires a value")
            candidate = (index, 2, args[index + 1])
        elif arg.startswith("--comment="):
            candidate = (index, 1, arg.split("=", 1)[1])
        elif arg.startswith("-c") and not arg.startswith("--"):
            candidate = (index, 1, arg[2:])
        if candidate is None:
            index += 1
            continue
        if found is not None:
            die("pr close must supply --comment exactly once")
        found = candidate
        index += candidate[1]
    return found


def rewrite_body_option(
    args: list[str],
    disclosure: disclosure_tag.Disclosure,
    *,
    required: bool,
    verdict: str | None = None,
) -> list[str]:
    found = body_option(args)
    if found is None:
        if required:
            return args + ["--body", attributed("", disclosure, verdict)]
        die("command has no supported --body/--body-file argument")
    index, consumed, body = found
    return (
        args[:index]
        + ["--body", attributed(body, disclosure, verdict)]
        + args[index + consumed :]
    )


def rewrite_close_comment(
    args: list[str], disclosure: disclosure_tag.Disclosure, verdict: str | None = None
) -> list[str]:
    found = close_comment_option(args)
    if found is None:
        die("pr close comment write has no --comment value")
    index, consumed, body = found
    return (
        args[:index]
        + ["--comment", attributed(body, disclosure, verdict)]
        + args[index + consumed :]
    )


def api_method(args: list[str]) -> str:
    for index, arg in enumerate(args):
        if arg in ("-X", "--method") and index + 1 < len(args):
            return args[index + 1].upper()
        if arg.startswith("--method="):
            return arg.split("=", 1)[1].upper()
    if any(arg in ("-f", "-F", "--field", "--raw-field") for arg in args):
        return "POST"
    return "GET"


def api_endpoint(args: list[str]) -> str:
    options_with_values = {
        "-X", "--method", "-H", "--header", "-f", "--raw-field", "-F",
        "--field", "--input", "--hostname", "--cache", "--jq", "-q",
        "--template", "-t",
    }
    skip = False
    for arg in args[1:]:
        if skip:
            skip = False
            continue
        if arg in options_with_values:
            skip = True
            continue
        if arg.startswith("-"):
            continue
        return arg
    return ""


# Subcommands whose body IS the artifact being created. The GitHub author is a
# constant on this fork, so an unattributed issue or pull request is
# indistinguishable from one the repository owner wrote himself. These fail
# closed when no body option is supplied rather than creating an unattributed
# artifact.
CREATED_BODY_COMMANDS = (["issue", "create"], ["pr", "create"])

# Subcommands that may REPLACE an existing body. Attributed only when a body
# option is actually present: `gh issue edit 1 --title x` writes no prose and
# must keep passing through untouched.
EDITED_BODY_COMMANDS = (["issue", "edit"], ["pr", "edit"])


def is_created_body_endpoint(endpoint: str) -> bool:
    """The REST endpoints that create an issue or a pull request."""
    endpoint = endpoint.split("?", 1)[0].strip("/")
    return bool(re.fullmatch(r"repos/[^/]+/[^/]+/(issues|pulls)", endpoint))


def is_comment_endpoint(endpoint: str) -> bool:
    endpoint = endpoint.split("?", 1)[0].strip("/")
    return bool(
        re.fullmatch(r"repos/[^/]+/[^/]+/(issues|pulls)/[^/]+/comments(?:/[^/]+)?", endpoint)
        or re.fullmatch(r"repos/[^/]+/[^/]+/pulls/[^/]+/reviews(?:/[^/]+)?", endpoint)
        or re.fullmatch(r"repos/[^/]+/[^/]+/commits/[^/]+/comments", endpoint)
        or re.fullmatch(r"repos/[^/]+/[^/]+/(issues|pulls)/comments/[^/]+", endpoint)
        or re.fullmatch(r"repos/[^/]+/[^/]+/comments/[^/]+", endpoint)
    )


def is_attributed_write(args: list[str]) -> bool:
    if len(args) >= 2 and args[:2] in (
        ["pr", "comment"],
        ["issue", "comment"],
        ["pr", "review"],
    ):
        return True
    if len(args) >= 2 and args[:2] in CREATED_BODY_COMMANDS:
        return True
    if len(args) >= 2 and args[:2] in EDITED_BODY_COMMANDS:
        return body_option(args) is not None
    if len(args) >= 2 and args[:2] == ["pr", "close"]:
        return close_comment_option(args) is not None
    if not args or args[0] != "api":
        return False
    if len(args) > 1 and args[1] == "graphql":
        joined = "\n".join(args[2:])
        return re.search(
            r"\b(addComment|addDiscussionComment|addPullRequestReview|"
            r"updateIssueComment|updatePullRequestReview|"
            r"updatePullRequestReviewComment)\b",
            joined,
        ) is not None
    method = api_method(args)
    endpoint = api_endpoint(args)
    if method in {"POST", "PATCH", "PUT"} and is_comment_endpoint(endpoint):
        return True
    # Creating an issue or a pull request through the raw API is the same
    # artifact as `issue create` / `pr create` and must not be a way around it.
    return method == "POST" and is_created_body_endpoint(endpoint)


def rewrite_api(
    args: list[str],
    disclosure: disclosure_tag.Disclosure,
    verdict: str | None = None,
) -> list[str]:
    if len(args) > 1 and args[1] == "graphql":
        die("raw GraphQL comment mutations cannot be attributed safely")
    method = api_method(args)
    endpoint = api_endpoint(args)
    attributable = is_comment_endpoint(endpoint) or (
        method == "POST" and is_created_body_endpoint(endpoint)
    )
    if method not in {"POST", "PATCH", "PUT"} or not attributable:
        return args
    if "--input" in args or any(arg.startswith("--input=") for arg in args):
        die("raw API comment mutation via --input cannot be attributed safely")
    for index, arg in enumerate(args):
        if arg in ("-f", "--raw-field", "-F", "--field") and index + 1 < len(args):
            if args[index + 1].startswith("body="):
                body = args[index + 1].split("=", 1)[1]
                rewritten = list(args)
                rewritten[index + 1] = f"body={attributed(body, disclosure, verdict)}"
                return rewritten
        for prefix in ("--raw-field=body=", "--field=body="):
            if arg.startswith(prefix):
                rewritten = list(args)
                rewritten[index] = (
                    f"{prefix}{attributed(arg[len(prefix):], disclosure, verdict)}"
                )
                return rewritten
    die(f"raw API comment mutation {method} {endpoint} has no supported body field")


def rewrite(
    args: list[str],
    disclosure: disclosure_tag.Disclosure,
    verdict: str | None = None,
) -> list[str]:
    if len(args) >= 2 and args[:2] in (["pr", "comment"], ["issue", "comment"]):
        return rewrite_body_option(args, disclosure, required=False, verdict=verdict)
    if len(args) >= 2 and args[:2] in CREATED_BODY_COMMANDS + EDITED_BODY_COMMANDS:
        return rewrite_body_option(args, disclosure, required=False, verdict=verdict)
    if len(args) >= 2 and args[:2] == ["pr", "review"]:
        return rewrite_body_option(args, disclosure, required=True, verdict=verdict)
    if len(args) >= 2 and args[:2] == ["pr", "close"]:
        return rewrite_close_comment(args, disclosure, verdict)
    if args and args[0] == "api":
        return rewrite_api(args, disclosure, verdict)
    return args


def is_verdict_write(args: list[str]) -> bool:
    """Whether this write creates a comment or review read by the marker grammar."""
    if len(args) >= 2 and args[:2] in (
        ["pr", "comment"],
        ["issue", "comment"],
        ["pr", "review"],
    ):
        return True
    if not args or args[0] != "api":
        return False
    return api_method(args) in {"POST", "PATCH", "PUT"} and is_comment_endpoint(
        api_endpoint(args)
    )


# ⚠️ THE COMMENT URL IS THE ONLY HONEST SOURCE FOR THIS RECORD.
# `gh pr comment` prints the permalink of the comment it created. Everything the
# record needs -- repo, pull request, comment id -- is IN that string, so the
# record is derived from what the post returned and never from the arguments the
# caller supplied. A caller can mistype `--repo`; it cannot mistype the URL
# GitHub handed back.
COMMENT_URL = re.compile(
    r"https://github\.com/[^/\s]+/[^/\s]+/pull/\d+#issuecomment-\d+"
)


def record_publication(task: str, actor: str, stdout: str) -> None:
    """Write the structured publication record, in the same operation as the post.

    WRITTEN AT POST TIME IS THE LOAD-BEARING PART. A field populated later by
    inference is the prose regex again with better manners: it would still be
    reconstructing "was something published" from a description of the act rather
    than recording the act. This function runs between the comment existing and
    this process exiting, and it writes the id GitHub just issued.

    FAILING TO RECORD MUST NOT FAIL THE POST. The comment already exists by the
    time we get here; a non-zero exit would tell the caller the publication did
    not happen, which is false, and false-negative is the worse error for a tool
    whose entire job is establishing that something was published. So a failure
    here WARNS LOUDLY on stderr and leaves the exit status alone -- the check
    then falls back to the prose regex and reports source=regex for this task,
    which is exactly the coverage signal that tells us the coupling has a hole.
    """
    match = COMMENT_URL.search(stdout or "")
    if match is None:
        print(
            "gh: WARNING — comment posted but no permalink was printed, so no "
            f"publication record was written to {task}. The publication check "
            "will fall back to matching prose for this task.",
            file=sys.stderr,
        )
        return
    url = match.group(0)
    parts = url.split("/")
    repo = f"{parts[3]}/{parts[4]}"
    pr = int(parts[6].split("#")[0])
    body = publication_record.render_publication(repo, pr, url, actor)
    try:
        result = subprocess.run(
            ["tg", "note", task, body], capture_output=True, text=True
        )
        if result.returncode != 0:
            raise RuntimeError(result.stderr.strip() or f"tg note exited {result.returncode}")
    except Exception as exc:  # noqa: BLE001 - see the docstring: never fail the post
        # ⚠️ THE RECOVERY HINT MUST BE THE RECORD ITSELF, not the URL. A hint that
        # says "note the link" produces PROSE, which only the fallback regex can
        # read -- the operator would follow the instructions and still not have a
        # record. Printing the exact body keeps the manual path and the automatic
        # path producing the same artifact.
        indented = "\n".join("       " + line for line in body.splitlines())
        print(
            f"gh: WARNING — posted {url} but could not record it on {task}: {exc}\n"
            "     The comment is real; only its record is missing. Re-record by\n"
            f"     passing EXACTLY this body to `tg note {task}`:\n{indented}",
            file=sys.stderr,
        )
        return
    print(f"gh: recorded publication {url} on {task}", file=sys.stderr)


def post_and_record(args: list[str], task: str, actor: str) -> int:
    """Run the comment write, pass its output through verbatim, then record it.

    Capturing is a behaviour change and is kept as small as possible: stdout and
    stderr are re-emitted unmodified so anything parsing this tool's output sees
    what it saw before.
    """
    result = subprocess.run([real_gh(), *args], capture_output=True, text=True)
    if result.stdout:
        sys.stdout.write(result.stdout)
        sys.stdout.flush()
    if result.stderr:
        sys.stderr.write(result.stderr)
        sys.stderr.flush()
    if result.returncode == 0:
        record_publication(task, actor, result.stdout)
    return result.returncode



def main() -> int:
    args, supplied = disclosure_options(sys.argv[1:])
    task = supplied.get("task")
    verdict = supplied.get("verdict")
    if verdict is not None and not is_verdict_write(args):
        die("--verdict only applies to a comment or review write")
    if is_attributed_write(args):
        claimed_agent, team, role = required_disclosure(supplied)
        disclosure = validate_disclosure(claimed_agent, team, role)
        args = rewrite(args, disclosure, verdict)
        # A named task is what couples the publication to its record. It is
        # optional so that every existing caller keeps working unchanged, and
        # `drain_publication.py` measures the resulting coverage per task rather
        # than assuming it.
        if task and args[:2] in (["pr", "comment"], ["issue", "comment"]):
            return post_and_record(args, task, claimed_agent)
    elif task or verdict is not None:
        option = "--task" if task else "--verdict"
        die(f"{option} only applies to a comment write")
    return subprocess.run([real_gh(), *args]).returncode


if __name__ == "__main__":
    raise SystemExit(main())
