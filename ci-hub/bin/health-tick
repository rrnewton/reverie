#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git -C "$(dirname -- "${BASH_SOURCE[0]}")/../.." rev-parse --show-toplevel)
case ${1:-} in
    help|-h|--help) export CI_HUB_TOOL_COST_ACTIVE=1 ;;
esac
if [[ -z ${CI_HUB_TOOL_COST_ACTIVE:-} ]]; then
    exec env CI_HUB_TOOL_COST_ACTIVE=1 "$ROOT/ci-hub/bin/tool-cost" \
        --tool ci-hub/health-tick \
        --estimate-unknown \
        --basis "not measured: due operational-health gates vary and tick cost history is not retained" \
        -- "$0" "$@"
fi
# The ORC production path supplies the full agent array on every scheduled tick:
# `HERMIT_AGENT_SNAPSHOT_JSON="$1" ./ci-hub/bin/health-tick --flush --no-header`.
# Persist that observation for `ci-hub active-work`, whose complete claim census
# requires status and current_task rather than tmux window names alone.
#
# A rejected snapshot must not stop every other health gate. `cache-agents`
# validates before replacing the previous file; on refusal, say so and continue
# through the gates, then retain the nonzero result so the producer failure cannot
# read as health while active-work keeps its fail-closed fallback.
cache_status=0
if [[ -n ${HERMIT_AGENT_SNAPSHOT_JSON:-} ]]; then
    if cache_result=$(
        python3 "$ROOT/ci-hub/health/operational_health.py" cache-agents 2>&1
    ); then
        :
    else
        cache_status=$?
        printf 'ERROR: could not cache the ORC agent snapshot: %s\n' "$cache_result" >&2
    fi
fi
cd "$ROOT"

# Hard Invariant 13 is an aggregate COUNT, not an idleness threshold.  The
# worktree_disk_residue reminder inherits this explicit policy value and fails
# whenever the active registry count exceeds it, even if every individual slot
# is fresh.  Keep the default in slot_disk_residue.py for direct invocations;
# spelling it here binds the running tick to the policy instead of ambient state.
export DEV_HERMIT_ACTIVE_SLOT_CAP=12

# A quiet evaluation does not necessarily clear text retained by the caller's
# display.  Make every human-visible warning self-dating so retained output
# cannot be mistaken for a claim about the current tree.  input_sha is the
# parent commit that selected this tick configuration and its gate producers;
# both values are captured once, before the evaluation starts.
observed_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
input_sha=$(git -C "$ROOT" rev-parse --verify 'HEAD^{commit}')
evaluation_provenance="observed_at=$observed_at input_sha=$input_sha"

emit_with_evaluation_provenance() {
    local line
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ -n $line ]]; then
            printf 'reported\n' > "$report_marker"
        fi
        case "$line" in
            ACTION:*)
                # tick-hub appends title="..." as the ACTION's displayed text.
                # Put provenance inside that title, not only in machine fields
                # that a coordinator UI may omit.
                if [[ $line == *' title="'* && ${line: -1} == '"' ]]; then
                    printf '%s %s"\n' "${line::-1}" "$evaluation_provenance"
                else
                    printf '%s title="%s"\n' "$line" "$evaluation_provenance"
                fi
                ;;
            NOTE:*)
                printf '%s %s\n' "$line" "$evaluation_provenance"
                ;;
            *)
                printf '%s\n' "$line"
                ;;
        esac
    done
}

# The producer runs on the left side of a pipeline, so the annotator cannot
# return an in-process boolean saying whether it saw output. A private marker
# distinguishes "the tick returned a gate verdict" from "the tick died before
# reporting anything" without buffering or delaying the live report.
report_marker=$(mktemp)
cleanup_report_marker() { local rc=$?; rm -f "$report_marker"; exit "$rc"; }
trap cleanup_report_marker EXIT

# Carry the provenance verdict INTO the report rather than leaving it on stderr.
#
# "agent-utils is dirty" and "health could not be determined" are different
# states: the first is a note about one input, the second is a claim about
# everything. Before this, the first was fatal to the second -- one dirty file
# in a checkout agents are INSTRUCTED to edit directly stopped every gate from
# running, and the fleet went dark with no warning to whoever dirtied it.
#
# Now the gates run and this line names exactly what is unverified. A reader who
# sees it knows the tick's own version is unpinned; a reader who does not see it
# knows provenance was clean. It is emitted ONLY when dirty, so it cannot become
# the permanent "undetermined" that would be as useless as the outage.
if [[ -n $(git -C "$ROOT/agent-utils" status --porcelain 2>/dev/null) ]]; then
    dirt_paths=$(git -C "$ROOT/agent-utils" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    echo "component=agent-utils-provenance state=undetermined" \
         "reason=agent-utils dirty at pinned commit ($dirt_paths path(s)); the tick harness is" \
         "not the reviewed pinned commit. Gate RESULTS below are parent-repo logic and stand."
fi

set +e
"$ROOT/ci-hub/bin/agent-tool" tick-hub tick \
    --config "$ROOT/ci-hub/health/tick-hub.yaml" \
    --state "$ROOT/.ops-state.yaml" \
    --fired-state "$ROOT/.tick-hub/fired-state" \
    --current-tick-min 60 \
    "$@" | emit_with_evaluation_provenance
pipeline_status=("${PIPESTATUS[@]}")
set -e

# The wrapper must not turn a failing evaluation into success.  If annotation
# itself fails, surface that only when the producer succeeded; otherwise retain
# the producer's exact nonzero status.
if (( pipeline_status[0] != 0 )); then
    # ⚠️ A TICK THAT DIES BEFORE READING ITS CONFIG LOOKS EXACTLY LIKE A CLEAN ONE.
    # Measured 2026-08-26: agent-tool refused on an agent-utils gitlink mismatch and
    # exited 1 in 0.57s, before a single gate ran. The timer kept firing every five
    # minutes, each run silent, and NOTHING SAID THAT 35 CHECKS HAD NOT RUN. It was
    # found by accident. Absence of ACTION lines meant "all clear" and "nothing was
    # looked at" at the same time, which is the one thing this tool must never do.
    #
    # So a nonzero producer status with NO REPORT announces the size of what went
    # unobserved. A nonzero status after output is a normal gate verdict and keeps
    # that report without falsely claiming nothing ran. The no-report count is read
    # STRAIGHT FROM THE CONFIG with grep, deliberately not through tick-hub: the
    # announcement has to work in exactly the case where tick-hub is the thing that
    # is broken. An unreadable config degrades to "unknown", never to silence and
    # never to zero -- a zero here would re-create the defect.
    if [[ ! -s $report_marker ]]; then
        tick_config="$ROOT/ci-hub/health/tick-hub.yaml"
        if [[ -r $tick_config ]]; then
            not_run=$(grep -cE '^  - name:' "$tick_config" || true)
            [[ $not_run =~ ^[1-9][0-9]*$ ]] || not_run=unknown
        else
            not_run=unknown
        fi
        printf 'ERROR: tick exited %s before reporting; %s configured check(s) DID NOT RUN\n' \
            "${pipeline_status[0]}" "$not_run"
        printf 'ACTION: hard-warn-coordinator component=tick-hub-reporting outcome=NO-SIGNAL gate=ALL reason=tick-exited-before-gates detail="producer exit %s; %s configured check(s) unobserved; this is NOT a clean tick" title="NO-SIGNAL gate=ALL: the tick exited %s before running any gate; %s check(s) unobserved"\n' \
            "${pipeline_status[0]}" "$not_run" "${pipeline_status[0]}" "$not_run"
    fi
    exit "${pipeline_status[0]}"
fi
if (( cache_status != 0 )); then
    exit "$cache_status"
fi
exit "${pipeline_status[1]}"
