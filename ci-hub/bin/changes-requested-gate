# REFUSE a merge when a review refusal is bound to the exact head.
#
# ⚠️ WHY THIS EXISTS: THERE WAS NO GATE. Measured 2026-08-25, `grep -rn
# CHANGES-REQUESTED-AT` across every .py/.sh/.rs in this repository returned hits
# in ci-hub/health/approval_binding.py and IN ITS OWN TESTS, and nowhere else. No
# lander, no merge gate, no workflow read a refusal marker. approval_binding.py is
# reached only by ci-hub/health/pr_status.py, which REPORTS. The merge itself is
# `gh pr merge` run by an agent, so the only thing between a live refusal and a
# landing was whether that agent happened to read the comments.
#
# hermit#2591 is what that costs:
#     17:55:19Z  APPROVED-AT: claude 86b76b82           (column 0)
#     18:05:19Z  CHANGES-REQUESTED-AT: claude 86b76b82  (COLUMN 0, plain, parses)
#     18:09:01Z  MERGED
#     18:12:00Z  passed-review-claude labeled -- three minutes AFTER the merge
# A plain, parseable, binding refusal was live 3m42s before the merge, and there
# was no approval label at merge time either. Neither the marker path nor the
# label path was consulted, because neither was wired to anything.
#
# ⚠️ A CONVENTION ENFORCED BY EVERY PARTICIPANT REMEMBERING IS NOT A GATE. It fails
# the first time one participant does not. Five separate fixes on 2026-08-25 --
# the parser fail-open, the lander refusal, the loud-on-unknown net, the fourth
# variant, the stale label -- all made readers better at NOTICING a block. None of
# them refuses. This one refuses.
#
# ⚠️ IT KEYS ON THE MARKER'S PRESENCE, NOT ON A FORM THAT PARSES. A fourth marker
# variant already escaped both the canonical grammar and the loud-on-unknown net,
# so requiring a parseable form reproduces the defect. The rule is:
#
#     the token appears in the line, AND a lane name follows it within a short
#     window -- OR the token begins the line once decoration is stripped.
#
# Nothing about the separator, the ordering, the decoration or WHAT PRECEDES THE
# TOKEN has to be canonical. See markers() for why a line-initial-only rule is
# still a form rule, and for the measurement that chose this one.
#
# If a sha can be extracted and it names the head, REFUSE. If a sha can be
# extracted and it names some other commit, that refusal was cleared by a later
# push and does not bind. AND IF NO SHA CAN BE EXTRACTED AT ALL, REFUSE ANYWAY:
# a marker whose binding cannot be determined must not be waved through, because
# "I could not read it" is not "it does not apply". That is the case the fourth
# variant occupied.
#
# ⚠️ AND IT REFUSES WHEN IT CANNOT RUN. Every path that fails to produce an answer
# -- unresolvable head, unreadable comment container, unreachable API -- returns
# INDETERMINATE (2), and both callers treat non-zero as blocking. A gate that can
# skip itself when its environment is wrong reproduces the defect it fixes: the
# existing admission check was found silently DISABLED by a stale primary, which
# is the same shape as a marker that cannot be bound being read as absent.
#
# Usage:
#   changes-requested-gate --repo OWNER/REPO --pr N [--head SHA]
#
# Exit status:
#   0  no refusal binds this head -- the merge may proceed
#   1  BLOCKED: a refusal is bound to this exact head
#   2  INDETERMINATE: a marker exists that cannot be bound, or the data could not
#      be fetched. Callers MUST treat this as blocking; it is not "no".
# `from __future__ import annotations` so the PEP 604 / PEP 585 annotations below
# do not evaluate at import time. Without it this file raises TypeError on an
# older python3 -- measured: /usr/bin/python3 crashed at the first annotated def.
# A gate that dies on import still fails CLOSED here, because both callers treat
# non-zero as blocking, but it reported BLOCKED for what was really COULD-NOT-RUN,
# and recording "I could not check" as "a reviewer refused" is a false verdict.
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys

# ⚠️ THE FENCE RULE IS IMPORTED, NOT COPIED. This gate already carries its own
# marker grammar, and that second copy is exactly what diverged from
# gh-merge-verified: measured 2026-08-25, the two paths disagreed on 6 of 28 open
# heads. Eligibility -- WHICH LINES may carry a verdict at all -- now has one
# definition in ci-hub/health/approval_binding.py and both landers call it.
# Policy still differs here (this gate fails closed on an unbindable refusal); the
# grammar and the eligibility rule may not.
def _load_grammar():
    import importlib.util
    import pathlib
    target = pathlib.Path(__file__).resolve().parent.parent / "health" / "approval_binding.py"
    spec = importlib.util.spec_from_file_location("approval_binding", target)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module

OK, BLOCKED, INDETERMINATE = 0, 1, 2

REFUSAL = "CHANGES-REQUESTED-AT"
WITHDRAWN = "CHANGES-REQUESTED-WITHDRAWN-AT"
# ⚠️ THE SUFFIX-LESS SPELLING, WHICH FAILED OPEN. A reviewer who writes
# `CHANGES-REQUESTED: claude <sha>` -- bare line, column zero, correct lane,
# correct 40-hex, one token wrong -- was flagged malformed and NOT HONOURED: this
# gate returned CLEAR and the lane's approval stood. hermit#1689 lost two blocking
# reviews that way and sat 19 days; hermit#2611 merged 24 minutes after a block
# written in this form.
#
# THE ASYMMETRY IS THE POINT. A malformed REFUSAL must still refuse and a
# malformed APPROVAL must not bind, because the two errors are not symmetric:
# someone intending to block is not a weaker signal than someone intending
# nothing. Reading an unparseable refusal as "proceed" inverts the author's
# stated intent; reading it as "stop" costs a re-post.
REFUSAL_BARE = "CHANGES-REQUESTED"

# Block-level decoration seen on real markers, stripped repeatedly until stable.
_DECOR = re.compile(r"^(\s|#{1,6}\s*|>\s*|[-*+]\s+|\*{1,3}|_{1,3}|`{1,3})+")
_SHA = re.compile(r"\b([0-9a-f]{7,40})\b")
_LANE = re.compile(r"\b(claude|codex)\b", re.I)
# ⚠️ A DOCUMENTATION EXAMPLE IS NOT A REFUSAL, AND THIS COST A REAL LANDING.
# Measured 2026-08-25 on hermit#2611: a comment explaining the convention contained
#     CHANGES-REQUESTED-AT: claude <sha>   ->  refuses, clears the lane
# which is line-initial, names a lane, and carries no hex -- so the gate returned
# INDETERMINATE and refused a head that had just been approved. That is precisely
# the "blocks a pull request for EXPLAINING the rule" failure this gate's own
# docstring warns gets it switched off, and it appeared in a comment posted AFTER
# the corpus measurement that found zero false positives.
#
# The discriminator is narrow on purpose: an ANGLE-BRACKET PLACEHOLDER where the
# sha belongs. A reviewer refusing a head writes a sha, or writes prose -- they do
# not write `<sha>`. So `CHANGES-REQUESTED-AT: claude -- see above` still refuses
# (no sha, no placeholder, genuinely unbindable), and only the template form is
# treated as documentation.
# The placeholder rule now lives in the shared grammar; see is_template there.
# Kept as a name so the docstring above still reads, but sourced from one place.


def undecorate(line: str) -> str:
    prev = None
    out = line
    while prev != out:
        prev = out
        out = _DECOR.sub("", out.strip())
    return out


def gh_json(args: list[str]) -> object:
    # with-proxy is what makes gh reach the network on these hosts; without it the
    # call fails as "network is unreachable" and would otherwise be indistinguishable
    # from "no comments", which is exactly the fail-open this gate exists to remove.
    for argv in (["with-proxy", "gh", *args], ["gh", *args]):
        try:
            r = subprocess.run(argv, capture_output=True, text=True, timeout=180)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0 and r.stdout.strip():
            try:
                return json.loads(r.stdout)
            except json.JSONDecodeError:
                continue
    return None


def markers(bodies: list[str]) -> list[tuple[str, str | None]]:
    """Every marker-shaped line, as (kind, sha-or-None), in document order.

    ⚠️ A WORD BEFORE THE TOKEN USED TO MAKE THE MARKER INVISIBLE, HERE AND IN EVERY
    OTHER EXTRACTOR IN USE. Found by agent(hermit-001). Stripping only markdown
    decoration and then requiring the line to START with the token misses all of:

        VERDICT: CHANGES-REQUESTED-AT: claude <sha>
        Posting CHANGES-REQUESTED-AT: claude <sha> now
        **Verdict:** CHANGES-REQUESTED-AT: claude <sha>
        1. CHANGES-REQUESTED-AT: claude <sha>

    all measured CLEAR against the shipped rule. A gate keyed on the token being
    line-initial is still keyed on a FORM, just a laxer one, so it inherits exactly
    the blindness it was meant to remove.

    THE RULE NOW: the token appears, AND a lane name follows it within a short
    window. That is presence, not grammar -- nothing about the separator, the
    ordering, the decoration or what precedes it has to be canonical.

    WHY NOT SIMPLY "THE TOKEN APPEARS ANYWHERE", which is the purest form of
    presence: measured on all 27 open pull requests on 2026-08-25,

        rule                       marker lines    PRs blocked
        line-initial (shipped)               12              8
        token + lane within 24 chars         26              8
        token anywhere                       39              9

    the lane rule catches MORE THAN DOUBLE the marker lines of the shipped rule at
    ZERO additional pull requests blocked, while matching anywhere adds one pure
    false positive (hermit#2216, three prose sentences discussing the convention).
    Notes discuss these markers constantly -- this docstring contains the token
    six times -- so "anywhere" blocks pull requests for explaining the rule, the
    gate gets switched off, and we are back to a convention. The lane rule is the
    widest net measured to cost nothing.
    """
    found = []
    eligible = _load_grammar().marker_lines
    for body in bodies:
        for raw in eligible(body or ""):
            line = undecorate(raw)
            # Longest first: WITHDRAWN contains REFUSAL, which contains REFUSAL_BARE.
            # A bare hit is recorded AS a refusal -- the downstream binding,
            # withdrawal and indeterminate logic is deliberately unchanged, so the
            # suffix-less spelling gets exactly the treatment the canonical one
            # gets and nothing special.
            for kind in (WITHDRAWN, REFUSAL, REFUSAL_BARE):
                idx = line.find(kind)
                if idx < 0:
                    continue
                tail = line[idx + len(kind):]
                # Line-initial keeps the bare form working even with no lane named;
                # otherwise a lane must follow closely for this to be a marker.
                if idx != 0 and not _LANE.search(tail[:24]):
                    continue
                m = _SHA.search(tail)
                if m is None and _load_grammar().is_template(tail):
                    break  # a template, not a verdict
                found.append((REFUSAL if kind == REFUSAL_BARE else kind,
                              m.group(1) if m else None))
                break
            else:
                # ⚠️ NO CANONICAL TOKEN ON THIS LINE -- BUT A REFUSAL THAT OMITS THE
                # `-AT` IS STILL A REFUSAL, AND UNTIL NOW THIS GATE COULD NOT SEE
                # ONE. `line.find(REFUSAL)` matches the literal
                # `CHANGES-REQUESTED-AT`, so `CHANGES-REQUESTED: claude <sha>` --
                # which the grammar reports MALFORMED and every human reads as a
                # block -- entered no branch here and the merge proceeded.
                # gh-merge-verified refuses it since `7db64676`; this path did not,
                # and this path is the one `land-pr.sh` uses. Measured on
                # https://github.com/rrnewton/hermit/pull/2611:
                # `CHANGES-REQUESTED: claude 7a75909c92ae` at the exact head.
                #
                # Same policy as above -- line-initial, or a lane close behind --
                # and the same shared grammar decides what is refusal-shaped, so
                # the two landers cannot drift apart on it again.
                near = _load_grammar().near_miss_refusal(line)
                if near is None:
                    continue
                tail = line[near.end():]
                if near.start() != 0 and not _LANE.search(tail[:24]):
                    continue
                if _load_grammar().is_template(tail):
                    continue
                m = _SHA.search(tail)
                found.append((REFUSAL, m.group(1) if m else None))
    return found


def head_is_main_equal(source: str, head: str) -> bool:
    """Does `head` carry nothing over origin/main in `source`?

    ⚠️ A WIPED BRANCH IS NOT A CLEAN HEAD, AND IT LAUNDERS EVERY REFUSAL. Something
    on this box closes pull requests and RESETS BRANCHES to main-equal on a ~10
    minute cadence -- hermit#2448 four times. When that happens the head sha MOVES,
    so every refusal naming the old sha stops binding and this gate reports its most
    reassuring verdict: "refusal marker(s) present but none names <head> -- superseded
    by a later push, the correct clearing path". That sentence is equally true of an
    author pushing a fix and of a branch wiped out from under the review, and comments
    alone cannot tell them apart.

    A main-equal head also merges as a NO-OP, so the pull request closes as "merged"
    while its content never landed -- a landing verified before a wipe looks identical
    to one that reverted itself.

    FAILS SAFE TOWARD NOT-WIPED: if git cannot answer, this returns False and the
    verdict is unchanged, because inventing a wipe would refuse honest heads. The
    check is skipped entirely without --source, which the caller states rather than
    hiding. Measured 2026-08-25: 0 of 28 open heads were main-equal, so this costs
    nothing today and exists for the state the wipe leaves behind.
    """
    try:
        subprocess.run(["git", "-C", source, "fetch", "-q", "--force", "origin",
                        "refs/heads/main:refs/tmp/crg/main"],
                       capture_output=True, timeout=120, check=False)
        r = subprocess.run(["git", "-C", source, "diff", "--name-only",
                            "refs/tmp/crg/main", head],
                           capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return False
    if r.returncode != 0:
        return False
    return r.stdout.strip() == ""


def evaluate(bodies: list[str], head: str) -> tuple[int, str]:
    found = markers(bodies)
    if not found:
        return OK, "no refusal marker of any shape on this pull request"

    def binds(sha: str | None) -> bool:
        # Abbreviated shas are normal in these markers; bind by prefix, both ways.
        return bool(sha) and (head.startswith(sha) or sha.startswith(head))

    withdrawn_at_head = any(k == WITHDRAWN and binds(s) for k, s in found)
    refusals = [(k, s) for k, s in found if k == REFUSAL]

    # ⚠️ A DEFINITE ANSWER OUTRANKS AN UNREADABLE ONE. Both block, so safety does
    # not depend on the order -- but reporting INDETERMINATE when a refusal is
    # demonstrably bound to this head describes the pull request wrongly, and the
    # author is then told to re-post a marker when what they actually need is a fix
    # or a withdrawal. Measured on hermit#2176: a bound refusal AND a sha-less
    # mention coexist, and checking unbindable first reported the weaker verdict.
    bound = [s for k, s in refusals if binds(s)]
    if bound and withdrawn_at_head:
        return OK, f"a refusal named {head[:12]} but {WITHDRAWN} clears it at the same head"
    if bound:
        return (
            BLOCKED,
            f"{len(bound)} refusal(s) bound to the exact head {head[:12]}. A refusal "
            f"naming the head blocks regardless of any lane's approval. This clears "
            f"when the AUTHOR pushes a fix (the sha moves and the refusal stops naming "
            f"the head) or the reviewer posts {WITHDRAWN} at this sha.",
        )

    unbindable = [s for k, s in refusals if s is None]
    if unbindable:
        return (
            INDETERMINATE,
            f"{len(unbindable)} refusal marker(s) carry no readable sha, so whether "
            f"they bind {head[:12]} cannot be decided. Refusing: a marker that cannot "
            f"be bound is not a marker that does not apply. Re-post it as "
            f"'{REFUSAL}: <lane> <40-hex>' on its own line, or withdraw it.",
        )

    if bound and withdrawn_at_head:
        return OK, f"a refusal named {head[:12]} but {WITHDRAWN} clears it at the same head"
    if bound:
        return (
            BLOCKED,
            f"{len(bound)} refusal(s) bound to the exact head {head[:12]}. A refusal "
            f"naming the head blocks regardless of any lane's approval. This clears "
            f"when the AUTHOR pushes a fix (the sha moves and the refusal stops naming "
            f"the head) or the reviewer posts {WITHDRAWN} at this sha.",
        )
    return (
        OK,
        f"{len(refusals)} refusal marker(s) present but none names {head[:12]} "
        f"-- superseded by a later push, the correct clearing path",
    )


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--repo", required=True)
    p.add_argument("--pr", required=True)
    p.add_argument("--head")
    p.add_argument("--source", help="a checkout, so a main-equal (wiped) head can be detected")
    p.add_argument("--from-json", help="offline: a JSON array of comment bodies")
    args = p.parse_args(argv)

    if args.from_json:
        with open(args.from_json, encoding="utf-8") as fh:
            bodies = json.load(fh)
        head = args.head or ""
    else:
        head = args.head
        if not head:
            view = gh_json(["pr", "view", args.pr, "-R", args.repo, "--json", "headRefOid"])
            head = (view or {}).get("headRefOid") if isinstance(view, dict) else None
        if not head:
            print(
                f"changes-requested-gate: INDETERMINATE pr={args.pr} "
                f"reason=could not resolve the head sha",
                file=sys.stderr,
            )
            return INDETERMINATE
        # ⚠️ A WIPED BRANCH IS NOT A CLEAN HEAD, AND IT LAUNDERS EVERY REFUSAL.
        # Something on this box closes pull requests and RESETS BRANCHES to
        # main-equal on a ~10 minute cadence -- hermit#2448 four times. When that
        # happens the head sha MOVES, so every refusal naming the old sha stops
        # binding and this gate reports the most reassuring verdict it has:
        # "refusal marker(s) present but none names <head> -- superseded by a later
        # push, the correct clearing path". That sentence is true of an author
        # pushing a fix and equally true of a branch that was wiped out from under
        # the review, and the gate cannot tell them apart from comments alone.
        #
        # A main-equal head also merges as a NO-OP, so the pull request closes as
        # "merged" while its content never landed -- a landing verified before a
        # wipe looks identical to one that reverted itself.
        #
        # Cheap discriminator: if the head carries nothing over main, it is not a
        # head worth clearing. Requires --source; without it this cannot be checked
        # and is skipped, which is stated rather than silent.
        # Issue comments are where every marker observed to date lives; reviews and
        # review comments were both EMPTY on hermit#2176, checked 2026-08-25. Read
        # all three anyway -- a container this gate does not read is a way past it.
        bodies = []
        for path in (
            f"repos/{args.repo}/issues/{args.pr}/comments?per_page=100",
            f"repos/{args.repo}/pulls/{args.pr}/reviews?per_page=100",
            f"repos/{args.repo}/pulls/{args.pr}/comments?per_page=100",
        ):
            got = gh_json(["api", path, "--paginate"])
            if got is None:
                print(
                    f"changes-requested-gate: INDETERMINATE pr={args.pr} "
                    f"reason=could not read {path.split('?')[0]}; a failed query is "
                    f"not an empty result",
                    file=sys.stderr,
                )
                return INDETERMINATE
            bodies.extend(c.get("body") or "" for c in got if isinstance(c, dict))

    rc, why = evaluate(bodies, head)

    # A main-equal head cannot CLEAR a pull request that carries refusal markers.
    # Only downgrades OK -> INDETERMINATE; a BLOCKED verdict is already correct and
    # is left alone.
    if rc == OK and args.source and markers(bodies) and head_is_main_equal(args.source, head):
        rc, why = (
            INDETERMINATE,
            f"the head {head[:12]} carries NOTHING over main, and this pull request has "
            f"refusal marker(s) naming other shas. 'Superseded by a later push' and "
            f"'the branch was wiped out from under the review' are the same sentence "
            f"from comments alone, and a main-equal head merges as a no-op -- the pull "
            f"request would close as merged with nothing landed. Refusing until the head "
            f"carries the change again.",
        )

    label = {OK: "CLEAR", BLOCKED: "BLOCKED", INDETERMINATE: "INDETERMINATE"}[rc]
    stream = sys.stdout if rc == OK else sys.stderr
    print(f"changes-requested-gate: {label} pr={args.pr} head={head[:12]} -- {why}", file=stream)
    return rc


if __name__ == "__main__":
    # ⚠️ AN UNEXPECTED CRASH IS INDETERMINATE, NEVER BLOCKED. Both are non-zero and
    # both stop the merge, so safety does not depend on telling them apart -- but a
    # crash reported as BLOCKED reads afterwards as "a reviewer refused this head",
    # which is a claim about the pull request that nobody made.
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except BaseException as exc:  # noqa: BLE001 -- deliberately total
        print(f"changes-requested-gate: INDETERMINATE -- the gate itself failed to run "
              f"({type(exc).__name__}: {exc}). Nothing was checked; this is NOT a statement "
              f"about the pull request.", file=sys.stderr)
        raise SystemExit(INDETERMINATE)
