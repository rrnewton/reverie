# PATH shim for `tg`: refuse inline `tg note` content, require the verified path.
#
# OPTIONAL DEPLOYMENT TARGET: /home/newton/orc-bin/tg, ahead of /usr/local/bin
# on the intended PATH. THIS FILE IS THE SOURCE OF TRUTH; its presence in the
# repository does not prove that the copy exists or is selected. Verify both
# `command -v tg` and byte identity before claiming these guards are active.
# Even then, an explicit `/usr/local/bin/tg` invocation bypasses this PATH shim.
# Refresh an existing deployment with
#     cp ci-hub/bin/tg-guard-shim /home/newton/orc-bin/tg
# and remove that deployment with
#     rm /home/newton/orc-bin/tg
# A copy rather than a symlink on purpose: a dangling symlink in PATH would take
# `tg` out for every agent at once, which is a worse failure than drift.
#
# WHY A PATH SHIM AND NOT A SHELL FUNCTION. Measured 2026-08-25: `~/.bashrc`
# returns at line 4 on `[[ $- != *i* ]] && return`, and non-interactive bash does
# not read it at all, so a `tg()` function there NEVER FIRES for the way agents
# actually run commands. It looked installed and enforced nothing.
#
# WHY IT REFUSES THE FORM, NOT THE CONTENT. `tg note X "$var"` and
# `tg note X "literal $(cmd)"` arrive here with IDENTICAL argv -- the shell
# substituted before anything ran, so the damage is undetectable at this layer.
# That is the same reason tg itself cannot refuse it. The only enforceable rule
# is to refuse inline content at all.
#
# FAILS OPEN. Anything that is not `tg note` with content is exec'd untouched.
REAL=/usr/local/bin/tg
if [ "${1:-}" = "note" ] && [ "$#" -ge 3 ] && [ -z "${TG_NOTE_VERIFIED:-}" ]; then
    printf '%s\n' \
"tg: REFUSED -- inline note content is not allowed." \
"" \
"  The shell substitutes backticks, \$(...) and \$? BEFORE tg runs, so what you typed" \
"  may not be what gets stored, and tg cannot tell the difference. Measured in this" \
"  project's own record: a note written 'indistinguishable from \$?' is stored as" \
"  'indistinguishable from 0' -- a different and wrong claim, confirmed as success." \
"" \
"  Use the verified path. It reads the note back out of the database and compares" \
"  it byte-for-byte before confirming:" \
"    /home/newton/work/dev-hermit/ci-hub/bin/tg-note-verified $2 --file NOTE.md" \
"    /home/newton/work/dev-hermit/ci-hub/bin/tg-note-verified $2 <<'EOF'" \
"    ...text, quoted heredoc so nothing is substituted..." \
"    EOF" \
"" \
"  READING notes is unaffected: 'tg note $2' with no content still works." >&2
    exit 2
fi

# ─────────────────────────────────────────────────────────────────────────────
# CONDITIONAL CLOSURE GUARD: when this shim is the resolved `tg`,
# `tg update <task> --status closed` must go through the verifier. This section
# describes the shim's behavior; it is not evidence that the shim is deployed.
#
# WHY, MEASURED 2026-08-25. Of 535 tasks closed that day only 60 carried a
# CLOSURE-VERIFIED note -- close-task was bypassed on ~89% of closures. This was
# NOT the 18-minute close-task outage that morning: in the 44 minutes AFTER that
# was fixed, 38 more tasks closed unverified, 10 of them tagged `landed`. And the
# population grew WHILE it was being repaired by hand -- 530 to 535 closures, two
# more unverified landing claims, inside six minutes. Repairing instances is a
# treadmill; the bypass rate is the defect. A safe path that exists but is not
# forced does not change behaviour, which is the same lesson the `tg note` guard
# above records.
#
# WHY IT IS NOT SIMPLY "REQUIRE --code". Of the 477 unverified closures that day,
# 380 named a PR or SHA in their notes and could have used the verifier -- but 97
# named nothing, because review lanes, coordination, duplicates and answered
# questions have no landing to prove. Refusing those would make the rule
# unfollowable and it would be routed around. close-task therefore grew
# `--disposition REASON`, which records CLOSURE-RECORDED (a DIFFERENT anchor, so
# it cannot inflate the CLOSURE-VERIFIED metric) and is itself REFUSED on any task
# tagged `implemented` or `landed`.
#
# FAILS OPEN, DELIBERATELY. Only `update ... --status closed|resolved` is caught.
# Changing tags, priority, owner, or moving a task to open/in_progress is
# untouched, and so is every other subcommand.
if [ "${1:-}" = "update" ] && [ -z "${CLOSE_TASK_VERIFIED:-}" ]; then
    task=${2:-<task>}; prev=""; blocked=""
    for arg in "$@"; do
        case "$prev" in
            --status) case "$arg" in closed|CLOSED|resolved|RESOLVED) blocked=$arg ;; esac ;;
        esac
        case "$arg" in --status=*) case "${arg#--status=}" in closed|CLOSED|resolved|RESOLVED) blocked=${arg#--status=} ;; esac ;; esac
        prev=$arg
    done
    if [ -n "$blocked" ]; then
        printf '%s\n' \
"tg: REFUSED -- while this optional shim is active, direct closure bypasses the closure verifier." \
"" \
"  Measured 2026-08-25: 535 tasks closed, only 60 recorded any closure evidence." \
"  Closed status alone proves neither who closed the task nor whether code landed." \
"  This shim requires the gateway to classify the closure and record its evidence." \
"" \
"  IF THE TASK HAS CODE TO RECORD, whether implemented or landed, name it:" \
"    /home/newton/work/dev-hermit/ci-hub/bin/close-task $task \\\\" \
"        --code <PR-or-40-hex> --repo <owner/repo> --source <checkout>" \
"  It records a resolvable unlanded product change as implemented-unlanded, or" \
"  verifies landed code against freshly-fetched main, then closes the task itself." \
"" \
"  IF THERE IS NOTHING TO LAND -- a review lane, a duplicate, a question answered:" \
"    /home/newton/work/dev-hermit/ci-hub/bin/close-task $task \\\\" \
"        --disposition 'superseded by hermit#1234'" \
"  That records the reason instead of a reference. It is refused on tasks tagged" \
"  \`implemented\` or \`landed\`, which have a reference to give." \
"" \
"  Everything else about 'tg update' still works: tags, priority, owner, and" \
"  moving a task to open or in_progress are untouched." >&2
        exit 2
    fi
fi
# ─────────────────────────────────────────────────────────────────────────────
# THE SAME CLOSURE RULE, VIA `tg import`.
#
# ⚠️ GUARDING ONE ROUTE TO A STATE IS NOT GUARDING THE STATE. The guard above
# covers `tg update --status closed`, the direct route measured in the initial
# 2026-08-25 deployment. Immediately after that installation,
# `tg import` still closed live tasks by two other routes and reported success:
#
#     {"ops":[{"close":{"id":"T"}}]}                      -> T becomes CLOSED
#     {"ops":[{"update":{"id":"T","status":"closed"}}]}   -> T becomes CLOSED
#
# `tg import` also MERGES onto existing ids -- "Existing tasks (same ID) are
# updated" -- so a `create` op carrying status=closed closes an existing task too.
# An enforcement that covers the documented route and leaves a bulk-write route
# open does not change the measured bypass rate; it just moves it.
#
# WHAT THIS REFUSES, PRECISELY: an op that would take an EXISTING, not-currently-
# closed task to closed/resolved. Bulk CREATION of new tasks, edges, notes and
# every other op is untouched, which matters because import is how task graphs are
# loaded and a blanket refusal would be routed around within the hour.
#
# FAILS OPEN ON ANYTHING IT CANNOT PARSE. A malformed or unreadable payload is
# `tg import`'s problem to report, not ours to guess at.
if [ "${1:-}" = "import" ] && [ -z "${CLOSE_TASK_VERIFIED:-}" ]; then
    _payload=""; _prev=""
    for _a in "$@"; do
        case "$_prev" in
            --from-file)   [ -r "$_a" ] && _payload=$(cat "$_a" 2>/dev/null) ;;
            --from-string) _payload=$_a ;;
        esac
        case "$_a" in
            --from-file=*)   _f=${_a#*=}; [ -r "$_f" ] && _payload=$(cat "$_f" 2>/dev/null) ;;
            --from-string=*) _payload=${_a#*=} ;;
        esac
        _prev=$_a
    done
    if [ -n "$_payload" ] && command -v python3 >/dev/null 2>&1; then
        _hits=$(printf '%s' "$_payload" | python3 -c '
import json,sys
try:
    doc = json.load(sys.stdin)
    ops = doc.get("ops") or []
except Exception:
    sys.exit(0)                      # unparseable: not ours to judge
CLOSED = {"closed", "resolved"}
out = []
for op in ops:
    if not isinstance(op, dict):
        continue
    for kind, body in op.items():
        if not isinstance(body, dict):
            continue
        tid = body.get("id")
        if not tid:
            continue
        if kind == "close" or str(body.get("status", "")).lower() in CLOSED:
            out.append(str(tid))
print("\n".join(out))
' 2>/dev/null)
        if [ -n "$_hits" ]; then
            _live=""
            for _t in $_hits; do
                case "$_t" in *[!A-Za-z0-9_.-]*) continue ;; esac
                _s=$("$REAL" sql "select status from tasks where local_id='$_t'" 2>/dev/null \
                     | sed -n '3p' | tr -d ' ')
                # Only an EXISTING, not-already-closed task is a closure.
                case "$_s" in ""|CLOSED) : ;; *) _live="$_live $_t($_s)" ;; esac
            done
            if [ -n "$_live" ]; then
                printf '%s\n' \
"tg: REFUSED -- this import would CLOSE live task(s), bypassing the closure verifier." \
"" \
"  would close:$_live" \
"" \
"  Measured 2026-08-25: closing via 'tg update --status closed' was already guarded," \
"  and 'tg import' still closed live tasks by two other routes and reported success." \
"  Guarding one route to a state is not guarding the state -- it moves the bypass" \
"  rather than removing it, and the bypass is what the measurement counts." \
"" \
"  Close each task through the verifier, which records WHY it closed:" \
"    /home/newton/work/dev-hermit/ci-hub/bin/close-task <task> \\\\" \
"        --code <PR-or-40-hex> --repo <owner/repo> --source <checkout>" \
"    /home/newton/work/dev-hermit/ci-hub/bin/close-task <task> \\\\" \
"        --disposition 'superseded by hermit#1234'" \
"" \
"  Everything else about 'tg import' is untouched: creating tasks, edges, notes," \
"  reopening, retagging, and any op that does not close a live task." >&2
                exit 2
            fi
        fi
    fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# OWNERSHIP GUARD: taking a task from a live owner must be deliberate.
#
# WHY, MEASURED 2026-08-25. Three task-id collisions between different agents in
# roughly twenty minutes, all one mechanism. `tg claim`'s own help says it: "Re-
# claiming by another agent simply overwrites the previous agent." It warns
# NEITHER party, so the collision is silent on both sides. Confirmed directly on a
# probe task: owner went hermit-020 -> hermit-007 and status OPEN -> IN_PROGRESS
# with no mention of either in the output.
#
# THE SECOND CAUSE IS THE ID. `tg add` PRINTS the id it created and agents were
# CONSTRUCTING one instead -- incrementing a suffix they expected -- so
# non_author_claude_lane_4 got claimed when tg had printed _5. A constructed id
# that happens to exist resolves to SOMEONE ELSE'S TASK, which is the same class
# as a plausible-but-wrong sha sending a reviewer at the wrong tree. Two answers
# here: refuse the overwrite (below), and echo the TITLE on every successful claim
# so a wrong id is visible immediately rather than after the work.
#
# THE DAMAGE IS PROVENANCE, NOT WORK. In all three cases the work was done
# correctly by whoever thought they held the task; what broke is the record. On
# non_author_claude_lane_4 the task said owner=hermit-030 while the PR comment said
# hermit-020, so "who supplied that lane" has two answers and no tiebreak.
#
# ⚠️ THE ORCHESTRATOR SHARES THIS PATH. `tg claim` and `tg update --owner` write
# the SAME `owner` column, so an orchestrator assigning ownership can overwrite a
# live owner exactly as an agent can. Both forms are guarded here for that reason.
#
# DELIBERATE TAKEOVER IS STILL AVAILABLE: pass --steal, which this consumes.
# REFUSES ONLY WHEN THE TASK IS IN_PROGRESS -- a started task is someone's live
# work. An OPEN or BACKLOG task with an owner is reassignable and only warns.
_guard_task_id_ok() { case "$1" in *[!A-Za-z0-9_.-]*|"") return 1 ;; *) return 0 ;; esac; }
_guard_field() {
    _guard_task_id_ok "$2" || return 1
    "$REAL" sql "select $1 from tasks where local_id='$2'" 2>/dev/null \
        | sed -n '3p' | sed 's/[[:space:]]*$//'
}
_guard_me() {
    w=/home/newton/work/dev-hermit/ci-hub/bin/who-am-i
    [ -x "$w" ] || return 0
    "$w" --tag --role impl 2>/dev/null | sed 's/^\[//; s/\].*$//' | cut -d, -f2 | tr -d ' '
}
_guard_refuse_takeover() {  # $1=task $2=current owner $3=incoming owner $4=verb
    printf '%s\n' \
"tg: REFUSED -- $1 is already claimed by a live owner." \
"" \
"  task          : $1" \
"  title         : $(_guard_field title "$1")" \
"  current owner : $2   (status IN_PROGRESS)" \
"  you           : $3" \
"" \
"  Measured 2026-08-25: three agents overwrote each other's live claims in twenty" \
"  minutes because '$4' overwrites unconditionally and tells neither party. The" \
"  work still got done each time -- what broke was the RECORD, which then named an" \
"  agent who had not done it." \
"" \
"  ⚠️ CHECK THE TITLE ABOVE FIRST. Most of these were CONSTRUCTED task ids: 'tg add'" \
"  prints the id it created and the id was retyped with a guessed suffix. If that" \
"  title is not the work you meant to take, you have the wrong id -- use the one" \
"  'tg add' printed." \
"" \
"  If the takeover is deliberate -- the owner stood down, or you are the" \
"  orchestrator reassigning -- say so explicitly:" \
"      tg $4 $1 --steal" \
"  and tell $2, because they may still be working." >&2
}

if [ "${1:-}" = "claim" ] || [ "${1:-}" = "update" ]; then
    _verb=$1; _task=""; _incoming=""; _steal=""; _prev=""; _sawowner=""
    _fwd=(); _n=0
    for _a in "$@"; do
        _n=$((_n+1))
        [ "$_n" = 1 ] && { _fwd+=("$_a"); _prev=$_a; continue; }
        case "$_a" in
            --steal) _steal=1; _prev=$_a; continue ;;   # consumed, never forwarded
        esac
        case "$_prev" in
            --agent|--owner) _incoming=$_a ;;
        esac
        case "$_a" in
            --agent=*|--owner=*) _incoming=${_a#*=}; _sawowner=1 ;;
            --owner|--agent)     _sawowner=1 ;;
            -*)                  : ;;
            *)                   [ -z "$_task" ] && _task=$_a ;;
        esac
        _fwd+=("$_a"); _prev=$_a
    done
    # `tg update --status ...` with no ownership change is not our business here;
    # the closure guard above already covers the one status that matters.
    if [ "$_verb" = "update" ] && [ -z "$_sawowner" ]; then _task=""; fi
    if [ -n "$_task" ] && [ -z "$_steal" ] && _guard_task_id_ok "$_task"; then
        _cur=$(_guard_field owner "$_task")
        _st=$(_guard_field status "$_task")
        [ -n "$_incoming" ] || _incoming=$(_guard_me)
        if [ -n "$_cur" ] && [ "$_cur" != "-" ] && [ -n "$_incoming" ] && [ "$_cur" != "$_incoming" ]; then
            if [ "$_st" = "IN_PROGRESS" ]; then
                _guard_refuse_takeover "$_task" "$_cur" "$_incoming" "$_verb"
                exit 2
            fi
            printf 'tg: NOTE -- %s was owned by %s (status %s); you are taking it as %s.\n' \
                "$_task" "$_cur" "${_st:-?}" "$_incoming" >&2
        fi
    fi
    # Echo the TITLE of what was actually claimed. A constructed id that resolves
    # to the wrong task is silent otherwise, and that silence is half this defect.
    "$REAL" "${_fwd[@]}"; _rc=$?
    if [ "$_rc" = 0 ] && [ "$_verb" = "claim" ] && [ -n "$_task" ]; then
        _t=$(_guard_field title "$_task")
        [ -n "$_t" ] && printf 'tg: claimed %s -- "%s"\n' "$_task" "$_t" >&2
    fi
    exit "$_rc"
fi
exec "$REAL" "$@"
