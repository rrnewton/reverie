#!/usr/bin/env python3
"""Report the calling agent identity without guessing through blind spots."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "ci-hub" / "lib"))

import agent_identity  # noqa: E402
import disclosure_tag  # noqa: E402


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--pid",
        type=int,
        default=os.getppid(),
        help="caller PID to resolve (default: this command's parent)",
    )
    parser.add_argument("--proc-root", type=Path, default=Path("/proc"))
    parser.add_argument("--repo-root", type=Path, default=ROOT)
    parser.add_argument("--state", type=Path, help="worktree-state.json override")
    parser.add_argument("--task", help="active TaskGraph task to cross-check")
    parser.add_argument("--db", type=Path, help="TaskGraph database override")
    output = parser.add_mutually_exclusive_group()
    output.add_argument("--json", action="store_true", help="emit stable schema-2 JSON")
    output.add_argument(
        "--tag",
        action="store_true",
        help="print only the canonical who-is-talking tag, with no trailing newline",
    )
    parser.add_argument(
        "--role",
        choices=sorted(disclosure_tag.ROLES),
        help="artifact role; required with --tag and never defaulted",
    )
    parser.add_argument(
        "--team",
        default=disclosure_tag.DEFAULT_TEAM,
        help=f"team slug for --tag (default: {disclosure_tag.DEFAULT_TEAM})",
    )
    args = parser.parse_args()
    if args.tag and args.role is None:
        parser.error("--role is required with --tag")
    if args.role is not None and not args.tag:
        parser.error("--role is only meaningful with --tag")
    return args


def main() -> int:
    args = parse_args()
    result = agent_identity.resolve_identity(
        args.pid,
        proc_root=args.proc_root,
        repo_root=args.repo_root,
        state_path=args.state,
        task_id=args.task,
        task_db=args.db,
    )
    if args.tag:
        degraded = result.state != "AGREEMENT" or not result.agent
        try:
            disclosure = disclosure_tag.from_resolution(
                result,
                team=args.team,
                role=args.role,
                degraded=degraded,
            )
        except disclosure_tag.DisclosureError as error:
            print(f"who-am-i: REFUSE: {error}", file=sys.stderr)
            return result.exit_code if result.state != "AGREEMENT" else 2
        if degraded:
            print(
                f"who-am-i: DEGRADED: identity resolver returned {result.state}",
                file=sys.stderr,
            )
        sys.stdout.write(disclosure.tag)
        return 0
    elif args.json:
        print(result.to_json())
    else:
        print(f"state={result.state}")
        print(f"agent={result.agent or ''}")
        print(f"model={result.model}")
        print(f"model_source={result.model_source or ''}")
        print(f"primary_source={result.primary_source or ''}")
        print("basis=" + ",".join(result.basis))
        for signal in result.signals:
            candidates = ",".join(signal.candidates)
            print(
                f"signal source={signal.source} state={signal.state} "
                f"agent={signal.agent or ''} candidates={candidates} detail={signal.detail}"
            )
    return result.exit_code


if __name__ == "__main__":
    raise SystemExit(main())
