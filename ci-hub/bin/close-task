#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)

# The `tg` PATH shim refuses `tg update --status closed` unless this is set,
# because a bare close hides landing debt. THIS wrapper is the verifier's own
# entry point, so the exemption is granted here rather than by the guard.
#
# `verified_close.py` also sets it internally (see its `_run`), and that is the
# authoritative copy. It is repeated here because the failure it prevents is a
# VERSION SKEW, not a missing line: the shim is deployed centrally from current
# main, while agents invoke close-task from whatever checkout they are standing
# in. Measured 2026-08-25 on a checkout 287 commits behind main -- the shim
# refused, and because the CLOSURE-VERIFIED note is written BEFORE the status
# update, the task was left OPEN carrying full closure evidence. Three tasks
# reached that state and every retry appended another anchor.
#
# A fix inside verified_close.py cannot reach a stale verified_close.py. This
# wrapper is one line of bash that a stale checkout still executes, and
# `git_env.sanitized_git_env()` strips only GIT_* repository selectors, so the
# variable survives into the `tg` child. Verified end to end against the stale
# copy: refused without it, `CLOSED rc=0` with it.
export CLOSE_TASK_VERIFIED=1

exec python3 "$ROOT/ci-hub/closure/verified_close.py" "$@"
