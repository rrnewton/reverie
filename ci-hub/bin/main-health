#!/usr/bin/env bash
set -euo pipefail
ROOT=$(git -C "$(dirname -- "${BASH_SOURCE[0]}")/../.." rev-parse --show-toplevel)
case ${1:-} in
    help|-h|--help) exec python3 "$ROOT/ci-hub/health/github_main_health.py" "$@" ;;
esac
# Legacy hook callers use the fixed owner wrapper; explicit empty/invalid
# selections survive for the shared strict constructor to refuse before API use.
export FLEET_REAL_GH="${FLEET_REAL_GH-${HOME:?HOME must be set}/bin/gh}"
if [[ -z ${CI_HUB_TOOL_COST_ACTIVE:-} ]]; then
    repo_count=0
    previous=""
    for arg in "$@"; do
        if [[ $previous == --repo ]]; then repo_count=$((repo_count + 1)); fi
        previous=$arg
    done
    if ((repo_count == 0)); then repo_count=3; fi
    exec env CI_HUB_TOOL_COST_ACTIVE=1 "$ROOT/ci-hub/bin/tool-cost" \
        --tool ci-hub/main-health \
        --estimate-unknown \
        --basis "not measured: repo_count=$repo_count; no retained commit/workflow-query cost history" \
        -- "$0" "$@"
fi
exec python3 "$ROOT/ci-hub/health/github_main_health.py" "$@"
