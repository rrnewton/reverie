#!/usr/bin/env bash
# Copyright (c) Meta Platforms, Inc. and affiliates.
# All rights reserved.
#
# This source code is licensed under the BSD-style license found in the
# LICENSE file in the root directory of this source tree.
#
# Write a task note and PROVE it was stored byte-for-byte, or refuse.
#
# WHY THIS EXISTS, AND WHAT IT IS NOT. `tg note` is not the culprit: measured
# 2026-08-25, tg stores exactly what reaches its argv, and a note containing
# backticks, `$(...)`, `$?` and `$HOME` round-trips byte-identical. The loss
# happens ONE LAYER EARLIER, in the caller's shell:
#
#     tg note TASK "the exit code was $?"        # bash substitutes -> "was 0"
#     tg note TASK "run `hermit --verify`"       # bash EXECUTES the backticks
#
# By the time tg runs, the original text no longer exists anywhere, so tg cannot
# detect the loss, cannot refuse it, and correctly reports success for what it
# was actually given. A real instance, in this repository's own record: a note
# written as "indistinguishable from $?" is stored as "indistinguishable from 0",
# which reads as a different and wrong factual claim.
#
# THE TWO RULES THIS ENFORCES.
#   1. Content NEVER appears as literal text in a command line. It comes from a
#      file or stdin, is held in a variable, and is passed as "$var" -- bash does
#      not re-evaluate a variable's VALUE, so backticks inside it stay literal.
#   2. The success message is CONTINGENT ON WHAT WAS STORED. The note is read
#      back out of the database and compared byte-for-byte with the input. If
#      they differ, this refuses and prints the first differing line rather than
#      reporting a success it did not establish.
#
# Usage:
#   tg-note-verified TASK_ID --file PATH
#   tg-note-verified TASK_ID < note.md
set -uo pipefail

# ⚠️ AN EXIT TRAP REPLACES THE EXIT STATUS WITH ITS OWN LAST COMMAND'S.
# A bare `trap 'rm -f ...' EXIT` here made a REFUSAL exit 0, because `rm`
# succeeded -- this tool reporting a success it had not established, which is
# precisely the defect it exists to prevent. Capture the status first and
# re-exit with it.
TMPFILES=""
cleanup() { local rc=$?; rm -f $TMPFILES 2>/dev/null; exit "$rc"; }
trap cleanup EXIT

die() { printf '%s\n' "tg-note-verified: $*" >&2; exit 2; }

usage() {
    cat <<'EOF'
Write a TaskGraph note and verify that the stored bytes match the input.

Usage:
  tg-note-verified TASK_ID --file PATH
  tg-note-verified TASK_ID < note.md

Put note content in a file or on stdin. Never pass the note text as an argument.
EOF
}

case "${1:-}" in
    help|-h|--help)
        usage
        exit 0
        ;;
    "")
        printf '%s\n' \
            "tg-note-verified: missing TASK_ID. Pass the task id first, then --file PATH or note text on stdin." >&2
        usage >&2
        exit 2
        ;;
esac

task=$1; shift

src=""
case "${1:-}" in
    --file) [ $# -ge 2 ] || die "--file needs a path. Pass a readable note file after --file, then retry."; src=$2 ;;
    "")     src="-" ;;
    *)      die "content must come from --file or stdin, never from an argument.
  Passing it as an argument is the defect this tool exists to prevent: the shell
  substitutes backticks, \$(...) and \$? before the note is ever written." ;;
esac

if [ "$src" = "-" ]; then
    input=$(mktemp); TMPFILES="$TMPFILES $input"
    cat > "$input"
else
    [ -r "$src" ] || die "cannot read $src. Create that file or pass a readable path, then retry."
    input=$src
fi

[ -s "$input" ] || die "refusing to write an empty note. Put the note text in the file or on stdin, then retry."

# ─────────────────────────────────────────────────────────────────────────────
# RULE 3: CONTENT FIDELITY IS NOT AUTHORSHIP. The read-back proof below shows the
# STORE matches what this tool SENT. It cannot show that the file it read is the
# file the caller wrote. /tmp is shared by every agent on this box, and the
# staging names are predictable -- /tmp/note.txt, /tmp/claim.txt, /tmp/ask030.txt.
# Measured 2026-08-25 by agent(hermit-006): two agents independently chose
# /tmp/ask030.txt for the same kind of message and one overwrote the other. That
# time the overwrite landed after the post; had it landed a few seconds earlier
# this tool would have stored the OTHER agent's text under the caller's name and
# printed "STORED AND VERIFIED byte-for-byte" -- a real proof of the wrong claim.
#
# A misattributed note is worse than a lost one. A lost note is absent; a
# misattributed one reads as a considered statement by an agent who never made it,
# and if it carries an APPROVED-AT, a landing claim or a stand-down, it is acted on.
#
# Two independent defences, because they fail differently:
#   3a PREVENT the collision -- a staging file in a shared directory must be
#      namespaced to the calling agent, so two agents cannot pick the same path.
#   3b DETECT misattribution -- if the note carries a disclosure tag naming a
#      DIFFERENT agent, refuse regardless of how it got there.
# Neither applies to stdin, which has no file to race and is the preferred form.

# Resolve the repository from THIS SCRIPT'S OWN LOCATION, not the caller's cwd:
# this tool is invoked by absolute path from worktrees all over the box, so a
# cwd-relative lookup would silently find no identity and disable both checks.
# `set -u` is on, so an undefined ROOT would abort rather than degrade -- but a
# MISSING who-am-i must degrade openly instead, which is what the -x test does.
SELF=$(cd "$(dirname "$0")" && pwd)
ROOT=${SELF%/ci-hub/bin}

me=""
if [ -x "$ROOT/ci-hub/bin/who-am-i" ]; then
    me=$("$ROOT/ci-hub/bin/who-am-i" --tag --role impl 2>/dev/null \
         | sed 's/^\[//; s/\].*$//' | cut -d, -f2 | tr -d ' ')
fi
# ⚠️ AN UNRESOLVED IDENTITY DISABLES BOTH CHECKS, AND THAT MUST BE VISIBLE.
# Failing open is right -- this tool's first job is recording notes, and a broken
# identity lookup must not stop the fleet writing to the record. But a guard that
# quietly stops guarding is how the `tg show` tag gate sat inert for weeks, so say
# so on stderr every time rather than letting silence read as a pass.
if [ -z "$me" ]; then
    printf '%s\n' \
"tg-note-verified: WARNING -- could not resolve this agent's identity via" \
"  $ROOT/ci-hub/bin/who-am-i" \
"  The staging-path and attribution checks are DISABLED for this call. The" \
"  byte-for-byte content check below still applies." >&2
fi

# 3a. Shared-directory staging paths must carry the agent id.
#
# ⚠️ THE RULE IS "NOT PREDICTABLE", AND NAMESPACING IS ONLY ONE WAY TO GET THERE.
# What makes a shared path dangerous is that ANOTHER AGENT CAN GUESS OR REUSE IT
# (/tmp/note.txt, /tmp/ask030.txt). Putting the agent id in the name removes that
# because agent ids are unique. A file created by mkstemp/NamedTemporaryFile has
# the same property MORE strongly: the name is random and the file is created
# O_EXCL, so no other writer can have produced or collided with it.
#
# Testing the proxy instead of the property deadlocked the fleet. Measured
# 2026-08-25: close-task stages its closure note through
# tempfile.NamedTemporaryFile(suffix=".note"), which lands at /tmp/tmpXXXXXXXX.note
# -- unpredictable, but with no agent id in it -- so this rule refused it and NO
# TASK COULD BE CLOSED BY ANY AGENT. Both guards were individually right; the bug
# was in how they composed.
#
# TG_NOTE_PRIVATE_TEMP is how a PROGRAM states "I created this file myself, just
# now, with a random name". That is a claim only the creating process can honestly
# make, and it is exactly the property namespacing was standing in for. It does not
# weaken the check: a hand-written /tmp/note.txt still has no such creator and is
# still refused, and the attribution check below applies to every path regardless.
if [ "${TG_NOTE_PRIVATE_TEMP:-}" != "1" ]; then
case "$src" in
    -) : ;;  # stdin: no file exists, so nothing can overwrite it
    /tmp/*|/var/tmp/*|/dev/shm/*)
        base=${src##*/}
        if [ -n "$me" ] && case "$base" in *"$me"*) false ;; *) true ;; esac; then
            printf '%s\n' \
"tg-note-verified: REFUSED -- unnamespaced staging path in a shared directory." \
"" \
"  $src" \
"" \
"  /tmp is shared by every agent on this box. Measured 2026-08-25: two agents both" \
"  chose /tmp/ask030.txt for the same kind of message and one silently overwrote the" \
"  other. If that swap lands between your write and this read, this tool stores" \
"  SOMEONE ELSE'S TEXT UNDER YOUR NAME and truthfully reports it verified -- the" \
"  bytes really do round-trip; they are just not your bytes." \
"" \
"  Put your agent id in the filename, which is already unique:" \
"    ${src%/*}/$me-<purpose>.md" \
"" \
"  Or avoid the file entirely -- there is then nothing to race:" \
"    $0 <task> <<'EOF'" \
"    ...note text, quoted heredoc so nothing is substituted..." \
"    EOF" >&2
            exit 2
        fi
        ;;
esac
fi

# Rule 1: the value travels in a variable. Never re-quoted into a command line.
content=$(cat "$input")

# 3b. A disclosure tag in authorship position must name the caller.
#
# ⚠️ MATCH THE AUTHORSHIP MARKER ONLY, NEVER A MENTION. Notes constantly and
# legitimately name other agents -- "agent(hermit-011) landed this", "From
# agent(hermit-001)". Refusing on any occurrence would fire on ordinary
# coordination and be turned off within the hour. The disclosure tag on the FIRST
# non-empty line is the one place a note states who is speaking, so that is the
# only place this reads.
if [ -n "$me" ]; then
    first=$(grep -m1 -v '^[[:space:]]*$' "$input" || true)
    case "$first" in
        \[*,*\]*)
            claimed=$(printf '%s' "$first" | sed 's/^\[//; s/\].*$//' | cut -d, -f2 | tr -d ' ')
            case "$claimed" in
                *-*)
                    if [ "$claimed" != "$me" ]; then
                        printf '%s\n' \
"tg-note-verified: REFUSED -- this note is attributed to another agent." \
"" \
"  disclosure tag says : $claimed" \
"  you are             : $me" \
"" \
"  Posting it would put ${claimed}'s words in the durable record under your name," \
"  or yours under theirs. Content fidelity and authorship are different properties" \
"  and the byte-for-byte check below only covers the first one." \
"" \
"  If a shared /tmp path was overwritten under you, re-stage to a namespaced path" \
"  and check what you are about to post. If you are deliberately relaying another" \
"  agent's text, quote it in the body rather than leading with their tag." >&2
                        exit 2
                    fi
                    ;;
            esac
            ;;
    esac
fi

# ⚠️ RULE 4: THE STORAGE LAYER INTERPRETS BACKSLASH ESCAPES, SO ENCODE FOR IT.
# The parent CLAUDE.md states that `tg note` stores text byte-identically and
# lists `$(...)`, backticks, `$VAR`, `${BRACE}` and mixed quotes as verified.
# Backslashes are NOT in that list and are NOT preserved. Measured 2026-08-25,
# passing content straight through:
#
#     authored            stored
#     \\        (2 chars) \          (1 char)   -- a doubled backslash collapses
#     \n        (2 chars) <newline>             -- the escape is executed
#     \t        (2 chars) <tab>                 -- likewise
#     \r \x41 \b \d \s \w \.         unchanged  -- only \\, \n, \t are interpreted
#
# Found by agent(hermit-006) writing a note that EXPLAINED a regex double-escaping
# bug; the storage ate the very backslash the explanation was about, and the
# sentence stayed grammatical and stopped being true.
#
# THE ENCODING IS EXACT, NOT A HEURISTIC. Every literal backslash is doubled, so
# each one arrives as `\\` and is un-escaped back to a single `\`; a `\n` in the
# source arrives as `\\n` and is stored as the two characters `\` and `n`. Because
# the interpreted set is exactly {`\\`, `\n`, `\t`} and all three begin with a
# backslash, doubling every backslash makes every sequence literal -- there is no
# sequence this misses. Verified by byte-identical round trip of a probe carrying
# doubled backslashes, `\n`, `\t`, a Windows path and two regexes.
#
# ⚠️ AND THE COMPARISON BELOW IS UNAFFECTED BY THIS ENCODING, DELIBERATELY. It
# compares the READ-BACK against "$input" -- the caller's ORIGINAL bytes on disk --
# not against `$encoded`. If a future tg changed its escape handling, the encoding
# would be wrong and the read-back check would catch it and refuse, rather than
# both sides carrying the same distortion and agreeing. The encoder is an
# optimisation of the success path; the proof of correctness is still the file.
encoded=${content//\\/\\\\}

# TG_NOTE_VERIFIED tells the shared shell guard that this call came through the
# verified path. The guard refuses inline note content everywhere else, because
# a safe call and a shell-mangled one are indistinguishable by then.
out=$(TG_NOTE_VERIFIED=1 command tg note "$task" "$encoded" 2>&1); rc=$?
[ "$rc" -eq 0 ] || die "tg note failed (rc=$rc): $out"

# Rule 2: the confirmation must reflect the STORE, not the call. Read it back.
#
# ⚠️ READ BACK *OUR* NOTE, NOT "WHATEVER WAS WRITTEN LAST".
#
# This was `order by created_at desc limit 1`, which does not name our write --
# it names whoever wrote most recently. Measured 2026-08-25 on
# `a-timeout-has-no-failure-class-...`: our note stored at 23:02:33.694 (row
# 13001) and a CLOSURE-VERIFIED note from close-task stored EIGHTY MILLISECONDS
# later at 23:02:33.774 (row 13002). The readback returned that second note, the
# comparison failed, and this tool withheld confirmation on a note it had stored
# perfectly. The author's only available response -- retry -- wrote a SECOND copy
# (row 13003).
#
# So a check built to protect note integrity became the proximate cause of a
# duplicated note. The fleet writes notes concurrently and close-task writes one
# on every close, so this is ordinary traffic, not bad luck.
#
# Scanning the recent notes for OUR content fixes it without weakening anything:
# a concurrent writer moves our note DOWN A SLOT instead of making it invisible,
# and a note whose content genuinely differs still matches nothing and is still
# refused. That is the true positive this must keep -- it caught a note losing two
# bytes of a regex earlier the same night, 5410 given and 5408 stored.
readback=$(mktemp)
TMPFILES="$TMPFILES $readback $readback.raw $readback.1 $readback.in.norm $readback.rb.norm $readback.newest $readback.newest.norm"

# ⚠️ ACCOUNT FOR THE FRAMING'S TRAILING NEWLINE, AND NOTHING ELSE.
# `tg sql` emits the row followed by a newline, so a note whose content does NOT
# end in one reads back exactly one byte longer. Measured: a 46-byte note with no
# final newline returns 47 bytes, identical otherwise. close-task composes exactly
# such a note, so a naive byte compare REFUSES EVERY CLOSURE -- a false refusal
# that would have broken it again in a new way. Normalise both sides to end in
# exactly one newline; any other difference, including anywhere inside the
# content, still refuses.
normalise() { if [ -s "$1" ] && [ "$(tail -c1 "$1" | od -An -c | tr -d ' \n')" != '\n' ]; then cat "$1"; printf '\n'; else cat "$1"; fi; }
normalise "$input" > "$readback.in.norm"

# Deep enough to absorb concurrent writers, shallow enough to stay one cheap
# indexed query per step. Eight is far beyond the one-slot displacement observed.
SCAN_DEPTH=8
matched_at=-1
rows_seen=0
read_failed=0
j=0
while [ "$j" -lt "$SCAN_DEPTH" ]; do
    if ! tg sql "select content from task_notes where task_id='$task' order by created_at desc limit 1 offset $j" \
         2>/dev/null | sed '1,2d' > "$readback.raw"; then
        read_failed=1
        break
    fi
    # `tg sql` frames rows with a header, a rule, and a trailing "(N rows)" line.
    # Strip the frame without touching content.
    sed -e '${/^([0-9]* rows\?)$/d}' "$readback.raw" > "$readback.1"
    sed -e '${/^$/d}' "$readback.1" > "$readback"
    [ -s "$readback" ] || break
    # Keep the NEWEST row for the diagnostic. Without this the refusal path
    # reports the empty read that TERMINATED the scan -- "newest stored: 0 bytes"
    # -- which is a wrong number in the one message whose job is to be exact.
    [ "$j" -eq 0 ] && cp "$readback" "$readback.newest"
    rows_seen=$((rows_seen + 1))
    normalise "$readback" > "$readback.rb.norm"
    if diff -q "$readback.in.norm" "$readback.rb.norm" >/dev/null 2>&1; then
        matched_at=$j
        break
    fi
    j=$((j + 1))
done

bytes=$(wc -c < "$input" | tr -d ' ')
lines=$(wc -l < "$input" | tr -d ' ')

if [ "$matched_at" -ge 0 ]; then
    printf 'tg-note-verified: STORED AND VERIFIED byte-for-byte (%s bytes, %s lines) on %s\n' \
        "$bytes" "$lines" "$task"
    # Say when a concurrent write displaced us. Silence here would hide the very
    # traffic that used to break this check.
    if [ "$matched_at" -gt 0 ]; then
        printf '  (found %s note(s) newer than ours -- concurrent writers, not a problem)\n' \
            "$matched_at" >&2
    fi
    exit 0
fi

# ⚠️ TWO DIFFERENT ANSWERS, AND CONFLATING THEM IS WHAT CAUSED THE DUPLICATE.
#
#   STORED AND DIFFERENT      -- we read the notes and ours is not among them.
#                                Something changed the content. WITHHOLD.
#   STORED, UNCONFIRMABLE     -- we could not read the notes back at all.
#                                The write itself reported success. SAY SO.
#
# The second is not a failure of the note, it is a failure of the CHECK, and
# reporting it as "do not treat this as evidence" leaves the author with no
# answer -- at which point retrying is the only move, and the retry duplicates.
if [ "$read_failed" -eq 1 ] || [ "$rows_seen" -eq 0 ]; then
    printf 'tg-note-verified: STORED, CONFIRMATION UNAVAILABLE on %s (%s bytes, %s lines)\n' \
        "$task" "$bytes" "$lines"
    printf '  `tg note` returned success, so THE WRITE HAPPENED. The read-back could not\n' >&2
    printf '  be performed (%s), so this tool cannot compare what was stored.\n' \
        "$([ "$read_failed" -eq 1 ] && echo 'the query failed' || echo 'it returned no rows')" >&2
    printf '  ⚠️ DO NOT RETRY. A retry writes a SECOND copy; it does not confirm the first.\n' >&2
    printf '  Verify by reading the task, or re-run the read-back alone.\n' >&2
    exit 0
fi

printf 'tg-note-verified: REFUSING TO CONFIRM -- what was stored is NOT what was given.\n' >&2
printf '  task: %s\n' "$task" >&2
printf '  input   : %s bytes\n' "$bytes" >&2
printf '  scanned : %s most recent note(s); none matched\n' "$rows_seen" >&2
printf '  newest stored: %s bytes\n' "$(wc -c < "$readback.newest" | tr -d ' ')" >&2
printf '  first difference against the newest:\n' >&2
normalise "$readback.newest" > "$readback.newest.norm"
diff "$readback.in.norm" "$readback.newest.norm" 2>&1 | head -6 | sed 's/^/    /' >&2
printf '  The note IS in the database; it is the CONFIRMATION that is withheld.\n' >&2
printf '  ⚠️ DO NOT RETRY -- a retry adds a second copy and does not resolve the difference.\n' >&2
printf '  Do not treat this note as evidence until the difference is explained.\n' >&2
exit 1
