#!/usr/bin/env python3
"""The lander must CALL the marker grammar, not carry a second copy of it.

WHY THIS EXISTS. `ci-hub/health/approval_binding.py` and this lander both had to
decide what a marker line says, and each had its own parser. Two parsers for one
grammar is the defect sweep check 14 names, and these two HAD already drifted:
the authority anchored at column 0 and failed open on a heading-formatted
refusal, while the lander stripped decoration and did not. The lander being the
stricter of the two was luck, not design -- and the next drift is not guaranteed
to fall the safe way.

WHAT IS AND IS NOT SHARED. The GRAMMAR is shared: what a marker line says. The
POLICY is not, and should not be. A landing guard and a review board legitimately
differ, and the lander is deliberately the stricter:

    lane-agnostic          a refusal in ANY lane stops the merge; the authority
                           is per-lane because a board must report per-lane
    withdrawal             CHANGES-REQUESTED-WITHDRAWN-AT clears a block here
    native review state    GitHub's own CHANGES_REQUESTED blocks here
    over-block             a refusal-shaped line the grammar cannot parse blocks

Those four are why "just call approval_binding and delete the rest" is the wrong
refactor: every one of them would be lost, and every loss is in the merge-more
direction. This bracket pins both halves -- one grammar, and the policy intact.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import pathlib
import re
import sys

HERE = pathlib.Path(__file__).resolve().parent
LANDER = HERE / "gh-merge-verified"
SHA = "b3ca4e155098ad6e6f32f507ed72855da0638010"
OTHER = "a" * 40


def by(agent: str, *lines: str) -> str:
    """A comment body carrying a disclosure tag, so the markers have an AUTHOR.

    ⚠️ THE FIXTURES USED TO BE UNSIGNED, AND THAT STOPPED BEING EXPRESSIVE ENOUGH.
    Clearing is now scoped to a refusal's own ISSUER as well as its own lane, so a
    cell that says "a withdrawal clears" has to be able to say WHOSE. An unsigned
    body cannot, and under the fail-closed rule it clears nothing -- which made
    two escape-hatch cells read as regressions when they are the rule working.
    The PROPERTY those cells pin is unchanged and still pinned below; only the
    fixture learned to name a speaker, which every real fleet comment already
    does. The unsigned behaviour is not dropped -- it is pinned explicitly, in
    its own cells, instead of being implied by silence.
    """
    tag = f"[hermit2, {agent}, unresolved, devbig014, role=reviewer]"
    return tag + "\n\n" + "\n".join(lines)


def load(path: pathlib.Path, name: str):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    try:
        spec.loader.exec_module(module)
    except SystemExit:
        pass
    return module


def probe_comments(module, bodies: list[str]) -> bool:
    """Like `probe`, but the bodies are SEPARATE COMMENTS.

    ⚠️ CONCATENATING TWO SIGNED BODIES INTO ONE STRING DOES NOT MAKE TWO
    SPEAKERS, and trying it is what produced this function. `comment_author`
    reads the FIRST disclosure tag in a body, so "hermit-007 refuses" glued to
    "hermit-005 withdraws" is one comment that GitHub would never produce and
    that the grammar correctly attributes entirely to hermit-007 -- the cell then
    passes or fails for a reason unrelated to the property it names. Two authors
    means two comments, which is also the only shape the real API returns.
    """
    module.run = lambda argv, **kw: (
        0,
        json.dumps({"comments": [{"body": b} for b in bodies], "reviews": []}),
        "",
    )
    return len(module.blocking_changes_requests("1", "o/r", SHA)) > 0


def probe(module, body: str) -> bool:
    module.run = lambda argv, **kw: (
        0,
        json.dumps({"comments": [{"body": body}], "reviews": []}),
        "",
    )
    return len(module.blocking_changes_requests("1", "o/r", SHA)) > 0


CASES = [
    ("plain refusal blocks", f"CHANGES-REQUESTED-AT: claude {SHA}", True),
    ("heading refusal blocks", f"## CHANGES-REQUESTED-AT: claude {SHA}", True),
    ("blockquote refusal blocks", f"> CHANGES-REQUESTED-AT: claude {SHA}", True),
    ("bold refusal blocks", f"**CHANGES-REQUESTED-AT: claude {SHA}**", True),
    ("list refusal blocks", f"- CHANGES-REQUESTED-AT: claude {SHA}", True),
    # POLICY, lane-agnostic: the authority would report this as codex-only.
    ("codex refusal blocks too", f"CHANGES-REQUESTED-AT: codex {SHA}", True),
    # POLICY, over-block: unparseable but refusal-shaped, naming this head.
    ("unparseable refusal shape blocks", f"CHANGES REQUESTED for {SHA} -- see below", True),
    ("withdrawal clears",
     by("hermit-007",
        f"CHANGES-REQUESTED-AT: claude {SHA}",
        f"CHANGES-REQUESTED-WITHDRAWN-AT: claude {SHA}"), False),
    # ⚠️ A WITHDRAWAL CLEARS ITS OWN LANE ONLY. Blocking is lane-agnostic on
    # purpose (see "codex refusal blocks too" above) because that direction fails
    # CLOSED. Clearing must not be, or one family discharges another's refusal --
    # reproduced live on hermit#2613, where a claude withdrawal cleared an
    # unwithdrawn codex refusal and both landers called the head ready. Each cell
    # below returns the wrong answer against the pre-fix lander.
    ("other lane's withdrawal does NOT clear",
     f"CHANGES-REQUESTED-AT: claude {SHA}\nCHANGES-REQUESTED-WITHDRAWN-AT: codex {SHA}", True),
    ("two lanes refuse, one withdraws, other still blocks",
     f"CHANGES-REQUESTED-AT: claude {SHA}\nCHANGES-REQUESTED-AT: codex {SHA}\n"
     f"CHANGES-REQUESTED-WITHDRAWN-AT: claude {SHA}", True),
    ("two lanes refuse, both withdraw, clears",
     by("hermit-007",
        f"CHANGES-REQUESTED-AT: claude {SHA}",
        f"CHANGES-REQUESTED-AT: codex {SHA}",
        f"CHANGES-REQUESTED-WITHDRAWN-AT: claude {SHA}",
        f"CHANGES-REQUESTED-WITHDRAWN-AT: codex {SHA}"), False),
    # ⚠️ A WITHDRAWAL CLEARS ITS OWN ISSUER'S REFUSAL ONLY, one scope narrower
    # than the lane rule above and for the identical reason. A LANE IS STAFFED BY
    # SEVERAL AGENTS, so lane-only clearing let agent B discharge agent A's block
    # inside one lane. Measured 2026-08-26 by driving `blocking_changes_requests`
    # directly: a hermit-007 refusal plus a hermit-005 withdrawal returned
    # blocking=0. Same fail-open direction as hermit#2613's cross-lane clear.
    # Each cell below returns the wrong answer against the pre-fix lander.
    ("another issuer's withdrawal does NOT clear",
     [by("hermit-007", f"CHANGES-REQUESTED-AT: claude {SHA}"),
      by("hermit-005", f"CHANGES-REQUESTED-WITHDRAWN-AT: claude {SHA}")], True),
    ("the issuer's own withdrawal still clears, across comments",
     [by("hermit-007", f"CHANGES-REQUESTED-AT: claude {SHA}"),
      by("hermit-007", f"CHANGES-REQUESTED-WITHDRAWN-AT: claude {SHA}")], False),
    ("a later approval by another issuer does NOT clear",
     [by("hermit-007", f"CHANGES-REQUESTED-AT: claude {SHA}"),
      by("hermit-005", f"APPROVED-AT: claude {SHA}")], True),
    # FAIL CLOSED AT BOTH ENDS. An unsigned withdrawal cannot say whose refusal it
    # discharges; an unsigned refusal cannot be proven to belong to anyone, so no
    # withdrawal can claim it. Both still clear the ordinary way -- push, and the
    # sha stops naming the head. This is the file's declared trade: a false
    # positive costs one push, a false negative merges over a block.
    ("unsigned withdrawal clears nothing",
     [by("hermit-007", f"CHANGES-REQUESTED-AT: claude {SHA}"),
      f"CHANGES-REQUESTED-WITHDRAWN-AT: claude {SHA}"], True),
    ("unsigned refusal is not cleared by a signed withdrawal",
     [f"CHANGES-REQUESTED-AT: claude {SHA}",
      by("hermit-007", f"CHANGES-REQUESTED-WITHDRAWN-AT: claude {SHA}")], True),
    # A withdrawal naming no lane cannot say whose refusal it discharges, so it
    # clears nothing -- otherwise the unilateral clear returns via the bare form.
    ("unlaned withdrawal clears nothing",
     f"CHANGES-REQUESTED-AT: claude {SHA}\nCHANGES-REQUESTED-WITHDRAWN-AT {SHA}", True),
    ("approval alone passes", f"APPROVED-AT: claude {SHA}", False),
    ("refusal at another sha passes", f"CHANGES-REQUESTED-AT: claude {OTHER}", False),
]


STALE_HEAD = "1f4982f7ab40" + "0" * 28
STALE_OLD = "94d9a86545d7" + "0" * 28


def probe_labels(module, labels, comments) -> bool:
    """True when the lander REFUSES on a stale passed-review label."""
    module.run = lambda argv, **kw: (
        0,
        json.dumps({
            "labels": [{"name": n} for n in labels],
            "comments": [{"body": b} for b in comments],
            "reviews": [],
        }),
        "",
    )
    return len(module.stale_review_labels("1", "o/r", STALE_HEAD)) > 0


# A label outlives the sha it was earned at. https://github.com/rrnewton/hermit/pull/2601
# merged with authoritative=0 because the pre-rebase passed-review-codex label
# admitted it. The last case is the scope guard: no label, no new requirement.
LABEL_CASES = [
    ("stale label refuses (the #2601 shape)",
     ["passed-review-codex"], [f"APPROVED-AT: codex {STALE_OLD}"], True),
    ("re-bound label admits",
     ["passed-review-codex"],
     [f"APPROVED-AT: codex {STALE_OLD}", f"APPROVED-AT: codex {STALE_HEAD}"], False),
    ("label with no binding at all refuses",
     ["passed-review-codex"], ["looks good"], True),
    ("missing lane token does not rescue a stale label",
     ["passed-review-codex"],
     [f"APPROVED-AT: codex {STALE_OLD}", f"APPROVED-AT {STALE_HEAD}"], True),
    ("no passed-review label imposes no requirement",
     [], [f"APPROVED-AT: codex {STALE_OLD}"], False),
]


def main() -> int:
    failures = []
    lander = load(LANDER, "lander_under_test")

    for name, body, want_block in CASES:
        # A list is several comments by several agents; a string is one comment.
        got = (probe_comments(lander, body) if isinstance(body, list)
               else probe(lander, body))
        ok = got == want_block
        print(f"  {'PASS' if ok else 'FAIL'}  {name}: blocks={got} want={want_block}")
        if not ok:
            failures.append(name)

    # STRUCTURAL: the grammar must come from the authority, not from here.
    source = LANDER.read_text()
    if "parse_marker" not in source:
        failures.append("lander no longer calls the shared parse_marker")
        print("  FAIL  lander does not call parse_marker")
    else:
        print("  PASS  lander calls the shared parse_marker")

    private = re.findall(r"CHANGES-REQUESTED-AT[\"']\s*\)", source)
    if private:
        failures.append("lander reintroduced a private marker parser")
        print(f"  FAIL  lander appears to parse markers privately: {private[:2]}")
    else:
        print("  PASS  lander carries no private marker parser")

    # And the authority really is the thing being called.
    authority = load(HERE.parent / "health" / "approval_binding.py", "authority_under_test")
    if authority.parse_marker(f"## CHANGES-REQUESTED-AT: claude {SHA}") is None:
        failures.append("authority cannot parse a decorated refusal")
        print("  FAIL  authority cannot parse a decorated refusal")
    else:
        print("  PASS  authority parses a decorated refusal")

    for name, labels, comments, want_refuse in LABEL_CASES:
        got = probe_labels(lander, labels, comments)
        ok = got == want_refuse
        print(f"  {'PASS' if ok else 'FAIL'}  {name}: refuses={got} want={want_refuse}")
        if not ok:
            failures.append(name)

    total = len(CASES) + len(LABEL_CASES) + 3
    print(f"\nassertions: {total - len(failures)} passed, {len(failures)} failed")
    if failures:
        print("RESULT: FAIL")
        return 1
    print("RESULT: PASS")
    return 0


if __name__ == "__main__":
    sys.exit(main())
