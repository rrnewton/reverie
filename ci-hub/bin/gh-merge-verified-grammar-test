STALE_HEAD = "1f4982f7ab40" + "0" * 28
STALE_OLD = "94d9a86545d7" + "0" * 28


def probe_review_set(module, labels, comments) -> bool:
    """True when canonical comments do not satisfy the required review set."""
    issue = [_comment_record(item, i) for i, item in enumerate(comments, 1)]
    _install_review_responses(module, issue=issue, labels=labels)
    return len(module.review_admission_problems("1", "o/r", STALE_HEAD)) > 0


# Canonical comments are authority; passed-review labels are cache state and
# cannot alter the required set in either direction.
REVIEW_SET_CASES = [
    ("stale cached approval has no current authority (the #2601 shape)",
     ["passed-review-codex"], [f"APPROVED-AT: codex {STALE_OLD}"], True),
    ("current canonical approval satisfies the one-lane set",
     [], [f"APPROVED-AT: codex {STALE_HEAD}"], False),
    ("stale unrelated cache label cannot block current canonical approval",
     ["passed-review-claude"], [f"APPROVED-AT: codex {STALE_HEAD}"], False),
    ("current canonical approval admits despite an older cached binding",
     ["passed-review-codex"],
     [f"APPROVED-AT: codex {STALE_OLD}", f"APPROVED-AT: codex {STALE_HEAD}"], False),
    ("cache label with no binding at all refuses",
     ["passed-review-codex"], ["looks good"], True),
    ("missing lane token does not satisfy the review set",
     ["passed-review-codex"],
     [f"APPROVED-AT: codex {STALE_OLD}", f"APPROVED-AT {STALE_HEAD}"], True),
    ("no cache label cannot make stale review evidence current",
     [], [f"APPROVED-AT: codex {STALE_OLD}"], True),
    (
        "critical review set refuses when the claude lane is missing",
        [],
        [
            f"APPROVED-AT: codex {STALE_HEAD}",
            "REVIEW-DISPATCH-ATTESTATION\n"
            "critical-class: hermit-syscall\n"
            f"head: {STALE_HEAD}",
        ],
        True,
    ),
    (
        "critical review set passes with both canonical lanes",
        [],
        [
            f"APPROVED-AT: codex {STALE_HEAD}",
            f"APPROVED-AT: claude {STALE_HEAD}",
            "REVIEW-DISPATCH-ATTESTATION\n"
            "critical-class: hermit-syscall\n"
            f"head: {STALE_HEAD}",
        ],
        False,
    ),
    (
        "old-head critical attestation cannot become ordinary on a new head",
        [],
        [
            f"APPROVED-AT: codex {STALE_HEAD}",
            "REVIEW-DISPATCH-ATTESTATION\n"
            "critical-class: hermit-syscall\n"
            f"head: {STALE_OLD}",
        ],
        True,
    ),
    (
        "current-head exact retirement preserves the repaired head's approval",
        ["passed-review-claude"],
        [
            {"id": 900003, "body": by("hermit-005", f"APPROVED-AT: claude {STALE_HEAD}")},
            {
                "id": "IC_opaque_refusal",
                "url": "https://github.com/o/r/pull/1#issuecomment-900001",
                "body": by(
                    "hermit-007", f"CHANGES-REQUESTED-AT: claude {STALE_OLD}"
                ),
            },
            {
                "id": "IC_opaque_withdrawal",
                "url": "https://github.com/o/r/pull/1#issuecomment-900002",
                "body": by(
                    "hermit-005",
                    f"CHANGES-REQUESTED-WITHDRAWN-AT: claude {STALE_HEAD}",
                    "RETIRES 900001",
                ),
            },
        ],
        False,
    ),
    (
        "stale-head retirement does not preserve the repaired head's approval",
        ["passed-review-claude"],
        [
            {"id": 900003, "body": by("hermit-005", f"APPROVED-AT: claude {STALE_HEAD}")},
            {
                "id": "IC_opaque_refusal",
                "url": "https://github.com/o/r/pull/1#issuecomment-900001",
                "body": by(
                    "hermit-007", f"CHANGES-REQUESTED-AT: claude {STALE_OLD}"
                ),
            },
            {
                "id": "IC_opaque_withdrawal",
                "url": "https://github.com/o/r/pull/1#issuecomment-900002",
                "body": by(
                    "hermit-005",
                    f"CHANGES-REQUESTED-WITHDRAWN-AT: claude {STALE_OLD}",
                    "RETIRES 900001",
                ),
            },
        ],
        True,
    ),
]

NATIVE_RETIREMENT_CASES = [
    (
        "old-head native refusal plus current-head exact retirement clears",
        SHA,
        False,
    ),
    (
        "old-head native refusal plus stale-head retirement still blocks",
        OTHER,
        True,
    ),
    (
        "markerless native refusal plus current-head exact retirement clears",
        SHA,
        False,
        900001,
        False,
    ),
    (
        "markerless native refusal plus stale-head retirement still blocks",
        OTHER,
        True,
        900001,
        False,
    ),
    (
        "markerless native refusal plus wrong-id retirement still blocks",
        SHA,
        True,
        900099,
        False,
    ),
]

NATIVE_VERSION_CASES = [
    (
        "a native refusal edited after retirement remains live",
        {
            "withdrawal_head": SHA,
            "refusal_updated_at": "2026-09-04T00:00:03Z",
            "withdrawal_created_at": "2026-09-04T00:00:02Z",
        },
        True,
    ),
    (
        "a native retirement posted before the refusal remains blocked",
        {
            "withdrawal_head": SHA,
            "refusal_updated_at": "2026-09-04T00:00:02Z",
            "withdrawal_created_at": "2026-09-04T00:00:01Z",
        },
        True,
    ),
    (
        "a submittedAt-only native refusal is unreadable rather than retired",
        {"withdrawal_head": SHA, "include_updated_at": False},
        True,
    ),
]

INLINE_COMMENT_CASES = [
    (
        "inline review-comment refusal is visible",
        [
            {
                "id": 900001,
                "body": by("hermit-007", f"CHANGES-REQUESTED-AT: claude {SHA}"),
            }
        ],
        True,
    ),
    (
        "inline review-comment refusal has the same exact retirement path",
        [
            {
                "id": 900001,
                "body": by("hermit-007", f"CHANGES-REQUESTED-AT: claude {SHA}"),
            },
            {
                "id": 900002,
                "body": by(
                    "hermit-005",
                    f"CHANGES-REQUESTED-WITHDRAWN-AT: claude {SHA}",
                    "RETIRES 900001",
                ),
            },
        ],
        False,
    ),
]


def main() -> int:
    failures = []
    lander = load(LANDER, "lander_under_test")

    for name, body, want_block in CASES:
        # A list is several comments by several agents; a string is one comment.
        got = (probe_comments(lander, body) if isinstance(body, list)
               else probe(lander, body))
        ok = got == want_block
        print(f"  {'PASS' if ok else 'FAIL'}  {name}: blocks={got} want={want_block}")
        if not ok:
            failures.append(name)

    authority_pair = [
        {
            "id": 920001,
            "user": {"login": "hermit-007"},
            "body": by("hermit-007", f"CHANGES-REQUESTED-AT: claude {OTHER}"),
        },
        {
            "id": 920002,
            "user": {"login": "rrnewton"},
            "body": by(
                "review-521-codex",
                f"CHANGES-REQUESTED-WITHDRAWN-AT: claude {SHA}",
                "RETIRES 920001",
            ),
        },
    ]
    for name, comments, permissions, want_block in (
        (
            "an agent using the authorized shared GitHub account can retire the exact objection",
            authority_pair,
            {"hermit-007": "write", "rrnewton": "write"},
            False,
        ),
        (
            "a read-only GitHub actor cannot retire the exact objection",
            authority_pair,
            {"hermit-007": "write", "rrnewton": "read"},
            True,
        ),
        (
            "missing current permission cannot retire the exact objection",
            authority_pair,
            {"hermit-007": "write", "rrnewton": None},
            True,
        ),
    ):
        got = probe_comments(lander, comments, permissions=permissions)
        ok = got == want_block
        print(f"  {'PASS' if ok else 'FAIL'}  {name}: blocks={got} want={want_block}")
        if not ok:
            failures.append(name)

    # STRUCTURAL: the grammar must come from the authority, not from here.
    source = LANDER.read_text()
    if "unresolved_review_objections" not in source:
        failures.append("lander no longer calls the shared review authority")
        print("  FAIL  lander does not call unresolved_review_objections")
    else:
        print("  PASS  lander calls the shared review authority")

    private = re.findall(r"CHANGES-REQUESTED-AT[\"']\s*\)", source)
    if private:
        failures.append("lander reintroduced a private marker parser")
        print(f"  FAIL  lander appears to parse markers privately: {private[:2]}")
    else:
        print("  PASS  lander carries no private marker parser")

    # And the authority really is the thing being called.
    authority = load(HERE.parent / "health" / "approval_binding.py", "authority_under_test")
    if authority.parse_marker(f"## CHANGES-REQUESTED-AT: claude {SHA}") is None:
        failures.append("authority cannot parse a decorated refusal")
        print("  FAIL  authority cannot parse a decorated refusal")
    else:
        print("  PASS  authority parses a decorated refusal")

    parsed_mixed = []
    for line in authority.marker_lines(MIXED_MENTION_AND_ASSERTION):
        if not authority.marker_assertion(line):
            continue
        parsed = authority.parse_marker(line)
        if parsed is not None:
            parsed_mixed.append(parsed)
    expected_mixed = [(authority.MARKER_REFUSED, "claude", SHA)]
    if parsed_mixed != expected_mixed:
        failures.append("mixed mention and assertion did not identify only the assertion")
        print(f"  FAIL  mixed body parsed {parsed_mixed!r}, want {expected_mixed!r}")
    else:
        print("  PASS  mixed body identifies only the later assertion")

    for name, labels, comments, want_refuse in REVIEW_SET_CASES:
        got = probe_review_set(lander, labels, comments)
        ok = got == want_refuse
        print(f"  {'PASS' if ok else 'FAIL'}  {name}: refuses={got} want={want_refuse}")
        if not ok:
            failures.append(name)

    for case in NATIVE_RETIREMENT_CASES:
        name, withdrawal_head, want_block, *rest = case
        target, marker = rest if rest else (900001, True)
        got = probe_native_retirement(
            lander, withdrawal_head, target=target, marker=marker
        )
        ok = got == want_block
        print(f"  {'PASS' if ok else 'FAIL'}  {name}: blocks={got} want={want_block}")
        if not ok:
            failures.append(name)

    for name, kwargs, want_block in NATIVE_VERSION_CASES:
        got = probe_native_retirement(lander, **kwargs)
        ok = got == want_block
        print(f"  {'PASS' if ok else 'FAIL'}  {name}: blocks={got} want={want_block}")
        if not ok:
            failures.append(name)

    for name, comments, want_block in INLINE_COMMENT_CASES:
        got = probe_inline_comments(lander, comments)
        ok = got == want_block
        print(f"  {'PASS' if ok else 'FAIL'}  {name}: blocks={got} want={want_block}")
        if not ok:
            failures.append(name)

    total = (
        len(CASES)
        + len(REVIEW_SET_CASES)
        + len(NATIVE_RETIREMENT_CASES)
        + len(NATIVE_VERSION_CASES)
        + len(INLINE_COMMENT_CASES)
        + 8
    )
    print(f"\nassertions: {total - len(failures)} passed, {len(failures)} failed")
    if failures:
        print("RESULT: FAIL")
        return 1
    print("RESULT: PASS")
    return 0


if __name__ == "__main__":
    sys.exit(main())
