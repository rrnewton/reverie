#!/usr/bin/env python3
"""The lander must CALL the marker grammar, not carry a second copy of it.

WHY THIS EXISTS. `ci-hub/health/approval_binding.py` and this lander both had to
decide what a marker line says, and each had its own parser. Two parsers for one
grammar is the defect sweep check 14 names, and these two HAD already drifted:
the authority anchored at column 0 and failed open on a heading-formatted
refusal, while the lander stripped decoration and did not. The lander being the
stricter of the two was luck, not design -- and the next drift is not guaranteed
to fall the safe way.

WHAT IS SHARED. The grammar and the unresolved-objection decision are both
shared. A refusal from any lane or supported GitHub review surface stops the
merge; only the shared authority may decide that an exact objection was later
resolved. This bracket pins the lander to that one implementation so a future
fix cannot leave reporting and the final merge boundary with opposite answers.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import pathlib
import re
import sys

HERE = pathlib.Path(__file__).resolve().parent
LANDER = HERE / "gh-merge-verified"
SHA = "b3ca4e155098ad6e6f32f507ed72855da0638010"
OTHER = "a" * 40
MENTION_SHA = "c" * 40
MIXED_MENTION_AND_ASSERTION = (
    "The migration note reproduces the retired review text exactly: "
    f"CHANGES-REQUESTED-AT: codex {MENTION_SHA}\n"
    f"CHANGES-REQUESTED-AT: claude {SHA}"
)


def by(agent: str, *lines: str) -> str:
    """A comment body carrying optional fleet-name and role metadata."""
    tag = f"[hermit2, {agent}, unresolved, devbig014, role=reviewer]"
    return tag + "\n\n" + "\n".join(lines)


def load(path: pathlib.Path, name: str):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    try:
        spec.loader.exec_module(module)
    except SystemExit:
        pass
    return module


def _time(second: int) -> str:
    return f"2026-09-04T00:00:{second:02d}Z"


def _comment_record(item: str | dict, position: int) -> dict:
    record = dict(item) if isinstance(item, dict) else {"body": item}
    record.setdefault("id", 900000 + position)
    disclosure = re.search(r"\[hermit2,\s*([^,\]]+)", str(record.get("body") or ""))
    record.setdefault(
        "user",
        {"login": disclosure.group(1) if disclosure else "fixture-reviewer"},
    )
    record.setdefault("created_at", _time(position))
    record.setdefault("updated_at", record["created_at"])
    return record


def _native_record(item: dict, position: int) -> dict:
    record = dict(item)
    database_id = record.pop("database_id", 910000 + position)
    record.setdefault("fullDatabaseId", database_id)
    record.setdefault("id", f"PRR_fixture_{database_id}")
    record.setdefault("author", {"login": "fixture-reviewer"})
    record.setdefault(
        "url", f"https://github.com/o/r/pull/1#pullrequestreview-{database_id}"
    )
    record.setdefault("submittedAt", _time(position))
    record.setdefault("updatedAt", record["submittedAt"])
    record.setdefault("lastEditedAt", None)
    record.setdefault("includesCreatedEdit", False)
    record.setdefault("commit", {"oid": SHA})
    return record


def _install_review_responses(
    module,
    *,
    issue: list[dict] | None = None,
    native: list[dict] | None = None,
    inline: list[dict] | None = None,
    labels: list[str] | None = None,
    permission: str | None = "write",
    permissions: dict[str, str | None] | None = None,
) -> None:
    """Install production-shaped REST and GraphQL review responses."""
    issue = issue or []
    native = native or []
    inline = inline or []

    def fake_run(argv, **_kwargs):
        joined = " ".join(argv)
        if " api " in f" {joined} " and "graphql" in argv:
            return (
                0,
                json.dumps(
                    [
                        {
                            "data": {
                                "repository": {
                                    "pullRequest": {
                                        "reviews": {
                                            "nodes": native,
                                            "pageInfo": {
                                                "hasNextPage": False,
                                                "endCursor": None,
                                            },
                                        }
                                    }
                                }
                            }
                        }
                    ]
                ),
                "",
            )
        if "/issues/" in joined and "/comments" in joined:
            return 0, json.dumps([issue]), ""
        if "/pulls/" in joined and "/comments" in joined:
            return 0, json.dumps([inline]), ""
        if "/collaborators/" in joined and "/permission" in joined:
            actor = joined.split("/collaborators/", 1)[1].split("/permission", 1)[0]
            actor_permission = (permissions or {}).get(actor, permission)
            return (
                0,
                json.dumps(
                    {"permission": actor_permission, "user": {"login": actor}}
                ),
                "",
            )
        if " pr view " in f" {joined} ":
            return (
                0,
                json.dumps({"labels": [{"name": name} for name in labels or []]}),
                "",
            )
        raise AssertionError(f"unexpected gh call: {argv!r}")

    module.run = fake_run


def probe_comments(
    module,
    bodies: list[str | dict],
    *,
    permission: str | None = "write",
    permissions: dict[str, str | None] | None = None,
) -> bool:
    """Like `probe`, but the bodies are SEPARATE COMMENTS.

    ⚠️ CONCATENATING TWO SIGNED BODIES INTO ONE STRING DOES NOT MAKE TWO
    SPEAKERS, and trying it is what produced this function. `comment_author`
    reads the FIRST disclosure tag in a body, so "hermit-007 refuses" glued to
    "hermit-005 withdraws" is one comment that GitHub would never produce and
    that the grammar correctly attributes entirely to hermit-007 -- the cell then
    passes or fails for a reason unrelated to the property it names. Two authors
    means two comments, which is also the only shape the real API returns.
    """
    comments = [_comment_record(item, i) for i, item in enumerate(bodies, 1)]
    _install_review_responses(
        module,
        issue=comments,
        permission=permission,
        permissions=permissions,
    )
    return len(module.blocking_changes_requests("1", "o/r", SHA)) > 0


def probe(module, body: str) -> bool:
    return probe_comments(module, [body])


def probe_native_retirement(
    module,
    withdrawal_head: str,
    *,
    target: int = 900001,
    marker: bool = True,
    refusal_updated_at: str = "2026-09-04T00:00:01Z",
    withdrawal_created_at: str = "2026-09-04T00:00:02Z",
    include_updated_at: bool = True,
) -> bool:
    """True when an old native refusal still blocks the current repaired head."""
    withdrawal = _comment_record(
        {
            "id": 900002,
            "body": by(
                "hermit-005",
                "CHANGES-REQUESTED-WITHDRAWN-AT: " f"claude {withdrawal_head}",
                f"RETIRES {target}",
            ),
            "created_at": withdrawal_created_at,
            "updated_at": withdrawal_created_at,
        },
        2,
    )
    native = _native_record(
        {
            "database_id": 900001,
            "state": "CHANGES_REQUESTED",
            "body": (
                by("hermit-007", f"CHANGES-REQUESTED-AT: claude {OTHER}")
                if marker
                else "Please fix the unchecked failure."
            ),
            "submittedAt": "2026-09-04T00:00:01Z",
            "updatedAt": refusal_updated_at,
        },
        1,
    )
    if not include_updated_at:
        native.pop("updatedAt", None)
    _install_review_responses(module, issue=[withdrawal], native=[native])
    return len(module.blocking_changes_requests("1", "o/r", SHA)) > 0


def probe_inline_comments(module, comments: list[dict]) -> bool:
    """True when a refusal in the pull-review-comment container blocks."""
    inline = [_comment_record(item, i) for i, item in enumerate(comments, 1)]
    _install_review_responses(module, inline=inline)
    return len(module.blocking_changes_requests("1", "o/r", SHA)) > 0


