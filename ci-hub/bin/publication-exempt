#!/usr/bin/env python3
"""Record, with attribution, that a drain task owed no published comment.

WHY THIS IS A TOOL AND NOT A LINE OF PROSE
------------------------------------------
The publication rule has always had an escape hatch: a task that correctly
decided nothing needed saying -- a duplicate, or a pull request whose landing
published itself -- writes `NO-PUBLICATION: <reason>` and the check accepts it.

Two things are wrong with that as the durable form. Nothing stops the string
appearing inside a quoted example, so the hatch can open by accident; and
nothing records WHO decided, so the hatch cannot be reviewed. An escape hatch
whose users are anonymous is indistinguishable from a weaker rule.

This writes the same decision as a structured record carrying the deciding
agent, resolved through the same process-context authority that attributes a
comment write. The reason is still free text, because the reason is the part a
human has to read.

  cat > /tmp/<agent>-publication-reason.md <<'EOF'
  landing published itself at <sha>
  EOF
  ci-hub/bin/publication-exempt <task> --repo owner/name --pr N \\
      --reason-file /tmp/<agent>-publication-reason.md \\
      --who <agent> --team <t> --role <r>

THE EXEMPTION IS NOT A PUBLICATION and the check keeps counting the two
separately. This tool only makes the claim attributable; it does not make it
true, and `--census` still lists every exemption by name.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Callable

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from closure import publication_record  # noqa: E402

BIN_DIR = Path(__file__).resolve().parent
REPO_ROOT = BIN_DIR.parents[1]


def resolve_actor(claimed: str) -> str:
    """Refuse unless the process context agrees the caller is who it says.

    ⚠️ READ THE TYPED FIELD, NOT THE PRINTED TAG. Bare `who-am-i` prints the
    five-field disclosure `[team, agent, model, machine, role=...]`; comparing
    `--who` against that whole string refuses EVERY correct caller, because the
    tag is not the agent name. `--json` carries `agent` as its own field, and
    `state`, which is what actually says whether the signals agree.
    """
    who = Path(__file__).resolve().parent / "who-am-i"
    proc = subprocess.run([str(who), "--json"], capture_output=True, text=True)
    try:
        info = json.loads(proc.stdout or "{}")
    except ValueError:
        info = {}
    resolved = str(info.get("agent") or "")
    state = str(info.get("state") or "")
    if proc.returncode != 0 or not resolved:
        sys.exit(
            f"publication-exempt: REFUSING \u2014 cannot resolve the calling agent "
            f"({(proc.stderr or '').strip()[:160]}). "
            "A record that cannot name its author records nothing. Run "
            "ci-hub/bin/who-am-i --diagnostics, fix the missing identity signal, "
            "then retry."
        )
    if state != "AGREEMENT":
        sys.exit(
            f"publication-exempt: REFUSING \u2014 process context resolves {resolved!r} in state "
            f"{state!r}, not AGREEMENT. An attributed record whose author is "
            "uncertain is worse than none. Run ci-hub/bin/who-am-i --diagnostics, "
            "resolve the disagreement, then retry."
        )
    if claimed and resolved != claimed:
        sys.exit(
            f"publication-exempt: REFUSING \u2014 --who said {claimed!r} but the process context "
            f"resolves to {resolved!r}. Omit --who to use the resolved identity, or "
            f"pass --who {resolved}, then retry."
        )
    return resolved


def write_exemption(
    task: str,
    repo: str,
    pr: int,
    actor: str,
    reason: str,
    *,
    run: Callable[..., subprocess.CompletedProcess[str]] = subprocess.run,
) -> subprocess.CompletedProcess[str]:
    """Write the structured record through the byte-verifying note path."""
    body = publication_record.render_exemption(repo, pr, actor, reason)
    with tempfile.NamedTemporaryFile(
        "w", suffix=".note", delete=False, encoding="utf-8"
    ) as handle:
        handle.write(body)
        note_path = Path(handle.name)
    env = os.environ.copy()
    # NamedTemporaryFile creates an unpredictable path with O_EXCL. Tell the
    # verified writer that this is its supported private-temp case rather than
    # an agent-chosen shared /tmp filename.
    env["TG_NOTE_PRIVATE_TEMP"] = "1"
    try:
        return run(
            [str(BIN_DIR / "tg-note-verified"), task, "--file", str(note_path)],
            cwd=REPO_ROOT,
            env=env,
            capture_output=True,
            text=True,
        )
    finally:
        try:
            note_path.unlink()
        except OSError:
            pass


def main(
    argv: list[str] | None = None,
    *,
    run: Callable[..., subprocess.CompletedProcess[str]] = subprocess.run,
    actor_resolver: Callable[[str], str] = resolve_actor,
) -> int:
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument("task")
    parser.add_argument("--repo", required=True, help="owner/name")
    parser.add_argument("--pr", required=True, type=int)
    parser.add_argument(
        "--reason-file",
        required=True,
        type=Path,
        help="file containing the reason; use a quoted heredoc so the shell cannot alter it",
    )
    parser.add_argument("--who", default="")
    parser.add_argument("--team", default="")
    parser.add_argument("--role", default="")
    args = parser.parse_args(argv)

    try:
        reason = args.reason_file.read_text(encoding="utf-8")
    except OSError as error:
        print(
            f"publication-exempt: cannot read reason file {args.reason_file}: {error}. "
            "Create that file with the reason, or pass a readable --reason-file, "
            "then retry.",
            file=sys.stderr,
        )
        return 2

    actor = actor_resolver(args.who)
    result = write_exemption(
        args.task,
        args.repo,
        args.pr,
        actor,
        reason,
        run=run,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip()
        print(
            f"publication-exempt: tg-note-verified failed (rc={result.returncode}): "
            f"{detail}. Follow the note writer's remedy, then retry this command.",
            file=sys.stderr,
        )
        return result.returncode
    if result.stdout:
        print(result.stdout.rstrip())
    print(f"recorded exemption for {args.repo}#{args.pr} on {args.task}, by {actor}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
