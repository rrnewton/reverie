#!/usr/bin/env python3
"""Plan or apply a hash-bound archival recovery of legacy escalation evidence."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "ci-hub/lib"))

from health_escalation_recovery import (  # noqa: E402
    RecoveryRefused,
    apply_recovery,
    write_plan,
)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    plan = subparsers.add_parser(
        "plan", help="write a deterministic read-only queue manifest"
    )
    plan.add_argument("--queue", required=True, type=Path)
    plan.add_argument("--output", required=True, type=Path)
    plan.add_argument(
        "--source-log",
        action="append",
        default=[],
        type=Path,
        help="immutable-prefix attempt log to hash and correlate (repeatable)",
    )

    apply = subparsers.add_parser("apply", help="archive exactly one reviewed manifest")
    apply.add_argument("--queue", required=True, type=Path)
    apply.add_argument("--manifest", required=True, type=Path)
    apply.add_argument("--expected-manifest-sha256", required=True)
    apply.add_argument("--archive-root", required=True, type=Path)

    args = parser.parse_args(argv)
    try:
        if args.command == "plan":
            digest, manifest = write_plan(
                args.queue, args.output, source_logs=tuple(args.source_log)
            )
            print(
                json.dumps(
                    {
                        "archive_members": manifest["counts"]["archive_members"],
                        "legacy_events": manifest["counts"]["legacy_events"],
                        "manifest": str(args.output.resolve()),
                        "manifest_sha256": digest,
                    },
                    sort_keys=True,
                )
            )
            return 0
        archive = apply_recovery(
            queue=args.queue,
            manifest_path=args.manifest,
            expected_manifest_sha256=args.expected_manifest_sha256,
            archive_root=args.archive_root,
        )
        print(json.dumps({"archive": str(archive), "state": "applied"}, sort_keys=True))
        return 0
    except (OSError, RecoveryRefused) as error:
        print(f"recover-health-escalation-legacy: REFUSED: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
