#!/usr/bin/env python3
"""Publish an operational alarm somewhere it can be read when Orc is not running.

WHY THIS EXISTS. Every alerting route on this host went through
``scripts/orc-hermit-msg.py``, which delivers by typing into the Orc coordinator's
TUI pane. Measured 2026-09-03 over 1656 recorded attempts in
``~/.local/state/orc-hermit-msg.log``: 1032 failed, the last successful send was
2026-08-25T03:02:05-07:00, and the 202 attempts after it all failed. 464 of the
failures are the composer probe not recognising a pane that is visibly drawing an
input box. Repairing that probe is a treadmill -- three earlier probes were each
invalidated by an Orc build -- and it would leave the real problem in place: both
Orc transports need Orc, and the alarm most worth delivering is the one that says
this host's monitoring has stopped.

TWO SINKS, TWO DIFFERENT OUTAGES, AND THEY ARE NOT INTERCHANGEABLE.

``--sink github`` writes an issue on the fork. It is deliberately OFF THIS HOST:
it needs no Orc, no tmux, no TUI and no agent running, and it survives the whole
fleet being down, which a file or a work queue on this machine does not. That is
the ABSENT-COORDINATOR case.

``--sink taskgraph`` files a row in the work queue. A queue entry gets DISPATCHED
rather than needing to be noticed, which is a different property from delivery
and the one that has actually been missing: the failure all week was correct
alarms nobody read. That is the PRESENT-BUT-NOT-LOOKING case.

The queue sink does NOT cover the first case and must not be described as though
it does -- when Orc is down there is nobody reading the queue either. Each sink
reports its own outcome by name and neither one's failure hides the other's,
because conflating them would leave one outage uncovered while looking complete.

WHAT THIS IS NOT. It is not a push. ``gh`` authenticates as the repository
owner's own account and GitHub does not notify you about your own actions, so the
issue is VISIBLE where the project already looks -- "work from the project backlog
and github issues" is standing policy -- rather than delivered to a phone. Saying
otherwise would be the same overclaim this tool exists to correct.

DELIVERY IS READ BACK, NOT ASSUMED. ``gh issue create`` exiting 0 says the
command ran. This fetches the issue or comment afterwards and requires the digest
marker to be present in what GitHub returns. Only then is the outcome
``published``. That is the same standard the Orc relay already holds itself to,
and the reason it reports honest failures instead of silent ones.

GITHUB IS THE STATE, not a local file. The issue body and its comments carry
``escalation-key:`` and ``escalation-digest:`` marker lines, so which issue
belongs to a key, and whether the content has changed since the last
publication, are both answered by reading the fork. A local cache would be one
more thing that can be lost or disagree.

QUIET WHILE UNCHANGED. The staleness alarm fires every ten minutes; 144 issues a
day is a sink nobody reads either. An open issue whose latest digest already
matches gets nothing new until either the content changes or ``--repeat-after``
elapses, so a persistent condition still says "still true" once a day rather than
going silent.

THE LOCAL RECORD IS WRITTEN FIRST, always, before anything can fail. If the fork
is unreachable the alarm is still on disk and this exits nonzero saying that the
local copy is the only one -- never 0, because a caller that cannot tell
"published" from "recorded here alone" is the defect being fixed.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
DEFAULT_REPOSITORY = "rrnewton/dev-hermit"
DEFAULT_LOG = Path.home() / ".local/state/hermit-escalation.log"
DEFAULT_REPEAT_AFTER_SECONDS = 86400
DEFAULT_TIMEOUT_SECONDS = 45
KEY_MARKER = "escalation-key:"
DIGEST_MARKER = "escalation-digest:"
KEY_RE = re.compile(r"^[a-z0-9][a-z0-9-]{2,63}$")
TG_DB_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")
GITHUB = "github"
TASKGRAPH = "taskgraph"
SINKS = (GITHUB, TASKGRAPH)
DEFAULT_TG_DATABASE = "hermit2"
DEFAULT_TG_BLOCKS = "ci_hub_trust"
DIGEST_RE = re.compile(rf"^{DIGEST_MARKER}\s*([0-9a-f]{{12}})\s*$", re.MULTILINE)

PUBLISHED = "published"
UNCHANGED = "unchanged"
RESOLVED = "resolved"
NOTHING_OPEN = "nothing-open"
RECORDED_ONLY = "recorded-locally-only"


def now_utc() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def digest_of(text: str, ignore: tuple[str, ...] = ()) -> str:
    """The digest decides whether anything CHANGED, so it is taken over the part
    of the message that carries meaning.

    Some callers stamp every line with when it was observed and which commit
    produced it. Those are worth publishing and worthless for comparison: with
    them included, a condition that has been identical for a week reads as new
    on every run, and the sink turns into an hourly comment nobody reads --
    which is the same "nobody hears it" defect arriving from the other side.
    Each --digest-ignore pattern is blanked here and nowhere else; the published
    text is always the caller's, verbatim.
    """
    normalized = text
    for pattern in ignore:
        normalized = re.sub(pattern, "<ignored>", normalized)
    return hashlib.sha256(normalized.encode("utf-8")).hexdigest()[:12]


def marker_block(key: str, digest: str, observed_at: str) -> str:
    return (
        f"{KEY_MARKER} {key}\n"
        f"{DIGEST_MARKER} {digest}\n"
        f"escalation-observed-at: {observed_at}\n"
        f"escalation-host: {os.uname().nodename}\n"
    )


def append_local_record(log_path: Path, record: dict[str, object]) -> str | None:
    """Write the alarm to disk before anything that can fail. Returns an error, or None."""
    try:
        log_path.parent.mkdir(parents=True, exist_ok=True)
        with log_path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(record, sort_keys=True) + "\n")
    except OSError as error:
        return str(error)
    return None


class SinkUnavailable(RuntimeError):
    """A sink could not be read or written. Never confused with 'nothing to do'."""


class GitHubUnavailable(SinkUnavailable):
    """The fork could not be read or written."""


class TaskGraphUnavailable(SinkUnavailable):
    """The work queue could not be read or written."""


def run_gh(
    args: list[str],
    *,
    gh: Path,
    timeout: int,
    stdin_text: str | None = None,
) -> str:
    try:
        completed = subprocess.run(
            [str(gh), *args],
            capture_output=True,
            text=True,
            input=stdin_text,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise GitHubUnavailable(f"{' '.join(args[:3])}: {error}") from error
    if completed.returncode != 0:
        detail = " ".join((completed.stderr or completed.stdout or "").split())[:400]
        raise GitHubUnavailable(
            f"{' '.join(args[:3])} exited {completed.returncode}: {detail}"
        )
    return completed.stdout


def find_open_issue(key: str, *, repository: str, gh: Path, timeout: int) -> dict | None:
    """The open issue carrying this key, read from the fork rather than a cache.

    Bodies are listed and matched exactly. GitHub's `--search` is index-backed and
    lags behind a just-created issue, which would make a second alarm open a
    duplicate; enumerating open issues costs one call and cannot lag.
    """
    raw = run_gh(
        [
            "issue",
            "list",
            "--repo",
            repository,
            "--state",
            "open",
            "--limit",
            "100",
            "--json",
            "number,title,body",
        ],
        gh=gh,
        timeout=timeout,
    )
    try:
        issues = json.loads(raw or "[]")
    except json.JSONDecodeError as error:
        raise GitHubUnavailable(f"issue list returned unreadable JSON: {error}") from error
    wanted = f"{KEY_MARKER} {key}"
    matches = [issue for issue in issues if wanted in (issue.get("body") or "")]
    if len(matches) > 1:
        numbers = ", ".join(f"#{issue['number']}" for issue in matches)
        raise GitHubUnavailable(
            f"key {key!r} matches {len(matches)} open issues ({numbers}); "
            "refusing to guess which one carries the alarm"
        )
    return matches[0] if matches else None


def latest_digest(issue_number: int, *, repository: str, gh: Path, timeout: int) -> tuple[str | None, str | None]:
    """The most recent digest published under this issue, and when.

    Read from the body and every comment, so the answer survives losing any local
    state and reflects what a human would actually see on the issue.
    """
    raw = run_gh(
        [
            "issue",
            "view",
            str(issue_number),
            "--repo",
            repository,
            "--json",
            "body,comments,createdAt",
        ],
        gh=gh,
        timeout=timeout,
    )
    try:
        document = json.loads(raw or "{}")
    except json.JSONDecodeError as error:
        raise GitHubUnavailable(f"issue view returned unreadable JSON: {error}") from error
    entries: list[tuple[str, str]] = []
    body = document.get("body") or ""
    found = DIGEST_RE.findall(body)
    if found:
        entries.append((document.get("createdAt") or "", found[-1]))
    for comment in document.get("comments") or []:
        found = DIGEST_RE.findall(comment.get("body") or "")
        if found:
            entries.append((comment.get("createdAt") or "", found[-1]))
    if not entries:
        return None, None
    when, digest = entries[-1]
    return digest, when or None


def seconds_since(timestamp: str | None) -> float | None:
    if not timestamp:
        return None
    try:
        parsed = datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
    except ValueError:
        return None
    return (datetime.now(timezone.utc) - parsed).total_seconds()


def create_issue(
    *,
    title: str,
    body: str,
    repository: str,
    gh: Path,
    timeout: int,
    who: str,
    team: str,
    role: str,
) -> int:
    out = run_gh(
        [
            "--who",
            who,
            "--team",
            team,
            "--role",
            role,
            "issue",
            "create",
            "--repo",
            repository,
            "--title",
            title,
            "--body-file",
            "-",
        ],
        gh=gh,
        timeout=timeout,
        stdin_text=body,
    )
    match = re.search(r"/issues/(\d+)", out)
    if not match:
        raise GitHubUnavailable(
            f"issue create returned no issue URL: {' '.join(out.split())[:200]}"
        )
    return int(match.group(1))


def comment_issue(
    *,
    number: int,
    body: str,
    repository: str,
    gh: Path,
    timeout: int,
    who: str,
    team: str,
    role: str,
) -> None:
    run_gh(
        [
            "--who",
            who,
            "--team",
            team,
            "--role",
            role,
            "issue",
            "comment",
            str(number),
            "--repo",
            repository,
            "--body-file",
            "-",
        ],
        gh=gh,
        timeout=timeout,
        stdin_text=body,
    )


def verify_published(
    *, number: int, digest: str, repository: str, gh: Path, timeout: int
) -> None:
    """Read the fork back and require the digest to be there. The write's own exit
    status is not evidence: it says the command ran, not that GitHub kept it."""
    seen, _when = latest_digest(number, repository=repository, gh=gh, timeout=timeout)
    if seen != digest:
        raise GitHubUnavailable(
            f"read-back of issue #{number} found latest digest {seen!r}, expected {digest!r}"
        )


def resolve(args: argparse.Namespace) -> int:
    """Close this key's open records because the condition is no longer reported.

    Without this the sinks rot: an alarm that was true last week stays open next
    to one that is true now, and a reader cannot tell them apart. Closing is the
    other half of reporting, and it says WHY -- on the issue as a comment before
    the close, and on the queue row through the closure verifier, which is what
    keeps a settled alarm distinguishable from an abandoned one.
    """
    observed_at = now_utc()
    record: dict[str, object] = {
        "timestamp": observed_at,
        "key": args.key,
        "repository": args.repo,
        "action": "resolve",
    }
    failures = 0
    for sink in args.sink:
        try:
            if sink == GITHUB:
                outcome, where = resolve_github(args, observed_at)
                destination = (
                    f"issue=https://github.com/{args.repo}/issues/{where}" if where else ""
                )
            else:
                outcome, where = resolve_taskgraph(args)
                destination = f"queue-row={where} database={args.tg_db}" if where else ""
        except SinkUnavailable as error:
            failures += 1
            append_local_record(
                args.log_file,
                dict(record, sink=sink, outcome=RECORDED_ONLY, error=str(error)),
            )
            print(
                f"escalate: sink={sink} outcome={RECORDED_ONLY} key={args.key} error={error}",
                file=sys.stderr,
            )
            continue
        append_local_record(
            args.log_file, dict(record, sink=sink, outcome=outcome, destination=where)
        )
        print(
            f"escalate: sink={sink} outcome={outcome} key={args.key} {destination}".rstrip()
        )
    return 1 if failures else 0


def resolve_github(args: argparse.Namespace, observed_at: str) -> tuple[str, int | str]:
    gh = Path(args.gh)
    issue = find_open_issue(args.key, repository=args.repo, gh=gh, timeout=args.timeout)
    if issue is None:
        return NOTHING_OPEN, ""
    number = int(issue["number"])
    closing = (
        f"No longer reported as of {observed_at}. Closing because the "
        "condition that opened this is absent from the current report; a "
        "recurrence reopens a new issue under the same key.\n\n"
        f"{KEY_MARKER} {args.key}\n"
    )
    comment_issue(
        number=number,
        body=closing,
        repository=args.repo,
        gh=gh,
        timeout=args.timeout,
        who=args.who,
        team=args.team,
        role=args.role,
    )
    run_gh(
        ["issue", "close", str(number), "--repo", args.repo],
        gh=gh,
        timeout=args.timeout,
    )
    still_open = find_open_issue(
        args.key, repository=args.repo, gh=gh, timeout=args.timeout
    )
    if still_open is not None:
        raise GitHubUnavailable(
            f"read-back still shows issue #{still_open['number']} open for key {args.key!r}"
        )
    return RESOLVED, number


def escalate(args: argparse.Namespace, message: str) -> int:
    key = args.key
    if not KEY_RE.match(key):
        print(
            f"escalate: REFUSED: --key must match {KEY_RE.pattern}; got {key!r}",
            file=sys.stderr,
        )
        return 2
    message = message.strip("\n")
    if not message.strip():
        print("escalate: REFUSED: refusing to publish an empty alarm", file=sys.stderr)
        return 2

    observed_at = now_utc()
    try:
        for pattern in args.digest_ignore:
            re.compile(pattern)
    except re.error as error:
        print(f"escalate: REFUSED: --digest-ignore {pattern!r} is not a regex: {error}", file=sys.stderr)
        return 2
    digest = digest_of(message, tuple(args.digest_ignore))
    record: dict[str, object] = {
        "timestamp": observed_at,
        "key": key,
        "title": args.title,
        "digest": digest,
        "message_bytes": len(message.encode("utf-8")),
        "repository": args.repo,
    }

    # DISK FIRST. Everything after this point can fail; the alarm must not.
    local_error = append_local_record(args.log_file, dict(record, outcome="recorded"))

    body = f"{message}\n\n{marker_block(key, digest, observed_at)}"

    failures = 0
    for sink in args.sink:
        try:
            if sink == GITHUB:
                outcome, where = publish_github(args, key, digest, body)
                destination = f"issue=https://github.com/{args.repo}/issues/{where}"
            else:
                outcome, where = publish_taskgraph(args, key, digest, body)
                destination = f"queue-row={where} database={args.tg_db}"
        except SinkUnavailable as error:
            failures += 1
            append_local_record(
                args.log_file,
                dict(record, sink=sink, outcome=RECORDED_ONLY, error=str(error)),
            )
            print(
                f"escalate: sink={sink} outcome={RECORDED_ONLY} key={key} error={error}",
                file=sys.stderr,
            )
            continue
        append_local_record(
            args.log_file, dict(record, sink=sink, outcome=outcome, destination=where)
        )
        print(
            f"escalate: sink={sink} outcome={outcome} key={key} "
            f"{destination} digest={digest}"
        )

    if failures:
        # EVERY SINK IS REPORTED BY NAME ABOVE, and one working does not excuse
        # another failing: they cover different outages, so a partial result is
        # a partial result. Only the total loss gets the loudest line.
        if failures == len(args.sink):
            print(
                f"escalate: the alarm is in {args.log_file} and NOWHERE ELSE; "
                "nobody has been told",
                file=sys.stderr,
            )
        return 1
    if local_error is not None:
        print(
            f"escalate: WARNING: published, but the local record failed: {local_error}",
            file=sys.stderr,
        )
    return 0


def publish_github(
    args: argparse.Namespace, key: str, digest: str, body: str
) -> tuple[str, int]:
    gh = Path(args.gh)
    issue = find_open_issue(key, repository=args.repo, gh=gh, timeout=args.timeout)
    if issue is None:
        number = create_issue(
            title=args.title,
            body=body,
            repository=args.repo,
            gh=gh,
            timeout=args.timeout,
            who=args.who,
            team=args.team,
            role=args.role,
        )
        outcome = PUBLISHED
    else:
        number = int(issue["number"])
        previous, published_at = latest_digest(
            number, repository=args.repo, gh=gh, timeout=args.timeout
        )
        age = seconds_since(published_at)
        # An unreadable or absent publication time counts as stale. The two
        # ways to be wrong here are not symmetric: repeating an alarm is
        # noise, and withholding one is the defect this tool exists for.
        stale = args.repeat_after > 0 and (age is None or age >= args.repeat_after)
        if previous == digest and not stale:
            outcome = UNCHANGED
        else:
            comment_issue(
                number=number,
                body=body,
                repository=args.repo,
                gh=gh,
                timeout=args.timeout,
                who=args.who,
                team=args.team,
                role=args.role,
            )
            outcome = PUBLISHED
    if outcome == PUBLISHED:
        verify_published(
            number=number,
            digest=digest,
            repository=args.repo,
            gh=gh,
            timeout=args.timeout,
        )
    return outcome, number


# ---------------------------------------------------------------- taskgraph sink


def taskgraph_database(name: str) -> Path:
    """The exact database file this alarm belongs in.

    ⚠️ NAMED, NEVER INHERITED. Measured 2026-09-03 from a real scheduled service:
    with no TG_DB_PATH, `tg db current` answers "(no active database - using
    tasks)", while every coordinator and agent reads a different one. And the
    active-database marker is a single shared file that any `tg db create`
    rewrites for every headless caller on the box at once. A row filed into the
    wrong database is not a quieter alarm, it is an invisible one, which is the
    exact defect this tool exists to remove -- so an absent database REFUSES
    rather than falling back.
    """
    if "/" in name:
        # An explicit file. Named just as deliberately as a bare name, and the
        # form a test uses so it can exercise a real database without rewriting
        # the shared active-database marker every headless caller reads.
        path = Path(name)
    else:
        if not TG_DB_NAME_RE.match(name):
            raise TaskGraphUnavailable(
                f"database name {name!r} must match {TG_DB_NAME_RE.pattern}"
            )
        path = Path.home() / ".tg" / f"{name}.db"
    if not path.is_file():
        raise TaskGraphUnavailable(
            f"database {name!r} does not exist at {path}; refusing to file into "
            "whichever database this process would otherwise inherit"
        )
    return path


def run_tg(
    args: list[str], *, tg: str, database: str, db_path: Path, timeout: int
) -> str:
    environment = dict(os.environ)
    # Both spellings, deliberately. `--db` covers tg's own subcommands; TG_DB_PATH
    # covers the helpers this sink shells out to, which take no --db and would
    # otherwise resolve the wrong database.
    environment["TG_DB_PATH"] = str(db_path)
    selector = [] if "/" in database else ["--db", database]
    try:
        completed = subprocess.run(
            [tg, *selector, *args],
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
            env=environment,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise TaskGraphUnavailable(f"tg {' '.join(args[:2])}: {error}") from error
    if completed.returncode != 0:
        detail = " ".join((completed.stderr or completed.stdout or "").split())[:400]
        raise TaskGraphUnavailable(
            f"tg {' '.join(args[:2])} exited {completed.returncode}: {detail}"
        )
    return completed.stdout


def tg_scalar(query: str, **kwargs) -> str | None:
    """One value from one row, or None.

    `tg sql` frames its output with a header, a rule, the rows, a blank line and
    a "(N rows)" trailer. Every query here selects a single column with no
    newlines in it, so the framing can be stripped positionally -- the same shape
    ci-hub/bin/tg-note-verified already relies on.
    """
    raw = run_tg(["sql", query], **kwargs)
    lines = raw.splitlines()
    body = [
        line
        for line in lines[2:]
        if line.strip() and not re.fullmatch(r"\(\d+ rows?\)", line.strip())
    ]
    if not body:
        return None
    return body[0].strip()


def find_open_task(key: str, **kwargs) -> str | None:
    """The open queue row carrying this key.

    IN_PROGRESS counts as open on purpose: if an agent has already claimed the
    alarm, filing a second row would both duplicate the condition and split the
    ownership picture the queue exists to hold. RESOLVED and CLOSED do not match,
    so a condition that comes back opens a fresh row rather than reviving a
    settled one.

    The key is constrained to lowercase letters, digits and hyphens by KEY_RE
    before it reaches here, so it cannot carry SQL syntax.
    """
    count = tg_scalar(
        "SELECT COUNT(*) FROM tasks WHERE status IN ('OPEN','IN_PROGRESS') "
        f"AND description LIKE '%{KEY_MARKER} {key}%'",
        **kwargs,
    )
    if count is not None and count.isdigit() and int(count) > 1:
        raise TaskGraphUnavailable(
            f"key {key!r} matches {count} open queue rows; refusing to guess which "
            "one carries the alarm. Duplicate rows for one condition corrupt the "
            "ownership picture, so this is a refusal rather than a choice"
        )
    return tg_scalar(
        "SELECT local_id FROM tasks WHERE status IN ('OPEN','IN_PROGRESS') "
        f"AND description LIKE '%{KEY_MARKER} {key}%' LIMIT 1",
        **kwargs,
    )


def latest_task_digest(local_id: str, **kwargs) -> tuple[str | None, str | None]:
    where = (
        f"FROM task_notes WHERE task_id='{local_id}' "
        f"AND content LIKE '%{DIGEST_MARKER} %' ORDER BY created_at DESC LIMIT 1"
    )
    digest = tg_scalar(
        f"SELECT substr(content, instr(content, '{DIGEST_MARKER} ') + "
        f"{len(DIGEST_MARKER) + 1}, 12) {where}",
        **kwargs,
    )
    when = tg_scalar(f"SELECT created_at {where}", **kwargs)
    if digest is not None and not re.fullmatch(r"[0-9a-f]{12}", digest):
        digest = None
    return digest, when


def create_task(
    *, title: str, description: str, key: str, args: argparse.Namespace, **kwargs
) -> str:
    """File the row, then read it back by key.

    ⚠️ `tg add` DOES NOT DEDUPLICATE. Measured 2026-09-03: adding the same title
    twice produced a second row with a suffixed identifier, silently, and
    auto-attached it to the first. Callers must look the row up first -- which
    find_open_task does -- because the command will happily give you two.

    The row is left UNOWNED. An alarm nobody has picked up must be claimable by
    the next coordinator or agent; claiming it here would file work and
    immediately mark it as somebody's.
    """
    run_tg(
        [
            "add",
            title,
            "--impact",
            str(args.tg_impact),
            "--effort",
            str(args.tg_effort),
            "--tags",
            args.tg_tags,
            "--priority",
            args.tg_priority,
            "--blocks",
            args.tg_blocks,
            "--description",
            description,
        ],
        **kwargs,
    )
    local_id = find_open_task(key, **kwargs)
    if local_id is None:
        raise TaskGraphUnavailable(
            f"filed a queue row for key {key!r} but reading it back found nothing"
        )
    return local_id


def append_task_note(local_id: str, body: str, *, args: argparse.Namespace, db_path: Path) -> None:
    """Through ci-hub/bin/tg-note-verified, which reads the note back and compares.

    Not `tg note` directly: the PATH shim refuses inline note content because the
    shell substitutes before tg ever sees it, and the verified path is the
    supported way through. It takes no --db, so the database is named in its
    environment.

    ON STDIN, NOT --file. tg-note-verified refuses an unnamespaced staging path
    under a shared directory, because two agents that pick the same filename can
    swap contents between the write and the read and it would then verify
    SOMEONE ELSE'S text as yours. Its own answer is that stdin has no file to
    race, so there is nothing to namespace and nothing to clean up.
    """
    environment = dict(os.environ)
    environment["TG_DB_PATH"] = str(db_path)
    try:
        completed = subprocess.run(
            [args.tg_note_verified, local_id],
            input=body,
            capture_output=True,
            text=True,
            timeout=args.timeout,
            check=False,
            env=environment,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise TaskGraphUnavailable(f"tg-note-verified: {error}") from error
    if completed.returncode != 0:
        detail = " ".join((completed.stderr or completed.stdout or "").split())[:400]
        raise TaskGraphUnavailable(f"tg-note-verified exited {completed.returncode}: {detail}")


def publish_taskgraph(
    args: argparse.Namespace, key: str, digest: str, body: str
) -> tuple[str, str]:
    database = args.tg_db
    db_path = taskgraph_database(database)
    common = {
        "tg": args.tg,
        "database": database,
        "db_path": db_path,
        "timeout": args.timeout,
    }
    local_id = find_open_task(key, **common)
    if local_id is None:
        local_id = create_task(
            title=args.title,
            description=f"{body}",
            key=key,
            args=args,
            **common,
        )
        append_task_note(local_id, body, args=args, db_path=db_path)
        outcome = PUBLISHED
    else:
        previous, noted_at = latest_task_digest(local_id, **common)
        age = seconds_since(noted_at)
        stale = args.repeat_after > 0 and (age is None or age >= args.repeat_after)
        if previous == digest and not stale:
            return UNCHANGED, local_id
        append_task_note(local_id, body, args=args, db_path=db_path)
        outcome = PUBLISHED
    seen, _when = latest_task_digest(local_id, **common)
    if seen != digest:
        raise TaskGraphUnavailable(
            f"read-back of queue row {local_id} found latest digest {seen!r}, "
            f"expected {digest!r}"
        )
    return outcome, local_id


def resolve_taskgraph(args: argparse.Namespace) -> tuple[str, str]:
    """Close this key's queue row through the supported verifier.

    Not `tg update --status closed`: the PATH shim refuses that because a task
    closed without evidence leaves ready, active and the drain in one step and no
    later audit can tell a settled alarm from an abandoned one.
    """
    database = args.tg_db
    db_path = taskgraph_database(database)
    common = {
        "tg": args.tg,
        "database": database,
        "db_path": db_path,
        "timeout": args.timeout,
    }
    local_id = find_open_task(args.key, **common)
    if local_id is None:
        return NOTHING_OPEN, ""
    environment = dict(os.environ)
    environment["TG_DB_PATH"] = str(db_path)
    disposition = (
        f"no longer reported by the {args.key} check as of {now_utc()}; a "
        "recurrence files a new row under the same key"
    )
    try:
        completed = subprocess.run(
            [args.close_task, local_id, "--disposition", disposition],
            capture_output=True,
            text=True,
            timeout=args.timeout,
            check=False,
            env=environment,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise TaskGraphUnavailable(f"close-task: {error}") from error
    if completed.returncode != 0:
        detail = " ".join((completed.stderr or completed.stdout or "").split())[:400]
        raise TaskGraphUnavailable(f"close-task exited {completed.returncode}: {detail}")
    still_open = find_open_task(args.key, **common)
    if still_open is not None:
        raise TaskGraphUnavailable(
            f"read-back still shows queue row {still_open} open for key {args.key!r}"
        )
    return RESOLVED, local_id


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    # Not `required=True`: --self-test must be runnable with no other argument,
    # so that a harness can check this tool without composing an alarm. main()
    # enforces both for every real publication.
    parser.add_argument(
        "--key",
        help="stable identifier for this alarm; one open issue is kept per key",
    )
    parser.add_argument("--title", help="issue title, one line of prose")
    parser.add_argument("--repo", default=DEFAULT_REPOSITORY, help="owner/name to publish to")
    parser.add_argument(
        "--message-file",
        type=Path,
        help="read the alarm from this file instead of standard input",
    )
    parser.add_argument("--log-file", type=Path, default=DEFAULT_LOG)
    parser.add_argument(
        "--repeat-after",
        type=int,
        default=DEFAULT_REPEAT_AFTER_SECONDS,
        help=(
            "re-say an unchanged alarm after this many seconds so a persistent "
            "condition does not go silent; 0 never repeats (default: %(default)s)"
        ),
    )
    parser.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT_SECONDS)
    parser.add_argument(
        "--gh",
        default=str(ROOT / "ci-hub/bin/gh"),
        help="the attributed GitHub boundary to write through (default: %(default)s)",
    )
    parser.add_argument(
        "--who",
        default=os.environ.get("DG_AGENT_NAME", ""),
        help="resolved agent name for the disclosure prefix (default: $DG_AGENT_NAME)",
    )
    parser.add_argument("--team", default="hermit2")
    parser.add_argument("--role", default="relay")
    parser.add_argument(
        "--sink",
        action="append",
        choices=SINKS,
        default=[],
        help=(
            "where to publish (repeatable). `github` is off this host and covers "
            "the coordinator being ABSENT; `taskgraph` files a row in the work "
            "queue and covers the coordinator being PRESENT AND NOT LOOKING. They "
            "are not substitutes: when Orc is down nobody reads the queue either. "
            "Default: github"
        ),
    )
    parser.add_argument(
        "--tg",
        default="tg",
        help="the TaskGraph command (default: %(default)s)",
    )
    parser.add_argument(
        "--tg-db",
        default=DEFAULT_TG_DATABASE,
        help=(
            "the database to file into, named rather than inherited. A scheduled "
            "service resolves a DIFFERENT database from the one coordinators read, "
            "so this is not optional and an absent database refuses "
            "(default: %(default)s)"
        ),
    )
    parser.add_argument(
        "--tg-blocks",
        default=DEFAULT_TG_BLOCKS,
        help="the goal the filed row blocks (default: %(default)s)",
    )
    parser.add_argument("--tg-impact", type=int, default=60)
    parser.add_argument("--tg-effort", type=int, default=1)
    parser.add_argument("--tg-tags", default="monitoring,tick")
    parser.add_argument("--tg-priority", default="P1")
    parser.add_argument(
        "--tg-note-verified",
        default=str(ROOT / "ci-hub/bin/tg-note-verified"),
        help="the verified note path this sink appends through (default: %(default)s)",
    )
    parser.add_argument(
        "--close-task",
        default=str(ROOT / "ci-hub/bin/close-task"),
        help="the closure verifier this sink closes through (default: %(default)s)",
    )
    parser.add_argument(
        "--digest-ignore",
        action="append",
        default=[],
        metavar="REGEX",
        help=(
            "text that changes on every run and must not count as a change "
            "(repeatable). Affects change detection only; the published text is "
            "always verbatim"
        ),
    )
    parser.add_argument(
        "--resolve",
        action="store_true",
        help=(
            "the condition is no longer reported: comment and close this key's "
            "open issue, so the issue list says what is true now"
        ),
    )
    parser.add_argument(
        "--self-test",
        action="store_true",
        help="check the parts that need no network, then exit",
    )
    return parser


def self_test() -> int:
    """Cover the decisions that do not need GitHub. Reaches no repository."""
    failures: list[str] = []

    def check(name: str, condition: bool) -> None:
        if not condition:
            failures.append(name)

    check("digest is stable", digest_of("a") == digest_of("a"))
    check("digest separates content", digest_of("a") != digest_of("b"))
    check("digest is twelve hex", re.fullmatch(r"[0-9a-f]{12}", digest_of("a")) is not None)

    block = marker_block("health-tick-staleness", digest_of("x"), "2026-01-01T00:00:00Z")
    found = DIGEST_RE.findall(block)
    check("digest marker round-trips", found == [digest_of("x")])
    check("key marker is present", f"{KEY_MARKER} health-tick-staleness" in block)

    two = block + "\n" + marker_block("k", "0123456789ab", "2026-01-01T00:00:00Z")
    check("last digest wins", DIGEST_RE.findall(two)[-1] == "0123456789ab")

    check("key grammar accepts a normal key", KEY_RE.match("operational-tick-findings") is not None)
    check("key grammar rejects spaces", KEY_RE.match("two words") is None)
    check("key grammar rejects uppercase", KEY_RE.match("Key") is None)
    check("key grammar rejects a leading dash", KEY_RE.match("-key") is None)

    stamped_a = 'ACTION: x title="y observed_at=2026-01-01T00:00:00Z"'
    stamped_b = 'ACTION: x title="y observed_at=2026-06-01T00:00:00Z"'
    ignore = (r"observed_at=[0-9TZ:+-]+",)
    check("volatile text still changes the digest by default", digest_of(stamped_a) != digest_of(stamped_b))
    check(
        "an ignored pattern makes the two compare equal",
        digest_of(stamped_a, ignore) == digest_of(stamped_b, ignore),
    )
    check(
        "an ignored pattern does not hide a real change",
        digest_of(stamped_a, ignore) != digest_of(stamped_a.replace("ACTION: x", "ACTION: z"), ignore),
    )

    check("no timestamp is not fresh", seconds_since(None) is None)
    check("a bad timestamp is not fresh", seconds_since("not-a-time") is None)
    aged = seconds_since("2000-01-01T00:00:00Z")
    check("an old timestamp is old", aged is not None and aged > 86400)

    for name in failures:
        print(f"escalate self-test FAIL: {name}", file=sys.stderr)
    total = 16
    print(f"escalate self-test: {total - len(failures)}/{total} checks passed")
    return 1 if failures else 0


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.self_test:
        return self_test()
    # argparse cannot express "default to one element" for an appending option
    # without that default surviving alongside anything the caller supplies.
    if not args.sink:
        args.sink = [GITHUB]
    else:
        args.sink = list(dict.fromkeys(args.sink))
    required = ("key",) if args.resolve else ("key", "title")
    missing = [name for name in required if not getattr(args, name)]
    if missing:
        print(
            "escalate: REFUSED: " + ", ".join(f"--{name}" for name in missing) + " is required",
            file=sys.stderr,
        )
        return 2
    if not args.who:
        print(
            "escalate: REFUSED: --who is required (or set DG_AGENT_NAME); an "
            "unattributed issue is indistinguishable from one the owner wrote",
            file=sys.stderr,
        )
        return 2
    if not KEY_RE.match(args.key):
        print(
            f"escalate: REFUSED: --key must match {KEY_RE.pattern}; got {args.key!r}",
            file=sys.stderr,
        )
        return 2
    if args.resolve:
        return resolve(args)
    if args.message_file is not None:
        try:
            message = args.message_file.read_text(encoding="utf-8")
        except OSError as error:
            print(f"escalate: REFUSED: cannot read {args.message_file}: {error}", file=sys.stderr)
            return 2
    else:
        message = sys.stdin.read()
    return escalate(args, message)


if __name__ == "__main__":
    raise SystemExit(main())
