#!/usr/bin/env python3
"""Publish an operational alarm somewhere it can be read when Orc is not running.

WHY THIS EXISTS. Every alerting route on this host went through
``scripts/orc-hermit-msg.py``, which delivers by typing into the Orc coordinator's
TUI pane. Measured 2026-09-03 over 1656 recorded attempts in
``~/.local/state/orc-hermit-msg.log``: 1032 failed, the last successful send was
2026-08-25T03:02:05-07:00, and the 202 attempts after it all failed. 464 of the
failures are the composer probe not recognising a pane that is visibly drawing an
input box. Repairing that probe is a treadmill -- three earlier probes were each
invalidated by an Orc build -- and it would leave the real problem in place: both
Orc transports need Orc, and the alarm most worth delivering is the one that says
this host's monitoring has stopped.

TWO SINKS, TWO DIFFERENT OUTAGES, AND THEY ARE NOT INTERCHANGEABLE.

``--sink github`` writes an issue on the fork. It is deliberately OFF THIS HOST:
it needs no Orc, no tmux, no TUI and no agent running, and it survives the whole
fleet being down, which a file or a work queue on this machine does not. That is
the ABSENT-COORDINATOR case.

``--sink taskgraph`` files a row in the work queue. A queue entry gets DISPATCHED
rather than needing to be noticed, which is a different property from delivery
and the one that has actually been missing: the failure all week was correct
alarms nobody read. That is the PRESENT-BUT-NOT-LOOKING case.

The queue sink does NOT cover the first case and must not be described as though
it does -- when Orc is down there is nobody reading the queue either. Each sink
reports its own outcome by name and neither one's failure hides the other's,
because conflating them would leave one outage uncovered while looking complete.

WHAT THIS IS NOT. It is not a push. ``gh`` authenticates as the repository
owner's own account and GitHub does not notify you about your own actions, so the
issue is VISIBLE where the project already looks -- "work from the project backlog
and github issues" is standing policy -- rather than delivered to a phone. Saying
otherwise would be the same overclaim this tool exists to correct.

DELIVERY IS READ BACK, NOT ASSUMED. ``gh issue create`` exiting 0 says the
command ran. This fetches the issue or comment afterwards and requires the digest
marker to be present in what GitHub returns. Only then is the outcome
``published``. That is the same standard the Orc relay already holds itself to,
and the reason it reports honest failures instead of silent ones.

GITHUB IS THE STATE, not a local file. The issue body and its comments carry
``escalation-key:`` and ``escalation-digest:`` marker lines, so which issue
belongs to a key, and whether the content has changed since the last
publication, are both answered by reading the fork. A local cache would be one
more thing that can be lost or disagree.

QUIET WHILE UNCHANGED. The staleness alarm fires every ten minutes; 144 issues a
day is a sink nobody reads either. An open issue whose latest digest already
matches gets nothing new until either the content changes or ``--repeat-after``
elapses, so a persistent condition still says "still true" once a day rather than
going silent.

THE LOCAL RECORD IS WRITTEN FIRST, always, before anything can fail. If the fork
is unreachable the alarm is still on disk and this exits nonzero saying that the
local copy is the only one -- never 0, because a caller that cannot tell
"published" from "recorded here alone" is the defect being fixed.
"""

from __future__ import annotations

import argparse
import errno
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import sqlite3
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from health_escalation_event import (  # noqa: E402
    InvalidEvent,
    PART_BEGIN,
    load_event,
    parse_part,
    part_documents,
    stable_task_id,
)

ROOT = Path(__file__).resolve().parents[2]
DEFAULT_REPOSITORY = "rrnewton/dev-hermit"
DEFAULT_LOG = Path.home() / ".local/state/hermit-escalation.log"
DEFAULT_REPEAT_AFTER_SECONDS = 86400
DEFAULT_TIMEOUT_SECONDS = 45
KEY_MARKER = "escalation-key:"
DIGEST_MARKER = "escalation-digest:"
KEY_RE = re.compile(r"^[a-z0-9][a-z0-9-]{2,63}$")
TG_DB_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")
GITHUB = "github"
TASKGRAPH = "taskgraph"
SINKS = (GITHUB, TASKGRAPH)
DEFAULT_TG_DATABASE = "hermit2"
DEFAULT_TG_BLOCKS = "ci_hub_trust"
ACTIVE_TASK_STATUSES = frozenset(("BACKLOG", "OPEN", "IN_PROGRESS"))
TERMINAL_TASK_STATUSES = frozenset(("CLOSED", "RESOLVED"))
DIGEST_RE = re.compile(rf"^{DIGEST_MARKER}\s*([0-9a-f]{{12}})\s*$", re.MULTILINE)
RELAY_DISCLOSURE_RE = re.compile(
    r"^\[[A-Za-z0-9_.-]+, [A-Za-z0-9_.-]+, [^,\[\]\r\n]+, "
    r"[A-Za-z0-9_.-]+, role=relay\]\n"
    r"(?:Unverified --who metadata: [^\r\n]+\n)?"
)

PUBLISHED = "published"
UNCHANGED = "unchanged"
RESOLVED = "resolved"
NOTHING_OPEN = "nothing-open"
RECORDED_ONLY = "recorded-locally-only"


def now_utc() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def digest_of(text: str, ignore: tuple[str, ...] = ()) -> str:
    """The digest decides whether anything CHANGED, so it is taken over the part
    of the message that carries meaning.

    Some callers stamp every line with when it was observed and which commit
    produced it. Those are worth publishing and worthless for comparison: with
    them included, a condition that has been identical for a week reads as new
    on every run, and the sink turns into an hourly comment nobody reads --
    which is the same "nobody hears it" defect arriving from the other side.
    Each --digest-ignore pattern is blanked here and nowhere else; the published
    text is always the caller's, verbatim.
    """
    normalized = text
    for pattern in ignore:
        normalized = re.sub(pattern, "<ignored>", normalized)
    return hashlib.sha256(normalized.encode("utf-8")).hexdigest()[:12]


def marker_block(key: str, digest: str, observed_at: str) -> str:
    return (
        f"{KEY_MARKER} {key}\n"
        f"{DIGEST_MARKER} {digest}\n"
        f"escalation-observed-at: {observed_at}\n"
        f"escalation-host: {os.uname().nodename}\n"
    )


def append_local_record(log_path: Path, record: dict[str, object]) -> str | None:
    """Write the alarm to disk before anything that can fail. Returns an error, or None."""
    try:
        log_path.parent.mkdir(parents=True, exist_ok=True)
        with log_path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(record, sort_keys=True) + "\n")
    except OSError as error:
        return str(error)
    return None


class SinkUnavailable(RuntimeError):
    """A sink could not be read or written. Never confused with 'nothing to do'."""


class GitHubUnavailable(SinkUnavailable):
    """The fork could not be read or written."""


class TaskGraphUnavailable(SinkUnavailable):
    """The work queue could not be read or written."""


class PermanentSinkFailure(SinkUnavailable):
    """Retrying the same immutable event with the same publisher cannot work."""


class PermanentGitHubFailure(PermanentSinkFailure, GitHubUnavailable):
    pass


class PermanentTaskGraphFailure(PermanentSinkFailure, TaskGraphUnavailable):
    pass


def bounded_detail(text: str, limit: int = 400) -> str:
    """Keep both the command framing and its root cause."""
    collapsed = " ".join(re.sub(r"\x1b\[[0-9;]*m", "", text).split())
    if len(collapsed) <= limit * 2:
        return collapsed
    return collapsed[:limit] + " ...[middle omitted]... " + collapsed[-limit:]


def run_gh(
    args: list[str],
    *,
    gh: Path,
    timeout: int,
    stdin_text: str | None = None,
) -> str:
    try:
        completed = subprocess.run(
            [str(gh), *args],
            capture_output=True,
            text=True,
            input=stdin_text,
            timeout=timeout,
            check=False,
        )
    except OSError as error:
        if getattr(error, "errno", None) == errno.E2BIG:
            raise PermanentGitHubFailure(
                f"{' '.join(args[:3])}: exec argument list too long: {error}"
            ) from error
        raise GitHubUnavailable(f"{' '.join(args[:3])}: {error}") from error
    except subprocess.TimeoutExpired as error:
        raise GitHubUnavailable(f"{' '.join(args[:3])}: {error}") from error
    if completed.returncode != 0:
        detail = bounded_detail(completed.stderr or completed.stdout or "")
        failure = (
            PermanentGitHubFailure
            if completed.returncode in {2, 64} or "HTTP 422" in detail or "body is too long" in detail.lower()
            else GitHubUnavailable
        )
        raise failure(
            f"{' '.join(args[:3])} exited {completed.returncode}: {detail}"
        )
    return completed.stdout


def find_open_issue(key: str, *, repository: str, gh: Path, timeout: int) -> dict | None:
    """The open issue carrying this key, read from the fork rather than a cache.

    Bodies are listed and matched exactly. GitHub's `--search` is index-backed and
    lags behind a just-created issue, which would make a second alarm open a
    duplicate; enumerating open issues costs one call and cannot lag.
    """
    raw = run_gh(
        [
            "issue",
            "list",
            "--repo",
            repository,
            "--state",
            "open",
            "--limit",
            "1000",
            "--json",
            "number,title,body,author",
        ],
        gh=gh,
        timeout=timeout,
    )
    try:
        issues = json.loads(raw or "[]")
    except json.JSONDecodeError as error:
        raise GitHubUnavailable(f"issue list returned unreadable JSON: {error}") from error
    wanted = f"{KEY_MARKER} {key}"
    marker = re.compile(rf"(?m)^{re.escape(wanted)}$")
    trusted_author = repository.split("/", 1)[0].lower()
    matches = [
        issue
        for issue in issues
        if marker.search(issue.get("body") or "") is not None
        and ((issue.get("author") or {}).get("login") or "").lower()
        == trusted_author
    ]
    if len(matches) > 1:
        numbers = ", ".join(f"#{issue['number']}" for issue in matches)
        raise GitHubUnavailable(
            f"key {key!r} matches {len(matches)} open issues ({numbers}); "
            "refusing to guess which one carries the alarm"
        )
    return matches[0] if matches else None


def latest_digest(issue_number: int, *, repository: str, gh: Path, timeout: int) -> tuple[str | None, str | None]:
    """The most recent digest published under this issue, and when.

    Read from the body and every comment, so the answer survives losing any local
    state and reflects what a human would actually see on the issue.
    """
    document = issue_document(
        issue_number, repository=repository, gh=gh, timeout=timeout
    )
    entries: list[tuple[str, str]] = []
    trusted_author = repository.split("/", 1)[0].lower()
    body = document.get("body") or ""
    body_is_trusted = (
        ((document.get("author") or {}).get("login") or "").lower()
        == trusted_author
    )
    found = DIGEST_RE.findall(body) if body_is_trusted else []
    if found:
        entries.append((document.get("createdAt") or "", found[-1]))
    for comment in document.get("comments") or []:
        if ((comment.get("author") or {}).get("login") or "").lower() != trusted_author:
            continue
        found = DIGEST_RE.findall(comment.get("body") or "")
        if found:
            entries.append((comment.get("createdAt") or "", found[-1]))
    if not entries:
        return None, None
    when, digest = entries[-1]
    return digest, when or None


def seconds_since(timestamp: str | None) -> float | None:
    if not timestamp:
        return None
    try:
        parsed = datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
    except ValueError:
        return None
    return (datetime.now(timezone.utc) - parsed).total_seconds()


def create_issue(
    *,
    title: str,
    body: str,
    repository: str,
    gh: Path,
    timeout: int,
    who: str,
    team: str,
    role: str,
) -> int:
    out = run_gh(
        [
            "--who",
            who,
            "--team",
            team,
            "--role",
            role,
            "issue",
            "create",
            "--repo",
            repository,
            "--title",
            title,
            "--body-file",
            "-",
        ],
        gh=gh,
        timeout=timeout,
        stdin_text=body,
    )
    match = re.search(r"/issues/(\d+)", out)
    if not match:
        raise GitHubUnavailable(
            f"issue create returned no issue URL: {' '.join(out.split())[:200]}"
        )
    return int(match.group(1))


def comment_issue(
    *,
    number: int,
    body: str,
    repository: str,
    gh: Path,
    timeout: int,
    who: str,
    team: str,
    role: str,
) -> None:
    run_gh(
        [
            "--who",
            who,
            "--team",
            team,
            "--role",
            role,
            "issue",
            "comment",
            str(number),
            "--repo",
            repository,
            "--body-file",
            "-",
        ],
        gh=gh,
        timeout=timeout,
        stdin_text=body,
    )


def verify_published(
    *, number: int, digest: str, repository: str, gh: Path, timeout: int
) -> None:
    """Read the fork back and require the digest to be there. The write's own exit
    status is not evidence: it says the command ran, not that GitHub kept it."""
    seen, _when = latest_digest(number, repository=repository, gh=gh, timeout=timeout)
    if seen != digest:
        raise GitHubUnavailable(
            f"read-back of issue #{number} found latest digest {seen!r}, expected {digest!r}"
        )


def resolve(args: argparse.Namespace) -> int:
    """Close this key's open records because the condition is no longer reported.

    Without this the sinks rot: an alarm that was true last week stays open next
    to one that is true now, and a reader cannot tell them apart. Closing is the
    other half of reporting, and it says WHY -- on the issue as a comment before
    the close, and on the queue row through the closure verifier, which is what
    keeps a settled alarm distinguishable from an abandoned one.
    """
    observed_at = now_utc()
    record: dict[str, object] = {
        "timestamp": observed_at,
        "key": args.key,
        "repository": args.repo,
        "action": "resolve",
    }
    failures = 0
    permanent = False
    for sink in args.sink:
        try:
            if sink == GITHUB:
                outcome, where = resolve_github(args, observed_at)
                destination = (
                    f"issue=https://github.com/{args.repo}/issues/{where}" if where else ""
                )
            else:
                outcome, where = with_retry(
                    lambda: resolve_taskgraph(args), attempts=args.tg_attempts
                )
                destination = f"queue-row={where} database={args.tg_db}" if where else ""
        except PermanentSinkFailure as error:
            failures += 1
            permanent = True
            append_local_record(
                args.log_file,
                dict(record, sink=sink, outcome=RECORDED_ONLY, classification="permanent", error=str(error)),
            )
            print(
                f"escalate: sink={sink} outcome={RECORDED_ONLY} classification=permanent "
                f"key={args.key} error={error}",
                file=sys.stderr,
            )
            continue
        except SinkUnavailable as error:
            failures += 1
            append_local_record(
                args.log_file,
                dict(record, sink=sink, outcome=RECORDED_ONLY, error=str(error)),
            )
            print(
                f"escalate: sink={sink} outcome={RECORDED_ONLY} key={args.key} error={error}",
                file=sys.stderr,
            )
            continue
        append_local_record(
            args.log_file, dict(record, sink=sink, outcome=outcome, destination=where)
        )
        print(
            f"escalate: sink={sink} outcome={outcome} key={args.key} {destination}".rstrip()
        )
    return 78 if permanent else (1 if failures else 0)


def resolve_github(args: argparse.Namespace, observed_at: str) -> tuple[str, int | str]:
    gh = Path(args.gh)
    issue = find_open_issue(args.key, repository=args.repo, gh=gh, timeout=args.timeout)
    if issue is None:
        return NOTHING_OPEN, ""
    number = int(issue["number"])
    closing = (
        f"No longer reported as of {observed_at}. Closing because the "
        "condition that opened this is absent from the current report; a "
        "recurrence reopens a new issue under the same key.\n\n"
        f"{KEY_MARKER} {args.key}\n"
    )
    comment_issue(
        number=number,
        body=closing,
        repository=args.repo,
        gh=gh,
        timeout=args.timeout,
        who=args.who,
        team=args.team,
        role=args.role,
    )
    run_gh(
        ["issue", "close", str(number), "--repo", args.repo],
        gh=gh,
        timeout=args.timeout,
    )
    still_open = find_open_issue(
        args.key, repository=args.repo, gh=gh, timeout=args.timeout
    )
    if still_open is not None:
        raise GitHubUnavailable(
            f"read-back still shows issue #{still_open['number']} open for key {args.key!r}"
        )
    return RESOLVED, number


def escalate(args: argparse.Namespace, message: str) -> int:
    key = args.key
    if not KEY_RE.match(key):
        print(
            f"escalate: REFUSED: --key must match {KEY_RE.pattern}; got {key!r}",
            file=sys.stderr,
        )
        return 2
    event = getattr(args, "event", None)
    if event is None:
        message = message.strip("\n")
    if not message.strip():
        print("escalate: REFUSED: refusing to publish an empty alarm", file=sys.stderr)
        return 2

    observed_at = now_utc()
    try:
        for pattern in args.digest_ignore:
            re.compile(pattern)
    except re.error as error:
        print(f"escalate: REFUSED: --digest-ignore {pattern!r} is not a regex: {error}", file=sys.stderr)
        return 2
    digest = (
        event["normalized_sha256"][:12]
        if event is not None
        else digest_of(message, tuple(args.digest_ignore))
    )
    record: dict[str, object] = {
        "timestamp": observed_at,
        "key": key,
        "title": args.title,
        "digest": digest,
        "message_bytes": len(message.encode("utf-8")),
        "repository": args.repo,
    }
    if event is not None:
        record.update(
            event_id=event["event_id"], origin_host=event["origin_host"],
            payload_sha256=event["payload_sha256"],
        )

    # DISK FIRST. Everything after this point can fail; the alarm must not.
    local_error = append_local_record(args.log_file, dict(record, outcome="recorded"))

    body = (
        ""
        if event is not None
        else f"{message}\n\n{marker_block(key, digest, observed_at)}"
    )

    failures = 0
    permanent = False
    for sink in args.sink:
        try:
            if sink == GITHUB:
                outcome, where = (
                    publish_github_event(args, event)
                    if event is not None
                    else publish_github(args, key, digest, body)
                )
                destination = f"issue=https://github.com/{args.repo}/issues/{where}"
            else:
                outcome, where = with_retry(
                    lambda: (
                        publish_taskgraph_event(args, event)
                        if event is not None
                        else publish_taskgraph(args, key, digest, body)
                    ),
                    attempts=args.tg_attempts,
                )
                destination = f"queue-row={where} database={args.tg_db}"
        except PermanentSinkFailure as error:
            failures += 1
            permanent = True
            append_local_record(
                args.log_file,
                dict(record, sink=sink, outcome=RECORDED_ONLY, classification="permanent", error=str(error)),
            )
            print(
                f"escalate: sink={sink} outcome={RECORDED_ONLY} classification=permanent "
                f"key={key} error={error}",
                file=sys.stderr,
            )
            continue
        except SinkUnavailable as error:
            failures += 1
            append_local_record(
                args.log_file,
                dict(record, sink=sink, outcome=RECORDED_ONLY, error=str(error)),
            )
            print(
                f"escalate: sink={sink} outcome={RECORDED_ONLY} key={key} error={error}",
                file=sys.stderr,
            )
            continue
        append_local_record(
            args.log_file, dict(record, sink=sink, outcome=outcome, destination=where)
        )
        print(
            f"escalate: sink={sink} outcome={outcome} key={key} "
            f"{destination} digest={digest}"
        )

    if failures:
        # EVERY SINK IS REPORTED BY NAME ABOVE, and one working does not excuse
        # another failing: they cover different outages, so a partial result is
        # a partial result. Only the total loss gets the loudest line.
        if failures == len(args.sink):
            print(
                f"escalate: the alarm is in {args.log_file} and NOWHERE ELSE; "
                "nobody has been told",
                file=sys.stderr,
            )
        return 78 if permanent else 1
    if local_error is not None:
        print(
            f"escalate: WARNING: published, but the local record failed: {local_error}",
            file=sys.stderr,
        )
    return 0


def publish_github(
    args: argparse.Namespace, key: str, digest: str, body: str
) -> tuple[str, int]:
    gh = Path(args.gh)
    issue = find_open_issue(key, repository=args.repo, gh=gh, timeout=args.timeout)
    if issue is None:
        number = create_issue(
            title=args.title,
            body=body,
            repository=args.repo,
            gh=gh,
            timeout=args.timeout,
            who=args.who,
            team=args.team,
            role=args.role,
        )
        outcome = PUBLISHED
    else:
        number = int(issue["number"])
        previous, published_at = latest_digest(
            number, repository=args.repo, gh=gh, timeout=args.timeout
        )
        age = seconds_since(published_at)
        # An unreadable or absent publication time counts as stale. The two
        # ways to be wrong here are not symmetric: repeating an alarm is
        # noise, and withholding one is the defect this tool exists for.
        stale = args.repeat_after > 0 and (age is None or age >= args.repeat_after)
        if previous == digest and not stale:
            outcome = UNCHANGED
        else:
            comment_issue(
                number=number,
                body=body,
                repository=args.repo,
                gh=gh,
                timeout=args.timeout,
                who=args.who,
                team=args.team,
                role=args.role,
            )
            outcome = PUBLISHED
    if outcome == PUBLISHED:
        verify_published(
            number=number,
            digest=digest,
            repository=args.repo,
            gh=gh,
            timeout=args.timeout,
        )
    return outcome, number


def issue_document(
    number: int, *, repository: str, gh: Path, timeout: int
) -> dict:
    raw = run_gh(
        [
            "issue", "view", str(number), "--repo", repository,
            "--json", "body,createdAt,author",
        ],
        gh=gh,
        timeout=timeout,
    )
    try:
        value = json.loads(raw or "{}")
    except json.JSONDecodeError as error:
        raise GitHubUnavailable(f"issue view returned unreadable JSON: {error}") from error
    if not isinstance(value, dict):
        raise GitHubUnavailable("issue view returned a non-object JSON document")
    endpoint = f"repos/{repository}/issues/{number}/comments?per_page=100"
    raw_comments = run_gh(
        ["api", "--paginate", "--slurp", endpoint],
        gh=gh,
        timeout=timeout,
    )
    try:
        pages = json.loads(raw_comments or "[]")
    except json.JSONDecodeError as error:
        raise GitHubUnavailable(
            f"paginated issue comments returned unreadable JSON: {error}"
        ) from error
    if not isinstance(pages, list) or not all(isinstance(page, list) for page in pages):
        raise GitHubUnavailable("paginated issue comments returned an unexpected shape")
    value["comments"] = [
        {
            "body": comment.get("body") or "",
            "createdAt": comment.get("created_at") or comment.get("createdAt") or "",
            "author": comment.get("user") or comment.get("author") or {},
        }
        for page in pages
        for comment in page
        if isinstance(comment, dict)
    ]
    return value


def extract_part(text: str) -> dict | None:
    """Recognize only a complete machine document at its allowed position."""
    if text.startswith(PART_BEGIN):
        start = 0
    else:
        disclosure = RELAY_DISCLOSURE_RE.match(text)
        if disclosure is None or not text.startswith(PART_BEGIN, disclosure.end()):
            return None
        start = disclosure.end()
    if not text.startswith(PART_BEGIN, start):
        return None
    parsed = parse_part(text[start:])
    if parsed is None:
        raise PermanentGitHubFailure("published escalation part is malformed or truncated")
    return parsed


def github_part_groups(
    document: dict, *, key: str, trusted_author: str
) -> tuple[dict[str, dict[int, dict]], dict[str, str]]:
    entries: list[tuple[str, str]] = []
    if (
        ((document.get("author") or {}).get("login") or "").lower()
        == trusted_author.lower()
    ):
        entries.append((document.get("body") or "", document.get("createdAt") or ""))
    entries.extend(
        ((comment.get("body") or ""), (comment.get("createdAt") or ""))
        for comment in document.get("comments") or []
        if ((comment.get("author") or {}).get("login") or "").lower()
        == trusted_author.lower()
    )
    groups: dict[str, dict[int, dict]] = {}
    newest: dict[str, str] = {}
    for text, when in entries:
        part = extract_part(text)
        if part is None or part["escalation-key"] != key:
            continue
        event_id = part["escalation-event-id"]
        number = int(part["number"])
        existing = groups.setdefault(event_id, {}).get(number)
        if existing is not None and existing != part:
            raise PermanentGitHubFailure(
                f"event {event_id} has conflicting published part {number}"
            )
        groups[event_id][number] = part
        newest[event_id] = when or newest.get(event_id, "")
    return groups, newest


def complete_part_group(parts: dict[int, dict]) -> tuple[str, str] | None:
    if not parts:
        return None
    totals = {int(part["total"]) for part in parts.values()}
    payload_hashes = {part["escalation-payload-sha256"] for part in parts.values()}
    digests = {part["escalation-digest"] for part in parts.values()}
    if len(totals) != 1 or len(payload_hashes) != 1 or len(digests) != 1:
        raise PermanentSinkFailure("published event parts disagree on their manifest identity")
    total = totals.pop()
    if set(parts) != set(range(1, total + 1)):
        return None
    payload = "".join(parts[index]["payload"] for index in range(1, total + 1))
    payload_sha = hashlib.sha256(payload.encode("utf-8")).hexdigest()
    expected_sha = payload_hashes.pop()
    if payload_sha != expected_sha:
        raise PermanentSinkFailure(
            f"complete published part set reconstructs {payload_sha}, expected {expected_sha}"
        )
    return digests.pop(), expected_sha


def publish_github_event(args: argparse.Namespace, event: dict) -> tuple[str, int]:
    """Publish a durable event in independently verifiable, resumable parts."""
    expected = part_documents(event)
    gh = Path(args.gh)
    trusted_author = args.repo.split("/", 1)[0]
    issue = find_open_issue(event["key"], repository=args.repo, gh=gh, timeout=args.timeout)
    if issue is None:
        number = create_issue(
            title=event["title"], body=expected[0], repository=args.repo, gh=gh,
            timeout=args.timeout, who=args.who, team=args.team, role=args.role,
        )
    else:
        number = int(issue["number"])

    document = issue_document(number, repository=args.repo, gh=gh, timeout=args.timeout)
    groups, newest = github_part_groups(
        document, key=event["key"], trusted_author=trusted_author
    )
    current = groups.get(event["event_id"], {})
    if not current:
        for other_event_id, parts in groups.items():
            completed = complete_part_group(parts)
            if completed is None:
                raise PermanentGitHubFailure(
                    f"issue #{number} contains incomplete event {other_event_id}; "
                    f"refusing to overtake it with {event['event_id']}"
                )
        complete_candidates = [
            (newest.get(event_id, ""), complete_part_group(parts))
            for event_id, parts in groups.items()
        ]
        matching = [
            (when, complete) for when, complete in complete_candidates
            if complete is not None and complete[0] == event["normalized_sha256"]
        ]
        if matching:
            published_at, _identity = sorted(matching)[-1]
            age = seconds_since(published_at)
            stale = args.repeat_after > 0 and (age is None or age >= args.repeat_after)
            if not stale:
                return UNCHANGED, number

    for index, expected_document in enumerate(expected, 1):
        parsed_expected = parse_part(expected_document)
        assert parsed_expected is not None
        if index in current:
            if current[index] != parsed_expected:
                raise PermanentGitHubFailure(
                    f"event {event['event_id']} part {index} conflicts with durable payload"
                )
            continue
        # Part one is already the body after a successful create. If create had
        # an ambiguous result, the next invocation discovers it by key above.
        comment_issue(
            number=number, body=expected_document, repository=args.repo, gh=gh,
            timeout=args.timeout, who=args.who, team=args.team, role=args.role,
        )

    # One complete read-back verifies every part together. If a post above had
    # an ambiguous outcome, the next invocation performs this same scan first
    # and resumes at the first absent part without duplicating exact ones.
    final = issue_document(number, repository=args.repo, gh=gh, timeout=args.timeout)
    final_groups, _ = github_part_groups(
        final, key=event["key"], trusted_author=trusted_author
    )
    completed = complete_part_group(final_groups.get(event["event_id"], {}))
    wanted = (event["normalized_sha256"], event["payload_sha256"])
    if completed != wanted:
        raise GitHubUnavailable(
            f"complete read-back of issue #{number} found {completed!r}, expected {wanted!r}"
        )
    return PUBLISHED, number


# ---------------------------------------------------------------- taskgraph sink


def with_retry(action, *, attempts: int, pause: float = 2.0):
    """Retry only what waiting can fix.

    The whole operation is retried rather than the single failing command,
    because the sink is idempotent by construction: it looks the row up before
    it writes, so a second attempt after a partial first one finds the row and
    continues rather than filing a duplicate.
    """
    last: SinkUnavailable | None = None
    for attempt in range(max(1, attempts)):
        try:
            return action()
        except SinkUnavailable as error:
            last = error
            if not looks_transient(str(error)) or attempt == attempts - 1:
                raise
            time.sleep(pause)
    raise last  # unreachable; kept so the type is never Optional


def taskgraph_database(name: str) -> Path:
    """The exact database file this alarm belongs in.

    ⚠️ NAMED, NEVER INHERITED. Measured 2026-09-03 from a real scheduled service:
    with no TG_DB_PATH, `tg db current` answers "(no active database - using
    tasks)", while every coordinator and agent reads a different one. And the
    active-database marker is a single shared file that any `tg db create`
    rewrites for every headless caller on the box at once. A row filed into the
    wrong database is not a quieter alarm, it is an invisible one, which is the
    exact defect this tool exists to remove -- so an absent database REFUSES
    rather than falling back.
    """
    if "/" in name:
        # An explicit file. Named just as deliberately as a bare name, and the
        # form a test uses so it can exercise a real database without rewriting
        # the shared active-database marker every headless caller reads.
        path = Path(name)
    else:
        if not TG_DB_NAME_RE.match(name):
            raise TaskGraphUnavailable(
                f"database name {name!r} must match {TG_DB_NAME_RE.pattern}"
            )
        path = Path.home() / ".tg" / f"{name}.db"
    if not path.is_file():
        raise TaskGraphUnavailable(
            f"database {name!r} does not exist at {path}; refusing to file into "
            "whichever database this process would otherwise inherit"
        )
    return path


def tg_detail(text: str) -> str:
    """The readable part of a `tg` failure.

    tg reports errors as a boxed multi-line chain whose ROOT CAUSE is at the
    bottom, so a head-clamped copy stops at the framing and says "database ope"
    where it should say what actually went wrong. Keep the tail.
    """
    return bounded_detail(text, 500)


def looks_transient(message: str) -> bool:
    """A busy shared database is a condition to wait out, not a failure to report.

    hermit2 is written by every agent on this box at once, so `database is
    locked` says "try again in a moment", and reporting it as an undelivered
    alarm would be both wrong and, repeated hourly, the kind of false alarm that
    gets a channel muted.
    """
    lowered = message.lower()
    return "database is locked" in lowered or "database table is locked" in lowered


def run_tg(
    args: list[str], *, tg: str, database: str, db_path: Path, timeout: int,
    stdin_text: str | None = None,
) -> str:
    environment = dict(os.environ)
    # Both spellings, deliberately. `--db` covers tg's own subcommands; TG_DB_PATH
    # covers the helpers this sink shells out to, which take no --db and would
    # otherwise resolve the wrong database.
    environment["TG_DB_PATH"] = str(db_path)
    selector = [] if "/" in database else ["--db", database]
    try:
        completed = subprocess.run(
            [tg, *selector, *args],
            capture_output=True,
            text=True,
            input=stdin_text,
            timeout=timeout,
            check=False,
            env=environment,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise TaskGraphUnavailable(f"tg {' '.join(args[:2])}: {error}") from error
    if completed.returncode != 0:
        detail = tg_detail(completed.stderr or completed.stdout or "")
        raise TaskGraphUnavailable(
            f"tg {' '.join(args[:2])} exited {completed.returncode}: {detail}"
        )
    return completed.stdout


def tg_scalar(query: str, **kwargs) -> str | None:
    """One value from one row, or None.

    `tg sql` frames its output with a header, a rule, the rows, a blank line and
    a "(N rows)" trailer. Every query here selects a single column with no
    newlines in it, so the framing can be stripped positionally -- the same shape
    ci-hub/bin/tg-note-verified already relies on.
    """
    raw = run_tg(["sql", query], **kwargs)
    lines = raw.splitlines()
    body = [
        line
        for line in lines[2:]
        if line.strip() and not re.fullmatch(r"\(\d+ rows?\)", line.strip())
    ]
    if not body:
        return None
    return body[0].strip()


def task_key_predicate(key: str) -> str:
    """Match one complete marker line, not a key that merely has this prefix."""
    marker = f"{KEY_MARKER} {key}"
    return (
        f"(instr(description, '{marker}\n') > 0 OR "
        f"substr(description, -{len(marker)}) = '{marker}')"
    )


def find_open_task(key: str, **kwargs) -> str | None:
    """The open queue row carrying this key.

    BACKLOG and IN_PROGRESS both count as open. The live Hermit database creates
    new rows as BACKLOG; excluding that state made the post-create readback miss
    the row it had just filed, so every later tick filed another one. RESOLVED
    and CLOSED do not match, so a condition that comes back opens a fresh row
    rather than reviving a settled one.

    The historical failure left many unowned BACKLOG rows carrying the same key.
    Keep those rows as evidence and consistently update the newest one. A single
    claimed row wins over unowned rows because it already carries the ownership
    for this condition. More than one claimed row remains an error: choosing
    between two agents would silently corrupt the ownership picture. Once the
    selected row is closed, its newer terminal state keeps older duplicate
    evidence from being mistaken for a new occurrence.

    The key is constrained to lowercase letters, digits and hyphens by KEY_RE
    before it reaches here, so it cannot carry SQL syntax.
    """
    key_match = task_key_predicate(key)
    claimed = tg_scalar(
        "SELECT COUNT(*) FROM tasks WHERE status='IN_PROGRESS' "
        f"AND {key_match}",
        **kwargs,
    )
    if claimed is None or not claimed.isdigit():
        raise TaskGraphUnavailable(
            f"could not determine how many claimed queue rows carry key {key!r}"
        )
    if int(claimed) > 1:
        raise TaskGraphUnavailable(
            f"key {key!r} matches {claimed} claimed queue rows; refusing to choose "
            "between multiple owners"
        )
    selected = tg_scalar(
        "SELECT status || ' ' || local_id FROM tasks "
        f"WHERE {key_match} "
        "ORDER BY CASE status WHEN 'IN_PROGRESS' THEN 0 ELSE 1 END, "
        "created_at DESC, local_id DESC LIMIT 1",
        **kwargs,
    )
    if selected is None:
        return None
    try:
        status, local_id = selected.split(" ", 1)
    except ValueError as error:
        raise TaskGraphUnavailable(
            f"could not read the selected queue row for key {key!r}: {selected!r}"
        ) from error
    if status in ACTIVE_TASK_STATUSES:
        return local_id
    if status in TERMINAL_TASK_STATUSES:
        return None
    raise TaskGraphUnavailable(
        f"queue row {local_id} for key {key!r} has unknown status {status!r}"
    )


def latest_task_digest(local_id: str, **kwargs) -> tuple[str | None, str | None]:
    where = (
        f"FROM task_notes WHERE task_id='{local_id}' "
        f"AND content LIKE '%{DIGEST_MARKER} %' ORDER BY created_at DESC LIMIT 1"
    )
    digest = tg_scalar(
        f"SELECT substr(content, instr(content, '{DIGEST_MARKER} ') + "
        f"{len(DIGEST_MARKER) + 1}, 12) {where}",
        **kwargs,
    )
    when = tg_scalar(f"SELECT created_at {where}", **kwargs)
    if digest is not None and not re.fullmatch(r"[0-9a-f]{12}", digest):
        digest = None
    return digest, when


def create_task(
    *, title: str, description: str, key: str, args: argparse.Namespace, **kwargs
) -> str:
    """File the row, then read it back by key.

    ⚠️ `tg add` DOES NOT DEDUPLICATE. Measured 2026-09-03: adding the same title
    twice produced a second row with a suffixed identifier, silently, and
    auto-attached it to the first. Callers must look the row up first -- which
    find_open_task does -- because the command will happily give you two.

    The row is left UNOWNED. An alarm nobody has picked up must be claimable by
    the next coordinator or agent; claiming it here would file work and
    immediately mark it as somebody's.
    """
    run_tg(
        [
            "add",
            title,
            "--impact",
            str(args.tg_impact),
            "--effort",
            str(args.tg_effort),
            "--tags",
            args.tg_tags,
            "--priority",
            args.tg_priority,
            "--blocks",
            args.tg_blocks,
            "--description",
            description,
        ],
        **kwargs,
    )
    local_id = find_open_task(key, **kwargs)
    if local_id is None:
        raise TaskGraphUnavailable(
            f"filed a queue row for key {key!r} but reading it back found nothing"
        )
    return local_id


def append_task_note(local_id: str, body: str, *, args: argparse.Namespace, db_path: Path) -> None:
    """Through ci-hub/bin/tg-note-verified, which reads the note back and compares.

    Not `tg note` directly: the PATH shim refuses inline note content because the
    shell substitutes before tg ever sees it, and the verified path is the
    supported way through. It takes no --db, so the database is named in its
    environment.

    ON STDIN, NOT --file. tg-note-verified refuses an unnamespaced staging path
    under a shared directory, because two agents that pick the same filename can
    swap contents between the write and the read and it would then verify
    SOMEONE ELSE'S text as yours. Its own answer is that stdin has no file to
    race, so there is nothing to namespace and nothing to clean up.
    """
    environment = dict(os.environ)
    environment["TG_DB_PATH"] = str(db_path)
    try:
        completed = subprocess.run(
            [args.tg_note_verified, local_id],
            input=body,
            capture_output=True,
            text=True,
            timeout=args.timeout,
            check=False,
            env=environment,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise TaskGraphUnavailable(f"tg-note-verified: {error}") from error
    if completed.returncode != 0:
        detail = tg_detail(completed.stderr or completed.stdout or "")
        raise TaskGraphUnavailable(f"tg-note-verified exited {completed.returncode}: {detail}")


def publish_taskgraph(
    args: argparse.Namespace, key: str, digest: str, body: str
) -> tuple[str, str]:
    database = args.tg_db
    db_path = taskgraph_database(database)
    common = {
        "tg": args.tg,
        "database": database,
        "db_path": db_path,
        "timeout": args.timeout,
    }
    local_id = find_open_task(key, **common)
    if local_id is None:
        local_id = create_task(
            title=args.title,
            description=f"{body}",
            key=key,
            args=args,
            **common,
        )
        append_task_note(local_id, body, args=args, db_path=db_path)
        outcome = PUBLISHED
    else:
        previous, noted_at = latest_task_digest(local_id, **common)
        age = seconds_since(noted_at)
        stale = args.repeat_after > 0 and (age is None or age >= args.repeat_after)
        if previous == digest and not stale:
            return UNCHANGED, local_id
        append_task_note(local_id, body, args=args, db_path=db_path)
        outcome = PUBLISHED
    seen, _when = latest_task_digest(local_id, **common)
    if seen != digest:
        raise TaskGraphUnavailable(
            f"read-back of queue row {local_id} found latest digest {seen!r}, "
            f"expected {digest!r}"
        )
    return outcome, local_id


def sqlite_task(db_path: Path, local_id: str) -> tuple[str, str] | None:
    try:
        with sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=5) as connection:
            row = connection.execute(
                "SELECT status, description FROM tasks WHERE local_id=?", (local_id,)
            ).fetchone()
    except sqlite3.Error as error:
        raise TaskGraphUnavailable(f"read-back of queue row {local_id}: {error}") from error
    if row is None:
        return None
    return str(row[0]), str(row[1] or "")


def sqlite_notes(db_path: Path, local_id: str) -> list[tuple[str, str]]:
    try:
        with sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=5) as connection:
            rows = connection.execute(
                "SELECT content, created_at FROM task_notes WHERE task_id=? "
                "ORDER BY created_at, id",
                (local_id,),
            ).fetchall()
    except sqlite3.Error as error:
        raise TaskGraphUnavailable(f"read-back of queue notes on {local_id}: {error}") from error
    return [(str(content), str(created_at)) for content, created_at in rows]


def taskgraph_part_groups(
    notes: list[tuple[str, str]], *, key: str
) -> tuple[dict[str, dict[int, dict]], dict[str, str]]:
    groups: dict[str, dict[int, dict]] = {}
    newest: dict[str, str] = {}
    for content, when in notes:
        part = parse_part(content)
        if part is None and content.startswith(PART_BEGIN):
            raise PermanentTaskGraphFailure(
                "queue row contains a malformed or truncated v1 escalation part"
            )
        if part is None or part["escalation-key"] != key:
            continue
        event_id = part["escalation-event-id"]
        number = int(part["number"])
        existing = groups.setdefault(event_id, {}).get(number)
        if existing is not None and existing != part:
            raise PermanentTaskGraphFailure(
                f"queue event {event_id} has conflicting part {number}"
            )
        groups[event_id][number] = part
        newest[event_id] = when
    return groups, newest


def import_ops(
    ops: list[dict], *, args: argparse.Namespace, common: dict[str, object]
) -> None:
    if "/" in args.tg_db:
        raise PermanentTaskGraphFailure(
            "event publication requires a named TaskGraph database because tg import "
            "requires an explicit --db selector"
        )
    payload = json.dumps({"ops": ops}, ensure_ascii=False, separators=(",", ":"))
    run_tg(["import", "--from-file", "-"], stdin_text=payload, **common)


def create_event_task(
    *, args: argparse.Namespace, event: dict, local_id: str,
    common: dict[str, object], db_path: Path,
) -> None:
    marker = (
        f"{KEY_MARKER} {event['key']}\n"
        f"escalation-event-id: {event['event_id']}\n"
        f"escalation-origin-host: {event['origin_host']}\n"
        f"escalation-payload-sha256: {event['payload_sha256']}\n"
        f"{DIGEST_MARKER} {event['normalized_sha256']}"
    )
    existing = sqlite_task(db_path, local_id)
    if existing is not None:
        if marker not in existing[1]:
            raise PermanentTaskGraphFailure(
                f"stable queue id {local_id} already exists with a different event identity"
            )
        if existing[0] not in ACTIVE_TASK_STATUSES:
            raise PermanentTaskGraphFailure(
                f"stable queue id {local_id} exists in terminal state {existing[0]}; "
                "refusing to append after closure"
            )
        return
    create = {
        "id": local_id,
        "title": event["title"],
        "impact": args.tg_impact,
        "effort": args.tg_effort,
        "tags": [tag for tag in args.tg_tags.split(",") if tag],
        "description": marker,
        "blocks": args.tg_blocks,
        "priority": args.tg_priority,
        "status": "open",
    }
    import_ops([{"create": create}], args=args, common=common)
    readback = sqlite_task(db_path, local_id)
    if readback is None or marker not in readback[1]:
        raise TaskGraphUnavailable(
            f"imported stable queue row {local_id} but exact identity read-back failed"
        )


def publish_taskgraph_event(args: argparse.Namespace, event: dict) -> tuple[str, str]:
    database = args.tg_db
    db_path = taskgraph_database(database)
    common: dict[str, object] = {
        "tg": args.tg, "database": database, "db_path": db_path,
        "timeout": args.timeout,
    }
    local_id = find_open_task(event["key"], **common)
    if local_id is None:
        local_id = stable_task_id(event)
        create_event_task(
            args=args, event=event, local_id=local_id, common=common, db_path=db_path
        )

    notes = sqlite_notes(db_path, local_id)
    groups, newest = taskgraph_part_groups(notes, key=event["key"])
    current = groups.get(event["event_id"], {})
    if not current:
        for other_event_id, parts in groups.items():
            if complete_part_group(parts) is None:
                raise PermanentTaskGraphFailure(
                    f"queue row {local_id} contains incomplete event {other_event_id}; "
                    f"refusing to overtake it with {event['event_id']}"
                )
        matches = [
            (newest.get(event_id, ""), complete_part_group(parts))
            for event_id, parts in groups.items()
        ]
        matches = [
            (when, identity) for when, identity in matches
            if identity is not None and identity[0] == event["normalized_sha256"]
        ]
        if matches:
            noted_at, _identity = sorted(matches)[-1]
            age = seconds_since(noted_at)
            stale = args.repeat_after > 0 and (age is None or age >= args.repeat_after)
            if not stale:
                return UNCHANGED, local_id

    expected = part_documents(event)
    for index, document in enumerate(expected, 1):
        notes = sqlite_notes(db_path, local_id)
        groups, _ = taskgraph_part_groups(notes, key=event["key"])
        current = groups.get(event["event_id"], {})
        parsed_expected = parse_part(document)
        assert parsed_expected is not None
        if index in current:
            if current[index] != parsed_expected:
                raise PermanentTaskGraphFailure(
                    f"event {event['event_id']} part {index} conflicts with durable payload"
                )
            continue
        import_ops(
            [{"note": {"id": local_id, "message": document}}],
            args=args,
            common=common,
        )
        read_groups, _ = taskgraph_part_groups(
            sqlite_notes(db_path, local_id), key=event["key"]
        )
        if read_groups.get(event["event_id"], {}).get(index) != parsed_expected:
            raise TaskGraphUnavailable(
                f"exact read-back of queue row {local_id} did not contain event "
                f"{event['event_id']} part {index}/{len(expected)}"
            )

    final_groups, _ = taskgraph_part_groups(
        sqlite_notes(db_path, local_id), key=event["key"]
    )
    completed = complete_part_group(final_groups.get(event["event_id"], {}))
    wanted = (event["normalized_sha256"], event["payload_sha256"])
    if completed != wanted:
        raise TaskGraphUnavailable(
            f"complete read-back of queue row {local_id} found {completed!r}, "
            f"expected {wanted!r}"
        )
    return PUBLISHED, local_id


def resolve_taskgraph(args: argparse.Namespace) -> tuple[str, str]:
    """Close this key's queue row through the supported verifier.

    Not `tg update --status closed`: the PATH shim refuses that because a task
    closed without evidence leaves ready, active and the drain in one step and no
    later audit can tell a settled alarm from an abandoned one.
    """
    database = args.tg_db
    db_path = taskgraph_database(database)
    common = {
        "tg": args.tg,
        "database": database,
        "db_path": db_path,
        "timeout": args.timeout,
    }
    local_id = find_open_task(args.key, **common)
    if local_id is None:
        return NOTHING_OPEN, ""
    environment = dict(os.environ)
    environment["TG_DB_PATH"] = str(db_path)
    disposition = (
        f"no longer reported by the {args.key} check as of {now_utc()}; a "
        "recurrence files a new row under the same key"
    )
    try:
        completed = subprocess.run(
            [args.close_task, local_id, "--disposition", disposition],
            capture_output=True,
            text=True,
            timeout=args.timeout,
            check=False,
            env=environment,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise TaskGraphUnavailable(f"close-task: {error}") from error
    if completed.returncode != 0:
        detail = tg_detail(completed.stderr or completed.stdout or "")
        raise TaskGraphUnavailable(f"close-task exited {completed.returncode}: {detail}")
    still_open = find_open_task(args.key, **common)
    if still_open is not None:
        raise TaskGraphUnavailable(
            f"read-back still shows queue row {still_open} open for key {args.key!r}"
        )
    return RESOLVED, local_id


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    # Not `required=True`: --self-test must be runnable with no other argument,
    # so that a harness can check this tool without composing an alarm. main()
    # enforces both for every real publication.
    parser.add_argument(
        "--key",
        help="stable identifier for this alarm; one open issue is kept per key",
    )
    parser.add_argument("--title", help="issue title, one line of prose")
    parser.add_argument("--repo", default=DEFAULT_REPOSITORY, help="owner/name to publish to")
    parser.add_argument(
        "--message-file",
        type=Path,
        help="read the alarm from this file instead of standard input",
    )
    parser.add_argument(
        "--event-file",
        type=Path,
        help=(
            "publish one durable schema-v1 health event; its key, host, kind, "
            "title and payload identity come only from the envelope"
        ),
    )
    parser.add_argument("--log-file", type=Path, default=DEFAULT_LOG)
    parser.add_argument(
        "--repeat-after",
        type=int,
        default=DEFAULT_REPEAT_AFTER_SECONDS,
        help=(
            "re-say an unchanged alarm after this many seconds so a persistent "
            "condition does not go silent; 0 never repeats (default: %(default)s)"
        ),
    )
    parser.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT_SECONDS)
    parser.add_argument(
        "--gh",
        default=str(ROOT / "ci-hub/bin/gh"),
        help="the attributed GitHub boundary to write through (default: %(default)s)",
    )
    parser.add_argument(
        "--who",
        default=os.environ.get("DG_AGENT_NAME", ""),
        help="resolved agent name for the disclosure prefix (default: $DG_AGENT_NAME)",
    )
    parser.add_argument("--team", default="hermit2")
    parser.add_argument("--role", default="relay")
    parser.add_argument(
        "--sink",
        action="append",
        choices=SINKS,
        default=[],
        help=(
            "where to publish (repeatable). `github` is off this host and covers "
            "the coordinator being ABSENT; `taskgraph` files a row in the work "
            "queue and covers the coordinator being PRESENT AND NOT LOOKING. They "
            "are not substitutes: when Orc is down nobody reads the queue either. "
            "Default: github"
        ),
    )
    parser.add_argument(
        "--tg",
        default="tg",
        help="the TaskGraph command (default: %(default)s)",
    )
    parser.add_argument(
        "--tg-db",
        default=DEFAULT_TG_DATABASE,
        help=(
            "the database to file into, named rather than inherited. A scheduled "
            "service resolves a DIFFERENT database from the one coordinators read, "
            "so this is not optional and an absent database refuses "
            "(default: %(default)s)"
        ),
    )
    parser.add_argument(
        "--tg-blocks",
        default=DEFAULT_TG_BLOCKS,
        help="the goal the filed row blocks (default: %(default)s)",
    )
    parser.add_argument(
        "--tg-attempts",
        type=int,
        default=3,
        help=(
            "how many times to retry a BUSY shared database before reporting the "
            "alarm undelivered; other failures are never retried (default: %(default)s)"
        ),
    )
    parser.add_argument("--tg-impact", type=int, default=60)
    parser.add_argument("--tg-effort", type=int, default=1)
    parser.add_argument("--tg-tags", default="monitoring,tick")
    parser.add_argument("--tg-priority", default="P1")
    parser.add_argument(
        "--tg-note-verified",
        default=str(ROOT / "ci-hub/bin/tg-note-verified"),
        help="the verified note path this sink appends through (default: %(default)s)",
    )
    parser.add_argument(
        "--close-task",
        default=str(ROOT / "ci-hub/bin/close-task"),
        help="the closure verifier this sink closes through (default: %(default)s)",
    )
    parser.add_argument(
        "--digest-ignore",
        action="append",
        default=[],
        metavar="REGEX",
        help=(
            "text that changes on every run and must not count as a change "
            "(repeatable). Affects change detection only; the published text is "
            "always verbatim"
        ),
    )
    parser.add_argument(
        "--resolve",
        action="store_true",
        help=(
            "the condition is no longer reported: comment and close this key's "
            "open issue, so the issue list says what is true now"
        ),
    )
    parser.add_argument(
        "--self-test",
        action="store_true",
        help="check the parts that need no network, then exit",
    )
    return parser


def self_test() -> int:
    """Cover the decisions that do not need GitHub. Reaches no repository."""
    failures: list[str] = []

    def check(name: str, condition: bool) -> None:
        if not condition:
            failures.append(name)

    check("digest is stable", digest_of("a") == digest_of("a"))
    check("digest separates content", digest_of("a") != digest_of("b"))
    check("digest is twelve hex", re.fullmatch(r"[0-9a-f]{12}", digest_of("a")) is not None)

    block = marker_block("health-tick-staleness", digest_of("x"), "2026-01-01T00:00:00Z")
    found = DIGEST_RE.findall(block)
    check("digest marker round-trips", found == [digest_of("x")])
    check("key marker is present", f"{KEY_MARKER} health-tick-staleness" in block)

    two = block + "\n" + marker_block("k", "0123456789ab", "2026-01-01T00:00:00Z")
    check("last digest wins", DIGEST_RE.findall(two)[-1] == "0123456789ab")

    check("key grammar accepts a normal key", KEY_RE.match("operational-tick-findings") is not None)
    check("key grammar rejects spaces", KEY_RE.match("two words") is None)
    check("key grammar rejects uppercase", KEY_RE.match("Key") is None)
    check("key grammar rejects a leading dash", KEY_RE.match("-key") is None)

    stamped_a = 'ACTION: x title="y observed_at=2026-01-01T00:00:00Z"'
    stamped_b = 'ACTION: x title="y observed_at=2026-06-01T00:00:00Z"'
    ignore = (r"observed_at=[0-9TZ:+-]+",)
    check("volatile text still changes the digest by default", digest_of(stamped_a) != digest_of(stamped_b))
    check(
        "an ignored pattern makes the two compare equal",
        digest_of(stamped_a, ignore) == digest_of(stamped_b, ignore),
    )
    check(
        "an ignored pattern does not hide a real change",
        digest_of(stamped_a, ignore) != digest_of(stamped_a.replace("ACTION: x", "ACTION: z"), ignore),
    )

    check("no timestamp is not fresh", seconds_since(None) is None)
    check("a bad timestamp is not fresh", seconds_since("not-a-time") is None)
    aged = seconds_since("2000-01-01T00:00:00Z")
    check("an old timestamp is old", aged is not None and aged > 86400)

    for name in failures:
        print(f"escalate self-test FAIL: {name}", file=sys.stderr)
    total = 16
    print(f"escalate self-test: {total - len(failures)}/{total} checks passed")
    return 1 if failures else 0


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.self_test:
        return self_test()
    # argparse cannot express "default to one element" for an appending option
    # without that default surviving alongside anything the caller supplies.
    if not args.sink:
        args.sink = [GITHUB]
    else:
        args.sink = list(dict.fromkeys(args.sink))
    args.event = None
    if args.event_file is not None:
        conflicting = []
        for name, value in (
            ("--key", args.key), ("--title", args.title),
            ("--message-file", args.message_file), ("--resolve", args.resolve),
        ):
            if value:
                conflicting.append(name)
        if args.digest_ignore:
            conflicting.append("--digest-ignore")
        if conflicting:
            print(
                "escalate: REFUSED: --event-file owns delivery identity and cannot be "
                "combined with " + ", ".join(conflicting),
                file=sys.stderr,
            )
            return 2
        try:
            args.event = load_event(args.event_file)
        except InvalidEvent as error:
            print(f"escalate: REFUSED: permanent invalid event envelope: {error}", file=sys.stderr)
            return 78
        args.key = args.event["key"]
        args.title = args.event["title"]
        args.resolve = args.event["kind"] == "resolve"
        args.digest_ignore = list(args.event["digest_ignore"])

    required = ("key",) if args.resolve else ("key", "title")
    missing = [name for name in required if not getattr(args, name)]
    if missing:
        print(
            "escalate: REFUSED: " + ", ".join(f"--{name}" for name in missing) + " is required",
            file=sys.stderr,
        )
        return 2
    if not args.who:
        print(
            "escalate: REFUSED: --who is required (or set DG_AGENT_NAME); an "
            "unattributed issue is indistinguishable from one the owner wrote",
            file=sys.stderr,
        )
        return 2
    if not KEY_RE.match(args.key):
        print(
            f"escalate: REFUSED: --key must match {KEY_RE.pattern}; got {args.key!r}",
            file=sys.stderr,
        )
        return 2
    if args.resolve:
        return resolve(args)
    if args.event is not None:
        message = args.event["payload"]
    elif args.message_file is not None:
        try:
            message = args.message_file.read_text(encoding="utf-8")
        except OSError as error:
            print(f"escalate: REFUSED: cannot read {args.message_file}: {error}", file=sys.stderr)
            return 2
    else:
        message = sys.stdin.read()
    return escalate(args, message)


if __name__ == "__main__":
    raise SystemExit(main())
