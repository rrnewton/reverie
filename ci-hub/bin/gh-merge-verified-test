#!/usr/bin/env python3
"""Self-test for `gh-merge-verified`, built around the case it must REFUSE.

WHY THIS EXISTS
---------------
A verifier that has only ever been run against a merge that SUCCEEDED has not
been shown to do anything. On 2026-08-25 four gates passed review in exactly
that state -- each had seen only the passing case -- and two of them were later
found to report nothing while reading as passing.

So the load-bearing cases here are the REFUSALS. `test_arrived` exists to prove
the tool is not simply refusing everything, which a refusal-only suite would
also pass.

HERMETIC AND OFFLINE. Every case builds throwaway git repositories under a
temporary directory and points the tool at them through
`GH_MERGE_VERIFIED_REMOTE`. Nothing here reaches GitHub, so it runs on a
proxy-blocked box -- which is the same property that made `gh-merge-verified`
the tool that was kept.

`gh` IS REPLACED BY A TRIPWIRE that records any invocation and exits non-zero.
Verification is supposed to be pure git; if a future edit reaches for the API,
`test_verify_only_never_calls_gh` fails rather than the property quietly
decaying.

    ci-hub/bin/gh-merge-verified-test

Exits 0 when every case matches its expectation, 1 otherwise.
"""

from __future__ import annotations

import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from unittest import mock

TOOL = Path(__file__).resolve().parent / "gh-merge-verified"

FAILURES: list[str] = []


def run(args: list[str], cwd: Path, env: dict[str, str] | None = None) -> tuple[int, str]:
    p = subprocess.run(
        args, cwd=cwd, capture_output=True, text=True, env=env
    )
    return p.returncode, p.stdout + p.stderr


def git(cwd: Path, *args: str) -> None:
    p = subprocess.run(
        ["git", *args],
        cwd=cwd,
        capture_output=True,
        text=True,
        env={
            **os.environ,
            "GIT_AUTHOR_NAME": "t",
            "GIT_AUTHOR_EMAIL": "t@example.invalid",
            "GIT_COMMITTER_NAME": "t",
            "GIT_COMMITTER_EMAIL": "t@example.invalid",
        },
    )
    if p.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)} failed: {p.stderr.strip()}")


def git_output(cwd: Path, *args: str) -> str:
    p = subprocess.run(
        ["git", *args],
        cwd=cwd,
        capture_output=True,
        text=True,
        env={
            **os.environ,
            "GIT_AUTHOR_NAME": "t",
            "GIT_AUTHOR_EMAIL": "t@example.invalid",
            "GIT_COMMITTER_NAME": "t",
            "GIT_COMMITTER_EMAIL": "t@example.invalid",
        },
    )
    if p.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)} failed: {p.stderr.strip()}")
    return p.stdout.strip()


def build_fixture(root: Path, landed: str) -> tuple[Path, Path]:
    """Build a remote carrying a base, a `refs/pull/1/head`, and a main branch.

    `landed` chooses what main holds for the changed file, which is exactly the
    three-way distinction the tool draws:

        "arrived"   main holds the branch's content
        "absent"    main still holds the base content
        "moved_on"  main holds something else entirely
    """
    origin = root / "origin"
    origin.mkdir()
    git(origin, "init", "--quiet", "--initial-branch=main", ".")
    (origin / "tracked.txt").write_text("base content\n")
    git(origin, "add", "tracked.txt")
    git(origin, "commit", "--quiet", "-m", "base")

    git(origin, "checkout", "--quiet", "-b", "feature")
    (origin / "tracked.txt").write_text("branch content\n")
    git(origin, "commit", "--quiet", "-am", "branch change")
    # Publish the branch tip where the tool looks for it.
    git(origin, "update-ref", "refs/pull/1/head", "refs/heads/feature")

    git(origin, "checkout", "--quiet", "main")
    if landed == "arrived":
        # A squash landing: same content, different sha. This is the case a
        # sha or ancestry comparison gets WRONG and content-identity gets right.
        (origin / "tracked.txt").write_text("branch content\n")
        git(origin, "commit", "--quiet", "-am", "squashed landing")
    elif landed == "moved_on":
        (origin / "tracked.txt").write_text("something else entirely\n")
        git(origin, "commit", "--quiet", "-am", "unrelated edit")
    elif landed != "absent":
        raise ValueError(landed)

    # The tool runs git from the caller's cwd; give it a real checkout to sit in.
    work = root / "work"
    subprocess.run(
        ["git", "clone", "--quiet", str(origin), str(work)],
        check=True,
        capture_output=True,
    )
    return origin, work


def tripwire_dir(root: Path) -> tuple[Path, Path]:
    """A `gh` that records any call and refuses, so an API reach cannot pass."""
    bindir = root / "trap"
    bindir.mkdir()
    log = bindir / "calls.log"
    gh = bindir / "gh"
    gh.write_text(
        "#!/bin/bash\n"
        f'echo "gh $*" >> "{log}"\n'
        "exit 99\n"
    )
    gh.chmod(0o755)
    log.write_text("")
    return bindir, log


def build_tool_fixture(root: Path) -> Path:
    """A dev-hermit origin whose main has the reviewed verifier and dependencies."""
    source_root = TOOL.parents[2]
    origin = root / "tool-origin"
    origin.mkdir()
    git(origin, "init", "--quiet", "--initial-branch=main", ".")
    for relative in (
        "ci-hub/bin/gh-merge-verified",
        "ci-hub/health/approval_binding.py",
        "ci-hub/lib/bounded_capture.py",
        "ci-hub/lib/ops_state.py",
        "ci-hub/validate/gh_route.py",
    ):
        destination = origin / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source_root / relative, destination)
    git(origin, "add", "ci-hub")
    git(origin, "commit", "--quiet", "-m", "reviewed verifier on main")

    work = root / "tool-work"
    subprocess.run(
        ["git", "clone", "--quiet", str(origin), str(work)],
        check=True,
        capture_output=True,
    )
    candidate = work / "ci-hub/bin/gh-merge-verified"
    with candidate.open("a") as output:
        output.write("\n# unreviewed working-tree change\n")
    return candidate


def merge_stub_dir(root: Path, target_origin: Path, landed_commit: str) -> tuple[Path, Path]:
    """A `gh` that answers admission reads and advances main on merge."""
    bindir = root / "merge-bin"
    bindir.mkdir()
    log = bindir / "calls.log"
    log.write_text("")
    gh = bindir / "gh"
    review_head = git_output(target_origin, "rev-parse", "refs/pull/1/head")
    issue_comments = json.dumps(
        [
            [
                {
                    "id": 900001,
                    "url": "https://github.com/fixture/repo/pull/1#issuecomment-900001",
                    "user": {"login": "fixture-reviewer"},
                    "body": f"APPROVED-AT: codex {review_head}",
                    "created_at": "2026-09-05T00:00:01Z",
                    "updated_at": "2026-09-05T00:00:01Z",
                }
            ]
        ]
    )
    permission = json.dumps(
        {"permission": "write", "user": {"login": "fixture-reviewer"}}
    )
    gh.write_text(
        "#!/bin/bash\n"
        f'echo "gh $*" >> "{log}"\n'
        "if [ \"$1\" = pr ] && [ \"$2\" = view ]; then\n"
        "  echo '{\"comments\":[],\"reviews\":[],\"labels\":[],\"state\":\"OPEN\"}'\n"
        "  exit 0\n"
        "fi\n"
        "if [ \"$1\" = api ] && [ \"$2\" = graphql ]; then\n"
        "  echo '[{\"data\":{\"repository\":{\"pullRequest\":{\"reviews\":{\"nodes\":[],\"pageInfo\":{\"hasNextPage\":false,\"endCursor\":null}}}}}}]'\n"
        "  exit 0\n"
        "fi\n"
        "if [ \"$1\" = api ] && [[ \"$*\" == *\"/collaborators/\"* ]]; then\n"
        f"  echo '{permission}'\n"
        "  exit 0\n"
        "fi\n"
        "if [ \"$1\" = api ] && [[ \"$*\" == *\"/issues/\"* ]]; then\n"
        f"  echo '{issue_comments}'\n"
        "  exit 0\n"
        "fi\n"
        "if [ \"$1\" = api ]; then\n"
        "  echo '[[]]'\n"
        "  exit 0\n"
        "fi\n"
        f'git -C "{target_origin}" update-ref refs/heads/main "{landed_commit}"\n'
    )
    gh.chmod(0o755)
    with_proxy = bindir / "with-proxy"
    with_proxy.write_text('#!/bin/sh\nexec "$@"\n')
    with_proxy.chmod(0o755)
    return bindir, log


def check(name: str, condition: bool, detail: str) -> None:
    if condition:
        print(f"  OK   {name}")
    else:
        FAILURES.append(name)
        print(f"  FAIL {name}: {detail}", file=sys.stderr)


def case(landed: str, expect_code: int, expect_text: str, name: str) -> None:
    with tempfile.TemporaryDirectory(prefix="gh-merge-verified-test-") as tmp:
        root = Path(tmp)
        origin, work = build_fixture(root, landed)
        bindir, log = tripwire_dir(root)
        env = {
            **os.environ,
            "FLEET_REAL_GH": str(bindir / "gh"),
            "PATH": f"{bindir}:{os.environ.get('PATH', '')}",
            "GH_MERGE_VERIFIED_REMOTE": str(origin),
        }
        code, out = run(
            [sys.executable, str(TOOL), "1", "--repo", "fixture/repo", "--verify-only"],
            cwd=work,
            env=env,
        )
        check(
            f"{name}: exit {expect_code}",
            code == expect_code,
            f"got exit {code}\n{out}",
        )
        check(
            f"{name}: says {expect_text!r}",
            expect_text in out,
            f"output did not contain {expect_text!r}\n{out}",
        )
        check(
            f"{name}: verify-only made no gh call",
            log.read_text().strip() == "",
            f"gh was invoked: {log.read_text().strip()}",
        )


def tree_content_cases() -> None:
    """Verify deletions, literal path names, modes, and failed Git reads."""
    unusual = "nested/[*]\tline\rbreak\n.txt"
    # Values contain the file bytes and executable bit; omitted paths are absent.
    old = ("base\n", False)
    new = ("head\n", False)
    cases = (
        ("deletion arrived", {"gone": old}, {}, {}, 0, ["gone"], [], []),
        ("deletion absent", {"gone": old}, {}, {"gone": old}, 3, [], ["gone"], []),
        ("deleted path replaced", {"gone": old}, {}, {"gone": new}, 3, [], [], ["gone"]),
        ("addition absent", {}, {"new": new}, {}, 3, [], ["new"], []),
        ("literal path arrived", {unusual: old}, {unusual: new}, {unusual: new},
         0, [unusual], [], []),
        ("mode change absent", {"script": old}, {"script": (old[0], True)},
         {"script": old}, 3, [], ["script"], []),
        ("mode change arrived", {"script": old}, {"script": (old[0], True)},
         {"script": (old[0], True)}, 0, ["script"], [], []),
        ("rename retained source", {"old.txt": old}, {"new.txt": old},
         {"old.txt": old, "new.txt": old}, 3, ["new.txt"], ["old.txt"], []),
    )
    for name, base_files, head_files, main_files, expected, arrived, absent, moved in cases:
        with tempfile.TemporaryDirectory(prefix="gh-merge-verified-content-") as tmp:
            root = Path(tmp)
            origin = root / "origin"
            origin.mkdir()
            git(origin, "init", "--quiet", "--initial-branch=main", ".")
            git(origin, "config", "core.fileMode", "true")
            git(origin, "config", "diff.renames", "true")
            paths = set(base_files) | set(head_files) | set(main_files)

            def commit_files(files: dict, message: str) -> None:
                for name in paths:
                    path = origin / name
                    if name in files:
                        content, executable = files[name]
                        path.parent.mkdir(parents=True, exist_ok=True)
                        path.write_text(content)
                        path.chmod(0o755 if executable else 0o644)
                    elif path.exists():
                        path.unlink()
                git(origin, "add", "--all")
                git(origin, "commit", "--quiet", "--allow-empty", "-m", message)

            commit_files(base_files, "base")
            git(origin, "checkout", "--quiet", "-b", "feature")
            commit_files(head_files, "branch")
            head = git_output(origin, "rev-parse", "HEAD")
            git(origin, "update-ref", "refs/pull/1/head", head)
            git(origin, "checkout", "--quiet", "main")
            commit_files(main_files, "independent main")
            work = root / "work"
            subprocess.run(["git", "clone", "--quiet", str(origin), str(work)],
                           check=True, capture_output=True)
            bindir, log = tripwire_dir(root)
            receipt = root / "receipt.json"
            env = {
                **os.environ,
                "FLEET_REAL_GH": str(bindir / "gh"),
            "PATH": f"{bindir}:{os.environ.get('PATH', '')}",
                "GH_MERGE_VERIFIED_REMOTE": str(origin),
            }
            code, out = run(
                [sys.executable, str(TOOL), "1", "--repo", "fixture/repo", "--verify-only",
                 "--expect-head", head, "--receipt", str(receipt)], cwd=work, env=env,
            )
            check(f"{name}: exit {expected}", code == expected, f"exit {code}\n{out}")
            record = json.loads(receipt.read_text()) if receipt.exists() else {}
            for field, wanted in (("arrived", arrived), ("absent", absent), ("moved_on", moved),
                                  ("files", sorted(arrived + absent + moved))):
                check(f"{name}: exact {field}", record.get(field) == sorted(wanted),
                      f"expected {wanted!r}, got {record.get(field)!r}\n{out}")
            check(f"{name}: no gh call", log.read_text() == "", log.read_text())

    for failing_command in ("ls-tree", "diff"):
        with tempfile.TemporaryDirectory(prefix="gh-merge-verified-read-failure-") as tmp:
            root = Path(tmp)
            origin, work = build_fixture(root, "arrived")
            bindir, log = tripwire_dir(root)
            git_wrapper = bindir / "git"
            git_wrapper.write_text(
                f"#!{sys.executable}\nimport os, sys\n"
                f"if {failing_command!r} in sys.argv[1:]:\n"
                "    print('injected Git read failure', file=sys.stderr)\n"
                "    sys.exit(66)\n"
                f"os.execv({shutil.which('git')!r}, ['git', *sys.argv[1:]])\n"
            )
            git_wrapper.chmod(0o755)
            receipt = root / "receipt.json"
            code, out = run(
                [sys.executable, str(TOOL), "1", "--repo", "fixture/repo", "--verify-only",
                 "--receipt", str(receipt)], cwd=work, env={
                    **os.environ,
                    "FLEET_REAL_GH": str(bindir / "gh"),
            "PATH": f"{bindir}:{os.environ.get('PATH', '')}",
                    "GH_MERGE_VERIFIED_REMOTE": str(origin),
                },
            )
            check(f"failed {failing_command}: inconclusive", code == 4, f"exit {code}\n{out}")
            check(f"failed {failing_command}: names Git failure",
                  "COULD NOT DETERMINE" in out and "injected Git read failure" in out, out)
            check(f"failed {failing_command}: no receipt", not receipt.exists(), out)
            check(f"failed {failing_command}: no gh call", log.read_text() == "", log.read_text())

    malformed = (
        ("ls-tree", b"bad bogus not-an-object\ttracked.txt\0", "invalid tree entry"),
        ("ls-tree", b"100644 tree " + b"1" * 40 + b"\ttracked.txt\0", "invalid tree entry"),
        ("ls-tree", b"100644 blob short\ttracked.txt\0", "invalid tree entry"),
        ("diff", b"tracked.txt", "invalid changed-path list"),
        ("diff", b"tracked.txt\0\0", "invalid changed-path list"),
    )
    for index, (command, payload, diagnostic) in enumerate(malformed):
        with tempfile.TemporaryDirectory(prefix="gh-merge-verified-malformed-") as tmp:
            root = Path(tmp)
            origin, work = build_fixture(root, "arrived")
            bindir, log = tripwire_dir(root)
            git_wrapper = bindir / "git"
            git_wrapper.write_text(
                f"#!{sys.executable}\nimport os, sys\n"
                f"if {command!r} in sys.argv[1:]:\n"
                f"    sys.stdout.buffer.write({payload!r})\n"
                "    sys.exit(0)\n"
                f"os.execv({shutil.which('git')!r}, ['git', *sys.argv[1:]])\n"
            )
            git_wrapper.chmod(0o755)
            receipt = root / "receipt.json"
            code, out = run(
                [sys.executable, str(TOOL), "1", "--repo", "fixture/repo", "--verify-only",
                 "--receipt", str(receipt)], cwd=work, env={
                    **os.environ,
                    "FLEET_REAL_GH": str(bindir / "gh"),
            "PATH": f"{bindir}:{os.environ.get('PATH', '')}",
                    "GH_MERGE_VERIFIED_REMOTE": str(origin),
                },
            )
            name = f"malformed {command} {index}"
            check(f"{name}: inconclusive", code == 4, f"exit {code}\n{out}")
            check(f"{name}: exact diagnostic", diagnostic in out, out)
            check(f"{name}: no receipt", not receipt.exists(), out)
            check(f"{name}: no gh call", log.read_text() == "", log.read_text())


def load_tool():
    """Import the tool as a module so its helpers can be tested directly."""
    import importlib.util

    spec = importlib.util.spec_from_loader(
        "gh_merge_verified_under_test",
        importlib.machinery.SourceFileLoader("gh_merge_verified_under_test", str(TOOL)),
    )
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def unit_cases() -> None:
    """The proxy wrapping and the unreachable/refused split.

    Both exist so an ENVIRONMENT fault is never written down as a verdict about
    a pull request, which is the failure this whole file is shaped around.
    """
    import importlib.machinery  # noqa: F401 - used via load_tool

    tool = load_tool()

    with tempfile.TemporaryDirectory(prefix="gh-merge-verified-proxy-") as tmp:
        root = Path(tmp)

        selected = root / "selected gh"
        selected.write_text('#!/bin/sh\nprintf \'%s\\n\' "$@"\n')
        selected.chmod(0o755)
        proxy = root / "with-proxy"
        proxy.write_text('#!/bin/sh\nprintf \'proxied\\n\'\nexec "$@"\n')
        proxy.chmod(0o755)
        decoy = root / "gh"
        decoy.write_text('#!/bin/sh\nexit 99\n')
        decoy.chmod(0o755)
        with mock.patch.dict(os.environ, PATH=str(root), FLEET_REAL_GH=str(selected)):
            argv = tool.gh_argv(["gh", "api", "operand with spaces"])
            result = subprocess.run(argv, capture_output=True, text=True, timeout=2)
            check("explicit executable/proxy preserve operands",
                  result.returncode == 0 and result.stdout == "proxied\napi\noperand with spaces\n",
                  repr(result))
            for invalid in (None, "", "gh", str(root / "absent"), str(root)):
                with mock.patch.dict(os.environ):
                    if invalid is None:
                        os.environ.pop("FLEET_REAL_GH", None)
                    else:
                        os.environ["FLEET_REAL_GH"] = invalid
                    status = None
                    try:
                        tool.gh_argv(["gh", "api", "user"])
                    except SystemExit as error:
                        status = error.code
                    check(f"invalid configured route refuses: {invalid!r}", status == 8,
                          f"got {status!r}")
            proxy.unlink()
            refused = False
            try:
                tool.run(tool.gh_argv(["gh", "api", "user"]))
            except FileNotFoundError as error:
                refused = error.filename == "with-proxy"
            check("missing proxy refuses without PATH gh", refused,
                  "the selected CLI must not execute directly")

    # A network fault must not read as a refusal...
    for text in (
        "dial tcp 140.82.114.6:443: connect: network is unreachable",
        "could not resolve host: api.github.com",
        "Post \"https://api.github.com/graphql\": proxyconnect tcp: connection refused",
    ):
        check(
            f"unreachable recognised: {text[:34]!r}",
            tool.looks_unreachable(text),
            "classified as a real merge refusal",
        )

    # ...and a real refusal must not be excused as a network fault.
    for text in (
        "Pull request is not mergeable: the merge commit cannot be cleanly created.",
        "GraphQL: Base branch was modified. Review and try the merge again.",
        "pull request #7 is already closed",
    ):
        check(
            f"refusal NOT excused: {text[:34]!r}",
            not tool.looks_unreachable(text),
            "a genuine refusal was misread as a network fault, which would hide it",
        )


def self_change_cases() -> None:
    """A modified verifier refuses normally; only the main copy may admit it.

    The first direction is load-bearing. If the ordinary invocation stops
    refusing, the new path has disabled the self-check instead of making a
    reviewed change to this file landable.
    """
    with tempfile.TemporaryDirectory(prefix="gh-merge-verified-self-change-") as tmp:
        root = Path(tmp)
        target_origin, target_work = build_fixture(root, "absent")
        candidate = build_tool_fixture(root)

        head = git_output(target_origin, "rev-parse", "refs/heads/feature")
        base = git_output(target_origin, "merge-base", "main", "feature")
        tree = git_output(target_origin, "rev-parse", f"{head}^{{tree}}")
        landed_commit = git_output(
            target_origin,
            "commit-tree",
            tree,
            "-p",
            base,
            "-m",
            "squashed landing",
        )
        bindir, log = merge_stub_dir(root, target_origin, landed_commit)
        env = {
            **os.environ,
            "FLEET_REAL_GH": str(bindir / "gh"),
            "PATH": f"{bindir}:{os.environ.get('PATH', '')}",
            "GH_MERGE_VERIFIED_REMOTE": str(target_origin),
        }

        code, out = run(
            [
                sys.executable,
                str(candidate),
                "1",
                "--repo",
                "fixture/repo",
                "--expect-head",
                head,
            ],
            cwd=target_work,
            env=env,
        )
        check(
            "an unreviewed modified copy is still refused",
            code == 7
            and "REFUSING TO MERGE" in out
            and "this copy is" in out
            and "dev-hermit main has" in out,
            f"got exit {code}; the refusal may not be the measured hash mismatch\n{out}",
        )
        check(
            "the refusal names the current-main remedy",
            "--run-current-main-copy" in out
            and "--verify-only" in out
            and "not a route for landing" in out,
            f"the refusal did not distinguish admission from post-merge verification\n{out}",
        )
        check(
            "the refused modified copy made no GitHub call",
            log.read_text() == "",
            f"gh was called before refusal:\n{log.read_text()}",
        )

        code, out = run(
            [
                sys.executable,
                str(candidate),
                "1",
                "--repo",
                "fixture/repo",
                "--run-current-main-copy",
                "--verify-only",
            ],
            cwd=target_work,
            env=env,
        )
        check(
            "post-merge verification is not presented as an admission route",
            code == 1
            and "choose either" in out
            and "performs no admission" in out,
            f"got exit {code}\n{out}",
        )

        # The current-main copy must carry its versioned grammar with it. A
        # stale checkout is the reason this route exists; importing that
        # checkout's approval_binding.py makes a newly added grammar API crash
        # before admission. Make the local copy unusable so success proves the
        # fetched verifier ran with the dependency from the same main commit.
        stale_grammar = candidate.parents[1] / "health/approval_binding.py"
        stale_grammar.write_text(
            'raise RuntimeError("stale local approval_binding was imported")\n'
        )

        code, out = run(
            [
                sys.executable,
                str(candidate),
                "1",
                "--repo",
                "fixture/repo",
                "--run-current-main-copy",
                "--expect-head",
                head,
            ],
            cwd=target_work,
            env=env,
        )
        check(
            "the explicit path runs the current-main verifier through admission",
            code == 0
            and "byte-identical verifier from dev-hermit main" in out
            and "VERIFIED" in out,
            f"got exit {code}\n{out}",
        )
        calls = log.read_text()
        # The GraphQL query is multiline inside one shell argument, so count
        # only logged command starts rather than every physical log line.
        call_lines = [line for line in calls.splitlines() if line.startswith("gh ")]
        check(
            "the current-main copy performed admission before merging",
            len(call_lines) == 9
            and "/issues/1/comments" in call_lines[0]
            and "/pulls/1/comments" in call_lines[1]
            and "gh api graphql" in call_lines[2]
            and "/collaborators/fixture-reviewer/permission" in call_lines[3]
            and "/issues/1/comments" in call_lines[4]
            and "/pulls/1/comments" in call_lines[5]
            and "gh api graphql" in call_lines[6]
            and "/collaborators/fixture-reviewer/permission" in call_lines[7]
            and "gh pr merge" in call_lines[8],
            f"expected two complete review reads and one merge call; got:\n{calls}",
        )

        # Transition direction: the version immediately before this fix wrote
        # only the fetched script under this basename and then invoked it
        # without --run-current-main-copy. The new script must recognize that
        # handoff and bootstrap once into the complete same-commit tree.
        legacy_root = root / "legacy-single-file"
        legacy_root.mkdir()
        legacy_origin, legacy_work = build_fixture(legacy_root, "absent")
        legacy_head = git_output(legacy_origin, "rev-parse", "refs/heads/feature")
        legacy_base = git_output(legacy_origin, "merge-base", "main", "feature")
        legacy_tree = git_output(legacy_origin, "rev-parse", f"{legacy_head}^{{tree}}")
        legacy_landed = git_output(
            legacy_origin,
            "commit-tree",
            legacy_tree,
            "-p",
            legacy_base,
            "-m",
            "squashed landing",
        )
        legacy_bindir, legacy_log = merge_stub_dir(
            legacy_root, legacy_origin, legacy_landed
        )
        legacy_copy = candidate.parent / ".gh-merge-verified-current-main-legacy"
        shutil.copy2(TOOL, legacy_copy)
        legacy_env = {
            **os.environ,
            "FLEET_REAL_GH": str(legacy_bindir / "gh"),
            "PATH": f"{legacy_bindir}:{os.environ.get('PATH', '')}",
            "GH_MERGE_VERIFIED_REMOTE": str(legacy_origin),
        }
        code, out = run(
            [
                sys.executable,
                str(legacy_copy),
                "1",
                "--repo",
                "fixture/repo",
                "--expect-head",
                legacy_head,
            ],
            cwd=legacy_work,
            env=legacy_env,
        )
        legacy_copy.unlink()
        check(
            "a legacy single-file handoff bootstraps the matching main dependency tree",
            code == 0
            and "byte-identical verifier from dev-hermit main" in out
            and "VERIFIED" in out
            and "stale local approval_binding" not in out,
            f"got exit {code}\n{out}",
        )
        legacy_calls = [
            line
            for line in legacy_log.read_text().splitlines()
            if line.startswith("gh ")
        ]
        check(
            "the legacy handoff performed admission before merging",
            len(legacy_calls) == 9
            and "/issues/1/comments" in legacy_calls[0]
            and "/pulls/1/comments" in legacy_calls[1]
            and "gh api graphql" in legacy_calls[2]
            and "/collaborators/fixture-reviewer/permission" in legacy_calls[3]
            and "/issues/1/comments" in legacy_calls[4]
            and "/pulls/1/comments" in legacy_calls[5]
            and "gh api graphql" in legacy_calls[6]
            and "/collaborators/fixture-reviewer/permission" in legacy_calls[7]
            and "gh pr merge" in legacy_calls[8],
            f"expected two complete review reads and one merge call; got:\n{legacy_log.read_text()}",
        )
        leftovers = list(candidate.parent.glob(".gh-merge-verified-current-main-*"))
        check(
            "the fetched verifier trees are removed after execution",
            leftovers == [],
            f"temporary paths remain: {leftovers}",
        )
        scratch = git_output(
            candidate.parents[2],
            "for-each-ref",
            "--format=%(refname)",
            "refs/gh-merge-verified",
        )
        check(
            "the tool repository retains no per-process scratch refs",
            scratch == "",
            f"leaked refs:\n{scratch}",
        )
        target_scratch = git_output(
            target_work,
            "for-each-ref",
            "--format=%(refname)",
            "refs/gh-merge-verified",
        )
        check(
            "the target repository retains no per-process scratch refs",
            target_scratch == "",
            f"leaked refs:\n{target_scratch}",
        )


def race_cases() -> None:
    """The merge succeeds but `refs/heads/main` has not advanced yet.

    This is the failure agent(hermit-012) found. An unguarded fetch returns the
    PRE-MERGE main, every file reads as ABSENT, and the tool exits 3 -- NOT
    LANDED -- for a merge that worked. rc=3 is this tool's strongest claim, so an
    agent that believes it re-lands work that is already on main, or reopens a
    closed pull request.

    The stub `gh` here reports a successful merge and changes nothing, which is
    exactly what the remote looks like mid-race.
    """
    with tempfile.TemporaryDirectory(prefix="gh-merge-verified-race-") as tmp:
        root = Path(tmp)
        origin, work = build_fixture(root, "absent")
        bindir = root / "trap"
        bindir.mkdir()
        gh = bindir / "gh"
        review_head = git_output(origin, "rev-parse", "refs/pull/1/head")
        issue_comments = json.dumps(
            [
                [
                    {
                        "id": 900001,
                        "url": "https://github.com/fixture/repo/pull/1#issuecomment-900001",
                        "user": {"login": "fixture-reviewer"},
                        "body": f"APPROVED-AT: codex {review_head}",
                        "created_at": "2026-09-05T00:00:01Z",
                        "updated_at": "2026-09-05T00:00:01Z",
                    }
                ]
            ]
        )
        permission = json.dumps(
            {"permission": "write", "user": {"login": "fixture-reviewer"}}
        )
        # The stub must answer the ADMISSION queries with valid JSON, or the
        # objection and required-review checks refuse before the merge and
        # the race path below is never reached. Measured 2026-08-25: without this the
        # race assertions passed on an exit 4 that came from the wrong branch entirely.
        gh.write_text(
            "#!/bin/bash\n"
            "if [ \"$1\" = pr ] && [ \"$2\" = view ]; then\n"
            "  echo '{\"comments\":[],\"reviews\":[],\"labels\":[],\"state\":\"OPEN\"}'\n"
            "  exit 0\n"
            "fi\n"
            "if [ \"$1\" = api ] && [ \"$2\" = graphql ]; then\n"
            "  echo '[{\"data\":{\"repository\":{\"pullRequest\":{\"reviews\":{\"nodes\":[],\"pageInfo\":{\"hasNextPage\":false,\"endCursor\":null}}}}}}]'\n"
            "  exit 0\n"
            "fi\n"
            "if [ \"$1\" = api ] && [[ \"$*\" == *\"/collaborators/\"* ]]; then\n"
            f"  echo '{permission}'\n"
            "  exit 0\n"
            "fi\n"
            "if [ \"$1\" = api ] && [[ \"$*\" == *\"/issues/\"* ]]; then\n"
            f"  echo '{issue_comments}'\n"
            "  exit 0\n"
            "fi\n"
            "if [ \"$1\" = api ]; then\n"
            "  echo '[[]]'\n"
            "  exit 0\n"
            "fi\n"
            "echo 'Merged pull request'\nexit 0\n"
        )
        gh.chmod(0o755)
        env = {
            **os.environ,
            "FLEET_REAL_GH": str(bindir / "gh"),
            "PATH": f"{bindir}:{os.environ.get('PATH', '')}",
            "GH_MERGE_VERIFIED_REMOTE": str(origin),
            "GH_MERGE_VERIFIED_SELFCHECK": "off",
            "GH_MERGE_VERIFIED_ADVANCE_TIMEOUT_S": "2",
            "GH_MERGE_VERIFIED_ADVANCE_POLL_S": "0.2",
        }
        code, out = run(
            [sys.executable, str(TOOL), "1", "--repo", "fixture/repo"],
            cwd=work,
            env=env,
        )
        check(
            "raced merge exits 4 COULD NOT DETERMINE, not 3 NOT LANDED",
            code == 4,
            "got exit %s; 3 would assert the change is absent when we only "
            "outran the remote\n%s" % (code, out),
        )
        check(
            "raced merge disclaims a verdict about the pull request",
            "NOT A STATEMENT ABOUT THE PULL REQUEST" in out,
            "output did not disclaim a verdict\n%s" % out,
        )
        check(
            "raced merge names the sha main is stuck on",
            "has not moved from" in out,
            "output did not name the unmoved ref\n%s" % out,
        )


def expect_head_cases() -> None:
    """`refs/pull/N/head` lags a push, so a caller who just pushed must be able to say so.

    Reading that ref once right after pushing can return the PREVIOUS head, and then
    the merge base, the file list and every ARRIVED/ABSENT verdict are computed from
    the wrong commit -- the tool reports VERIFIED over the old change. These cases
    pin the three behaviours that close it.
    """
    with tempfile.TemporaryDirectory(prefix="gh-merge-verified-head-") as tmp:
        root = Path(tmp)
        origin, work = build_fixture(root, "arrived")
        bindir, log = tripwire_dir(root)
        env = {
            **os.environ,
            "FLEET_REAL_GH": str(bindir / "gh"),
            "PATH": f"{bindir}:{os.environ.get('PATH', '')}",
            "GH_MERGE_VERIFIED_REMOTE": str(origin),
            "GH_MERGE_VERIFIED_PR_HEAD_TIMEOUT_S": "2",
            "GH_MERGE_VERIFIED_PR_HEAD_POLL_S": "0.2",
        }
        real_head = subprocess.run(
            ["git", "rev-parse", "refs/pull/1/head"],
            cwd=origin, capture_output=True, text=True,
        ).stdout.strip()

        # (1) the correct sha: converges immediately and verifies as before.
        code, out = run(
            [sys.executable, str(TOOL), "1", "--repo", "fixture/repo",
             "--verify-only", "--expect-head", real_head],
            cwd=work, env=env,
        )
        check(
            "--expect-head matching the ref proceeds to a verdict",
            code == 0 and "VERIFIED" in out,
            f"got exit {code}\n{out}",
        )

        # (2) a sha the ref never reaches: COULD NOT DETERMINE, never a verdict.
        wrong = "0" * 40
        code, out = run(
            [sys.executable, str(TOOL), "1", "--repo", "fixture/repo",
             "--verify-only", "--expect-head", wrong],
            cwd=work, env=env,
        )
        check(
            "--expect-head that never converges exits 4, not a verdict",
            code == 4,
            f"got exit {code}; anything else asserts something about the change from a "
            f"fact about timing\n{out}",
        )
        check(
            "non-convergence disclaims a statement about the change",
            "NOT A STATEMENT ABOUT THE CHANGE" in out,
            f"output did not disclaim\n{out}",
        )
        check(
            "non-convergence names both the seen and the expected sha",
            "--expect-head said" in out,
            f"output did not name the expectation\n{out}",
        )

        # (3) omitted: the tool must SAY it could not corroborate, not imply it did.
        code, out = run(
            [sys.executable, str(TOOL), "1", "--repo", "fixture/repo", "--verify-only"],
            cwd=work, env=env,
        )
        check(
            "omitting --expect-head discloses the head was uncorroborated",
            "WITHOUT corroboration" in out,
            f"silent about an unverified head, which reads as though it checked\n{out}",
        )
        check(
            "omitting --expect-head still reaches a verdict",
            code == 0,
            f"got exit {code}; the disclosure must not become a refusal\n{out}",
        )


def receipt_cases() -> None:
    """The receipt must carry BOTH shas, and must refuse to overclaim.

    ⚠️ TWO SHAS THAT AGREE ARE EVIDENCE; ONE SHA IS A NOTE. Recording only the head
    the tool resolved leaves an auditor unable to separate a correct resolution
    from a stale one -- which is precisely why the pull-ref audit could report no
    more than "clean as far as recorded". The pair is what makes the record
    load-bearing, and it is stamped at resolve time rather than rebuilt at report
    time, because a field reconstructed later is the same guess with better
    manners.
    """
    tool = load_tool()

    # THE FORCED DIVERGENCE. Reaching the writer with two shas that disagree must
    # refuse by name rather than persist a receipt an audit would count as checked.
    with tempfile.TemporaryDirectory(prefix="gh-merge-verified-receipt-") as tmp:
        out = Path(tmp) / "receipt.json"
        code = None
        try:
            tool.write_receipt(str(out), {
                "resolved_head": "a" * 40,
                "corroborated_against": "b" * 40,
                "corroborated": True,
            })
        except SystemExit as exc:
            code = exc.code
        check(
            "a receipt whose two shas disagree is REFUSED, not written",
            code == 4,
            "expected exit 4 from the writer; got %r" % (code,),
        )
        check(
            "the refused receipt leaves NO file behind for an audit to trust",
            not out.exists(),
            "a contradictory receipt was persisted at %s" % out,
        )

    # Claiming corroboration with nothing to corroborate against is the same defect.
    code = None
    try:
        tool.write_receipt(None, {"resolved_head": "a" * 40,
                                  "corroborated_against": None, "corroborated": True})
    except SystemExit as exc:
        code = exc.code
    check(
        "claiming corroboration against nothing is refused",
        code == 4,
        "expected exit 4; got %r" % (code,),
    )

    # THE HONEST CASES still write, and carry the pair.
    with tempfile.TemporaryDirectory(prefix="gh-merge-verified-receipt-ok-") as tmp:
        out = Path(tmp) / "r.json"
        tool.write_receipt(str(out), {
            "resolved_head": "c" * 40, "corroborated_against": "c" * 40,
            "corroborated": True, "pr": "1",
        })
        rec = json.loads(out.read_text())
        check(
            "a corroborated receipt records BOTH shas, not just the resolved one",
            rec["resolved_head"] == "c" * 40 and rec["corroborated_against"] == "c" * 40,
            "receipt did not carry the pair: %s" % rec,
        )
        out2 = Path(tmp) / "r2.json"
        tool.write_receipt(str(out2), {
            "resolved_head": "d" * 40, "corroborated_against": None,
            "corroborated": False, "pr": "1",
        })
        rec2 = json.loads(out2.read_text())
        check(
            "an uncorroborated receipt says so explicitly rather than omitting the field",
            rec2["corroborated"] is False and rec2["corroborated_against"] is None,
            "an audit could not tell this run was unchecked: %s" % rec2,
        )


def argv_cases() -> None:
    """A flag this tool owns must not be lost, whatever its position.

    ⚠️ MEASURED ON A REAL LANDING. `... --expect-head <sha> -- --squash` dropped
    the corroboration silently: the `--` handler did `extra = argv[i+1:]`, which
    REPLACED everything collected before it. The merge succeeded, gh saw valid
    flags, and the head was never corroborated. A guard reported as used that had
    not run is the exact failure this file exists to prevent, so it is pinned here
    rather than remembered.
    """
    tool = load_tool()
    for label, argv, want_head, want_extra in [
        ("owned flag before the gh flags",
         ["7", "--repo", "r/h", "--expect-head", "ABC", "--squash"], "ABC", ["--squash"]),
        ("owned flag before an explicit separator",
         ["7", "--repo", "r/h", "--expect-head", "ABC", "--", "--squash"], "ABC", ["--squash"]),
        ("owned flag after the gh flags",
         ["7", "--repo", "r/h", "--squash", "--expect-head", "ABC"], "ABC", ["--squash"]),
    ]:
        _repo, _vo, _cm, got_head, _rc, _local, got_extra = tool.parse_options(argv)
        check(f"position does not matter: {label}",
              got_head == want_head and got_extra == want_extra,
              f"expect_head={got_head!r} extra={got_extra!r}; wanted {want_head!r} / {want_extra!r}")

    _r, _v, _cm, head, _rc, _local, extra = tool.parse_options(
        ["7", "--repo", "r/h", "--expct-head", "ABC", "--", "--squash"])
    check("a misspelled flag before `--` is FORWARDED, never silently dropped",
          "--expct-head" in extra and "ABC" in extra and head is None,
          f"the typo vanished instead of reaching gh: extra={extra!r}")

    _r, _v, current_main, _head, _rc, _local, extra = tool.parse_options(
        ["7", "--squash", "--run-current-main-copy"]
    )
    check(
        "--run-current-main-copy is owned before the separator",
        current_main and "--run-current-main-copy" not in extra,
        f"current_main={current_main!r} extra={extra!r}",
    )
    _r, _v, current_main, _head, _rc, _local, extra = tool.parse_options(
        ["7", "--", "--run-current-main-copy"]
    )
    check(
        "--run-current-main-copy after the separator remains a gh argument",
        not current_main and extra == ["--run-current-main-copy"],
        f"current_main={current_main!r} extra={extra!r}",
    )


def admission_unresolvable_cases() -> None:
    """The admission guard cannot READ, so it must not borrow the merge's code.

    An exit code passed on from an inner call carries the INNER meaning. The
    admission guard could not resolve comments, said "could not determine", and a
    caller read that as "the MERGE could not be determined" -- same code, two
    meanings, one boundary. The two want opposite reactions: after an admission
    failure NOTHING WAS ATTEMPTED and a plain re-run is safe; after a merge-outcome
    failure the merge already happened and re-running risks a second landing.

    Measured 2026-08-25: while they shared code 4, three race cases in this suite
    passed on an exit 4 that the admission guard produced, not the race they named.
    """
    with tempfile.TemporaryDirectory(prefix="gh-merge-verified-adm-") as tmp:
        root = Path(tmp)
        origin, work = build_fixture(root, "arrived")
        bindir = root / "trap"
        bindir.mkdir()
        gh = bindir / "gh"
        # Answers the merge, but returns NON-JSON for the admission query, so the
        # guard can neither admit nor refuse.
        gh.write_text("#!/bin/bash\n"
                      "if [ \"$1\" = pr ] && [ \"$2\" = view ]; then\n"
                      "  echo 'not json at all'\n  exit 0\nfi\n"
                      "echo 'Merged pull request'\nexit 0\n")
        gh.chmod(0o755)
        env = {
            **os.environ,
            "FLEET_REAL_GH": str(bindir / "gh"),
            "PATH": f"{bindir}:{os.environ.get('PATH', '')}",
            "GH_MERGE_VERIFIED_REMOTE": str(origin),
            "GH_MERGE_VERIFIED_SELFCHECK": "off",
        }
        code, out = run([sys.executable, str(TOOL), "1", "--repo", "fixture/repo"],
                        cwd=work, env=env)
        check(
            "an unresolvable admission exits 8, NOT 4",
            code == 8,
            "got exit %s; 4 would say the MERGE outcome is undetermined when the "
            "merge was never attempted\n%s" % (code, out),
        )
        check(
            "it says nothing was attempted, so a plain re-run is safe",
            "NOTHING WAS ATTEMPTED" in out,
            "output did not say nothing was attempted\n%s" % out,
        )


def reviewer_name_metadata_cases() -> None:
    """Fleet-name equality cannot change an exact-head admission decision.

    ⚠️ THIS IS AN END-TO-END PROBE ON PURPOSE. A unit test on the helper proves it
    RETURNS a row; it does not prove the tool acts on it. Those are different claims,
    and the gap between them is exactly where a check gets computed, reported and
    then not acted on. Both cases drive the real CLI and must have the same result.
    """
    for issuers, expect_code, name in (
        (("hermit-011", "hermit-011"), 0, "two lanes, matching name metadata: ACCEPTED"),
        (("hermit-011", "hermit-030"), 0, "two lanes, differing name metadata: ACCEPTED"),
    ):
        with tempfile.TemporaryDirectory(prefix="gh-merge-verified-iss-") as tmp:
            root = Path(tmp)
            origin, work = build_fixture(root, "arrived")
            head = subprocess.run(
                ["git", "-C", str(origin), "rev-parse", "refs/pull/1/head"],
                capture_output=True, text=True, check=True,
            ).stdout.strip()

            claude, codex = issuers
            doc = {
                "headRefOid": head,
                "state": "OPEN",
                "labels": [{"name": "passed-review-claude"},
                           {"name": "passed-review-codex"}],
                "reviews": [],
                "comments": [
                    {"id": 900001,
                     "user": {"login": "fixture-reviewer"},
                     "html_url": "https://github.com/fixture/repo/pull/1#issuecomment-900001",
                     "created_at": "2026-09-04T00:00:01Z",
                     "updated_at": "2026-09-04T00:00:01Z",
                     "body": f"[hermit2, {claude}, unresolved, devbig014, role=review]\n"
                             f"APPROVED-AT: claude {head} BY {claude}"},
                    {"id": 900002,
                     "user": {"login": "fixture-reviewer"},
                     "html_url": "https://github.com/fixture/repo/pull/1#issuecomment-900002",
                     "created_at": "2026-09-04T00:00:02Z",
                     "updated_at": "2026-09-04T00:00:02Z",
                     "body": f"[hermit2, {codex}, unresolved, devbig014, role=review]\n"
                             f"APPROVED-AT: codex {head} BY {codex}"},
                ],
            }
            payload = root / "view.json"
            payload.write_text(json.dumps(doc))
            issue_payload = root / "issue-comments.json"
            issue_payload.write_text(json.dumps([doc["comments"]]))

            bindir = root / "bin"
            bindir.mkdir()
            gh = bindir / "gh"
            # On merge this ADVANCES the fixture's main, the way a real merge
            # would. Without that the tool correctly exits 4 waiting for a remote
            # that never moves -- which would make the accept case unreachable and
            # tempt a weaker assertion than "it actually merged".
            gh.write_text(
                "#!/bin/bash\n"
                'if [ "$1" = api ] && [ "$2" = graphql ]; then\n'
                "  echo '[{\"data\":{\"repository\":{\"pullRequest\":{\"reviews\":{\"nodes\":[],\"pageInfo\":{\"hasNextPage\":false,\"endCursor\":null}}}}}}]'\n"
                "  exit 0\nfi\n"
                'if [ "$1" = api ] && [[ "$*" = *"/issues/1/comments"* ]]; then\n'
                f'  cat {issue_payload}\n  exit 0\nfi\n'
                'if [ "$1" = api ] && [[ "$*" = *"/collaborators/fixture-reviewer/permission"* ]]; then\n'
                "  echo '{\"role_name\":\"write\",\"permission\":\"write\","
                "\"user\":{\"login\":\"fixture-reviewer\"}}'\n"
                "  exit 0\nfi\n"
                'if [ "$1" = api ]; then\n'
                "  echo '[[]]'\n  exit 0\nfi\n"
                'if [ "$1" = pr ] && [ "$2" = view ]; then\n'
                f'  cat {payload}\n  exit 0\nfi\n'
                f'if [ "$1" = pr ] && [ "$2" = merge ]; then\n'
                f'  git -C {origin} -c user.name=t -c user.email=t@example.invalid \\\n'
                f'      commit --allow-empty --quiet -m merged\n'
                "  echo 'Merged pull request'\n  exit 0\nfi\n"
                "echo 'Merged pull request'\nexit 0\n"
            )
            gh.chmod(0o755)
            env = {
                **os.environ,
                "FLEET_REAL_GH": str(bindir / "gh"),
            "PATH": f"{bindir}:{os.environ.get('PATH', '')}",
                "GH_MERGE_VERIFIED_REMOTE": str(origin),
                "GH_MERGE_VERIFIED_SELFCHECK": "off",
                "GH_MERGE_VERIFIED_ADVANCE_TIMEOUT_S": "20",
            }
            code, out = run([sys.executable, str(TOOL), "1", "--repo", "fixture/repo"],
                            cwd=work, env=env)
            check(name, code == expect_code,
                  f"got exit {code}, expected {expect_code}\n{out}")


def local_review_cases() -> None:
    """Drive the real helper through local admission and squash verification.

    The provider, authenticated actor and GitHub API are explicitly synthetic;
    Git source identities, packet bytes, receipts and landing effects are real.
    No public comment is created, and every refusal must avoid the merge call.
    """
    cases = (
        ("accepted", 0), ("wrong-head", 6), ("changed-report", 6),
        ("admin-equals", 1), ("auto-equals", 1), ("feature-only-base", 6),
        ("unprivileged", 6), ("missing-provenance", 6),
        ("core-label", 6), ("sticky-critical", 6),
        ("newer-refusal", 5), ("stale-refusal", 5),
        ("unreadable-public", 8), ("malformed-public", 5),
    )
    for scenario, expected in cases:
        with tempfile.TemporaryDirectory(prefix="gh-local-review-test-") as tmp:
            root = Path(tmp)
            origin, work = build_fixture(root, "absent")
            head = git_output(origin, "rev-parse", "feature")
            base = git_output(origin, "rev-parse", "main")
            if scenario == "feature-only-base":
                # An otherwise valid exact packet for only the final feature
                # commit must not hide the earlier tracked.txt PR change.
                base = head
                git(origin, "checkout", "--quiet", "feature")
                (origin / "later.txt").write_text("only the final feature change\n")
                git(origin, "add", "later.txt")
                git(origin, "commit", "--quiet", "-m", "later feature change")
                head = git_output(origin, "rev-parse", "feature")
                git(origin, "update-ref", "refs/pull/1/head", head)
                git(origin, "checkout", "--quiet", "main")
            tree = git_output(origin, "rev-parse", "feature^{tree}")
            diff = subprocess.run(
                ["git", "--no-replace-objects", "diff", "--no-ext-diff", "--no-textconv",
                 "--no-renames", "--full-index", "--binary", base, head, "--"],
                cwd=origin, capture_output=True, check=True,
            ).stdout
            # Main advances independently after the immutable reviewed base.
            (origin / "unrelated.txt").write_text("current main is preserved\n")
            git(origin, "add", "unrelated.txt")
            git(origin, "commit", "--quiet", "-m", "unrelated main advance")
            before = git_output(origin, "rev-parse", "main")
            (origin / "tracked.txt").write_text("branch content\n")
            git(origin, "commit", "--quiet", "-am", "squash landing")
            landed = git_output(origin, "rev-parse", "main")
            git(origin, "update-ref", "refs/heads/main", before)

            def artifact(name, value):
                raw = (value if isinstance(value, str) else json.dumps(value) + "\n").encode()
                path = root / name
                path.write_bytes(raw)
                return {"path": str(path), "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest()}

            report = artifact("review.md", f"[fixture worker, role=reviewer]\nAPPROVED-AT: codex {head}\nIndependent fixture review.\n")
            triggers = {name: {"applies": False, "reason": "Synthetic text-file change only."} for name in (
                "new-syscall", "reverie-core-api", "new-determinization", "detcore-scheduling",
            )}
            identity = {"head": head, "base": base, "tree": tree, "diff_sha256": hashlib.sha256(diff).hexdigest()}
            completion = artifact("completion.json", {
                "schema": 1, **identity, "reviewer": "fixture-review-worker", "implementor": "fixture-author-worker",
                "report_sha256": report["sha256"], "verdict": "approve", "open_findings": [],
                "triggers_sha256": hashlib.sha256(json.dumps(triggers, sort_keys=True, separators=(",", ":")).encode()).hexdigest(),
                "completed_at": "2026-09-22T00:00:00Z",
            })
            provenance = artifact("observed-completion.json", {
                "reviewer": "fixture-review-worker", "observed_at": "2026-09-22T00:00:01Z",
                "message": f"Completed {head}, report {report['sha256']}, completion {completion['sha256']}",
            })
            packet = {"schema": 1, "repository": "fixture/repo", "pr": 1, **identity,
                      "family": "codex", "report": report, "completion": completion, "triggers": triggers,
                      "provenance": {"kind": "attestor-observed-collaboration", "evidence": provenance}}
            if scenario == "wrong-head":
                packet["head"] = base
            if scenario == "changed-report":
                Path(report["path"]).write_text("changed after review\n")
            if scenario == "missing-provenance":
                Path(provenance["path"]).unlink()
            packet_path = root / "packet.json"
            packet_path.write_text(json.dumps(packet))
            comments = []
            marker = {
                "newer-refusal": f"CHANGES-REQUESTED-AT: claude {head}",
                "stale-refusal": f"CHANGES-REQUESTED-AT: claude {base}",
                "malformed-public": "APPROVED-AT: codex malformed",
                "sticky-critical": f"REVIEW-DISPATCH-ATTESTATION\nhead: {base}\ncritical-class: detcore-scheduling",
            }.get(scenario)
            if marker:
                comments.append({"id": 900001, "body": marker, "user": {"login": "public-reviewer"},
                                 "created_at": "2026-09-22T00:01:00Z", "updated_at": "2026-09-22T00:01:00Z"})
            config = {"origin": str(origin), "head": head, "landed": landed, "scenario": scenario,
                      "comments": comments, "labels": [{"name": "post-facto-human-review"}] if scenario == "core-label" else []}
            (root / "gh-config.json").write_text(json.dumps(config))
            bindir = root / "bin"
            bindir.mkdir()
            log = root / "calls.jsonl"
            (bindir / "gh").write_text("#!/usr/bin/env python3\n" + r'''
import json, pathlib, subprocess, sys
root = pathlib.Path(__file__).resolve().parents[1]
c = json.loads((root / "gh-config.json").read_text())
args = sys.argv[1:]
with (root / "calls.jsonl").open("a") as output:
    output.write(json.dumps(args) + "\n")
def emit(value):
    print(json.dumps(value))
    raise SystemExit(0)
if args[:2] == ["pr", "merge"]:
    assert args[args.index("--match-head-commit") + 1] == c["head"]
    assert "--squash" in args and "--admin" not in args and "--auto" not in args
    subprocess.run(["git", "-C", c["origin"], "update-ref", "refs/heads/main", c["landed"]], check=True)
    emit({"fixture_merge": True})
assert args[0] == "api" and "--method" not in args and "-X" not in args, args
if args[1] == "graphql":
    emit([{"data": {"repository": {"pullRequest": {"reviews": {"nodes": [], "pageInfo": {"hasNextPage": False, "endCursor": None}}}}}}])
path = args[-1]
if path == "user":
    emit({"login": "fixture-relay"})
if "/collaborators/" in path:
    actor = path.split("/")[-2]
    permission = "read" if c["scenario"] == "unprivileged" and actor == "fixture-relay" else "write"
    emit({"permission": permission, "user": {"login": actor}})
if path.endswith("/pulls/1"):
    emit({"state": "open", "head": {"sha": c["head"]}, "base": {"repo": {"full_name": "fixture/repo"}}, "labels": c["labels"]})
if "/issues/1/comments" in path:
    if c["scenario"] == "unreadable-public":
        raise SystemExit(23)
    emit([c["comments"]])
if "/pulls/1/comments" in path:
    emit([[]])
raise AssertionError(args)
''')
            (bindir / "gh").chmod(0o755)
            (bindir / "with-proxy").write_text('#!/bin/sh\nexec "$@"\n')
            (bindir / "with-proxy").chmod(0o755)
            receipt = root / "landing.json"
            extra = {"admin-equals": ["--admin=true"], "auto-equals": ["--auto=true"]}.get(scenario, [])
            env = {**os.environ, "FLEET_REAL_GH": str(bindir / "gh"),
            "PATH": f"{bindir}:{os.environ.get('PATH', '')}",
                   "GH_MERGE_VERIFIED_REMOTE": str(origin), "GH_MERGE_VERIFIED_SELFCHECK": "off",
                   "GIT_ALLOW_PROTOCOL": "file"}
            code, out = run([sys.executable, str(TOOL), "1", "--repo", "fixture/repo", "--expect-head", head,
                             "--local-review", str(packet_path), "--receipt", str(receipt), "--", "--squash", *extra], cwd=work, env=env)
            calls = [json.loads(line) for line in log.read_text().splitlines()] if log.exists() else []
            merges = [call for call in calls if call[:2] == ["pr", "merge"]]
            check(f"local {scenario}: native {expected}", code == expected, out)
            check(f"local {scenario}: merge boundary", len(merges) == (1 if expected == 0 else 0), str(calls))
            if expected:
                check(f"local {scenario}: main/receipt unchanged", git_output(origin, "rev-parse", "main") == before
                      and not receipt.exists() and not Path(str(receipt) + ".admission.json").exists(), out)
            elif code == 0:
                terminal = json.loads(receipt.read_text())
                admission_path = Path(terminal["local_review_admission"]["path"])
                raw = admission_path.read_bytes()
                admission = json.loads(raw)
                check("local accepted: durable separate admission", admission["phase"] == "premerge-admission"
                      and admission["merge_performed"] is False
                      and hashlib.sha256(raw).hexdigest() == terminal["local_review_admission"]["sha256"], str(terminal))
                check("local accepted: source and current actor", admission["review"]["base"] == base
                      and admission["main_before"] == before and before != base
                      and admission["review"]["attestor"]["login"] == "fixture-relay", str(admission))
                check("local accepted: real squash effect", terminal["arrived"] == ["tracked.txt"]
                      and terminal["absent"] == [] and terminal["moved_on"] == [] and terminal["main_sha"] == landed
                      and git_output(origin, "show", "main:unrelated.txt") == "current main is preserved", str(terminal))
                check("local accepted: all public surfaces queried", all(any(needle in " ".join(call) for call in calls)
                      for needle in ("issues/1/comments", "pulls/1/comments", "graphql")), str(calls))


def main() -> int:
    if not TOOL.exists():
        print(f"gh-merge-verified-test: {TOOL} is missing", file=sys.stderr)
        return 1

    print("gh-merge-verified-test: the refusals are the point; the pass proves it can still accept")

    # THE CASE THAT MUST BE REFUSED. Main still holds the pre-change content, so
    # the change definitely did not land. Anything other than a refusal here
    # means a merge that never happened can be recorded as a landing.
    case("absent", 3, "NOT LANDED", "a merge that did not happen")

    # Refused, but NOT as a claim that it failed to land: blobs cannot decide.
    # Collapsing this into "not landed" is how a real landing gets re-landed.
    case("moved_on", 3, "UNDECIDABLE", "a file that moved on")

    # The accept case, so a tool that refuses everything does not pass this suite.
    # The landing here is a SQUASH -- same content, different sha -- which is why
    # ancestry cannot answer this question and content-identity can.
    case("arrived", 0, "VERIFIED", "a squash landing that did arrive")

    tree_content_cases()
    unit_cases()
    self_change_cases()
    race_cases()
    reviewer_name_metadata_cases()
    admission_unresolvable_cases()
    receipt_cases()
    argv_cases()
    expect_head_cases()
    local_review_cases()

    print()
    if FAILURES:
        print(
            f"gh-merge-verified-test: FAIL — {len(FAILURES)} case(s): {', '.join(FAILURES)}",
            file=sys.stderr,
        )
        return 1
    print("gh-merge-verified-test: OK — refuses a merge that did not happen, "
          "distinguishes undecidable from absent, accepts a squash landing, and keeps "
          "verify-only free of gh calls")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
