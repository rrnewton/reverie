    {
      "label": "neither field, finished_at in year zero",
      "fields": {
        "repo": "hermit",
        "finished_at": "0000-09-25T19:00:00Z"
      },
      "expected": null
    },
    {
      "label": "neither field, a repository that is neither Hermit nor Reverie",
      "fields": {
        "repo": "agent-utils",
        "finished_at": "2026-08-07T20:15:31Z"
      },
      "expected": null
    },
    {
      "label": "consistent cargo",
      "fields": {
        "release_builder": "cargo",
        "e2e_payload": {
          "path": "target/validate/hermit",
          "profile": "validate",
          "debug_assertions": true,
          "overflow_checks": true
        }
      },
      "expected": "cargo"
    },
    {
      "label": "consistent buck",
      "fields": {
        "release_builder": "buck",
        "e2e_payload": {
          "path": "target/ci/hermit-strict",
          "profile": "release",
          "debug_assertions": false,
          "overflow_checks": false
        }
      },
      "expected": "buck"
    },
    {
      "label": "builder absent beside the Buck payload",
      "fields": {
        "e2e_payload": {
          "path": "target/ci/hermit-strict",
