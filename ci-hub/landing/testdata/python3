#!/usr/bin/env bash
printf 'python3 %s\n' "$*" >> "$CALLS"
case "$*" in
  *rebase_wrapper.py*authorize*)
    # Faithful model of the authority: a head is authorized when it has EITHER a
    # qualifying exact-head verdict (hard green) OR recorded rebase provenance
    # (soft green). With neither, it refuses -- and the message names the
    # missing record, which is the secondary message emitted after hard-green
    # has already been demoted.
    # Like the real authority, name the state: an exact-head verdict is hard
    # green, recorded provenance alone is soft green.
    if [ -f "$SCEN_DIR/jit_ok" ]; then
      echo '{"verdict":"AUTHORIZED","state":"HARD_GREEN"}'; exit 0
    fi
    if [ -f "$SCEN_DIR/recorded" ]; then
      echo '{"verdict":"AUTHORIZED","state":"SOFT_GREEN"}'; exit 0
    fi
    echo '{"verdict":"REFUSED","detail":"no rebase record for result '"${SCEN_ORIG:-bbbb222}"'"}'; exit 2 ;;
  *union_rebase_result.py*require-success*)
    echo '{"ok":true,"branch":"feature"}'; exit 0 ;;
  *changes-requested-gate*)
    # Opt-in so existing scenarios keep stopping at this gate as before.
    if [ -n "${SCEN_CR_CLEAR:-}" ]; then
      echo "changes-requested-gate: CLEAR (stub)"; exit 0
    fi
    exit 0 ;;
  *rebase_wrapper.py*record*) : > "$SCEN_DIR/recorded"; echo '{"recorded":true}'; exit 0 ;;
  *) exit 0 ;;
esac
