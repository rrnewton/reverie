def _packaged_resource(name: str) -> Path:
    if name not in {
        "bounded-run-space",
        "hermit-import-compatibility.v1.json",
        "hermit-import-receipts.v1.json",
        "hermit-test-bin",
        "safehermit",
    }:
        raise HermitError("packaged resource name is not allowlisted")
    adjacent = Path(__file__).with_name(name)
    source_tree = Path(__file__).with_name("resources") / name
    try:
        return (adjacent if os.path.lexists(adjacent) else source_tree).resolve(
            strict=True
        )
    except OSError as error:
        raise HermitError(f"packaged resource is unavailable: {name}") from error


