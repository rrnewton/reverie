class HermitError(RuntimeError):
    pass


@dataclass(frozen=True)
class _VerifySpace:
    path: Path
    verify_dir: Path
    disk_limit: str
    limit_bytes: int
    mount_id: int
    root_record: dict[str, object]
    marker_record: dict[str, object]
    create_receipt: dict[str, object]


def _safehermit_log_root(attempt_root: Path) -> Path:
    configured = os.environ.get(_VERIFY_SPACE_ROOT_ENV)
    if configured is None:
        return attempt_root / "bounded-output"
    root = Path(configured)
    if not root.is_absolute():
        raise HermitError("configured verification space root is not absolute")
    try:
        canonical = root.resolve(strict=True)
        fixture_root = root.parents[1]
    except (IndexError, OSError) as error:
        raise HermitError(
            "configured verification space root is unavailable"
        ) from error
    if (
        canonical != root
        or root.name != "safehermit"
        or root.parent.name != "mount"
        or fixture_root.parent != Path("/tmp/tfa-phase2")
        or not fixture_root.name.startswith("tfa-production-btrfs-")
    ):
        raise HermitError("configured verification space root is not a test fixture")
    for component in (fixture_root, root.parent, root):
        metadata = component.lstat()
        if (
            not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid != os.getuid()
            or stat.S_IMODE(metadata.st_mode) & 0o022
        ):
            raise HermitError("configured verification space root is unsafe")
    return root / ("attempt-" + _verify_allocation_key(attempt_root))


def _prepare_safehermit_log_root(attempt_root: Path) -> Path:
    path = _safehermit_log_root(attempt_root)
    path.mkdir(mode=0o700, exist_ok=True)
    metadata = path.lstat()
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or stat.S_IMODE(metadata.st_mode) != 0o700
    ):
        raise HermitError("safehermit log root is unsafe")
    return path


def _verify_allocation_lock(attempt_root: Path) -> Path:
    return attempt_root / ".verify-allocation.lock"


def _verify_command_lock(attempt_root: Path) -> Path:
    return attempt_root / ".verify-command.lock"


def _verify_allocation_key(attempt_root: Path) -> str:
    canonical = attempt_root.resolve(strict=True)
    return hashlib.sha256(os.fsencode(canonical)).hexdigest()[:24]


def _verify_allocation_tag(attempt_root: Path) -> str:
    return _VERIFY_ALLOCATION_TAG_PREFIX + _verify_allocation_key(attempt_root)


def _verify_allocation_prefix(attempt_root: Path) -> str:
    return "brs-" + _verify_allocation_tag(attempt_root) + "-"


def _verify_allocation_path_matches(path: Path, attempt_root: Path) -> bool:
    return (
        path.parent == _safehermit_log_root(attempt_root)
        and re.fullmatch(
            re.escape(_verify_allocation_prefix(attempt_root))
            + r"[1-9][0-9]*-[1-9][0-9]*",
            path.name,
        )
        is not None
    )


@contextmanager
def _verified_lock_guard(
    path: Path,
    timeout_seconds: int,
    label: str,
    *,
    inherit_on_fork: bool,
) -> Iterator[int]:
    descriptor = os.open(
        path,
        os.O_RDWR
        | os.O_CREAT
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.getuid()
            or metadata.st_nlink != 1
        ):
            raise HermitError(f"verification {label} lock is unsafe")
        deadline = time.monotonic() + timeout_seconds
        while True:
            try:
                if inherit_on_fork:
                    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                else:
                    fcntl.lockf(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError as error:
                if time.monotonic() >= deadline:
                    raise HermitError(f"verification {label} lock timed out") from error
                time.sleep(0.05)
        lexical = path.lstat()
        locked = os.fstat(descriptor)
        if (
            (lexical.st_dev, lexical.st_ino) != (locked.st_dev, locked.st_ino)
            or not stat.S_ISREG(lexical.st_mode)
            or stat.S_IMODE(lexical.st_mode) != 0o600
        ):
            raise HermitError(f"verification {label} lock changed")
        yield descriptor
    finally:
        os.close(descriptor)


@contextmanager
def _verify_allocation_guard(attempt_root: Path) -> Iterator[None]:
    with _verified_lock_guard(
        _verify_allocation_lock(attempt_root),
        _VERIFY_ALLOCATION_LOCK_TIMEOUT_SECONDS,
        "allocation",
        inherit_on_fork=False,
    ):
        yield


@contextmanager
def _verify_command_guard(attempt_root: Path) -> Iterator[int]:
    with _verified_lock_guard(
        _verify_command_lock(attempt_root),
        _VERIFY_COMMAND_LOCK_TIMEOUT_SECONDS,
        "command",
        inherit_on_fork=True,
    ) as descriptor:
        yield descriptor


def _safehermit_deadline(argv: tuple[str, ...]) -> int:
    values: list[str] = []
    for index, token in enumerate(argv):
        if token == "--sh-deadline" and index + 1 < len(argv):
            values.append(argv[index + 1])
        elif token.startswith("--sh-deadline="):
            values.append(token.partition("=")[2])
    if len(values) != 1 or not values[0].isascii() or not values[0].isdecimal():
        raise HermitError("safehermit requires one numeric deadline")
    deadline = int(values[0])
    if deadline <= _HERMIT_UNWIND_SECONDS:
        raise HermitError("safehermit deadline leaves no Hermit unwind interval")
    return deadline


def hermit_witness_argv(argv: tuple[str, ...], attempt_root: Path) -> tuple[str, ...]:
    value = list(argv)
    report_index = value.index("--sh-report")
    if report_index + 1 >= len(value):
        raise HermitError("safehermit report argument is missing")
    value[report_index + 1] = str(attempt_root / "safehermit.json")
    verify_indexes = [
        index
        for index, token in enumerate(value)
        if token.startswith("--verify-log-dir=")
    ]
    if len(verify_indexes) != 1:
        raise HermitError("Hermit witness requires one verification log directory")
    value[verify_indexes[0]] = f"--verify-log-dir={attempt_root / 'verify'}"
    return tuple(value)


def _verify_log_dir(argv: tuple[str, ...]) -> Path:
    boundary = argv.index("--")
    values = [
        token.partition("=")[2]
        for token in argv[:boundary]
        if token.startswith("--verify-log-dir=")
    ]
    if len(values) != 1 or not values[0] or argv[:boundary].count("--keep-logs") != 1:
        raise HermitError("Hermit requires one retained verification log directory")
    value = Path(values[0])
    if not value.is_absolute():
        raise HermitError("Hermit verification log directory is not absolute")
    return value


def _replace_verify_log_dir(
    argv: tuple[str, ...], expected: Path, replacement: Path
) -> tuple[str, ...]:
    if _verify_log_dir(argv) != expected:
        raise HermitError("Hermit verification log directory escaped its attempt")
    value = list(argv)
    boundary = value.index("--")
    index = next(
        index
        for index, token in enumerate(value[:boundary])
        if token.startswith("--verify-log-dir=")
    )
    value[index] = f"--verify-log-dir={replacement}"
    return tuple(value)


def _current_verify_argv(argv: tuple[str, ...]) -> tuple[str, ...]:
    """Translate the sealed historical contract to a919's equally strict CLI."""
    boundary = argv.index("--")
    options = list(argv[:boundary])
    timeouts = [
        token.partition("=")[2] for token in options if token.startswith("--timeout=")
    ]
    if (
        options.count("--verify") != 1
        or options.count("--verify-strict") != 1
        or options.count("--keep-logs") != 1
        or options.count("--verify-verbose") != 0
        or len([token for token in options if token.startswith("--verify-log-dir=")])
        != 1
        or len(timeouts) != 1
        or not timeouts[0].isascii()
        or not timeouts[0].isdecimal()
    ):
        raise HermitError("historical strict verification contract is malformed")
    inner_deadline = int(timeouts[0])
    if inner_deadline != _safehermit_deadline(argv) - _HERMIT_UNWIND_SECONDS:
        raise HermitError("historical Hermit timeout contract is malformed")
    translated: list[str] = []
    index = 0
    while index < len(options):
        token = options[index]
        if token == "--verify-strict":
            translated.append("--verify-verbose")
        elif token == "--sh-deadline":
            translated.extend((token, str(inner_deadline)))
            index += 1
        elif token.startswith("--sh-deadline="):
            translated.append(f"--sh-deadline={inner_deadline}")
        elif (
            token == "--keep-logs"
            or token.startswith("--verify-log-dir=")
            or token.startswith("--timeout=")
        ):
            pass
        else:
            translated.append(token)
        index += 1
    if translated.count("--verify-verbose") != 1:
        raise HermitError("current strict verification contract is ambiguous")
    return (*translated, *argv[boundary:])


def _fd_mount_id(descriptor: int) -> int:
    try:
        lines = Path(f"/proc/self/fdinfo/{descriptor}").read_text().splitlines()
    except OSError as error:
        raise HermitError("cannot inspect verification output mount") from error
    values = [
        line.partition(":")[2].strip() for line in lines if line.startswith("mnt_id:")
    ]
    if len(values) != 1 or not values[0].isascii() or not values[0].isdecimal():
        raise HermitError("verification output mount identity is malformed")
    return int(values[0])


def _directory_record(path: Path, descriptor: int) -> dict[str, object]:
    metadata = os.fstat(descriptor)
    lexical = path.lstat()
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or not stat.S_ISDIR(lexical.st_mode)
        or (metadata.st_dev, metadata.st_ino) != (lexical.st_dev, lexical.st_ino)
    ):
        raise HermitError("verification output directory identity differs")
    return {
        "device": metadata.st_dev,
        "inode": metadata.st_ino,
        "kind": "directory",
        "mode": stat.S_IMODE(metadata.st_mode),
        "path": str(path),
    }


def _bounded_space_local_result(
    executable: Path, arguments: list[str], cwd: Path
) -> dict[str, object]:
    if not arguments or arguments[0] not in {"create", "destroy", "report"}:
        raise HermitError("bounded verification space operation is invalid")
    artifact = cwd / "bounded-space-control" / f"{arguments[0]}-{time.monotonic_ns()}"
    try:
        result = process_module.run_process(
            str(executable),
            tuple(arguments),
            cwd,
            artifact,
            _BOUNDED_SPACE_TIMEOUT_SECONDS,
            {"PATH": "/usr/local/bin:/usr/bin:/bin"},
        )
        stdout = result.stdout_path.read_text()
        stderr = result.stderr_path.read_text()
    except (OSError, RuntimeError) as error:
        raise HermitError("bounded verification space command failed") from error
    if result.timed_out:
        raise HermitError("bounded verification space command timed out")
    if len(stdout) > 16384 or len(stderr) > 16384:
        raise HermitError("bounded verification space response is too large")
    return {
        "argv": [str(executable), *arguments],
        "returncode": result.returncode,
        "process": regular_file_record(artifact / "metadata.json"),
        "stderr": stderr,
        "stdout": stdout,
    }


def _bounded_space_worker(
    executable: Path, arguments: list[str], cwd: Path, output: int
) -> None:
    try:
        try:
            receipt = _bounded_space_local_result(executable, arguments, cwd)
            value: dict[str, object] = {
                "ok": True,
                "receipt": {**receipt, "worker_pid": os.getpid()},
            }
        except Exception as error:
            value = {
                "error": f"{type(error).__name__}: {error}",
                "ok": False,
                "worker_pid": os.getpid(),
            }
        payload = json.dumps(value, sort_keys=True).encode()
        if len(payload) > 65536:
            payload = json.dumps(
                {
                    "error": "bounded verification worker response is too large",
                    "ok": False,
                    "worker_pid": os.getpid(),
                },
                sort_keys=True,
            ).encode()
        offset = 0
        while offset < len(payload):
            written = os.write(output, payload[offset:])
            if written <= 0:
                break
            offset += written
    except OSError:
        pass
    finally:
        os.close(output)
        os._exit(0)


def _read_bounded_space_worker(output: int) -> dict[str, object]:
    deadline = time.monotonic() + _VERIFY_COMMAND_WORKER_TIMEOUT_SECONDS
    payload = bytearray()
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise HermitError("bounded verification worker did not finish")
        readable, _, _ = select.select([output], [], [], remaining)
        if not readable:
            raise HermitError("bounded verification worker did not finish")
        chunk = os.read(output, 65536 - len(payload) + 1)
        if not chunk:
            break
        payload.extend(chunk)
        if len(payload) > 65536:
            raise HermitError("bounded verification worker response is too large")
    try:
        value = json.loads(payload)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise HermitError(
            "bounded verification worker response is malformed"
        ) from error
    if not isinstance(value, dict):
        raise HermitError("bounded verification worker response is malformed")
    receipt = value.get("receipt")
    if value.get("ok") is not True or not isinstance(receipt, dict):
        message = value.get("error")
        raise HermitError(
            message
            if isinstance(message, str) and message
            else "bounded verification worker failed"
        )
    return receipt


def _bounded_space_result(
    executable: Path, arguments: list[str], cwd: Path
) -> dict[str, object]:
    with _verify_command_guard(cwd):
        output, worker_input = os.pipe2(getattr(os, "O_CLOEXEC", 0))
        try:
            first_child = os.fork()
        except OSError:
            os.close(output)
            os.close(worker_input)
            raise
        if first_child == 0:
            os.close(output)
            try:
                os.setsid()
                second_child = os.fork()
            except OSError:
                os.close(worker_input)
                os._exit(125)
            if second_child != 0:
                os.close(worker_input)
                os._exit(0)
            _bounded_space_worker(executable, arguments, cwd, worker_input)
        os.close(worker_input)
        try:
            _pid, status = os.waitpid(first_child, 0)
            if status != 0:
                raise HermitError("bounded verification worker could not detach")
            return _read_bounded_space_worker(output)
        finally:
            os.close(output)


def _bounded_marker(path: Path) -> tuple[dict[str, object], int]:
    marker = path / ".BOUNDED_RUN_SPACE"
    record = regular_file_record(marker)
    lines = marker.read_text().splitlines()
    if len(lines) != 5 or lines[0] != "bounded-run-space/v1":
        raise HermitError("bounded verification space marker is malformed")
    fields: dict[str, str] = {}
    for line in lines[1:]:
        key, separator, value = line.partition("=")
        if not separator or key in fields or not value:
            raise HermitError("bounded verification space marker is malformed")
        fields[key] = value
    metadata = path.lstat()
    identity = f"{metadata.st_dev}:{metadata.st_ino}"
    limit = fields.get("limit_bytes", "")
    if (
        set(fields) != {"directory", "device_inode", "subvolume_id", "limit_bytes"}
        or fields["directory"] != str(path)
        or fields["device_inode"] != identity
        or not fields["subvolume_id"].isascii()
        or not fields["subvolume_id"].isdecimal()
        or not limit.isascii()
        or not limit.isdecimal()
        or int(limit) <= 0
    ):
        raise HermitError("bounded verification space marker differs")
    return record, int(limit)


def _prepare_verify_space(
    attempt_root: Path, bounded_run_space: Path, disk_limit: str
) -> _VerifySpace:
    log_root = _prepare_safehermit_log_root(attempt_root)
    tag = _verify_allocation_tag(attempt_root)
    receipt = _bounded_space_result(
        bounded_run_space,
        [
            "create",
            "--limit",
            disk_limit,
            "--tag",
            tag,
            "--base",
            str(log_root),
        ],
        attempt_root,
    )
    stdout = receipt["stdout"]
    if not isinstance(stdout, str):
        raise HermitError("bounded verification space response is malformed")
    lines = stdout.splitlines()
    if len(lines) != 1:
        raise HermitError("bounded verification space path is malformed")
    path = Path(lines[0])
    if not path.is_absolute() or not _verify_allocation_path_matches(
        path, attempt_root
    ):
        raise HermitError("bounded verification space escaped its attempt")
    if receipt["returncode"] != 0:
        cleanup = _bounded_space_result(
            bounded_run_space, ["destroy", str(path)], attempt_root
        )
        write_metadata(
            attempt_root / "verify-output-refusal.json",
            {
                "cleanup": cleanup,
                "create": receipt,
                "schema": "tfa.hermit.verify-output-refusal.v1",
            },
        )
        if cleanup["returncode"] != 0 or os.path.lexists(path):
            raise HermitError("unbounded verification space cleanup failed")
        raise HermitError("bounded verification space was not applied")
    try:
        space = _inspect_verify_space(path, disk_limit, receipt)
        space.verify_dir.mkdir(mode=0o700)
        return space
    except BaseException as error:
        if os.path.lexists(path):
            try:
                recovery = _inspect_verify_space(path, disk_limit, receipt)
                _destroy_verify_space(recovery, bounded_run_space, attempt_root)
            except Exception as cleanup_error:
                error.add_note(
                    f"bounded verification space cleanup also failed: {cleanup_error}"
                )
        raise


def _inspect_verify_space(
    path: Path, disk_limit: str, create_receipt: dict[str, object]
) -> _VerifySpace:
    descriptor = os.open(
        path,
        os.O_RDONLY
        | os.O_DIRECTORY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        root_record = _directory_record(path, descriptor)
        mount_id = _fd_mount_id(descriptor)
    finally:
        os.close(descriptor)
    marker_record, limit_bytes = _bounded_marker(path)
    return _VerifySpace(
        path,
        path / "verify",
        disk_limit,
        limit_bytes,
        mount_id,
        root_record,
        marker_record,
        create_receipt,
    )


def _open_verify_directory(parent: int, name: str, expected_mount_id: int) -> int:
    descriptor = os.open(
        name,
        os.O_RDONLY
        | os.O_DIRECTORY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
        dir_fd=parent,
    )
    try:
        lexical = os.stat(name, dir_fd=parent, follow_symlinks=False)
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISDIR(lexical.st_mode)
            or (lexical.st_dev, lexical.st_ino) != (opened.st_dev, opened.st_ino)
            or _fd_mount_id(descriptor) != expected_mount_id
        ):
            raise HermitError("verification output crossed a mount boundary")
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _copy_verify_file(
    source_parent: int,
    destination_parent: int | None,
    name: str,
    relative: str,
    expected_mount_id: int,
    remaining_bytes: int,
) -> dict[str, object]:
    descriptor = os.open(
        name,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
        dir_fd=source_parent,
    )
    output = -1
    try:
        before = os.fstat(descriptor)
        lexical = os.stat(name, dir_fd=source_parent, follow_symlinks=False)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or (before.st_dev, before.st_ino) != (lexical.st_dev, lexical.st_ino)
            or _fd_mount_id(descriptor) != expected_mount_id
            or before.st_size > remaining_bytes
        ):
            raise HermitError("verification output file is unsafe or exceeds its cap")
        if destination_parent is not None:
            output = os.open(
                name,
                os.O_WRONLY
                | os.O_CREAT
                | os.O_EXCL
                | getattr(os, "O_CLOEXEC", 0)
                | getattr(os, "O_NOFOLLOW", 0),
                stat.S_IMODE(before.st_mode),
                dir_fd=destination_parent,
            )
        digest = hashlib.sha256()
        size = 0
        while data := os.read(descriptor, 1024 * 1024):
            if size + len(data) > remaining_bytes:
                raise HermitError("verification output byte cap exceeded")
            digest.update(data)
            size += len(data)
            if output >= 0:
                offset = 0
                while offset < len(data):
                    written = os.write(output, data[offset:])
                    if written <= 0:
                        raise HermitError("verification output copy made no progress")
                    offset += written
        if output >= 0:
            os.fchmod(output, stat.S_IMODE(before.st_mode))
            os.fsync(output)
        after = os.fstat(descriptor)
        current = os.stat(name, dir_fd=source_parent, follow_symlinks=False)
        stable = ("st_dev", "st_ino", "st_mode", "st_nlink", "st_size", "st_mtime_ns")
        if any(
            getattr(before, field) != getattr(after, field) for field in stable
        ) or any(getattr(after, field) != getattr(current, field) for field in stable):
            raise HermitError("verification output changed while inventoried")
        return {
            "kind": "file",
            "mode": stat.S_IMODE(after.st_mode),
            "path": relative,
            "sha256": digest.hexdigest(),
            "size": size,
        }
    finally:
        if output >= 0:
            os.close(output)
        os.close(descriptor)


def _verify_output_inventory(
    root: Path, *, destination: Path | None = None, expected_mount_id: int | None = None
) -> dict[str, object]:
    flags = (
        os.O_RDONLY
        | os.O_DIRECTORY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    root_descriptor = os.open(root, flags)
    destination_descriptor = -1
    try:
        mount_id = _fd_mount_id(root_descriptor)
        if expected_mount_id is not None and mount_id != expected_mount_id:
            raise HermitError("verification output root crossed a mount boundary")
        root_record = _directory_record(root, root_descriptor)
        if destination is not None:
            destination.mkdir(mode=stat.S_IMODE(os.fstat(root_descriptor).st_mode))
            destination_descriptor = os.open(destination, flags)
        entries: list[dict[str, object]] = []
        total_bytes = 0

        def visit(
            source: int, target: int | None, prefix: tuple[str, ...], depth: int
        ) -> None:
            nonlocal total_bytes
            if depth > 32:
                raise HermitError("verification output depth cap exceeded")
            for name in sorted(os.listdir(source)):
                if name in ("", ".", "..") or Path(name).name != name:
                    raise HermitError("verification output name is invalid")
                if len(entries) >= _VERIFY_OUTPUT_MAX_ENTRIES:
                    raise HermitError("verification output entry cap exceeded")
                relative = str(Path(*prefix, name))
                metadata = os.stat(name, dir_fd=source, follow_symlinks=False)
                if stat.S_ISDIR(metadata.st_mode):
                    child = _open_verify_directory(source, name, mount_id)
                    target_child = -1
                    try:
                        if target is not None:
                            os.mkdir(
                                name, stat.S_IMODE(metadata.st_mode), dir_fd=target
                            )
                            target_child = _open_verify_directory(
                                target, name, _fd_mount_id(target)
                            )
                        entries.append(
                            {
                                "kind": "directory",
                                "mode": stat.S_IMODE(metadata.st_mode),
                                "path": relative,
                            }
                        )
                        visit(
                            child,
                            target_child if target_child >= 0 else None,
                            (*prefix, name),
                            depth + 1,
                        )
                        if target_child >= 0:
                            os.fsync(target_child)
                    finally:
                        if target_child >= 0:
                            os.close(target_child)
                        os.close(child)
                elif stat.S_ISREG(metadata.st_mode):
                    record = _copy_verify_file(
                        source,
                        target,
                        name,
                        relative,
                        mount_id,
                        _VERIFY_OUTPUT_MAX_BYTES - total_bytes,
                    )
                    size = record.get("size")
                    if not isinstance(size, int) or isinstance(size, bool):
                        raise HermitError("verification output size is malformed")
                    total_bytes += size
                    entries.append(record)
                else:
                    raise HermitError("verification output has unsupported type")

        visit(
            root_descriptor,
            destination_descriptor if destination_descriptor >= 0 else None,
            (),
            0,
        )
        if destination_descriptor >= 0:
            os.fsync(destination_descriptor)
        return {
            "entries": entries,
            "entry_count": len(entries),
            "max_bytes": _VERIFY_OUTPUT_MAX_BYTES,
            "max_entries": _VERIFY_OUTPUT_MAX_ENTRIES,
            "root": root_record,
            "total_bytes": total_bytes,
        }
    finally:
        if destination_descriptor >= 0:
            os.close(destination_descriptor)
        os.close(root_descriptor)


def _bounded_space_report(
    space: _VerifySpace, bounded_run_space: Path, attempt_root: Path
) -> dict[str, object]:
    _validate_live_verify_space(space)
    receipt = _bounded_space_result(
        bounded_run_space, ["report", str(space.path)], attempt_root
    )
    stdout = receipt["stdout"]
    if receipt["returncode"] != 0 or not isinstance(stdout, str):
        raise HermitError("bounded verification space did not remain under quota")
    match = re.fullmatch(
        r"referenced=([0-9]+) exclusive=([0-9]+) limit=([0-9]+)\n?", stdout
    )
    if match is None or int(match.group(3)) != space.limit_bytes:
        raise HermitError("bounded verification space report is malformed")
    return {
        **receipt,
        "exclusive_bytes": int(match.group(2)),
        "limit_bytes": int(match.group(3)),
        "referenced_bytes": int(match.group(1)),
    }


def _validate_live_verify_space(space: _VerifySpace) -> None:
    descriptor = os.open(
        space.path,
        os.O_RDONLY
        | os.O_DIRECTORY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        if (
            _directory_record(space.path, descriptor) != space.root_record
            or _fd_mount_id(descriptor) != space.mount_id
        ):
            raise HermitError("bounded verification space mount differs")
    finally:
        os.close(descriptor)
    if regular_file_record(space.path / ".BOUNDED_RUN_SPACE") != space.marker_record:
        raise HermitError("bounded verification space marker changed")


def _destroy_verify_space(
    space: _VerifySpace, bounded_run_space: Path, attempt_root: Path
) -> dict[str, object]:
    _validate_live_verify_space(space)
    receipt = _bounded_space_result(
        bounded_run_space, ["destroy", str(space.path)], attempt_root
    )
    if receipt["returncode"] != 0 or os.path.lexists(space.path):
        raise HermitError("bounded verification space cleanup failed")
    return receipt


def _verify_transaction_path(attempt_root: Path) -> Path:
    return attempt_root / "verify-output-transaction.json"


def _verify_space_fields(attempt_root: Path, space: _VerifySpace) -> dict[str, object]:
    return {
        "allocation_key": _verify_allocation_key(attempt_root),
        "bounded_tree": space.root_record,
        "create": space.create_receipt,
        "disk_limit": space.disk_limit,
        "limit_bytes": space.limit_bytes,
        "marker": space.marker_record,
        "mount_id": space.mount_id,
        "verify_log_dir": str(space.verify_dir),
    }


def _write_verify_transaction(
    attempt_root: Path,
    space: _VerifySpace,
    phase: str,
    **details: object,
) -> None:
    write_metadata(
        _verify_transaction_path(attempt_root),
        {
            **_verify_space_fields(attempt_root, space),
            **details,
            "phase": phase,
            "schema": _VERIFY_TRANSACTION_SCHEMA,
        },
    )


def _space_from_transaction(
    attempt_root: Path, value: object
) -> tuple[_VerifySpace, str]:
    if not isinstance(value, dict):
        raise HermitError("verification allocation transaction is malformed")
    phase = value.get("phase")
    path_value = value.get("verify_log_dir")
    bounded_tree = value.get("bounded_tree")
    marker = value.get("marker")
    create = value.get("create")
    mount_id = value.get("mount_id")
    limit_bytes = value.get("limit_bytes")
    disk_limit = value.get("disk_limit")
    key = _verify_allocation_key(attempt_root)
    if (
        value.get("schema") != _VERIFY_TRANSACTION_SCHEMA
        or value.get("allocation_key") != key
        or not isinstance(phase, str)
        or phase
        not in {
            "prepared",
            "finalizing",
            "destroyed",
            "finalized",
            "cleanup_failed",
            "recovered",
        }
        or not isinstance(path_value, str)
        or not isinstance(bounded_tree, dict)
        or not isinstance(marker, dict)
        or not isinstance(create, dict)
        or not isinstance(mount_id, int)
        or isinstance(mount_id, bool)
        or mount_id <= 0
        or not isinstance(limit_bytes, int)
        or isinstance(limit_bytes, bool)
        or limit_bytes <= 0
        or not isinstance(disk_limit, str)
        or not disk_limit
    ):
        raise HermitError("verification allocation transaction is malformed")
    verify_dir = Path(path_value)
    path = verify_dir.parent
    expected_tag = _verify_allocation_tag(attempt_root)
    bounded_run_space = safehermit_runtime_paths(attempt_root)[1]
    if (
        verify_dir.name != "verify"
        or not _verify_allocation_path_matches(path, attempt_root)
        or bounded_tree.get("path") != str(path)
        or bounded_tree.get("kind") != "directory"
        or marker.get("path") != str(path / ".BOUNDED_RUN_SPACE")
        or marker.get("kind") != "file"
        or create.get("argv")
        != [
            str(bounded_run_space),
            "create",
            "--limit",
            disk_limit,
            "--tag",
            expected_tag,
            "--base",
            str(_safehermit_log_root(attempt_root)),
        ]
        or create.get("returncode") != 0
        or create.get("stdout") != f"{path}\n"
    ):
        raise HermitError("verification allocation transaction differs")
    return (
        _VerifySpace(
            path,
            verify_dir,
            disk_limit,
            limit_bytes,
            mount_id,
            bounded_tree,
            marker,
            create,
        ),
        phase,
    )


def _read_verify_transaction(attempt_root: Path) -> tuple[_VerifySpace, str] | None:
    path = _verify_transaction_path(attempt_root)
    if not os.path.lexists(path):
        return None
    try:
        value = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise HermitError(
            "verification allocation transaction is unreadable"
        ) from error
    return _space_from_transaction(attempt_root, value)


def _cleanup_failed_verify_space(
    attempt_root: Path,
    space: _VerifySpace,
    bounded_run_space: Path,
    error: BaseException,
) -> None:
    try:
        destroy = (
            _destroy_verify_space(space, bounded_run_space, attempt_root)
            if os.path.lexists(space.path)
            else None
        )
        _write_verify_transaction(
            attempt_root,
            space,
            "recovered",
            destroy=destroy,
            primary_error=f"{type(error).__name__}: {error}",
        )
    except Exception as cleanup_error:
        try:
            _write_verify_transaction(
                attempt_root,
                space,
                "cleanup_failed",
                cleanup_error=f"{type(cleanup_error).__name__}: {cleanup_error}",
                primary_error=f"{type(error).__name__}: {error}",
            )
        except Exception as record_error:
            cleanup_error.add_note(f"transaction recording also failed: {record_error}")
        error.add_note(
            f"bounded verification space cleanup also failed: {cleanup_error}"
        )


def _recover_prior_verify_transaction(
    attempt_root: Path, bounded_run_space: Path
) -> bool:
    transaction = _read_verify_transaction(attempt_root)
    if transaction is None:
        return False
    space, phase = transaction
    if phase in {"finalized", "recovered"} and not os.path.lexists(space.path):
        return True
    destroy = (
        _destroy_verify_space(space, bounded_run_space, attempt_root)
        if os.path.lexists(space.path)
        else None
    )
    _write_verify_transaction(
        attempt_root,
        space,
        "recovered",
        destroy=destroy,
        previous_phase=phase,
    )
    return True


def _recover_orphaned_verify_spaces(
    attempt_root: Path, bounded_run_space: Path
) -> list[dict[str, object]]:
    recovered: list[dict[str, object]] = []
    pattern = re.compile(
        rf"^{re.escape(_VERIFY_ALLOCATION_NAME_PREFIX)}"
        r"[0-9a-f]{24}-[1-9][0-9]*-[1-9][0-9]*$"
    )
    try:
        entries = sorted(
            os.scandir(_safehermit_log_root(attempt_root)), key=lambda item: item.name
        )
    except OSError as error:
        raise HermitError("cannot inventory bounded verification spaces") from error
    for entry in entries:
        if not pattern.fullmatch(entry.name):
            continue
        if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
            raise HermitError("orphaned verification allocation has unsafe type")
        path = Path(entry.path)
        space = _inspect_verify_space(
            path,
            "recovered",
            {
                "argv": [str(bounded_run_space), "recovered", str(path)],
                "returncode": 0,
                "stderr": "",
                "stdout": f"{path}\n",
            },
        )
        recovered.append(
            {
                "bounded_tree": space.root_record,
                "destroy": _destroy_verify_space(
                    space, bounded_run_space, attempt_root
                ),
                "marker": space.marker_record,
                "mount_id": space.mount_id,
                "path": str(path),
            }
        )
    if recovered:
        write_metadata(
            attempt_root / "verify-output-orphan-recovery.json",
            {
                "allocations": recovered,
                "schema": "tfa.hermit.verify-output-orphan-recovery.v1",
            },
        )
    return recovered


def _reconcile_verify_allocations(attempt_root: Path, bounded_run_space: Path) -> None:
    with _verify_command_guard(attempt_root):
        pass
    prior = _recover_prior_verify_transaction(attempt_root, bounded_run_space)
    recovered = _recover_orphaned_verify_spaces(attempt_root, bounded_run_space)
    if prior or recovered:
        raise HermitError(
            "prior bounded verification allocation was recovered; use a fresh attempt"
        )


def _finalize_verify_space(
    attempt_root: Path, space: _VerifySpace, bounded_run_space: Path
) -> dict[str, object]:
    _write_verify_transaction(attempt_root, space, "finalizing")
    report = _bounded_space_report(space, bounded_run_space, attempt_root)
    destination = attempt_root / "verify"
    source_inventory = _verify_output_inventory(
        space.verify_dir, destination=destination, expected_mount_id=space.mount_id
    )
    copied_inventory = _verify_output_inventory(destination)
    if source_inventory["entries"] != copied_inventory["entries"] or any(
        source_inventory[field] != copied_inventory[field]
        for field in ("entry_count", "max_bytes", "max_entries", "total_bytes")
    ):
        raise HermitError("copied verification output differs")
    destroy = _destroy_verify_space(space, bounded_run_space, attempt_root)
    _write_verify_transaction(
        attempt_root,
        space,
        "destroyed",
        copied_output=copied_inventory,
        destroy=destroy,
        report=report,
    )
    evidence: dict[str, object] = {
        "allocation_key": _verify_allocation_key(attempt_root),
        "bounded_tree": space.root_record,
        "copied_output": copied_inventory,
        "copied_output_root": str(destination),
        "create": space.create_receipt,
        "destroy": destroy,
        "disk_limit": space.disk_limit,
        "limit_bytes": space.limit_bytes,
        "marker": space.marker_record,
        "mount_id": space.mount_id,
        "phase": "finalized",
        "report": report,
        "schema": "tfa.hermit.verify-output.v1",
        "verify_log_dir": str(space.verify_dir),
    }
    write_metadata(attempt_root / "verify-output.json", evidence)
    _write_verify_transaction(
        attempt_root,
        space,
        "finalized",
        copied_output=copied_inventory,
        destroy=destroy,
        final_evidence=regular_file_record(attempt_root / "verify-output.json"),
        report=report,
    )
    return evidence


def _recorded_verify_log_dir(attempt_root: Path) -> Path:
    try:
        value = json.loads((attempt_root / "verify-output.json").read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise HermitError("verification output evidence is unreadable") from error
    path = value.get("verify_log_dir") if isinstance(value, dict) else None
    if not isinstance(path, str) or not Path(path).is_absolute():
        raise HermitError("verification output evidence is malformed")
    return Path(path)


def hermit_recorded_attempt_argv(
    argv: tuple[str, ...],
    guest_cwd: Path,
    controller_cwd: Path,
    attempt_root: Path,
    outer_timeout_seconds: float,
    wrapper: Path | None = None,
) -> tuple[str, ...]:
    rewritten = _replace_verify_log_dir(
        argv, attempt_root / "verify", _recorded_verify_log_dir(attempt_root)
    )
    return hermit_attempt_argv(
        rewritten,
        guest_cwd,
        controller_cwd,
        outer_timeout_seconds,
        wrapper,
    )


def hermit_attempt_argv(
    argv: tuple[str, ...],
    guest_cwd: Path,
    controller_cwd: Path,
    outer_timeout_seconds: float,
    wrapper: Path | None = None,
) -> tuple[str, ...]:
    if not argv or argv[0] != SAFEHERMIT:
        raise HermitError("Hermit attempts must use the pinned safehermit entry point")
    if not guest_cwd.is_absolute() or not controller_cwd.is_absolute():
        raise HermitError("Hermit working directories must be absolute")
    if not math.isfinite(outer_timeout_seconds) or outer_timeout_seconds <= 0:
        raise HermitError("outer timeout must be positive and finite")
    safehermit_deadline = _safehermit_deadline(argv)
    hermit_deadline = safehermit_deadline - _HERMIT_UNWIND_SECONDS
    if outer_timeout_seconds < safehermit_deadline + _OUTER_CLEANUP_SECONDS:
        raise HermitError("outer timeout leaves no safehermit cleanup interval")
    boundary = argv.index("--")
    if any(
        token == "--timeout"
        or token.startswith("--timeout=")
        or token == "--workdir"
        or token.startswith("--workdir=")
        for token in argv[:boundary]
    ):
        raise HermitError("Hermit timeout or workdir is already populated")
    guest_mount = f"--mount=type=bind,source={guest_cwd},target={guest_cwd}"
    if guest_mount not in argv[:boundary]:
        raise HermitError("sealed guest working directory is not mounted same-path")
    controller_mount = (
        f"--mount=type=bind,source={controller_cwd},target={controller_cwd}"
    )
    executable = Path(argv[0]) if wrapper is None else wrapper
    if not executable.is_absolute():
        raise HermitError("safehermit wrapper path must be absolute")
    return (
        str(executable),
        *argv[1:boundary],
        controller_mount,
        f"--workdir={guest_cwd}",
        f"--timeout={hermit_deadline}",
        *argv[boundary:],
    )


def _pin_safehermit(
    source: Path, destination: Path, expected_sha256: str
) -> dict[str, object]:
    source_descriptor = os.open(
        source,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
    )
    destination_descriptor = -1
    completed = False
    try:
        before = os.fstat(source_descriptor)
        lexical = source.lstat()
        if (
            not stat.S_ISREG(before.st_mode)
            or not stat.S_ISREG(lexical.st_mode)
            or (before.st_dev, before.st_ino) != (lexical.st_dev, lexical.st_ino)
            or stat.S_IMODE(before.st_mode) & 0o111 == 0
        ):
            raise HermitError("safehermit source is not a pinned executable")
        destination_descriptor = os.open(
            destination,
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
            0o500,
        )
        digest = hashlib.sha256()
        size = 0
        while data := os.read(source_descriptor, 65536):
            digest.update(data)
            size += len(data)
            offset = 0
            while offset < len(data):
                written = os.write(destination_descriptor, data[offset:])
                if written <= 0:
                    raise HermitError("safehermit wrapper copy made no progress")
                offset += written
        os.fchmod(destination_descriptor, 0o500)
        os.fsync(destination_descriptor)
        after = os.fstat(source_descriptor)
        current = source.lstat()
        stable = (
            "st_dev",
            "st_ino",
            "st_mode",
            "st_size",
            "st_mtime_ns",
            "st_ctime_ns",
        )
        if any(getattr(before, field) != getattr(after, field) for field in stable) or (
            current.st_dev,
            current.st_ino,
            current.st_mode,
            current.st_size,
            current.st_mtime_ns,
            current.st_ctime_ns,
        ) != tuple(getattr(after, field) for field in stable):
            raise HermitError("safehermit source changed while it was pinned")
        if digest.hexdigest() != expected_sha256:
            raise HermitError("safehermit wrapper hash differs")
        record = regular_file_record(destination)
        if (
            record.get("sha256") != expected_sha256
            or record.get("size") != size
            or record.get("mode") != 0o500
        ):
            raise HermitError("pinned safehermit wrapper differs")
        parent_descriptor = os.open(
            destination.parent,
            os.O_RDONLY
            | os.O_DIRECTORY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
        try:
            os.fsync(parent_descriptor)
        finally:
            os.close(parent_descriptor)
        completed = True
        return record
    finally:
        if destination_descriptor >= 0:
            os.close(destination_descriptor)
        os.close(source_descriptor)
        if not completed:
            try:
                destination.unlink()
            except FileNotFoundError:
                pass


def safehermit_wrapper_path(attempt_root: Path) -> Path:
    return attempt_root / "safehermit-runtime" / "bin" / "safehermit"


def safehermit_runtime_paths(attempt_root: Path) -> tuple[Path, Path]:
    wrapper = safehermit_wrapper_path(attempt_root)
    return wrapper, wrapper.parent.parent / "scripts" / "bounded-run-space"


def _pin_safehermit_runtime(attempt_root: Path) -> dict[str, object]:
    wrapper, bounded_run_space = safehermit_runtime_paths(attempt_root)
    wrapper.parent.mkdir(parents=True, mode=0o700)
    bounded_run_space.parent.mkdir(mode=0o700)
    return {
        "safehermit": _pin_safehermit(
            _packaged_resource("safehermit"), wrapper, SAFEHERMIT_SHA256
        ),
        "bounded_run_space": _pin_safehermit(
            _packaged_resource("bounded-run-space"),
            bounded_run_space,
            BOUNDED_RUN_SPACE_SHA256,
        ),
    }


def _existing_safehermit_runtime(attempt_root: Path) -> dict[str, object] | None:
    inputs_path = attempt_root / "execution-inputs.json"
    if not os.path.lexists(inputs_path):
        return None
    try:
        inputs = json.loads(inputs_path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise HermitError("safehermit execution inputs are unreadable") from error
    wrapper, bounded_run_space = safehermit_runtime_paths(attempt_root)
    wrapper_record = inputs.get("safehermit") if isinstance(inputs, dict) else None
    bounded_record = (
        inputs.get("bounded_run_space") if isinstance(inputs, dict) else None
    )
    if not isinstance(wrapper_record, dict) or not isinstance(bounded_record, dict):
        raise HermitError("safehermit execution inputs are malformed")
    try:
        verify_regular_file_record(wrapper, wrapper_record)
        verify_regular_file_record(bounded_run_space, bounded_record)
    except StateError as error:
        raise HermitError("safehermit execution input differs") from error
    if (
        wrapper_record.get("sha256") != SAFEHERMIT_SHA256
        or wrapper_record.get("mode") != 0o500
        or bounded_record.get("sha256") != BOUNDED_RUN_SPACE_SHA256
        or bounded_record.get("mode") != 0o500
    ):
        raise HermitError("safehermit execution input differs")
    return {"safehermit": wrapper_record, "bounded_run_space": bounded_record}


def _prepare_safehermit_runtime(attempt_root: Path) -> dict[str, object]:
    existing = _existing_safehermit_runtime(attempt_root)
    if existing is not None:
        return existing
    execution_inputs = _pin_safehermit_runtime(attempt_root)
    write_metadata(attempt_root / "execution-inputs.json", execution_inputs)
    return execution_inputs


def _safehermit_flag(argv: tuple[str, ...], name: str) -> str:
    values: list[str] = []
    for index, token in enumerate(argv):
        if token == name and index + 1 < len(argv):
            values.append(argv[index + 1])
        elif token.startswith(name + "="):
            values.append(token.partition("=")[2])
    if len(values) != 1 or not values[0]:
        raise HermitError(f"safehermit requires one {name}")
    return values[0]


def _safehermit_binary(argv: tuple[str, ...]) -> Path:
    value_flags = {
        "--sh-bin",
        "--sh-deadline",
        "--sh-report",
        "--sh-resource-report",
        "--sh-memory-max-bytes",
        "--sh-tasks-max",
        "--sh-cpu-cores",
        "--sh-cpu-timeout",
        "--sh-max-log-bytes",
        "--sh-disk-limit",
    }
    index = 1
    while index < len(argv):
        token = argv[index]
        if token in value_flags:
            index += 2
        elif any(token.startswith(flag + "=") for flag in value_flags) or token in (
            "--sh-fresh",
            "--sh-no-deadline",
        ):
            index += 1
        else:
            break
    if index >= len(argv):
        raise HermitError("safehermit binary is missing")
    binary = Path(argv[index])
    if not binary.is_absolute():
        raise HermitError("safehermit binary is not absolute")
    return binary


def _qualification_receipt_record(
    qualification: Mapping[str, object],
) -> dict[str, object]:
    resource_name = qualification.get("receipts_resource")
    expected_digest = qualification.get("receipts_sha256")
    if (
        resource_name != _PACKAGED_HERMIT_RECEIPTS_RESOURCE
        or expected_digest != PACKAGED_HERMIT_RECEIPTS_SHA256
    ):
        raise HermitError("packaged Hermit qualification receipt binding is malformed")
    path = _packaged_resource(_PACKAGED_HERMIT_RECEIPTS_RESOURCE)
    try:
        before = regular_file_record(path)
        receipts = json.loads(path.read_text())
        after = regular_file_record(path)
    except (OSError, json.JSONDecodeError, StateError) as error:
        raise HermitError(
            "packaged Hermit qualification receipts are unreadable"
        ) from error
    if (
        before != after
        or before.get("sha256") != expected_digest
        or not isinstance(receipts, dict)
        or receipts.get("schema_version") != 1
        or receipts.get("probe_binary")
        != {
            "build_mode": qualification.get("mode"),
            "configured_target": qualification.get("configured_target"),
            "sha256": qualification.get("sha256"),
            "upstream_revision": PACKAGED_HERMIT_REVISION,
        }
        or receipts.get("bounds")
        != {
            "deadline_seconds": 120,
            "disk_limit": "8G",
            "max_log_bytes": 67108864,
        }
        or not isinstance(receipts.get("probes"), list)
    ):
        raise HermitError("packaged Hermit qualification receipts are malformed")
    expected_markers = {
        "asyncssl": (
            1,
            1,
            "AddressSanitizer: CHECK failed",
            "setrlimit(RLIMIT_CORE",
        ),
        "thrift": (0, 132, "ThreadSanitizer: CHECK failed", "signal=SIGILL"),
        "httpcoro": (
            1,
            1,
            "Clock perf counter exceeds target value",
            "Sandbox container exited unexpectedly",
        ),
    }
    observed: list[tuple[str, int, int]] = []
    for probe in receipts["probes"]:
        if not isinstance(probe, dict):
            raise HermitError("packaged Hermit qualification probe is malformed")
        case_id = probe.get("case_id")
        if not isinstance(case_id, str):
            raise HermitError("packaged Hermit qualification probe is malformed")
        expected = expected_markers.get(case_id)
        argv = probe.get("argv")
        stderr = probe.get("stderr")
        stdout = probe.get("stdout")
        result_receipt = probe.get("result_receipt")
        safehermit_report = probe.get("safehermit_report")
        if (
            expected is None
            or not isinstance(argv, list)
            or not all(isinstance(token, str) for token in argv)
            or not isinstance(stderr, str)
            or not isinstance(stdout, str)
            or not isinstance(result_receipt, str)
            or not isinstance(safehermit_report, str)
            or probe.get("seed") != expected[0]
            or probe.get("returncode") != expected[1]
            or expected[2] not in stderr
            or expected[3] not in stderr
            or "--sh-deadline" not in argv
            or argv[argv.index("--sh-deadline") + 1] != "120"
            or "--sh-max-log-bytes" not in argv
            or argv[argv.index("--sh-max-log-bytes") + 1] != "67108864"
            or "--sh-disk-limit" not in argv
            or argv[argv.index("--sh-disk-limit") + 1] != "8G"
            or hashlib.sha256(
                (json.dumps(argv, separators=(",", ":")) + "\n").encode()
            ).hexdigest()
            != probe.get("argv_sha256")
            or hashlib.sha256(stderr.encode()).hexdigest() != probe.get("stderr_sha256")
            or hashlib.sha256(stdout.encode()).hexdigest() != probe.get("stdout_sha256")
            or hashlib.sha256((result_receipt + "\n").encode()).hexdigest()
            != probe.get("result_receipt_sha256")
            or hashlib.sha256(safehermit_report.encode()).hexdigest()
            != probe.get("safehermit_report_sha256")
        ):
            raise HermitError("packaged Hermit qualification probe is malformed")
        try:
            result = json.loads(result_receipt)
        except json.JSONDecodeError as error:
            raise HermitError(
                "packaged Hermit qualification result receipt is malformed"
            ) from error
        required_report_lines = {
            f"safehermit: binary_sha256={qualification.get('sha256')}",
            "safehermit: bound.wall=APPLIED:120s",
            "safehermit: bound.disk=APPLIED:8G for log_dir only; guest paths and "
            "explicit log files elsewhere are outside this bound",
            "safehermit: bound.bytes=APPLIED:67108864 "
            "(LETHAL: the run is cgroup-killed at the cap)",
            "safehermit: truncated=false",
            f"safehermit: exit_code={expected[1]}",
        }
        if (
            not isinstance(result, dict)
            or result.get("argv") != argv
            or result.get("case_id") != case_id
            or result.get("outcome_label") != "pass"
            or result.get("returncode") != expected[1]
            or not isinstance(result.get("duration_seconds"), (int, float))
            or not math.isfinite(result["duration_seconds"])
            or result["duration_seconds"] <= 0
            or not safehermit_report.endswith("\n")
            or not required_report_lines.issubset(safehermit_report.splitlines())
        ):
            raise HermitError(
                "packaged Hermit qualification result provenance is malformed"
            )
        observed.append((case_id, expected[0], expected[1]))
    candidates = qualification.get("short_candidates")
    if not isinstance(candidates, list) or observed != [
        (candidate.get("case_id"), candidate.get("seed"), candidate.get("returncode"))
        for candidate in candidates
        if isinstance(candidate, dict)
    ]:
        raise HermitError(
            "packaged Hermit qualification candidates differ from receipts"
        )
    return before


def packaged_hermit_argv(
    argv: tuple[str, ...],
    expected_revision: str,
    expected_sha256: str,
    destination: Path,
) -> tuple[str, ...]:
    compatibility_path = _packaged_resource(_PACKAGED_HERMIT_COMPATIBILITY_RESOURCE)
    try:
        compatibility_before = regular_file_record(compatibility_path)
        compatibility = json.loads(compatibility_path.read_text())
        compatibility_after = regular_file_record(compatibility_path)
    except (OSError, json.JSONDecodeError, StateError) as error:
        raise HermitError(
            "packaged Hermit compatibility record is unreadable"
        ) from error
    if compatibility_before != compatibility_after or not isinstance(
        compatibility, dict
    ):
        raise HermitError("packaged Hermit compatibility record changed while read")
    qualification = compatibility.get("qualification_probe")
    packaged = compatibility.get("packaged_executable")
    historical = compatibility.get("historical_witness")
    packaged_blockers = (
        packaged.get("observed_blockers") if isinstance(packaged, dict) else None
    )
    blockers = (
        qualification.get("blockers") if isinstance(qualification, dict) else None
    )
    if (
        compatibility.get("schema_version") != 1
        or compatibility.get("target")
        != "fbcode//hermetic_infra/hermit/hermit-cli:hermit"
        or compatibility.get("resource") != _PACKAGED_HERMIT_RESOURCE
        or compatibility.get("upstream_revision") != PACKAGED_HERMIT_REVISION
        or not isinstance(compatibility.get("fbsource_import_commit"), str)
        or re.fullmatch(
            r"[0-9a-f]{40}", str(compatibility.get("fbsource_import_commit"))
        )
        is None
        or not isinstance(historical, dict)
        or re.fullmatch(r"[0-9a-f]{40}", str(historical.get("revision"))) is None
        or re.fullmatch(r"[0-9a-f]{64}", str(historical.get("sha256"))) is None
        or historical.get("state") != "PRESERVED"
        or not isinstance(qualification, dict)
        or not isinstance(packaged, dict)
        or packaged.get("sha256") != PACKAGED_HERMIT_RESOURCE_SHA256
        or packaged.get("configured_target")
        != (
            "fbcode//hermetic_infra/hermit/hermit-cli:hermit "
            "(ovr_config//platform/linux:x86_64-fbcode-platform010-clang"
            "#512fd0a9ea51f545)"
        )
        or packaged.get("state") not in ("BLOCKED", "QUALIFIED")
        or not isinstance(packaged_blockers, list)
        or not all(
            isinstance(blocker, str) and blocker for blocker in packaged_blockers
        )
        or (packaged.get("state") == "BLOCKED") != bool(packaged_blockers)
        or qualification.get("sha256") != PACKAGED_HERMIT_QUALIFICATION_SHA256
        or qualification.get("configured_target")
        != (
            "fbcode//hermetic_infra/hermit/hermit-cli:hermit "
            "(cfg:opt-linux-x86_64-fbcode-platform010-clang21-no-san"
            "#ac368791f452debc)"
        )
        or qualification.get("state") not in ("BLOCKED", "QUALIFIED")
        or not isinstance(blockers, list)
        or not all(isinstance(blocker, str) and blocker for blocker in blockers)
        or (qualification.get("state") == "BLOCKED") != bool(blockers)
    ):
        raise HermitError("packaged Hermit compatibility record is malformed")
    receipt_record = _qualification_receipt_record(qualification)
    binary = _packaged_resource(_PACKAGED_HERMIT_RESOURCE)
    try:
        record = regular_file_record(binary)
        metadata = binary.lstat()
    except (OSError, StateError) as error:
        raise HermitError("packaged Hermit binary is unavailable") from error
    packaged_sha256 = record.get("sha256")
    if (
        not isinstance(packaged_sha256, str)
        or not stat.S_ISREG(metadata.st_mode)
        or stat.S_IMODE(metadata.st_mode) & 0o111 == 0
    ):
        raise HermitError("packaged Hermit executable differs from its provenance")
    qualification_sha256 = str(qualification["sha256"])
    if packaged_sha256 != packaged["sha256"]:
        compatibility_state = "PROVENANCE_MISMATCH"
    elif packaged["state"] != "QUALIFIED":
        compatibility_state = "BLOCKED"
    elif packaged_sha256 != qualification_sha256:
        compatibility_state = "UNASSESSED_VARIANT"
    elif qualification["state"] != "QUALIFIED":
        compatibility_state = "BLOCKED"
    elif (
        expected_revision != PACKAGED_HERMIT_REVISION
        or expected_sha256 != packaged_sha256
    ):
        compatibility_state = "WITNESS_MISMATCH"
    else:
        compatibility_state = "QUALIFIED"
    destination.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    write_metadata(
        destination.parent / "identity.json",
        {
            "blockers": blockers,
            "expected_witness": {
                "revision": expected_revision,
                "sha256": expected_sha256,
            },
            "fbsource_import_commit": compatibility["fbsource_import_commit"],
            "packaged_executable": {
                **record,
                "configured_target": packaged["configured_target"],
                "state": packaged["state"],
            },
            "packaged_blockers": packaged_blockers,
            "qualification_receipts": receipt_record,
            "packaged_revision": PACKAGED_HERMIT_REVISION,
            "qualification": {
                "configured_target": qualification["configured_target"],
                "mode": qualification["mode"],
                "sha256": qualification_sha256,
                "state": qualification["state"],
            },
            "schema": "tfa.packaged-hermit-compatibility.v1",
            "state": compatibility_state,
            "target": compatibility["target"],
        },
    )
    if compatibility_state in (
        "BLOCKED",
        "PROVENANCE_MISMATCH",
        "UNASSESSED_VARIANT",
    ):
        raise HermitError(
            f"packaged Hermit compatibility is {compatibility_state}: "
            f"expected revision={expected_revision} sha256={expected_sha256}; "
            f"target={compatibility['target']} "
            f"import_commit={compatibility['fbsource_import_commit']} "
            f"packaged revision={PACKAGED_HERMIT_REVISION} "
            f"sha256={packaged_sha256}; "
            f"qualification probe sha256={qualification_sha256} "
            f"state={qualification['state']}; "
            f"qualification blockers={'; '.join(blockers)}; "
            f"packaged blockers={'; '.join(packaged_blockers)}"
        )
    if compatibility_state == "WITNESS_MISMATCH":
        raise HermitError(
            "packaged Hermit identity differs from the qualified witness: "
            f"expected revision={expected_revision} sha256={expected_sha256}; "
            f"packaged revision={PACKAGED_HERMIT_REVISION} "
            f"sha256={packaged_sha256}"
        )
    if os.path.lexists(destination):
        pinned = regular_file_record(destination)
        if pinned.get("sha256") != packaged_sha256 or pinned.get("mode") != 0o500:
            raise HermitError("pinned packaged Hermit executable differs")
    else:
        _pin_safehermit(binary, destination, packaged_sha256)
    expected = _safehermit_binary(argv)
    values = list(argv)
    indexes = [index for index, value in enumerate(values) if value == str(expected)]
    if len(indexes) != 1:
        raise HermitError("qualified Hermit binary position is ambiguous")
    values[indexes[0]] = str(destination)
    return tuple(values)


def _safehermit_fields(path: Path) -> dict[str, str]:
    fields: dict[str, str] = {}
    try:
        lines = path.read_text().splitlines()
    except OSError as error:
        raise HermitError("safehermit report is unreadable") from error
    for line in lines:
        prefix, separator, value = line.partition("=")
        if not separator or not prefix.startswith("safehermit: "):
            raise HermitError("safehermit report is malformed")
        key = prefix.removeprefix("safehermit: ")
        if not key or key in fields or not value:
            raise HermitError("safehermit report is malformed")
        fields[key] = value
    return fields


def _validate_bounded_command_process(
    receipt: dict[str, object], expected_argv: list[str], attempt_root: Path
) -> None:
    process_record = receipt.get("process")
    worker_pid = receipt.get("worker_pid")
    if (
        not isinstance(worker_pid, int)
        or isinstance(worker_pid, bool)
        or worker_pid <= 0
        or not isinstance(process_record, dict)
        or not isinstance(process_record.get("path"), str)
    ):
        raise HermitError("bounded verification command evidence is incomplete")
    metadata_path = Path(process_record["path"])
    operation = expected_argv[1]
    if (
        metadata_path.name != "metadata.json"
        or metadata_path.parent.parent != attempt_root / "bounded-space-control"
        or not metadata_path.parent.name.startswith(operation + "-")
    ):
        raise HermitError("bounded verification command evidence escaped its attempt")
    try:
        verify_regular_file_record(metadata_path, process_record)
        metadata = json.loads(metadata_path.read_text())
    except (OSError, json.JSONDecodeError, StateError) as error:
        raise HermitError("bounded verification command evidence differs") from error
    cgroup_value = metadata.get("cgroup") if isinstance(metadata, dict) else None
    stdout_record = metadata.get("stdout") if isinstance(metadata, dict) else None
    stderr_record = metadata.get("stderr") if isinstance(metadata, dict) else None
    if (
        not isinstance(metadata, dict)
        or metadata.get("argv") != expected_argv
        or metadata.get("cwd") != str(attempt_root)
        or metadata.get("environment") != "restricted"
        or metadata.get("containment") != process_module.CONTAINMENT
        or metadata.get("containment_empty") is not True
        or metadata.get("timed_out") is not False
        or metadata.get("timeout_seconds") != _BOUNDED_SPACE_TIMEOUT_SECONDS
        or metadata.get("returncode") != receipt.get("returncode")
        or not isinstance(cgroup_value, str)
        or os.path.lexists(cgroup_value)
        or not isinstance(stdout_record, dict)
        or not isinstance(stderr_record, dict)
        or not isinstance(stdout_record.get("path"), str)
        or not isinstance(stderr_record.get("path"), str)
    ):
        raise HermitError("bounded verification command evidence is incomplete")
    stdout_path = Path(stdout_record["path"])
    stderr_path = Path(stderr_record["path"])
    try:
        verify_regular_file_record(stdout_path, stdout_record)
        verify_regular_file_record(stderr_path, stderr_record)
        stdout = stdout_path.read_text()
        stderr = stderr_path.read_text()
    except (OSError, StateError) as error:
        raise HermitError("bounded verification command output differs") from error
    if stdout != receipt.get("stdout") or stderr != receipt.get("stderr"):
        raise HermitError("bounded verification command output differs")


def _verify_output_evidence(
    argv: tuple[str, ...], attempt_root: Path
) -> dict[str, object]:
    path = attempt_root / "verify-output.json"
    record = regular_file_record(path)
    try:
        value = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise HermitError("verification output evidence is unreadable") from error
    if not isinstance(value, dict):
        raise HermitError("verification output evidence is malformed")
    copied_output = value.get("copied_output")
    copied_root_value = value.get("copied_output_root")
    bounded_tree = value.get("bounded_tree")
    marker = value.get("marker")
    create = value.get("create")
    report = value.get("report")
    destroy = value.get("destroy")
    verify_log_dir_value = value.get("verify_log_dir")
    if not isinstance(verify_log_dir_value, str):
        raise HermitError("verification output evidence is incomplete")
    verify_log_dir = Path(verify_log_dir_value)
    boundary = argv.index("--")
    current_options = argv[:boundary]
    if any(
        token == "--verify-strict"
        or token == "--keep-logs"
        or token.startswith("--verify-log-dir=")
        or token.startswith("--timeout=")
        for token in current_options
    ):
        historical_verify_log_dir = _verify_log_dir(argv)
        if historical_verify_log_dir != verify_log_dir:
            raise HermitError("verification output escaped its invocation")
    elif (
        current_options.count("--verify") != 1
        or current_options.count("--verify-verbose") != 1
        or not verify_log_dir.is_absolute()
    ):
        raise HermitError("current strict verification contract is malformed")
    bounded_path = verify_log_dir.parent
    bounded_run_space = (
        attempt_root / "safehermit-runtime" / "scripts" / "bounded-run-space"
    )
    disk_limit = _safehermit_flag(argv, "--sh-disk-limit")
    limit_bytes = value.get("limit_bytes")
    mount_id = value.get("mount_id")
    allocation_key = _verify_allocation_key(attempt_root)
    allocation_tag = _verify_allocation_tag(attempt_root)
    expected_create_argv = [
        str(bounded_run_space),
        "create",
        "--limit",
        disk_limit,
        "--tag",
        allocation_tag,
        "--base",
        str(_safehermit_log_root(attempt_root)),
    ]
    expected_report_argv = [str(bounded_run_space), "report", str(bounded_path)]
    expected_destroy_argv = [str(bounded_run_space), "destroy", str(bounded_path)]
    if (
        value.get("schema") != "tfa.hermit.verify-output.v1"
        or value.get("phase") != "finalized"
        or value.get("allocation_key") != allocation_key
        or value.get("verify_log_dir") != str(verify_log_dir)
        or bounded_path.parent != _safehermit_log_root(attempt_root)
        or not bounded_path.name.startswith("brs-" + allocation_tag + "-")
        or os.path.lexists(bounded_path)
        or not isinstance(bounded_tree, dict)
        or bounded_tree.get("path") != str(bounded_path)
        or bounded_tree.get("kind") != "directory"
        or not isinstance(marker, dict)
        or marker.get("path") != str(bounded_path / ".BOUNDED_RUN_SPACE")
        or marker.get("kind") != "file"
        or value.get("disk_limit") != disk_limit
        or not isinstance(limit_bytes, int)
        or isinstance(limit_bytes, bool)
        or limit_bytes <= 0
        or not isinstance(mount_id, int)
        or isinstance(mount_id, bool)
        or mount_id <= 0
        or not isinstance(create, dict)
        or create.get("argv") != expected_create_argv
        or create.get("returncode") != 0
        or create.get("stdout") != f"{bounded_path}\n"
        or not isinstance(copied_root_value, str)
        or Path(copied_root_value) != attempt_root / "verify"
        or not isinstance(copied_output, dict)
        or copied_output.get("max_bytes") != _VERIFY_OUTPUT_MAX_BYTES
        or copied_output.get("max_entries") != _VERIFY_OUTPUT_MAX_ENTRIES
        or not isinstance(report, dict)
        or report.get("argv") != expected_report_argv
        or report.get("returncode") != 0
        or report.get("limit_bytes") != limit_bytes
        or not isinstance(report.get("referenced_bytes"), int)
        or not isinstance(report.get("exclusive_bytes"), int)
        or not isinstance(destroy, dict)
        or destroy.get("argv") != expected_destroy_argv
        or destroy.get("returncode") != 0
    ):
        raise HermitError("verification output evidence is incomplete")
    _validate_bounded_command_process(create, expected_create_argv, attempt_root)
    _validate_bounded_command_process(report, expected_report_argv, attempt_root)
    _validate_bounded_command_process(destroy, expected_destroy_argv, attempt_root)
    referenced = report["referenced_bytes"]
    exclusive = report["exclusive_bytes"]
    if (
        isinstance(referenced, bool)
        or isinstance(exclusive, bool)
        or not 0 <= referenced < limit_bytes - limit_bytes // 100
        or not 0 <= exclusive <= referenced
        or report.get("stdout")
        != f"referenced={referenced} exclusive={exclusive} limit={limit_bytes}\n"
    ):
        raise HermitError("verification output quota evidence differs")
    expected_inventory = _verify_output_inventory(Path(copied_root_value))
    if copied_output != expected_inventory:
        raise HermitError("verification output differs from its inventory")
    transaction_path = _verify_transaction_path(attempt_root)
    transaction_record = regular_file_record(transaction_path)
    try:
        transaction = json.loads(transaction_path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise HermitError(
            "verification allocation transaction is unreadable"
        ) from error
    transaction_space, transaction_phase = _space_from_transaction(
        attempt_root, transaction
    )
    if (
        transaction_phase != "finalized"
        or transaction_space
        != _VerifySpace(
            bounded_path,
            verify_log_dir,
            disk_limit,
            limit_bytes,
            mount_id,
            bounded_tree,
            marker,
            create,
        )
        or not isinstance(transaction, dict)
        or transaction.get("copied_output") != copied_output
        or transaction.get("destroy") != destroy
        or transaction.get("final_evidence") != record
        or transaction.get("report") != report
    ):
        raise HermitError("verification allocation transaction differs")
    if (
        regular_file_record(path) != record
        or regular_file_record(transaction_path) != transaction_record
    ):
        raise HermitError("verification output evidence changed while it was read")
    return {
        "evidence": record,
        "transaction": transaction_record,
        **value,
    }


def safehermit_evidence(
    argv: tuple[str, ...],
    metadata: dict[str, object],
    report_path: Path,
    expected_hermit_sha256: str,
) -> dict[str, object]:
    if Path(_safehermit_flag(argv, "--sh-report")) != report_path:
        raise HermitError("safehermit report path differs from its invocation")
    verify_output = _verify_output_evidence(argv, report_path.parent)
    started = metadata.get("started_wall_time_ns")
    finished = metadata.get("finished_wall_time_ns")
    returncode = metadata.get("returncode")
    payload_pid = metadata.get("payload_pid")
    timed_out = metadata.get("timed_out")
    if (
        not isinstance(started, int)
        or isinstance(started, bool)
        or not isinstance(finished, int)
        or isinstance(finished, bool)
        or finished < started
        or not isinstance(returncode, int)
        or isinstance(returncode, bool)
        or not isinstance(payload_pid, int)
        or isinstance(payload_pid, bool)
        or payload_pid <= 0
        or timed_out is not False
        or metadata.get("environment") != "restricted"
    ):
        raise HermitError("safehermit process metadata is malformed")
    report_record = regular_file_record(report_path)
    report_metadata = report_path.lstat()
    if not started <= report_metadata.st_mtime_ns <= finished:
        raise HermitError("safehermit report is not fresh for this run")
    inputs_path = report_path.parent / "execution-inputs.json"
    inputs_record = regular_file_record(inputs_path)
    try:
        inputs = json.loads(inputs_path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise HermitError("safehermit execution inputs are unreadable") from error
    wrapper_record = inputs.get("safehermit") if isinstance(inputs, dict) else None
    bounded_record = (
        inputs.get("bounded_run_space") if isinstance(inputs, dict) else None
    )
    if (
        not isinstance(wrapper_record, dict)
        or not isinstance(wrapper_record.get("path"), str)
        or not isinstance(bounded_record, dict)
        or not isinstance(bounded_record.get("path"), str)
    ):
        raise HermitError("safehermit execution inputs are malformed")
    wrapper_path = Path(wrapper_record["path"])
    bounded_path = Path(bounded_record["path"])
    try:
        verify_regular_file_record(wrapper_path, wrapper_record)
        verify_regular_file_record(bounded_path, bounded_record)
    except StateError as error:
        raise HermitError("safehermit execution input differs") from error
    if (
        wrapper_path != Path(argv[0])
        or wrapper_record.get("sha256") != SAFEHERMIT_SHA256
        or wrapper_record.get("mode") != 0o500
        or bounded_path != wrapper_path.parent.parent / "scripts" / "bounded-run-space"
        or bounded_record.get("sha256") != BOUNDED_RUN_SPACE_SHA256
        or bounded_record.get("mode") != 0o500
    ):
        raise HermitError("safehermit execution input differs")
    fields = _safehermit_fields(report_path)
    if (
        regular_file_record(report_path) != report_record
        or regular_file_record(inputs_path) != inputs_record
    ):
        raise HermitError("safehermit evidence changed while it was read")
    required = {
        "run_id",
        "binary",
        "binary_source",
        "binary_sha256",
        "log_dir",
        "log_file",
        "unit",
        "bound.wall",
        "bound.cgroup",
        "bound.disk",
        "bound.bytes",
        "bound.logfilter",
        "env.forwarded",
        "note.run_record",
        "elapsed_secs",
        "bytes_written",
        "truncated",
        "runner_exit_code",
        "unit_result",
        "exit_code",
    }
    if not required.issubset(fields):
        raise HermitError("safehermit report is incomplete")
    run_match = re.fullmatch(
        r"(?P<stamp>[0-9]{8}T[0-9]{6}Z)-[1-9][0-9]*", fields["run_id"]
    )
    if run_match is None:
        raise HermitError("safehermit run identity is malformed")
    if int(run_match.group(0).rsplit("-", maxsplit=1)[1]) != payload_pid:
        raise HermitError("safehermit run identity differs from its payload")
    run_time_ns = int(
        datetime.strptime(run_match.group("stamp"), "%Y%m%dT%H%M%SZ")
        .replace(tzinfo=UTC)
        .timestamp()
        * 1_000_000_000
    )
    if not started - 1_000_000_000 <= run_time_ns <= finished:
        raise HermitError("safehermit run identity is not bound to this process")
    expected_fields = required
    if returncode != 0:
        expected_fields = expected_fields | {
            "exec_main_pid",
            "exec_main_code",
            "exec_main_status",
            "exec_main_start_monotonic_usec",
        }
    if returncode == 134:
        expected_fields = expected_fields | {"process_signal"}
    if set(fields) != expected_fields:
        raise HermitError("safehermit report field set differs")
    run_id = fields["run_id"]
    log_dir = Path(fields["log_dir"])
    expected_log_root = _safehermit_log_root(report_path.parent)
    expected_run_record = expected_log_root / "registry" / f"{run_id}.json"
    if (
        fields["unit"] != f"safehermit-{run_id}"
        or log_dir.parent != expected_log_root
        or re.fullmatch(
            rf"brs-safehermit-{re.escape(run_id)}-[1-9][0-9]*-[1-9][0-9]*",
            log_dir.name,
        )
        is None
        or Path(fields["log_file"]) != log_dir / "hermit.log"
        or fields["note.run_record"]
        != f"{expected_run_record} (best-effort; nothing depends on it)"
    ):
        raise HermitError("safehermit run paths differ from its identity")
    deadline = int(_safehermit_flag(argv, "--sh-deadline"))
    max_bytes = int(_safehermit_flag(argv, "--sh-max-log-bytes"))
    disk_limit = _safehermit_flag(argv, "--sh-disk-limit")
    try:
        elapsed = int(fields["elapsed_secs"])
        bytes_written = int(fields["bytes_written"])
        runner_exit = int(fields["runner_exit_code"])
        reported_exit = int(fields["exit_code"])
    except ValueError as error:
        raise HermitError("safehermit numeric evidence is malformed") from error
    if (
        fields["binary"] != str(_safehermit_binary(argv))
        or fields["binary_source"] != "argv:positional-path"
        or fields["binary_sha256"] != expected_hermit_sha256
        or fields["bound.wall"] != f"APPLIED:{deadline}s"
        or fields["bound.cgroup"] != "APPLIED:MemoryMax=16G MemorySwapMax=0"
        or fields["bound.bytes"]
        != f"APPLIED:{max_bytes} (LETHAL: the run is cgroup-killed at the cap)"
        or fields["bound.disk"]
        != f"APPLIED:{disk_limit} for log_dir only; guest paths and explicit "
        "log files elsewhere are outside this bound"
        or fields["bound.logfilter"]
        != "NOT_APPLIED:by owner ruling -- the emitter is left loud so a stuck "
        "run stays visible; the low byte cap is the mechanism that fires"
        or re.fullmatch(
            r"APPLIED:[1-9][0-9]* variables forwarded(?:; [1-9][0-9]* SKIPPED "
            r"\(name not a plain shell identifier, e\.g\. an exported function\))?",
            fields["env.forwarded"],
        )
        is None
        or fields["truncated"] != "false"
        or not 0 <= elapsed <= deadline
        or not 0 <= bytes_written <= max_bytes
        or reported_exit != returncode
        or returncode in (124, 125, 126)
    ):
        raise HermitError("safehermit safety or completion evidence differs")
    if returncode == 0:
        if fields["unit_result"] != "success" or runner_exit != 0:
            raise HermitError("safehermit success termination differs")
    elif returncode == 134:
        if (
            fields["unit_result"] != "core-dump"
            or runner_exit != 1
            or fields.get("exec_main_code") != "3"
            or fields.get("exec_main_status") != "6"
            or fields.get("process_signal") != "6"
        ):
            raise HermitError("safehermit SIGABRT evidence differs")
    elif (
        fields["unit_result"] != "exit-code"
        or runner_exit != returncode
        or fields.get("exec_main_code") != "1"
        or fields.get("exec_main_status") != str(returncode)
        or "process_signal" in fields
    ):
        raise HermitError("safehermit failure termination differs")
    if returncode != 0:
        try:
            exec_pid = int(fields["exec_main_pid"])
            exec_start = int(fields["exec_main_start_monotonic_usec"])
        except ValueError as error:
            raise HermitError("safehermit process evidence is malformed") from error
        if exec_pid <= 0 or exec_start <= 0:
            raise HermitError("safehermit process evidence is malformed")
    try:
        verify_regular_file_record(wrapper_path, wrapper_record)
        verify_regular_file_record(bounded_path, bounded_record)
    except StateError as error:
        raise HermitError("safehermit execution input differs") from error
    argv_digest = hashlib.sha256()
    for token in argv:
        argv_digest.update(os.fsencode(token))
        argv_digest.update(b"\0")
    return {
        "argv_sha256": argv_digest.hexdigest(),
        "execution_inputs": inputs_record,
        "report": report_record,
        "run_id": run_id,
        "unit": fields["unit"],
        "exit_code": reported_exit,
        "truncated": False,
        "wrapper": wrapper_record,
        "bounded_run_space": bounded_record,
        "verify_output": verify_output,
    }


def controller_evidence(attempt_root: Path) -> dict[str, object]:
    controller_cwd = attempt_root / "controller-cwd"
    before_path = attempt_root / "controller-cwd.before.json"
    after_path = attempt_root / "controller-cwd.after.json"
    try:
        before = json.loads(before_path.read_text())
        after = json.loads(after_path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise HermitError(
            "controller working-directory evidence is unreadable"
        ) from error
    if (
        not isinstance(before, dict)
        or before.get("path") != str(controller_cwd)
        or before.get("entries") != []
        or not isinstance(after, dict)
        or after.get("path") != str(controller_cwd)
        or before.get("root") != after.get("root")
    ):
        raise HermitError("controller working-directory evidence is malformed")
    verify_working_directory(controller_cwd, after_path)
    entries = after.get("entries")
    if not isinstance(entries, list):
        raise HermitError("controller working-directory entries are malformed")
    outputs: list[dict[str, object]] = []
    residues: list[dict[str, object]] = []
    for entry in entries:
        if not isinstance(entry, dict) or not isinstance(entry.get("path"), str):
            raise HermitError("controller working-directory entry is malformed")
        if entry.get("kind") != "file":
            continue
        path = controller_cwd / entry["path"]
        record = regular_file_record(path)
        outputs.append(record)
        if path.name.startswith(".hermit-verify-summary-"):
            residues.append(record)
    return {
        "after": regular_file_record(after_path),
        "before": regular_file_record(before_path),
        "controller_cwd": str(controller_cwd),
        "outputs": outputs,
        "verify_summary_residue": residues,
    }


def run_hermit_attempt(
    argv: tuple[str, ...],
    guest_cwd: Path,
    attempt_root: Path,
    outer_timeout_seconds: float,
    environment: Mapping[str, str] | None = None,
) -> ProcessResult:
    attempt_root.mkdir(parents=True, exist_ok=True)
    with _verify_allocation_guard(attempt_root):
        return _run_hermit_attempt_locked(
            argv,
            guest_cwd,
            attempt_root,
            outer_timeout_seconds,
            environment,
        )


def _run_hermit_attempt_locked(
    argv: tuple[str, ...],
    guest_cwd: Path,
    attempt_root: Path,
    outer_timeout_seconds: float,
    environment: Mapping[str, str] | None,
) -> ProcessResult:
    _prepare_safehermit_runtime(attempt_root)
    _prepare_safehermit_log_root(attempt_root)
    pinned_wrapper = safehermit_wrapper_path(attempt_root)
    _, bounded_run_space = safehermit_runtime_paths(attempt_root)
    _reconcile_verify_allocations(attempt_root, bounded_run_space)
    controller_cwd = attempt_root / "controller-cwd"
    try:
        controller_cwd.mkdir(mode=0o700)
    except FileExistsError as error:
        raise HermitError("controller working directory is not fresh") from error
    before_path = attempt_root / "controller-cwd.before.json"
    after_path = attempt_root / "controller-cwd.after.json"
    seal_working_directory(controller_cwd, before_path)
    space: _VerifySpace | None = None
    try:
        report_path = Path(_safehermit_flag(argv, "--sh-report"))
        if report_path.parent != attempt_root or report_path.name not in (
            "safehermit.json",
            "safehermit.txt",
        ):
            raise HermitError("safehermit report escaped its attempt")
        if os.path.lexists(report_path):
            raise HermitError("safehermit report is not fresh")
        disk_limit = _safehermit_flag(argv, "--sh-disk-limit")
        space = _prepare_verify_space(attempt_root, bounded_run_space, disk_limit)
        _write_verify_transaction(attempt_root, space, "prepared")
        bounded_argv = _replace_verify_log_dir(
            argv, attempt_root / "verify", space.verify_dir
        )
        prepared = _current_verify_argv(
            hermit_attempt_argv(
                bounded_argv,
                guest_cwd,
                controller_cwd,
                outer_timeout_seconds,
                pinned_wrapper,
            )
        )
        execution_environment = dict(os.environ if environment is None else environment)
        execution_environment["SAFEHERMIT_LOG_ROOT"] = str(
            _safehermit_log_root(attempt_root)
        )
        execution_environment["TMPDIR"] = str(space.verify_dir)
        result = run_process(
            prepared[0],
            prepared[1:],
            controller_cwd,
            attempt_root / "wrapper",
            outer_timeout_seconds,
            execution_environment,
        )
        _finalize_verify_space(attempt_root, space, bounded_run_space)
        return result
    except BaseException as error:
        if space is not None:
            _cleanup_failed_verify_space(attempt_root, space, bounded_run_space, error)
        else:
            try:
                with _verify_command_guard(attempt_root):
                    pass
                recovered = _recover_orphaned_verify_spaces(
                    attempt_root, bounded_run_space
                )
                if recovered:
                    error.add_note(
                        "unrecorded bounded verification allocation was recovered"
                    )
            except Exception as cleanup_error:
                error.add_note(
                    "unrecorded bounded verification allocation cleanup also "
                    f"failed: {cleanup_error}"
                )
        raise
    finally:
        seal_directory_evidence(controller_cwd, after_path)
        write_metadata(
            attempt_root / "controller-evidence.json", controller_evidence(attempt_root)
        )
