from __future__ import annotations

import hashlib
import json
import os
from dataclasses import dataclass
from pathlib import Path

from testinfra.tfa.manifest import Case
from testinfra.tfa.pipeline import (
    _gtest_execution_evidence,
    _gtest_fatal_execution_evidence,
    FAILURE_MARKERS,
)


SUMMARY_SCHEMA: str = "tfa.relocated-reproducer-summary.v2"
RECEIPT_SCHEMA: str = "tfa.relocated-reproducer-run.v2"
_DETERMINISM = ":: Success: deterministic. Determinism verified."
_FORBIDDEN_ROOT = "/tmp"


class RelocationError(RuntimeError):
    pass


@dataclass(frozen=True)
class RelocatedWitness:
    outcome: str
    seed: int
    argv: tuple[str, ...]
    cwd: str
    decided_attempts: tuple[str, ...]
    censored_attempts: tuple[str, ...]


@dataclass(frozen=True)
class Relocation:
    summary_sha256: str
    passing: RelocatedWitness
    failing: RelocatedWitness


def _names_tmp(value: str) -> bool:
    root = _FORBIDDEN_ROOT
    return value == root or f"{root}/" in value or value.endswith(f"={root}")


def _check_path(outcome: str, role: str, path: str) -> str:
    if not path.startswith("/") or os.path.normpath(path) != path:
        raise RelocationError(f"{outcome} argv {role} path is not canonical: {path}")
    roots = (_FORBIDDEN_ROOT, os.path.realpath(_FORBIDDEN_ROOT))
    for candidate in (path, os.path.realpath(path)):
        if any(candidate == root or candidate.startswith(f"{root}/") for root in roots):
            raise RelocationError(
                f"{outcome} argv {role} resolves into {_FORBIDDEN_ROOT}"
            )
    return path


def _check_argv(case: Case, outcome: str, seed: int, argv: tuple[str, ...]) -> str:
    """Return the relocated cwd after proving `argv` differs from the manifest
    argv only in its /tmp-bound tokens and scheduler seed."""
    source = case.pass_argv if outcome == "pass" else case.fail_argv
    old_mount = (
        f"--mount=type=bind,source={case.working_directory},"
        f"target={case.working_directory}"
    )
    boundary = source.index("--")
    if len(argv) != len(source) + 1 or argv[boundary + 1 :] != source[boundary:]:
        raise RelocationError(f"{outcome} argv changes more than its /tmp paths")
    cwd = None
    offset = 0
    for index, token in enumerate(source[:boundary]):
        actual = argv[index + offset]
        previous = source[index - 1] if index else ""
        if previous == "--sched-seed":
            if actual != str(seed):
                raise RelocationError(f"{outcome} argv is not bound to seed {seed}")
        elif previous == "--sh-report":
            _check_path(outcome, "safehermit report", actual)
        elif token.startswith("--verify-log-dir="):
            prefix = "--verify-log-dir="
            if not actual.startswith(prefix):
                raise RelocationError(f"{outcome} argv has no verify-log dir")
            _check_path(outcome, "verify-log dir", actual.removeprefix(prefix))
        elif token == old_mount:
            prefix = "--mount=type=bind,source="
            mounted = actual.removeprefix(prefix).split(",target=")
            if not actual.startswith(prefix) or len(mounted) != 2:
                raise RelocationError(f"{outcome} argv has no same-path cwd mount")
            if mounted[0] != mounted[1]:
                raise RelocationError(f"{outcome} cwd mount is not same-path")
            cwd = _check_path(outcome, "cwd", mounted[0])
            offset = 1
            if not argv[index + offset].startswith("--tmp="):
                raise RelocationError(f"{outcome} argv does not own the guest /tmp")
            _check_path(
                outcome, "guest /tmp", argv[index + offset].removeprefix("--tmp=")
            )
        elif actual != token:
            raise RelocationError(f"{outcome} argv changes more than its /tmp paths")
    if cwd is None:
        raise RelocationError(f"{outcome} argv has no relocated cwd")
    if any(_names_tmp(token) for token in argv):
        raise RelocationError(f"{outcome} argv still names /tmp")
    return cwd


def _bound_file(value: object, expected: Path, role: str) -> Path:
    if not isinstance(value, dict) or value.get("path") != str(expected):
        raise RelocationError(f"{role} is not the attempt's own file")
    try:
        data = expected.read_bytes()
    except OSError as error:
        raise RelocationError(f"cannot read {role}: {expected}") from error
    if value.get("sha256") != hashlib.sha256(data).hexdigest():
        raise RelocationError(f"{role} bytes differ from the receipt")
    return expected


def _check_oracle(
    case: Case, outcome: str, argv: tuple[str, ...], returncode: object, run: Path
) -> None:
    stdout, stderr = run / "stdout.txt", run / "stderr.txt"
    error_text = stderr.read_text(errors="replace")
    if _DETERMINISM not in error_text.splitlines():
        raise RelocationError(f"attempt did not verify determinism: {run}")
    if outcome == "pass":
        if returncode != 0:
            raise RelocationError(f"PASS attempt exited {returncode}")
        _gtest_execution_evidence(argv, stdout, True)
        return
    markers = FAILURE_MARKERS[case.case_id]
    output = stdout.read_text(errors="replace") + "\n" + error_text
    if not isinstance(returncode, int) or returncode in (0, 124, 125, 126):
        raise RelocationError(f"FAIL attempt exited {returncode}")
    if not all(marker in output for marker in markers):
        raise RelocationError("FAIL attempt lacks the failure-class markers")
    if case.case_id != "httpcoro":
        _gtest_execution_evidence(argv, stdout, False)
    elif returncode != 134:
        raise RelocationError("httpcoro FAIL attempt did not abort")
    else:
        _gtest_fatal_execution_evidence(argv, stdout, stderr, markers)


def _bound_receipt(
    case: Case, outcome: str, seed: int, run: Path
) -> tuple[dict[str, object], tuple[str, ...], str, dict[str, str]]:
    """Bind an attempt's receipt to the manifest inputs, its own argv, and its
    own stdout, stderr and safehermit report bytes, whatever its label."""
    try:
        receipt = json.loads((run / "receipt.json").read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise RelocationError(f"missing or malformed receipt: {run}") from error
    if not isinstance(receipt, dict) or receipt.get("schema") != RECEIPT_SCHEMA:
        raise RelocationError(f"receipt has the wrong schema: {run}")
    if receipt.get("case_id") != case.case_id or receipt.get("seed") != seed:
        raise RelocationError(f"receipt is not bound to {case.case_id} seed {seed}")
    recorded = receipt.get("argv")
    if not isinstance(recorded, list) or not all(
        isinstance(token, str) for token in recorded
    ):
        raise RelocationError(f"receipt has no argv: {run}")
    argv = tuple(recorded)
    cwd = _check_argv(case, outcome, seed, argv)
    inputs = receipt.get("inputs")
    if not isinstance(inputs, dict) or not all(
        isinstance(inputs.get(name), dict) for name in ("hermit", "guest")
    ):
        raise RelocationError("receipt has no input identities")
    if inputs["hermit"].get("sha256") != case.hermit_sha256:
        raise RelocationError("receipt Hermit differs from the manifest")
    if inputs["guest"].get("sha256") != case.artifact_sha256:
        raise RelocationError("receipt test ELF differs from the manifest")
    classification = receipt.get("classification")
    if not isinstance(classification, dict):
        raise RelocationError("receipt has no classification")
    _bound_file(receipt.get("stdout"), run / "stdout.txt", "stdout")
    _bound_file(receipt.get("stderr"), run / "stderr.txt", "stderr")
    report_path = _bound_file(
        receipt.get("safehermit_report"), run / "safehermit.txt", "safehermit report"
    )
    report = {}
    for line in report_path.read_text(errors="replace").splitlines():
        key, equals, value = line.removeprefix("safehermit: ").partition("=")
        if line.startswith("safehermit: ") and equals:
            if key in report:
                raise RelocationError(f"safehermit report repeats {key}: {run}")
            report[key] = value
    if report.get("binary_sha256") != case.hermit_sha256:
        raise RelocationError(f"safehermit ran a Hermit not in the manifest: {run}")
    if report.get("exit_code") != str(classification.get("returncode")):
        raise RelocationError(f"safehermit exit code contradicts the receipt: {run}")
    return receipt, argv, cwd, report


def _check_attempt(
    case: Case, outcome: str, seed: int, run: Path
) -> tuple[tuple[str, ...], str]:
    receipt, argv, cwd, _ = _bound_receipt(case, outcome, seed, run)
    classification = receipt["classification"]
    assert isinstance(classification, dict)
    try:
        _check_oracle(case, outcome, argv, classification.get("returncode"), run)
    except RelocationError:
        raise
    except RuntimeError as error:
        raise RelocationError(f"{outcome} oracle refused {run}") from error
    return argv, cwd


def _check_censored(case: Case, outcome: str, seed: int, run: Path) -> None:
    """Accept a CENSORED attempt only with safehermit's own wall-deadline
    evidence and bytes that neither decided oracle accepts."""
    receipt, argv, _, report = _bound_receipt(case, outcome, seed, run)
    classification = receipt["classification"]
    assert isinstance(classification, dict)
    deadline = argv[argv.index("--sh-deadline") + 1]
    elapsed = report.get("elapsed_secs", "")
    duration = receipt.get("duration_seconds")
    if (
        classification.get("oracle") != "CENSORED"
        or classification.get("returncode") != 124
        or report.get("unit_result") != "timeout"
        or report.get("bound.wall") != f"APPLIED:{deadline}s"
        or not elapsed.isdigit()
        or int(elapsed) < int(deadline)
        or not isinstance(duration, (int, float))
        or duration < int(deadline)
    ):
        raise RelocationError(f"CENSORED attempt lacks wall-bound evidence: {run}")
    fatal = 134 if case.case_id == "httpcoro" else 1
    for decided, returncode in (("pass", 0), ("fail", fatal)):
        try:
            _check_oracle(case, decided, argv, returncode, run)
        except RuntimeError:
            continue
        raise RelocationError(f"CENSORED attempt satisfies the {decided} oracle: {run}")


def _witness(
    case: Case, outcome: str, value: object, summary_dir: Path
) -> RelocatedWitness:
    if not isinstance(value, dict) or value.get("state") != "REPRODUCED":
        raise RelocationError(f"{outcome} relocation is not REPRODUCED")
    seed = value.get("seed")
    if not isinstance(seed, int) or isinstance(seed, bool) or seed < 0:
        raise RelocationError(f"{outcome} relocation has no seed")
    if seed in case.fresh_stress_seeds:
        raise RelocationError(f"{outcome} relocation spent a fresh stress seed")
    decided = value.get("decided_attempts")
    censored = value.get("censored_attempts")
    if (
        not isinstance(decided, list)
        or len(decided) < 2
        or len(set(decided)) != len(decided)
        or not isinstance(censored, list)
        or not all(isinstance(label, str) for label in decided + censored)
        or any(Path(label).name != label for label in decided)
    ):
        raise RelocationError(f"{outcome} relocation lacks two decided attempts")
    on_disk = {
        path.name
        for path in summary_dir.glob(f"seed-{seed:03d}-attempt-*")
        if path.is_dir()
    }
    if set(decided) & set(censored) or on_disk != set(decided) | set(censored):
        raise RelocationError(f"{outcome} relocation omits or invents attempts")
    for label in censored:
        _check_censored(case, outcome, seed, summary_dir / label)
    runs = [
        _check_attempt(case, outcome, seed, summary_dir / label) for label in decided
    ]
    argv, cwd = runs[0]
    if value.get("argv") != list(argv) or value.get("cwd") != cwd:
        raise RelocationError(f"{outcome} witness differs from its first attempt")
    return RelocatedWitness(outcome, seed, argv, cwd, tuple(decided), tuple(censored))


def validated_relocation(case: Case, summary_path: Path) -> Relocation:
    """Validate a measured non-/tmp PASS/FAIL relocation for `case`.

    Every decided attempt is re-judged from its own stdout/stderr bytes with the
    pipeline's gtest oracles, so a receipt's recorded label is never trusted.
    """
    try:
        data = summary_path.read_bytes()
        summary = json.loads(data)
    except (OSError, json.JSONDecodeError) as error:
        raise RelocationError(
            f"missing or malformed summary: {summary_path}"
        ) from error
    if not isinstance(summary, dict) or summary.get("schema") != SUMMARY_SCHEMA:
        raise RelocationError("relocation summary has the wrong schema")
    if summary.get("case_id") != case.case_id:
        raise RelocationError("relocation summary names a different case")
    witness = summary.get("witness")
    if not isinstance(witness, dict):
        raise RelocationError("relocation summary has no witnesses")
    return Relocation(
        hashlib.sha256(data).hexdigest(),
        _witness(case, "pass", witness.get("pass"), summary_path.parent),
        _witness(case, "fail", witness.get("fail"), summary_path.parent),
    )
