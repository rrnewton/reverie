+def _safehermit_log_root(attempt_root: Path) -> Path:
+    configured = os.environ.get(_VERIFY_SPACE_ROOT_ENV)
+    if configured is None:
+        return attempt_root / "bounded-output"
+    root = Path(configured)
+    if not root.is_absolute():
+        raise HermitError("configured verification space root is not absolute")
+    try:
+        canonical = root.resolve(strict=True)
+        fixture_root = root.parents[1]
+    except (IndexError, OSError) as error:
+        raise HermitError(
+            "configured verification space root is unavailable"
+        ) from error
+    if (
+        canonical != root
+        or root.name != "safehermit"
+        or root.parent.name != "mount"
+        or fixture_root.parent != Path("/tmp/tfa-phase2")
+        or not fixture_root.name.startswith("tfa-production-btrfs-")
+    ):
+        raise HermitError("configured verification space root is not a test fixture")
+    for component in (fixture_root, root.parent, root):
+        metadata = component.lstat()
+        if (
+            not stat.S_ISDIR(metadata.st_mode)
+            or metadata.st_uid != os.getuid()
+            or stat.S_IMODE(metadata.st_mode) & 0o022
+        ):
+            raise HermitError("configured verification space root is unsafe")
+    return root / ("attempt-" + _verify_allocation_key(attempt_root))
