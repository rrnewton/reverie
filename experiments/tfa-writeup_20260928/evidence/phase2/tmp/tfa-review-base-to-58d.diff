+        raise RuntimeError("runtime resource manifest mode differs")
+    source_value = _strict_resource_manifest(source_manifest)
+    runtime_value = _strict_resource_manifest(runtime_manifest)
+    if tuple(source_value) != tuple(sorted(source_value)):
+        source_value = dict(sorted(source_value.items()))
+    expected_files: list[str] = []
+    expected_entries: list[dict[str, object]] = []
+    resolved_checkout = checkout_root.resolve(strict=True)
+    for logical, original_target in source_value.items():
+        source = (source_manifest.parent / original_target).resolve(strict=True)
+        try:
+            source.relative_to(resolved_checkout)
+        except ValueError as error:
+            raise RuntimeError(
+                "runtime resource target escaped the checkout"
+            ) from error
+        runtime_path = resource_root / logical
+        runtime_target = os.path.relpath(runtime_path, runtime_manifest.parent)
+        if runtime_value.get(logical) != runtime_target:
+            raise RuntimeError("staged runtime resource target differs")
+        resolved_runtime = (runtime_manifest.parent / runtime_target).resolve(
