+        or not isinstance(runtime_record, dict)
+        or runtime_record.get("path") != str(runtime_manifest)
+        or not isinstance(resource_root_value, str)
+        or not isinstance(entries, list)
+    ):
+        raise RuntimeError("runtime resource inventory is malformed")
+    resource_root = Path(resource_root_value)
