+def _strict_resource_manifest(path: Path) -> dict[str, str]:
+    def reject_duplicates(pairs: list[tuple[str, object]]) -> dict[str, object]:
+        value: dict[str, object] = {}
+        for key, item in pairs:
+            if key in value:
+                raise RuntimeError("runtime resource manifest has duplicate keys")
+            value[key] = item
+        return value
+
+    try:
+        raw = json.loads(path.read_text(), object_pairs_hook=reject_duplicates)
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
+        raise RuntimeError("runtime resource manifest is malformed") from error
+    if not isinstance(raw, dict):
+        raise RuntimeError("runtime resource manifest is not an object")
+    result: dict[str, str] = {}
+    for logical, target in raw.items():
+        if not isinstance(logical, str) or not isinstance(target, str):
+            raise RuntimeError("runtime resource manifest entry is malformed")
+        logical_path = Path(logical)
+        target_path = Path(target)
+        if (
+            not logical
+            or not target
+            or "\\" in logical
+            or "\\" in target
+            or logical_path.is_absolute()
+            or target_path.is_absolute()
+            or logical != str(logical_path)
+            or target != str(target_path)
+            or any(part in ("", ".", "..") for part in logical_path.parts)
+            or any(part in ("", ".") for part in target_path.parts)
+        ):
+            raise RuntimeError("runtime resource manifest path is unsafe")
+        result[logical] = target
+    return result
+
+
+def _write_runtime_resource_manifest(
+    path: Path, value: dict[str, str], mode: int
+) -> dict[str, object]:
+    content = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
+    descriptor = os.open(
+        path,
+        os.O_WRONLY
+        | os.O_CREAT
+        | os.O_EXCL
+        | getattr(os, "O_CLOEXEC", 0)
+        | getattr(os, "O_NOFOLLOW", 0),
+        mode,
+    )
+    try:
+        offset = 0
+        while offset < len(content):
+            written = os.write(descriptor, content[offset:])
+            if written <= 0:
+                raise RuntimeError("runtime resource manifest write failed")
+            offset += written
+        os.fchmod(descriptor, mode)
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
+    return regular_file_record(path)
+
+
+def _stage_runtime_resources(
+    source_elf: Path,
+    staging_elf: Path,
+    checkout_root: Path,
+    remaining_bytes: int,
+) -> tuple[dict[str, object] | None, int]:
+    source_manifest = source_elf.with_name(source_elf.name + ".resources.json")
+    if not os.path.lexists(source_manifest):
+        return None, 0
+    metadata = source_manifest.lstat()
+    if not stat.S_ISREG(metadata.st_mode):
+        raise RuntimeError("runtime resource manifest is not a regular file")
+    manifest = _strict_resource_manifest(source_manifest)
+    logical_paths = [Path(logical) for logical in manifest]
+    for index, logical in enumerate(logical_paths):
+        for other in logical_paths[index + 1 :]:
+            if logical in other.parents or other in logical.parents:
+                raise RuntimeError("runtime resource manifest paths overlap")
+    resource_root = staging_elf.parent / f"{staging_elf.name}.resources"
+    resource_root.mkdir()
+    resolved_checkout = checkout_root.resolve(strict=True)
+    entries: list[dict[str, object]] = []
+    rewritten: dict[str, str] = {}
+    copied_bytes = 0
+    for logical, target in sorted(manifest.items()):
+        try:
+            source = (source_manifest.parent / target).resolve(strict=True)
+        except OSError as error:
+            raise RuntimeError("runtime resource target is missing") from error
+        try:
+            source.relative_to(resolved_checkout)
+        except ValueError as error:
+            raise RuntimeError(
+                "runtime resource target escaped the checkout"
+            ) from error
+        if source != source.resolve(strict=True) or not stat.S_ISREG(
+            source.lstat().st_mode
+        ):
+            raise RuntimeError(
+                "runtime resource target is not a canonical regular file"
+            )
+        destination = resource_root / logical
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        destination.symlink_to(source)
+        source_record, runtime_record = _copy_pinned_runtime_source(
+            source, destination, remaining_bytes - copied_bytes
+        )
+        size = runtime_record.get("size")
+        if not isinstance(size, int) or isinstance(size, bool):
+            raise RuntimeError("runtime resource size is malformed")
+        copied_bytes += size
+        runtime_target = os.path.relpath(destination, staging_elf.parent)
+        if Path(runtime_target).is_absolute():
+            raise RuntimeError("staged runtime resource target is not relative")
+        rewritten[logical] = runtime_target
+        entries.append(
+            {
+                "logical": logical,
+                "original_target": target,
+                "runtime": runtime_record,
+                "runtime_target": runtime_target,
+                "source": source_record,
+            }
+        )
+    runtime_manifest = staging_elf.with_name(staging_elf.name + ".resources.json")
+    manifest_record = _write_runtime_resource_manifest(
+        runtime_manifest, rewritten, stat.S_IMODE(metadata.st_mode)
+    )
+    manifest_size = manifest_record.get("size")
+    if (
+        not isinstance(manifest_size, int)
+        or isinstance(manifest_size, bool)
+        or copied_bytes + manifest_size > remaining_bytes
+    ):
+        raise RuntimeError("runtime staging byte budget exceeded")
+    return (
+        {
+            "entries": entries,
+            "runtime_manifest": manifest_record,
+            "runtime_root": str(resource_root),
+            "source_manifest": regular_file_record(source_manifest),
+        },
+        copied_bytes + manifest_size,
+    )
+
