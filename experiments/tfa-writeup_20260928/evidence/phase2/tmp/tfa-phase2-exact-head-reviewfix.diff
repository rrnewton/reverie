+    elif [ -n "$log_dir" ]; then
+        # exit 10: the space exists but nothing caps it. RELAY IT -- this is the
+        # case bounded-run-space exists to make impossible to miss.
+        disk_state="NOT_APPLIED:bounded-run-space reported UNBOUNDED (rc=$rc); space exists but is not capped"
+    else
