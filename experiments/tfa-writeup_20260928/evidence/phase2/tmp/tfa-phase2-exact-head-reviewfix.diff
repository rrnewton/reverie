+# ---------------------------------------------------------------- (3) byte cap
+# A capped log that reads as complete is worse than a missing one, so the capper
+# records the truncation. It NEVER closes the pipe: closing would deliver SIGPIPE
+# to hermit and turn a log cap into a kill, and under `set -o pipefail` that also
+# takes the script down silently. It keeps draining and stops writing.
+capper() {
+    # STREAMING, CONSTANT MEMORY. A reviewer found that the evidence cap in
+    # safe-ci-dag-runner bounds the FILE while still holding complete stdout and
+    # stderr in memory -- trading a full disk for an OOM is not a fix. This reads
+    # and writes in 64 KiB chunks and accumulates nothing, so peak memory is the
+    # chunk, not the stream.
+    #
+    # IT NEVER CLOSES THE PIPE. Closing would deliver SIGPIPE to hermit and turn a
+    # log cap into an unexplained kill, and under `set -o pipefail` it would take
+    # this script down silently too. On cap it stops WRITING and keeps DRAINING.
+    #
+    # THE CAP IS LETHAL, BY OWNER RULING. A spinning program should die from the
+    # timeout or from the log hitting a low cap, so on cap we kill the run through
+    # its cgroup and keep the first bytes as evidence. Without systemd there is no
+    # cgroup to kill, so it degrades to truncate-and-say-so rather than pretending.
+    python3 -u -c '
+import sys, os, subprocess, time
+cap = int(sys.argv[1]); path = sys.argv[2]; unit = sys.argv[3]
+parent_monitors = sys.argv[4] == "yes"
+written = 0; truncated = False; killed = "n/a"
+out = open(path, "wb")
+src = sys.stdin.buffer; dst = sys.stdout.buffer
+while True:
+    # Resource-accounted runs give this capper a dedicated payload-only FIFO;
+    # systemd-run never owns its write end, so EOF is an exact child boundary.
+    # os.read also returns currently available bytes instead of waiting to fill
+    # a 64-KiB BufferedReader request.
+    chunk = os.read(src.fileno(), 65536)
+    if not chunk: break
+    dst.write(chunk); dst.flush()
+    if not truncated:
+        room = cap - written
+        if len(chunk) <= room:
+            out.write(chunk); written += len(chunk)
+        else:
+            if room > 0: out.write(chunk[:room]); written += room
+            out.write(b"\n[safehermit] LOG CAP OF %d BYTES REACHED. The bytes above are kept as evidence; everything after this point was discarded.\n" % cap)
+            out.flush(); truncated = True
+            marker = path + ".cap-fired"
+            with open(marker + ".tmp", "w") as cap_marker:
+                cap_marker.write("1\n")
+            os.replace(marker + ".tmp", marker)
+            if unit and unit != "none":
+                if parent_monitors:
+                    # The detached parent owns the cgroup path in memory and
+                    # polls this marker. Do not trust a same-UID, payload-writable
+                    # sidecar as kill authority.
+                    rc = 0
+                    killed = "parent-monitor"
+                    kill_error = b""
+                else:
+                    rc = 1
+                    kill_error = b""
+                    for _ in range(100):
+                        attempt = subprocess.run(
+                            ["/usr/bin/systemctl", "--user", "kill", "--kill-whom=all", "--signal=KILL", unit],
+                            stdout=subprocess.DEVNULL,
+                            stderr=subprocess.PIPE,
+                            check=False,
+                        )
+                        rc = attempt.returncode
+                        kill_error = attempt.stderr[-512:]
+                        if rc == 0:
+                            break
+                        time.sleep(0.05)
+                    killed = "cgroup-killed" if rc == 0 else "kill-failed-rc%d" % rc
+                if parent_monitors:
+                    out.write(b"[safehermit] the detached parent was notified to kill the owned cgroup.\n")
+                else:
+                    out.write(b"[safehermit] the run was killed at the cap (%s).\n" % killed.encode())
+                if rc != 0 and kill_error:
+                    out.write(b"[safehermit] final systemctl kill error: %s\n" % kill_error.rstrip())
+            else:
+                killed = "no-cgroup-available"
+                out.write(b"[safehermit] NOT killed: no systemd cgroup was available, so the cap could only truncate.\n")
+            out.flush()
+out.flush(); out.close()
+with open(path + ".meta", "w") as m:
+    m.write("bytes_written=%d\ntruncated=%s\ncap=%d\nkilled=%s\n" % (written, str(truncated).lower(), cap, killed))
+' "$1" "$2" "$3" "$4"
+}
+
+# ---------------------------------------------------------------- run
+# A FIFO, NOT PROCESS SUBSTITUTION. `2> >(capper …)` is not waited on, so the
+# script read `.meta` before the capper had written it and reported
+# `truncated=unknown` -- i.e. the truncation record, which is the entire point of
+# requirement (3), was missing on every run. Caught by this script's own test. A
+# FIFO with an explicit `wait` makes the capper's completion a precondition of
+# reporting, and keeps `$?` the child's own status rather than the pipeline's.
+if [ -n "$detached_report_file" ]; then
+    fifo="$log_dir/.resource-payload-stderr.fifo"
+else
+    fifo="$log_dir/.stderr.fifo"
+fi
+rm -f "$fifo"; mkfifo "$fifo" 2>/dev/null || die "cannot create fifo $fifo"
+if [ -n "$detached_report_file" ]; then
+    capper_parent_monitors=yes
+else
+    capper_parent_monitors=no
+fi
+capper "$max_log_bytes" "$log_file" "$unit" "$capper_parent_monitors" < "$fifo" >&2 &
+capper_pid=$!
+capper_waited=0
+
+started=$(date +%s)
+started_monotonic_usec="$(python3 -c 'import time; print(time.monotonic_ns() // 1000)' 2>/dev/null)"
+if [ "$runner_state" = APPLIED ] && [ -n "$detached_report_file" ]; then
+    # Keep one inert process in the service after the payload exits. Without it,
+    # a successful transient service can disappear between systemd-run returning
+    # and the first accounting query. The payload writes its status atomically,
+    # then blocks on this FIFO while we read the still-live unit's counters and
+    # publish the complete report. RuntimeMaxSec and the lethal log cap still
+    # kill the whole cgroup, including this holder.
+    payload_status_file="$log_dir/.resource-payload-status"
+    payload_binary_identity_file="$log_dir/.resource-binary-sha256"
+    payload_release_fifo="$log_dir/.resource-payload-release"
+    payload_start_fifo="$log_dir/.resource-payload-start"
+    mkfifo "$payload_start_fifo" "$payload_release_fifo" 2>/dev/null \
+        || die "cannot create resource-accounting gate fifos"
+    resource_wrapper=(python3 -c '
+import ctypes
+import hashlib
+import os
+import pathlib
+import signal
+import stat
+import subprocess
+import sys
+
+status_file = pathlib.Path(sys.argv[1])
+release_fifo = pathlib.Path(sys.argv[2])
+start_fifo = pathlib.Path(sys.argv[3])
+stderr_fifo = pathlib.Path(sys.argv[4])
+binary_identity_file = pathlib.Path(sys.argv[5])
+binary_path = sys.argv[6]
+
+# A direct child may leave double-forked descendants behind. Become their
+# subreaper before launch, then do not publish payload status until every
+# adopted descendant is gone. This keeps the outer cgroup sampler authoritative
+# for the entire payload tree, including daemons that close stderr.
+PR_SET_CHILD_SUBREAPER = 36
+libc = ctypes.CDLL(None, use_errno=True)
+if libc.prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) != 0:
+    raise OSError(ctypes.get_errno(), "PR_SET_CHILD_SUBREAPER")
+
+# Pin the executable inode that is hashed. Executing /proc/self/fd/N with the
+# descriptor inherited closes the pathname-replacement race between identity
+# measurement and exec, including for arbitrary binaries under /tmp.
+binary_fd = os.open(binary_path, os.O_RDONLY | os.O_CLOEXEC)
+identity = os.fstat(binary_fd)
+if not stat.S_ISREG(identity.st_mode):
+    raise SystemExit(126)
+digest = hashlib.sha256()
+while True:
+    chunk = os.read(binary_fd, 1024 * 1024)
+    if not chunk:
+        break
+    digest.update(chunk)
+os.lseek(binary_fd, 0, os.SEEK_SET)
+identity_temporary = binary_identity_file.with_name(binary_identity_file.name + ".tmp")
+identity_temporary.write_text(digest.hexdigest() + "\n", encoding="ascii")
+identity_temporary.replace(binary_identity_file)
+with stderr_fifo.open("wb", buffering=0) as payload_stderr:
+    # Open the payload-only writer before waiting at the launch gate. If
+    # preflight refuses the service, killing this wrapper then gives the capper
+    # an exact EOF even though the payload was never allowed to start.
+    with start_fifo.open("rb") as stream:
+        if not stream.read(1):
+            raise SystemExit(126)
+    completed = subprocess.run(
+        [binary_path, *sys.argv[7:]],
+        check=False,
+        executable=f"/proc/self/fd/{binary_fd}",
+        stderr=payload_stderr,
+        pass_fds=(binary_fd,),
+    )
+    while True:
+        try:
+            os.waitpid(-1, 0)
+        except ChildProcessError:
+            break
+os.close(binary_fd)
+caller_status = 128 - completed.returncode if completed.returncode < 0 else completed.returncode
+temporary = status_file.with_name(status_file.name + ".tmp")
+temporary.write_text(str(caller_status) + "\n", encoding="ascii")
+temporary.replace(status_file)
+with release_fifo.open("rb") as stream:
+    if not stream.read(1):
+        raise SystemExit(126)
+if completed.returncode < 0:
+    signum = -completed.returncode
+    signal.signal(signum, signal.SIG_DFL)
+    os.kill(os.getpid(), signum)
+    raise SystemExit(128 + signum)
+raise SystemExit(completed.returncode)
+' "$payload_status_file" "$payload_release_fifo" "$payload_start_fifo" "$fifo" \
+        "$payload_binary_identity_file" "$hermit_bin" "$@")
+    "${runner[@]}" "${resource_wrapper[@]}" &
+    runner_pid=$!
+
+    # The report already contains the owned unit name. Resolve only that unit's
+    # cgroup, then retain its monotonic pids.peak while waiting. This also gives
+    # timeout/cap outcomes a task count even though their cgroup vanishes on kill.
+    for _ in $(seq 1 100); do
+        resolve_detached_cgroup && break
+        kill -0 "$runner_pid" 2>/dev/null || break
+        sleep 0.02
+    done
+    if [ -n "$detached_cgroup_path" ] && verify_detached_limits; then
+        if ! sample_detached_cgroup; then
+            detached_metrics_error="could not sample verified cgroup before payload launch"
+            kill_detached_unit || true
+        else
+            for _ in $(seq 1 100); do
+                accept_detached_binary_identity && break
+                kill -0 "$runner_pid" 2>/dev/null || break
+                sleep 0.02
+            done
+            if [ "$detached_binary_identity_accepted" -ne 1 ]; then
+                detached_metrics_error="could not authenticate the pinned executable before payload launch"
+                kill_detached_unit || true
+            elif ! signal_detached_fifo "$payload_start_fifo"; then
+                detached_metrics_error="could not release verified payload gate"
+                kill_detached_unit || true
+            fi
+        fi
+    else
+        detached_metrics_error="declared memory, task, or CPU-core limit was not applied exactly"
+        kill_detached_unit || true
+    fi
+    detached_empty_polls=0
+    detached_sample_failures=0
+    while [ ! -f "$payload_status_file" ]; do
+        if sample_detached_cgroup; then
+            detached_sample_failures=0
+        else
+            detached_group_dir="/sys/fs/cgroup${detached_cgroup_path}"
+            # RuntimeMaxSec removes the service cgroup before the foreground
+            # systemd-run client necessarily exits. Once that exact verified
+            # cgroup is gone, no payload can still be running inside it; leave
+            # the loop and collect the retained unit properties. Treating the
+            # still-draining systemd-run client as payload liveness made a
+            # legitimate wall timeout sporadically look like lost accounting.
+            [ -d "$detached_group_dir" ] || break
+            populated="$(sed -n 's/^populated //p' \
+                "$detached_group_dir/cgroup.events" 2>/dev/null)"
+            [ "$populated" != 0 ] || break
+            if [ "$populated" = 1 ] || kill -0 "$runner_pid" 2>/dev/null; then
+                detached_sample_failures=$((detached_sample_failures + 1))
+                if [ "$detached_sample_failures" -ge 3 ]; then
+                    detached_metrics_error="live cgroup resource counters became unreadable"
+                    kill_detached_unit || true
+                    break
+                fi
+            fi
+        fi
+        if [ -f "$log_file.cap-fired" ]; then
+            detached_log_cap_hit=1
+            if terminate_detached_unit; then
+                detached_log_cap_killed=1
+            else
+                detached_metrics_error="log cap fired but the owned cgroup could not be terminated"
+            fi
+            break
+        fi
+        if [ "$detached_cpu_usage_usec" -gt $((detached_cpu_timeout_secs * 1000000)) ]; then
+            detached_cpu_time_limit_hit=1
+            if ! terminate_detached_unit; then
+                detached_metrics_error="CPU-time budget fired but the owned cgroup could not be terminated"
+            fi
+            break
+        fi
+        if ! kill -0 "$runner_pid" 2>/dev/null; then
+            populated="$(sed -n 's/^populated //p' \
+                "/sys/fs/cgroup${detached_cgroup_path}/cgroup.events" 2>/dev/null)"
+            if [ "$populated" = 1 ]; then
+                detached_empty_polls=0
+            else
+                detached_empty_polls=$((detached_empty_polls + 1))
+                [ "$detached_empty_polls" -lt 20 ] || break
+            fi
+        fi
+        sleep 0.05
+    done
+    sample_detached_cgroup || true
+    [ ! -f "$log_file.cap-fired" ] || detached_log_cap_hit=1
+    if [ "$detached_cpu_usage_usec" -gt $((detached_cpu_timeout_secs * 1000000)) ]; then
+        detached_cpu_time_limit_hit=1
+        if ! terminate_detached_unit; then
+            detached_metrics_error="final CPU-time sample exceeded the budget but the owned cgroup could not be terminated"
+        fi
+    fi
+
+    payload_rc=""
+    if [ -f "$payload_status_file" ]; then
+        payload_rc="$(sed -n '1p' "$payload_status_file")"
+        if ! [[ "$payload_rc" =~ ^[0-9]+$ ]] || [ "$payload_rc" -gt 255 ]; then
+            detached_metrics_error="payload status is missing or malformed"
+            payload_rc=""
+        fi
+        # Status is published only after the payload tree has closed its stderr
+        # writer. Drain the capper before releasing the holder so a short final
+        # burst cannot publish its marker after the parent has already decided
+        # the run completed normally.
+        wait "$capper_pid" 2>/dev/null
+        capper_waited=1
+        capper_pid=""
+        if [ -f "$log_file.cap-fired" ]; then
+            detached_log_cap_hit=1
+            if terminate_detached_unit; then
+                detached_log_cap_killed=1
+            else
+                detached_metrics_error="log cap fired at payload completion but the owned cgroup could not be terminated"
+            fi
+        fi
+        # Status is written only after the subreaper has reaped every payload
+        # descendant. Release the sole holder and wait for the unit to terminate
+        # before taking the authoritative final counters.
+        if ! detached_unit_is_quiescent && ! signal_detached_fifo "$payload_release_fifo"; then
+            detached_metrics_error="could not release the quiescent resource-accounting holder"
+            terminate_detached_unit || true
+        fi
+    fi
+    runner_rc=0
+    wait "$runner_pid" 2>/dev/null || runner_rc=$?
+    runner_pid=""
+    wait "$capper_pid" 2>/dev/null
+    capper_waited=1
+    capper_pid=""
+    [ ! -f "$log_file.cap-fired" ] || detached_log_cap_hit=1
+
+    # A deadline, lethal log cap, or external cgroup kill bypasses payload
+    # status, but the retained unit properties remain queryable until cleanup.
+    # For ordinary completion, status proves the subreaper had no descendants
+    # before the holder exited. In both cases publication happens only now.
+    if [ "$detached_metrics_written" -eq 0 ] && [ -z "$detached_metrics_error" ]; then
+        detached_metrics="$(collect_detached_metrics)"
+        metrics_rc=$?
+        if [ "$metrics_rc" -eq 0 ]; then
+            read -r detached_memory_peak detached_cpu_usage detached_tasks_peak \
+                detached_result_oom detached_result_timeout <<<"$detached_metrics"
+            [ "$detached_result_oom" -le "$detached_memory_oom_kills" ] \
+                || detached_memory_oom_kills="$detached_result_oom"
+            [ "$detached_result_timeout" -le "$detached_wall_time_limit_hit" ] \
+                || detached_wall_time_limit_hit="$detached_result_timeout"
+            if unsigned_decimal_gt "$detached_cpu_usage" "$detached_limit_cpu_time_nsec"; then
+                detached_cpu_time_limit_hit=1
+            fi
+            if finish_detached_report "$detached_memory_peak" "$detached_cpu_usage" "$detached_tasks_peak"; then
+                detached_metrics_written=1
+            else
+                detached_metrics_error="atomic post-termination resource report completion failed"
+            fi
+        else
+            detached_metrics_error="required post-termination resource property is missing or malformed"
+        fi
+    fi
+    if [ -n "$payload_rc" ]; then
+        rc=$payload_rc
+    else
+        rc=$runner_rc
+    fi
+elif [ "$runner_state" = APPLIED ]; then
+    "${runner[@]}" "$hermit_bin" "$@" 2>"$fifo"
+    rc=$?
+    runner_rc=$rc
+else
+    "$hermit_bin" "$@" 2>"$fifo"
+    rc=$?
+    runner_rc=$rc
+fi
+if [ "$capper_waited" -eq 0 ]; then
+    wait "$capper_pid" 2>/dev/null
+    capper_pid=""
+fi
+[ ! -f "$log_file.cap-fired" ] || detached_log_cap_hit=1
+rm -f "$fifo"
+if [ -n "${payload_release_fifo:-}" ]; then
+    rm -f "$payload_start_fifo" "$payload_release_fifo" "$payload_status_file" "$payload_status_file.tmp" \
+        "$payload_binary_identity_file" "$payload_binary_identity_file.tmp" \
+        "$log_dir/.resource-unit-location" "$log_dir/.resource-unit-properties"
+fi
+rm -f "$log_file.cap-fired" "$log_file.cap-fired.tmp"
+elapsed=$(( $(date +%s) - started ))
+
+# ---------------------------------------------------------------- report
+trunc="unknown"; wrote="unknown"
+if [ -f "$log_file.meta" ]; then
+    trunc="$(sed -n 's/^truncated=//p' "$log_file.meta")"
+    killed="$(sed -n 's/^killed=//p' "$log_file.meta")"
+    wrote="$(sed -n 's/^bytes_written=//p' "$log_file.meta")"
+fi
+field elapsed_secs  "$elapsed"
+field bytes_written "$wrote"
+field truncated     "$trunc"
+field runner_exit_code "$runner_rc"
+if [ -n "$detached_report_file" ]; then
+    if [ "$detached_metrics_written" -eq 1 ]; then
+        field resource_report_state "COMPLETE"
+    else
+        field resource_report_state "INCOMPLETE:${detached_metrics_error:-payload ended before accounting could complete}"
+    fi
+fi
+if [ "$trunc" = true ]; then
+    if [ "$detached_log_cap_killed" -eq 1 ] && [ "${killed:-}" != cgroup-killed ]; then
+        killed="parent-cgroup-killed"
+    fi
+    field killed_at_cap "${killed:-unknown}"
+    # A distinct code, because "255" tells a caller nothing about WHY.
+    if [ "${killed:-}" = "cgroup-killed" ] || [ "$detached_log_cap_killed" -eq 1 ]; then
+        rc=125
+    fi
+    say "LOG CAP: the run hit the ${max_log_bytes}-byte cap (${killed:-unknown}). The log is INCOMPLETE by design; the kept bytes are the evidence."
+fi
+# ---------------------------------------------------------------- deadline verdict
+# ASK SYSTEMD, DO NOT INFER. This used to reconstruct "did the deadline fire?" from
+# two proxies -- `elapsed >= deadline` arithmetic, and an allowlist of child exit
+# codes (143/137/1) -- and both can be wrong.
+#
+# THE REPRODUCED FAILURE, which is why this is not a tidy-up. `--sh-deadline 6s` is a
+# perfectly ordinary thing for a caller to write and systemd accepts it: RuntimeMaxSec
+# takes a suffix, the bound IS applied, and the run IS killed. But bash `[ 6 -ge 6s ]`
+# aborts with "integer expression expected", so the whole condition went false and the
+# kill went UNREPORTED -- measured, a 600s child under `--sh-deadline 6s` returned exit
+# 1 after 6s with zero DEADLINE lines, against exit 124 for `--sh-deadline 6`. Exit 1
+# is hermit's own convention for "the guest failed", so the caller sees a plausible
+# ordinary failure and has no reason to suspect the run was killed.
+#
+# `Result` is what systemd itself concluded, so neither proxy is needed and the
+# arithmetic that broke on "6s" is deleted rather than repaired.
+#
+# THE NON-ANSWER IS TREATED AS A NON-ANSWER. If the result cannot be read, this says
+# so and falls back to the old inference rather than trusting a blank -- a unit that
+# no longer exists reports Result=success, so "unreadable" and "the run was fine" look
+# identical and must not be conflated.
+unit_result=""
+if [ "$runner_state" = APPLIED ] && [ "$unit" != none ]; then
+    unit_result="$(systemctl --user show "$unit.service" -p Result --value 2>/dev/null)"
+    field unit_result "${unit_result:-UNREADABLE}"
+    case "$unit_result" in
+        exit-code|signal|core-dump)
+            # systemd-run reports core-dump as 1 and signal as 255, not the
+            # shell's 128 + signal number. Read the completed process before
+            # resetting its failed unit; never infer an abort from exit 1.
+            termination_text="$(timeout 5 systemctl --user show "$unit.service" \
+                -p Id -p LoadState -p ActiveState -p SubState -p Result \
+                -p ExecMainPID -p ExecMainCode -p ExecMainStatus \
+                -p ExecMainStartTimestampMonotonic 2>/dev/null)"
+            termination_query_rc=$?
+            declare -A termination=()
+            termination_valid=1
+            while IFS='=' read -r key value; do
+                case "$key" in
+                    Id|LoadState|ActiveState|SubState|Result|ExecMainPID|ExecMainCode|ExecMainStatus|ExecMainStartTimestampMonotonic)
+                        [ -z "${termination[$key]+present}" ] || termination_valid=0
+                        termination[$key]="$value" ;;
+                    *) termination_valid=0 ;;
+                esac
+            done <<<"$termination_text"
+            if [ "$termination_query_rc" -eq 0 ] && [ "$termination_valid" -eq 1 ] \
+                && [ "${#termination[@]}" -eq 9 ] \
+                && [ "${termination[Id]:-}" = "$unit.service" ] \
+                && [ "${termination[LoadState]:-}" = loaded ] \
+                && [ "${termination[ActiveState]:-}" = failed ] \
+                && [ "${termination[SubState]:-}" = failed ] \
+                && [ "${termination[Result]:-}" = "$unit_result" ] \
+                && [[ "${termination[ExecMainPID]:-}" =~ ^[1-9][0-9]*$ ]] \
+                && [[ "$started_monotonic_usec" =~ ^[1-9][0-9]{0,17}$ ]] \
+                && [[ "${termination[ExecMainStartTimestampMonotonic]:-}" =~ ^[1-9][0-9]{0,17}$ ]] \
+                && [ "${termination[ExecMainStartTimestampMonotonic]}" -ge "$started_monotonic_usec" ]; then
+                field exec_main_pid "${termination[ExecMainPID]}"
+                field exec_main_code "${termination[ExecMainCode]}"
+                field exec_main_status "${termination[ExecMainStatus]}"
+                field exec_main_start_monotonic_usec "${termination[ExecMainStartTimestampMonotonic]}"
+                if { [ "$unit_result" = signal ] && [ "${termination[ExecMainCode]}" = 2 ]; } \
+                    || { [ "$unit_result" = core-dump ] && [ "${termination[ExecMainCode]}" = 3 ]; }; then
+                    if [[ "${termination[ExecMainStatus]}" =~ ^([1-9]|[1-5][0-9]|6[0-4])$ ]] \
+                        && [ "$runner_rc" -ne 0 ]; then
+                        field process_signal "${termination[ExecMainStatus]}"
+                        # A deliberate cap verdict keeps its original priority.
+                        [ "$rc" -eq 125 ] || rc=$((128 + termination[ExecMainStatus]))
+                    else
+                        say "PROCESS STATUS UNREADABLE: invalid signal status; retaining runner exit $runner_rc."
+                    fi
+                elif [ "$unit_result" != exit-code ]; then
+                    say "PROCESS STATUS UNREADABLE: termination code differs from Result; retaining runner exit $runner_rc."
+                fi
+            else
+                say "PROCESS STATUS UNREADABLE: completed unit identity or properties differ; retaining runner exit $runner_rc."
+            fi
+            ;;
+    esac
+    # Clean up explicitly, since --collect is deliberately not used. A timed-out unit
+    # is left in the failed state otherwise, and its name stays taken.
+    systemctl --user stop "$unit.service" >/dev/null 2>&1 || true
+    systemctl --user reset-failed "$unit.service" >/dev/null 2>&1 || true
+    if [ -n "$detached_report_file" ] && detached_unit_is_quiescent; then
+        detached_cleanup_armed=0
+        trap - EXIT INT TERM HUP
+    fi
+fi
+if [ "$unit_result" = timeout ]; then
+    say "DEADLINE: the run reached ${deadline} and was killed by its cgroup (systemd Result=timeout, child exit $rc)."
