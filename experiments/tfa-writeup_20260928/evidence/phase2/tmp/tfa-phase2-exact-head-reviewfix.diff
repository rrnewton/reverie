+cleanup_detached_on_exit() {
+    local original_rc=$?
+    trap - EXIT INT TERM HUP
+    if [ "$detached_cleanup_armed" -eq 1 ]; then
+        terminate_detached_unit >/dev/null 2>&1 || true
