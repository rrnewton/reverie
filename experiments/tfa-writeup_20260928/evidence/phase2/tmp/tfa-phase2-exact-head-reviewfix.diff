+            raise HermitError("packaged Hermit qualification probe is malformed")
+        case_id = probe.get("case_id")
+        if not isinstance(case_id, str):
+            raise HermitError("packaged Hermit qualification probe is malformed")
+        expected = expected_markers.get(case_id)
+        argv = probe.get("argv")
+        stderr = probe.get("stderr")
+        stdout = probe.get("stdout")
+        result_receipt = probe.get("result_receipt")
+        safehermit_report = probe.get("safehermit_report")
+        if (
+            expected is None
+            or not isinstance(argv, list)
+            or not all(isinstance(token, str) for token in argv)
+            or not isinstance(stderr, str)
+            or not isinstance(stdout, str)
+            or not isinstance(result_receipt, str)
+            or not isinstance(safehermit_report, str)
+            or probe.get("seed") != expected[0]
+            or probe.get("returncode") != expected[1]
+            or expected[2] not in stderr
+            or expected[3] not in stderr
+            or "--sh-deadline" not in argv
+            or argv[argv.index("--sh-deadline") + 1] != "120"
+            or "--sh-max-log-bytes" not in argv
+            or argv[argv.index("--sh-max-log-bytes") + 1] != "67108864"
+            or "--sh-disk-limit" not in argv
