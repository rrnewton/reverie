+field binary        "$hermit_bin"
+field binary_source "$binary_source"
+field binary_sha256 "$binary_sha256"
+field log_dir       "$log_dir"
+field log_file      "$log_file"
+field unit          "$unit"
+field bound.wall      "$wall_state"
