+        reap_detached_helper "${capper_pid:-}"
+        timeout 5 systemctl --user stop "$unit.service" >/dev/null 2>&1 || true
+        systemctl --user reset-failed "$unit.service" >/dev/null 2>&1 || true
+    fi
