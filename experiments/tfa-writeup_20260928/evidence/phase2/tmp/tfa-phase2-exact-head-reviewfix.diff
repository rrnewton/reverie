+verify_detached_limits() {
+    [ -n "$detached_cgroup_path" ] || return 1
+    python3 - "/sys/fs/cgroup${detached_cgroup_path}" "$detached_memory_max_bytes" \
+        "$detached_tasks_max" "$detached_limit_cpu_cores_micros" 2>/dev/null <<'PY'
