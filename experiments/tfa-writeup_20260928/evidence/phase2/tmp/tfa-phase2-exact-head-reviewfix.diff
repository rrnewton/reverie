+signal_detached_fifo() {
+    # A cancellation may kill the service after the unit stub is published but
+    # before its gate reader opens. A plain shell redirection would then block
+    # forever in open(2), so every one-byte handoff has its own real-clock bound.
+    # shellcheck disable=SC2016
+    timeout 5 bash -c 'printf "\n" >"$1"' bash "$1"
