+kill_detached_unit() {
+    if [ -n "$detached_cgroup_path" ] \
+        && [ -w "/sys/fs/cgroup${detached_cgroup_path}/cgroup.kill" ]; then
+        printf '1\n' >"/sys/fs/cgroup${detached_cgroup_path}/cgroup.kill" 2>/dev/null \
+            && return 0
+    fi
+    local attempt
+    for attempt in $(seq 1 20); do
+        /usr/bin/systemctl --user kill --kill-whom=all --signal=KILL "$unit.service" \
+            >/dev/null 2>&1 && return 0
+        [ "$attempt" -eq 20 ] || sleep 0.02
+    done
+    return 1
+}
+
+detached_unit_is_quiescent() {
+    if [ -n "$detached_cgroup_path" ] \
+        && [ -d "/sys/fs/cgroup${detached_cgroup_path}" ]; then
+        local populated
+        populated="$(sed -n 's/^populated //p' \
+            "/sys/fs/cgroup${detached_cgroup_path}/cgroup.events" 2>/dev/null)"
+        [ "$populated" = 0 ] || return 1
+    fi
+    local active
+    active="$(systemctl --user show "$unit.service" -p ActiveState --value 2>/dev/null)"
+    [ "$active" != active ] && [ "$active" != activating ] && [ "$active" != deactivating ]
+}
+
+terminate_detached_unit() {
+    local attempt
+    if detached_unit_is_quiescent; then
+        return 0
+    fi
+    kill_detached_unit || true
+    for attempt in $(seq 1 100); do
+        detached_unit_is_quiescent && return 0
+        sleep 0.02
+    done
+    timeout 5 systemctl --user stop "$unit.service" >/dev/null 2>&1 || true
+    for attempt in $(seq 1 100); do
+        detached_unit_is_quiescent && return 0
+        sleep 0.02
+    done
+    return 1
+}
+
+reap_detached_helper() {
+    local helper_pid=$1
+    [ -n "$helper_pid" ] || return 0
+    local attempt
+    for attempt in $(seq 1 100); do
+        kill -0 "$helper_pid" 2>/dev/null || break
+        sleep 0.02
+    done
+    if kill -0 "$helper_pid" 2>/dev/null; then
+        kill -KILL "$helper_pid" 2>/dev/null || true
+    fi
+    wait "$helper_pid" 2>/dev/null || true
+}
