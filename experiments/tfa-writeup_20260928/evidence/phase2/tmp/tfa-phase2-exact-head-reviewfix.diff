+import pathlib
+import sys
+
+path, expected_unit, sampled_tasks = sys.argv[1:]
+known = {
+    "Id", "LoadState", "ActiveState", "SubState", "Result", "ControlGroup",
+    "MemoryPeak", "CPUUsageNSec", "TasksPeak",
+}
+fields = {}
+for line in pathlib.Path(path).read_text(encoding="utf-8").splitlines():
+    key, separator, value = line.partition("=")
+    if not separator or key not in known or key in fields:
+        raise SystemExit(1)
+    fields[key] = value
+if (
+    fields.get("Id") != expected_unit
+    or fields.get("LoadState") != "loaded"
+    or fields.get("ActiveState") not in {"active", "inactive", "failed"}
+    or not fields.get("SubState")
+):
+    raise SystemExit(1)
+
+def unsigned(name):
+    value = fields.get(name, "")
+    if not value.isascii() or not value.isdecimal():
+        raise SystemExit(1)
+    number = int(value)
+    if number >= 2**64 - 1:
+        raise SystemExit(1)
+    return number
+
+memory = unsigned("MemoryPeak")
+cpu = unsigned("CPUUsageNSec")
+tasks_raw = fields.get("TasksPeak", "")
+if tasks_raw.isascii() and tasks_raw.isdecimal():
+    tasks = int(tasks_raw)
+elif sampled_tasks.isascii() and sampled_tasks.isdecimal():
+    tasks = int(sampled_tasks)
+else:
+    raise SystemExit(1)
+print(
+    memory,
+    cpu,
+    tasks,
+    1 if fields.get("Result") == "oom-kill" else 0,
+    1 if fields.get("Result") == "timeout" else 0,
+)
+PY
