+def _current_verify_argv(argv: tuple[str, ...]) -> tuple[str, ...]:
+    """Translate the sealed historical contract to a919's equally strict CLI."""
+    boundary = argv.index("--")
+    options = list(argv[:boundary])
+    timeouts = [
+        token.partition("=")[2] for token in options if token.startswith("--timeout=")
+    ]
+    if (
+        options.count("--verify") != 1
+        or options.count("--verify-strict") != 1
+        or options.count("--keep-logs") != 1
+        or options.count("--verify-verbose") != 0
+        or len([token for token in options if token.startswith("--verify-log-dir=")])
+        != 1
+        or len(timeouts) != 1
+        or not timeouts[0].isascii()
+        or not timeouts[0].isdecimal()
+    ):
+        raise HermitError("historical strict verification contract is malformed")
+    inner_deadline = int(timeouts[0])
+    if inner_deadline != _safehermit_deadline(argv) - _HERMIT_UNWIND_SECONDS:
+        raise HermitError("historical Hermit timeout contract is malformed")
+    translated: list[str] = []
+    index = 0
+    while index < len(options):
+        token = options[index]
+        if token == "--verify-strict":
+            translated.append("--verify-verbose")
+        elif token == "--sh-deadline":
+            translated.extend((token, str(inner_deadline)))
+            index += 1
+        elif token.startswith("--sh-deadline="):
+            translated.append(f"--sh-deadline={inner_deadline}")
+        elif (
+            token == "--keep-logs"
+            or token.startswith("--verify-log-dir=")
+            or token.startswith("--timeout=")
+        ):
+            pass
+        else:
+            translated.append(token)
+        index += 1
+    if translated.count("--verify-verbose") != 1:
+        raise HermitError("current strict verification contract is ambiguous")
+    return (*translated, *argv[boundary:])
+
