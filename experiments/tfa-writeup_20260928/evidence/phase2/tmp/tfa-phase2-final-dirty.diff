+        or value.get("owner_pid") != os.getpid()
+        or value.get("recovery_token") != recovery_token
+    ):
+        raise AssertionError("fixture recovery receipt is not owned by this fixture")
+    path.unlink()
+    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(directory)
+    finally:
+        os.close(directory)
+
+
+def _fixture_root_identity(root: Path) -> tuple[int, int]:
+    metadata = root.lstat()
+    if (
+        not stat.S_ISDIR(metadata.st_mode)
+        or metadata.st_uid != os.getuid()
+        or stat.S_IMODE(metadata.st_mode) & 0o022
+    ):
+        raise AssertionError("fixture root is not a private owned directory")
+    return metadata.st_dev, metadata.st_ino
+
