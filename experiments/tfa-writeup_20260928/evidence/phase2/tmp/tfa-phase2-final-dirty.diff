+def _clear_fixture_recovery(path: Path, recovery_token: str) -> None:
+    metadata = path.lstat()
+    if (
+        not stat.S_ISREG(metadata.st_mode)
+        or metadata.st_uid != os.getuid()
+        or stat.S_IMODE(metadata.st_mode) != 0o600
+        or metadata.st_nlink != 1
+    ):
+        raise AssertionError("fixture recovery receipt is unsafe")
+    try:
