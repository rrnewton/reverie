+def _write_fixture_recovery(
+    token: str,
+    recovery_token: str,
+    kind: str,
+    root: Path,
+    root_identity: tuple[int, int],
+    phase: str,
+    **details: object,
+) -> Path:
+    _FIXTURE_RECOVERY_ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
+    recovery_root_metadata = _FIXTURE_RECOVERY_ROOT.lstat()
+    if (
+        not stat.S_ISDIR(recovery_root_metadata.st_mode)
+        or recovery_root_metadata.st_uid != os.getuid()
+        or stat.S_IMODE(recovery_root_metadata.st_mode) != 0o700
+    ):
+        raise AssertionError("fixture recovery root is unsafe")
+    path = _FIXTURE_RECOVERY_ROOT / f"{token}.json"
+    temporary = _FIXTURE_RECOVERY_ROOT / f".{token}.{os.getpid()}.tmp"
+    if os.path.lexists(path):
+        path_metadata = path.lstat()
+        if (
+            not stat.S_ISREG(path_metadata.st_mode)
+            or path_metadata.st_uid != os.getuid()
+            or stat.S_IMODE(path_metadata.st_mode) != 0o600
+            or path_metadata.st_nlink != 1
+        ):
+            raise AssertionError("fixture recovery receipt is unsafe")
+        try:
+            existing = json.loads(path.read_text())
+        except (OSError, json.JSONDecodeError) as error:
+            raise AssertionError("fixture recovery ownership is unreadable") from error
+        if (
+            not isinstance(existing, dict)
+            or existing.get("owner_pid") != os.getpid()
+            or existing.get("recovery_token") != recovery_token
+            or existing.get("root") != str(root)
+            or existing.get("root_identity")
+            != {"device": root_identity[0], "inode": root_identity[1]}
+        ):
+            raise AssertionError("fixture recovery ownership changed")
+    elif phase != "allocated":
+        raise AssertionError("fixture recovery receipt disappeared")
+    payload = {
+        "schema": "tfa.production-fixture-recovery.v1",
+        "kind": kind,
+        "owner_pid": os.getpid(),
+        "phase": phase,
+        "recovery_token": recovery_token,
+        "root": str(root),
+        "root_identity": {"device": root_identity[0], "inode": root_identity[1]},
+        **details,
+    }
+    descriptor = os.open(
+        temporary,
+        os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
+        0o600,
+    )
+    try:
+        with os.fdopen(descriptor, "w") as output:
+            json.dump(payload, output, sort_keys=True)
+            output.write("\n")
+            output.flush()
+            os.fsync(output.fileno())
+    except BaseException:
+        temporary.unlink(missing_ok=True)
+        raise
+    os.replace(temporary, path)
+    directory = os.open(_FIXTURE_RECOVERY_ROOT, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(directory)
+    finally:
+        os.close(directory)
+    return path
