+def _write_fixture_recovery(
+    token: str, kind: str, root: Path, phase: str, **details: object
+) -> Path:
+    _FIXTURE_RECOVERY_ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
+    path = _FIXTURE_RECOVERY_ROOT / f"{token}.json"
+    temporary = _FIXTURE_RECOVERY_ROOT / f".{token}.{os.getpid()}.tmp"
+    payload = {
+        "schema": "tfa.production-fixture-recovery.v1",
+        "kind": kind,
+        "owner_pid": os.getpid(),
+        "phase": phase,
+        "root": str(root),
+        **details,
+    }
+    descriptor = os.open(
+        temporary,
+        os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
+        0o600,
+    )
+    try:
+        with os.fdopen(descriptor, "w") as output:
+            json.dump(payload, output, sort_keys=True)
+            output.write("\n")
+            output.flush()
+            os.fsync(output.fileno())
+    except BaseException:
+        temporary.unlink(missing_ok=True)
+        raise
+    os.replace(temporary, path)
+    directory = os.open(_FIXTURE_RECOVERY_ROOT, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(directory)
+    finally:
+        os.close(directory)
+    return path
+
+
+def _clear_fixture_recovery(path: Path) -> None:
