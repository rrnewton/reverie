diff --git a/fbcode/testinfra/tfa/resources/bounded-run-space b/fbcode/testinfra/tfa/resources/bounded-run-space
new file mode 100755
--- /dev/null
+++ b/fbcode/testinfra/tfa/resources/bounded-run-space
@@ -0,0 +1,318 @@
+#!/usr/bin/env bash
+# bounded-run-space — give one unit of work its own bounded place to write.
+#
+# WHAT THIS IS
+# ------------
+# Creates a btrfs subvolume with a qgroup limit, hands back its path, reports what
+# was used, and tears it down. Only writes below the returned directory are
+# bounded. A caller that writes elsewhere -- including an explicit log path
+# outside it -- remains outside this limit. Cleanup deletes that subvolume;
+# qgroup exclusive bytes provide a pre-deletion reclaim estimate.
+#
+# WHY THIS EXISTS. On 2026-08-17..19 three hermit invocations wrote ~4.5 TB of
+# stderr each and filled the device. cgroup-v2 cannot prevent that: it has no
+# disk-SPACE control at all, and io.max is bandwidth, not bytes at rest. A qgroup
+# is the only mechanism here that bounds bytes at rest.
+#
+# MEASUREMENTS THIS IS BUILT ON (2026-08-19, 512 MiB loopback, compress=zstd:3 to
+# match /data; every number re-derived locally rather than inherited):
+#
+#   QGROUPS COUNT COMPRESSED, ON-DISK BYTES -- not logical. A 16 MiB max_rfer
+#   passed 513,747,600 LOGICAL bytes of the incident's own repeated log lines
+#   (490 MiB, 30.6x) before failing. qgroup referenced settled at 15.98 MiB.
+#   CONSEQUENCE FOR WHOEVER SETS --limit: this is a DISK number. "64M" buys a
+#   1-2 GB log file, which still costs real time to read, copy and grep.
+#
+#   THE ERRNO IS EDQUOT (122), NOT ENOSPC (28). ENOSPC is what a genuinely full
+#   filesystem gives. Both occur, on different code paths; a handler needs both.
+#
+#   COST IS NEGLIGIBLE: create + limit + delete measured at 2.1 ms of actual btrfs
+#   work over 20 iterations. Each `sudo` fork costs 11.3 ms, five times more than
+#   the work. Privilege is the cost here, not time.
+#
+# THE FAILURE MODE THIS IS DESIGNED AGAINST IS SILENCE, NOT HANGING. Measured on
+# hermit 0.2.0 across nine runs: it never hung. It either died with a bare exit 101
+# whose panic message could not be written (because the sink that filled WAS
+# stderr), or -- with --log-file -- completed in the same 26.0s as an unbounded
+# control, exit 1, guest output correct, and NOT ONE WORD about the log having been
+# truncated. On a full filesystem that path exited 0 with no log at all. A run that
+# reports success while its evidence is silently missing is worse than one that
+# hangs, because a hang gets investigated. So the bounded thing cannot be trusted to
+# report its own truncation: `report` below exists to do it from the outside.
+#
+# TWO TRAPS THIS ENCODES, both measured:
+#
+#   1. `btrfs qgroup limit` CANNOT BE TRUSTED BY ITS EXIT CODE ALONE for the
+#      property we care about. We therefore READ THE LIMIT BACK off the live
+#      qgroup and only report BOUNDED if the readback matches. A limit that was
+#      requested but not applied is precisely the "looks bounded, is not" failure
+#      this tool exists to prevent.
+#   2. NON-ROOT CAN CREATE A SUBVOLUME BUT CANNOT DELETE IT (create exit 0, delete
+#      exit 1, "Operation not permitted"). Creating without being able to destroy
+#      leaks a subvolume per run forever, so this refuses to create unless it can
+#      also verify it can clean up: everything goes through `sudo -n`.
+#
+# UNBOUNDED IS ALWAYS LOUD. If quotas are off, sudo is unavailable, or the target
+# is not btrfs, this still hands back a usable directory -- but it says UNBOUNDED
+# on stderr, exits 10 instead of 0, and drops a `.UNBOUNDED` marker file inside the
+# directory so someone finding the artifacts later knows they were never bounded.
+# A step that runs unbounded while appearing bounded is worse than no feature.
+#
+# USAGE
+#   dir=$(bounded-run-space create --limit 256M --tag mytag --base /tmp)   # exit 0 | 10
+#   bounded-run-space report  "$dir"                                       # exit 0 | 10 | 11
+#   bounded-run-space destroy "$dir"                                       # exit 0
+#
+# EXIT CODES
+#   0   bounded (create), under allowance (report), destroyed (destroy)
+#   2   bad usage
+#   10  UNBOUNDED -- the caller MUST relay this; the space exists but nothing caps it
+#   11  report only: the allowance threshold was reached, so the contents may be incomplete
+#   12  destroy failed; the path still exists
+set -uo pipefail
+
+PROG=bounded-run-space
+die() { echo "$PROG: $*" >&2; exit 2; }
+say() { echo "$PROG: $*" >&2; }
+
+# --- size parsing (byte count, or 512M / 2G SI, or 1Gi binary) -------------------
+parse_size() {
+    python3 - "$1" <<'PY'
+import re, sys
+s = sys.argv[1].strip()
+m = re.fullmatch(r'(\d+(?:\.\d+)?)\s*([KMGT]i?B?|B)?', s, re.IGNORECASE)
+if not m: sys.exit(1)
+val = float(m.group(1)); unit = (m.group(2) or "").upper().rstrip("B")
+mult = {"":1,"K":1000,"M":1000**2,"G":1000**3,"T":1000**4,
+        "KI":1024,"MI":1024**2,"GI":1024**3,"TI":1024**4}
+if unit not in mult: sys.exit(1)
+b = int(val*mult[unit])
+if b <= 0: sys.exit(1)
+print(b)
+PY
+}
+
+is_btrfs() { [ "$(stat -fc %T "$1" 2>/dev/null || true)" = "btrfs" ]; }
+have_sudo() { sudo -n true >/dev/null 2>&1; }
+
+# Resolve the subvolume id of PATH, or empty.
+subvol_id() { sudo -n btrfs subvolume show "$1" 2>/dev/null | awk '/Subvolume ID/{print $3; exit}'; }
+
+# Read the LIVE limit and usage for a subvolume: "referenced exclusive max_rfer".
+# Empty when quotas are off or the qgroup is absent.
+qgroup_row() {
+    local path="$1" id="$2"
+    sudo -n btrfs qgroup show -re --raw "$path" 2>/dev/null \
+        | awk -v q="0/$id" '$1==q {print $2" "$3" "$4; exit}'
+}
+
+mark_unbounded() { # $1=dir  $2=reason
+    local identity canonical
+    identity="$(stat -Lc '%d:%i' "$1")" || return 1
+    canonical="$(cd "$1" && pwd -P)" || return 1
+    printf '%s\n' \
+        "This directory was NOT bounded." \
+        "directory=$canonical" \
+        "device_inode=$identity" \
+        "reason: $2" \
+        "Nothing limited how many bytes were written here. Totals below are not a guarantee." \
+        > "$1/.UNBOUNDED" 2>/dev/null
+}
+
+record_unbounded_or_remove() { # $1=dir  $2=reason
+    local dir="$1" reason="$2"
+    mark_unbounded "$dir" "$reason" && return 0
+    if [ -n "$(subvol_id "$dir")" ]; then
+        sudo -n btrfs subvolume delete "$dir" >/dev/null 2>&1 || true
+    else
+        rm -f -- "$dir/.UNBOUNDED" 2>/dev/null || true
+        rmdir -- "$dir" 2>/dev/null || true
+    fi
+    die "create: could not record that the returned space was unbounded; removed it instead"
+}
+
+mark_bounded() { # $1=dir  $2=subvolume-id  $3=limit-bytes
+    local identity canonical
+    identity="$(stat -Lc '%d:%i' "$1")" || return 1
+    canonical="$(cd "$1" && pwd -P)" || return 1
+    printf '%s\n' \
+        "bounded-run-space/v1" \
+        "directory=$canonical" \
+        "device_inode=$identity" \
+        "subvolume_id=$2" \
+        "limit_bytes=$3" \
+        > "$1/.BOUNDED_RUN_SPACE"
+}
+
+owned_path() {
+    local dir="$1" name marker canonical recorded_dir identity recorded_identity
+    [ ! -L "$dir" ] || return 1
+    name="$(basename -- "$dir")"
+    case "$name" in brs-*) ;; *) return 1 ;; esac
+    if [ "$(head -n 1 "$dir/.BOUNDED_RUN_SPACE" 2>/dev/null)" = "bounded-run-space/v1" ]; then
+        marker="$dir/.BOUNDED_RUN_SPACE"
+    elif [ "$(head -n 1 "$dir/.UNBOUNDED" 2>/dev/null)" = "This directory was NOT bounded." ]; then
+        marker="$dir/.UNBOUNDED"
+    else
+        return 1
+    fi
+    canonical="$(cd "$dir" && pwd -P)" || return 1
+    recorded_dir="$(sed -n 's/^directory=//p' "$marker")"
+    identity="$(stat -Lc '%d:%i' "$dir")" || return 1
+    recorded_identity="$(sed -n 's/^device_inode=//p' "$marker")"
+    [ "$recorded_dir" = "$canonical" ] && [ "$recorded_identity" = "$identity" ]
+}
+
+# --------------------------------------------------------------------------- create
+cmd_create() {
+    local limit="" base="${TMPDIR:-/tmp}" tag="run"
+    while [ $# -gt 0 ]; do
+        case "$1" in
+            --limit) [ $# -ge 2 ] || die "--limit needs a value"; limit="$2"; shift 2 ;;
+            --limit=*) limit="${1#*=}"; shift ;;
+            --base)  [ $# -ge 2 ] || die "--base needs a value";  base="$2";  shift 2 ;;
+            --base=*)  base="${1#*=}";  shift ;;
+            --tag)   [ $# -ge 2 ] || die "--tag needs a value";   tag="$2";   shift 2 ;;
+            --tag=*)   tag="${1#*=}";   shift ;;
+            *) die "create: unknown argument '$1'" ;;
+        esac
+    done
+    [ -n "$limit" ] || die "create: --limit is required"
+    local bytes; bytes="$(parse_size "$limit")" || die "create: --limit: bad size '$limit'"
+    local safe
+    safe="$(printf '%s' "$tag" | tr -c 'A-Za-z0-9._-' '-' | cut -c1-48)"
+    mkdir -p "$base" 2>/dev/null || die "create: cannot create base $base"
+    base="$(cd "$base" && pwd -P)" || die "create: cannot resolve base $base"
+    local dir
+    dir="$base/brs-$safe-$$-$(date +%s%N)"
+
+    # Decide up front whether a bound is even possible, and name the reason if not.
+    local reason=""
+    if ! is_btrfs "$base"; then reason="$base is not btrfs (fstype=$(stat -fc %T "$base" 2>/dev/null))"
+    elif ! have_sudo;      then reason="passwordless sudo unavailable; subvolume create/delete both need it"
+    fi
+    if [ -n "$reason" ]; then
+        mkdir -p "$dir" || die "create: cannot create $dir"
+        record_unbounded_or_remove "$dir" "$reason"
+        say "UNBOUNDED: $reason"
+        say "UNBOUNDED: handing back a PLAIN DIRECTORY at $dir with NOTHING capping its size."
+        printf '%s\n' "$dir"; return 10
+    fi
+
+    if ! sudo -n btrfs subvolume create "$dir" >/dev/null 2>&1; then
+        mkdir -p "$dir" || die "create: cannot create $dir"
+        record_unbounded_or_remove "$dir" "btrfs subvolume create failed"
+        say "UNBOUNDED: could not create a subvolume at $dir; using a plain directory, size NOT capped."
+        printf '%s\n' "$dir"; return 10
+    fi
+    sudo -n chown "$(id -u):$(id -g)" "$dir" 2>/dev/null || true
+
+    local id; id="$(subvol_id "$dir")"
+    if [ -z "$id" ]; then
+        record_unbounded_or_remove "$dir" "created path has no readable btrfs subvolume id"
+        say "UNBOUNDED: created $dir but could not read its subvolume id."
+        printf '%s\n' "$dir"; return 10
+    fi
+    local limit_err; limit_err="$(sudo -n btrfs qgroup limit "$bytes" "0/$id" "$base" 2>&1)"
+    # READBACK, NOT THE EXIT CODE. Only a live max_rfer equal to what we asked for
+    # counts as bounded; anything else degrades loudly rather than pretending.
+    local row max_rfer; row="$(qgroup_row "$base" "$id")"; max_rfer="$(echo "$row" | awk '{print $3}')"
+    if [ "${max_rfer:-none}" != "$bytes" ]; then
+        record_unbounded_or_remove "$dir" "qgroup limit not in force (readback='${max_rfer:-unreadable}', wanted=$bytes; ${limit_err:-no error text})"
+        say "UNBOUNDED: asked for a ${bytes}-byte quota on subvolume 0/$id but the readback says '${max_rfer:-unreadable}'."
+        [ -n "$limit_err" ] && say "UNBOUNDED: btrfs said: $limit_err"
+        say "UNBOUNDED: $dir is a real subvolume but NOTHING CAPS ITS SIZE. Enable quotas to bound it."
+        printf '%s\n' "$dir"; return 10
+    fi
+
+    if ! mark_bounded "$dir" "$id" "$bytes"; then
+        sudo -n btrfs subvolume delete "$dir" >/dev/null 2>&1 || true
+        die "create: could not record ownership marker; removed the new subvolume"
+    fi
+
+    say "bounded: $dir  subvol=0/$id  limit=${bytes} bytes of ON-DISK (compressed) space"
+    say "bounded: note the allowance is measured AFTER compression; expect logical files many times larger"
+    printf '%s\n' "$dir"; return 0
+}
+
+# --------------------------------------------------------------------------- report
+cmd_report() {
+    local dir="${1:-}"; [ -n "$dir" ] || die "report: need a path"
+    [ -d "$dir" ] || die "report: no such directory $dir"
+    if ! owned_path "$dir"; then
+        say "UNBOUNDED: $dir has no matching bounded-run-space identity marker"
+        return 10
+    fi
+    if [ -f "$dir/.UNBOUNDED" ]; then
+        say "UNBOUNDED: $dir was never bounded; byte totals here guarantee nothing."
+        sed 's/^/  /' "$dir/.UNBOUNDED" >&2 2>/dev/null || true
+        return 10
+    fi
+    local base id row recorded_id recorded_limit
+    base="$(dirname "$dir")"; id="$(subvol_id "$dir")"
+    [ -n "$id" ] || { say "UNBOUNDED: $dir is not a subvolume"; return 10; }
+    recorded_id="$(sed -n 's/^subvolume_id=//p' "$dir/.BOUNDED_RUN_SPACE")"
+    recorded_limit="$(sed -n 's/^limit_bytes=//p' "$dir/.BOUNDED_RUN_SPACE")"
+    if [ "$id" != "$recorded_id" ] || ! [[ "$recorded_limit" =~ ^[0-9]+$ ]]; then
+        say "UNBOUNDED: marker identity does not match live subvolume $id"
+        return 10
+    fi
+    row="$(qgroup_row "$base" "$id")"
+    [ -n "$row" ] || { say "UNBOUNDED: no qgroup row for 0/$id (quotas off?)"; return 10; }
+    local ref exc mx; ref="$(echo "$row" | awk '{print $1}')"; exc="$(echo "$row" | awk '{print $2}')"; mx="$(echo "$row" | awk '{print $3}')"
+    if [ "$mx" != "$recorded_limit" ]; then
+        say "UNBOUNDED: live qgroup limit is '$mx', marker records '$recorded_limit'"
+        return 10
+    fi
+    echo "referenced=$ref exclusive=$exc limit=$mx"
+    if [ "$mx" != "none" ] && [ "${ref:-0}" -ge "$(( mx - mx / 100 ))" ]; then
+        # Within 1% of the allowance: treat as reached. The bounded process will NOT
+        # tell you this -- measured: hermit exits 0 or 1 with a silently truncated log.
+        say "ALLOWANCE THRESHOLD REACHED: referenced=$ref of limit=$mx. Anything written here may be INCOMPLETE."
+        return 11
+    fi
+    return 0
+}
+
+# --------------------------------------------------------------------------- destroy
+cmd_destroy() {
+    local dir="${1:-}"; [ -n "$dir" ] || die "destroy: need a path"
+    [ -d "$dir" ] || { say "destroy: $dir already gone"; return 0; }
+    if ! owned_path "$dir"; then
+        say "destroy: REFUSING path without a matching bounded-run-space identity marker: $dir"
+        return 12
+    fi
+    local base id exc; base="$(dirname "$dir")"; id="$(subvol_id "$dir")"
+    if [ -z "$id" ]; then
+        rm -rf -- "$dir" 2>/dev/null || sudo -n rm -rf -- "$dir" 2>/dev/null || true
+        [ ! -e "$dir" ] || { say "destroy: could not remove plain directory $dir"; return 12; }
+        say "destroyed (plain directory, no reclaim figure available): $dir"
+        return 0
+    fi
+    exc="$(qgroup_row "$base" "$id" | awk '{print $2}')"
+    if ! sudo -n btrfs subvolume delete "$dir" >/dev/null 2>&1; then
+        say "destroy: subvolume delete failed for $dir"
+        return 12
+    fi
+    # SYNC BEFORE MEASURING. Subvolume deletion is ASYNCHRONOUS: measured, reading df
+    # immediately after delete reported 0 bytes reclaimed on a filesystem that then
+    # gave back 10.7 MB. An unsynced reading under-reports how much space is still
+    # held, which is the dangerous direction.
+    sudo -n btrfs subvolume sync "$base" >/dev/null 2>&1 || true
+    if [ -n "$exc" ]; then
+        # Exclusive over-predicts slightly (measured: predicted 10,915,840, df returned
+        # 10,768,384 -- 1.4% optimistic), so it is an upper bound on reclaim, not exact.
+        say "destroyed: $dir  reclaimed about $exc bytes (qgroup exclusive; ~1.5% optimistic)"
+    else
+        say "destroyed: $dir"
+    fi
+    return 0
+}
+
+case "${1:-}" in
+    create)  shift; cmd_create "$@" ;;
+    report)  shift; cmd_report "$@" ;;
+    destroy) shift; cmd_destroy "$@" ;;
+    -h|--help|"") sed -n '2,/^set -uo pipefail/{/^set -uo pipefail/d;p}' "$0"; exit 0 ;;
+    *) die "unknown subcommand '${1}' (want create|report|destroy)" ;;
+esac
diff --git a/fbcode/testinfra/tfa/resources/safehermit b/fbcode/testinfra/tfa/resources/safehermit
new file mode 100755
--- /dev/null
+++ b/fbcode/testinfra/tfa/resources/safehermit
@@ -0,0 +1,1452 @@
+#!/usr/bin/env bash
+# safehermit -- the only hermit entry point agents may call.
+#
+# WHY THIS EXISTS
+# ===============
+# On 2026-08-17 three hermit runs each wrote ~4.5 TB of stderr over 28+ hours at
+# 75% CPU and filled the filesystem, taking down ORC and every running agent. No
+# single mechanism would have stopped it, so this applies several and -- the part
+# that matters -- SAYS WHICH ONES IT COULD NOT APPLY.
+#
+# THE CASE THAT DECIDES WHETHER THIS WORKS. The incident binary was
+# /tmp/hermit-ers-patched, invoked by absolute path. Absolute-path execution never
+# consults PATH, so a shim named `hermit` dropped in front covers the ordinary case
+# and misses precisely the one that caused the outage. This therefore takes the
+# binary as an argument:
+#
+#     safehermit /tmp/hermit-ers-patched run -- ./prog     # arbitrary binary
+#     safehermit run -- ./prog                             # default hermit
+#     safehermit --sh-resource-report /tmp/seed-7.resources \
+#       --sh-memory-max-bytes 17179869184 --sh-tasks-max 256 \
+#       --sh-cpu-cores 1 --sh-cpu-timeout 900 --sh-deadline 2700 run -- ./prog
+#
+# The first argument is the hermit binary IF it contains a `/` and is executable,
+# or if --bin is given. Nothing else is treated as a binary, so a subcommand
+# (`run`, `record`, `replay`, `verify`, `log-diff` -- none contains a `/`) can
+# never be mistaken for one.
+#
+# FAIL LOUD, NEVER SILENTLY UNBOUNDED
+# ===================================
+# Every bound is reported on EVERY run as APPLIED or NOT_APPLIED with a reason,
+# including when everything works. This is deliberate and is the whole discipline:
+# on the day of the incident several mechanisms were present and inert, and a
+# wrapper that only speaks up when something breaks becomes another one of them.
+# `safehermit: bound.* =` lines are the contract; grep them.
+#
+# WHAT IT DOES NOT DO
+# ===================
+# It does not change hermit's behaviour, arguments or stdio. The child exit code
+# is preserved unless an explicitly requested resource report cannot be completed,
+# which fails closed with 2. stdout and stderr of the child are passed through
+# untouched; everything this script says goes to stderr prefixed `safehermit:` so
+# it can never be confused with, or parsed as, hermit output.
+#
+# EXIT CODES
+#   the child's exit code, verbatim, when accounting (if requested) completes
+#   2   safehermit usage error, or opted-in resource accounting refusal
+#   124 the deadline fired and the run was killed by its cgroup
+#   125 the log cap fired and the run was killed by its cgroup
+#   126 the opted-in aggregate CPU-time budget fired
+set -uo pipefail
+
+PROG=safehermit
+# WHERE THIS SCRIPT'S OWN LINES GO. Default 2 (stderr), exactly as before.
+# --sh-report FILE moves them, and the reason is a measured demo failure, not
+# tidiness: demos/05-qemu-boot.py hashes its hermit log into run-metadata.json
+# (info_log_sha256) and demo_common.compare_runs then LINE-DIFFS two runs' logs,
+# failing the repeat on any difference that survives normalization. Six of the
+# lines below embed run_id, which is a UTC timestamp plus this script's pid and so
+# differs on every run. Verified against the real comparator: hermit_log_diff on
+# two otherwise-identical logs reports "first divergence at line 1 ... run_id",
+# i.e. wiring that demo to safehermit while the report shares fd 2 with hermit's
+# stderr would fail repeat verification on 100% of runs, for a reason that has
+# nothing to do with hermit.
+# The report is still WRITTEN and still greppable -- this only changes where -- so
+# the "fail loud, never silently unbounded" discipline is intact. A caller that
+# redirects it takes on the job of surfacing it.
+REPORT_FD=2
+say()  { printf '%s: %s\n' "$PROG" "$*" >&$REPORT_FD; }
+# die() stays on real stderr: a usage error must be visible even when the caller
+# has pointed the report at a file it is not going to read.
+die()  { printf '%s: %s\n' "$PROG" "$*" >&2; exit 2; }
+field(){ printf '%s: %s=%s\n' "$PROG" "$1" "$2" >&$REPORT_FD; }
+
+# ---------------------------------------------------------------- defaults
+DEFAULT_DEADLINE_SECS=3600          # (2) no run outlives a default without opting out
+DEFAULT_MAX_LOG_BYTES=$((64*1024*1024))   # LOW ON PURPOSE -- see the cap note below
+DEFAULT_DISK_LIMIT=8G
+DEFAULT_MEM_MAX=16G
+# (4) THE EMITTER IS DELIBERATELY LEFT ALONE. An earlier version of this script
+# defaulted RUST_LOG=detcore::scheduler=warn, which does work (measured: stderr
+# 380 -> 272 lines, detcore::scheduler 40 -> 0). The owner ruled against it, and
+# the reasoning is better: a spinning program SHOULD die from the timeout or from
+# the log hitting a low cap. Quieting the emitter hides the very signal that a run
+# is stuck -- it makes a wedged run look healthy and cheap. So the cap is set LOW
+# so that it is the thing that fires, the deadline backs it up, and the first
+# bytes are kept as evidence. RUST_LOG is never set by safehermit; the caller's
+# value, if any, is passed through untouched.
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+LOG_ROOT="${SAFEHERMIT_LOG_ROOT:-$ROOT/ignored/safehermit}"
+REGISTRY="$LOG_ROOT/registry"
+
+deadline=$DEFAULT_DEADLINE_SECS
+max_log_bytes=$DEFAULT_MAX_LOG_BYTES
+disk_limit=$DEFAULT_DISK_LIMIT
+mem_max=$DEFAULT_MEM_MAX
+bin_override=""
+no_deadline=0
+deadline_explicit=0
+fresh=0
+report_file=""
+detached_report_file=""
+detached_memory_max_bytes=""
+detached_tasks_max=""
+detached_cpu_cores=""
+detached_cpu_timeout_secs=""
+
+# ---------------------------------------------------------------- our own flags
+# Parsed ONLY until the first argument we do not own, so hermit's own flags are
+# never intercepted. `--` ends our parsing explicitly.
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --sh-bin)       [ $# -ge 2 ] || die "--sh-bin needs a value"; bin_override="$2"; shift 2 ;;
+        --sh-bin=*)     bin_override="${1#*=}"; shift ;;
+        --sh-deadline)  [ $# -ge 2 ] || die "--sh-deadline needs a value"; deadline="$2"; deadline_explicit=1; shift 2 ;;
+        --sh-deadline=*) deadline="${1#*=}"; deadline_explicit=1; shift ;;
+        --sh-no-deadline) no_deadline=1; shift ;;
+        --sh-fresh) fresh=1; shift ;;
+        --sh-report)    [ $# -ge 2 ] || die "--sh-report needs a value"; report_file="$2"; shift 2 ;;
+        --sh-report=*)  report_file="${1#*=}"; shift ;;
+        --sh-resource-report) [ $# -ge 2 ] || die "--sh-resource-report needs a value"; detached_report_file="$2"; shift 2 ;;
+        --sh-resource-report=*) detached_report_file="${1#*=}"; shift ;;
+        --sh-memory-max-bytes) [ $# -ge 2 ] || die "--sh-memory-max-bytes needs a value"; detached_memory_max_bytes="$2"; shift 2 ;;
+        --sh-memory-max-bytes=*) detached_memory_max_bytes="${1#*=}"; shift ;;
+        --sh-tasks-max) [ $# -ge 2 ] || die "--sh-tasks-max needs a value"; detached_tasks_max="$2"; shift 2 ;;
+        --sh-tasks-max=*) detached_tasks_max="${1#*=}"; shift ;;
+        --sh-cpu-cores) [ $# -ge 2 ] || die "--sh-cpu-cores needs a value"; detached_cpu_cores="$2"; shift 2 ;;
+        --sh-cpu-cores=*) detached_cpu_cores="${1#*=}"; shift ;;
+        --sh-cpu-timeout) [ $# -ge 2 ] || die "--sh-cpu-timeout needs a value"; detached_cpu_timeout_secs="$2"; shift 2 ;;
+        --sh-cpu-timeout=*) detached_cpu_timeout_secs="${1#*=}"; shift ;;
+        --sh-max-log-bytes)   [ $# -ge 2 ] || die "needs a value"; max_log_bytes="$2"; shift 2 ;;
+        --sh-max-log-bytes=*) max_log_bytes="${1#*=}"; shift ;;
+        --sh-disk-limit)   [ $# -ge 2 ] || die "needs a value"; disk_limit="$2"; shift 2 ;;
+        --sh-disk-limit=*) disk_limit="${1#*=}"; shift ;;
+        --sh-help|-h)
+            sed -n '2,/^set -uo pipefail/{/^set -uo pipefail/d;p}' "$0" | sed 's/^# \{0,1\}//'
+            exit 0 ;;
+        --) shift; break ;;
+        *) break ;;
+    esac
+done
+
+detached_limit_count=0
+for detached_limit in "$detached_memory_max_bytes" "$detached_tasks_max" \
+    "$detached_cpu_cores" "$detached_cpu_timeout_secs"; do
+    [ -z "$detached_limit" ] || detached_limit_count=$((detached_limit_count + 1))
+done
+if [ -n "$detached_report_file" ]; then
+    [ "$detached_limit_count" -eq 4 ] \
+        || die "--sh-resource-report requires --sh-memory-max-bytes, --sh-tasks-max, --sh-cpu-cores, and --sh-cpu-timeout"
+    if [ "$deadline_explicit" -ne 1 ] || [ "$no_deadline" -ne 0 ]; then
+        die "--sh-resource-report requires an explicit --sh-deadline"
+    fi
+    detached_limits="$(python3 - "$detached_memory_max_bytes" "$detached_tasks_max" \
+        "$detached_cpu_cores" "$detached_cpu_timeout_secs" "$deadline" <<'PY'
+import sys
+
+names = ("memory bytes", "tasks", "CPU cores", "CPU timeout seconds", "wall deadline seconds")
+values = []
+for name, raw in zip(names, sys.argv[1:]):
+    if not raw.isascii() or not raw.isdecimal() or int(raw) <= 0:
+        raise SystemExit(f"{name} must be a positive unsigned integer in detached mode")
+    values.append(int(raw))
+memory, tasks, cores, cpu_seconds, wall_seconds = values
+if cores > 316:
+    raise SystemExit("CPU cores exceeds the 316-worker host safety ceiling")
+for name, value in (("CPU timeout", cpu_seconds), ("wall deadline", wall_seconds)):
+    if value > (2**63 - 1) // 1_000_000_000:
+        raise SystemExit(f"{name} cannot be represented in nanoseconds")
+print(memory, tasks, cores, cpu_seconds, wall_seconds)
+PY
+)" || die "invalid detached resource limit"
+    read -r detached_memory_max_bytes detached_tasks_max detached_cpu_cores \
+        detached_cpu_timeout_secs deadline <<<"$detached_limits"
+    mem_max="$detached_memory_max_bytes"
+elif [ "$detached_limit_count" -ne 0 ]; then
+    die "detached resource limit flags require --sh-resource-report"
+fi
+
+if [ -n "$report_file" ] && [ -n "$detached_report_file" ]; then
+    same_report_path="$(python3 - "$report_file" "$detached_report_file" <<'PY'
+import os
+import sys
+print("yes" if os.path.abspath(sys.argv[1]) == os.path.abspath(sys.argv[2]) else "no")
+PY
+)"
+    [ "$same_report_path" = no ] || die "--sh-report and --sh-resource-report must name different files"
+fi
+
+if [ -n "$report_file" ]; then
+    # Fail loudly on an unwritable destination rather than losing the report: a
+    # report that silently goes nowhere is the inert-mechanism failure this script
+    # exists to prevent.
+    exec 3>"$report_file" || die "--sh-report: cannot write $report_file"
+    REPORT_FD=3
+fi
+
+[ $# -ge 1 ] || die "no hermit arguments given (try --sh-help)"
+
+# ---------------------------------------------------------------- pick the binary
+# The rule that makes an ARBITRARY binary as cheap as running it bare.
+# PRECEDENCE IS NAMED, NOT JUST APPLIED. `binary_source` below reports which layer
+# won, because "which build produced this artifact" was unanswerable for most of
+# 2026-08-19 and that cost most of a day's rework.
+#
+# FRESHNESS IS OPT-IN (--sh-fresh), NOT DEFAULT, AND THAT IS A DELIBERATE
+# DEVIATION worth reading: the owner asked for ./target/release/hermit "or cargo
+# run it to ensure freshness", and separately, this morning, asked that a stable
+# binary be FROZEN for demo work precisely because rebuild churn in the shared
+# checkout produced artifacts whose originating build was unrecorded. Rebuilding
+# by default in the entry point every demo uses would reintroduce that churn. So
+# the default resolves an EXISTING binary and never builds; `--sh-fresh` opts in.
+# Raised with the owner rather than decided quietly.
+hermit_bin=""; binary_source=""
+if [ -n "$bin_override" ]; then
+    hermit_bin="$bin_override"; binary_source="flag:--sh-bin"
+elif [ -x "$1" ] && case "$1" in */*) true ;; *) false ;; esac; then
+    hermit_bin="$1"; binary_source="argv:positional-path"; shift
+elif [ -n "${HERMIT_BIN:-}" ]; then
+    hermit_bin="$HERMIT_BIN"; binary_source="env:HERMIT_BIN"
+elif [ -x "$ROOT/target/release/hermit" ]; then
+    hermit_bin="$ROOT/target/release/hermit"; binary_source="default:target/release/hermit"
+elif [ -x "$ROOT/bin/hermit" ]; then
+    hermit_bin="$ROOT/bin/hermit"; binary_source="default:bin/hermit"
+else
+    hermit_bin="$(command -v hermit 2>/dev/null || true)"; binary_source="path:$(command -v hermit 2>/dev/null || echo none)"
+fi
+if [ "$fresh" = 1 ]; then
+    if [ "$binary_source" = "default:target/release/hermit" ] || [ ! -x "$hermit_bin" ]; then
+        say "--sh-fresh: building hermit --release (this mutates the shared checkout's target/)"
+        if (cd "$ROOT" && cargo build --release -p hermit >&2); then
+            hermit_bin="$ROOT/target/release/hermit"; binary_source="fresh:cargo build --release"
+        else
+            die "--sh-fresh: cargo build --release failed; refusing to run a stale binary while you asked for a fresh one"
+        fi
+    else
+        say "--sh-fresh ignored: an explicit binary was selected ($binary_source); refusing to rebuild over an explicit choice"
+    fi
+fi
+[ -n "$hermit_bin" ] || die "no hermit binary found: pass one as the first argument, set HERMIT_BIN, or use --sh-bin"
+[ -x "$hermit_bin" ] || die "not executable: $hermit_bin"
+hermit_bin="$(cd "$(dirname "$hermit_bin")" && printf '%s/%s' "$(pwd)" "$(basename "$hermit_bin")")"
+
+# ---------------------------------------------------------------- identity (5)
+# Most of today's rework came from artifacts whose originating build was
+# unrecorded. The hash is of the binary that ACTUALLY ran, resolved absolute.
+run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
+binary_sha256="$(sha256sum "$hermit_bin" 2>/dev/null | cut -d' ' -f1)"
+[ -n "$binary_sha256" ] || binary_sha256="unavailable"
+invocation_sha256=""
+if [ -n "$detached_report_file" ]; then
+    invocation_sha256="$(python3 - "$hermit_bin" "$@" <<'PY'
+import hashlib
+import os
+import sys
+
+digest = hashlib.sha256()
+for argument in sys.argv[1:]:
+    digest.update(os.fsencode(argument))
+    digest.update(b"\0")
+print(digest.hexdigest())
+PY
+)"
+fi
+
+# ---------------------------------------------------------------- optional detached-unit accounting
+# Parallel experiment runners normally measure the worker cgroup. systemd-run
+# reparents this script's expensive child into a transient service, outside that
+# cgroup, so an explicitly opted-in caller may ask for a second resource report.
+#
+# The report is deliberately a separate file from --sh-report. It first appears
+# atomically with the owned unit name, before the unit is launched, so signal
+# teardown can find that exact cgroup. It is replaced atomically with the complete
+# counters while the unit is still retained and before reset-failed/stop below.
+# A pre-existing path is always a refusal: accepting one could make a stale unit
+# name authoritative for cancellation or mix a previous seed's counters into this
+# invocation.
+detached_report_identity=""
+detached_metrics_error=""
+detached_metrics_written=0
+detached_last_tasks_peak=""
+detached_cgroup_path=""
+detached_cpu_usage_usec=0
+detached_memory_oom_kills=0
+detached_tasks_limit_hits=0
+detached_cpu_time_limit_hit=0
+detached_wall_time_limit_hit=0
+detached_log_cap_hit=0
+detached_log_cap_killed=0
+detached_cleanup_armed=0
+detached_binary_identity_accepted=0
+detached_limit_cpu_cores_micros=""
+detached_limit_cpu_time_nsec=""
+detached_limit_wall_time_usec=""
+if [ -n "$detached_report_file" ]; then
+    detached_limit_cpu_cores_micros=$((detached_cpu_cores * 1000000))
+    detached_limit_cpu_time_nsec=$((detached_cpu_timeout_secs * 1000000000))
+    detached_limit_wall_time_usec=$((deadline * 1000000))
+fi
+
+prepare_detached_report() {
+    local prepared
+    local -a prepared_lines=()
+    prepared="$(python3 - "$detached_report_file" "$unit" "$run_id" \
+        "$invocation_sha256" "$binary_sha256" "$detached_memory_max_bytes" \
+        "$detached_tasks_max" "$detached_limit_cpu_cores_micros" \
+        "$detached_limit_cpu_time_nsec" "$detached_limit_wall_time_usec" "0" <<'PY'
+import os
+import pathlib
+import stat
+import sys
+import tempfile
+
+(raw, unit, run_id, invocation, binary, memory_limit, tasks_limit,
+ cpu_cores_micros, cpu_time_limit, wall_time_limit, swap_limit) = sys.argv[1:]
+if not raw or any(ord(char) < 32 or ord(char) == 127 for char in raw):
+    raise SystemExit("resource report path is empty or contains a control character")
+path = pathlib.Path(raw)
+parent_text = os.path.abspath(os.fspath(path.parent))
+parent = pathlib.Path(parent_text)
+resolved_parent = parent.resolve(strict=True)
+if parent != resolved_parent:
+    raise SystemExit("resource report parent must not contain symlinks")
+if not resolved_parent.is_dir():
+    raise SystemExit("resource report parent is not a directory")
+parent_mode = resolved_parent.stat().st_mode
+if parent_mode & 0o022 and not parent_mode & stat.S_ISVTX:
+    raise SystemExit("resource report parent is writable by other users without sticky protection")
+name = path.name
+if name in {"", ".", ".."}:
+    raise SystemExit("resource report needs a file name")
+target = resolved_parent / name
+try:
+    os.lstat(target)
+except FileNotFoundError:
+    pass
+else:
+    raise SystemExit("resource report already exists")
+
+payload = (
+    f"safehermit: unit={unit}\n"
+    f"safehermit: run_id={run_id}\n"
+    f"safehermit: invocation_sha256={invocation}\n"
+    f"safehermit: binary_sha256={binary}\n"
+    f"safehermit: limit_memory_bytes={memory_limit}\n"
+    f"safehermit: limit_swap_bytes={swap_limit}\n"
+    f"safehermit: limit_tasks={tasks_limit}\n"
+    f"safehermit: limit_cpu_cores_micros={cpu_cores_micros}\n"
+    f"safehermit: limit_cpu_time_nsec={cpu_time_limit}\n"
+    f"safehermit: limit_wall_time_usec={wall_time_limit}\n"
+).encode("utf-8")
+fd, temporary = tempfile.mkstemp(prefix=".safehermit-resource.", suffix=".tmp", dir=resolved_parent)
+try:
+    os.fchmod(fd, 0o600)
+    with os.fdopen(fd, "wb", closefd=True) as stream:
+        stream.write(payload)
+        stream.flush()
+        os.fsync(stream.fileno())
+    fd = -1
+    # link(2), unlike replace(2), refuses a name that appeared after our lstat.
+    os.link(temporary, target)
+    os.unlink(temporary)
+    directory_fd = os.open(resolved_parent, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(directory_fd)
+    finally:
+        os.close(directory_fd)
+finally:
+    if fd >= 0:
+        os.close(fd)
+    try:
+        os.unlink(temporary)
+    except FileNotFoundError:
+        pass
+
+identity = os.lstat(target)
+if not stat.S_ISREG(identity.st_mode) or identity.st_nlink != 1:
