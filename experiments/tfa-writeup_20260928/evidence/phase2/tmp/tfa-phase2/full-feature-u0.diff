+def _qualification_receipt_record(
+    qualification: Mapping[str, object],
+) -> dict[str, object]:
+    resource_name = qualification.get("receipts_resource")
+    expected_digest = qualification.get("receipts_sha256")
+    if (
+        resource_name != _PACKAGED_HERMIT_RECEIPTS_RESOURCE
+        or expected_digest != PACKAGED_HERMIT_RECEIPTS_SHA256
+    ):
+        raise HermitError("packaged Hermit qualification receipt binding is malformed")
+    path = _packaged_resource(_PACKAGED_HERMIT_RECEIPTS_RESOURCE)
+    try:
+        before = regular_file_record(path)
+        receipts = json.loads(path.read_text())
+        after = regular_file_record(path)
+    except (OSError, json.JSONDecodeError, StateError) as error:
+        raise HermitError("packaged Hermit qualification receipts are unreadable") from error
+    if (
+        before != after
+        or before.get("sha256") != expected_digest
+        or not isinstance(receipts, dict)
+        or receipts.get("schema_version") != 1
+        or receipts.get("probe_binary")
+        != {
+            "build_mode": qualification.get("mode"),
+            "sha256": qualification.get("sha256"),
+            "upstream_revision": PACKAGED_HERMIT_REVISION,
+        }
+        or receipts.get("bounds")
+        != {
+            "deadline_seconds": 120,
+            "disk_limit": "8G",
+            "max_log_bytes": 67108864,
+        }
+        or not isinstance(receipts.get("probes"), list)
+    ):
+        raise HermitError("packaged Hermit qualification receipts are malformed")
+    expected_markers = {
+        "asyncssl": (1, 1, "AddressSanitizer: CHECK failed", "setrlimit(RLIMIT_CORE"),
+        "thrift": (0, 132, "ThreadSanitizer: CHECK failed", "signal=SIGILL"),
+        "httpcoro": (1, 1, "Clock perf counter exceeds target value", "Sandbox container exited unexpectedly"),
+    }
+    observed: list[tuple[str, int, int]] = []
+    for probe in receipts["probes"]:
+        if not isinstance(probe, dict):
+            raise HermitError("packaged Hermit qualification probe is malformed")
+        case_id = probe.get("case_id")
+        expected = expected_markers.get(case_id)
+        argv = probe.get("argv")
+        stderr = probe.get("stderr")
+        stdout = probe.get("stdout")
+        if (
+            expected is None
+            or not isinstance(argv, list)
+            or not all(isinstance(token, str) for token in argv)
+            or not isinstance(stderr, str)
+            or not isinstance(stdout, str)
+            or probe.get("seed") != expected[0]
+            or probe.get("returncode") != expected[1]
+            or expected[2] not in stderr
+            or expected[3] not in stderr
+            or "--sh-deadline" not in argv
+            or argv[argv.index("--sh-deadline") + 1] != "120"
+            or "--sh-max-log-bytes" not in argv
+            or argv[argv.index("--sh-max-log-bytes") + 1] != "67108864"
+            or "--sh-disk-limit" not in argv
+            or argv[argv.index("--sh-disk-limit") + 1] != "8G"
+            or hashlib.sha256(
+                (json.dumps(argv, separators=(",", ":")) + "\n").encode()
+            ).hexdigest()
+            != probe.get("argv_sha256")
+            or hashlib.sha256(stderr.encode()).hexdigest()
+            != probe.get("stderr_sha256")
+            or hashlib.sha256(stdout.encode()).hexdigest()
+            != probe.get("stdout_sha256")
+            or re.fullmatch(r"[0-9a-f]{64}", str(probe.get("result_receipt_sha256")))
+            is None
+            or re.fullmatch(
+                r"[0-9a-f]{64}", str(probe.get("safehermit_report_sha256"))
+            )
+            is None
+        ):
+            raise HermitError("packaged Hermit qualification probe is malformed")
+        observed.append((case_id, expected[0], expected[1]))
+    candidates = qualification.get("short_candidates")
+    if not isinstance(candidates, list) or observed != [
+        (candidate.get("case_id"), candidate.get("seed"), candidate.get("returncode"))
+        for candidate in candidates
+        if isinstance(candidate, dict)
+    ]:
+        raise HermitError("packaged Hermit qualification candidates differ from receipts")
+    return before
+
+
+def packaged_hermit_argv(
+    argv: tuple[str, ...],
+    expected_revision: str,
+    expected_sha256: str,
+    destination: Path,
+) -> tuple[str, ...]:
+    compatibility_path = _packaged_resource(_PACKAGED_HERMIT_COMPATIBILITY_RESOURCE)
+    try:
+        compatibility_before = regular_file_record(compatibility_path)
+        compatibility = json.loads(compatibility_path.read_text())
+        compatibility_after = regular_file_record(compatibility_path)
+    except (OSError, json.JSONDecodeError, StateError) as error:
+        raise HermitError(
+            "packaged Hermit compatibility record is unreadable"
+        ) from error
+    if compatibility_before != compatibility_after or not isinstance(
+        compatibility, dict
+    ):
+        raise HermitError("packaged Hermit compatibility record changed while read")
+    qualification = compatibility.get("qualification_probe")
+    packaged = compatibility.get("packaged_executable")
+    historical = compatibility.get("historical_witness")
+    blockers = (
+        qualification.get("blockers") if isinstance(qualification, dict) else None
+    )
+    if (
+        compatibility.get("schema_version") != 1
+        or compatibility.get("target")
+        != "fbcode//hermetic_infra/hermit/hermit-cli:hermit"
+        or compatibility.get("resource") != _PACKAGED_HERMIT_RESOURCE
+        or compatibility.get("upstream_revision") != PACKAGED_HERMIT_REVISION
+        or not isinstance(compatibility.get("fbsource_import_commit"), str)
+        or re.fullmatch(
+            r"[0-9a-f]{40}", str(compatibility.get("fbsource_import_commit"))
+        )
+        is None
+        or not isinstance(historical, dict)
+        or re.fullmatch(r"[0-9a-f]{40}", str(historical.get("revision"))) is None
+        or re.fullmatch(r"[0-9a-f]{64}", str(historical.get("sha256"))) is None
+        or historical.get("state") != "PRESERVED"
+        or not isinstance(qualification, dict)
+        or not isinstance(packaged, dict)
+        or packaged.get("sha256") != PACKAGED_HERMIT_RESOURCE_SHA256
+        or packaged.get("configuration")
+        != "opt-linux-x86_64-fbcode-platform010-clang21-no-san"
+        or qualification.get("sha256") != PACKAGED_HERMIT_QUALIFICATION_SHA256
+        or qualification.get("state") not in ("BLOCKED", "QUALIFIED")
+        or not isinstance(blockers, list)
+        or not all(isinstance(blocker, str) and blocker for blocker in blockers)
+        or (qualification.get("state") == "BLOCKED") != bool(blockers)
+    ):
+        raise HermitError("packaged Hermit compatibility record is malformed")
+    receipt_record = _qualification_receipt_record(qualification)
+    binary = _packaged_resource(_PACKAGED_HERMIT_RESOURCE)
+    try:
+        record = regular_file_record(binary)
+        metadata = binary.lstat()
+    except (OSError, StateError) as error:
+        raise HermitError("packaged Hermit binary is unavailable") from error
+    packaged_sha256 = record.get("sha256")
+    if (
+        not isinstance(packaged_sha256, str)
+        or not stat.S_ISREG(metadata.st_mode)
+        or stat.S_IMODE(metadata.st_mode) & 0o111 == 0
+    ):
+        raise HermitError("packaged Hermit executable differs from its provenance")
+    qualification_sha256 = str(qualification["sha256"])
+    if packaged_sha256 != packaged["sha256"]:
+        compatibility_state = "UNASSESSED_VARIANT"
+    elif qualification["state"] != "QUALIFIED":
+        compatibility_state = "BLOCKED"
+    elif (
+        expected_revision != PACKAGED_HERMIT_REVISION
+        or expected_sha256 != packaged_sha256
+    ):
+        compatibility_state = "WITNESS_MISMATCH"
+    else:
+        compatibility_state = "QUALIFIED"
+    destination.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
+    write_metadata(
+        destination.parent / "identity.json",
+        {
+            "blockers": blockers,
+            "expected_witness": {
+                "revision": expected_revision,
+                "sha256": expected_sha256,
+            },
+            "fbsource_import_commit": compatibility["fbsource_import_commit"],
+            "packaged_executable": record,
+            "qualification_receipts": receipt_record,
+            "packaged_revision": PACKAGED_HERMIT_REVISION,
+            "qualification": {
+                "sha256": qualification_sha256,
+                "state": qualification["state"],
+            },
+            "schema": "tfa.packaged-hermit-compatibility.v1",
+            "state": compatibility_state,
+            "target": compatibility["target"],
+        },
+    )
+    if compatibility_state in ("BLOCKED", "UNASSESSED_VARIANT"):
+        raise HermitError(
+            f"packaged Hermit compatibility is {compatibility_state}: "
+            f"expected revision={expected_revision} sha256={expected_sha256}; "
+            f"target={compatibility['target']} "
+            f"import_commit={compatibility['fbsource_import_commit']} "
+            f"packaged revision={PACKAGED_HERMIT_REVISION} "
+            f"sha256={packaged_sha256}; "
+            f"qualification probe sha256={qualification_sha256} "
+            f"state={qualification['state']}; "
+            f"blockers={'; '.join(blockers)}"
+        )
+    if compatibility_state == "WITNESS_MISMATCH":
+        raise HermitError(
+            "packaged Hermit identity differs from the qualified witness: "
+            f"expected revision={expected_revision} sha256={expected_sha256}; "
+            f"packaged revision={PACKAGED_HERMIT_REVISION} "
+            f"sha256={packaged_sha256}"
+        )
+    if os.path.lexists(destination):
+        pinned = regular_file_record(destination)
+        if pinned.get("sha256") != packaged_sha256 or pinned.get("mode") != 0o500:
+            raise HermitError("pinned packaged Hermit executable differs")
+    else:
+        _pin_safehermit(binary, destination, packaged_sha256)
+    expected = _safehermit_binary(argv)
+    values = list(argv)
+    indexes = [index for index, value in enumerate(values) if value == str(expected)]
