+for label, value in (
+    ("memory_peak_bytes", memory_peak),
+    ("cpu_usage_nsec", cpu_usage),
+    ("tasks_peak", tasks_peak),
+    ("limit_memory_bytes", memory_limit),
+    ("limit_swap_bytes", swap_limit),
+    ("limit_tasks", tasks_limit),
+    ("limit_cpu_cores_micros", cpu_cores_micros),
+    ("limit_cpu_time_nsec", cpu_time_limit),
+    ("limit_wall_time_usec", wall_time_limit),
+    ("cpu_time_limit_hit", cpu_limit_hit),
+    ("memory_oom_kills", memory_oom_kills),
+    ("tasks_limit_hits", tasks_limit_hits),
+    ("wall_time_limit_hit", wall_limit_hit),
+    ("log_cap_hit", log_cap_hit),
