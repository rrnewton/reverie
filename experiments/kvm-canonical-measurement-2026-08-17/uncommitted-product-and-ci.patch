+#[derive(Clone, Debug, Deserialize)]
+#[serde(untagged)]
+pub enum Ci {
+    All(bool),
+    Backends(Vec<String>),
+}
+
+impl Default for Ci {
+    fn default() -> Self {
+        Self::All(false)
+    }
+}
+
+impl Ci {
+    fn selects(&self, backend: &str) -> bool {
+        match self {
+            Self::All(selected) => *selected,
+            Self::Backends(backends) => backends.iter().any(|value| value == backend),
+        }
+    }
+
+    fn selected<'a>(&'a self, enabled: &'a BTreeSet<&str>) -> BTreeSet<&'a str> {
+        match self {
+            Self::All(true) => enabled.iter().copied().collect(),
+            Self::All(false) => BTreeSet::new(),
+            Self::Backends(backends) => backends.iter().map(String::as_str).collect(),
+        }
+    }
+}
