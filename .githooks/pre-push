#!/usr/bin/env bash
# Warn on every parent push when GitHub reports a red current main commit.
# This is deliberately non-blocking: it makes the red impossible to miss while
# still allowing the coordinator to push a fix for that red.
set -uo pipefail

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
checker="$root/ci-hub/bin/main-health"

if [ ! -f "$checker" ]; then
  echo "HARD WARNING: GitHub main health checker is missing: $checker" >&2
  exit 0
fi

# The health checker has a wider standalone envelope, so bind this call site to an
# 8-second internal deadline and a 10-second process ceiling.  That leaves time
# for the commit, push, fetch, and ancestry proof without turning an unavailable
# diagnostic into green or suppressing the publication error.
output=$(timeout --signal=TERM --kill-after=1s 10s \
  "$checker" --per-call-timeout 4 --overall-deadline 8 2>&1)
rc=$?
if [ "$rc" -eq 0 ]; then
  printf '%s\n' "$output" >&2
  exit 0
fi

{
  echo "----------------------------------------------------------------------"
  printf '%s\n' "$output"
  if [ "$rc" -eq 1 ]; then
    echo "Pre-push warning: GitHub reports RED main. Push is allowed so fixes can land."
  elif [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
    echo "Pre-push warning: GitHub main health unavailable: exceeded 10s pre-push budget; push continues, and green is not established."
  else
    echo "Pre-push warning: GitHub main health could not be verified. Do not claim green."
  fi
  echo "----------------------------------------------------------------------"
} >&2
exit 0
