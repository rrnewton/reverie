#!/usr/bin/env bash
#
# Parent dev-hermit repo-hygiene guard (backstop).
#
# The DEFAULT hygiene practice is to write anything you won't commit -- raw logs,
# boot artifacts, scratch, big outputs -- directly into an ignored/ dir from the
# start, so there is no commit-time judgment call. This hook is only a BACKSTOP.
# It applies TWO INDEPENDENT hygiene gates to the staged blobs:
#
#   1. BINARY TYPE, size-independent -- ELF / ar-archive magic is refused at any
#      size (Hard Invariant 11). A 17 KiB compiled mutant is as refused as a
#      50 MB one; no size limit can catch that shape.
#   2. SOFT SIZE, type-independent -- WARNS + BLOCKS over a per-file limit, so an
#      oversized artifact never lands by accident. SIZE-DELTA AWARE: see below.
#
# Neither blanket-bans an extension; small curated logs/reports commit freely.
#
# Override the SIZE gate (you testify you've verified this file is a
# genuinely-needed, curated tracked report / machine-readable state):
#     HERMIT_HYGIENE_OVERRIDE=1 git commit ...
# Tune the size limit (KiB):
#     HERMIT_HYGIENE_MAX_KB=2048 git commit ...
# Override the BINARY gate -- SEPARATE FLAG BY DESIGN; needs a repo-owner policy
# decision, and HERMIT_HYGIENE_OVERRIDE deliberately does NOT reach it:
#     HERMIT_BINARY_GUARD=off git commit ...
#
# ---------------------------------------------------------------------------
# WHY THE SIZE GATE IS DELTA-AWARE (2026-08-08).
#
# An absolute-only limit fires on EVERY commit to a legitimately-growing tracked
# file. The validate ledger shard crossed 1024 KiB on its first import and was
# 1221 KiB on its second, so every future import would have needed
# HERMIT_HYGIENE_OVERRIDE -- and a gate that fires on every legitimate operation
# trains routine override until it protects nothing. That is not a forecast:
# SEVEN tracked files already exceed 1024 KiB, and six are raw logs/dumps under
# experiments/ -- precisely the class this hook exists to refuse. They are here
# because the only way past the gate was a flag that releases it entirely.
#
# The two populations are cleanly separable by DELTA, not by size:
#   * every one of those six arrived LARGE IN ONE COMMIT, with no prior version;
#   * the ledger got there by repeated small appends (+155 KiB / 81 rows;
#     measured 1700 B/row, ~153 KiB for a day's import).
# So: an over-limit path with NO baseline in HEAD is refused as before, while an
# over-limit path that ALREADY EXISTS is judged on how much it GREW. A routine
# append passes untouched; a 1.5 MiB dump appended to a tracked file does not.
#
# Raising the limit was rejected: clearing the ledger would mean clearing all six
# logs too. Path-exempting the ledger was rejected: it blinds the gate to the one
# file actually growing, and would need repeating per host and per team shard.
#
# THE CEILING IS NOT A THIRD GUARD -- it is AGENTS.md's existing rule finally
# implemented. "Textual files over 2 MiB require explicit coordinator approval
# before staging" was not enforced anywhere: HERMIT_HYGIENE_OVERRIDE exited 0 at
# ANY size, so the flag used routinely for a 1.2 MiB ledger also waved through a
# 50 MiB file. The ceiling is absolute and, following this file's established
# idiom, the routine override deliberately does NOT reach it:
#     HERMIT_HYGIENE_CEILING_OVERRIDE=1 git commit ...   (coordinator decision)
# Tune the growth allowance / ceiling (KiB):
#     HERMIT_HYGIENE_MAX_GROWTH_KB=256   HERMIT_HYGIENE_CEILING_KB=2048
# ---------------------------------------------------------------------------
#
# Install:  scripts/setup-hooks.sh   (sets core.hooksPath to durable dispatcher copies)
# Policy:   .githooks/hygiene-policy.md

set -u

# ---------------------------------------------------------------------------
# SHARED-INDEX GUARD. Restored 2026-08-25; removed 2026-08-15 by 4acd425b
# "Remove parent Git serialization blockers", which took six guards out of this
# hook family at once. This one is not a serialization blocker: it holds no
# lock, refuses no concurrent writer, and is about a single commit taking paths
# that are not its author's.
#
# WHAT IT PREVENTS, demonstrated before restoring rather than argued: with the
# guard absent, agent A stages mine.txt, agent B stages theirs.txt into the same
# shared index, and A's `git commit -m ...` exits 0 having taken BOTH. AGENTS.md
# devotes a section to exactly this ("Never commit to `dev-hermit` from the
# shared parent checkout") and records three incidents from it. The prose
# survived 4acd425b; the mechanism did not.
#
# WHY block IS THE DEFAULT AND NOT warn: .githooks/hygiene-policy.md has said
# "blocks bare commits by default (since 2026-08-06)" continuously, including
# every day the guard was absent. Restoring at warn would leave the same
# policy-outlives-enforcement gap that made this invisible for ten days, so the
# code is brought back to what the policy already claims.
#
# CENSUS RE-DERIVED 2026-08-25, because hygiene-policy.md records that the
# ORIGINAL census of this was WRONG TWICE -- it counted error-message strings as
# call sites and its grep missed the `-o`/`--only` plus separate-`--` form. Both
# mistakes were avoided here. Every non-test site that commits in the PARENT
# tree passes an explicit pathspec: ci-hub.rs:2355,2562; ledger/publisher.py:354,
# 500; pin/validation_gate.py:140; single-submodule-bump.rs:458 (`--only`, the
# form the old census missed); primary_checkout.py:975 (via the wrapper). The
# three that looked bare are not parent commits -- main-tooling-link.rs:543 is
# inside `#[cfg(test)]`, and checkout-hermit-pr-latest-reverie.sh:263 runs in a
# hermit checkout. The shared index was also sampled 35 times over 105s while
# the fleet worked: empty every time. Nothing known would be refused.
#
# Escape hatches unchanged: HERMIT_SHARED_INDEX_GUARD=warn (report, allow) or
# =off (silent). Independent of HERMIT_PIN_DRIFT_OVERRIDE.
# Evidence + harness (29 checks): experiments/shared-git-index-race_20260806/
# ---------------------------------------------------------------------------
shared_index_guard() {
  [ "${HERMIT_SHARED_INDEX_GUARD:-block}" = "off" ] && return 0
  # A pathspec commit is already safe -- git builds a temporary *next-index*
  # for `commit -- <paths>` / `--only`, so this is how the safe form is detected.
  case "${GIT_INDEX_FILE:-.git/index}" in *next-index*) return 0 ;; esac

  local staged n
  staged=$(git diff --cached --name-only 2>/dev/null) || return 0
  [ -z "$staged" ] && return 0
  n=$(printf '%s\n' "$staged" | grep -c .)

  {
    echo "----------------------------------------------------------------------"
    echo "SHARED INDEX: this is a BARE commit, so it takes EVERYTHING staged in"
    echo "the parent's shared index -- including any path another agent staged."
    echo "$n path(s) staged right now; first 15:"
    printf '%s\n' "$staged" | head -15 | sed 's/^/    /'
    [ "$n" -gt 15 ] && echo "    ... and $((n - 15)) more (git diff --cached --name-only)"
    echo
    echo "If any line above is not yours, abort (Ctrl-C) and instead run:"
    echo "      git add <your paths> && git commit -m 'msg' -- <your paths>"
  } >&2

  if [ "${HERMIT_SHARED_INDEX_GUARD:-block}" != "warn" ]; then
    {
      echo "BLOCKED: bare commits are refused in this shared-index repo."
      echo "If every path above really is yours, the same commit as a pathspec is fine:"
      echo "      git commit -m 'msg' -- <your paths>"
      echo "Deliberate exception: HERMIT_SHARED_INDEX_GUARD=warn (or =off) git commit ..."
      echo "----------------------------------------------------------------------"
    } >&2
    return 1
  fi
  echo "(warn mode; the default is block)" >&2
  echo "----------------------------------------------------------------------" >&2
  return 0
}
# In warn/off mode a defect in the guard must never block a commit.
if [ "${HERMIT_SHARED_INDEX_GUARD:-block}" = "block" ]; then
  shared_index_guard || exit 1
else
  shared_index_guard || true
fi

LIMIT_KB="${HERMIT_HYGIENE_MAX_KB:-1024}"
# Per-commit growth allowance for a path that ALREADY exists in HEAD. 256 KiB is
# ~1.7x the measured 153 KiB daily ledger import, so a normal append has room
# while a dump appended to a tracked file is still far outside it.
GROWTH_KB="${HERMIT_HYGIENE_MAX_GROWTH_KB:-256}"
# AGENTS.md coordinator-approval threshold. Absolute; delta cannot buy past it.
CEILING_KB="${HERMIT_HYGIENE_CEILING_KB:-2048}"
POLICY=".githooks/hygiene-policy.md"

# Warning-only checkout/snapshot freshness probe. A stale/detached primary,
# stale parent gitlink, or Reverie-pin currency mismatch must be loud, but it
# must not prevent a parent commit that repairs a stale gitlink or hook.
if [ -x scripts/primary_checkout.py ]; then
  scripts/primary_checkout.py check >&2 || true
else
  echo "WARNING: primary checkout freshness checker is missing." >&2
fi

# BLOCKING Reverie pin-drift guard. Distinct from the warning-only freshness
# probe above: this is the offline *consistency* check -- it fails the commit
# only when the tracked Reverie references (every Cargo.toml rev and both
# Cargo.lock sources) disagree with each other, i.e. a silent pin drift. It
# never touches primary freshness/network, so it cannot block a commit that
# repairs a stale gitlink. Override a deliberate in-flight state with
# HERMIT_PIN_DRIFT_OVERRIDE=1.
#
# IT READS THE RECORDED GITLINK, NOT THE HERMIT WORKING TREE (since 2026-08-06).
# A parent commit records a submodule *commit*, so check-pins resolves the
# hermit gitlink this very commit will take -- from GIT_INDEX_FILE, which for
# the mandated `git commit -m msg -- <paths>` form is the temporary index built
# from HEAD plus the named paths -- and reads that tree out of hermit's object
# store. Consequences, both deliberate: another agent's dirty hermit/ working
# tree can no longer false-block an unrelated parent commit (that regression
# put the whole fleet on HERMIT_PIN_DRIFT_OVERRIDE=1 for a day), and drift the
# commit does not record is not this hook's business -- hermit's own
# check-reverie-pin.rs hook and CI guard the hermit working tree.
#
# The hermit/Cargo.toml test below is a "hermit is checked out at all" probe:
# without a hermit checkout there is no object store to read the gitlink from.
if [ -x scripts/primary_checkout.py ] && [ -f hermit/Cargo.toml ]; then
  if ! scripts/primary_checkout.py check-pins >&2; then
    if [ "${HERMIT_PIN_DRIFT_OVERRIDE:-}" = "1" ]; then
      echo "HERMIT_PIN_DRIFT_OVERRIDE=1 set -- proceeding despite Reverie pin drift." >&2
    else
      exit 1
    fi
  fi
fi

# ---------------------------------------------------------------------------
# BINARY-TYPE GUARD (SIZE-INDEPENDENT). Runs BEFORE the size check below.
#
# The size check is a soft budget; this is Hard Invariant 11 ("never commit
# binaries to any repository"), which has no size threshold. Keeping them
# separate matters because the two failure modes are different: a 4 MiB CSV is
# a judgment call, a 17 KiB ELF is never correct at any size.
#
# Measured 2026-08-06 (audit `ai_docs/parent-dirty-ownership-audit_20260806.md`
# section 4): experiments/strict-certification-mutation-sweep_20260806/mutants/
# held 7 unignored ELF executables, 17,256-907,448 bytes, ~5.4 MB total, none
# ignored by `git check-ignore`. EVERY ONE was under LIMIT_KB=1024, so the
# size-only guard would have passed all 5.4 MB silently on one `git add -A`.
# The smallest (`clean_trivial`, 17 KiB) is the shape no size limit can ever
# catch -- which is the whole point of checking TYPE instead of SIZE.
#
# SCOPE IS DELIBERATELY NARROW: the executable/object/archive family, matched on
# magic bytes of the STAGED BLOB (not the worktree file, not the extension, not
# `file`(1) -- no external dependency, and nothing an extension rename evades):
#     \x7fELF     ELF -- executables, .so shared libs, .o relocatables, core dumps
#     !<arch>\n   ar  -- .a static libraries (and .deb)
# This is NOT a general binary heuristic on purpose. Verified against the whole
# tracked tree at 2026-08-06: ZERO tracked files match either magic, so this
# gate cannot false-positive on anything the repo already contains. A broader
# net (git's own NUL-byte heuristic) would catch legitimate tracked fixtures and
# golden logs and is NOT adopted here.
#
# Escape hatch is SEPARATE from HERMIT_HYGIENE_OVERRIDE on purpose. That flag
# means "I testify this is a curated tracked report/state", which a compiled
# binary can never be, so it MUST NOT silence this gate -- one flag for two
# different authorities is exactly the collapse that lets a real breach ride in
# on an unrelated testimony. Committing a binary needs a repo-owner policy
# decision (see Hard Invariant 11 on Git LFS), so the hatch is deliberately
# separate and greppable:  HERMIT_BINARY_GUARD=off git commit ...
#
# Bracket harness (both directions, counted): .githooks/tests/test-binary-guard.sh
# ---------------------------------------------------------------------------
bins=()
if [ "${HERMIT_BINARY_GUARD:-block}" != "off" ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    # Magic bytes of the STAGED blob. `od -N8` stops after 8 bytes; the SIGPIPE
    # this sends to `git cat-file` is expected and harmless (no pipefail here).
    # Fail OPEN on any lookup error -- a guard defect must never wedge a commit.
    magic=$(git cat-file blob ":$f" 2>/dev/null | od -An -tx1 -v -N8 2>/dev/null | tr -d ' \n') || continue
    case "$magic" in
      7f454c46*)         bins+=("$(printf '  ELF      %s' "$f")") ;;
      213c617263683e0a*) bins+=("$(printf '  ARCHIVE  %s' "$f")") ;;
    esac
  done < <(git diff --cached --name-only --diff-filter=ACM)
fi

if [ "${#bins[@]}" -gt 0 ]; then
  {
    echo "----------------------------------------------------------------------"
    echo "REPO HYGIENE: staged file(s) are COMPILED BINARIES (matched by magic"
    echo "bytes of the staged blob, independent of size):"
    for b in "${bins[@]}"; do echo "$b"; done
    echo
    echo "Hard Invariant 11: never commit binaries to any repository -- no size"
    echo "is small enough. Build outputs, mutants, fixtures and compiled test"
    echo "guests belong under an ignored/ dir, written there FROM THE START."
    echo "If evidence depends on one, commit a small TEXT manifest instead:"
    echo "location, checksum, producing command, tool version, source SHA."
    echo
    echo "NOTE: HERMIT_HYGIENE_OVERRIDE=1 does NOT bypass this -- it attests a"
    echo "curated report/state file, which a compiled binary is not."
    echo "Policy: ${POLICY}"
    echo
    echo "BLOCKED. Committing a binary needs a repo-owner policy decision; if you"
    echo "have one, it is:  HERMIT_BINARY_GUARD=off git commit ..."
    echo "----------------------------------------------------------------------"
  } >&2
  exit 1
fi

big=()
over_ceiling=()
grew_ok=()
# Only added/copied/modified files; deletions and renames-away don't add bytes.
while IFS= read -r f; do
  [ -z "$f" ] && continue
  # Size of the STAGED blob (bytes). Fail open on any lookup error (never wedge).
  sz=$(git cat-file -s ":$f" 2>/dev/null) || continue
  kb=$(( (sz + 1023) / 1024 ))

  # The ceiling is checked FIRST and independently: it is an absolute policy
  # threshold, so neither a small delta nor the routine override may reach it.
  if [ "$kb" -gt "$CEILING_KB" ]; then
    over_ceiling+=("$(printf '%7d KiB  %s' "$kb" "$f")")
    continue
  fi

  [ "$kb" -le "$LIMIT_KB" ] && continue

  # Over the soft limit. Judge an ALREADY-TRACKED path on its growth instead of
  # its absolute size: that is what separates a legitimate append from a dump
  # landing in one commit. A path with no baseline in HEAD has no growth to
  # measure and stays refused exactly as before.
  base=$(git cat-file -s "HEAD:$f" 2>/dev/null) || base=""
  if [ -n "$base" ]; then
    base_kb=$(( (base + 1023) / 1024 ))
    delta_kb=$(( kb - base_kb ))
    if [ "$delta_kb" -le "$GROWTH_KB" ]; then
      grew_ok+=("$(printf '%7d KiB (+%d KiB)  %s' "$kb" "$delta_kb" "$f")")
      continue
    fi
    big+=("$(printf '%7d KiB (+%d KiB, allowance %d KiB)  %s' \
      "$kb" "$delta_kb" "$GROWTH_KB" "$f")")
    continue
  fi
  big+=("$(printf '%7d KiB (new file, no baseline)  %s' "$kb" "$f")")
done < <(git diff --cached --name-only --diff-filter=ACM)

# Growth stays VISIBLE even when allowed: a silent allowance is how a file
# creeps to the ceiling with nobody noticing it happening.
if [ "${#grew_ok[@]}" -gt 0 ]; then
  {
    echo "repo hygiene: over ${LIMIT_KB} KiB but growing normally (allowance ${GROWTH_KB} KiB/commit):"
    for g in "${grew_ok[@]}"; do echo "  $g"; done
    echo "  ceiling is ${CEILING_KB} KiB and needs a coordinator decision."
  } >&2
fi

if [ "${#over_ceiling[@]}" -gt 0 ]; then
  {
    echo "----------------------------------------------------------------------"
    echo "REPO HYGIENE: staged file(s) over the ${CEILING_KB} KiB CEILING:"
    for b in "${over_ceiling[@]}"; do echo "  $b"; done
    echo
    echo "AGENTS.md: textual files over 2 MiB require explicit coordinator"
    echo "approval before staging. This is a POLICY threshold, not a soft limit,"
    echo "so HERMIT_HYGIENE_OVERRIDE does NOT reach it -- same reason the binary"
    echo "guard has its own flag: two different decisions must not collapse into"
    echo "one habit."
    echo
    echo "BLOCKED. Prefer splitting/sharding the artifact so no single file"
    echo "crosses the threshold. With a recorded coordinator decision:"
    echo "        HERMIT_HYGIENE_CEILING_OVERRIDE=1 git commit ..."
    echo "----------------------------------------------------------------------"
  } >&2
  [ "${HERMIT_HYGIENE_CEILING_OVERRIDE:-}" = "1" ] || exit 1
  echo "HERMIT_HYGIENE_CEILING_OVERRIDE=1 set -- proceeding on a recorded" >&2
  echo "coordinator decision for the above." >&2
fi

[ "${#big[@]}" -eq 0 ] && exit 0

{
  echo "----------------------------------------------------------------------"
  echo "REPO HYGIENE: staged file(s) over the ${LIMIT_KB} KiB soft limit:"
  for b in "${big[@]}"; do echo "  $b"; done
  echo
  echo "Commit CODE + REPORTS + machine-readable state only. Raw giant logs,"
  echo "dumps, and binaries belong under an ignored/ dir (write them there from"
  echo "the START), not in git -- especially under experiments/ and debug/."
  echo "Policy: ${POLICY}  and  hermit/.claude/skills/repo-cleanliness.md"
  echo
} >&2

if [ "${HERMIT_HYGIENE_OVERRIDE:-}" = "1" ]; then
  echo "HERMIT_HYGIENE_OVERRIDE=1 set -- proceeding on your testimony that the" >&2
  echo "above are verified-compliant curated report/state files." >&2
  exit 0
fi

{
  echo "BLOCKED. Choose one:"
  echo "  * move the artifact under an ignored/ dir (or reference it by path), OR"
  echo "  * if it is a genuinely-needed tracked report/state, re-run:"
  echo "        HERMIT_HYGIENE_OVERRIDE=1 git commit ..."
  echo "----------------------------------------------------------------------"
} >&2
exit 1
